#. module: health_pwa_family
msgid "Family Update (post-visit)"
msgstr "Cập nhật gia đình (sau thăm khám)"

#. module: health_pwa_family
msgid "Access denied"
msgstr "Truy cập bị từ chối"

#. module: health_pwa_family
msgid "Not assigned to this visit"
msgstr "Bạn không được phân công cho lượt thăm khám này"

#. module: health_pwa_family
msgid "Messaging is disabled"
msgstr "Tính năng nhắn tin đang tắt"

#. module: health_pwa_family
msgid "Invalid thread"
msgstr "Kênh tin nhắn không hợp lệ"

#. module: health_pwa_family
msgid "Thread not found for this visit"
msgstr "Không tìm thấy kênh tin nhắn cho lượt thăm khám này"

#. module: health_pwa_family
msgid "Please write an update first."
msgstr "Vui lòng nhập nội dung cập nhật trước."

#. module: health_pwa_family
msgid "No eligible family recipients for this patient."
msgstr "Không có người thân đủ điều kiện nhận tin cho bệnh nhân này."

#. module: health_pwa_family
msgid "Update sent to %s family recipient(s)."
msgstr "Đã gửi cập nhật đến %s người thân."
