<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- fammsg.css after health.css so the cascade wins without specificity
         hacks (daystrip/ergo precedent). fammsg styles ONLY its own .fammsg-*
         elements. ?v cache-busts on the shared PWA asset version (now 1.10.0). -->
    <template id="app_shell_fammsg_head" inherit_id="health_pwa.app_shell"
              name="Health PWA App Shell — Family Messages (head)">
        <xpath expr="//link[contains(@t-attf-href, 'css/health.css')]"
               position="after">
            <link t-attf-href="/health_pwa_family/static/src/css/fammsg.css?v=#{pwa_asset_version}"
                  rel="stylesheet" type="text/css"/>
        </xpath>
    </template>

    <!-- fammsg.js after router.js (daystrip/ergo precedent). Plain IIFE,
         window.healthFamMsg global, no app.js hooks beyond the fetch-wrap. -->
    <template id="app_shell_fammsg_scripts" inherit_id="health_pwa.app_shell"
              name="Health PWA App Shell — Family Messages (scripts)">
        <xpath expr="//script[contains(@t-attf-src, 'js/router.js')]"
               position="after">
            <script t-attf-src="/health_pwa_family/static/src/js/fammsg.js?v=#{pwa_asset_version}"></script>
        </xpath>
    </template>

</odoo>
