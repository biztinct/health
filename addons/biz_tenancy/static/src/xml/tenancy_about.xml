<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="biz_tenancy.About">
  <div class="bzk bzk-page bztn-about">

    <div class="bztn-about-head">
      <HubBackChip back="back"/>
      <div class="bzk-h1" t-esc="title"/>
      <div class="bzk-sub" t-esc="lede"/>
    </div>

    <!-- THE ONE ANSWER SOMEBODY CAME FOR, at the top and in the largest type
         on the page: which release am I running. -->
    <div class="bzk-hero bztn-hero" t-if="currentName">
      <div class="bzk-hero-av"><t t-out="ic('package', 24)"/></div>
      <div class="bzk-hero-id">
        <div class="nm" t-esc="currentName"/>
        <div class="mt" t-if="currentDate">
          Released <t t-esc="currentDate"/>
        </div>
      </div>
      <div class="bzk-hero-net" t-if="state.pushed_at">
        <div class="k">Last heard from the platform</div>
        <div class="mt" t-esc="state.pushed_at"/>
      </div>
    </div>

    <!-- ZERO DEAD ENDS: a system that has never been told about a release
         explains what will appear here rather than showing a blank page. -->
    <div class="bzk-panel bztn-empty" t-if="!currentName">
      <div class="bzk-empty">
        <div class="bztn-empty-ic"><t t-out="ic('package', 28)"/></div>
        <div class="bztn-empty-t">No update has been recorded here yet.</div>
        <div class="bztn-empty-s">
          The next time this system is updated, the release and a note saying
          what changed will appear on this page.
        </div>
      </div>
    </div>

    <!-- THE HISTORY. `rel` and never `lt`/`gt`/`amp`: those names compile to a
         literal `&lt;` and take the whole component down (ledger F15). -->
    <div class="bztn-rel-list" t-if="releases.length">
      <div t-foreach="releases" t-as="rel" t-key="rel.name"
           t-attf-class="bzk-panel bztn-rel {{ rel.current ? 'is-now' : '' }}">
        <div class="bztn-rel-h">
          <span class="bztn-rel-n" t-esc="rel.name"/>
          <span class="bzk-badge ok" t-if="rel.current">
            <span class="d"/> You are on this one
          </span>
          <span class="bztn-rel-d" t-if="rel.date" t-esc="rel.date"/>
        </div>
        <div class="bztn-rel-b" t-if="rel.hasNotes">
          <t t-foreach="rel.blocks" t-as="blk" t-key="blk_index">
            <p t-if="blk.kind === 'p'" t-esc="blk.text"/>
            <ul t-else="">
              <li t-foreach="blk.items" t-as="bullet" t-key="bullet_index"
                  t-esc="bullet"/>
            </ul>
          </t>
        </div>
        <div class="bztn-rel-b bztn-rel-none" t-else="">
          No note was written for this update.
        </div>
      </div>
    </div>


    <!-- ==================================================================
         SUPPORT ACCESS, ON THE CUSTOMER'S OWN SCREEN.

         This is the half of the feature that makes the other half worth
         having. Everything below is read from THIS system: who came in, when,
         why, for how long, and which screens they opened. And the switch at
         the top is the customer's, not the platform's: a door only one side
         can open is not support, it is access.
         ================================================================== -->
    <div class="bzk-panel bztn-sup" t-if="support.loaded">
      <div class="bzk-panel-h">
        <div class="bzk-h2">Support access</div>
      </div>

      <div class="bztn-sup-switch">
        <div class="bztn-sup-switch-t">
          <div class="nm">Let <t t-esc="brand"/> come in to help</div>
          <div class="sb">
            When this is on, somebody from <t t-esc="brand"/> can open a
            time-limited link into this system after typing a reason. Every
            time they do, it is listed below. When it is off, they are refused
            and the attempt is still listed.
          </div>
        </div>
        <button t-if="support.mayChange"
                t-attf-class="bzk-btn {{ support.allowed ? 'outline' : 'primary' }}"
                t-on-click="toggleSupportAllowed">
          <t t-if="support.allowed">
            <t t-out="ic('lock', 15)"/> <span>Switch it off</span>
          </t>
          <t t-else="">
            <t t-out="ic('check', 15)"/> <span>Switch it on</span>
          </t>
        </button>
        <!-- A button that answers back is worse than no button. Somebody who
             cannot change this is told so where the control would have been,
             and told who can. -->
        <div t-else="" class="bztn-sup-cannot">
          <span t-if="support.allowed">It is on.</span>
          <span t-else="">It is off.</span>
          <span>Only somebody who administers this system can change it.</span>
        </div>
      </div>

      <div class="bzk-sub bztn-sup-lede" t-esc="supportLede"/>

      <div class="bztn-sup-row" t-foreach="supportSessions" t-as="sup"
           t-key="sup.id">
        <div class="bztn-sup-row-h">
          <span t-attf-class="bzk-badge {{ supportTone(sup.state) }}"
                t-esc="supportWords(sup.state)"/>
          <span class="who" t-esc="sup.who"/>
          <span class="when" t-esc="sup.opened_at or sup.issued_at"/>
          <span class="mins"><t t-esc="sup.minutes"/> minutes</span>
          <button class="bzk-btn ghost bzk-btn-sm"
                  t-if="sup.state === 'active' or sup.state === 'issued'"
                  t-on-click="() => this.endSupport(sup.id)">
            <t t-out="ic('x', 13)"/> <span>End it now</span>
          </button>
        </div>
        <div class="bztn-sup-why">"<t t-esc="sup.reason"/>"</div>
        <div class="bztn-sup-end" t-if="sup.end_reason" t-esc="sup.end_reason"/>
        <div class="bztn-sup-screens" t-if="sup.screens.length">
          <div class="t">Screens they opened</div>
          <div class="s" t-foreach="sup.screens" t-as="scr" t-key="scr.path">
            <span class="nm" t-esc="scr.name or scr.path"/>
            <span class="pt" t-esc="scr.path"/>
            <span class="ct" t-if="scr.count > 1">x<t t-esc="scr.count"/></span>
          </div>
        </div>
      </div>
    </div>

    <!-- WHO TO ASK. Drawn only when there is somebody: an empty contact card
         is a dead end wearing the clothes of a door. -->
    <div class="bzk-panel bztn-contact" t-if="hasContact">
      <div class="bzk-panel-h">
        <div class="bzk-h2">Need a hand?</div>
      </div>
      <div class="bztn-contact-rows">
        <a t-if="mailto" class="bzk-btn outline" t-att-href="mailto">
          <t t-out="ic('mail', 15)"/>
          <span t-esc="state.support_email"/>
        </a>
        <a t-if="state.platform_url" class="bzk-btn ghost"
           t-att-href="state.platform_url" target="_blank" rel="noreferrer">
          <t t-out="ic('external', 15)"/>
          <span>Open the platform</span>
        </a>
      </div>
    </div>

  </div>
</t>

</templates>
