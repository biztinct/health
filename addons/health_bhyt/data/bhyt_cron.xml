<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Config-gated (bhyt.generate_enabled, default OFF) batch backfill of
             claims for eligible completed+invoiced+bhyt_valid visits. Never
             marks ready (human review). Per-order savepoint (never-block). -->
        <record id="cron_bhyt_generate" model="ir.cron">
            <field name="name">BHYT: generate claims for eligible visits</field>
            <field name="model_id" ref="model_bhyt_claim"/>
            <field name="state">code</field>
            <field name="code">model.cron_bhyt_generate()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=15, second=0, microsecond=0))"/>
        </record>
    </data>
</odoo>
