<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_schedule_drag" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.schedule.drag</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="health_base.res_config_settings_view_form_health"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='health_base']" position="inside">
                <block title="Reschedule-by-Drag" name="health_schedule_drag_settings">
                    <setting id="schedule_drag_zns_setting" string="Reschedule ZNS template"
                             help="Zalo template id sent to the patient when their booking is rescheduled by drag. Empty → no patient notification. Rides health_messaging.enabled / dry_run.">
                        <field name="schedule_drag_zns_template_rescheduled"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
