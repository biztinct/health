<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Incident sequence (spec §5.9: prefix INC, padding 5). No other
         seeds — types are selections, not lookup rows, to keep the
         taxonomy stable for FHIR coding. -->
    <record id="seq_health_incident" model="ir.sequence">
        <field name="name">Incident</field>
        <field name="code">health.incident</field>
        <field name="prefix">INC</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

</odoo>
