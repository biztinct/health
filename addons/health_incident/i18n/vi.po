#. module: health_incident
#. odoo-python
#: code:addons/health_incident/models/health_incident.py:0
msgid "Only a reported incident can be put under review."
msgstr "Chỉ sự cố đã báo cáo mới có thể được đưa vào xem xét."

#. module: health_incident
#. odoo-python
#: code:addons/health_incident/models/health_incident.py:0
msgid "Only an incident under review can move to investigation."
msgstr "Chỉ sự cố đang xem xét mới có thể chuyển sang điều tra."

#. module: health_incident
#. odoo-python
#: code:addons/health_incident/models/health_incident.py:0
msgid "Assign an investigator before starting the investigation."
msgstr "Chỉ định người điều tra trước khi bắt đầu điều tra."

#. module: health_incident
#. odoo-python
#: code:addons/health_incident/models/health_incident.py:0
msgid "Record the root cause before assigning corrective actions."
msgstr "Ghi nhận nguyên nhân gốc trước khi giao hành động khắc phục."

#. module: health_incident
#. odoo-python
#: code:addons/health_incident/models/health_incident.py:0
msgid "Add at least one open corrective action before moving to actions assigned."
msgstr "Thêm ít nhất một hành động khắc phục đang mở trước khi chuyển sang đã giao hành động."

#. module: health_incident
#. odoo-python
#: code:addons/health_incident/models/health_incident.py:0
msgid "This incident cannot be closed: %(count)s corrective action(s) are still open."
msgstr "Không thể đóng sự cố này: còn %(count)s hành động khắc phục đang mở."

#. module: health_incident
#. odoo-python
#: code:addons/health_incident/models/health_incident.py:0
msgid "This incident is notifiable: record the notified authority and notification date before closing (compliance evidence)."
msgstr "Sự cố này phải báo cáo cơ quan chức năng: ghi nhận cơ quan đã báo cáo và ngày báo cáo trước khi đóng (bằng chứng tuân thủ)."

#. module: health_incident
#. odoo-python
#: code:addons/health_incident/models/health_incident.py:0
msgid "Fast-close is only available for severity 1-2 incidents."
msgstr "Đóng nhanh chỉ áp dụng cho sự cố mức độ 1-2."

#. module: health_incident
#. odoo-python
#: code:addons/health_incident/models/health_incident.py:0
msgid "Fast-close is only available from Reported or Under Review."
msgstr "Đóng nhanh chỉ áp dụng từ trạng thái Đã báo cáo hoặc Đang xem xét."

#. module: health_incident
#. odoo-python
#: code:addons/health_incident/models/health_incident.py:0
msgid "Only a closed incident can be reopened."
msgstr "Chỉ sự cố đã đóng mới có thể được mở lại."

#. module: health_incident
#. odoo-python
#: code:addons/health_incident/models/health_incident.py:0
msgid "Only managers may reopen a closed incident."
msgstr "Chỉ quản lý mới có thể mở lại sự cố đã đóng."

#. module: health_incident
#. odoo-python
#: code:addons/health_incident/models/health_incident_action.py:0
msgid "Only an open action can be started."
msgstr "Chỉ hành động đang mở mới có thể bắt đầu."

#. module: health_incident
#. odoo-python
#: code:addons/health_incident/models/health_incident_action.py:0
msgid "Only an open or in-progress action can be marked done."
msgstr "Chỉ hành động đang mở hoặc đang thực hiện mới có thể đánh dấu hoàn thành."

#. module: health_incident
#. odoo-python
