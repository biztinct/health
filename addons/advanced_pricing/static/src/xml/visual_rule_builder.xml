<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="advanced_pricing.VisualRuleBuilderTemplate" owl="1">
        <div class="visual-rule-builder">
            <!-- Header -->
            <div class="builder-header">
                <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
                    <h4 class="mb-0">
                        <i class="fa fa-puzzle-piece me-2"/>
                        Visual Rule Builder
                    </h4>
                    <div class="btn-group">
                        <button class="btn btn-sm btn-outline-secondary" t-on-click="clearWorkspace">
                            <i class="fa fa-trash"/> Clear
                        </button>
                        <button class="btn btn-sm btn-primary" t-on-click="saveRule">
                            <i class="fa fa-save"/> Save Rule
                        </button>
                        <button class="btn btn-sm btn-secondary" t-on-click="props.onCancel">
                            <i class="fa fa-times"/> Cancel
                        </button>
                    </div>
                </div>
            </div>

            <!-- Loading State -->
            <div t-if="state.isLoading" class="text-center p-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading Blockly...</span>
                </div>
                <p class="mt-3 text-muted">Initializing Visual Rule Builder...</p>
            </div>

            <!-- Main Content -->
            <div t-if="!state.isLoading" class="builder-content">
                <div class="row g-0 h-100">
                    <!-- Blockly Workspace -->
                    <div class="col-md-8">
                        <div class="blockly-container">
                            <!-- Templates Bar -->
                            <div class="templates-bar bg-light p-2 border-bottom">
                                <small class="text-muted me-3">Quick Templates:</small>
                                <button class="btn btn-sm btn-outline-primary me-2" 
                                        t-on-click="() => this.loadTemplate('distance_pricing')">
                                    Distance Pricing
                                </button>
                                <button class="btn btn-sm btn-outline-primary me-2" 
                                        t-on-click="() => this.loadTemplate('bulk_discount')">
                                    Bulk Discount
                                </button>
                            </div>
                            
                            <!-- Blockly Workspace Area -->
                            <div t-ref="blocklyDiv" class="blockly-workspace" style="height: 600px; width: 100%;"/>
                        </div>
                    </div>

                    <!-- Preview Panel -->
                    <div class="col-md-4 border-start">
                        <div class="preview-panel h-100">
                            <!-- Rule Preview -->
                            <div class="preview-header bg-light p-3 border-bottom">
                                <h6 class="mb-0">
                                    <i class="fa fa-eye me-2"/>
                                    Rule Preview
                                </h6>
                            </div>
                            
                            <div class="preview-content p-3">
                                <!-- Rule Name -->
                                <div class="mb-3">
                                    <label class="form-label">Rule Name:</label>
                                    <div class="fw-bold text-primary">
                                        <t t-esc="state.previewRule.name or 'Untitled Rule'"/>
                                    </div>
                                </div>

                                <!-- Generated Code -->
                                <div class="mb-3">
                                    <label class="form-label">Generated Logic:</label>
                                    <pre class="code-preview bg-light p-2 rounded small"><t t-esc="state.generatedCode or '// Build your rule using blocks'"/></pre>
                                </div>

                                <!-- Rule Description -->
                                <div class="mb-3">
                                    <label class="form-label">Description:</label>
                                    <div class="text-muted small">
                                        <t t-if="!state.generatedCode">
                                            Drag blocks from the left panel to build your pricing rule.
                                        </t>
                                        <t t-else="">
                                            This rule will be evaluated when processing prices.
                                        </t>
                                    </div>
                                </div>

                                <!-- Help Text -->
                                <div class="help-section mt-4">
                                    <h6 class="text-primary">
                                        <i class="fa fa-question-circle me-1"/>
                                        How to Build Rules:
                                    </h6>
                                    <ul class="small text-muted">
                                        <li>Start with a "Pricing Rule" block</li>
                                        <li>Add conditions from the "Conditions" category</li>
                                        <li>Define actions from the "Actions" category</li>
                                        <li>Use number blocks for values</li>
                                        <li>Connect blocks by dragging</li>
                                    </ul>
                                </div>

                                <!-- Example Rules -->
                                <div class="examples-section mt-4">
                                    <h6 class="text-primary">
                                        <i class="fa fa-lightbulb me-1"/>
                                        Example Rules:
                                    </h6>
                                    <div class="small text-muted">
                                        <strong>Distance Pricing:</strong><br/>
                                        If distance > 15km, add $50
                                        <br/><br/>
                                        <strong>Bulk Discount:</strong><br/>
                                        If quantity >= 10, apply 10% discount
                                        <br/><br/>
                                        <strong>Premium Time:</strong><br/>
                                        If time > 5PM, multiply by 1.5
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="advanced_pricing.VisualRuleBuilderActionTemplate" owl="1">
        <div class="visual-rule-builder-action">
            <VisualRuleBuilder 
                ruleData="state.ruleData"
                onSave.bind="onSaveRule"
                onCancel.bind="onCancel"
            />
        </div>
    </t>

</templates>