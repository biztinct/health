<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="advanced_pricing.PricingWidget">
        <div class="o_advanced_pricing_widget">
            <div class="card">
                <div class="card-header">
                    <h5 t-esc="this.t('Advanced Pricing Rules')"/>
                </div>
                <div class="card-body">
                    <t t-if="state.isLoading">
                        <div class="text-center">
                            <i class="fa fa-spinner fa-spin fa-2x"/>
                        </div>
                    </t>
                    <t t-else="">
                        <t t-if="state.rules.length === 0">
                            <div class="alert alert-info">
                                <t t-esc="this.t('No pricing rules configured.')"/>
                            </div>
                        </t>
                        <t t-else="">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th t-esc="this.t('Sequence')"/>
                                        <th t-esc="this.t('Name')"/>
                                        <th t-esc="this.t('Level')"/>
                                        <th t-esc="this.t('Type')"/>
                                        <th t-esc="this.t('Status')"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.rules" t-as="rule" t-key="rule.id">
                                        <tr>
                                            <td t-esc="rule.sequence"/>
                                            <td t-esc="rule.name"/>
                                            <td t-esc="this.t('Level') + ' ' + rule.level"/>
                                            <td t-esc="rule.rule_type"/>
                                            <td>
                                                <span t-att-class="rule.active ? 'badge bg-success' : 'badge bg-danger'"
                                                      t-esc="rule.active ? this.t('Active') : this.t('Inactive')"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </t>
                </div>
            </div>
        </div>
    </t>
    
    <t t-name="advanced_pricing.RuleBuilder">
        <div class="o_pricing_rule_builder">
            <div class="modal-header">
                <h5 class="modal-title" t-esc="this.t('Visual Rule Builder')"/>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label t-esc="this.t('Rule Name')"/>
                    <input type="text" class="form-control" t-model="state.ruleName"/>
                </div>
                <div class="form-group">
                    <label t-esc="this.t('Level')"/>
                    <select class="form-select" t-model="state.level">
                        <option value="1" t-esc="this.t('Level 1 - Base Rules')"/>
                        <option value="2" t-esc="this.t('Level 2 - Cascading Rules')"/>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" t-on-click="props.onClose">
                    <t t-esc="this.t('Cancel')"/>
                </button>
                <button type="button" class="btn btn-primary" t-on-click="saveRule">
                    <t t-esc="this.t('Save Rule')"/>
                </button>
            </div>
        </div>
    </t>
    
    <t t-name="advanced_pricing.Calculator">
        <div class="o_pricing_calculator">
            <div class="card">
                <div class="card-header">
                    <h5 t-esc="this.t('Price Calculator')"/>
                </div>
                <div class="card-body">
                    <t t-if="state.calculating">
                        <div class="text-center">
                            <i class="fa fa-spinner fa-spin fa-3x"/>
                        </div>
                    </t>
                    <t t-elif="state.error">
                        <div class="alert alert-danger">
                            <t t-esc="state.error"/>
                        </div>
                    </t>
                    <t t-elif="state.result">
                        <h2 class="text-primary">
                            <t t-esc="state.result"/>
                        </h2>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
