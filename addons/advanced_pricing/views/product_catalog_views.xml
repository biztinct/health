<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Booking Quote button to product catalog -->
    <record id="product_view_kanban_catalog_booking_quote" model="ir.ui.view">
        <field name="name">product.view.kanban.catalog.booking.quote</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_view_kanban_catalog"/>
        <field name="arch" type="xml">
            <!-- Add Booking Quote button inside templates -->
            <xpath expr="//templates" position="before">
                <div class="d-flex justify-content-between align-items-center mb-3 bg-light p-2 rounded" 
                     invisible="not context.get('order_id')">
                    <div class="d-flex align-items-center">
                        <h5 class="mb-0 me-3"><i class="fa fa-list"/> Product Catalog</h5>
                        <span class="text-muted">
                            Adding products to Healthcare Quote
                        </span>
                    </div>
                    <div>
                        <button name="action_return_to_healthcare_quote" 
                                string="Back to Booking Quote" icon="fa-medkit"
                                type="object" 
                                class="btn btn-primary"
                                help="Return to Healthcare Quote"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_view_search_catalog_catchment_area" model="ir.ui.view">
        <field name="name">product.view.search.catalog.catchment.area</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_view_search_catalog"/>
        <field name="arch" type="xml">
            <xpath expr="//searchpanel/field[@name='categ_id']" position="before">
                <field name="catalog_catchment_area"
                       string="Catchment Area"
                       icon="fa-map-marker"
                       enable_counters="1"/>
            </xpath>
        </field>
    </record>

    <!-- Price list details on the service form (both languages come from the
         price list upload; use the language switch to edit either). -->
    <record id="product_template_form_price_list" model="ir.ui.view">
        <field name="name">product.template.form.price.list</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Price List" name="price_list" invisible="type != 'service'">
                    <group>
                        <group>
                            <field name="price_item_code"/>
                            <field name="item_group"/>
                            <field name="marketing_service_line"/>
                            <field name="price_is_fee"/>
                            <field name="rounding_rule"/>
                        </group>
                        <group>
                            <field name="price_version"/>
                            <field name="price_valid_from"/>
                            <field name="price_valid_to"/>
                            <field name="price_updated_by"/>
                            <field name="price_updated_on"/>
                        </group>
                    </group>
                    <group>
                        <field name="price_change_reason"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
