<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Booking Quote button to product catalog -->
    <record id="product_view_kanban_catalog_booking_quote" model="ir.ui.view">
        <field name="name">product.view.kanban.catalog.booking.quote</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_view_kanban_catalog"/>
        <field name="arch" type="xml">
            <!-- Add Booking Quote button inside templates -->
            <xpath expr="//templates" position="before">
                <div class="d-flex justify-content-between align-items-center mb-3 bg-light p-2 rounded" 
                     invisible="not context.get('order_id')">
                    <div class="d-flex align-items-center">
                        <h5 class="mb-0 me-3">📋 Product Catalog</h5>
                        <span class="text-muted">
                            Adding products to Healthcare Quote
                        </span>
                    </div>
                    <div>
                        <button name="action_return_to_healthcare_quote" 
                                string="🏥 Back to Booking Quote" 
                                type="object" 
                                class="btn btn-primary"
                                help="Return to Healthcare Quote"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>