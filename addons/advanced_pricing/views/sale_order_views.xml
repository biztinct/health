<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_advanced_pricing" model="ir.ui.view">
        <field name="name">sale.order.form.advanced.pricing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pricelist_id']" position="after">
                <field name="use_advanced_pricing" invisible="1"/>
                <field name="fso_id" invisible="not fso_id"/>
                <field name="advanced_pricing_details" readonly="1" invisible="not use_advanced_pricing"/>
            </xpath>
            
            <!-- Add Advanced Pricing button to header -->
            <xpath expr="//header//button[@name='action_confirm'][1]" position="before">
                <button name="action_recalculate_advanced_prices" 
                        string="Recalc Pricing" 
                        type="object" 
                        class="btn-secondary"
                        invisible="not use_advanced_pricing"
                        help="Recalculate prices using advanced pricing rules"/>
            </xpath>
            
            <!-- Add pricing info to order lines (informational) -->
            <xpath expr="//field[@name='order_line']//control//button[@name='action_add_from_catalog']" position="after">
                <span invisible="not parent.use_advanced_pricing" 
                      class="text-muted px-2">
                    <i class="fa fa-bar-chart me-1"/> Advanced Pricing Active
                </span>
            </xpath>
            
            <notebook position="inside">
                <page string="Advanced Pricing" invisible="not use_advanced_pricing">
                    <group>
                        <group string="FSO Information">
                            <field name="fso_distance" readonly="1"/>
                            <field name="fso_appointment_time" readonly="1"/>
                            <field name="fso_service_type" readonly="1"/>
                            <field name="fso_service_location" readonly="1"/>
                            <field name="fso_urgency" readonly="1"/>
                            <field name="fso_priority" readonly="1"/>
                        </group>
                        <group string="Computed Factors">
                            <field name="is_weekend" readonly="1"/>
                            <field name="is_holiday" readonly="1"/>
                            <field name="is_after_hours" readonly="1"/>
                            <field name="appointment_hour" readonly="1"/>
                            <field name="service_units" readonly="1"/>
                            <field name="service_city" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="advanced_pricing_details" readonly="1" widget="html"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
    
    <!-- Add Catalog button to healthcare quote form -->
    <record id="view_healthcare_quote_form_catalog" model="ir.ui.view">
        <field name="name">healthcare.quote.form.catalog</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="health_fieldservice.view_healthcare_quote_form_custom"/>
        <field name="arch" type="xml">
            <!-- Add Back to Quotation button to header -->
            <xpath expr="//header" position="inside">
                <button name="action_draft" invisible="state != 'cancel'" type="object"
                        string="Back to Quotation" data-hotkey="w" class="btn btn-primary"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,sent,sale"/>
            </xpath>
            
            <!-- Add Catalog button after the order lines field -->
            <xpath expr="//field[@name='order_line']" position="after">
                <!-- Pricing breakdown (shown after Recalc Pricing) -->
                <field name="pricing_breakdown_html" nolabel="1" 
                       invisible="not pricing_breakdown_html"
                       class="mt-2 mb-2"/>
                
                <!-- Service Procedures section -->
                <div class="mt-3 mb-2"
                     style="background: linear-gradient(135deg, #f0fdfa 0%, #e0f7f1 100%); border: 1px solid #b2dfdb; border-radius: 12px; padding: 16px 20px;">
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
                        <span class="vu-section__icon" data-icon="syringe"/>
                        <span style="font-weight: 700; font-size: 14px; color: #00695C;">Service Procedures</span>
                        <span style="font-size: 11px; color: #78909c; margin-left: auto;">Updated by nurse after service delivery</span>
                    </div>
                    <group col="4">
                        <field name="injection_count" string="Injections"/>
                        <field name="medication_count" string="Medications"/>
                        <field name="wound_count" string="Wounds"/>
                        <field name="iv_fluid_count" string="IV Bags"/>
                    </group>
                </div>
                
                <div class="row mt-3">
                    <div class="col-12 text-center">
                        <button name="action_add_from_catalog"
                                string="Add from Catalog"
                                type="object"
                                class="btn btn-primary me-2" icon="fa-list"
                                context="{'order_id': id, 'child_field': 'order_line'}"
                                help="Add products from catalog"/>
                        <button name="action_recalculate_advanced_prices" 
                                string="Recalc Pricing" 
                                type="object" 
                                class="btn btn-secondary me-2" icon="fa-refresh"
                                help="Recalculate prices using advanced pricing rules"/>
                        <button name="action_post_service_recalc" 
                                string="Post-Service Recalc" 
                                type="object" 
                                class="btn btn-warning" icon="fa-calculator"
                                invisible="not context.get('invoicing_mode')"
                                help="Recalculate with actual procedure counts and create adjustment if needed"/>
                    </div>
                </div>
            </xpath>
            
            <!-- Add advanced pricing fields after the title -->
            <xpath expr="//div[@class='oe_title']" position="after">
                <group>
                    <field name="use_advanced_pricing" invisible="1"/>
                    <field name="fso_id" invisible="not fso_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
