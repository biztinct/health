<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Actions must be defined before menu items that reference them -->
    <record id="action_advanced_pricing_engines" model="ir.actions.act_window">
        <field name="name">Pricing Engines</field>
        <field name="res_model">advanced.pricing.engine</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <record id="action_advanced_pricing_rules" model="ir.actions.act_window">
        <field name="name">Pricing Rules</field>
        <field name="res_model">advanced.pricing.rule</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <record id="action_advanced_pricing_config" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">advanced.pricing.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Regular action for pricing rules (opens form view) -->
    <record id="action_pricing_rules_with_visual" model="ir.actions.act_window">
        <field name="name">Pricing Rules</field>
        <field name="res_model">advanced.pricing.rule</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_pricing_rule_list"/>
        <field name="search_view_id" ref="view_pricing_rule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first pricing rule!
            </p>
            <p>
                Pricing rules allow you to automatically adjust prices based on various conditions.
                Use the Visual Builder for an intuitive drag-and-drop experience.
            </p>
        </field>
    </record>

    <!-- Quick Edit action for pricing rules (inline editing) -->
    <record id="action_pricing_rules_quick_edit" model="ir.actions.act_window">
        <field name="name">Quick Edit Rules</field>
        <field name="res_model">advanced.pricing.rule</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_pricing_rule_list_quick_edit"/>
        <field name="search_view_id" ref="view_pricing_rule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first pricing rule!
            </p>
            <p>
                Quick edit pricing rules with inline editing. Click a cell to edit values directly.
                ⚠️ Editing approved rules will reset them to Draft status requiring re-approval.
            </p>
        </field>
    </record>

    <!-- Menu items referencing the actions above -->
    <menuitem id="menu_advanced_pricing_root" 
              name="Advanced Pricing" 
              parent="sale.sale_menu_root"
              sequence="15"/>
              
    <!-- Healthcare Advanced Pricelist Menu -->
    <menuitem id="menu_healthcare_advanced_pricelist" 
              name="Advanced Pricelist" 
              parent="health_base.menu_healthcare_root"
              sequence="27"
              groups="health_base.group_healthcare_manager,health_base.group_healthcare_admin,health_base.group_healthcare_owner"/>
    
    <!-- Healthcare Pricelist Submenus -->
    <menuitem id="menu_healthcare_pricing_engines" 
              name="Pricing Engines" 
              parent="menu_healthcare_advanced_pricelist"
              action="action_advanced_pricing_engines"
              sequence="10"
              groups="health_base.group_healthcare_manager,health_base.group_healthcare_admin,health_base.group_healthcare_owner"/>
    
    <menuitem id="menu_healthcare_pricing_rules" 
              name="Pricing Rules" 
              parent="menu_healthcare_advanced_pricelist"
              action="action_pricing_rules_with_visual"
              sequence="20"
              groups="health_base.group_healthcare_manager,health_base.group_healthcare_admin,health_base.group_healthcare_owner"/>
    
    <menuitem id="menu_healthcare_pricing_rules_quick_edit" 
              name="Quick Edit Rules" 
              parent="menu_healthcare_advanced_pricelist"
              action="action_pricing_rules_quick_edit"
              sequence="25"
              groups="health_base.group_healthcare_manager,health_base.group_healthcare_admin,health_base.group_healthcare_owner"/>
    
    <menuitem id="menu_pricing_engines" 
              name="Pricing Engines" 
              parent="menu_advanced_pricing_root"
              action="action_advanced_pricing_engines"
              sequence="10"/>
    
    <menuitem id="menu_pricing_rules" 
              name="Pricing Rules" 
              parent="menu_advanced_pricing_root"
              action="action_pricing_rules_with_visual"
              sequence="20"/>
    
    <menuitem id="menu_pricing_rules_quick_edit" 
              name="Quick Edit Rules" 
              parent="menu_advanced_pricing_root"
              action="action_pricing_rules_quick_edit"
              sequence="25"/>
    
    <menuitem id="menu_pricing_config" 
              name="Configuration" 
              parent="menu_advanced_pricing_root"
              action="action_advanced_pricing_config"
              sequence="30"/>

</odoo>