<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pricing_rule_form" model="ir.ui.view">
        <field name="name">advanced.pricing.rule.form</field>
        <field name="model">advanced.pricing.rule</field>
        <field name="arch" type="xml">
            <form string="Pricing Rule">
                <header>
                    <!-- Approval Status Bar -->
                    <field name="approval_status" widget="statusbar"
                           statusbar_visible="draft,pending,approved"/>

                    <!-- Draft actions -->
                    <button name="action_submit_for_approval" string="Submit for Approval"
                            type="object" class="oe_highlight"
                            invisible="approval_status != 'draft'"/>

                    <!-- Pending actions (Board only) -->
                    <button name="action_approve" string="Approve"
                            type="object" class="oe_highlight"
                            invisible="approval_status != 'pending'"
                            groups="health_base.group_healthcare_owner"/>
                    <button name="action_reject" string="Reject"
                            type="object" class="btn-danger"
                            invisible="approval_status != 'pending'"
                            groups="health_base.group_healthcare_owner"/>

                    <!-- Rejected actions -->
                    <button name="action_reset_to_draft" string="Reset to Draft"
                            type="object"
                            invisible="approval_status != 'rejected'"/>

                    <!-- Visual Builder -->
                    <button name="action_open_visual_builder" type="object"
                            string="🎨 Visual Builder" class="btn-primary"
                            help="Open drag-and-drop visual rule builder"/>
                </header>
                <sheet>
                    <!-- Warning banner for non-approved rules -->
                    <div class="alert alert-warning" role="alert"
                         invisible="approval_status == 'approved'">
                        <strong>⚠️ This rule will NOT be used in pricing calculations</strong>
                        <span invisible="approval_status != 'draft'"> - Submit for board approval to enable pricing</span>
                        <span invisible="approval_status != 'pending'"> - Awaiting board approval before it can be used</span>
                        <span invisible="approval_status != 'rejected'"> - Rule has been rejected and cannot be used</span>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="approval_status != 'approved'">
                        <strong>✅ This rule is approved</strong> - It will be used in pricing calculations when active (not archived).
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_visual_rule" type="object" 
                                class="oe_stat_button" icon="fa-puzzle-piece"
                                invisible="rule_type == 'visual'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Create</span>
                                <span class="o_stat_text">Visual Rule</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Rule Name"/>
                        </h1>
                    </div>
                    
                    <!-- Approval Information -->
                    <group string="Approval Status"
                           invisible="approval_status == 'draft'">
                        <field name="approved_by" invisible="approval_status != 'approved'"/>
                        <field name="approval_date" invisible="approval_status != 'approved'"/>
                        <field name="approval_notes"/>
                        <field name="rejection_reason"
                               invisible="approval_status != 'rejected'"
                               class="text-danger"/>
                    </group>

                    <group>
                        <group string="Basic Information">
                            <field name="engine_id"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Rule Configuration">
                            <field name="level"/>
                            <field name="rule_type"/>
                        </group>
                    </group>
                    
                    <group string="Product Selection">
                        <field name="applied_on"/>
                        <field name="categ_id" 
                               invisible="applied_on != '2_product_category'"
                               domain="[('parent_id', '=', False)]"
                               options="{'no_create': True}"/>
                        <field name="product_tmpl_id" 
                               invisible="applied_on != '1_product'"
                               domain="[('sale_ok', '=', True)]"
                               options="{'no_create': True}"/>
                        <field name="product_id" 
                               invisible="applied_on != '0_product_variant'"
                               domain="[('sale_ok', '=', True)]"
                               options="{'no_create': True}"/>
                    </group>
                    
                    <notebook>
                        <page string="General Conditions" invisible="1">
                            <group>
                                <field name="condition_field"/>
                                <field name="condition_operator"/>
                                <field name="condition_value"/>
                            </group>
                        </page>
                        <page string="Booking Conditions">
                            <group>
                                <group string="Distance &amp; Time">
                                    <field name="distance_min" placeholder="Leave blank to ignore"/>
                                    <field name="distance_max" placeholder="Leave blank to ignore"/>
                                    <field name="appointment_hour_min" placeholder="Leave blank to ignore"/>
                                    <field name="appointment_hour_max" placeholder="Leave blank to ignore"/>
                                </group>
                                <group string="Time-based Conditions">
                                    <field name="is_weekend_required"/>
                                    <field name="is_holiday_required"/>
                                    <field name="is_after_hours_required"/>
                                </group>
                            </group>
                            <group>
                                <group string="Service Details">
                                    <field name="service_type"/>
                                    <field name="service_location"/>
                                    <field name="urgency_level"/>
                                    <field name="priority"/>
                                </group>
                                <group string="Quantity &amp; Location">
                                    <field name="service_units_min" placeholder="Leave blank to ignore"/>
                                    <field name="service_units_max" placeholder="Leave blank to ignore"/>
                                    <field name="service_city" placeholder="Leave blank to ignore"/>
                                </group>
                            </group>
                        </page>
                        <page string="Actions">
                            <group>
                                <field name="action_type"/>
                                <field name="action_value"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Search View with Filters -->
    <record id="view_pricing_rule_search" model="ir.ui.view">
        <field name="name">advanced.pricing.rule.search</field>
        <field name="model">advanced.pricing.rule</field>
        <field name="arch" type="xml">
            <search string="Search Pricing Rules">
                <field name="name"/>
                <field name="engine_id"/>
                <field name="applied_on"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('approval_status', '=', 'draft')]"/>
                <filter string="Pending Approval" name="pending" domain="[('approval_status', '=', 'pending')]"/>
                <filter string="Approved" name="approved" domain="[('approval_status', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('approval_status', '=', 'rejected')]"/>
                <separator/>
                <group>
                    <filter string="Approval Status" name="group_approval_status" context="{'group_by': 'approval_status'}"/>
                    <filter string="Engine" name="group_engine" context="{'group_by': 'engine_id'}"/>
                    <filter string="Rule Type" name="group_type" context="{'group_by': 'rule_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Regular List View (No Inline Editing) -->
    <record id="view_pricing_rule_list" model="ir.ui.view">
        <field name="name">advanced.pricing.rule.list</field>
        <field name="model">advanced.pricing.rule</field>
        <field name="arch" type="xml">
            <list string="Pricing Rules" default_order="sequence"
                  decoration-success="approval_status == 'approved'"
                  decoration-warning="approval_status == 'pending'"
                  decoration-danger="approval_status == 'rejected'"
                  decoration-muted="approval_status == 'draft'">
                <header>
                    <button name="action_create_visual_rule" type="object"
                            string="🎨 Create Visual Rule" class="btn-primary"
                            help="Create a new visual pricing rule using drag-and-drop builder"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="approval_status" widget="badge"
                       decoration-success="approval_status == 'approved'"
                       decoration-warning="approval_status == 'pending'"
                       decoration-danger="approval_status == 'rejected'"
                       decoration-info="approval_status == 'draft'"/>
                <field name="engine_id"/>
                <field name="applied_on"/>
                <field name="level"/>
                <field name="rule_type"/>
                <field name="condition_field" optional="show"/>
                <field name="condition_operator" optional="show"/>
                <field name="condition_value" optional="show"/>
                <field name="action_type"/>
                <field name="action_value"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
                <button name="action_open_visual_builder" type="object" 
                        string="Visual Builder" class="btn-primary btn-sm"
                        invisible="rule_type != 'visual'"
                        icon="fa-puzzle-piece"/>
            </list>
        </field>
    </record>
    
    <!-- Quick Edit List View (Inline Editing) -->
    <record id="view_pricing_rule_list_quick_edit" model="ir.ui.view">
        <field name="name">advanced.pricing.rule.list.quick.edit</field>
        <field name="model">advanced.pricing.rule</field>
        <field name="arch" type="xml">
            <list string="Quick Edit Pricing Rules" editable="bottom" default_order="sequence"
                  decoration-success="approval_status == 'approved'"
                  decoration-warning="approval_status == 'pending'"
                  decoration-danger="approval_status == 'rejected'"
                  decoration-muted="approval_status == 'draft'">
                <header>
                    <button name="action_create_visual_rule" type="object"
                            string="🎨 Create Visual Rule" class="btn-primary"
                            help="Create a new visual pricing rule using drag-and-drop builder"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="name" required="1"/>
                <field name="approval_status" widget="badge" readonly="1"
                       decoration-success="approval_status == 'approved'"
                       decoration-warning="approval_status == 'pending'"
                       decoration-danger="approval_status == 'rejected'"
                       decoration-info="approval_status == 'draft'"/>
                <field name="engine_id" options="{'no_create': True}"/>
                <field name="applied_on" optional="show"/>
                <field name="level"/>
                <field name="rule_type"/>
                <field name="condition_field" optional="show"/>
                <field name="condition_operator" optional="show"/>
                <field name="condition_value" optional="show"/>
                <field name="action_type" optional="show"/>
                <field name="action_value" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
</odoo>
