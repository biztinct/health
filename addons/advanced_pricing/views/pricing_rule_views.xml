<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pricing_rule_form" model="ir.ui.view">
        <field name="name">advanced.pricing.rule.form</field>
        <field name="model">advanced.pricing.rule</field>
        <field name="arch" type="xml">
            <form string="Pricing Rule">
                <header>
                    <!-- Approval Status Bar -->
                    <field name="approval_status" widget="statusbar"
                           statusbar_visible="draft,pending,approved"/>

                    <!-- Draft actions -->
                    <button name="action_submit_for_approval" string="Submit for Approval"
                            type="object" class="oe_highlight"
                            invisible="approval_status != 'draft'"/>

                    <!-- Pending actions (Board only) -->
                    <button name="action_approve" string="Approve"
                            type="object" class="oe_highlight"
                            invisible="approval_status != 'pending'"
                            groups="health_base.group_healthcare_owner"/>
                    <button name="action_reject" string="Reject"
                            type="object" class="btn-danger"
                            invisible="approval_status != 'pending'"
                            groups="health_base.group_healthcare_owner"/>

                    <!-- Rejected actions -->
                    <button name="action_reset_to_draft" string="Reset to Draft"
                            type="object"
                            invisible="approval_status != 'rejected'"/>
                </header>
                <sheet>
                    <!-- Warning banner for non-approved rules -->
                    <div class="alert alert-warning" role="alert"
                         invisible="approval_status == 'approved'">
                        <strong><i class="fa fa-exclamation-triangle"/> This rule will NOT be used in pricing calculations</strong>
                        <span invisible="approval_status != 'draft'"> - Submit for board approval to enable pricing</span>
                        <span invisible="approval_status != 'pending'"> - Awaiting board approval before it can be used</span>
                        <span invisible="approval_status != 'rejected'"> - Rule has been rejected and cannot be used</span>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="approval_status != 'approved'">
                        <strong><i class="fa fa-check-circle"/> This rule is approved</strong> - It will be used in pricing calculations when active (not archived).
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Rule Name"/>
                        </h1>
                    </div>

                    <!-- Live plain-language summary: FOR … WHEN … THEN … -->
                    <field name="rule_summary_html" nolabel="1" class="apr-summary-wrap"/>

                    <!-- Approval Information -->
                    <group string="Approval Status"
                           invisible="approval_status == 'draft'">
                        <field name="approved_by" invisible="approval_status != 'approved'"/>
                        <field name="approval_date" invisible="approval_status != 'approved'"/>
                        <field name="approval_notes"/>
                        <field name="rejection_reason"
                               invisible="approval_status != 'rejected'"
                               class="text-danger"/>
                    </group>

                    <!-- ① SCOPE -->
                    <div class="apr-section apr-section--scope">
                        <div class="apr-section__head">
                            <span class="apr-section__step">1</span>
                            <div>
                                <div class="apr-section__title">What this rule prices</div>
                                <div class="apr-section__sub">The pricing engine, region and product this rule applies to.</div>
                            </div>
                        </div>
                        <group>
                            <group>
                                <field name="engine_id"/>
                                <field name="region" placeholder="e.g., Hanoi, HCMC"/>
                                <field name="item_code"/>
                            </group>
                            <group>
                                <field name="level" widget="radio"/>
                                <field name="sequence"/>
                                <field name="active" invisible="1"/>
                                <field name="rule_type" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="applied_on" widget="radio" options="{'horizontal': true}"/>
                            <field name="categ_id"
                                   invisible="applied_on != '2_product_category'"
                                   domain="[('parent_id', '=', False)]"
                                   options="{'no_create': True}"/>
                            <field name="product_tmpl_id"
                                   invisible="applied_on != '1_product'"
                                   domain="[('sale_ok', '=', True)]"
                                   options="{'no_create': True}"/>
                            <field name="product_id"
                                   invisible="applied_on != '0_product_variant'"
                                   domain="[('sale_ok', '=', True)]"
                                   options="{'no_create': True}"/>
                        </group>
                    </div>

                    <!-- ② WHEN -->
                    <div class="apr-section apr-section--when">
                        <div class="apr-section__head">
                            <span class="apr-section__step">2</span>
                            <div>
                                <div class="apr-section__title">When does it apply?</div>
                                <div class="apr-section__sub">Set only the conditions you need — blank/unchecked is ignored. Every condition you set must match for the rule to fire.</div>
                            </div>
                        </div>
                        <group>
                            <group string="Visit &amp; time">
                                <field name="requires_home_service" string="Only at the client's home"/>
                                <field name="service_location" string="Service location"/>
                                <field name="service_type" string="Service type"/>
                                <field name="is_after_hours_or_weekend" string="After-hours or weekend"/>
                                <field name="is_after_hours_required" string="After hours only"/>
                                <field name="is_weekend_required" string="Weekends only"/>
                                <field name="is_holiday_required" string="Holidays only"/>
                                <field name="holiday_type" string="Holiday type" invisible="not is_holiday_required"/>
                            </group>
                            <group string="Distance, hours &amp; quantities">
                                <field name="distance_min" string="Min distance (km)" placeholder="ignore"/>
                                <field name="distance_max" string="Max distance (km)" placeholder="ignore"/>
                                <field name="appointment_hour_min" string="From hour (0–23)" placeholder="ignore"/>
                                <field name="appointment_hour_max" string="To hour (0–23)" placeholder="ignore"/>
                                <field name="wound_count_min" string="Min wounds" placeholder="ignore"/>
                                <field name="injection_count_min" string="Min injections" placeholder="ignore"/>
                                <field name="iv_fluid_count_min" string="Min IV bags" placeholder="ignore"/>
                                <field name="medication_count_min" string="Min medications" placeholder="ignore"/>
                            </group>
                        </group>
                        <div class="apr-advanced-toggle">
                            <field name="show_advanced_conditions"/>
                        </div>
                        <group string="Advanced conditions" invisible="not show_advanced_conditions">
                            <group>
                                <field name="urgency_level"/>
                                <field name="priority"/>
                                <field name="service_units_min" string="Min service units" placeholder="ignore"/>
                                <field name="service_units_max" string="Max service units" placeholder="ignore"/>
                                <field name="service_city" placeholder="ignore"/>
                                <field name="wound_count_max" string="Max wounds" placeholder="ignore"/>
                            </group>
                            <group>
                                <field name="requires_other_service_same_visit"/>
                                <field name="requires_multi_client_same_location"/>
                                <field name="requires_bilingual_provider"/>
                                <field name="is_repeat_booking"/>
                                <field name="is_manual_quote"/>
                            </group>
                            <group string="Validity (optional)">
                                <field name="valid_from"/>
                                <field name="valid_to"/>
                            </group>
                            <group string="Generic condition (rarely used)">
                                <field name="condition_field"/>
                                <field name="condition_operator"/>
                                <field name="condition_value"/>
                            </group>
                            <group string="Metadata">
                                <field name="trigger_source"/>
                                <field name="data_required"/>
                                <field name="notes"/>
                            </group>
                        </group>
                    </div>

                    <!-- ③ THEN -->
                    <div class="apr-section apr-section--then">
                        <div class="apr-section__head">
                            <span class="apr-section__step">3</span>
                            <div>
                                <div class="apr-section__title">What price change?</div>
                                <div class="apr-section__sub">How this rule changes the catalog price when it matches.</div>
                            </div>
                        </div>
                        <group>
                            <field name="action_type" widget="radio"/>
                            <field name="action_value"/>
                            <field name="per_unit_field"
                                   invisible="action_type != 'per_unit'"/>
                        </group>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Search View with Filters -->
    <record id="view_pricing_rule_search" model="ir.ui.view">
        <field name="name">advanced.pricing.rule.search</field>
        <field name="model">advanced.pricing.rule</field>
        <field name="arch" type="xml">
            <search string="Search Pricing Rules">
                <field name="name"/>
                <field name="engine_id"/>
                <field name="applied_on"/>
                <field name="region"/>
                <field name="item_code"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Hanoi" name="hanoi" domain="[('region', 'ilike', 'hanoi')]"/>
                <filter string="HCMC" name="hcmc" domain="[('region', 'ilike', 'hcmc')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('approval_status', '=', 'draft')]"/>
                <filter string="Pending Approval" name="pending" domain="[('approval_status', '=', 'pending')]"/>
                <filter string="Approved" name="approved" domain="[('approval_status', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('approval_status', '=', 'rejected')]"/>
                <separator/>
                <group>
                    <filter string="Region" name="group_region" context="{'group_by': 'region'}"/>
                    <filter string="Approval Status" name="group_approval_status" context="{'group_by': 'approval_status'}"/>
                    <filter string="Engine" name="group_engine" context="{'group_by': 'engine_id'}"/>
                    <filter string="Rule Type" name="group_type" context="{'group_by': 'rule_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Regular List View (No Inline Editing) -->
    <record id="view_pricing_rule_list" model="ir.ui.view">
        <field name="name">advanced.pricing.rule.list</field>
        <field name="model">advanced.pricing.rule</field>
        <field name="arch" type="xml">
            <list string="Pricing Rules" default_order="sequence"
                  decoration-success="approval_status == 'approved'"
                  decoration-warning="approval_status == 'pending'"
                  decoration-danger="approval_status == 'rejected'"
                  decoration-muted="approval_status == 'draft'">
                <header>
                    <button name="%(action_pricing_rule_bulk_submit)d" type="action"
                            string="Submit for Approval" class="btn-primary" icon="fa-paper-plane"
                            display="always"
                            help="Bulk submit draft pricing rules for board approval"/>
                    <button name="%(action_pricing_rule_bulk_approve)d" type="action"
                            string="Approve" class="btn-success" icon="fa-check"
                            display="always"
                            groups="health_base.group_healthcare_owner"
                            help="Bulk approve pending pricing rules"/>
                    <button name="%(action_pricing_import_wizard)d" type="action"
                            string="Import Price List" class="btn-secondary" icon="fa-download"
                            display="always"
                            help="Import products and pricing rules from Excel file"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="region" optional="show"/>
                <field name="item_code" optional="show"/>
                <field name="approval_status" widget="badge"
                       decoration-success="approval_status == 'approved'"
                       decoration-warning="approval_status == 'pending'"
                       decoration-danger="approval_status == 'rejected'"
                       decoration-info="approval_status == 'draft'"/>
                <field name="engine_id"/>
                <field name="applied_on"/>
                <field name="level"/>
                <field name="rule_type"/>
                <field name="condition_field" optional="show"/>
                <field name="condition_operator" optional="show"/>
                <field name="condition_value" optional="show"/>
                <field name="action_type"/>
                <field name="action_value"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
    
    <!-- Quick Edit List View (Inline Editing) -->
    <record id="view_pricing_rule_list_quick_edit" model="ir.ui.view">
        <field name="name">advanced.pricing.rule.list.quick.edit</field>
        <field name="model">advanced.pricing.rule</field>
        <field name="arch" type="xml">
            <list string="Quick Edit Pricing Rules" editable="bottom" default_order="sequence"
                  decoration-success="approval_status == 'approved'"
                  decoration-warning="approval_status == 'pending'"
                  decoration-danger="approval_status == 'rejected'"
                  decoration-muted="approval_status == 'draft'">
                <header>
                    <button name="%(action_pricing_rule_bulk_submit)d" type="action"
                            string="Submit for Approval" class="btn-primary" icon="fa-paper-plane"
                            display="always"
                            help="Bulk submit draft pricing rules for board approval"/>
                    <button name="%(action_pricing_rule_bulk_approve)d" type="action"
                            string="Approve" class="btn-success" icon="fa-check"
                            display="always"
                            groups="health_base.group_healthcare_owner"
                            help="Bulk approve pending pricing rules"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="name" required="1"/>
                <field name="approval_status" widget="badge" readonly="1"
                       decoration-success="approval_status == 'approved'"
                       decoration-warning="approval_status == 'pending'"
                       decoration-danger="approval_status == 'rejected'"
                       decoration-info="approval_status == 'draft'"/>
                <field name="engine_id" options="{'no_create': True}"/>
                <field name="applied_on" optional="show"/>
                <field name="level"/>
                <field name="rule_type"/>
                <field name="condition_field" optional="show"/>
                <field name="condition_operator" optional="show"/>
                <field name="condition_value" optional="show"/>
                <field name="action_type" optional="show"/>
                <field name="action_value" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
</odoo>
