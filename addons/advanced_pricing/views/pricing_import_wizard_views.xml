<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pricing_import_wizard_form" model="ir.ui.view">
        <field name="name">advanced.pricing.import.wizard.form</field>
        <field name="model">advanced.pricing.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Price List">
                <field name="state" invisible="1"/>
                <div class="text-muted mb-2" invisible="state == 'done'">
                    Upload one price list workbook per region (a services sheet and an
                    adjustments sheet). Columns are found by their header names, so their
                    order does not matter. Press <b>Check File</b> first to see what would
                    change without saving anything.
                </div>
                <group invisible="state == 'done'">
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="engine_id" options="{'no_create': True}"/>
                    <field name="import_type"/>
                    <field name="replace_existing"/>
                    <field name="approve_rules" groups="health_base.group_healthcare_owner"/>
                </group>
                <group invisible="not import_log">
                    <field name="import_log" widget="text" readonly="1" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_check" string="Check File" type="object"
                            class="btn-secondary" invisible="state == 'done'"/>
                    <button name="import_rules" string="Import" type="object"
                            class="oe_highlight" invisible="state == 'done'"/>
                    <button string="Close" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open import wizard -->
    <record id="action_pricing_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Price List</field>
        <field name="res_model">advanced.pricing.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
