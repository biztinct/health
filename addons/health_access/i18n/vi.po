#. module: health_access
#. odoo-python
#: code:addons/health_access/wizard/new_person.py:0
msgid ""
"\"%(role)s\" would carry %(bad)s — the administrator permission for the "
"whole system. It is never given out from this screen."
msgstr ""
"\"%(role)s\" sẽ mang theo %(bad)s — quyền quản trị toàn hệ thống. Quyền này "
"không bao giờ được trao từ màn hình này."

#. module: health_access
#. odoo-python
#: code:addons/health_access/wizard/new_person.py:0
msgid ""
"\"%s\" does not hand out anything yet, so giving it to somebody would give "
"them nothing."
msgstr ""
"\"%s\" chưa trao quyền gì, nên giao nó cho ai đó cũng không cho họ được gì."

#. module: health_access
#. odoo-python
#: code:addons/health_access/wizard/new_person.py:0
msgid "%(who)s can sign in as %(login)s and holds \"%(role)s\"."
msgstr "%(who)s có thể đăng nhập bằng %(login)s và đang giữ \"%(role)s\"."

#. module: health_access
#. odoo-python
#: code:addons/health_access/wizard/new_person.py:0
msgid ""
"%(who)s can sign in as %(login)s and holds \"%(role)s\". They have no "
"password yet — send them a reset from their card."
msgstr ""
"%(who)s có thể đăng nhập bằng %(login)s và đang giữ \"%(role)s\". Họ chưa có"
" mật khẩu — hãy gửi cho họ liên kết đặt lại từ thẻ của họ."

#. module: health_access
#. odoo-python
#: code:addons/health_access/wizard/new_person.py:0
msgid ""
"%(who)s can sign in as %(login)s. They hold no role yet — give them one from"
" their card whenever you are ready."
msgstr ""
"%(who)s có thể đăng nhập bằng %(login)s. Họ chưa giữ vai trò nào — hãy giao "
"cho họ một vai trò từ thẻ của họ khi bạn sẵn sàng."

#. module: health_access
#. odoo-python
#: code:addons/health_access/wizard/set_job.py:0
msgid ""
"%(who)s has no job on their record any more, and \"%(what)s\" was taken "
"back."
msgstr ""
"Hồ sơ của %(who)s không còn công việc nào, và \"%(what)s\" đã được thu hồi."

#. module: health_access
#. odoo-python
#: code:addons/health_access/wizard/set_job.py:0
msgid "%(who)s is already employed as %(what)s."
msgstr "%(who)s đã đang làm %(what)s."

#. module: health_access
#. odoo-python
#: code:addons/health_access/wizard/set_job.py:0
msgid "%(who)s is now employed as \"%(what)s\", and holds it."
msgstr "%(who)s giờ làm \"%(what)s\" và đang giữ vai trò đó."

#. module: health_access
#. odoo-python
#: code:addons/health_access/models/access_facade.py:0
msgid "%s can sign in again."
msgstr "%s có thể đăng nhập lại."

#. module: health_access
#. odoo-python
#: code:addons/health_access/models/access_facade.py:0
msgid ""
"%s has a login but no staff record. Add one from the staff list and it will "
"open from here afterwards."
msgstr ""
"%s có tài khoản đăng nhập nhưng chưa có hồ sơ nhân viên. Hãy thêm hồ sơ từ "
"danh sách nhân viên, sau đó có thể mở hồ sơ từ đây."

#. module: health_access
#. odoo-python
#: code:addons/health_access/models/access_facade.py:0
msgid ""
"%s has no email address on their record, so there is nowhere to send the "
"link. Add one first."
msgstr ""
"Hồ sơ của %s chưa có địa chỉ email, nên không có nơi nào để gửi liên kết. "
"Hãy thêm email trước."

#. module: health_access
#. odoo-python
#: code:addons/health_access/models/access_facade.py:0
msgid "%s is already able to sign in."
msgstr "%s đã có thể đăng nhập."

#. module: health_access
#. odoo-python
#: code:addons/health_access/models/access_facade.py:0
msgid "%s is already switched off."
msgstr "%s đã bị tắt rồi."

#. module: health_access
#. odoo-python
#: code:addons/health_access/models/res_users.py:0
msgid "%s is no longer their job."
msgstr "%s không còn là công việc của họ."

#. module: health_access
#. odoo-python
#: code:addons/health_access/models/access_facade.py:0
msgid ""
"%s is switched off. They cannot sign in, and everything they did is still "
"here."
msgstr ""
"%s đã bị tắt. Họ không thể đăng nhập, và mọi việc họ đã làm vẫn còn ở đây."

#. module: health_access
#. odoo-python
#: code:addons/health_access/models/access_facade.py:0
msgid ""
"%s is the system administrator for this box. Switching them off is not "
"something this screen does — it would leave the system with nobody able to "
"fix it."
msgstr ""
"%s là quản trị viên hệ thống của máy chủ này. Màn hình này không tắt người "
"đó — làm vậy sẽ khiến hệ thống không còn ai có thể sửa lỗi."

#. module: health_access
#. odoo-python
#: code:addons/health_access/models/access_facade.py:0
msgid ""
"%s is the system administrator for this box. Their password is reset on "
