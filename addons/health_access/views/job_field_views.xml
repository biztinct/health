<?xml version="1.0" encoding="utf-8"?>
<!-- ======================================================================
     THE JOB, ON THE SCREENS THAT ASK ABOUT IT.

     WHY THESE FRAGMENTS LIVE HERE AND NOT WHERE THE FORMS DO. They name
     `job_role_id` and the flags computed from it, and those are put on the
     models by THIS module. A view in `health_base` or `health_fieldservice`
     naming them would refuse to load on a database without the Access home,
     and those two modules are the root of the product's tree — they have to
     keep working on their own. So the forms stay where they are and the job
     is added to them from up here.
     ====================================================================== -->
<odoo>

    <!-- ============================================== the login's own form -->
    <record id="view_users_form_job" model="ir.ui.view">
        <field name="name">res.users.form.job</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="health_base.view_users_form_healthcare"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='healthcare_settings']"
                   position="inside">
                <field name="job_role_id"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="is_doctor_role" invisible="1"/>
                <field name="is_nurse_role" invisible="1"/>
                <field name="is_duty_doctor" invisible="not is_doctor_role"/>
                <field name="is_head_nurse" invisible="not is_nurse_role"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================== the staff record ===== -->
    <record id="view_healthcare_staff_form_job" model="ir.ui.view">
        <field name="name">healthcare.staff.form.job</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id"
               ref="health_fieldservice.view_healthcare_staff_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='healthcare_role_status']/field[@name='user_id']"
                   position="after">
                <field name="job_role_id" string="Employed as"
                       readonly="not user_id"
                       options="{'no_create': True, 'no_open': True}"
                       help="What this person is employed as. It decides what the schedule, the staff pickers and the reports call them — and it gives them that role. It can be set once they have a login."/>
                <field name="is_doctor_role" invisible="1"/>
                <field name="is_nurse_role" invisible="1"/>
                <field name="is_duty_doctor" invisible="not is_doctor_role"/>
                <field name="is_head_nurse" invisible="not is_nurse_role"/>
            </xpath>
        </field>
    </record>

    <record id="view_healthcare_staff_list_job" model="ir.ui.view">
        <field name="name">healthcare.staff.list.job</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id"
               ref="health_fieldservice.view_healthcare_staff_list"/>
        <field name="arch" type="xml">
            <field name="job_id" position="after">
                <field name="access_role_display" string="Employed as"/>
            </field>
        </field>
    </record>

    <!-- ============================ the picker that used to narrow itself === -->
    <!-- `health.facility.facility_manager_id` carried this domain on the field
         itself until the flag it reads moved up here with the job. Same
         narrowing, same screen; it simply cannot be declared in a module that
         does not know the field exists. -->
    <record id="view_health_facility_form_manager" model="ir.ui.view">
        <field name="name">health.facility.form.manager.domain</field>
        <field name="model">health.facility</field>
        <field name="inherit_id" ref="health_base.view_health_facility_form"/>
        <field name="arch" type="xml">
            <field name="facility_manager_id" position="attributes">
                <attribute name="domain">[('is_om_role', '=', True)]</attribute>
            </field>
        </field>
    </record>

    <!-- ============================================== the role's own form ===
         WHAT A ROLE COUNTS AS, where the role is edited (AR-2). The field has
         been on the model since the job was split from the permissions, and
         it was only ever set by a one-off reading of the role's name — so a
         clinic that added a tenth role had no way to say it is a nursing job.
         Writing it recomputes the job flags of everybody employed as it
         (`res.users._compute_user_role_flags` depends on it). -->
    <record id="view_biz_access_role_form_clinical_kind" model="ir.ui.view">
        <field name="name">biz.access.role.form.clinical.kind</field>
        <field name="model">biz.access.role</field>
        <field name="inherit_id" ref="biz_access.view_biz_access_role_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='area']" position="after">
                <field name="clinical_kind"
                       help="Which job flags the people whose job is this role get: whether the roster, the staff pickers and the reports count them as a doctor, a nurse or an operations manager."/>
            </xpath>
        </field>
    </record>

</odoo>
