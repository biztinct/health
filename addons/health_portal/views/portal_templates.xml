<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Self-contained styles (no website/backend assets); flat mono palette. -->
    <template id="portal_styles" name="My Care Styles">
        <style>
            :root { --ink:#1f2933; --muted:#66707a; --line:#e4e7eb;
                    --accent:#0b6e6e; --bg:#f5f7f8; --card:#ffffff; }
            * { box-sizing:border-box; }
            body { margin:0; background:var(--bg); color:var(--ink);
                   font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
                   font-size:15px; line-height:1.45; -webkit-text-size-adjust:100%; }
            .wrap { max-width:560px; margin:0 auto; padding:16px 14px 40px; }
            .brand { display:flex; align-items:center; gap:8px; padding:6px 0 6px; }
            .brand .dot { width:10px; height:10px; border-radius:50%; background:var(--accent); }
            .brand h1 { font-size:18px; margin:0; font-weight:700; }
            .who { color:var(--muted); font-size:13px; margin:2px 0 16px; }
            .sec { font-size:13px; font-weight:700; text-transform:uppercase;
                   letter-spacing:.04em; color:var(--muted); margin:20px 0 8px; }
            .card { background:var(--card); border:1px solid var(--line);
                    border-radius:12px; padding:12px 14px; margin-bottom:10px; }
            .row1 { display:flex; justify-content:space-between; align-items:baseline; gap:8px; }
            .svc { font-weight:600; }
            .when { color:var(--accent); font-weight:600; white-space:nowrap; }
            .meta { color:var(--muted); font-size:13px; margin-top:2px; }
            .chip { display:inline-block; font-size:11px; font-weight:700;
                    padding:2px 8px; border-radius:20px; background:#eef2f2; color:var(--accent); }
            .empty { color:var(--muted); font-size:14px; padding:14px 2px; }
            .foot { color:var(--muted); font-size:12px; text-align:center; margin-top:26px; }
            a.nav, a.back { color:var(--accent); text-decoration:none; font-weight:600; font-size:14px; }
            a.nav { display:inline-block; margin:2px 0 4px; }
            a.back { display:inline-block; margin-bottom:12px; }
            a.card-link { text-decoration:none; color:inherit; display:block; }
            .btn { display:inline-block; background:var(--accent); color:#fff;
                   text-decoration:none; font-weight:600; font-size:14px;
                   padding:10px 16px; border-radius:10px; margin-top:8px; }
            .nsec { margin:14px 0; }
            .nsec .lbl { font-size:12px; font-weight:700; text-transform:uppercase;
                         letter-spacing:.03em; color:var(--muted); margin-bottom:3px; }
            .nsec .val { white-space:pre-line; }
            .crow { display:flex; justify-content:space-between; align-items:center; gap:10px; }
            .crow .lbl2 { font-weight:600; }
            .on { color:#1b7a3d; font-weight:700; font-size:13px; }
            .off { color:var(--muted); font-weight:600; font-size:13px; }
            form.inline { margin:0; }
            .btn-sm { font-size:13px; font-weight:600; padding:7px 12px; border-radius:9px;
                      border:1px solid var(--line); background:#fff; color:var(--ink); cursor:pointer; text-decoration:none; }
            .btn-sm.warn { border-color:#e2c9c9; color:#a13b3b; }
            #pad { border:1px solid var(--line); border-radius:10px; background:#fff;
                   width:100%; height:180px; touch-action:none; display:block; }
            .err { color:#a13b3b; font-size:13px; margin:8px 0; }
        </style>
    </template>

    <!-- Shared page shell; section content is injected as t-out="0". -->
    <template id="portal_layout" name="My Care Layout">
        <html lang="vi">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>Chăm sóc của tôi</title>
                <t t-call="health_portal.portal_styles"/>
            </head>
            <body>
                <div class="wrap">
                    <div class="brand"><span class="dot"/><h1>Chăm sóc của tôi</h1></div>
                    <t t-out="0"/>
                    <div class="foot">Trang này chỉ dành cho bạn. Vui lòng không chia sẻ liên kết.</div>
                </div>
            </body>
        </html>
    </template>

    <!-- Hub: patient name + upcoming + history visits (Phase 4A). -->
    <template id="portal_hub" name="My Care Hub">
        <t t-call="health_portal.portal_layout">
            <div class="who">
                <t t-esc="patient_name"/>
                <t t-if="patient_code"> · <t t-esc="patient_code"/></t>
            </div>
            <a class="nav" t-attf-href="/my/care/#{token}/health">Sức khỏe của tôi →</a><br/>
            <a class="nav" t-attf-href="/my/care/#{token}/records">Hồ sơ bệnh án của tôi →</a><br/>
            <a class="nav" t-attf-href="/my/care/#{token}/consents">Đồng ý &amp; quyền riêng tư →</a>

            <div class="sec">Lịch hẹn sắp tới</div>
            <t t-if="upcoming">
                <t t-foreach="upcoming" t-as="v">
                    <div class="card">
                        <div class="row1">
                            <span class="svc"><t t-esc="v['service']"/></span>
                            <span class="when"><t t-esc="v['when']"/></span>
                        </div>
                        <div class="meta">
                            <t t-if="v['staff']">Điều dưỡng: <t t-esc="v['staff']"/> · </t>
                            <span class="chip"><t t-esc="v['state_label']"/></span>
                        </div>
                        <t t-if="v['facility_phone']">
                            <div class="meta">ĐT cơ sở: <t t-esc="v['facility_phone']"/></div>
                        </t>
                    </div>
                </t>
            </t>
            <t t-else="">
                <div class="empty">Chưa có lịch hẹn sắp tới.</div>
            </t>

            <div class="sec">Lịch sử thăm khám</div>
            <t t-if="history">
                <t t-foreach="history" t-as="v">
                    <div class="card">
                        <div class="row1">
                            <span class="svc"><t t-esc="v['service']"/></span>
                            <span class="when"><t t-esc="v['when']"/></span>
                        </div>
                        <div class="meta">
                            <t t-if="v['staff']">Điều dưỡng: <t t-esc="v['staff']"/> · </t>
                            <span class="chip"><t t-esc="v['state_label']"/></span>
                        </div>
                    </div>
                </t>
            </t>
            <t t-else="">
                <div class="empty">Chưa có lịch sử thăm khám.</div>
            </t>

            <t t-if="packages">
                <div class="sec">Số buổi còn lại</div>
                <t t-foreach="packages" t-as="p">
                    <div class="card">
                        <div class="row1">
                            <span class="svc"><t t-esc="p['name']"/></span>
                            <span class="when"><t t-esc="p['remaining']"/> / <t t-esc="p['total']"/></span>
                        </div>
                    </div>
                </t>
            </t>

            <div class="sec">Đặt lịch &amp; liên hệ</div>
            <div class="card">
                <t t-if="rebook['invite_token']">
                    <a class="btn" t-attf-href="/booking/self/#{rebook['invite_token']}">Đặt lịch hẹn</a>
                </t>
                <t t-if="rebook['facility_phone']">
                    <div class="meta" t-attf-style="margin-top:#{rebook['invite_token'] and '10px' or '0'};">Liên hệ đội chăm sóc: <t t-esc="rebook['facility_phone']"/></div>
                </t>
                <t t-if="not rebook['invite_token'] and not rebook['facility_phone']">
                    <div class="meta">Vui lòng liên hệ cơ sở chăm sóc của bạn để đặt lịch hẹn.</div>
                </t>
            </div>
        </t>
    </template>

    <!-- My Health: active problem list + recent vitals (Phase 4E). -->
    <template id="portal_health" name="My Care Health">
        <t t-call="health_portal.portal_layout">
            <a class="back" t-attf-href="/my/care/#{token}">← Quay lại</a>

            <div class="sec">Chẩn đoán đang theo dõi</div>
            <t t-if="conditions">
                <t t-foreach="conditions" t-as="c">
                    <div class="card">
                        <div class="row1">
                            <span class="svc"><t t-esc="c['label']"/></span>
                            <t t-if="c['code']"><span class="chip"><t t-esc="c['code']"/></span></t>
                        </div>
                        <t t-if="c['since']">
                            <div class="meta">từ <t t-esc="c['since']"/></div>
                        </t>
                    </div>
                </t>
            </t>
            <t t-else="">
                <div class="empty">Chưa có chẩn đoán được ghi nhận.</div>
            </t>

            <div class="sec">Sinh hiệu gần đây</div>
            <t t-if="vitals">
                <t t-foreach="vitals" t-as="v">
                    <div class="card">
                        <div class="row1">
                            <span class="svc"><t t-esc="v['label']"/></span>
                            <span class="when"><t t-esc="v['value']"/><t t-if="v['unit']"> <t t-esc="v['unit']"/></t></span>
                        </div>
                        <t t-if="v['when']">
                            <div class="meta"><t t-esc="v['when']"/></div>
                        </t>
                    </div>
                </t>
            </t>
            <t t-else="">
                <div class="empty">Chưa có sinh hiệu được ghi nhận.</div>
            </t>
        </t>
    </template>

    <!-- My Records: list of finalized medical records (Phase 4B). -->
    <template id="portal_records" name="My Care Records">
        <t t-call="health_portal.portal_layout">
            <a class="back" t-attf-href="/my/care/#{token}">← Quay lại</a>
            <div class="sec">Hồ sơ bệnh án của tôi</div>
            <t t-if="records">
                <t t-foreach="records" t-as="r">
                    <a class="card-link" t-attf-href="/my/care/#{token}/records/#{r['id']}">
                        <div class="card">
                            <div class="row1">
                                <span class="svc">Ghi chú thăm khám</span>
                                <span class="when"><t t-esc="r['when']"/></span>
                            </div>
                            <div class="meta">
                                <t t-if="r['visit']"><t t-esc="r['visit']"/> · </t>
                                <t t-if="r['signer']">Ký bởi: <t t-esc="r['signer']"/></t>
                            </div>
                        </div>
                    </a>
                </t>
            </t>
            <t t-else="">
                <div class="empty">Chưa có hồ sơ đã hoàn tất.</div>
            </t>
        </t>
    </template>

    <!-- My Record detail: one finalized note (Phase 4B). -->
    <template id="portal_record" name="My Care Record">
        <t t-call="health_portal.portal_layout">
            <a class="back" t-attf-href="/my/care/#{token}/records">← Hồ sơ bệnh án</a>
            <div class="card">
                <div class="row1">
                    <span class="svc">Ghi chú thăm khám</span>
                    <span class="when"><t t-esc="when"/></span>
                </div>
                <div class="meta">
                    <t t-if="visit"><t t-esc="visit"/> · </t>
                    <t t-if="signer">Ký bởi: <t t-esc="signer"/></t>
                </div>
                <t t-if="sections">
                    <t t-foreach="sections" t-as="s">
                        <div class="nsec">
                            <div class="lbl"><t t-esc="s[0]"/></div>
                            <div class="val"><t t-esc="s[1]"/></div>
                        </div>
                    </t>
                </t>
                <t t-else="">
                    <div class="empty">Không có nội dung.</div>
                </t>
            </div>
            <a class="btn" t-attf-href="/my/care/#{token}/records/#{note_id}/download">Tải xuống (.txt)</a>
        </t>
    </template>

    <!-- My Consents: view + withdraw + grant (Phase 4C). -->
    <template id="portal_consents" name="My Care Consents">
        <t t-call="health_portal.portal_layout">
            <a class="back" t-attf-href="/my/care/#{token}">← Quay lại</a>
            <div class="sec">Đồng ý &amp; quyền riêng tư</div>
            <t t-foreach="consents" t-as="c">
                <div class="card">
                    <div class="crow">
                        <div>
                            <div class="lbl2"><t t-esc="c['label']"/></div>
                            <t t-if="c['active']"><span class="on">Đã đồng ý</span></t>
                            <t t-else=""><span class="off">Chưa đồng ý</span></t>
                        </div>
                        <t t-if="c['active']">
                            <form class="inline" method="post"
                                  t-attf-action="/my/care/#{token}/consents/#{c['type']}/withdraw">
                                <button type="submit" class="btn-sm warn">Thu hồi</button>
                            </form>
                        </t>
                        <t t-else="">
                            <a class="btn-sm" t-attf-href="/my/care/#{token}/consents/#{c['type']}/grant">Đồng ý</a>
                        </t>
                    </div>
                </div>
            </t>
            <div class="meta" style="margin-top:8px;">Thu hồi “Chia sẻ dữ liệu y tế” sẽ dừng việc chia sẻ hồ sơ của bạn ra bên ngoài.</div>
        </t>
    </template>

    <!-- Grant with on-screen signature (Phase 4C). -->
    <template id="portal_consent_grant" name="My Care Consent Grant">
        <t t-call="health_portal.portal_layout">
            <a class="back" t-attf-href="/my/care/#{token}/consents">← Quay lại</a>
            <div class="sec">Đồng ý: <t t-esc="label"/></div>
            <div class="card">
                <div class="meta">Vui lòng ký tên vào ô bên dưới để xác nhận đồng ý.</div>
                <t t-if="error"><div class="err">Vui lòng ký trước khi gửi.</div></t>
                <form id="sform" method="post"
                      t-attf-action="/my/care/#{token}/consents/#{ctype}/grant">
                    <canvas id="pad"/>
                    <input type="hidden" name="signature" id="sigdata"/>
                    <div style="display:flex; gap:8px; margin-top:10px;">
                        <button type="button" class="btn-sm" onclick="clearPad()">Xóa</button>
                        <button type="submit" class="btn">Xác nhận đồng ý</button>
                    </div>
                </form>
            </div>
            <script>
                (function(){
                  var c=document.getElementById('pad');
                  var ctx=c.getContext('2d'); var drawing=false; var has=false;
                  function size(){ c.width=c.offsetWidth; c.height=180;
                    ctx.lineWidth=2; ctx.lineCap='round'; ctx.strokeStyle='#1f2933'; }
                  window.addEventListener('load', size);
                  function pos(e){ var r=c.getBoundingClientRect();
                    return {x:e.clientX-r.left, y:e.clientY-r.top}; }
                  c.addEventListener('pointerdown', function(e){ drawing=true;
                    var p=pos(e); ctx.beginPath(); ctx.moveTo(p.x,p.y); e.preventDefault(); });
                  c.addEventListener('pointermove', function(e){ if(!drawing) return;
                    var p=pos(e); ctx.lineTo(p.x,p.y); ctx.stroke(); has=true; e.preventDefault(); });
                  window.addEventListener('pointerup', function(){ drawing=false; });
                  window.clearPad=function(){ ctx.clearRect(0,0,c.width,c.height); has=false; };
                  document.getElementById('sform').addEventListener('submit', function(ev){
                    if(!has){ ev.preventDefault(); alert('Vui lòng ký trước khi gửi.'); return; }
                    document.getElementById('sigdata').value=c.toDataURL('image/png');
                  });
                })();
            </script>
        </t>
    </template>

    <!-- Neutral page: invalid / revoked / expired / unknown (no oracle). -->
    <template id="portal_neutral" name="My Care Unavailable">
        <t t-call="health_portal.portal_layout">
            <div class="card">
                <div class="svc">Liên kết không khả dụng</div>
                <div class="meta">Liên kết này không còn hiệu lực hoặc không đúng.
                    Vui lòng liên hệ cơ sở chăm sóc của bạn để được cấp liên kết mới.</div>
            </div>
        </t>
    </template>

</odoo>
