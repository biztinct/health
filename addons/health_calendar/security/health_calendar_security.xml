<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_healthcare_calendar" model="ir.module.category">
        <field name="name">Healthcare Calendar</field>
        <field name="description" />
        <field name="sequence">20</field>
    </record>

    <!-- Security Groups for Healthcare Calendar -->
    <record id="group_health_appointment_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_healthcare_calendar"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_health_appointment_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_healthcare_calendar"/>
        <field name="implied_ids" eval="[(4, ref('group_health_appointment_user'))]"/>
    </record>

    <!-- Record Rules -->
    <!-- Appointment Rules -->
    <record id="health_appointment_rule_user" model="ir.rule">
        <field name="name">Health Appointment: User Access</field>
        <field name="model_id" ref="model_health_appointment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_health_appointment_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="health_appointment_rule_manager" model="ir.rule">
        <field name="name">Health Appointment: Manager Access</field>
        <field name="model_id" ref="model_health_appointment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_health_appointment_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>


    <!-- Portal Access Rules -->
    <record id="health_patient_portal_rule" model="ir.rule">
        <field name="name">Health Patient: Portal User Access</field>
        <field name="model_id" ref="health_base.model_health_patient"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="health_appointment_portal_rule" model="ir.rule">
        <field name="name">Health Appointment: Portal User Access</field>
        <field name="model_id" ref="model_health_appointment"/>
        <field name="domain_force">[('patient_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Public Access for Booking Portal -->
    <record id="health_service_type_public_rule" model="ir.rule">
        <field name="name">Health Service Type: Public Read Access for Booking</field>
        <field name="model_id" ref="health_base.model_health_service_type"/>
        <field name="domain_force">[('allow_online_booking', '=', True), ('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>