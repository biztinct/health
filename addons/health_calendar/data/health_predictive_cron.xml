<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- V2.0 Enhancement: Predictive Scheduling Cron Jobs -->
    
    <!-- Daily Optimization Cron Job -->
    <record id="cron_daily_schedule_optimization" model="ir.cron">
        <field name="name">Healthcare: Daily Schedule Optimization</field>
        <field name="model_id" ref="model_health_predictive_scheduling"/>
        <field name="state">code</field>
        <field name="code">model.run_daily_optimization()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall">2025-08-17 06:00:00</field>
        <field name="priority">5</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Weekly Model Training Cron Job -->
    <record id="cron_weekly_ml_training" model="ir.cron">
        <field name="name">Healthcare: Weekly ML Model Training</field>
        <field name="model_id" ref="model_health_predictive_scheduling"/>
        <field name="state">code</field>
        <field name="code">model.train_prediction_model()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="nextcall">2025-08-18 02:00:00</field>
        <field name="priority">10</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Appointment Predictions Update Cron Job -->
    <record id="cron_hourly_appointment_predictions" model="ir.cron">
        <field name="name">Healthcare: Update Appointment Predictions</field>
        <field name="model_id" ref="model_health_appointment"/>
        <field name="state">code</field>
        <field name="code">
# Update predictions for today's appointments
today_appointments = model.search([
    ('appointment_date', '=', fields.Date.today()),
    ('state', 'in', ['confirmed', 'requested'])
])
if today_appointments:
    model.predict_appointment_outcomes(today_appointments.ids)
        </field>
        <field name="interval_number">2</field>
        <field name="interval_type">hours</field>
        <field name="nextcall">2025-08-16 16:00:00</field>
        <field name="priority">15</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

    <!-- No-Show Alert Cron Job -->
    <record id="cron_no_show_alerts" model="ir.cron">
        <field name="name">Healthcare: No-Show Risk Alerts</field>
        <field name="model_id" ref="model_health_appointment"/>
        <field name="state">code</field>
        <field name="code">
# Find high no-show risk appointments for tomorrow
tomorrow = fields.Date.today() + relativedelta(days=1)
high_risk_appointments = model.search([
    ('appointment_date', '=', tomorrow),
    ('state', '=', 'confirmed'),
    ('no_show_probability', '>', 40)
])

# Send alerts to staff
for appointment in high_risk_appointments:
    if appointment.assigned_staff_id:
        appointment.activity_schedule(
            'mail.mail_activity_data_todo',
            summary='High No-Show Risk: ' + appointment.patient_id.name,
            note='This appointment has a ' + str(int(appointment.no_show_probability)) + '% no-show probability. Consider confirmation call.',
            user_id=appointment.assigned_staff_id.id
        )
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall">2025-08-17 17:00:00</field>
        <field name="priority">8</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

</odoo>