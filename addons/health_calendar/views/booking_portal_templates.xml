<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <!-- Main Booking Portal - Calendly-inspired -->
    <template id="booking_portal_main" name="Book Appointment - VAFHS">
        <t t-call="website.layout">
            <t t-set="title">Book Your Appointment - VAFHS Healthcare</t>
            <t t-set="additional_title">Professional Healthcare at Your Convenience</t>
            
            <!-- Debug: Test if JavaScript runs at all -->
            <t t-set="head">
                <link rel="stylesheet" type="text/css" href="/health_calendar/static/src/css/booking_portal.css"/>
                <script type="text/javascript">
                    console.log('VAFHS DEBUG: Inline script loaded');
                    document.addEventListener('DOMContentLoaded', function() {
                        console.log('VAFHS DEBUG: DOM ready');
                        console.log('VAFHS DEBUG: Found cards:', document.querySelectorAll('.appointment-type-card').length);
                        console.log('VAFHS DEBUG: Found buttons:', document.querySelectorAll('.btn-select-type').length);
                        
                        // Add simple click handlers for testing
                        document.querySelectorAll('.btn-select-type').forEach(function(btn) {
                            btn.addEventListener('click', function(e) {
                                e.preventDefault();
                                const typeId = this.getAttribute('data-type-id');
                                console.log('VAFHS DEBUG: Inline click handler - Type ID:', typeId);
                                window.location.href = '/book-appointment/step2?appointment_type_id=' + typeId;
                            });
                        });
                    });
                </script>
                <script type="text/javascript" src="/health_calendar/static/src/js/booking_portal.js"></script>
            </t>
            
            <div class="booking-portal-main" t-att-data-page="page_name">
                <!-- Hero Section -->
                <section class="booking-hero">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-6">
                                <div class="booking-hero-content">
                                    <h1 class="booking-hero-title">
                                        Book Your Healthcare Appointment
                                    </h1>
                                    <p class="booking-hero-subtitle">
                                        Professional healthcare services in Vietnam. 
                                        Choose clinic visits, home care, or telemedicine consultations.
                                    </p>
                                    <div class="booking-hero-features">
                                        <div class="feature-item">
                                            <i class="fa fa-clock-o"></i>
                                            <span>Instant confirmation</span>
                                        </div>
                                        <div class="feature-item">
                                            <i class="fa fa-mobile"></i>
                                            <span>Mobile-friendly</span>
                                        </div>
                                        <div class="feature-item">
                                            <i class="fa fa-shield"></i>
                                            <span>Secure &amp; private</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="booking-hero-image">
                                    <img src="/health_calendar/static/src/img/healthcare-booking.jpg" 
                                         alt="Healthcare Booking" class="img-fluid"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Appointment Type Selection -->
                <section class="appointment-types-section">
                    <div class="container">
                        <div class="section-header text-center">
                            <h2 class="section-title">Choose Your Service</h2>
                            <p class="section-subtitle">Select the type of healthcare service you need</p>
                        </div>
                        
                        <div class="appointment-types-grid">
                            <t t-foreach="appointment_types" t-as="apt_type">
                                <div class="appointment-type-card" 
                                     t-att-data-type-id="apt_type.id"
                                     t-att-data-color="apt_type.color">
                                    <div class="card-icon">
                                        <i t-att-class="apt_type.icon or 'fa fa-stethoscope'"></i>
                                    </div>
                                    <div class="card-content">
                                        <h3 class="card-title" t-field="apt_type.name"/>
                                        <p class="card-description" t-field="apt_type.description"/>
                                        <div class="card-details">
                                            <div class="detail-item">
                                                <i class="fa fa-clock-o"></i>
                                                <span t-esc="apt_type.duration_minutes"/> minutes
                                            </div>
                                            <div class="detail-item">
                                                <i class="fa fa-map-marker"></i>
                                                <span t-if="apt_type.location_type == 'clinic'">Clinic Visit</span>
                                                <span t-if="apt_type.location_type == 'home'">Home Visit</span>
                                                <span t-if="apt_type.location_type == 'online'">Telemedicine</span>
                                            </div>
                                            <div class="detail-item price" t-if="apt_type.base_price > 0">
                                                <i class="fa fa-money"></i>
                                                <span>From ₫<t t-esc="'{:,.0f}'.format(apt_type.base_price)"/></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-action">
                                        <button class="btn btn-primary btn-select-type" 
                                                t-att-data-type-id="apt_type.id">
                                            Select This Service
                                            <i class="fa fa-arrow-right ml-2"></i>
                                        </button>
                                    </div>
                                </div>
                            </t>
                        </div>
                        
                        <!-- No types available fallback -->
                        <div t-if="not appointment_types" class="no-types-available">
                            <div class="text-center">
                                <i class="fa fa-calendar-times-o fa-3x text-muted mb-3"></i>
                                <h3>No Services Available</h3>
                                <p>Online booking is temporarily unavailable. Please contact us directly.</p>
                                <a href="tel:+842812345678" class="btn btn-outline-primary">
                                    <i class="fa fa-phone mr-2"></i>Call Us
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Why Choose VAFHS -->
                <section class="why-choose-section bg-light">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-12 text-center">
                                <h2 class="section-title">Why Choose VAFHS Healthcare?</h2>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="feature-box">
                                    <div class="feature-icon">
                                        <i class="fa fa-user-md"></i>
                                    </div>
                                    <h4>Expert Healthcare Professionals</h4>
                                    <p>Qualified doctors and nurses with international experience</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="feature-box">
                                    <div class="feature-icon">
                                        <i class="fa fa-home"></i>
                                    </div>
                                    <h4>Home Visit Services</h4>
                                    <p>Professional healthcare delivered to your home across Ho Chi Minh City</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="feature-box">
                                    <div class="feature-icon">
                                        <i class="fa fa-language"></i>
                                    </div>
                                    <h4>Bilingual Service</h4>
                                    <p>English and Vietnamese speaking staff for your comfort</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- Step 2: Date & Time Selection - Calendly Style -->
    <template id="booking_portal_step2" name="Select Date and Time">
        <t t-call="website.layout">
            <t t-set="title">Select Date and Time - VAFHS Booking</t>
            
            <!-- Ensure our assets are loaded -->
            <t t-set="head">
                <link rel="stylesheet" type="text/css" href="/health_calendar/static/src/css/booking_portal.css"/>
                <script type="text/javascript">
                    console.log('VAFHS DEBUG: Step 2 inline script loaded');
                    document.addEventListener('DOMContentLoaded', function() {
                        console.log('VAFHS DEBUG: Step 2 DOM ready');
                    });
                </script>
                <script type="text/javascript" src="/health_calendar/static/src/js/booking_portal.js"></script>
            </t>
            
            <div class="booking-step-container" t-att-data-page="page_name">
                <!-- Progress Bar -->
                <div class="booking-progress">
                    <div class="container">
                        <div class="progress-steps">
                            <div class="step completed">
                                <div class="step-number">1</div>
                                <div class="step-label">Service</div>
                            </div>
                            <div class="step active">
                                <div class="step-number">2</div>
                                <div class="step-label">Date and Time</div>
                            </div>
                            <div class="step">
                                <div class="step-number">3</div>
                                <div class="step-label">Your Info</div>
                            </div>
                            <div class="step">
                                <div class="step-number">4</div>
                                <div class="step-label">Confirm</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="container">
                    <div class="row">
                        <!-- Left: Service Summary -->
                        <div class="col-lg-4">
                            <div class="booking-summary-card sticky-top">
                                <div class="service-summary">
                                    <div class="service-icon">
                                        <i t-att-class="appointment_type.icon or 'fa fa-stethoscope'"></i>
                                    </div>
                                    <h3 t-field="appointment_type.name"/>
                                    <p t-field="appointment_type.description"/>
                                    
                                    <div class="service-details">
                                        <div class="detail-row">
                                            <i class="fa fa-clock-o"></i>
                                            <span t-esc="appointment_type.duration_minutes"/> minutes
                                        </div>
                                        <div class="detail-row">
                                            <i class="fa fa-map-marker"></i>
                                            <span t-if="appointment_type.location_type == 'clinic'">Clinic Visit</span>
                                            <span t-if="appointment_type.location_type == 'home'">Home Visit</span>
                                            <span t-if="appointment_type.location_type == 'online'">Video Call</span>
                                        </div>
                                        <div class="detail-row" t-if="appointment_type.base_price > 0">
                                            <i class="fa fa-money"></i>
                                            <span>₫<t t-esc="'{:,.0f}'.format(appointment_type.base_price)"/></span>
                                        </div>
                                    </div>
                                </div>
                                
                                <button class="btn btn-outline-secondary btn-sm btn-back">
                                    <i class="fa fa-arrow-left mr-2"></i>Back to Services
                                </button>
                            </div>
                        </div>

                        <!-- Right: Calendar Interface -->
                        <div class="col-lg-8">
                            <div class="datetime-selection">
                                <div class="selection-header">
                                    <h2>Select Your Preferred Date and Time</h2>
                                    <p class="text-muted">Choose from available slots over the next 
                                       <t t-esc="appointment_type.advance_booking_days"/> days</p>
                                </div>

                                <!-- Modern Calendar Widget -->
                                <div class="booking-calendar-container">
                                    <div class="calendar-widget" 
                                         t-att-data-appointment-type="appointment_type.id"
                                         t-att-data-min-date="today"
                                         t-att-data-max-date="max_date"
                                         t-att-data-working-hours-start="appointment_type.working_hours_start"
                                         t-att-data-working-hours-end="appointment_type.working_hours_end">
                                        
                                        <!-- Calendar will be rendered by JavaScript -->
                                        <div class="calendar-loading">
                                            <i class="fa fa-spinner fa-spin fa-2x"></i>
                                            <p>Loading available dates...</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Time Slots -->
                                <div class="time-slots-container" style="display: none;">
                                    <h4 class="time-slots-title">Available Times</h4>
                                    <div class="time-slots-grid" id="timeSlots">
                                        <!-- Time slots will be populated by JavaScript -->
                                    </div>
                                </div>

                                <!-- Continue Button -->
                                <div class="booking-actions">
                                    <button class="btn btn-primary btn-lg btn-continue" 
                                            id="continueBtn" disabled="disabled">
                                        Continue to Your Information
                                        <i class="fa fa-arrow-right ml-2"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Step 3: Patient Information -->
    <template id="booking_portal_step3" name="Patient Information">
        <t t-call="website.layout">
            <t t-set="title">Your Information - VAFHS Booking</t>
            
            <div class="booking-step-container">
                <!-- Progress Bar -->
                <div class="booking-progress">
                    <div class="container">
                        <div class="progress-steps">
                            <div class="step completed">
                                <div class="step-number">1</div>
                                <div class="step-label">Service</div>
                            </div>
                            <div class="step completed">
                                <div class="step-number">2</div>
                                <div class="step-label">Date and Time</div>
                            </div>
                            <div class="step active">
                                <div class="step-number">3</div>
                                <div class="step-label">Your Info</div>
                            </div>
                            <div class="step">
                                <div class="step-number">4</div>
                                <div class="step-label">Confirm</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="container">
                    <div class="row">
                        <!-- Left: Booking Summary -->
                        <div class="col-lg-4">
                            <div class="booking-summary-card sticky-top">
                                <h4>Your Appointment</h4>
                                <div class="appointment-summary">
                                    <div class="summary-item">
                                        <strong t-field="appointment_type.name"/>
                                    </div>
                                    <div class="summary-item">
                                        <i class="fa fa-calendar mr-2"></i>
                                        <t t-esc="selected_date"/>
                                    </div>
                                    <div class="summary-item">
                                        <i class="fa fa-clock-o mr-2"></i>
                                        <t t-esc="selected_time_str"/>
                                    </div>
                                    <div class="summary-item">
                                        <i class="fa fa-hourglass-half mr-2"></i>
                                        <t t-esc="appointment_type.duration_minutes"/> minutes
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Patient Information Form -->
                        <div class="col-lg-8">
                            <form action="/book-appointment/confirm" method="post" 
                                  class="patient-info-form" id="patientInfoForm">
                                
                                <!-- Hidden fields -->
                                <input type="hidden" name="appointment_type_id" t-att-value="appointment_type.id"/>
                                <input type="hidden" name="selected_date" t-att-value="selected_date"/>
                                <input type="hidden" name="selected_time" t-att-value="selected_time"/>
                                
                                <div class="form-section">
                                    <h3 class="form-section-title">
                                        <i class="fa fa-user mr-2"></i>Personal Information
                                    </h3>
                                    
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="patient_name" class="form-label required">Full Name</label>
                                                <input type="text" class="form-control" id="patient_name" 
                                                       name="patient_name" required="required" 
                                                       placeholder="Enter your full name"/>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="birth_date" class="form-label">Date of Birth</label>
                                                <input type="date" class="form-control" id="birth_date" 
                                                       name="birth_date"/>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="patient_phone" class="form-label required">Phone Number</label>
                                                <input type="tel" class="form-control" id="patient_phone" 
                                                       name="patient_phone" required="required" 
                                                       placeholder="+84 90 123 4567"/>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="patient_email" class="form-label required">Email Address</label>
                                                <input type="email" class="form-control" id="patient_email" 
                                                       name="patient_email" required="required" 
                                                       placeholder="your.email@example.com"/>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="gender" class="form-label">Gender</label>
                                                <select class="form-control" id="gender" name="gender">
                                                    <option value="">Select Gender</option>
                                                    <option value="male">Male</option>
                                                    <option value="female">Female</option>
                                                    <option value="other">Other</option>
                                                    <option value="prefer_not_to_say">Prefer not to say</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="national_id" class="form-label">National ID (CCCD/CMND)</label>
                                                <input type="text" class="form-control" id="national_id" 
                                                       name="national_id" placeholder="123456789012"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Address Section (for home visits) -->
                                <div class="form-section" t-if="appointment_type.location_type == 'home'">
                                    <h3 class="form-section-title">
                                        <i class="fa fa-home mr-2"></i>Visit Address
                                    </h3>
                                    
                                    <div class="form-group">
                                        <label for="visit_address" class="form-label required">Complete Address</label>
                                        <textarea class="form-control" id="visit_address" name="visit_address" 
                                                  rows="3" required="required" 
                                                  placeholder="Enter the complete address where you need the home visit service"></textarea>
                                    </div>
                                </div>

                                <!-- Medical Information -->
                                <div class="form-section">
                                    <h3 class="form-section-title">
                                        <i class="fa fa-stethoscope mr-2"></i>Medical Information
                                    </h3>
                                    
                                    <div class="form-group" t-if="booking_config.get('show_symptoms_field')">
                                        <label for="symptoms" class="form-label">Symptoms or Reason for Visit</label>
                                        <textarea class="form-control" id="symptoms" name="symptoms" 
                                                  rows="3" placeholder="Please describe your symptoms or reason for the appointment"></textarea>
                                    </div>
                                    
                                    <div class="form-group" t-if="booking_config.get('show_urgency_field')">
                                        <label for="urgency_level" class="form-label">Urgency Level</label>
                                        <select class="form-control" id="urgency_level" name="urgency_level">
                                            <option value="routine">Routine</option>
                                            <option value="urgent">Urgent</option>
                                            <option value="emergency">Emergency</option>
                                        </select>
                                    </div>
                                    
                                    <div class="form-group" t-if="booking_config.get('show_special_requirements')">
                                        <label for="special_requirements" class="form-label">Special Requirements</label>
                                        <textarea class="form-control" id="special_requirements" 
                                                  name="special_requirements" rows="2" 
                                                  placeholder="Any special requirements or accessibility needs"></textarea>
                                    </div>
                                </div>

                                <!-- Form Actions -->
                                <div class="form-actions">
                                    <button type="button" class="btn btn-outline-secondary btn-back">
                                        <i class="fa fa-arrow-left mr-2"></i>Back
                                    </button>
                                    <button type="submit" class="btn btn-primary btn-lg">
                                        Confirm Appointment
                                        <i class="fa fa-check ml-2"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Booking Success Page -->
    <template id="booking_success" name="Booking Confirmed - VAFHS">
        <t t-call="website.layout">
            <t t-set="title">Appointment Confirmed - VAFHS Healthcare</t>
            
            <div class="booking-success-container">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="success-card">
                                <div class="success-icon">
                                    <i class="fa fa-check-circle"></i>
                                </div>
                                
                                <h1 class="success-title">Appointment Confirmed!</h1>
                                <p class="success-subtitle">
                                    Your appointment has been successfully booked. We'll send you a confirmation email shortly.
                                </p>

                                <!-- Appointment Details -->
                                <div class="appointment-details-card">
                                    <h3>Appointment Details</h3>
                                    <div class="details-grid">
                                        <div class="detail-item">
                                            <div class="detail-label">Reference</div>
                                            <div class="detail-value" t-field="appointment.name"/>
                                        </div>
                                        <div class="detail-item">
                                            <div class="detail-label">Service</div>
                                            <div class="detail-value" t-field="appointment.appointment_type_id.name"/>
                                        </div>
                                        <div class="detail-item">
                                            <div class="detail-label">Date</div>
                                            <div class="detail-value" t-field="appointment.appointment_date"/>
                                        </div>
                                        <div class="detail-item">
                                            <div class="detail-label">Time</div>
                                            <div class="detail-value">
                                                <t t-esc="'{:02d}:{:02d}'.format(int(appointment.appointment_time), int((appointment.appointment_time % 1) * 60))"/>
                                            </div>
                                        </div>
                                        <div class="detail-item">
                                            <div class="detail-label">Patient</div>
                                            <div class="detail-value" t-field="appointment.patient_id.name"/>
                                        </div>
                                        <div class="detail-item">
                                            <div class="detail-label">Status</div>
                                            <div class="detail-value">
                                                <span class="badge badge-warning">Pending Confirmation</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Next Steps -->
                                <div class="next-steps">
                                    <h4>What Happens Next?</h4>
                                    <div class="steps-list">
                                        <div class="step-item">
                                            <div class="step-icon">1</div>
                                            <div class="step-content">
                                                <strong>Confirmation</strong>
                                                <p>Our team will review and confirm your appointment within 2 hours</p>
                                            </div>
                                        </div>
                                        <div class="step-item">
                                            <div class="step-icon">2</div>
                                            <div class="step-content">
                                                <strong>Reminder</strong>
                                                <p>You'll receive appointment reminders via SMS and email</p>
                                            </div>
                                        </div>
                                        <div class="step-item">
                                            <div class="step-icon">3</div>
                                            <div class="step-content">
                                                <strong>Service Delivery</strong>
                                                <p>Our healthcare professional will provide your service as scheduled</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="success-actions">
                                    <a href="/book-appointment" class="btn btn-outline-primary">
                                        <i class="fa fa-plus mr-2"></i>Book Another Appointment
                                    </a>
                                    <a href="/" class="btn btn-primary">
                                        <i class="fa fa-home mr-2"></i>Back to Home
                                    </a>
                                </div>

                                <!-- Contact Information -->
                                <div class="contact-info">
                                    <p class="text-muted">
                                        Need to make changes or have questions? 
                                        <strong>Call us at <a href="tel:+842812345678">+84 28 1234 5678</a></strong>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Booking Error Page -->
    <template id="booking_error" name="Booking Error - VAFHS">
        <t t-call="website.layout">
            <t t-set="title">Booking Error - VAFHS Healthcare</t>
            
            <div class="booking-error-container">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-6">
                            <div class="error-card">
                                <div class="error-icon">
                                    <i class="fa fa-exclamation-triangle"></i>
                                </div>
                                
                                <h1 class="error-title">Booking Error</h1>
                                <p class="error-message" t-esc="error"/>
                                
                                <div class="error-actions">
                                    <a href="/book-appointment" class="btn btn-primary">
                                        <i class="fa fa-arrow-left mr-2"></i>Try Again
                                    </a>
                                    <a href="tel:+842812345678" class="btn btn-outline-primary">
                                        <i class="fa fa-phone mr-2"></i>Call Us
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</data>
</odoo>