<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- V2.0 Enhancement: Predictive Scheduling Views -->

    <!-- Predictive Scheduling List View -->
    <record id="view_health_predictive_scheduling_list" model="ir.ui.view">
        <field name="name">health.predictive.scheduling.list</field>
        <field name="model">health.predictive.scheduling</field>
        <field name="arch" type="xml">
            <list string="Predictive Scheduling Analysis" default_order="analysis_date desc"
                  decoration-success="model_trained == True"
                  decoration-muted="active == False">
                <field name="analysis_name"/>
                <field name="analysis_date"/>
                <field name="analysis_period_start"/>
                <field name="analysis_period_end"/>
                <field name="model_trained" widget="boolean_toggle"/>
                <field name="model_accuracy" widget="progressbar"/>
                <field name="training_data_points"/>
                <field name="prediction_accuracy" widget="progressbar" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Predictive Scheduling Form View -->
    <record id="view_health_predictive_scheduling_form" model="ir.ui.view">
        <field name="name">health.predictive.scheduling.form</field>
        <field name="model">health.predictive.scheduling</field>
        <field name="arch" type="xml">
            <form string="Predictive Scheduling Analysis">
                <header>
                    <button name="train_prediction_model" type="object" 
                            string="Train ML Model" class="oe_highlight"
                            icon="fa-cogs"/>
                    <button name="generate_demand_forecast" type="object" 
                            string="Generate Forecast" 
                            icon="fa-line-chart"/>
                    <button name="optimize_staff_schedule" type="object" 
                            string="Optimize Staff Schedule" 
                            icon="fa-users"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-percent">
                            <field name="model_accuracy" string="Model Accuracy" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-database">
                            <field name="training_data_points" string="Training Data" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-target">
                            <field name="prediction_accuracy" string="Prediction Accuracy" widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="analysis_name" placeholder="Analysis Name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Analysis Period">
                            <field name="analysis_date"/>
                            <field name="analysis_period_start"/>
                            <field name="analysis_period_end"/>
                            <field name="active"/>
                        </group>
                        <group string="Model Status">
                            <field name="model_trained" widget="boolean_toggle"/>
                            <field name="last_training_date" readonly="True"/>
                            <field name="model_accuracy" widget="progressbar"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Performance Metrics" name="metrics">
                            <group>
                                <group string="Accuracy Metrics">
                                    <field name="prediction_accuracy" widget="progressbar"/>
                                    <field name="demand_forecast_score" widget="progressbar"/>
                                    <field name="optimization_score" widget="progressbar"/>
                                </group>
                                <group string="Training Information">
                                    <field name="training_data_points"/>
                                    <field name="last_training_date"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Predictions" name="predictions">
                            <group string="Generated Predictions">
                                <field name="predicted_appointments" widget="ace" 
                                       options="{'mode': 'json'}" readonly="True"/>
                            </group>
                        </page>
                        
                        <page string="Capacity Recommendations" name="capacity">
                            <group string="Capacity Analysis">
                                <field name="capacity_recommendations" widget="ace" 
                                       options="{'mode': 'json'}" readonly="True"/>
                            </group>
                        </page>
                        
                        <page string="Staff Optimization" name="staff_optimization">
                            <group string="Staff Schedule Optimization">
                                <field name="staff_optimization" widget="ace" 
                                       options="{'mode': 'json'}" readonly="True"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Predictive Scheduling Kanban View -->
    <record id="view_health_predictive_scheduling_kanban" model="ir.ui.view">
        <field name="name">health.predictive.scheduling.kanban</field>
        <field name="model">health.predictive.scheduling</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="analysis_name"/>
                <field name="analysis_date"/>
                <field name="model_accuracy"/>
                <field name="model_trained"/>
                <field name="training_data_points"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <i class="fa fa-brain fa-2x" 
                                   t-att-style="record.model_trained.raw_value ? 'color: #28a745;' : 'color: #6c757d;'"/>
                            </div>
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <t t-esc="record.analysis_name.value"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <i class="fa fa-calendar"/> <t t-esc="record.analysis_date.value"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="row">
                                        <div class="col-6">
                                            <span class="badge badge-secondary">
                                                Accuracy: <t t-esc="Math.round(record.model_accuracy.raw_value)"/>%
                                            </span>
                                        </div>
                                        <div class="col-6">
                                            <span class="badge badge-info">
                                                <t t-esc="record.training_data_points.value"/> samples
                                            </span>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        <span t-if="record.model_trained.raw_value" 
                                              class="badge badge-success">
                                            <i class="fa fa-check"/> Model Trained
                                        </span>
                                        <span t-if="!record.model_trained.raw_value" 
                                              class="badge badge-warning">
                                            <i class="fa fa-clock-o"/> Training Needed
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dashboard functionality will be provided through other views -->

    <!-- Predictive Scheduling Graph View -->
    <record id="view_health_predictive_scheduling_graph" model="ir.ui.view">
        <field name="name">health.predictive.scheduling.graph</field>
        <field name="model">health.predictive.scheduling</field>
        <field name="arch" type="xml">
            <graph string="Prediction Accuracy Trends" type="line">
                <field name="analysis_date" type="row"/>
                <field name="model_accuracy" type="measure"/>
                <field name="prediction_accuracy" type="measure"/>
                <field name="optimization_score" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Main Action for Predictive Scheduling -->
    <record id="action_health_predictive_scheduling" model="ir.actions.act_window">
        <field name="name">AI Predictive Scheduling</field>
        <field name="res_model">health.predictive.scheduling</field>
        <field name="view_mode">kanban,list,form,graph</field>
        <field name="view_id" ref="view_health_predictive_scheduling_kanban"/>
        <field name="context">{
            'search_default_active': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Welcome to AI-Powered Predictive Scheduling!
            </p>
            <p>
                Create your first predictive analysis to start optimizing appointment schedules using machine learning.
                The system analyzes historical data to predict optimal appointment times, staff requirements, and patient satisfaction.
            </p>
            <p>
                <strong>Quick Actions:</strong><br/>
                • Use "Train ML Model" button to create new prediction models<br/>
                • View performance metrics in Graph view<br/>
                • Monitor accuracy trends over time
            </p>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_health_predictive_scheduling_search" model="ir.ui.view">
        <field name="name">health.predictive.scheduling.search</field>
        <field name="model">health.predictive.scheduling</field>
        <field name="arch" type="xml">
            <search string="Predictive Scheduling Analysis">
                <field name="analysis_name"/>
                <field name="analysis_date"/>
                
                <separator/>
                
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="trained_models" string="Trained Models" domain="[('model_trained', '=', True)]"/>
                <filter name="high_accuracy" string="High Accuracy (>80%)" domain="[('model_accuracy', '>', 80)]"/>
                
                <separator/>
                
                <filter name="this_week" string="This Week" 
                        domain="[('analysis_date', '>=', (context_today() - datetime.timedelta(days=7)))]"/>
                <filter name="this_month" string="This Month" 
                        domain="[('analysis_date', '>=', (context_today() - datetime.timedelta(days=30)))]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Analysis Date" name="group_analysis_date" 
                            context="{'group_by': 'analysis_date'}"/>
                    <filter string="Model Status" name="group_model_trained" 
                            context="{'group_by': 'model_trained'}"/>
                    <filter string="Accuracy Range" name="group_accuracy" 
                            context="{'group_by': 'model_accuracy'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>