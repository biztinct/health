<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <!-- Staff List View -->
    <record id="health_staff_view_list" model="ir.ui.view">
        <field name="name">health.staff.list</field>
        <field name="model">health.staff</field>
        <field name="arch" type="xml">
            <list string="Healthcare Staff" default_order="staff_type, name">
                <field name="image_256" widget="image" class="oe_avatar"/>
                <field name="name"/>
                <field name="staff_code"/>
                <field name="staff_type" widget="badge" 
                       decoration-info="staff_type == 'doctor'"
                       decoration-success="staff_type == 'nurse'"
                       decoration-warning="staff_type == 'specialist'"/>
                <field name="primary_facility_id"/>
                <field name="employment_status" widget="badge"
                       decoration-success="employment_status == 'active'"
                       decoration-warning="employment_status == 'on_leave'"
                       decoration-danger="employment_status == 'suspended'"/>
                <field name="is_available_today" widget="boolean_toggle"/>
                <field name="total_appointments"/>
                <field name="email" optional="hide"/>
                <field name="mobile" optional="hide"/>
                <field name="active" invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Staff Form View -->
    <record id="health_staff_view_form" model="ir.ui.view">
        <field name="name">health.staff.form</field>
        <field name="model">health.staff</field>
        <field name="arch" type="xml">
            <form string="Healthcare Staff">
                <header>
                    <button name="action_create_user_account" type="object" string="Create User Account" 
                            invisible="user_id" class="oe_highlight"/>
                    <button name="action_set_availability" type="object" string="Set Availability" 
                            class="btn-secondary"/>
                    <field name="employment_status" widget="statusbar" 
                           statusbar_visible="active,on_leave,suspended,terminated"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appointments" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="total_appointments" widget="statinfo" string="Appointments"/>
                        </button>
                        <button name="action_set_availability" type="object"
                                class="oe_stat_button" icon="fa-clock-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Set</span>
                                <span class="o_stat_text">Availability</span>
                            </div>
                        </button>
                    </div>

                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Staff Full Name"/>
                        </h1>
                        <h2>
                            <field name="staff_type" placeholder="Select staff type..."/>
                        </h2>
                    </div>

                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="staff_code"/>
                            <field name="employee_id"/>
                            <field name="hire_date"/>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group name="professional_info" string="Professional Information">
                            <field name="license_number"/>
                            <field name="license_expiry"/>
                            <field name="years_experience"/>
                            <field name="specialization_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <group name="contact_info" string="Contact Information">
                        <group>
                            <field name="email"/>
                            <field name="mobile"/>
                        </group>
                        <group>
                            <field name="phone"/>
                        </group>
                    </group>

                    <group name="facility_assignment" string="Facility Assignment">
                        <group>
                            <field name="primary_facility_id"/>
                            <field name="facility_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="service_type_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <group name="availability_settings" string="Service Availability">
                        <group>
                            <field name="available_for_clinic"/>
                            <field name="available_for_home_visits"/>
                            <field name="available_for_telemedicine"/>
                        </group>
                        <group>
                            <field name="max_appointments_per_day"/>
                            <field name="appointment_duration_default"/>
                            <field name="advance_booking_days"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Working Schedule" name="schedule">
                            <group>
                                <group string="Weekdays">
                                    <field name="working_hours_monday" placeholder="e.g., 09:00-17:00"/>
                                    <field name="working_hours_tuesday" placeholder="e.g., 09:00-17:00"/>
                                    <field name="working_hours_wednesday" placeholder="e.g., 09:00-17:00"/>
                                    <field name="working_hours_thursday" placeholder="e.g., 09:00-17:00"/>
                                    <field name="working_hours_friday" placeholder="e.g., 09:00-17:00"/>
                                </group>
                                <group string="Weekend">
                                    <field name="working_hours_saturday" placeholder="e.g., 09:00-13:00"/>
                                    <field name="working_hours_sunday" placeholder="Leave empty for off"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Qualifications" name="qualifications">
                            <field name="qualifications" placeholder="Enter qualifications, certifications, training, etc."/>
                        </page>
                        
                        <page string="Statistics" name="statistics">
                            <group>
                                <group string="Performance">
                                    <field name="total_appointments" readonly="True"/>
                                    <field name="completed_appointments" readonly="True"/>
                                    <field name="patient_rating" readonly="True"/>
                                </group>
                                <group string="Availability">
                                    <field name="is_available_today" readonly="True"/>
                                    <field name="color"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Staff Kanban View -->
    <record id="health_staff_view_kanban" model="ir.ui.view">
        <field name="name">health.staff.kanban</field>
        <field name="model">health.staff</field>
        <field name="arch" type="xml">
            <kanban default_group_by="staff_type">
                <field name="id"/>
                <field name="name"/>
                <field name="staff_type"/>
                <field name="employment_status"/>
                <field name="is_available_today"/>
                <field name="image_256"/>
                <field name="primary_facility_id"/>
                <field name="total_appointments"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('health.staff', 'image_256', record.id.raw_value)" 
                                     alt="Staff Photo" class="o_image_64_cover"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_tags_section">
                                    <span class="badge badge-pill badge-info">
                                        <field name="staff_type"/>
                                    </span>
                                    <span t-if="record.employment_status.raw_value == 'active'" 
                                          class="badge badge-pill badge-success">Active</span>
                                    <span t-if="record.is_available_today.raw_value" 
                                          class="badge badge-pill badge-primary">Available Today</span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="primary_facility_id"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span title="Total Appointments">
                                            <i class="fa fa-calendar"/> <field name="total_appointments"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Staff Search View -->
    <record id="health_staff_view_search" model="ir.ui.view">
        <field name="name">health.staff.search</field>
        <field name="model">health.staff</field>
        <field name="arch" type="xml">
            <search string="Search Healthcare Staff">
                <field name="name" string="Staff Name"/>
                <field name="staff_code" string="Staff Code"/>
                <field name="staff_type" string="Staff Type"/>
                <field name="license_number" string="License Number"/>
                <field name="specialization_ids" string="Specialization"/>
                <field name="facility_ids" string="Facility"/>
                
                <filter string="Doctors" name="doctors" domain="[('staff_type', '=', 'doctor')]"/>
                <filter string="Nurses" name="nurses" domain="[('staff_type', '=', 'nurse')]"/>
                <filter string="Specialists" name="specialists" domain="[('staff_type', '=', 'specialist')]"/>
                
                <separator/>
                <filter string="Active Staff" name="active" domain="[('employment_status', '=', 'active')]"/>
                <filter string="Available for Clinic" name="clinic" domain="[('available_for_clinic', '=', True)]"/>
                <filter string="Available for Home Visits" name="home_visits" domain="[('available_for_home_visits', '=', True)]"/>
                <filter string="Available for Telemedicine" name="telemedicine" domain="[('available_for_telemedicine', '=', True)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Staff Type" name="group_staff_type" context="{'group_by': 'staff_type'}"/>
                    <filter string="Employment Status" name="group_employment_status" context="{'group_by': 'employment_status'}"/>
                    <filter string="Primary Facility" name="group_facility" context="{'group_by': 'primary_facility_id'}"/>
                    <filter string="Specialization" name="group_specialization" context="{'group_by': 'specialization_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Staff Actions -->
    <record id="action_health_staff" model="ir.actions.act_window">
        <field name="name">Healthcare Staff</field>
        <field name="res_model">health.staff</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="health_staff_view_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first healthcare staff member!
            </p>
            <p>
                Manage doctors, nurses, and other healthcare professionals.
                Configure their schedules, qualifications, and service availability.
            </p>
        </field>
    </record>

    <!-- Staff Availability Views -->
    <record id="health_staff_availability_view_calendar" model="ir.ui.view">
        <field name="name">health.staff.availability.calendar</field>
        <field name="model">health.staff.availability</field>
        <field name="arch" type="xml">
            <calendar date_start="date_start" date_stop="date_end" string="Staff Availability" 
                     color="color" mode="week" quick_create="true" event_open_popup="true">
                <field name="staff_id"/>
                <field name="availability_type"/>
                <field name="facility_id"/>
                <field name="notes"/>
                <field name="color"/>
            </calendar>
        </field>
    </record>

    <record id="health_staff_availability_view_list" model="ir.ui.view">
        <field name="name">health.staff.availability.list</field>
        <field name="model">health.staff.availability</field>
        <field name="arch" type="xml">
            <list string="Staff Availability">
                <field name="staff_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="availability_type" widget="badge"/>
                <field name="facility_id"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="health_staff_availability_view_form" model="ir.ui.view">
        <field name="name">health.staff.availability.form</field>
        <field name="model">health.staff.availability</field>
        <field name="arch" type="xml">
            <form string="Staff Availability">
                <sheet>
                    <group>
                        <group>
                            <field name="staff_id"/>
                            <field name="availability_type"/>
                            <field name="facility_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    
                    <group string="Recurring Schedule" invisible="availability_type != 'available'">
                        <group>
                            <field name="recurring"/>
                            <field name="recurring_rule" invisible="not recurring"/>
                        </group>
                    </group>
                    
                    <field name="notes" placeholder="Additional notes about this availability period..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_health_staff_availability" model="ir.actions.act_window">
        <field name="name">Staff Availability</field>
        <field name="res_model">health.staff.availability</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set staff availability schedules!
            </p>
            <p>
                Configure when your healthcare staff are available for appointments.
                Set regular working hours, time off, and special availability periods.
            </p>
        </field>
    </record>

    <!-- Specialization Views -->
    <record id="health_specialization_view_list" model="ir.ui.view">
        <field name="name">health.specialization.list</field>
        <field name="model">health.specialization</field>
        <field name="arch" type="xml">
            <list string="Medical Specializations" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_health_specialization" model="ir.actions.act_window">
        <field name="name">Medical Specializations</field>
        <field name="res_model">health.specialization</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

</data>
</odoo>