<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    
    <!-- Demo Healthcare Staff Records -->
    <record id="demo_staff_doctor" model="hr.employee">
        <field name="name">Dr. Nguyen Van A</field>
        <field name="is_healthcare_staff" eval="True"/>
        <field name="healthcare_role">doctor</field>
        <field name="staff_code">DOC001</field>
        <field name="employment_status">active</field>
        <field name="work_email">doctor@vafhs.com</field>
        <field name="mobile_phone">+84901234567</field>
        <field name="available_for_clinic" eval="True"/>
        <field name="available_for_home_visits" eval="True"/>
        <field name="can_do_telemedicine" eval="True"/>
        <field name="max_daily_appointments">15</field>
        <field name="professional_license_number">MD-DEMO-001</field>
    </record>
    
    <record id="demo_staff_nurse" model="hr.employee">
        <field name="name">Nurse Tran Thi B</field>
        <field name="is_healthcare_staff" eval="True"/>
        <field name="healthcare_role">nurse</field>
        <field name="staff_code">NUR001</field>
        <field name="employment_status">active</field>
        <field name="work_email">nurse@vafhs.com</field>
        <field name="mobile_phone">+84901234568</field>
        <field name="available_for_clinic" eval="True"/>
        <field name="available_for_home_visits" eval="True"/>
        <field name="max_daily_appointments">20</field>
        <field name="professional_license_number">RN-DEMO-001</field>
    </record>
    
    <!-- Demo Staff Availability Matrix Records -->
    <record id="staff_availability_demo_1" model="health.staff.availability.matrix">
        <field name="staff_id" ref="demo_staff_doctor"/>
        <field name="availability_date" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d')"/>
        <field name="start_time">8.0</field>
        <field name="end_time">17.0</field>
        <field name="status">available</field>
        <field name="capacity">1</field>
        <field name="notes">Regular working hours</field>
    </record>
    
    <record id="staff_availability_demo_2" model="health.staff.availability.matrix">
        <field name="staff_id" ref="demo_staff_nurse"/>
        <field name="availability_date" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d')"/>
        <field name="start_time">6.0</field>
        <field name="end_time">14.0</field>
        <field name="status">available</field>
        <field name="capacity">1</field>
        <field name="notes">Early shift</field>
    </record>
    
    <record id="staff_availability_demo_3" model="health.staff.availability.matrix">
        <field name="staff_id" ref="demo_staff_doctor"/>
        <field name="availability_date" eval="(datetime.now() + timedelta(days=2)).strftime('%Y-%m-%d')"/>
        <field name="start_time">12.0</field>
        <field name="end_time">13.0</field>
        <field name="status">blocked</field>
        <field name="capacity">0</field>
        <field name="notes">Staff meeting</field>
    </record>
    
    <record id="staff_availability_demo_4" model="health.staff.availability.matrix">
        <field name="staff_id" ref="demo_staff_nurse"/>
        <field name="availability_date" eval="(datetime.now() + timedelta(days=3)).strftime('%Y-%m-%d')"/>
        <field name="start_time">0.0</field>
        <field name="end_time">24.0</field>
        <field name="status">blocked</field>
        <field name="capacity">0</field>
        <field name="notes">Weekend off</field>
    </record>
    
</data>
</odoo>