<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    
    <!-- Demo Staff Records First -->
    <record id="demo_staff_doctor" model="health.staff">
        <field name="name">Dr. Nguyen Van A</field>
        <field name="staff_code">DOC001</field>
        <field name="staff_type">doctor</field>
        <field name="employment_status">active</field>
        <field name="email">doctor@vafhs.com</field>
        <field name="mobile">+84901234567</field>
        <field name="available_for_clinic" eval="True"/>
        <field name="available_for_home_visits" eval="True"/>
    </record>
    
    <record id="demo_staff_nurse" model="health.staff">
        <field name="name">Nurse Tran Thi B</field>
        <field name="staff_code">NUR001</field>
        <field name="staff_type">nurse</field>
        <field name="employment_status">active</field>
        <field name="email">nurse@vafhs.com</field>
        <field name="mobile">+84901234568</field>
        <field name="available_for_clinic" eval="True"/>
        <field name="available_for_home_visits" eval="True"/>
    </record>
    
    <!-- Demo Staff Availability Records -->
    <record id="staff_availability_demo_1" model="health.staff.availability">
        <field name="staff_id" ref="demo_staff_doctor"/>
        <field name="date_start" eval="datetime.now() + timedelta(days=1, hours=8)"/>
        <field name="date_end" eval="datetime.now() + timedelta(days=1, hours=17)"/>
        <field name="availability_type">available</field>
        <field name="notes">Regular working hours</field>
    </record>
    
    <record id="staff_availability_demo_2" model="health.staff.availability">
        <field name="staff_id" ref="demo_staff_nurse"/>
        <field name="date_start" eval="datetime.now() + timedelta(days=1, hours=6)"/>
        <field name="date_end" eval="datetime.now() + timedelta(days=1, hours=14)"/>
        <field name="availability_type">available</field>
        <field name="notes">Early shift</field>
    </record>
    
    <record id="staff_availability_demo_3" model="health.staff.availability">
        <field name="staff_id" ref="demo_staff_doctor"/>
        <field name="date_start" eval="datetime.now() + timedelta(days=2, hours=12)"/>
        <field name="date_end" eval="datetime.now() + timedelta(days=2, hours=13)"/>
        <field name="availability_type">meeting</field>
        <field name="notes">Staff meeting</field>
    </record>
    
    <record id="staff_availability_demo_4" model="health.staff.availability">
        <field name="staff_id" ref="demo_staff_nurse"/>
        <field name="date_start" eval="datetime.now() + timedelta(days=3)"/>
        <field name="date_end" eval="datetime.now() + timedelta(days=4)"/>
        <field name="availability_type">off</field>
        <field name="notes">Weekend off</field>
    </record>
    
</data>
</odoo>