<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Health Flow Main Template -->
    <t t-name="health_flow.HealthFlowTemplate">
        <div class="health_flow_container">

            <!-- Top Header Bar with User Info, Home Button, and Notifications -->
            <div class="health_flow_top_bar">
                <!-- Home Button -->
                <div class="health_flow_home_btn" role="button" tabindex="0" t-on-click="() => this.goHome()">
                    <i class="fa fa-home"></i>
                </div>

                <!-- User Info (Center) -->
                <div class="health_flow_user_info">
                    <span class="health_flow_user_name" t-esc="state.userName"/>
                    <t t-if="state.userFacility">
                        <span class="health_flow_user_separator">|</span>
                        <span class="health_flow_user_facility" t-esc="state.userFacility"/>
                    </t>
                </div>

                <!-- Booking Notifications -->
                <div class="health_flow_notifications">
                    <div class="health_flow_notification_btn" role="button" tabindex="0" t-on-click="() => this.toggleBookingNotifications()">
                        <i class="fa fa-calendar-plus-o"></i>
                        <t t-if="state.bookingNotifications.length > 0">
                            <span class="health_flow_notification_badge" t-esc="state.bookingNotifications.length"/>
                        </t>
                    </div>

                    <!-- Notifications Dropdown -->
                    <div class="health_flow_notifications_dropdown" t-att-class="{'open': state.bookingNotificationsOpen}">
                        <div class="health_flow_notifications_header">
                            <span>Booking Notifications</span>
                            <div class="health_flow_notifications_close" t-on-click="() => this.toggleBookingNotifications()">
                                <i class="fa fa-times"></i>
                            </div>
                        </div>
                        <div class="health_flow_notifications_list">
                            <t t-if="state.bookingNotifications.length === 0">
                                <div class="health_flow_notifications_empty">
                                    <i class="fa fa-check-circle"></i>
                                    <span>No new notifications</span>
                                </div>
                            </t>
                            <t t-foreach="state.bookingNotifications" t-as="notification" t-key="notification.id">
                                <div class="health_flow_notification_item"
                                     t-att-class="this.getNotificationClass(notification.type)"
                                     t-on-click="() => this.openNotificationBooking(notification)">
                                    <i t-att-class="'fa ' + this.getNotificationIcon(notification.type)"></i>
                                    <div class="health_flow_notification_content">
                                        <span class="health_flow_notification_title" t-esc="notification.title"/>
                                        <span class="health_flow_notification_subtitle" t-esc="notification.subtitle"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Horizontal Panel Strip (shows when a primary node is clicked) -->
            <div class="health_flow_horizontal_panel" t-att-class="{'open': state.panelOpen}">
                <div class="health_flow_horizontal_panel_header">
                    <h4 class="health_flow_horizontal_panel_title" t-esc="state.panelTitle"/>
                    <div class="health_flow_horizontal_panel_close" role="button" tabindex="0" t-on-click="() => this.closePanel()">
                        <i class="fa fa-times"></i>
                    </div>
                </div>
                <div class="health_flow_horizontal_panel_items">
                    <t t-foreach="state.panelItems" t-as="item" t-key="item.key">
                        <div class="health_flow_horizontal_tile" t-on-click="() => this.onPanelTileClick(item)">
                            <i t-att-class="'fa ' + item.icon + ' health_flow_tile_icon'"></i>
                            <span class="health_flow_tile_label" t-esc="item.label"/>
                            <t t-if="this.getTileCount(item) !== null">
                                <span class="health_flow_tile_count" t-esc="this.getTileCount(item)"/>
                            </t>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Main Circular Workflow Layout -->
            <div class="health_flow_circular_workflow" t-att-class="{'panel-open': state.panelOpen}">

                <!-- Flow Arrows (Clockwise Direction) -->
                <div class="health_flow_arrows">
                    <svg viewBox="0 0 700 700" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <!-- Arrow marker for path ends -->
                            <marker id="health-flow-arrowhead" markerWidth="6" markerHeight="5" refX="5" refY="2.5" orient="auto">
                                <polygon points="0 0, 6 2.5, 0 5" fill="#264A6A"/>
                            </marker>
                        </defs>

                        <!-- CRM (350,70) to Booking (570,220) -->
                        <path class="health_flow_arrow"
                              d="M 410,120 Q 490,145 510,175"
                              marker-end="url(#health-flow-arrowhead)"/>

                        <!-- Booking (570,220) to Invoicing (570,480) -->
                        <path class="health_flow_arrow"
                              d="M 570,285 Q 590,350 570,415"
                              marker-end="url(#health-flow-arrowhead)"/>

                        <!-- Invoicing (570,480) to Analytics (350,630) -->
                        <path class="health_flow_arrow"
                              d="M 510,525 Q 490,555 410,580"
                              marker-end="url(#health-flow-arrowhead)"/>

                        <!-- Analytics (350,630) to Audit (130,480) -->
                        <path class="health_flow_arrow"
                              d="M 290,580 Q 210,555 190,525"
                              marker-end="url(#health-flow-arrowhead)"/>

                        <!-- Audit (130,480) to Admin (130,220) -->
                        <path class="health_flow_arrow"
                              d="M 130,415 Q 110,350 130,285"
                              marker-end="url(#health-flow-arrowhead)"/>

                        <!-- Admin (130,220) to CRM (350,70) -->
                        <path class="health_flow_arrow"
                              d="M 190,175 Q 210,145 290,120"
                              marker-end="url(#health-flow-arrowhead)"/>
                    </svg>
                </div>

                <!-- CENTER: Client Badge -->
                <div class="health_flow_center_badge"
                     role="button"
                     tabindex="0"
                     t-on-click="() => this.onCenterClick()">
                    <i class="fa fa-users health_flow_center_icon"></i>
                    <span class="health_flow_center_text">Clients</span>
                </div>

                <!-- PRIMARY LEVEL: 6 Badges in Circle -->

                <!-- 1. CRM (Top - 12 o'clock) -->
                <div role="button"
                     tabindex="0"
                     class="health_flow_primary_badge badge-crm"
                     t-att-class="{'active': state.activePrimary === 'crm'}"
                     t-on-click="() => this.onPrimaryClick('crm')">
                    <i class="fa fa-handshake-o health_flow_primary_icon"></i>
                    <span class="health_flow_primary_text">Sales &amp; CRM</span>
                </div>

                <!-- 2. Booking (Top Right - 2 o'clock) -->
                <div role="button"
                     tabindex="0"
                     class="health_flow_primary_badge badge-booking"
                     t-att-class="{'active': state.activePrimary === 'booking'}"
                     t-on-click="() => this.onPrimaryClick('booking')">
                    <i class="fa fa-calendar-check-o health_flow_primary_icon"></i>
                    <span class="health_flow_primary_text">Bookings</span>
                </div>

                <!-- 3. Invoicing (Bottom Right - 4 o'clock) -->
                <div role="button"
                     tabindex="0"
                     class="health_flow_primary_badge badge-invoicing"
                     t-att-class="{'active': state.activePrimary === 'invoicing'}"
                     t-on-click="() => this.onPrimaryClick('invoicing')">
                    <i class="fa fa-money health_flow_primary_icon"></i>
                    <span class="health_flow_primary_text">Finance</span>
                </div>

                <!-- 4. Analytics (Bottom - 6 o'clock) -->
                <div role="button"
                     tabindex="0"
                     class="health_flow_primary_badge badge-analytics"
                     t-on-click="() => this.onPrimaryClick('analytics')">
                    <i class="fa fa-line-chart health_flow_primary_icon"></i>
                    <span class="health_flow_primary_text">Analytics</span>
                </div>

                <!-- 5. Audit (Bottom Left - 8 o'clock) -->
                <div role="button"
                     tabindex="0"
                     class="health_flow_primary_badge badge-audit"
                     t-on-click="() => this.onPrimaryClick('audit')">
                    <i class="fa fa-history health_flow_primary_icon"></i>
                    <span class="health_flow_primary_text">Audit</span>
                </div>

                <!-- 6. Admin (Top Left - 10 o'clock) -->
                <div role="button"
                     tabindex="0"
                     class="health_flow_primary_badge badge-admin"
                     t-att-class="{'active': state.activePrimary === 'admin'}"
                     t-on-click="() => this.onPrimaryClick('admin')">
                    <i class="fa fa-cogs health_flow_primary_icon"></i>
                    <span class="health_flow_primary_text">Admin</span>
                </div>

            </div>

            <!-- Client Choice Modal (Select Existing / Add New) -->
            <t t-if="state.clientChoiceModalOpen">
                <div class="health_flow_search_modal_backdrop" t-on-click="() =&gt; this.closeClientChoiceModal()">
                    <div class="health_flow_search_modal" t-on-click.stop="" style="max-width: 420px; padding: 30px;">
                        <div class="health_flow_search_modal_header" style="margin-bottom: 20px;">
                            <h3>Clients</h3>
                            <div class="health_flow_search_modal_close" t-on-click="() =&gt; this.closeClientChoiceModal()">
                                <i class="fa fa-times"></i>
                            </div>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 12px;">
                            <div role="button"
                                 style="display: flex; align-items: center; gap: 15px; padding: 16px 20px; border-radius: 10px; background: linear-gradient(135deg, #4299e1, #3182ce); color: white; cursor: pointer; font-size: 16px; font-weight: 600; transition: transform 0.15s;"
                                 t-on-click="() =&gt; this.onSelectExistingClient()">
                                <i class="fa fa-search fa-lg"></i>
                                <span>Select Existing Client</span>
                            </div>
                            <div role="button"
                                 style="display: flex; align-items: center; gap: 15px; padding: 16px 20px; border-radius: 10px; background: linear-gradient(135deg, #48bb78, #38a169); color: white; cursor: pointer; font-size: 16px; font-weight: 600; transition: transform 0.15s;"
                                 t-on-click="() =&gt; this.onAddNewClient()">
                                <i class="fa fa-user-plus fa-lg"></i>
                                <span>Add New Client</span>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

            <!-- Master Data Modal -->
            <t t-if="state.masterDataModalOpen">
                <div class="health_flow_search_modal_backdrop" t-on-click="() =&gt; this.closeMasterDataModal()">
                    <div class="health_flow_search_modal" t-on-click.stop="" style="max-width: 520px; padding: 30px;">
                        <div class="health_flow_search_modal_header" style="margin-bottom: 20px;">
                            <h3>Master Data</h3>
                            <div class="health_flow_search_modal_close" t-on-click="() =&gt; this.closeMasterDataModal()">
                                <i class="fa fa-times"></i>
                            </div>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <div role="button"
                                 style="display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-radius: 10px; background: #f7fafc; border: 1px solid #e2e8f0; cursor: pointer; font-size: 15px; font-weight: 500; transition: all 0.15s; color: #2d3748;"
                                 t-on-click="() =&gt; this.onMasterDataSelect('admin-facilities')">
                                <i class="fa fa-building fa-lg" style="color: #9f7aea; width: 24px; text-align: center;"></i>
                                <span>Healthcare Facility</span>
                            </div>
                            <div role="button"
                                 style="display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-radius: 10px; background: #f7fafc; border: 1px solid #e2e8f0; cursor: pointer; font-size: 15px; font-weight: 500; transition: all 0.15s; color: #2d3748;"
                                 t-on-click="() =&gt; this.onMasterDataSelect('admin-catchment-provinces')">
                                <i class="fa fa-globe fa-lg" style="color: #9f7aea; width: 24px; text-align: center;"></i>
                                <span>Catchment Province</span>
                            </div>
                            <div role="button"
                                 style="display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-radius: 10px; background: #f7fafc; border: 1px solid #e2e8f0; cursor: pointer; font-size: 15px; font-weight: 500; transition: all 0.15s; color: #2d3748;"
                                 t-on-click="() =&gt; this.onMasterDataSelect('admin-service-types')">
                                <i class="fa fa-list-ul fa-lg" style="color: #9f7aea; width: 24px; text-align: center;"></i>
                                <span>Service Types</span>
                            </div>
                            <div role="button"
                                 style="display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-radius: 10px; background: #f7fafc; border: 1px solid #e2e8f0; cursor: pointer; font-size: 15px; font-weight: 500; transition: all 0.15s; color: #2d3748;"
                                 t-on-click="() =&gt; this.onMasterDataSelect('admin-symptoms')">
                                <i class="fa fa-heartbeat fa-lg" style="color: #9f7aea; width: 24px; text-align: center;"></i>
                                <span>Symptoms</span>
                            </div>
                            <div role="button"
                                 style="display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-radius: 10px; background: #f7fafc; border: 1px solid #e2e8f0; cursor: pointer; font-size: 15px; font-weight: 500; transition: all 0.15s; color: #2d3748;"
                                 t-on-click="() =&gt; this.onMasterDataSelect('admin-referral-sources')">
                                <i class="fa fa-share-alt fa-lg" style="color: #9f7aea; width: 24px; text-align: center;"></i>
                                <span>Referral Sources</span>
                            </div>
                            <div role="button"
                                 style="display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-radius: 10px; background: #f7fafc; border: 1px solid #e2e8f0; cursor: pointer; font-size: 15px; font-weight: 500; transition: all 0.15s; color: #2d3748;"
                                 t-on-click="() =&gt; this.onMasterDataSelect('admin-insurance')">
                                <i class="fa fa-shield fa-lg" style="color: #9f7aea; width: 24px; text-align: center;"></i>
                                <span>Insurance Provider</span>
                            </div>
                            <div role="button"
                                 style="display: flex; align-items: center; gap: 14px; padding: 14px 18px; border-radius: 10px; background: #f7fafc; border: 1px solid #e2e8f0; cursor: pointer; font-size: 15px; font-weight: 500; transition: all 0.15s; color: #2d3748;"
                                 t-on-click="() =&gt; this.onMasterDataSelect('admin-urgency-levels')">
                                <i class="fa fa-exclamation-circle fa-lg" style="color: #9f7aea; width: 24px; text-align: center;"></i>
                                <span>Urgency Levels</span>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

            <!-- User Management Modal -->
            <t t-if="state.userMgmtModalOpen">
                <div class="health_flow_search_modal_backdrop" t-on-click="() =&gt; this.closeUserMgmtModal()">
                    <div class="health_flow_search_modal" t-on-click.stop="" style="max-width: 480px; padding: 30px;">
                        <div class="health_flow_search_modal_header" style="margin-bottom: 20px;">
                            <h3>User Management</h3>
                            <div class="health_flow_search_modal_close" t-on-click="() =&gt; this.closeUserMgmtModal()">
                                <i class="fa fa-times"></i>
                            </div>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            <div role="button"
                                 style="display: flex; align-items: center; gap: 14px; padding: 16px 18px; border-radius: 10px; background: linear-gradient(135deg, #9f7aea, #805ad5); color: white; cursor: pointer; font-size: 15px; font-weight: 600; transition: all 0.15s;"
                                 t-on-click="() =&gt; this.onUserMgmtSelect('admin-user-list')">
                                <i class="fa fa-user-circle fa-lg" style="width: 24px; text-align: center;"></i>
                                <div>
                                    <span>Users</span>
                                    <div style="font-size: 12px; font-weight: 400; opacity: 0.85; margin-top: 2px;">Add, edit, and manage user accounts</div>
                                </div>
                            </div>
                            <div role="button"
                                 style="display: flex; align-items: center; gap: 14px; padding: 16px 18px; border-radius: 10px; background: linear-gradient(135deg, #805ad5, #6b46c1); color: white; cursor: pointer; font-size: 15px; font-weight: 600; transition: all 0.15s;"
                                 t-on-click="() =&gt; this.onUserMgmtSelect('admin-access-roles')">
                                <i class="fa fa-key fa-lg" style="width: 24px; text-align: center;"></i>
                                <div>
                                    <span>Access Roles</span>
                                    <div style="font-size: 12px; font-weight: 400; opacity: 0.85; margin-top: 2px;">Define permission bundles for user groups</div>
                                </div>
                            </div>
                            <div role="button"
                                 style="display: flex; align-items: center; gap: 14px; padding: 16px 18px; border-radius: 10px; background: linear-gradient(135deg, #6b46c1, #553c9a); color: white; cursor: pointer; font-size: 15px; font-weight: 600; transition: all 0.15s;"
                                 t-on-click="() =&gt; this.onUserMgmtSelect('admin-role-management')">
                                <i class="fa fa-shield fa-lg" style="width: 24px; text-align: center;"></i>
                                <div>
                                    <span>Role Management</span>
                                    <div style="font-size: 12px; font-weight: 400; opacity: 0.85; margin-top: 2px;">Configure restrictions, hidden menus, and field access</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

            <!-- Booking Search Modal -->
            <t t-if="state.searchModalOpen">
                <div class="health_flow_search_modal_backdrop" t-on-click="() => this.closeSearchModal()">
                    <div class="health_flow_search_modal" t-on-click.stop="">
                        <div class="health_flow_search_modal_header">
                            <h3 t-esc="state.searchType === 'crm' ? 'CRM Search' : 'Booking Search'"/>
                            <div class="health_flow_search_modal_close" t-on-click="() => this.closeSearchModal()">
                                <i class="fa fa-times"></i>
                            </div>
                        </div>
                        <div class="health_flow_search_modal_body">
                            <div class="health_flow_search_form">
                                <input type="text"
                                       class="health_flow_search_input"
                                       t-att-placeholder="state.searchType === 'crm' ? 'Search by name, phone, or email...' : 'Search by client name, phone, or booking code...'"
                                       t-model="state.searchQuery"
                                       t-on-input="onSearchInput"/>
                            </div>
                            <div class="health_flow_search_results" t-if="this.getSearchResultCount() > 0">
                                <!-- Merge Button (appears when 2+ leads selected) -->
                                <div class="health_flow_merge_controls" t-if="state.searchType === 'crm' and state.selectedLeadIds.length >= 2">
                                    <button class="health_flow_merge_button"
                                            t-on-click="() => this.mergeCrmLeads()">
                                        <i class="fa fa-clone"/> Merge <t t-esc="state.selectedLeadIds.length"/> contacts
                                    </button>
                                </div>

                                <!-- Booking Result -->
                                <t t-if="state.searchType === 'booking'">
                                    <t t-foreach="state.searchResults.bookings" t-as="result" t-key="result.id">
                                        <div class="health_flow_search_result_card"
                                             t-att-class="'status-' + result.status + (this.isLeadSelected(result.id) ? ' selected' : '')"
                                             t-on-click="(event) => this.onSearchResultClick('booking', result.id, event)">
                                            <div class="health_flow_search_result_checkbox">
                                                <input type="checkbox"
                                                       t-att-checked="this.isLeadSelected(result.id)"
                                                       t-on-change="(event) => this.onLeadCheckboxChange(event, result.id)"/>
                                            </div>
                                            <div class="health_flow_search_result_header">
                                                <span class="health_flow_search_result_client" t-esc="result.client_name"/>
                                                <span class="health_flow_search_result_status" t-esc="result.status"/>
                                            </div>
                                            <div class="health_flow_search_result_details">
                                                <div><i class="fa fa-user-md"/> <t t-esc="result.lead_nurse"/></div>
                                                <div><i class="fa fa-calendar"/> <t t-esc="result.appointment_date"/></div>
                                            </div>
                                        </div>
                                    </t>
                                </t>

                                <!-- CRM Results -->
                                <t t-if="state.searchType === 'crm'">
                                    <t t-if="state.searchResults.clients.length">
                                        <div class="health_flow_search_section_title">Clients</div>
                                        <t t-foreach="state.searchResults.clients" t-as="result" t-key="result.id">
                                            <div class="health_flow_search_result_card"
                                                 t-att-class="'client-result'"
                                                 t-on-click="(event) => this.onSearchResultClick('client', result.id, event)">
                                                <div class="health_flow_search_result_header">
                                                    <span class="health_flow_search_result_client" t-esc="result.name"/>
                                                    <span class="health_flow_search_result_status" t-esc="result.patient_code"/>
                                                </div>
                                                <div class="health_flow_search_result_details">
                                                    <div><i class="fa fa-phone"/> <t t-esc="result.phone"/></div>
                                                    <div><i class="fa fa-envelope"/> <t t-esc="result.email"/></div>
                                                </div>
                                            </div>
                                        </t>
                                    </t>

                                    <t t-if="state.searchResults.leads.length">
                                        <div class="health_flow_search_section_title">Contacts</div>
                                        <t t-foreach="state.searchResults.leads" t-as="result" t-key="result.id">
                                            <div class="health_flow_search_result_card"
                                                 t-att-class="'status-' + result.contact_outcome + (this.isLeadSelected(result.id) ? ' selected' : '')"
                                                 t-on-click="(event) => this.onSearchResultClick('lead', result.id, event)">
                                                <div class="health_flow_search_result_checkbox">
                                                    <input type="checkbox"
                                                           t-att-checked="this.isLeadSelected(result.id)"
                                                           t-on-change="(event) => this.onLeadCheckboxChange(event, result.id)"/>
                                                </div>
                                                <div class="health_flow_search_result_header">
                                                    <span class="health_flow_search_result_client" t-esc="result.name"/>
                                                    <span class="health_flow_search_result_status" t-esc="result.stage"/>
                                                </div>
                                                <div class="health_flow_search_result_details">
                                                    <div><i class="fa fa-phone"/> <t t-esc="result.phone"/></div>
                                                    <div><i class="fa fa-envelope"/> <t t-esc="result.email"/></div>
                                                </div>
                                            </div>
                                        </t>
                                    </t>
                                </t>
                            </div>
                            <div class="health_flow_search_empty" t-if="state.searchQuery and this.getSearchResultCount() === 0">
                                <i class="fa fa-search fa-3x"/>
                                <p t-esc="state.searchType === 'crm' ? 'No CRM results found' : 'No bookings found'"/>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

        </div>
    </t>

</templates>
