<?xml version="1.0" encoding="utf-8"?>
<!-- ======================================================================
     THREE SCHEDULED JOBS, AND NOT ONE OF THEM INSTALLS ANYTHING (rail R1).

     Two of them only READ a customer's system and write down what they found
     on OUR record; the third writes a copy of it to disk. Nothing here
     installs, upgrades, repairs or configures anybody's system, and nothing
     ever will: a customer's system does not change while everybody is asleep.
     That sentence is on the "In step with master" screen as well, so nobody
     has to read this file to know it.

     `noupdate="1"` so that an operator who moves one of these to a quieter
     hour keeps their decision through every later release.
     ====================================================================== -->
<odoo noupdate="1">

    <!-- Every night, before the drift read, so the morning screen shows a copy
         that is newer than the reading beside it. -->
    <record id="cron_nightly_backups" model="ir.cron">
        <field name="name">Customers: nightly copy of every live customer</field>
        <field name="model_id" ref="model_biz_tenants"/>
        <field name="state">code</field>
        <field name="code">model._cron_nightly_backups()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall"
               eval="(DateTime.now().replace(hour=19, minute=30, second=0)
                      + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <!-- READ ONLY. It measures every customer against the current release so
         that the number on the morning screen is honest rather than however
         old the last button-press left it. -->
    <record id="cron_drift" model="ir.cron">
        <field name="name">Customers: read how far each one has drifted</field>
        <field name="model_id" ref="model_biz_tenants"/>
        <field name="state">code</field>
        <field name="code">model._cron_drift()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall"
               eval="(DateTime.now().replace(hour=21, minute=15, second=0)
                      + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <!-- Hourly, and cheap: a handful of queries and one request per customer.
         A health reading taken once a day is a health reading that is wrong for
         most of it. -->
    <record id="cron_health" model="ir.cron">
        <field name="name">Customers: read each one's health</field>
        <field name="model_id" ref="model_biz_tenants"/>
        <field name="state">code</field>
        <field name="code">model._cron_health()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <!-- ==================================================================
         AND FIVE MORE, AND STILL NOT ONE OF THEM INSTALLS ANYTHING.

         The rollout worker is the only one that changes a customer's system
         at all, and it changes it ONLY by doing what a person already wrote
         down when they pressed Start. With nobody having pressed it, the
         worker looks for a rollout, finds none, and stops — which is what it
         does on nearly every run it will ever make.
         ================================================================== -->

    <!-- Every fifteen minutes: look at everything, compare it with what was
         already known, and write down what changed. With no outgoing mail
         account this job speaks to nobody — everything it would have sent is
         written on the Alerts screen instead, and it says so there. -->
    <record id="cron_alerts" model="ir.cron">
        <field name="name">Platform: look for anything wrong</field>
        <field name="model_id" ref="model_biz_tenants"/>
        <field name="state">code</field>
        <field name="code">model._cron_alerts()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- One short summary a day. THE EMPTY ONE IS THE POINT: a channel that
         only ever speaks when something is broken cannot be told apart from a
         channel that is broken. -->
    <record id="cron_alert_digest" model="ir.cron">
        <field name="name">Platform: the morning summary</field>
        <field name="model_id" ref="model_biz_tenants"/>
        <field name="state">code</field>
        <field name="code">model._cron_alert_digest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall"
               eval="(DateTime.now().replace(hour=1, minute=0, second=0)
                      + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <!-- The public page, rewritten every five minutes. It also rewrites itself
         at the end of every check and after every message sent or cleared;
         this job is what makes the timestamp on it move on a quiet day, which
         is what stops the page silently going stale. -->
    <record id="cron_status_page" model="ir.cron">
        <field name="name">Platform: rewrite the public page</field>
        <field name="model_id" ref="model_biz_tenants"/>
        <field name="state">code</field>
        <field name="code">model._cron_status_page()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- One step of whatever a PERSON started, every five minutes. It never
         starts anything and it never opens a new ring around a failure. -->
    <record id="cron_rollout_worker" model="ir.cron">
        <field name="name">Releases: carry on with a rollout somebody started</field>
        <field name="model_id" ref="model_biz_tenants"/>
        <field name="state">code</field>
        <field name="code">model._cron_rollout_worker()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Hourly: warn the customers whose quiet window opens within a day, on
         their own screens, in their own clock. It only ever speaks to a
         customer already on somebody's list. -->
    <record id="cron_rollout_notices" model="ir.cron">
        <field name="name">Releases: warn tomorrow's customers</field>
        <field name="model_id" ref="model_biz_tenants"/>
        <field name="state">code</field>
        <field name="code">model._cron_rollout_notices()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <!-- ==================================================================
         AND THE TWO THIS PHASE ADDS. NEITHER OF THEM INVOICES ANYBODY.

         The reading job READS every customer and writes the numbers down on
         OUR system. The billing job moves OUR invoices along and raises
         flags on OUR screen. Between them they cannot install anything, they
         cannot invoice anybody, and the ONE thing they can do to a customer
         is pause them — only when the owner has deliberately switched the
         automatic pause on, which ships OFF and stays off until somebody
         moves it.
         ================================================================== -->

    <!-- Daily, and the interesting day is the 1st: the method itself works out
         which month has just ended, so a machine that was switched off on the
         1st still writes the reading down on the 2nd. A month that already has
         a reading is never given a second one. -->
    <record id="cron_meter_snapshot" model="ir.cron">
        <field name="name">Customers: write down the month's numbers</field>
        <field name="model_id" ref="model_biz_tenants"/>
        <field name="state">code</field>
        <field name="code">model._cron_meter_snapshot()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall"
               eval="(DateTime.now().replace(hour=2, minute=30, second=0)
                      + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <!-- Once a morning: which invoices are past their date, which trials are
         running out, and which retention clocks have passed. It raises flags
         and it does not send anything, because there is nothing to send with. -->
    <record id="cron_billing" model="ir.cron">
        <field name="name">Customers: chase what is owed and count the trials down</field>
        <field name="model_id" ref="model_biz_tenants"/>
        <field name="state">code</field>
        <field name="code">model._cron_billing()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall"
               eval="(DateTime.now().replace(hour=7, minute=15, second=0)
                      + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

</odoo>
