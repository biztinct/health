<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The invoice a customer receives.

         Odoo 19's explicit `record model="ir.actions.report"` form. The old
         shortcut tag was removed from this framework and fails at load with a
         message that names the file rather than the tag.

         NOT the framework's shared document layout. That layout prints the
         COMPANY's header and footer, which on the platform's own system is the
         platform — and its footer carries the framework's own "powered by"
         line, which is a user-visible string with the wrong word in it
         (rail R12). Everything here is drawn by hand, so what is on the page is
         what we put on it.
    -->
    <record id="action_report_tenant_invoice" model="ir.actions.report">
        <field name="name">Invoice</field>
        <field name="model">biz.tenant.invoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">biz_tenants.report_tenant_invoice</field>
        <field name="report_file">biz_tenants.report_tenant_invoice</field>
        <field name="print_report_name">'%s' % object.number</field>
    </record>

    <template id="report_tenant_invoice">
        <!-- ⚠ THE DOCUMENT'S OWN TITLE, SET BEFORE THE CONTAINER IS CALLED
             (ledger F55). The shared report layout renders
             `title or 'Odoo Report'`, and that string becomes the PDF's
             document title — which a reader sees in their viewer's window and
             in the file's own properties. It is a user-visible string like any
             other, and this document goes to a paying customer. -->
        <t t-set="title">Invoice</t>
        <!-- THE PAGE HAS NO HEADER, SO IT MUST NOT RESERVE ROOM FOR ONE
             (ledger F55's second half). The paper format leaves about 35 mm at
             the top for the company header every standard report prints; this
             document draws its own, so without these the invoice begins a
             third of the way down a mostly empty sheet. Read off the root html
             tag by the renderer. -->
        <t t-set="data_report_margin_top" t-value="7"/>
        <t t-set="data_report_header_spacing" t-value="0"/>
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="inv">
                <t t-set="d" t-value="inv._billing_render_data()"/>
                <!-- ⚠ `article` IS LOAD-BEARING AND IT IS ABOUT THE CHARACTER
                     SET (ledger F54). The PDF printer is handed one file per
                     `div class="article"` found in the rendered page, each one
                     wrapped in the minimal layout — which is the only thing
                     that carries the utf-8 declaration. A document with no
                     `article` div falls through to a fallback that hands the
                     printer a bare fragment, the printer reads it as Latin-1,
                     and every ₫ on the invoice comes out as "â‚«" and every
                     em dash as "â€”". It renders, it looks deliberate, and it
                     goes to the customer. The data-oe-* attributes are the
                     same convention, so a multi-invoice print keeps its pages
                     in step with its records. -->
                <div class="article page"
                     t-att-data-oe-model="inv._name" t-att-data-oe-id="inv.id"
                     t-att-data-oe-lang="inv.env.context.get('lang')"
                     style="font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color:#101828; font-size:12px;">
                    <style>
                        .bzi-h { display:flex; justify-content:space-between; align-items:flex-start; border-bottom:2px solid #1565C0; padding-bottom:14px; margin-bottom:20px; }
                        .bzi-brand { font-size:22px; font-weight:800; letter-spacing:-.5px; color:#1565C0; }
                        .bzi-eyebrow { font-size:9px; letter-spacing:.14em; text-transform:uppercase; color:#667085; font-weight:700; }
                        .bzi-no { font-size:16px; font-weight:700; text-align:right; }
                        .bzi-cols { width:100%; margin-bottom:22px; }
                        .bzi-cols td { vertical-align:top; width:50%; padding-right:16px; }
                        .bzi-label { font-size:9px; letter-spacing:.12em; text-transform:uppercase; color:#667085; font-weight:700; margin-bottom:5px; }
                        .bzi-block { font-size:12px; line-height:1.6; }
                        /* ⚠ `pre-wrap` ONLY WHERE IT IS NEEDED. Put on the whole
                           block it also honours the TEMPLATE's own indentation, and
                           the customer's name prints twenty spaces in from the left
                           of its own column. Only the address is genuinely
                           multi-line. */
                        .bzi-pre { white-space:pre-wrap; }
                        .bzi-tbl { width:100%; border-collapse:collapse; margin-bottom:14px; }
                        .bzi-tbl th { text-align:left; font-size:9px; letter-spacing:.1em; text-transform:uppercase; color:#667085; border-bottom:1px solid #E3E8EF; padding:0 8px 7px 0; }
                        .bzi-tbl th.num, .bzi-tbl td.num { text-align:right; padding-right:0; }
                        .bzi-tbl td { padding:10px 8px 10px 0; border-bottom:1px solid #F2F4F7; vertical-align:top; }
                        .bzi-detail { color:#667085; font-size:10px; display:block; margin-top:2px; }
                        .bzi-why { font-size:10.5px; color:#475467; background:#F7F9FC; border-left:3px solid #1565C0; padding:8px 12px; margin:0 0 18px; }
                        .bzi-tot { width:56%; margin-left:44%; border-collapse:collapse; }
                        .bzi-tot td { padding:5px 0; font-size:12px; }
                        .bzi-tot td.num { text-align:right; }
                        .bzi-tot tr.grand td { border-top:2px solid #1565C0; padding-top:9px; font-size:15px; font-weight:800; }
                        .bzi-bank { border-left:3px solid #1565C0; padding:8px 0 8px 13px; margin:22px 0 0; font-size:11px; line-height:1.7; white-space:pre-wrap; }
                        .bzi-warn { border-left:3px solid #B42318; background:#FEF3F2; color:#B42318; padding:9px 13px; margin:22px 0 0; font-size:11px; line-height:1.6; }
                        .bzi-foot { margin-top:24px; padding-top:12px; border-top:1px solid #E3E8EF; font-size:10px; color:#667085; line-height:1.6; }
                        .bzi-chip { display:inline-block; padding:3px 9px; border-radius:20px; font-size:9px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; }
                        .bzi-paid { background:#ECFDF3; color:#027A48; }
                        .bzi-void { background:#F2F4F7; color:#667085; }
                    </style>

                    <div class="bzi-h">
                        <div>
                            <div class="bzi-brand" t-esc="d['seller_name']"/>
                        </div>
                        <div>
                            <div class="bzi-eyebrow">Invoice</div>
                            <div class="bzi-no" t-esc="d['number']"/>
                            <div style="text-align:right;margin-top:5px;">
                                <span t-if="d['state'] == 'paid'" class="bzi-chip bzi-paid">Paid</span>
                                <span t-if="d['state'] == 'cancelled'" class="bzi-chip bzi-void">Cancelled</span>
                            </div>
                        </div>
                    </div>

                    <table class="bzi-cols">
                        <tr>
                            <td>
                                <div class="bzi-label">Billed to</div>
                                <div class="bzi-block"><b t-esc="d['customer_name']"/>
                                    <div class="bzi-pre" t-if="d['customer_address']" t-esc="d['customer_address']"/>
                                    <div t-if="d['customer_vat']">Tax number: <t t-esc="d['customer_vat']"/></div>
                                    <div t-if="d['customer_email']" t-esc="d['customer_email']"/>
                                </div>
                            </td>
                            <td>
                                <div class="bzi-label">From</div>
                                <div class="bzi-block"><b t-esc="d['seller_name']"/>
                                    <div class="bzi-pre" t-if="d['seller_address']" t-esc="d['seller_address']"/>
                                    <div t-if="d['seller_vat']">Tax number: <t t-esc="d['seller_vat']"/></div>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <table class="bzi-cols">
                        <tr>
                            <td>
                                <div class="bzi-label">For the month of</div>
                                <div class="bzi-block"><b t-esc="d['period_label']"/></div>
                            </td>
                            <td>
                                <div class="bzi-label">Issued — due by</div>
                                <div class="bzi-block"><t t-esc="d['issued_on']"/> — <b t-esc="d['due_on']"/></div>
                            </td>
                        </tr>
                    </table>

                    <table class="bzi-tbl">
                        <thead>
                            <tr>
                                <th style="width:52%">What this covers</th>
                                <th class="num" style="width:12%">How many</th>
                                <th class="num" style="width:18%">Price each</th>
                                <th class="num" style="width:18%">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="d['lines']" t-as="line">
                                <td>
                                    <b t-esc="line['label']"/>
                                    <span t-if="line['detail']" class="bzi-detail" t-esc="line['detail']"/>
                                </td>
                                <td class="num" t-esc="line['qty_h']"/>
                                <td class="num" t-esc="line['unit_h']"/>
                                <td class="num" t-esc="line['amount_h']"/>
                            </tr>
                        </tbody>
                    </table>

                    <!-- THE ARITHMETIC IN WORDS, on the document as well as on
                         the preview. The first question anybody asks about an
                         invoice is "why is it this much", and the answer costs
                         one line. -->
                    <div t-if="d['explain']" class="bzi-why">
                        How this was worked out: <t t-esc="d['explain']"/>
                    </div>

                    <table class="bzi-tot">
                        <tr>
                            <td>Subtotal</td>
                            <td class="num" t-esc="d['subtotal_h']"/>
                        </tr>
                        <tr t-if="d['vat_rate']">
                            <td>Tax at <t t-esc="d['vat_rate_h']"/>%</td>
                            <td class="num" t-esc="d['vat_h']"/>
                        </tr>
                        <tr class="grand">
                            <td>Total to pay</td>
                            <td class="num" t-esc="d['total_h']"/>
                        </tr>
                    </table>

                    <div t-if="d['bank_details']" class="bzi-bank">
                        <div class="bzi-label" style="margin-bottom:6px;">How to pay</div>
                        <t t-esc="d['bank_details']"/>
                    </div>

                    <!-- ⚠ THE DOCUMENT SAYS SO ITSELF RATHER THAN PRINTING AN
                         INVOICE THAT CANNOT BE PAID. A request for money with
                         no way to send it is worse than no document at all,
                         and the person who receives it has no way of knowing
                         that was an oversight. -->
                    <div t-if="d['missing']" class="bzi-warn">
                        <b>Not ready to send.</b>
                        <t t-esc="d['missing_text']"/>
                        Fill those in on the Billing settings screen, then make
                        this document again.
                    </div>

                    <div class="bzi-foot">
                        <div t-if="d['footer']" t-esc="d['footer']"/>
                        <div>Please quote <b t-esc="d['number']"/> with your payment.</div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
