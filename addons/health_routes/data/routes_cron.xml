<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Nightly travel-feasibility sweep (03:00) — handover §2.3. -->
        <record id="cron_route_feasibility_sweep" model="ir.cron">
            <field name="name">Routes: nightly travel-feasibility sweep</field>
            <field name="model_id" ref="model_health_route_transition"/>
            <field name="state">code</field>
            <field name="code">model.cron_route_feasibility_sweep()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=0, second=0) + timedelta(days=1))"/>
        </record>

    </data>
</odoo>
