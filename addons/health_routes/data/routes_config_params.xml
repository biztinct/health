<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Default config (mirrors res_config_settings defaults). -->
        <record id="param_routes_enabled" model="ir.config_parameter">
            <field name="key">health_routes.enabled</field>
            <field name="value">True</field>
        </record>
        <record id="param_routes_buffer_minutes" model="ir.config_parameter">
            <field name="key">health_routes.buffer_minutes</field>
            <field name="value">10</field>
        </record>
        <record id="param_routes_horizon_days" model="ir.config_parameter">
            <field name="key">health_routes.horizon_days</field>
            <field name="value">7</field>
        </record>
        <record id="param_routes_leg_ttl_days" model="ir.config_parameter">
            <field name="key">health_routes.leg_ttl_days</field>
            <field name="value">30</field>
        </record>
        <!-- OFF on vietuat — UAT must not hammer public OSRM. -->
        <record id="param_routes_use_external_router" model="ir.config_parameter">
            <field name="key">health_routes.use_external_router</field>
            <field name="value">False</field>
        </record>

    </data>
</odoo>
