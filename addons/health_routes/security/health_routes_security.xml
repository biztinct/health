<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Catchment record-rule pair on transitions (staff-keyed — mirrors
         health_self_booking/security). Transitions are created by the nightly
         cron with sudo(); internal read is nurse+ scoped to their catchment,
         owner sees all. Legs are pure geometry — no catchment rule. -->
    <record id="rule_route_transition_catchment" model="ir.rule">
        <field name="name">Route transition: healthcare users see own catchment</field>
        <field name="model_id" ref="model_health_route_transition"/>
        <field name="domain_force">['&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_nurse')), (4, ref('health_base.group_healthcare_head_nurse')), (4, ref('health_base.group_healthcare_doctor')), (4, ref('health_base.group_healthcare_operations_manager')), (4, ref('health_base.group_healthcare_manager'))]"/>
    </record>
    <record id="rule_route_transition_owner" model="ir.rule">
        <field name="name">Route transition: owner sees all</field>
        <field name="model_id" ref="model_health_route_transition"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_owner'))]"/>
    </record>

</odoo>
