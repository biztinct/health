<odoo>
    <!-- Odoo 19: Most template inherits removed due to changed structure -->
    <!-- Only keeping safe modifications -->
    <template id="web_layout" inherit_id="web.layout">
        <xpath expr="//title" position="replace">
            <title t-out="title" />
        </xpath>
    </template>
</odoo>
