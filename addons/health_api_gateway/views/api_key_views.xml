<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root menu: Settings / Technical / API Gateway -->
    <menuitem id="menu_gateway_root" name="API Gateway"
              parent="base.menu_custom" sequence="60"
              groups="health_api_gateway.group_gateway_admin"/>

    <!-- Scopes -->
    <record id="view_api_key_scope_list" model="ir.ui.view">
        <field name="name">api.key.scope.list</field>
        <field name="model">api.key.scope</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_api_key_scope_form" model="ir.ui.view">
        <field name="name">api.key.scope.form</field>
        <field name="model">api.key.scope</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_api_key_scope" model="ir.actions.act_window">
        <field name="name">API Scopes</field>
        <field name="res_model">api.key.scope</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_api_key_scope" name="Scopes"
              parent="menu_gateway_root" action="action_api_key_scope"
              sequence="40"/>

    <!-- Gateway fields on Odoo API keys -->
    <record id="view_res_users_apikeys_gateway_form" model="ir.ui.view">
        <field name="name">res.users.apikeys.gateway.form</field>
        <field name="model">res.users.apikeys</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Key">
                            <field name="name" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="gateway_active"/>
                        </group>
                        <group string="Gateway Access">
                            <field name="ip_allowlist"/>
                            <field name="scope_ids" widget="many2many_tags"/>
                            <field name="facility_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_users_apikeys_gateway_list" model="ir.ui.view">
        <field name="name">res.users.apikeys.gateway.list</field>
        <field name="model">res.users.apikeys</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="gateway_active"/>
                <field name="scope_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="action_res_users_apikeys_gateway" model="ir.actions.act_window">
        <field name="name">API Keys</field>
        <field name="res_model">res.users.apikeys</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_res_users_apikeys_gateway_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_res_users_apikeys_gateway_form')})]"/>
    </record>

    <menuitem id="menu_res_users_apikeys_gateway" name="API Keys"
              parent="menu_gateway_root" action="action_res_users_apikeys_gateway"
              sequence="10"/>
</odoo>
