<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- One insertion point, every screen.

         Anchored on MainComponentsContainer, NOT on ActionContainer:
         health_fieldservice already replaces ActionContainer with its own
         wrapper, and two modules xpath-ing the same node is how a patch quietly
         stops applying after an unrelated upgrade. This node is core and
         untouched. -->
    <t t-name="web.WebClient" t-inherit="web.WebClient" t-inherit-mode="extension">
        <xpath expr="//MainComponentsContainer" position="after">
            <CoachHost/>
        </xpath>
    </t>

</templates>
