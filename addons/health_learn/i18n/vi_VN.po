#: model:learn.station,name:health_learn.station_leadanalysis
msgid "Lead Analysis"
msgstr "Phân tích khách tiềm năng"

#. module: health_learn
#: model:learn.string,value:health_learn.str_leadstab
msgid "Leads"
msgstr "Khách tiềm năng"

#. module: health_learn
