<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Groups
         ================================================================
         Only one new group. Content is owned by Product and edited by
         release; there is no per-tenant content author role, because the
         moment one exists the tutorials fork (analysis §8).
    -->
    <record id="group_learn_author" model="res.groups">
        <field name="name">Learning content author</field>
        <!-- Odoo 19: res.groups.category_id is gone; groups hang off a
             res.groups.privilege. Same one the other healthcare groups use. -->
        <field name="privilege_id" ref="health_base.res_groups_privilege_healthcare"/>
        <field name="comment">Edits the learning content spine. Product only —
            content ships with the module and is identical in every clinic.</field>
    </record>

    <!-- ================================================================
         Record rules
         ================================================================
         Rules for the same model across different groups are OR'd, so the
         author rules widen rather than narrow what a learner can see.
    -->

    <!-- Progress: a learner sees their own row and nobody else's. -->
    <record id="rule_learn_progress_own" model="ir.rule">
        <field name="name">Learn progress: own rows only</field>
        <field name="model_id" ref="model_learn_progress"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_learn_progress_author" model="ir.rule">
        <field name="name">Learn progress: authors read everything</field>
        <field name="model_id" ref="model_learn_progress"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_learn_author'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Events: same shape. The model itself refuses write/unlink for
         everyone, so these rules only govern who can READ whose events. -->
    <record id="rule_learn_event_own" model="ir.rule">
        <field name="name">Learn events: own rows only</field>
        <field name="model_id" ref="model_learn_event"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_learn_event_author" model="ir.rule">
        <field name="name">Learn events: authors read everything</field>
        <field name="model_id" ref="model_learn_event"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_learn_author'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Tenant overrides: the shipped defaults (company_id = False) are
         readable by everyone; a clinic's own rows are readable and editable
         only inside that clinic. Global rule, so it AND's with everything. -->
    <record id="rule_learn_override_company" model="ir.rule">
        <field name="name">Learn overrides: shipped defaults + own clinic</field>
        <field name="model_id" ref="model_learn_tenant_override"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
