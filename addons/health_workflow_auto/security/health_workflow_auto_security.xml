<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Timecard mismatch: an ordinary employee may read only their own
             rows; HR officers/managers see all (their non-global rule OR's in). -->
        <record id="rule_timecard_mismatch_own" model="ir.rule">
            <field name="name">Timecard mismatch: own rows (employee)</field>
            <field name="model_id" ref="model_health_timecard_mismatch"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_timecard_mismatch_officer_all" model="ir.rule">
            <field name="name">Timecard mismatch: all rows (HR officer)</field>
            <field name="model_id" ref="model_health_timecard_mismatch"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
        </record>

    </data>
</odoo>
