<?xml version="1.0" encoding="UTF-8"?>
<!-- Part of the Viet Uc Care white-label layer. License LGPL-3.
     web_debranding's runtime _t() lookup misses this term (its key gets
     debranded), so the raw "Odoo Push…" English source leaks through.
     Drop the "Odoo" word directly in the template — brand-neutral, SaaS-safe. -->
<templates xml:space="preserve">
    <t t-name="biz_debranding.NotificationAlert" t-inherit="web.NotificationAlert" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('alert')]" position="replace">
            <div t-if="isNotificationBlocked" class="alert alert-primary text-center">
                Push notifications have been blocked. Go to your browser settings to allow them.
            </div>
        </xpath>
    </t>
</templates>
