<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Company scoping. The service methods already company-scope every
         search via sudo(); this rule is belt-and-suspenders so any direct
         (non-sudo) read stays within the user's allowed companies. -->
    <record id="care_conversation_company_rule" model="ir.rule">
        <field name="name">Care Conversation: multi-company</field>
        <field name="model_id" ref="model_care_conversation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="care_reply_template_company_rule" model="ir.rule">
        <field name="name">Care Reply Template: multi-company</field>
        <field name="model_id" ref="model_care_reply_template"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="care_watch_phrase_company_rule" model="ir.rule">
        <field name="name">Care Watch Phrase: multi-company</field>
        <field name="model_id" ref="model_care_watch_phrase"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!--
        Catchment scoping for direct (non-sudo) reads: the backend list view,
        the chatter, any report. The Care Command workspace itself does NOT
        rely on these — every one of its reads is sudo'd, so `_scope_domain`
        carries the enforcement there (care_conversation.py:572). Both halves
        are needed; neither covers the other.

        Owner bypass is mandatory for the reason spelled out in
        health_catchment_scope/security: owner implies admin implies manager,
        and manager is in the scoped list, so an owner would otherwise be
        pinned to one area by their own inherited groups.
    -->
    <record id="care_conversation_catchment_rule" model="ir.rule">
        <field name="name">Care Conversation: staff see their own catchment</field>
        <field name="model_id" ref="model_care_conversation"/>
        <field name="domain_force">['|', ('catchment_province_id', '=', False), ('catchment_province_id', '=', user.catchment_province_id.id)]</field>
        <field name="groups" eval="[
            (4, ref('health_crm.group_health_crm_user')),
            (4, ref('health_crm.group_health_crm_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="care_conversation_catchment_owner_rule" model="ir.rule">
        <field name="name">Care Conversation: Owner sees every catchment</field>
        <field name="model_id" ref="model_care_conversation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_owner'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
