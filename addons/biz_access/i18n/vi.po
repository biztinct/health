#. module: biz_access
#: model:mail.template,body_html:biz_access.mail_template_delegation_handed
msgid ""
"<div style=\"margin:0; padding:0; font-family:Inter,Helvetica,Arial,sans-serif; color:#1B1733;\">\n"
"                <p>Hello,</p>\n"
"                <p>\n"
"                    <strong><t t-out=\"object.delegator_user_id.name or ''\"/></strong>\n"
"                    has handed some of what they can do to\n"
"                    <strong><t t-out=\"object.delegate_user_id.name or ''\"/></strong>.\n"
"                    Both of you are getting this message.\n"
"                </p>\n"
"                <p><strong>What was handed over</strong></p>\n"
"                <ul>\n"
"                    <t t-foreach=\"object.profile_ids\" t-as=\"prof\">\n"
"                        <li>\n"
"                            <strong><t t-out=\"prof.name or ''\"/></strong>\n"
"                            — <t t-out=\"prof.description or ''\"/>\n"
"                        </li>\n"
"                    </t>\n"
"                </ul>\n"
"                <p t-if=\"object.kind == 'temporary'\">\n"
"                    It runs from <strong><t t-out=\"object.date_start or ''\"/></strong>\n"
"                    until <strong><t t-out=\"object.date_end or ''\"/></strong>.\n"
"                    On the morning after that it is taken back automatically —\n"
"                    nobody has to remember.\n"
"                </p>\n"
"                <p t-if=\"object.kind != 'temporary'\">\n"
"                    It has no end date. Either of you can have it taken back at\n"
"                    any time, and the access team can too.\n"
"                </p>\n"
"                <p t-if=\"object.reason\">\n"
"                    <strong>Why:</strong> <t t-out=\"object.reason or ''\"/>\n"
"                </p>\n"
"                <p style=\"color:#4A5568;\">\n"
"                    If this is not something you expected, say so now — every\n"
"                    hand-over is written down and can be taken back in seconds.\n"
"                </p>\n"
"                <br/>\n"
"                The access team<br/>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin:0; padding:0; font-family:Inter,Helvetica,Arial,sans-serif; color:#1B1733;\">\n"
"                <p>Xin chào,</p>\n"
"                <p>\n"
"                    <strong><t t-out=\"object.delegator_user_id.name or ''\"/></strong>\n"
"                    đã bàn giao một phần quyền của mình cho\n"
"                    <strong><t t-out=\"object.delegate_user_id.name or ''\"/></strong>.\n"
"                    Cả hai bạn đều nhận được thư này.\n"
"                </p>\n"
"                <p><strong>Những gì đã được bàn giao</strong></p>\n"
"                <ul>\n"
"                    <t t-foreach=\"object.profile_ids\" t-as=\"prof\">\n"
"                        <li>\n"
"                            <strong><t t-out=\"prof.name or ''\"/></strong>\n"
"                            — <t t-out=\"prof.description or ''\"/>\n"
"                        </li>\n"
"                    </t>\n"
"                </ul>\n"
"                <p t-if=\"object.kind == 'temporary'\">\n"
"                    Có hiệu lực từ <strong><t t-out=\"object.date_start or ''\"/></strong>\n"
"                    đến <strong><t t-out=\"object.date_end or ''\"/></strong>.\n"
"                    Sáng hôm sau ngày đó, quyền sẽ được tự động thu hồi —\n"
"                    không ai phải nhớ việc này.\n"
"                </p>\n"
"                <p t-if=\"object.kind != 'temporary'\">\n"
"                    Việc bàn giao này không có ngày kết thúc. Bất kỳ ai trong hai bạn\n"
"                    cũng có thể yêu cầu thu hồi bất cứ lúc nào, và đội quản lý quyền truy cập cũng vậy.\n"
"                </p>\n"
"                <p t-if=\"object.reason\">\n"
"                    <strong>Lý do:</strong> <t t-out=\"object.reason or ''\"/>\n"
"                </p>\n"
"                <p style=\"color:#4A5568;\">\n"
"                    Nếu đây không phải điều bạn mong đợi, hãy báo ngay — mọi lần\n"
"                    bàn giao quyền đều được ghi lại và có thể thu hồi trong vài giây.\n"
"                </p>\n"
"                <br/>\n"
"                Đội quản lý quyền truy cập<br/>\n"
"            </div>\n"
"        "

#. module: biz_access
#: model:mail.template,body_html:biz_access.mail_template_delegation_ended
msgid ""
"<div style=\"margin:0; padding:0; font-family:Inter,Helvetica,Arial,sans-serif; color:#1B1733;\">\n"
"                <p>Hello,</p>\n"
"                <p>\n"
"                    The access\n"
"                    <strong><t t-out=\"object.delegator_user_id.name or ''\"/></strong>\n"
"                    lent to\n"
"                    <strong><t t-out=\"object.delegate_user_id.name or ''\"/></strong>\n"
"                    has been taken back. Both of you are getting this message.\n"
"                </p>\n"
"                <p><strong>What has gone</strong></p>\n"
"                <ul>\n"
"                    <t t-foreach=\"object.profile_ids\" t-as=\"prof\">\n"
"                        <li><t t-out=\"prof.name or ''\"/></li>\n"
"                    </t>\n"
"                </ul>\n"
"                <p><t t-out=\"object.ended_note or ''\"/></p>\n"
"                <p style=\"color:#4A5568;\">\n"
"                    Anything either of you did while it was running stays\n"
"                    exactly as it was. This only changes what can be done from\n"
"                    now on.\n"
"                </p>\n"
"                <br/>\n"
"                The access team<br/>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin:0; padding:0; font-family:Inter,Helvetica,Arial,sans-serif; color:#1B1733;\">\n"
"                <p>Xin chào,</p>\n"
"                <p>\n"
"                    Quyền mà\n"
"                    <strong><t t-out=\"object.delegator_user_id.name or ''\"/></strong>\n"
"                    đã cho\n"
"                    <strong><t t-out=\"object.delegate_user_id.name or ''\"/></strong>\n"
"                    mượn đã được thu hồi. Cả hai bạn đều nhận được thư này.\n"
"                </p>\n"
"                <p><strong>Những gì đã được thu hồi</strong></p>\n"
"                <ul>\n"
"                    <t t-foreach=\"object.profile_ids\" t-as=\"prof\">\n"
"                        <li><t t-out=\"prof.name or ''\"/></li>\n"
"                    </t>\n"
"                </ul>\n"
"                <p><t t-out=\"object.ended_note or ''\"/></p>\n"
"                <p style=\"color:#4A5568;\">\n"
"                    Mọi việc hai bạn đã làm trong thời gian bàn giao vẫn được giữ\n"
"                    nguyên. Việc này chỉ thay đổi những gì có thể làm từ\n"
"                    bây giờ trở đi.\n"
"                </p>\n"
"                <br/>\n"
"                Đội quản lý quyền truy cập<br/>\n"
"            </div>\n"
"        "

#. module: biz_access
#. odoo-python
