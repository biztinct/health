#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid " and %s more"
msgstr " và %s người khác"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid " until %s"
msgstr " đến %s"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "\"%(what)s\" is on the left menu for the people who hold \"%(role)s\"."
msgstr "\"%(what)s\" đã có trên menu bên trái cho những người giữ \"%(role)s\"."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"\"%(what)s\" is written down. %(who)s already able to do all of it, so they "
"hold it from the start."
msgstr ""
"\"%(what)s\" đã được ghi lại. %(who)s đã làm được tất cả những việc này, nên"
" họ giữ vai trò ngay từ đầu."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_role.py:0
msgid ""
"\"%(what)s\" would carry %(bad)s — the administrator permission for the "
"whole system. It is not something this board can hand out, and it cannot be "
"put on a role. An administrator changes it on the person's own record, "
"deliberately."
msgstr ""
"\"%(what)s\" sẽ mang theo %(bad)s — quyền quản trị toàn hệ thống. Bảng này "
"không thể trao quyền đó, và cũng không thể gắn nó vào một vai trò. Quản trị "
"viên chỉ thay đổi nó trên hồ sơ của chính người đó, một cách có chủ đích."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_ability.py:0
msgid ""
"\"%(what)s\" would carry %(bad)s — the administrator permission for the "
"whole system. That is never something a role can hand out. An administrator "
"changes it on the person's own record, deliberately."
msgstr ""
"\"%(what)s\" sẽ mang theo %(bad)s — quyền quản trị toàn hệ thống. Một vai "
"trò không bao giờ được trao quyền này. Quản trị viên chỉ thay đổi nó trên hồ"
" sơ của chính người đó, một cách có chủ đích."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"\"%(what)s\" would hand out exactly what \"%(twin)s\" already hands out, "
"down to the last permission. Two roles that mean the same thing cannot be "
"told apart afterwards, and neither can be taken away from somebody who holds"
" both. Give this one something \"%(twin)s\" does not have — or start from "
"\"%(twin)s\" and change it."
msgstr ""
"\"%(what)s\" sẽ trao đúng y những gì \"%(twin)s\" đang trao, không sót một "
"quyền nào. Hai vai trò giống hệt nhau thì về sau không phân biệt được, và "
"không thể gỡ khỏi người đang giữ cả hai. Hãy cho vai trò này thêm điều gì đó"
" mà \"%(twin)s\" không có — hoặc bắt đầu từ \"%(twin)s\" rồi chỉnh sửa."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"\"%s\" does not hand out anything yet, so putting it on this entry would "
"gate it on nothing."
msgstr ""
"\"%s\" chưa trao quyền gì, nên gắn nó vào mục này sẽ không giới hạn được gì."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "\"%s\" does not point at a permission, so there is nothing to hand out."
msgstr "\"%s\" không gắn với quyền nào, nên không có gì để trao."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"\"%s\" has been put away. It is off the board, and everything it was ever "
"part of is still in the history."
msgstr ""
"\"%s\" đã được cất đi. Vai trò không còn trên bảng, và mọi lần nó từng xuất "
"hiện vẫn còn trong lịch sử."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "\"%s\" is already on the left menu."
msgstr "\"%s\" đã có trên menu bên trái."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "\"%s\" is back on the left menu."
msgstr "\"%s\" đã trở lại menu bên trái."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"\"%s\" is not in that part of the menu. Entries are reordered inside their "
"own block."
msgstr ""
"\"%s\" không nằm trong phần menu đó. Các mục chỉ được sắp xếp lại bên trong "
"khối của chính chúng."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"\"%s\" is off the left menu. Nobody sees it, and nothing behind it has "
"changed — switch it back on whenever you want."
msgstr ""
"\"%s\" đã được ẩn khỏi menu bên trái. Không ai thấy nó, và mọi thứ phía sau "
"vẫn giữ nguyên — bật lại bất cứ lúc nào bạn muốn."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"\"%s\" is part of a hand-over that is still running. End the hand-over first"
" — the Hand-overs tab has it."
msgstr ""
"\"%s\" là một phần của lần bàn giao vẫn đang hiệu lực. Hãy kết thúc lần bàn "
"giao đó trước — xem ở thẻ Bàn giao."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_role.py:0
msgid ""
"\"%s\" is the administrator permission for the whole system. It is not "
"something this board can hand out, and it cannot be put on a profile. An "
"administrator changes it on the user record itself, deliberately."
msgstr ""
"\"%s\" là quyền quản trị toàn hệ thống. Bảng này không thể trao quyền đó, và"
" cũng không thể gắn nó vào một hồ sơ quyền. Quản trị viên chỉ thay đổi nó "
"trực tiếp trên tài khoản người dùng, một cách có chủ đích."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"\"%s\" is written down. Nobody holds it yet — give it to somebody when you "
"are ready."
msgstr ""
"\"%s\" đã được ghi lại. Chưa ai giữ vai trò này — hãy giao cho ai đó khi bạn"
" sẵn sàng."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"\"%s\" was switched off on purpose, not because nobody could open it. Switch"
" it back on from its own row if that is what you want."
msgstr ""
"\"%s\" đã được tắt có chủ đích, không phải vì không ai mở được. Nếu bạn "
"muốn, hãy bật lại từ chính dòng của nó."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"\"%s\" would carry the administrator permission for the whole system. It is "
"never given out from this screen — an administrator changes it on the "
"person's own record, deliberately."
msgstr ""
"\"%s\" sẽ mang theo quyền quản trị toàn hệ thống. Quyền này không bao giờ "
"được trao từ màn hình này — quản trị viên chỉ thay đổi nó trên hồ sơ của "
"chính người đó, một cách có chủ đích."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_delegation.py:0
msgid ""
"\"%s\" would carry the administrator permission for the whole system. It is "
"never handed over from this screen."
msgstr ""
"\"%s\" sẽ mang theo quyền quản trị toàn hệ thống. Quyền này không bao giờ "
"được bàn giao từ màn hình này."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"\"%s\" would carry the administrator permission for the whole system. It is "
"never something a role can hand out, and never something a screen can ask "
"for."
msgstr ""
"\"%s\" sẽ mang theo quyền quản trị toàn hệ thống. Một vai trò không bao giờ "
"được trao quyền này, và một màn hình cũng không bao giờ được yêu cầu quyền "
"này."

#. module: biz_access
#: model:ir.model.fields,help:biz_access.field_biz_access_delegation__reason
msgid ""
"\"Two weeks in Da Nang\", \"covering the December pay run\". It is what the "
"audit trail will show."
msgstr ""
"\"Hai tuần ở Đà Nẵng\", \"làm thay kỳ lương tháng 12\". Đây là nội dung nhật"
" ký kiểm tra sẽ hiển thị."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_delegation.py:0
msgid "%(body)s %(n)s already been removed by somebody else."
msgstr "%(body)s %(n)s đã bị người khác gỡ trước đó."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_delegation.py:0
msgid "%(ended)s ended and %(removed)s taken back."
msgstr "Đã kết thúc %(ended)s và thu hồi %(removed)s."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/access_board.js:0
msgid "%(from)s to %(to)s"
msgstr "%(from)s đến %(to)s"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_delegation.py:0
msgid "%(from)s to %(to)s, %(date)s"
msgstr "%(from)s cho %(to)s, %(date)s"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"%(g)s on the left menu %(v)s limited to a role; %(e)s open to everybody with"
" a login."
msgstr ""
"%(g)s trên menu bên trái %(v)s giới hạn theo vai trò; %(e)s mở cho mọi người"
" có tài khoản đăng nhập."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%(line)s %(b)s taken back early."
msgstr "%(line)s %(b)s đã được thu hồi sớm."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_delegation.py:0
msgid "%(line)s %(n)s already been removed by somebody else."
msgstr "%(line)s %(n)s đã bị người khác gỡ trước đó."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_delegation.py:0
msgid ""
"%(line)s %(n)s could not be ended and %(still)s — an administrator should "
"look at %(them)s."
msgstr ""
"%(line)s %(n)s không thể kết thúc và %(still)s — quản trị viên nên kiểm tra "
"%(them)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%(message)s %(already)s already theirs."
msgstr "%(message)s %(already)s đã là của họ từ trước."

#. module: biz_access
#. odoo-javascript
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
#: code:addons/biz_access/static/src/js/access_board.js:0
msgid "%(most)s and %(last)s"
msgstr "%(most)s và %(last)s"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%(n)s can now open %(what)s."
msgstr "%(n)s giờ có thể mở %(what)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%(n)s can now open everything in the %(what)s block."
msgstr "%(n)s giờ có thể mở mọi thứ trong khối %(what)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%(n)s no longer opens %(what)s."
msgstr "%(n)s không còn mở %(what)s nữa."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%(n)s no longer opens the %(what)s block."
msgstr "%(n)s không còn mở được khối %(what)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_delegation.py:0
msgid "%(n)s taken back."
msgstr "Đã thu hồi %(n)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"%(p)s in plain English — who holds them, and what each one opens. %(m)s."
msgstr ""
"%(p)s bằng lời dễ hiểu — ai đang giữ, và mỗi vai trò mở ra những gì. %(m)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%(r)s running, %(e)s ended."
msgstr "%(r)s đang hiệu lực, %(e)s đã kết thúc."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"%(said)s \"%(role)s\" was also let into \"%(parent)s\" so the entry can be "
"reached."
msgstr ""
"%(said)s \"%(role)s\" cũng được cho vào \"%(parent)s\" để có thể đến được "
"mục này."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%(said)s Inside it: %(kids)s."
msgstr "%(said)s Bên trong: %(kids)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"%(said)s One entry on the left menu was opened only by it — %(where)s — so "
"nobody can reach that entry now. The Screens lens shows it with a warning."
msgstr ""
"%(said)s Một mục trên menu bên trái chỉ được mở bởi vai trò này — %(where)s "
"— nên giờ không ai vào được mục đó. Thẻ Màn hình sẽ hiện nó kèm cảnh báo."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%(who)s already has \"%(what)s\"."
msgstr "%(who)s đã có \"%(what)s\"."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%(who)s can now do it on %(whose)s's behalf%(until)s."
msgstr "%(who)s giờ có thể làm việc đó thay %(whose)s%(until)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%(who)s can now do it on your behalf%(until)s."
msgstr "%(who)s giờ có thể làm việc đó thay bạn%(until)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_delegation.py:0
msgid "%(who)s can now do this on %(whose)s behalf: %(what)s."
msgstr "%(who)s giờ có thể thay %(whose)s làm việc này: %(what)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%(who)s does not have \"%(what)s\"."
msgstr "%(who)s không có \"%(what)s\"."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_delegation.py:0
msgid ""
"%(who)s does not have %(what)s, so it cannot be handed to anybody else. You "
"can only lend what somebody holds themselves."
msgstr ""
"%(who)s không có %(what)s, nên không thể trao nó cho người khác. Chỉ có thể "
"bàn giao những gì người đó đang có."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"%(who)s has \"%(what)s\" because of another role they hold, not directly. "
"Take that other role away instead — removing this one here would change "
"nothing."
msgstr ""
"%(who)s có \"%(what)s\" nhờ một vai trò khác họ đang giữ, không phải trực "
"tiếp. Hãy gỡ vai trò kia — gỡ vai trò này ở đây sẽ không thay đổi gì."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%(who)s no longer has \"%(what)s\"."
msgstr "%(who)s không còn \"%(what)s\" nữa."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%(who)s now has \"%(what)s\"."
msgstr "%(who)s giờ đã có \"%(what)s\"."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"%(who)s still %(has)s \"%(what)s\"%(more)s. Take it away from them first — "
"archiving it would leave them holding access this board can no longer name."
msgstr ""
"%(who)s vẫn %(has)s \"%(what)s\"%(more)s. Hãy gỡ vai trò khỏi họ trước — nếu"
" cất đi lúc này, họ sẽ giữ một quyền mà bảng này không còn gọi tên được."

#. module: biz_access
#. odoo-javascript
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
#: code:addons/biz_access/static/src/js/access_board.js:0
msgid "%s abilities"
msgstr "%s quyền thao tác"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%s already has all of those roles."
msgstr "%s đã có tất cả các vai trò đó."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%s are"
msgstr "%s mục"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/access_board.js:0
msgid "%s days left."
msgstr "Còn %s ngày."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/access_board.js:0
msgid ""
"%s does not hold any of the roles on this board, so there is nothing of "
"theirs to hand over."
msgstr ""
"%s không giữ vai trò nào trên bảng này, nên không có gì của họ để bàn giao."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_delegation.py:0
msgid "%s ended, and nothing needed taking back."
msgstr "Đã kết thúc %s, không có gì cần thu hồi."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid "%s entries"
msgstr "%s mục"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/access_board.js:0
msgid "%s entries switched off"
msgstr "%s mục đã tắt"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_delegation.py:0
msgid "%s had"
msgstr "%s quyền"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_delegation.py:0
msgid "%s hand-overs"
msgstr "%s lần bàn giao"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/access_board.js:0
msgid "%s has %s permanent roles that can be added."
msgstr "%s có %s vai trò lâu dài có thể thêm."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/access_board.js:0
msgid "%s has 1 permanent role that can be added."
msgstr "%s có 1 vai trò lâu dài có thể thêm."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_facade.py:0
msgid ""
"%s has an employee login only. Roles are for people who work inside this "
"application."
msgstr ""
"%s chỉ có tài khoản nhân viên. Vai trò dành cho những người làm việc bên "
"trong ứng dụng này."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/access_board.js:0
msgid "%s has no new permanent roles to add."
msgstr "%s không có vai trò lâu dài mới nào để thêm."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/access_board.js:0
msgid "%s holds this"
msgstr "%s giữ vai trò này"

