<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">

    <!-- Every minute: try the forwards that did not land. Ours to retry, not
         Meta's — a non-2xx to Meta redelivers the whole batch for every
         customer in it and, sustained, switches the application's Messenger
         webhook off for all of them. -->
    <record id="ir_cron_channel_relay_retry" model="ir.cron" forcecreate="True">
        <field name="name">Channel relay: retry deliveries</field>
        <field name="model_id" ref="model_channel_relay_delivery"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry()</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=2)).strftime('%Y-%m-%d %H:%M:00')"/>
    </record>

    <!-- Every ten minutes: read the customer list, re-read who owns which Page
         and number, and give every serving customer the platform's Meta
         application. A customer created five minutes ago is relaying inside
         ten without anybody pressing anything. -->
    <record id="ir_cron_channel_relay_reconcile" model="ir.cron" forcecreate="True">
        <field name="name">Channel relay: reconcile customers</field>
        <field name="model_id" ref="model_channel_relay_tenant"/>
        <field name="state">code</field>
        <field name="code">model._cron_reconcile()</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:00')"/>
    </record>

    <!-- Daily 03:40: the queue is a queue, not an archive. Anything delivered
         or given up on more than a week ago goes, and the encrypted message
         goes with the row. -->
    <record id="ir_cron_channel_relay_purge" model="ir.cron" forcecreate="True">
        <field name="name">Channel relay: clear finished deliveries</field>
        <field name="model_id" ref="model_channel_relay_delivery"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:40:00')"/>
    </record>

</data></odoo>
