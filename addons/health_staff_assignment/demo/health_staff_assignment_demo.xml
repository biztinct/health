<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- =====================================================================
         Demo Data for VAFHS Staff Assignment System
         Healthcare-Specific Demo Data for Testing and Training
         ===================================================================== -->

    <!-- Demo Healthcare Staff -->
    <record id="demo_doctor_smith" model="hr.employee">
        <field name="name">Dr. Sarah Smith</field>
        <field name="job_id" ref="hr.job_developer"/>
        <field name="work_email">dr.smith@vafhs.com</field>
        <field name="work_phone">+84 901 234 567</field>
        <field name="is_healthcare_staff" eval="True"/>
        <field name="color">3</field>
    </record>

    <record id="demo_nurse_johnson" model="hr.employee">
        <field name="name">Nurse Emily Johnson</field>
        <field name="job_id" ref="hr.job_developer"/>
        <field name="work_email">nurse.johnson@vafhs.com</field>
        <field name="work_phone">+84 901 234 568</field>
        <field name="is_healthcare_staff" eval="True"/>
        <field name="color">5</field>
    </record>

    <record id="demo_doctor_brown" model="hr.employee">
        <field name="name">Dr. Michael Brown</field>
        <field name="job_id" ref="hr.job_developer"/>
        <field name="work_email">dr.brown@vafhs.com</field>
        <field name="work_phone">+84 901 234 569</field>
        <field name="is_healthcare_staff" eval="True"/>
        <field name="color">1</field>
    </record>

    <!-- Demo Healthcare Skills -->
    <record id="demo_skill_cardiology" model="health.staff.skill">
        <field name="name">Cardiology</field>
        <field name="description">Cardiac care and heart disease treatment</field>
        <field name="skill_category">medical</field>
        <field name="required_certification">true</field>
    </record>

    <record id="demo_skill_nursing" model="health.staff.skill">
        <field name="name">General Nursing</field>
        <field name="description">General nursing care and patient support</field>
        <field name="skill_category">nursing</field>
        <field name="required_certification">true</field>
    </record>

    <record id="demo_skill_pediatrics" model="health.staff.skill">
        <field name="name">Pediatrics</field>
        <field name="description">Children's healthcare and medical care</field>
        <field name="skill_category">medical</field>
        <field name="required_certification">true</field>
    </record>

    <!-- Demo Service Areas -->
    <record id="demo_area_hanoi_center" model="health.service.area">
        <field name="name">Hanoi City Center</field>
        <field name="description">Central Hanoi urban area</field>
        <field name="area_code">HN-CENTER</field>
        <field name="is_active">true</field>
        <field name="travel_time_minutes">15</field>
    </record>

    <record id="demo_area_ho_chi_minh" model="health.service.area">
        <field name="name">Ho Chi Minh City</field>
        <field name="description">Ho Chi Minh City metropolitan area</field>
        <field name="area_code">HCM-METRO</field>
        <field name="is_active">true</field>
        <field name="travel_time_minutes">25</field>
    </record>

    <!-- Demo Patients for Appointments -->
    <record id="demo_patient_nguyen" model="res.partner">
        <field name="name">Nguyễn Văn Minh</field>
        <field name="email">nguyen.minh@example.com</field>
        <field name="phone">+84 901 111 222</field>
        <field name="is_company">false</field>
        <field name="customer_rank">1</field>
        <field name="street">123 Trần Hưng Đạo</field>
        <field name="city">Hanoi</field>
        <field name="country_id" ref="base.vn"/>
    </record>

    <record id="demo_patient_tran" model="res.partner">
        <field name="name">Trần Thị Lan</field>
        <field name="email">tran.lan@example.com</field>
        <field name="phone">+84 901 333 444</field>
        <field name="is_company">false</field>
        <field name="customer_rank">1</field>
        <field name="street">456 Lê Lợi</field>
        <field name="city">Ho Chi Minh City</field>
        <field name="country_id" ref="base.vn"/>
    </record>

    <!-- Demo Appointment Types -->
    <record id="demo_appointment_type_consultation" model="health.appointment.type">
        <field name="name">General Consultation</field>
        <field name="duration_minutes">60</field>
        <field name="color">2</field>
        <field name="is_home_visit">false</field>
    </record>

    <record id="demo_appointment_type_home_visit" model="health.appointment.type">
        <field name="name">Home Health Visit</field>
        <field name="duration_minutes">90</field>
        <field name="color">5</field>
        <field name="is_home_visit">true</field>
    </record>

    <!-- Demo Appointments -->
    <record id="demo_appointment_1" model="health.appointment">
        <field name="name">General Consultation - Nguyễn Văn Minh</field>
        <field name="patient_id" ref="demo_patient_nguyen"/>
        <field name="appointment_type_id" ref="demo_appointment_type_consultation"/>
        <field name="appointment_date" eval="(DateTime.now() + timedelta(days=1)).replace(hour=9, minute=0)"/>
        <field name="state">confirmed</field>
        <field name="priority">1</field>
        <field name="notes">Routine checkup appointment</field>
    </record>

    <record id="demo_appointment_2" model="health.appointment">
        <field name="name">Home Visit - Trần Thị Lan</field>
        <field name="patient_id" ref="demo_patient_tran"/>
        <field name="appointment_type_id" ref="demo_appointment_type_home_visit"/>
        <field name="appointment_date" eval="(DateTime.now() + timedelta(days=1)).replace(hour=14, minute=0)"/>
        <field name="state">confirmed</field>
        <field name="priority">2</field>
        <field name="notes">Post-surgery follow-up at home</field>
    </record>

    <record id="demo_appointment_3" model="health.appointment">
        <field name="name">Urgent Consultation - Emergency</field>
        <field name="patient_id" ref="demo_patient_nguyen"/>
        <field name="appointment_type_id" ref="demo_appointment_type_consultation"/>
        <field name="appointment_date" eval="(DateTime.now() + timedelta(hours=2))"/>
        <field name="state">draft</field>
        <field name="priority">4</field>
        <field name="notes">Urgent medical consultation needed</field>
    </record>

    <!-- Demo Staff Assignments -->
    <record id="demo_assignment_1" model="health.staff.assignment">
        <field name="name">ASG-001</field>
        <field name="appointment_id" ref="demo_appointment_1"/>
        <field name="assigned_staff_ids" eval="[(6, 0, [ref('demo_doctor_smith')])]"/>
        <field name="lead_staff_id" ref="demo_doctor_smith"/>
        <field name="assignment_date" eval="(DateTime.now() + timedelta(days=1)).replace(hour=9, minute=0)"/>
        <field name="state">assigned</field>
        <field name="priority">1</field>
        <field name="assignment_type">clinic_visit</field>
    </record>

    <record id="demo_assignment_2" model="health.staff.assignment">
        <field name="name">ASG-002</field>
        <field name="appointment_id" ref="demo_appointment_2"/>
        <field name="assigned_staff_ids" eval="[(6, 0, [ref('demo_nurse_johnson'), ref('demo_doctor_brown')])]"/>
        <field name="lead_staff_id" ref="demo_nurse_johnson"/>
        <field name="assignment_date" eval="(DateTime.now() + timedelta(days=1)).replace(hour=14, minute=0)"/>
        <field name="state">confirmed</field>
        <field name="priority">2</field>
        <field name="assignment_type">home_visit</field>
    </record>

    <!-- Demo Staff Availability -->
    <record id="demo_availability_doctor_smith" model="health.staff.availability">
        <field name="staff_id" ref="demo_doctor_smith"/>
        <field name="date" eval="(DateTime.now() + timedelta(days=1)).date()"/>
        <field name="start_time">8.0</field>
        <field name="end_time">17.0</field>
        <field name="is_available">true</field>
        <field name="availability_type">regular</field>
    </record>

    <record id="demo_availability_nurse_johnson" model="health.staff.availability">
        <field name="staff_id" ref="demo_nurse_johnson"/>
        <field name="date" eval="(DateTime.now() + timedelta(days=1)).date()"/>
        <field name="start_time">9.0</field>
        <field name="end_time">18.0</field>
        <field name="is_available">true</field>
        <field name="availability_type">regular</field>
    </record>

</data>
</odoo>