<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- AI Assignment Engine List View -->
    <record id="view_health_ai_assignment_engine_list" model="ir.ui.view">
        <field name="name">health.ai.assignment.engine.list</field>
        <field name="model">health.ai.assignment.engine</field>
        <field name="arch" type="xml">
            <list string="AI Assignment Analysis" default_order="analysis_date desc">
                <field name="analysis_name"/>
                <field name="analysis_date"/>
                <field name="analysis_period_start"/>
                <field name="analysis_period_end"/>
                <field name="model_trained" widget="boolean_toggle"/>
                <field name="model_accuracy"/>
                <field name="assignment_success_rate"/>
                <field name="assignment_efficiency"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- AI Assignment Engine Form View -->
    <record id="view_health_ai_assignment_engine_form" model="ir.ui.view">
        <field name="name">health.ai.assignment.engine.form</field>
        <field name="model">health.ai.assignment.engine</field>
        <field name="arch" type="xml">
            <form string="AI Assignment Engine Analysis">
                <header>
                    <button name="train_assignment_model" type="object" string="🧠 Train AI Model" 
                            class="btn-primary" groups="health_staff_assignment.group_assignment_manager"
                            help="Train the machine learning model with historical assignment data"/>
                    <button name="generate_optimal_assignments" type="object" string="🎯 Generate Optimal Assignments" 
                            class="btn-secondary" groups="health_staff_assignment.group_head_nurse,health_staff_assignment.group_assignment_manager"
                            help="Generate AI-powered staff assignment suggestions for unassigned appointments"/>
                    <button name="optimize_daily_assignments" type="object" string="⚡ Optimize Daily Assignments" 
                            class="btn-secondary" groups="health_staff_assignment.group_head_nurse,health_staff_assignment.group_assignment_manager"
                            help="Run comprehensive daily assignment optimization across all assignments"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="analysis_name" placeholder="Analysis Name"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Analysis Period">
                            <field name="analysis_date"/>
                            <field name="analysis_period_start"/>
                            <field name="analysis_period_end"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        
                        <group string="AI Model Status">
                            <field name="model_trained" widget="boolean_toggle"/>
                            <field name="model_accuracy" widget="progressbar"/>
                            <field name="training_data_points"/>
                            <field name="last_training_date"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Performance Metrics" name="performance">
                            <group>
                                <group string="Assignment Intelligence">
                                    <field name="assignment_success_rate" widget="progressbar"/>
                                    <field name="assignment_efficiency" widget="progressbar"/>
                                    <field name="staff_satisfaction_score" widget="progressbar"/>
                                    <field name="patient_satisfaction_impact" widget="progressbar"/>
                                </group>
                                
                                <group string="Geographic Optimization">
                                    <field name="travel_optimization_score" widget="progressbar"/>
                                    <field name="route_efficiency" widget="progressbar"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Optimal Assignments" name="optimal_assignments">
                            <field name="optimal_assignments" widget="ace" options="{'mode': 'json'}" 
                                   placeholder="AI-generated optimal assignment suggestions will appear here after analysis"/>
                        </page>
                        
                        <page string="Skills Matrix" name="skills_matrix">
                            <field name="skills_matrix_optimization" widget="ace" options="{'mode': 'json'}" 
                                   placeholder="Skills matrix optimization analysis will appear here"/>
                        </page>
                        
                        <page string="Workload Analysis" name="workload_analysis">
                            <field name="workload_balance_analysis" widget="ace" options="{'mode': 'json'}" 
                                   placeholder="Workload balance analysis will appear here"/>
                        </page>
                    </notebook>
                </sheet>
                
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- AI Assignment Engine Kanban View -->
    <record id="view_health_ai_assignment_engine_kanban" model="ir.ui.view">
        <field name="name">health.ai.assignment.engine.kanban</field>
        <field name="model">health.ai.assignment.engine</field>
        <field name="arch" type="xml">
            <kanban string="AI Assignment Analytics" default_group_by="model_trained" class="o_kanban_small_column">
                <field name="analysis_name"/>
                <field name="analysis_date"/>
                <field name="model_trained"/>
                <field name="model_accuracy"/>
                <field name="assignment_success_rate"/>
                <field name="assignment_efficiency"/>
                <field name="training_data_points"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="analysis_name"/>
                                        </strong>
                                        <br/>
                                        <small class="o_kanban_record_subtitle text-muted">
                                            <field name="analysis_date"/>
                                        </small>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <span t-if="record.model_trained.raw_value" class="badge badge-success">
                                            AI Trained
                                        </span>
                                        <span t-else="" class="badge badge-warning">
                                            Pending Training
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="o_kanban_record_body">
                                    <div class="row">
                                        <div class="col-6">
                                            <span class="text-muted">🎯 Model Accuracy:</span><br/>
                                            <strong><field name="model_accuracy"/>%</strong>
                                        </div>
                                        <div class="col-6">
                                            <span class="text-muted">✅ Success Rate:</span><br/>
                                            <strong><field name="assignment_success_rate"/>%</strong>
                                        </div>
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-6">
                                            <span class="text-muted">⚡ Efficiency:</span><br/>
                                            <strong><field name="assignment_efficiency"/>%</strong>
                                        </div>
                                        <div class="col-6">
                                            <span class="text-muted">📊 Data Points:</span><br/>
                                            <strong><field name="training_data_points"/></strong>
                                        </div>
                                    </div>
                                    <div class="mt-2" t-if="record.model_trained.raw_value">
                                        <small class="text-success">
                                            <i class="fa fa-check-circle"/> Ready for AI optimization
                                        </small>
                                    </div>
                                    <div class="mt-2" t-else="">
                                        <small class="text-warning">
                                            <i class="fa fa-exclamation-circle"/> Needs training
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- AI Assignment Engine Search View -->
    <record id="view_health_ai_assignment_engine_search" model="ir.ui.view">
        <field name="name">health.ai.assignment.engine.search</field>
        <field name="model">health.ai.assignment.engine</field>
        <field name="arch" type="xml">
            <search string="Search AI Assignment Analysis">
                <field name="analysis_name" string="Analysis Name" 
                       filter_domain="[('analysis_name', 'ilike', self)]"/>
                <field name="analysis_date" string="Analysis Date"/>
                
                <filter string="AI Model Trained" name="model_trained" 
                        domain="[('model_trained', '=', True)]"/>
                <filter string="Pending Training" name="pending_training" 
                        domain="[('model_trained', '=', False)]"/>
                <filter string="High Accuracy" name="high_accuracy" 
                        domain="[('model_accuracy', '>=', 90)]"/>
                <filter string="This Month" name="this_month" 
                        domain="[('analysis_date', '>=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01')),
                                 ('analysis_date', '&lt;', (context_today() + relativedelta(months=1)).strftime('%Y-%m-01'))]"/>
                
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Model Status" name="group_model_trained" 
                            context="{'group_by': 'model_trained'}"/>
                    <filter string="Analysis Month" name="group_month" 
                            context="{'group_by': 'analysis_date:month'}"/>
                    <filter string="Company" name="group_company" 
                            context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- AI Assignment Engine Action -->
    <record id="action_health_ai_assignment_engine" model="ir.actions.act_window">
        <field name="name">AI Assignment Engine</field>
        <field name="res_model">health.ai.assignment.engine</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_health_ai_assignment_engine_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AI Assignment Analysis!
            </p>
            <p>
                The AI Assignment Engine uses machine learning to optimize staff assignments,
                improve efficiency, and balance workloads. Train the AI model with historical
                data to get intelligent assignment suggestions.
            </p>
        </field>
    </record>

</odoo>