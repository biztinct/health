<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Professional Staff Assignment Timeline View using web_timeline -->
    <record id="health_staff_assignment_timeline_view" model="ir.ui.view">
        <field name="name">Staff Assignment Timeline</field>
        <field name="model">health.staff.assignment</field>
        <field name="type">timeline</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <timeline date_start="assignment_date"
                      string="display_name"
                      default_group_by="lead_staff_id"
                      event_open_popup="true"
                      colors="#e74c3c:state=='cancelled';#f39c12:state=='draft';#3498db:state=='assigned';#2980b9:state=='confirmed';#e67e22:state=='in_progress';#27ae60:state=='completed'"
                      quick_create="false">
                
                <!-- Timeline Fields -->
                <field name="name"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="assigned_staff_ids"/>
                <field name="lead_staff_id"/>
                <field name="appointment_id"/>
                <field name="assignment_type"/>
                <field name="assignment_date"/>
                <field name="display_name"/>
                
                <templates>
                    <t t-name="timeline-item">
                        <div class="o_healthcare_assignment_item">
                            <!-- Priority & Type Icons Row -->
                            <div class="assignment_header">
                                <span class="priority_icon">
                                    <i t-if="record.priority == '4'" class="fa fa-exclamation-circle text-danger" title="Emergency"/>
                                    <i t-elif="record.priority == '3'" class="fa fa-exclamation-triangle text-warning" title="Urgent"/>
                                    <i t-elif="record.priority == '2'" class="fa fa-circle text-warning" title="High"/>
                                    <i t-else="" class="fa fa-circle-o text-muted" title="Normal"/>
                                </span>
                                <span class="type_icon ml-auto">
                                    <i t-if="record.assignment_type == 'emergency'" class="fa fa-ambulance text-danger" title="Emergency"/>
                                    <i t-elif="record.assignment_type == 'home_visit'" class="fa fa-home text-success" title="Home Visit"/>
                                    <i t-elif="record.assignment_type == 'clinic_visit'" class="fa fa-hospital-o text-primary" title="Clinic"/>
                                    <i t-elif="record.assignment_type == 'follow_up'" class="fa fa-stethoscope text-info" title="Follow-up"/>
                                    <i t-else="" class="fa fa-user-md text-secondary" title="Consultation"/>
                                </span>
                            </div>
                            
                            <!-- Staff Avatars Row -->
                            <div class="staff_avatars">
                                <img t-if="record.lead_staff_id"
                                     t-attf-src="/web/image/hr.employee/#{record.lead_staff_id[0]}/image_128/20x20"
                                     t-att-title="record.lead_staff_id[1]"
                                     width="20" height="20"
                                     class="rounded-circle mr-1"
                                     alt="Lead Staff"/>
                                <t t-if="record.assigned_staff_ids and record.assigned_staff_ids.length > 1">
                                    <span class="team_badge">
                                        <i class="fa fa-users"></i>
                                        <small t-esc="record.assigned_staff_ids.length"/>
                                    </span>
                                </t>
                            </div>
                            
                            <!-- Assignment Title -->
                            <div class="assignment_name">
                                <t t-esc="record.display_name"/>
                            </div>
                            
                            <!-- Status & Appointment Info -->
                            <div class="assignment_footer">
                                <small class="state_text text-muted">
                                    <i t-if="record.state == 'draft'" class="fa fa-clock-o"/>
                                    <i t-elif="record.state == 'assigned'" class="fa fa-user-plus"/>
                                    <i t-elif="record.state == 'confirmed'" class="fa fa-check-circle-o"/>
                                    <i t-elif="record.state == 'in_progress'" class="fa fa-play-circle"/>
                                    <i t-elif="record.state == 'completed'" class="fa fa-check-circle"/>
                                    <i t-elif="record.state == 'cancelled'" class="fa fa-times-circle"/>
                                    <t t-esc="record.state"/>
                                </small>
                                <small t-if="record.appointment_id" class="appointment_ref text-info ml-2">
                                    <i class="fa fa-calendar-check-o"/>
                                </small>
                            </div>
                        </div>
                    </t>
                </templates>
                
            </timeline>
        </field>
    </record>

    <!-- Professional Staff Assignment List View -->
    <record id="health_staff_assignment_list_view" model="ir.ui.view">
        <field name="name">Staff Assignment List</field>
        <field name="model">health.staff.assignment</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <list string="Staff Assignments" default_order="assignment_date desc">
                <field name="name"/>
                <field name="assignment_date"/>
                <field name="lead_staff_id"/>
                <field name="assigned_staff_ids" widget="many2many_tags"/>
                <field name="state" decoration-success="state=='completed'" decoration-warning="state=='assigned'" decoration-danger="state=='cancelled'"/>
                <field name="priority"/>
                <field name="appointment_id"/>
                <field name="assignment_type"/>
            </list>
        </field>
    </record>

    <!-- Professional Staff Assignment Form View -->
    <record id="health_staff_assignment_form_view" model="ir.ui.view">
        <field name="name">Staff Assignment Form</field>
        <field name="model">health.staff.assignment</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="Staff Assignment">
                <header>
                    <button name="action_assign_staff" type="object" string="Assign Staff" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_confirm_assignment" type="object" string="Confirm" class="oe_highlight" invisible="state != 'assigned'"/>
                    <button name="action_start_assignment" type="object" string="Start" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_complete_assignment" type="object" string="Complete" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel_assignment" type="object" string="Cancel" invisible="state in ['completed', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,confirmed,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="assignment_info">
                            <field name="appointment_id" options="{'no_create': True}"/>
                            <field name="assignment_date"/>
                            <field name="assignment_type"/>
                            <field name="priority"/>
                        </group>
                        <group name="staff_info">
                            <field name="lead_staff_id" options="{'no_create': True}"/>
                            <field name="assigned_staff_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="assigned_by" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="assignment_details" string="Assignment Details">
                            <group>
                                <field name="assignment_score" readonly="1"/>
                                <field name="skill_match_score" readonly="1"/>
                                <field name="proximity_score" readonly="1"/>
                                <field name="workload_score" readonly="1"/>
                                <field name="availability_score" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

</odoo>