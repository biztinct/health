<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- =====================================================================
         Staff Assignment Dashboard - Mobile-First Kanban Interface
         Inspired by: Monday.com, Asana, Uber Driver Dashboard
         ===================================================================== -->

    <!-- Mobile-First Kanban Board View -->
    <record id="view_assignment_dashboard_kanban" model="ir.ui.view">
        <field name="name">health.staff.assignment.dashboard.kanban</field>
        <field name="model">health.staff.assignment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_dashboard o_assignment_dashboard o_advanced_scheduler" 
                    quick_create="false" create="true" edit="true" delete="true" 
                    js_class="assignment_dashboard_kanban">
                
                <!-- Enhanced Progressbar with Assignment Intelligence -->
                <progressbar field="assignment_score" colors='{"0": "danger", "50": "warning", "80": "success"}' sum_field="assignment_score"/>
                
                <!-- Advanced Fields for Drag-and-Drop and AI Features -->
                <field name="name"/>
                <field name="appointment_id"/>
                <field name="assigned_staff_ids"/>
                <field name="assignment_date"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="assignment_score"/>
                <field name="skill_match_score"/>
                <field name="proximity_score"/>
                <field name="workload_score"/>
                <field name="estimated_travel_time"/>
                <field name="lead_staff_id"/>
                <field name="current_location"/>
                <field name="real_time_status"/>
                
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card o_assignment_card o_draggable_assignment" 
                             t-att-data-assignment-id="record.id.raw_value"
                             t-att-data-priority="record.priority.raw_value"
                             t-att-data-score="record.assignment_score.raw_value"
                             t-att-data-state="record.state.raw_value">
                            
                            <!-- Smart Card Header with Priority and AI Score -->
                            <div class="o_assignment_card_header">
                                <div class="o_assignment_priority_indicator">
                                    <t t-if="record.priority.raw_value == '4'">
                                        <span class="fa fa-exclamation-triangle text-danger pulse-animation" title="Emergency Assignment"/>
                                    </t>
                                    <t t-elif="record.priority.raw_value == '3'">
                                        <span class="fa fa-exclamation-circle text-warning" title="Urgent Assignment"/>
                                    </t>
                                    <t t-elif="record.priority.raw_value == '2'">
                                        <span class="fa fa-arrow-up text-info" title="High Priority"/>
                                    </t>
                                    <t t-else="">
                                        <span class="fa fa-circle text-muted" title="Normal Priority"/>
                                    </t>
                                </div>
                                
                                <!-- AI Assignment Score Badge -->
                                <div class="o_assignment_ai_score">
                                    <span class="badge badge-pill" 
                                          t-att-class="record.assignment_score.raw_value >= 90 ? 'badge-success' : record.assignment_score.raw_value >= 70 ? 'badge-warning' : record.assignment_score.raw_value > 0 ? 'badge-secondary' : 'badge-light'"
                                          title="AI Assignment Match Score">
                                        <i class="fa fa-magic mr-1"/>
                                        <t t-esc="Math.round(record.assignment_score.raw_value)"/>%
                                    </span>
                                </div>
                                
                                <!-- Drag Handle -->
                                <div class="o_assignment_drag_handle">
                                    <i class="fa fa-bars text-muted"/>
                                </div>
                            </div>

                            <!-- Patient & Appointment Information -->
                            <div class="o_assignment_patient_section">
                                <div class="o_patient_info">
                                    <div class="o_patient_avatar">
                                        <i class="fa fa-user-circle fa-2x text-primary"/>
                                    </div>
                                    <div class="o_patient_details">
                                        <div class="o_patient_name font-weight-bold">
                                            <field name="appointment_id"/>
                                        </div>
                                        <div class="o_assignment_name text-muted small">
                                            <field name="name"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Date, Time & Location -->
                            <div class="o_assignment_schedule_info">
                                <div class="o_schedule_datetime">
                                    <i class="fa fa-calendar text-primary mr-2"/>
                                    <strong><field name="assignment_date" widget="datetime"/></strong>
                                </div>
                                
                                <!-- Travel Time Indicator for Home Visits -->
                                <div class="o_travel_info" t-if="record.estimated_travel_time.raw_value > 0">
                                    <i class="fa fa-car text-warning mr-1"/>
                                    <span class="small text-muted">
                                        <t t-esc="Math.round(record.estimated_travel_time.raw_value * 60)"/> min travel
                                    </span>
                                </div>
                            </div>

                            <!-- Assigned Staff Section -->
                            <div class="o_assigned_staff_section" t-if="record.assigned_staff_ids.raw_value.length > 0">
                                <div class="o_staff_avatars_container">
                                    <i class="fa fa-user-md text-success mr-2"/>
                                    <field name="assigned_staff_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}"/>
                                </div>
                                <div class="o_lead_staff" t-if="record.lead_staff_id.raw_value">
                                    <small class="text-muted">Lead: <field name="lead_staff_id"/></small>
                                </div>
                            </div>

                            <!-- Assignment Intelligence Metrics -->
                            <div class="o_assignment_metrics" t-if="record.assignment_score.raw_value > 0">
                                <div class="o_metrics_grid">
                                    <!-- Skills Match -->
                                    <div class="o_metric_item">
                                        <div class="o_metric_icon">
                                            <i class="fa fa-graduation-cap"/>
                                        </div>
                                        <div class="o_metric_bar">
                                            <div class="o_metric_fill" 
                                                 t-att-style="'width: ' + record.skill_match_score.raw_value + '%;'"
                                                 t-att-class="record.skill_match_score.raw_value >= 80 ? 'bg-success' : record.skill_match_score.raw_value >= 60 ? 'bg-warning' : 'bg-danger'">
                                            </div>
                                        </div>
                                        <span class="o_metric_value"><t t-esc="Math.round(record.skill_match_score.raw_value)"/>%</span>
                                    </div>
                                    
                                    <!-- Location Proximity -->
                                    <div class="o_metric_item">
                                        <div class="o_metric_icon">
                                            <i class="fa fa-map-marker"/>
                                        </div>
                                        <div class="o_metric_bar">
                                            <div class="o_metric_fill" 
                                                 t-att-style="'width: ' + record.proximity_score.raw_value + '%;'"
                                                 t-att-class="record.proximity_score.raw_value >= 80 ? 'bg-success' : record.proximity_score.raw_value >= 60 ? 'bg-warning' : 'bg-danger'">
                                            </div>
                                        </div>
                                        <span class="o_metric_value"><t t-esc="Math.round(record.proximity_score.raw_value)"/>%</span>
                                    </div>
                                    
                                    <!-- Workload Balance -->
                                    <div class="o_metric_item">
                                        <div class="o_metric_icon">
                                            <i class="fa fa-balance-scale"/>
                                        </div>
                                        <div class="o_metric_bar">
                                            <div class="o_metric_fill" 
                                                 t-att-style="'width: ' + record.workload_score.raw_value + '%;'"
                                                 t-att-class="record.workload_score.raw_value >= 80 ? 'bg-success' : record.workload_score.raw_value >= 60 ? 'bg-warning' : 'bg-danger'">
                                            </div>
                                        </div>
                                        <span class="o_metric_value"><t t-esc="Math.round(record.workload_score.raw_value)"/>%</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Smart Action Buttons with State-Aware Logic -->
                            <div class="o_assignment_smart_actions">
                                <!-- AI-Powered Staff Suggestion -->
                                <!-- Temporarily disabled for installation: -->
                                <!--
                                <div class="o_ai_suggestions" t-if="record.state.raw_value == 'draft'">
                                    <button name="action_get_ai_suggestions" type="object" 
                                            class="btn btn-sm btn-outline-primary btn-magic"
                                            title="Get AI-Powered Staff Suggestions">
                                        <i class="fa fa-magic mr-1"/>AI Suggest
                                    </button>
                                </div>
                                -->
                                
                                <!-- Quick Assignment Button -->
                                <div class="o_quick_actions">
                                    <t t-if="record.state.raw_value == 'assigned'">
                                        <button name="action_confirm_assignment" type="object" 
                                                class="btn btn-sm btn-success" title="Confirm Assignment">
                                            <i class="fa fa-check mr-1"/>Confirm
                                        </button>
                                    </t>
                                    
                                    <t t-elif="record.state.raw_value == 'confirmed'">
                                        <button name="action_start_assignment" type="object" 
                                                class="btn btn-sm btn-primary" title="Start Assignment">
                                            <i class="fa fa-play mr-1"/>Start
                                        </button>
                                    </t>
                                    
                                    <t t-elif="record.state.raw_value == 'in_progress'">
                                        <button name="action_complete_assignment" type="object" 
                                                class="btn btn-sm btn-info" title="Complete Assignment">
                                            <i class="fa fa-flag-checkered mr-1"/>Complete
                                        </button>
                                    </t>
                                </div>
                                
                                <!-- Advanced Options Dropdown -->
                                <div class="dropdown o_advanced_options">
                                    <span class="btn btn-sm btn-outline-secondary dropdown-toggle" 
                                          data-toggle="dropdown" title="More Options" role="button">
                                        <i class="fa fa-ellipsis-v"/>
                                    </span>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <h6 class="dropdown-header">Assignment Actions</h6>
                                        <button name="optimize_route" type="object" class="dropdown-item">
                                            <i class="fa fa-route mr-2"/>Optimize Route
                                        </button>
                                        <button name="action_reschedule_assignment" type="object" class="dropdown-item">
                                            <i class="fa fa-calendar mr-2"/>Reschedule
                                        </button>
                                        <div class="dropdown-divider"/>
                                        <h6 class="dropdown-header">Advanced</h6>
                                        <a href="#" class="dropdown-item o_view_assignment_details">
                                            <i class="fa fa-info-circle mr-2"/>View Details
                                        </a>
                                        <a href="#" class="dropdown-item o_duplicate_assignment">
                                            <i class="fa fa-copy mr-2"/>Duplicate
                                        </a>
                                        <div class="dropdown-divider"/>
                                        <button name="action_cancel_assignment" type="object" class="dropdown-item text-danger">
                                            <i class="fa fa-times mr-2"/>Cancel Assignment
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Real-time Status Indicator -->
                            <div class="o_realtime_status_footer" t-if="record.real_time_status.raw_value != 'scheduled'">
                                <div class="o_status_badge" 
                                     t-att-class="'badge badge-sm badge-' + (record.real_time_status.raw_value == 'en_route' ? 'warning' : record.real_time_status.raw_value == 'arrived' ? 'info' : record.real_time_status.raw_value == 'in_progress' ? 'primary' : 'secondary')">
                                    <i class="fa fa-circle pulse mr-1"/>
                                    <field name="real_time_status"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Assignment Dashboard Action -->
    <record id="action_assignment_dashboard" model="ir.actions.act_window">
        <field name="name">Staff Assignment Dashboard</field>
        <field name="res_model">health.staff.assignment</field>
        <field name="view_mode">kanban,calendar,list,form</field>
        <field name="view_id" ref="view_assignment_dashboard_kanban"/>
        <field name="domain">[]</field>
        <field name="context">{
            'default_state': 'draft',
            'group_by': ['state'],
            'kanban_column_progressbar': 'true'
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Welcome to the Staff Assignment Dashboard!
            </p>
            <p>
                This is your command center for managing healthcare staff assignments.
                Drag and drop assignments between workflow stages, get AI-powered suggestions,
                and track real-time status updates.
            </p>
        </field>
    </record>

    <!-- Assignment Calendar View -->
    <record id="view_assignment_calendar" model="ir.ui.view">
        <field name="name">health.staff.assignment.calendar</field>
        <field name="model">health.staff.assignment</field>
        <field name="arch" type="xml">
            <calendar string="Staff Assignment Calendar" 
                      date_start="assignment_date" 
                      color="state"
                      mode="week">
                
                <field name="name"/>
                <field name="state"/>
                <field name="priority"/>
            </calendar>
        </field>
    </record>

    <!-- Assignment List View -->
    <record id="view_assignment_list" model="ir.ui.view">
        <field name="name">health.staff.assignment.list</field>
        <field name="model">health.staff.assignment</field>
        <field name="arch" type="xml">
            <list string="Staff Assignments" create="true" edit="true" delete="true" 
                  decoration-success="state == 'completed'" 
                  decoration-warning="state in ('assigned', 'confirmed')"
                  decoration-danger="priority in ('3', '4')"
                  decoration-info="state == 'in_progress'">
                
                <field name="name"/>
                <field name="appointment_id"/>
                <field name="assigned_staff_ids" widget="many2many_tags"/>
                <field name="assignment_date"/>
                <field name="state" decoration-bf="1"/>
                <field name="priority" widget="priority"/>
                <field name="assignment_score" widget="progressbar"/>
                <field name="current_location" optional="hide"/>
                <field name="estimated_travel_time" optional="hide"/>
                
                <!-- Context Menu -->
                <button name="action_confirm_assignment" 
                        type="object" 
                        icon="fa-check" 
                        string="Confirm Assignment"
                        invisible="state != 'assigned'"/>
                
                <button name="action_start_assignment" 
                        type="object" 
                        icon="fa-play" 
                        string="Start Assignment"
                        invisible="state != 'confirmed'"/>
                
                <button name="optimize_route" 
                        type="object" 
                        icon="fa-route" 
                        string="Optimize Route"
                        invisible="state in ('completed', 'cancelled')"/>
                
            </list>
        </field>
    </record>

</data>
</odoo>