        <field name="arch" type="xml">
            <calendar string="Staff Availability Calendar" 
                      date_start="availability_date" 
                      color="status"
                      mode="week">
                <field name="staff_id"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="status"/>
            </calendar>
        </field>
    </record> -->

    <!-- Search View -->
    <record id="view_health_staff_availability_search" model="ir.ui.view">
        <field name="name">health.staff.availability.matrix.search</field>
        <field name="model">health.staff.availability.matrix</field>
        <field name="arch" type="xml">
            <search string="Staff Availability Search">
                <field name="staff_id"/>
                <field name="availability_date"/>
                <field name="status"/>
                
                <filter string="Available" name="available" domain="[('status', '=', 'available')]"/>
                <filter string="Booked" name="booked" domain="[('status', '=', 'booked')]"/>
                <filter string="Conflicts" name="conflicts" domain="[('conflict_detected', '=', True)]"/>
                <filter string="Today" name="today" 
                        domain="[('availability_date', '=', context_today())]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Staff" name="group_by_staff" context="{'group_by': 'staff_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'availability_date'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_health_staff_availability" model="ir.actions.act_window">
        <field name="name">Staff Availability</field>
        <field name="res_model">health.staff.availability.matrix</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No availability records found!
            </p>
            <p>
                Staff availability is automatically managed by the assignment system.
                You can manually block time slots or adjust capacity as needed.
            </p>
        </field>
    </record>

    <!-- Note: Healthcare Skills and Service Areas views are now defined in healthcare_skill_views.xml
         to avoid duplicate view definitions and field naming conflicts. -->


</data>
</odoo>