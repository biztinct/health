<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- =====================================================================
         Staff Availability Matrix Views
         ===================================================================== -->

    <!-- List View -->
    <record id="view_health_staff_availability_list" model="ir.ui.view">
        <field name="name">health.staff.availability.matrix.list</field>
        <field name="model">health.staff.availability.matrix</field>
        <field name="arch" type="xml">
            <list string="Staff Availability Matrix" create="true" edit="true" delete="true"
                  decoration-success="status == 'available'"
                  decoration-warning="status in ('tentative', 'break')"
                  decoration-danger="status in ('booked', 'blocked')"
                  decoration-info="status == 'travel'">
                
                <field name="staff_id"/>
                <field name="availability_date"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="status"/>
                <field name="capacity"/>
                <field name="booked_count"/>
                <field name="remaining_capacity"/>
                <field name="conflict_detected" optional="hide"/>
                <field name="location_type" optional="hide"/>
                
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_health_staff_availability_form" model="ir.ui.view">
        <field name="name">health.staff.availability.matrix.form</field>
        <field name="model">health.staff.availability.matrix</field>
        <field name="arch" type="xml">
            <form string="Staff Availability">
                <sheet>
                    <group>
                        <group string="Basic Information">
                            <field name="staff_id"/>
                            <field name="availability_date"/>
                            <field name="status"/>
                        </group>
                        <group string="Time Slot">
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="capacity"/>
                            <field name="booked_count"/>
                            <field name="remaining_capacity"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Assignment Details" invisible="status not in ('booked', 'tentative')">
                            <field name="appointment_id"/>
                            <field name="assignment_id"/>
                            <field name="location_type"/>
                        </group>
                        <group string="Buffer Management">
                            <field name="buffer_before"/>
                            <field name="buffer_after"/>
                            <field name="conflict_detected"/>
                        </group>
                    </group>
                    
                    <group string="Travel Information" invisible="location_type != 'home'">
                        <field name="travel_time_from_previous"/>
                        <field name="travel_time_to_next"/>
                    </group>
                    
                    <group string="Conflict Details" invisible="not conflict_detected">
                        <field name="conflict_details" readonly="1"/>
                    </group>
                    
                </sheet>
            </form>
        </field>
    </record>

    <!-- Calendar View - Temporarily disabled due to field type compatibility issues -->
