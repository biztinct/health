<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Automation policy (phase 1.6). Editable in Settings > Technical >
             System Parameters. Auto-finalize is OFF by default — locking a
             clinician's note without their sign-off is a policy the org opts
             into; reminders are on (harmless). -->
        <record id="param_reminder_enabled" model="ir.config_parameter">
            <field name="key">health_emr.reminder_enabled</field>
            <field name="value">True</field>
        </record>
        <record id="param_reminder_hours" model="ir.config_parameter">
            <field name="key">health_emr.reminder_hours</field>
            <field name="value">24</field>
        </record>
        <record id="param_auto_finalize_enabled" model="ir.config_parameter">
            <field name="key">health_emr.auto_finalize_enabled</field>
            <field name="value">False</field>
        </record>
        <record id="param_auto_finalize_days" model="ir.config_parameter">
            <field name="key">health_emr.auto_finalize_days</field>
            <field name="value">3</field>
        </record>

        <!-- Nightly: sign-reminders + (opt-in) auto-finalize backstop. -->
        <record id="cron_process_unsigned_notes" model="ir.cron">
            <field name="name">EMR: process unsigned clinical notes</field>
            <field name="model_id" ref="health_fieldservice.model_health_clinical_note"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_unsigned_notes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=2, minute=30, second=0) + timedelta(days=1))"/>
        </record>

    </data>
</odoo>
