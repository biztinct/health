<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Patient Form View - Add Zalo Fields -->
    <record id="view_health_patient_form_zalo" model="ir.ui.view">
        <field name="name">res.partner.patient.form.zalo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="health_base.view_health_patient_form"/>
        <field name="arch" type="xml">

            <!-- Add Zalo smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_zalo_conversations"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-comments"
                        invisible="zalo_conversation_count == 0">
                    <field name="zalo_conversation_count" widget="statinfo" string="Zalo Chats"/>
                </button>
            </xpath>

            <!-- Add Zalo User ID field with action buttons after phone -->
            <xpath expr="//field[@name='phone']" position="after">
                <label for="zalo_user_id" string="Zalo User ID"/>
                <div class="o_row">
                    <field name="zalo_user_id" placeholder="Zalo User ID (optional)" class="o_field_widget"/>
                    <button name="action_open_zalo_chat"
                            type="object"
                            icon="fa-comment"
                            class="btn-link"
                            title="Open Zalo Chat"
                            invisible="not has_zalo">
                        Zalo Chat
                    </button>
                    <button name="action_call_zalo"
                            type="object"
                            icon="fa-phone"
                            class="btn-link"
                            title="Call via Zalo"
                            invisible="not has_zalo">
                        Zalo Call
                    </button>
                </div>
            </xpath>

            <!-- Add invisible helper fields for computed values -->
            <xpath expr="//field[@name='email']" position="after">
                <field name="has_zalo" invisible="1"/>
                <field name="zalo_conversation_count" invisible="1"/>
                <field name="zalo_conversation_id" invisible="1"/>
                <field name="zalo_last_message_date" invisible="1"/>
            </xpath>

            <!-- Add Zalo tab in notebook - Always visible so users can configure -->
            <xpath expr="//notebook" position="inside">
                <page string="Zalo Integration" name="zalo">
                    <group>
                        <group string="Zalo Connection">
                            <field name="has_zalo" invisible="1"/>
                            <field name="zalo_user_id"/>
                            <field name="zalo_conversation_id" readonly="1"/>
                            <field name="zalo_last_message_date" readonly="1"/>
                            <field name="zalo_conversation_count"/>
                        </group>
                        <group string="View Conversations">
                            <button name="action_view_zalo_conversations"
                                    type="object"
                                    string="View All Conversations"
                                    class="btn-primary"
                                    invisible="not has_zalo or zalo_conversation_count == 0"
                                    icon="fa-comments"/>
                            <button name="action_link_zalo_user"
                                    type="object"
                                    string="Link Zalo User"
                                    class="btn-warning"
                                    invisible="has_zalo"
                                    icon="fa-link"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Extend Patient Kanban View - Add Zalo icons -->
    <record id="view_health_patient_kanban_zalo" model="ir.ui.view">
        <field name="name">res.partner.patient.kanban.zalo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="health_base.view_health_patient_kanban"/>
        <field name="arch" type="xml">
            <!-- Add Zalo fields -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="has_zalo"/>
                <field name="zalo_user_id"/>
            </xpath>

            <!-- Replace patient card header to add Zalo icons -->
            <xpath expr="//div[@class='o_patient_card_header']" position="replace">
                <div class="o_patient_card_header">
                    <div class="d-flex align-items-center justify-content-between">
                        <strong><field name="name"/></strong>
                        <t t-if="record.has_zalo.raw_value">
                            <div class="d-flex gap-1 align-items-center">
                                <span class="text-primary small fw-bold">Zalo</span>
                                <button name="action_open_zalo_chat" type="object" class="btn btn-link btn-sm p-0" title="Zalo Chat">
                                    <i class="fa fa-comment text-primary"/>
                                </button>
                                <button name="action_call_zalo" type="object" class="btn btn-link btn-sm p-0" title="Zalo Call">
                                    <i class="fa fa-phone text-success"/>
                                </button>
                            </div>
                        </t>
                    </div>
                </div>
            </xpath>

            <!-- Hide checkbox/tick mark in kanban -->
            <xpath expr="//kanban" position="attributes">
                <attribute name="records_draggable">0</attribute>
            </xpath>
        </field>
    </record>

</odoo>
