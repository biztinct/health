<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Zalo Conversation Form View -->
    <record id="zalo_conversation_view_form" model="ir.ui.view">
        <field name="name">Zalo Conversation Form</field>
        <field name="model">zalo.conversation</field>
        <field name="arch" type="xml">
            <form string="Zalo Conversation">
                <header>
                    <button name="action_open_chat" type="object" string="Open Chat" class="oe_highlight" invisible="state != 'active'"/>
                    <button name="action_mark_as_read" type="object" string="Mark as Read" invisible="unread_count == 0"/>
                    <button name="action_link_to_partner" type="object" string="Link to Contact" invisible="partner_id"/>
                    <button name="action_archive_conversation" type="object" string="Archive" invisible="state == 'archived'"/>
                    <button name="action_unarchive_conversation" type="object" string="Unarchive" invisible="state != 'archived'"/>
                    <button name="action_block_user" type="object" string="Block User" invisible="state == 'blocked'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active"/>
                </header>
                <sheet string="Zalo Conversation">
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="o_text_overflow"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Zalo User">
                            <field name="zalo_user_id"/>
                            <field name="zalo_user_name"/>
                            <field name="zalo_user_avatar" widget="url"/>
                            <field name="is_follower"/>
                        </group>
                        <group string="Linked Records">
                            <field name="partner_id"/>
                            <field name="config_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Conversation Info">
                            <field name="message_count"/>
                            <field name="unread_count"/>
                            <field name="last_message_date"/>
                            <field name="created_date"/>
                        </group>
                        <group string="Last Message">
                            <field name="last_message_text"/>
                            <field name="last_message_from_us"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages">
                            <field name="message_ids">
                                <list string="Messages" create="0">
                                    <field name="sent_date"/>
                                    <field name="direction"/>
                                    <field name="message_type"/>
                                    <field name="text"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- Zalo Conversation List View -->
    <record id="zalo_conversation_view_list" model="ir.ui.view">
        <field name="name">Zalo Conversation List</field>
        <field name="model">zalo.conversation</field>
        <field name="arch" type="xml">
            <list string="Zalo Conversations" default_order="last_message_date desc">
                <field name="name"/>
                <field name="zalo_user_name"/>
                <field name="partner_id"/>
                <field name="message_count"/>
                <field name="unread_count" decoration-danger="unread_count &gt; 0"/>
                <field name="last_message_date"/>
                <field name="state" decoration-success="state=='active'" decoration-muted="state=='archived'"/>
            </list>
        </field>
    </record>

    <!-- Zalo Conversation Kanban View -->
    <record id="zalo_conversation_view_kanban" model="ir.ui.view">
        <field name="name">Zalo Conversation Kanban</field>
        <field name="model">zalo.conversation</field>
        <field name="arch" type="xml">
            <kanban default_order="last_message_date desc">
                <field name="id"/>
                <field name="name"/>
                <field name="zalo_user_avatar"/>
                <field name="last_message_text"/>
                <field name="last_message_date"/>
                <field name="unread_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-if="record.zalo_user_avatar.value" t-att-src="record.zalo_user_avatar.value" alt="Avatar"/>
                                <img t-else="" src="/web/static/img/placeholder.png" alt="Avatar"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div t-if="record.unread_count.value &gt; 0" class="badge badge-danger">
                                    <t t-esc="record.unread_count.value"/> new
                                </div>
                                <div class="text-muted">
                                    <t t-esc="record.last_message_text.value"/>
                                </div>
                                <div class="text-muted">
                                    <small><field name="last_message_date"/></small>
                                </div>
                            </div>
                        </div>
                    </t>
                    <!-- OWL kanban compatibility -->
                    <t t-name="card">
                        <t t-call="kanban-box"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Zalo Conversation Search View -->
    <record id="zalo_conversation_view_search" model="ir.ui.view">
        <field name="name">Zalo Conversation Search</field>
        <field name="model">zalo.conversation</field>
        <field name="arch" type="xml">
            <search string="Search Conversations">
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Zalo Conversation Action -->
    <record id="zalo_conversation_action" model="ir.actions.act_window">
        <field name="name">Zalo Conversations</field>
        <field name="res_model">zalo.conversation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Zalo conversations yet
            </p>
            <p>
                Zalo conversations will appear here when users send messages to your Official Account.
            </p>
        </field>
    </record>

</odoo>
