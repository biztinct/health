<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Partner Form View - Add Zalo Fields -->
    <record id="res_partner_view_form_zalo" model="ir.ui.view">
        <field name="name">res.partner.form.zalo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Add Zalo smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_zalo_conversations" type="object" class="oe_stat_button" icon="fa-comments" invisible="zalo_conversation_count == 0">
                    <field name="zalo_conversation_count" widget="statinfo" string="Zalo Chats"/>
                </button>
            </xpath>

            <!-- Add Zalo User ID field with action icons after phone -->
            <xpath expr="//field[@name='phone']" position="after">
                <label for="zalo_user_id" string="Zalo User ID"/>
                <div class="o_row">
                    <field name="zalo_user_id" placeholder="Zalo User ID (optional)" class="o_field_widget"/>
                    <button name="action_open_zalo_chat"
                            type="object"
                            icon="fa-comment"
                            class="btn-link o_icon_button"
                            title="Open Zalo Chat"
                            invisible="not has_zalo"
                            aria-label="Open Zalo Chat"/>
                    <button name="action_call_zalo"
                            type="object"
                            icon="fa-phone"
                            class="btn-link o_icon_button"
                            title="Call via Zalo"
                            invisible="not has_zalo"
                            aria-label="Call via Zalo"/>
                </div>
            </xpath>

            <!-- Add invisible helper fields -->
            <xpath expr="//field[@name='email']" position="after">
                <field name="has_zalo" invisible="1"/>
                <field name="zalo_conversation_count" invisible="1"/>
                <field name="zalo_conversation_id" invisible="1"/>
                <field name="zalo_last_message_date" invisible="1"/>
            </xpath>

            <!-- Add Zalo tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Zalo" name="zalo">
                    <group>
                        <group string="Zalo Integration">
                            <field name="has_zalo" invisible="1"/>
                            <field name="zalo_user_id"/>
                            <field name="zalo_conversation_id" readonly="1"/>
                            <field name="zalo_last_message_date" readonly="1"/>
                            <field name="zalo_conversation_count"/>
                        </group>
                        <group string="View Conversations">
                            <button name="action_view_zalo_conversations"
                                    type="object"
                                    string="View All Conversations"
                                    class="btn-primary"
                                    invisible="not has_zalo or zalo_conversation_count == 0"
                                    icon="fa-comments"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
