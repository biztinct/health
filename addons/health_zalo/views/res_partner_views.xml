<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Partner Form View - Add Zalo Fields -->
    <record id="res_partner_view_form_zalo" model="ir.ui.view">
        <field name="name">res.partner.form.zalo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Add Zalo smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_zalo_conversations" type="object" class="oe_stat_button" icon="fa-comments" invisible="zalo_conversation_count == 0">
                    <field name="zalo_conversation_count" widget="statinfo" string="Zalo Chats"/>
                </button>
            </xpath>

            <!-- Add Zalo fields after phone -->
            <xpath expr="//field[@name='phone']" position="after">
                <field name="zalo_user_id" widget="phone" placeholder="Zalo User ID" invisible="not has_zalo"/>
            </xpath>

            <!-- Add Zalo action buttons next to phone icon -->
            <xpath expr="//field[@name='phone']/.." position="attributes">
                <attribute name="class">o_row</attribute>
            </xpath>

            <xpath expr="//field[@name='phone']" position="after">
                <button name="action_open_zalo_chat" type="object" class="btn btn-link" invisible="not has_zalo" title="Open Zalo Chat">
                    <i class="fa fa-comment"/>
                </button>
                <button name="action_call_zalo" type="object" class="btn btn-link" invisible="not has_zalo" title="Call via Zalo">
                    <i class="fa fa-phone"/>
                </button>
            </xpath>

            <!-- Add Zalo tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Zalo" name="zalo" invisible="not has_zalo">
                    <group>
                        <group string="Zalo Integration">
                            <field name="has_zalo" invisible="1"/>
                            <field name="zalo_user_id"/>
                            <field name="zalo_conversation_id" readonly="1"/>
                            <field name="zalo_last_message_date" readonly="1"/>
                        </group>
                        <group string="Actions">
                            <button name="action_open_zalo_chat" type="object" string="Open Zalo Chat" class="btn-primary" invisible="not has_zalo"/>
                            <button name="action_call_zalo" type="object" string="Call via Zalo" invisible="not has_zalo"/>
                            <button name="action_link_zalo_user" type="object" string="Link Zalo User" invisible="has_zalo"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
