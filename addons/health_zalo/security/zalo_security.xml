<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_zalo" model="ir.module.category">
        <field name="name">Zalo Integration</field>
        <field name="description">Manage Zalo messaging and integration access</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_zalo_user" model="res.groups">
        <field name="name">Zalo User</field>
        <field name="category_id" ref="module_category_zalo"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view and send Zalo messages</field>
    </record>

    <record id="group_zalo_manager" model="res.groups">
        <field name="name">Zalo Manager</field>
        <field name="category_id" ref="module_category_zalo"/>
        <field name="implied_ids" eval="[(4, ref('health_zalo.group_zalo_user'))]"/>
        <field name="comment">Can configure Zalo integration and manage conversations</field>
    </record>

    <record id="group_zalo_admin" model="res.groups">
        <field name="name">Zalo Administrator</field>
        <field name="category_id" ref="module_category_zalo"/>
        <field name="implied_ids" eval="[(4, ref('health_zalo.group_zalo_manager')), (4, ref('base.group_system'))]"/>
        <field name="comment">Full access to Zalo configuration and settings</field>
    </record>

</odoo>
