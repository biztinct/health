<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_zalo" model="ir.module.category">
        <field name="name">Zalo Integration</field>
        <field name="description">Manage Zalo messaging and integration access</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_zalo" model="res.groups.privilege">
        <field name="name">Zalo Integration</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_zalo"/>
    </record>

    <record id="group_zalo_user" model="res.groups">
        <field name="name">Zalo User</field>
        <field name="privilege_id" ref="health_base.res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('health_base.group_healthcare_base'))]"/>
        <field name="comment">Can view and send Zalo messages</field>
    </record>

    <record id="group_zalo_manager" model="res.groups">
        <field name="name">Zalo Manager</field>
        <field name="privilege_id" ref="health_base.res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('health_zalo.group_zalo_user'))]"/>
        <field name="comment">Can configure Zalo integration and manage conversations</field>
    </record>

    <record id="group_zalo_admin" model="res.groups">
        <field name="name">Zalo Administrator</field>
        <field name="privilege_id" ref="health_base.res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('health_zalo.group_zalo_manager'))]"/>
        <field name="comment">Full access to Zalo configuration and settings</field>
    </record>

    <!-- ==================================================================
         CC-D, defect Z4: this module shipped with NO ir.rule at all, so any
         Zalo user of any company could read every company's configuration,
         conversations and messages. The rules below are GLOBAL (no `groups`
         field) — a group-bound rule only constrains its own members, and a
         group without a matching rule would read everything. Same posture as
         health_care_command_channels/security/channel_hub_security.xml.
         ================================================================== -->

    <record id="zalo_config_company_rule" model="ir.rule">
        <field name="name">Zalo Configuration: multi-company</field>
        <field name="model_id" ref="model_zalo_config"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="zalo_conversation_company_rule" model="ir.rule">
        <field name="name">Zalo Conversation: multi-company</field>
        <field name="model_id" ref="model_zalo_conversation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- zalo.message carries no company of its own: it hangs off the
         conversation, which hangs off the config. -->
    <record id="zalo_message_company_rule" model="ir.rule">
        <field name="name">Zalo Message: multi-company</field>
        <field name="model_id" ref="model_zalo_message"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('conversation_id.config_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="zalo_attachment_company_rule" model="ir.rule">
        <field name="name">Zalo Attachment: multi-company</field>
        <field name="model_id" ref="model_zalo_attachment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('message_id.conversation_id.config_id.company_id', 'in', company_ids)]</field>
    </record>

</odoo>
