<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         Catchment province record rules (spec §0.3 template).
         health.vitals.type is a global catalog — no rules.
         ===================================================================== -->

    <record id="rule_health_observation_catchment" model="ir.rule">
        <field name="name">Observation: Healthcare users see own catchment</field>
        <field name="model_id" ref="model_health_observation"/>
        <field name="domain_force">['&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_nurse')), (4, ref('health_base.group_healthcare_head_nurse')), (4, ref('health_base.group_healthcare_doctor')), (4, ref('health_base.group_healthcare_operations_manager')), (4, ref('health_base.group_healthcare_manager'))]"/>
    </record>
    <record id="rule_health_observation_owner" model="ir.rule">
        <field name="name">Observation: Owner sees all</field>
        <field name="model_id" ref="model_health_observation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_owner'))]"/>
    </record>

    <record id="rule_health_vitals_threshold_catchment" model="ir.rule">
        <field name="name">Vitals Threshold: Healthcare users see own catchment</field>
        <field name="model_id" ref="model_health_vitals_threshold"/>
        <field name="domain_force">['&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_nurse')), (4, ref('health_base.group_healthcare_head_nurse')), (4, ref('health_base.group_healthcare_doctor')), (4, ref('health_base.group_healthcare_operations_manager')), (4, ref('health_base.group_healthcare_manager'))]"/>
    </record>
    <record id="rule_health_vitals_threshold_owner" model="ir.rule">
        <field name="name">Vitals Threshold: Owner sees all</field>
        <field name="model_id" ref="model_health_vitals_threshold"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_owner'))]"/>
    </record>

</odoo>
