msgid "Internal code must be unique."
msgstr "Mã nội bộ phải là duy nhất."

#. module: health_vitals
msgid "One threshold per client, type and severity."
msgstr "Mỗi khách hàng, loại và mức độ chỉ có một ngưỡng."

#. module: health_vitals
msgid "A threshold needs at least a minimum or a maximum value."
msgstr "Ngưỡng cần ít nhất một giá trị tối thiểu hoặc tối đa."

#. module: health_vitals
msgid "Threshold minimum cannot exceed its maximum."
msgstr "Giá trị tối thiểu của ngưỡng không được vượt quá giá trị tối đa."

#. module: health_vitals
msgid "%(name)s: value %(value)s outside plausible range [%(min)s – %(max)s]."
msgstr "%(name)s: giá trị %(value)s ngoài phạm vi hợp lệ [%(min)s – %(max)s]."

#. module: health_vitals
msgid "Only a head nurse (or above) can amend the value of a final observation."
msgstr "Chỉ điều dưỡng trưởng (hoặc cấp cao hơn) mới được sửa giá trị của quan sát đã hoàn tất."

#. module: health_vitals
msgid "Clinical observations are append-only and cannot be deleted. Mark the record 'Entered in Error' and re-enter the correct value instead."
msgstr "Quan sát lâm sàng chỉ được thêm mới, không thể xóa. Hãy đánh dấu bản ghi là 'Nhập sai' và nhập lại giá trị đúng."

#. module: health_vitals
msgid "Observation %s is already marked entered in error."
msgstr "Quan sát %s đã được đánh dấu nhập sai."

#. module: health_vitals
msgid "ALERT: %(type)s %(value)s%(unit)s breached %(severity)s threshold [%(min)s-%(max)s]"
msgstr "CẢNH BÁO: %(type)s %(value)s%(unit)s vượt ngưỡng %(severity)s [%(min)s-%(max)s]"

