<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Standalone popup-completion pages. No website dependency, no backend
         assets (the popup is opened from the provider's domain and may be
         blocked or orphaned). Flat mono colors, no gradients, no emoji,
         vi-first with an en gloss — family_link precedent.

         SECURITY: these pages never echo state, code or any other callback
         parameter. The only values interpolated are the channel key and our
         OWN base URL, both server-controlled, and both handed to JS through
         data attributes rather than inline script text. -->
    <template id="oauth_styles" name="Channel Hub Callback Styles">
        <style>
            * { box-sizing: border-box; }
            body { margin: 0; font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
                   background: #f4f5f7; color: #1f2733; -webkit-text-size-adjust: 100%; }
            .ch-wrap { max-width: 460px; margin: 0 auto; padding: 48px 18px; }
            .ch-card { background: #ffffff; border: 1px solid #e3e6ea; border-radius: 14px;
                       padding: 28px 24px; text-align: center; }
            .ch-mark { width: 44px; height: 44px; margin: 0 auto 16px; border-radius: 50%;
                       display: flex; align-items: center; justify-content: center; }
            .ch-mark svg { width: 22px; height: 22px; }
            .ch-mark.ok { background: #e6f4f1; color: #0b6b5a; }
            .ch-mark.neutral { background: #eef0f2; color: #5b6572; }
            .ch-h1 { font-size: 19px; font-weight: 700; margin: 0 0 8px; }
            .ch-sub { color: #5b6572; font-size: 14px; margin: 0 0 6px; line-height: 1.5; }
            .ch-en { color: #8a94a1; font-size: 13px; margin: 0 0 22px; line-height: 1.5; }
            .ch-link { display: inline-block; padding: 11px 20px; border-radius: 10px;
                       background: #0b6b5a; color: #ffffff; text-decoration: none;
                       font-weight: 600; font-size: 15px; }
        </style>
    </template>

    <template id="oauth_bridge" name="Channel Hub Callback Bridge">
        <!-- Tells the opener how it went, then leaves a manual way back for a
             popup whose opener is gone (blocked, closed, cross-tab). -->
        <div id="ch_bridge" t-att-data-origin="origin" t-att-data-channel="channel"
             t-att-data-ok="ok and '1' or '0'" style="display:none"/>
        <script type="text/javascript">
            (function () {
                var el = document.getElementById('ch_bridge');
                if (!el || !window.opener || !el.dataset.origin) { return; }
                try {
                    window.opener.postMessage({
                        channelHub: true,
                        ok: el.dataset.ok === '1',
                        channel: el.dataset.channel || ''
                    }, el.dataset.origin);
                } catch (e) { /* opener gone or cross-origin — the link below covers it */ }
            })();
        </script>
    </template>

    <template id="oauth_success" name="Channel Hub — Connected">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Health19</title>
                <t t-call="health_care_command_channels.oauth_styles"/>
            </head>
            <body>
                <div class="ch-wrap">
                    <div class="ch-card">
                        <div class="ch-mark ok">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 6 9 17l-5-5"/>
                            </svg>
                        </div>
                        <p class="ch-h1">Đã kết nối</p>
                        <p class="ch-sub">Bạn có thể đóng cửa sổ này và quay lại Health19
                            để hoàn tất các bước còn lại.</p>
                        <p class="ch-en">Connected. You can close this window and return to
                            Health19 to finish the remaining steps.</p>
                        <a class="ch-link" t-att-href="origin or '/'">Quay lại Health19 / Return to Health19</a>
                    </div>
                </div>
                <t t-call="health_care_command_channels.oauth_bridge">
                    <t t-set="ok" t-value="True"/>
                </t>
            </body>
        </html>
    </template>

    <template id="oauth_denied" name="Channel Hub — Cancelled">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Health19</title>
                <t t-call="health_care_command_channels.oauth_styles"/>
            </head>
            <body>
                <div class="ch-wrap">
                    <div class="ch-card">
                        <div class="ch-mark neutral">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 6 6 18M6 6l12 12"/>
                            </svg>
                        </div>
                        <p class="ch-h1">Bạn đã huỷ — chưa kết nối gì cả</p>
                        <p class="ch-sub">Không có thay đổi nào được lưu. Bạn có thể thử lại
                            bất cứ lúc nào từ Health19.</p>
                        <p class="ch-en">You cancelled — nothing was connected. No changes were
                            saved; you can try again any time from Health19.</p>
                        <a class="ch-link" t-att-href="origin or '/'">Quay lại Health19 / Return to Health19</a>
                    </div>
                </div>
                <t t-call="health_care_command_channels.oauth_bridge">
                    <t t-set="ok" t-value="False"/>
                </t>
            </body>
        </html>
    </template>

    <template id="oauth_generic" name="Channel Hub — Cannot continue">
        <!-- The ONE page for unknown / already-used / expired / mismatched
             state, and for a rate-limited caller. Deliberately says nothing
             that would tell an attacker which of those it was. -->
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Health19</title>
                <t t-call="health_care_command_channels.oauth_styles"/>
            </head>
            <body>
                <div class="ch-wrap">
                    <div class="ch-card">
                        <div class="ch-mark neutral">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 8v5"/><path d="M12 16.5h.01"/>
                                <circle cx="12" cy="12" r="9"/>
                            </svg>
                        </div>
                        <p class="ch-h1">Không thể tiếp tục</p>
                        <p class="ch-sub">Liên kết này không còn dùng được. Hãy quay lại
                            Health19 và bắt đầu lại kết nối.</p>
                        <p class="ch-en">This link can no longer be used. Return to Health19 and
                            start the connection again.</p>
                        <a class="ch-link" t-att-href="origin or '/'">Quay lại Health19 / Return to Health19</a>
                    </div>
                </div>
            </body>
        </html>
    </template>

</odoo>
