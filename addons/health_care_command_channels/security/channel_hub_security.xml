<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- CC-C note: every rule below is GLOBAL (no `groups` field), so it
         already applies to the tenant-administrator persona whose ACL rows
         land in this phase — there is no group list to extend. A global rule
         is also the stronger posture: a group-bound rule only constrains its
         own members, and any group without a matching rule would read
         everything. -->

    <!-- Company scoping, cloned from health_care_command's global rules.
         Global (not group-bound) so a direct, non-sudo read from ANY user
         stays inside the user's allowed companies. Belt and suspenders: every
         service method in this module already scopes by company, and the
         credentials themselves are additionally field-gated to
         base.group_system. Defect Z4 in health_zalo — a config model with no
         ir.rule at all — is exactly what this prevents. -->

    <record id="care_channel_connection_company_rule" model="ir.rule">
        <field name="name">Care Channel Connection: multi-company</field>
        <field name="model_id" ref="model_care_channel_connection"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="care_channel_readiness_check_company_rule" model="ir.rule">
        <field name="name">Channel Readiness Check: multi-company</field>
        <field name="model_id" ref="model_care_channel_readiness_check"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('connection_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="care_channel_audit_company_rule" model="ir.rule">
        <field name="name">Channel Audit: multi-company</field>
        <field name="model_id" ref="model_care_channel_audit"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- CC-B message spine. Both models carry a stored related company_id
         (from the connection), so the rule is a plain company test. -->
    <record id="care_channel_identity_company_rule" model="ir.rule">
        <field name="name">Care Channel Identity: multi-company</field>
        <field name="model_id" ref="model_care_channel_identity"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="care_channel_message_company_rule" model="ir.rule">
        <field name="name">Care Channel Message: multi-company</field>
        <field name="model_id" ref="model_care_channel_message"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="care_channel_oauth_session_company_rule" model="ir.rule">
        <field name="name">Channel Authorization Session: multi-company</field>
        <field name="model_id" ref="model_care_channel_oauth_session"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- The Unrouted queue. Company-scoped like everything else here — a
         capture from a page we could not recognise still carries the company
         of the connection it was routed to, or the acting company when there
         was none. -->
    <record id="care_contact_capture_company_rule" model="ir.rule">
        <field name="name">Unrouted Contact: multi-company</field>
        <field name="model_id" ref="model_care_contact_capture"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!--
        Catchment scoping. Each area runs its own Zalo OA / Facebook page, so a
        connection belongs to an area and its identities and messages inherit
        it (stored related, same shape as company_id above).

        Connections with NO area are national accounts and stay visible to
        everyone: hiding an unassigned account would make the Channels setup
        screen look empty on a fresh install and give nobody a way to assign
        one. The Owner twin is required for the inherited-group reason
        documented in health_catchment_scope/security.
    -->
    <record id="care_channel_connection_catchment_rule" model="ir.rule">
        <field name="name">Channel Connection: staff see their own catchment</field>
        <field name="model_id" ref="model_care_channel_connection"/>
        <field name="domain_force">['|', ('catchment_province_id', '=', False), ('catchment_province_id', '=', user.catchment_province_id.id)]</field>
        <field name="groups" eval="[
            (4, ref('health_crm.group_health_crm_user')),
            (4, ref('health_crm.group_health_crm_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="care_channel_connection_catchment_owner_rule" model="ir.rule">
        <field name="name">Channel Connection: Owner sees all catchments</field>
        <field name="model_id" ref="model_care_channel_connection"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_owner'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="care_channel_message_catchment_rule" model="ir.rule">
        <field name="name">Channel Message: staff see their own catchment</field>
        <field name="model_id" ref="model_care_channel_message"/>
        <field name="domain_force">['|', ('catchment_province_id', '=', False), ('catchment_province_id', '=', user.catchment_province_id.id)]</field>
        <field name="groups" eval="[
            (4, ref('health_crm.group_health_crm_user')),
            (4, ref('health_crm.group_health_crm_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="care_channel_message_catchment_owner_rule" model="ir.rule">
        <field name="name">Channel Message: Owner sees all catchments</field>
        <field name="model_id" ref="model_care_channel_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_owner'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
