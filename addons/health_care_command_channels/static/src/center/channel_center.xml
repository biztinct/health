<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!--
  Channel Connection Center — the catalogue (8 cards) and the stepper modal.
  Every visible string either comes from the server already translated
  (labels, chips, check names, stepper copy) or goes through _t here; there is
  no channel knowledge and no state vocabulary in this file.
-->
<t t-name="health_care_command_channels.ChannelCenter">
  <div class="o_channel_center">

    <header class="cc-top">
      <div class="cc-title">
        <span class="ic ic-plug"/>
        <div>
          <h1>Channel Connection Center</h1>
          <p>Connect the places your clients already message you from. Everything lands in Care Command.</p>
        </div>
      </div>
      <button class="cc-btn ghost" t-on-click="() => this.load()"
              t-att-disabled="state.loading">
        <span class="ic ic-refresh"/><span>Refresh</span>
      </button>
    </header>

    <div t-if="state.loading and !state.cards.length" class="cc-empty">Loading…</div>
    <div t-if="state.error" class="cc-alert bad" role="alert" t-esc="state.error"/>

    <!-- ===================== catalogue ===================== -->
    <div class="cc-grid">
      <t t-foreach="cards" t-as="card" t-key="card.channel">
        <section class="cc-card" t-att-class="'tone-' + tone(card.state)"
                 t-att-style="'--cv:' + style(card.channel).cv">

          <div class="cc-card-head">
            <span class="cc-bub"><span class="ic" t-att-class="style(card.channel).ic"/></span>
            <div class="cc-card-id">
              <h2 t-esc="card.label"/>
              <span class="cc-chip" t-att-class="'tone-' + tone(card.state)"
                    t-esc="card.state_chip"/>
            </div>
          </div>

          <!-- One account: the headline IS the account, so keep the single
               line the card has always had. Several: list them, because
               "Messenger — connected" is a lie when one of two pages is
               broken. -->
          <p class="cc-res" t-if="card.resource_line and card.accounts.length &lt;= 1"
             t-esc="card.resource_line"/>
          <p class="cc-res muted" t-if="!card.resource_line and card.available and card.implemented">
            Not set up yet
          </p>

          <div class="cc-accounts" t-if="card.accounts.length &gt; 1">
            <t t-foreach="card.accounts" t-as="acc" t-key="acc.connection_id">
              <button class="cc-account" t-att-class="'tone-' + tone(acc.state)"
                      t-on-click="() => this.openManage(card, acc)">
                <span class="cc-account-id">
                  <span class="cc-account-name" t-esc="acc.account_label"/>
                  <span class="cc-account-res" t-if="acc.resource_line"
                        t-esc="acc.resource_line"/>
                </span>
                <span class="cc-chip small" t-att-class="'tone-' + tone(acc.state)"
                      t-esc="acc.state_chip"/>
              </button>
            </t>
          </div>
          <p class="cc-res muted" t-if="!card.available">
            Health19 is completing provider approval for this channel.
          </p>
          <p class="cc-res muted" t-if="card.available and !card.implemented">
            Available in an upcoming update.
          </p>

          <!-- Calls is RECEIVE ONLY and the card says so without being
               opened: "connected" here means call events are arriving, never
               that VoIP24h's API works — which we have no way to know. -->
          <p class="cc-sub-line" t-if="card.notice" t-esc="card.notice"/>

          <div class="cc-traffic" t-if="card.last_inbound_at or card.last_outbound_at">
            <span t-if="card.last_inbound_at">
              <span class="ic ic-in"/> Received <t t-esc="since(card.last_inbound_at)"/>
            </span>
            <span t-if="card.last_outbound_at">
              <span class="ic ic-out"/> Sent <t t-esc="since(card.last_outbound_at)"/>
            </span>
          </div>

          <!-- Meta's human reviews, on the card itself: a tenant should not
               have to open a stepper to learn what they are waiting for. -->
          <t t-if="card.approvals">
            <t t-foreach="card.approvals" t-as="ap" t-key="ap.key">
              <p class="cc-sub-line" t-if="ap.status !== 'pass'"
                 t-att-class="'st-' + ap.status">
                <strong t-esc="ap.label"/>: <t t-esc="ap.message"/>
              </p>
            </t>
          </t>

          <div class="cc-checks" t-if="card.checks.length and card.implemented">
            <div class="cc-dots">
              <t t-foreach="card.checks" t-as="chk" t-key="chk.key">
                <span class="cc-dot" t-att-class="'st-' + chk.status"
                      t-att-title="chk.label"/>
              </t>
            </div>
            <span class="cc-count"><t t-esc="card.checks_done"/>/<t t-esc="card.checks_total"/></span>
          </div>

          <div class="cc-actions">
            <button class="cc-btn primary"
                    t-att-disabled="card.primary_action === 'unavailable' or state.busy"
                    t-on-click="() => this.onPrimary(card)"
                    t-esc="card.primary_label"/>
            <!-- Two Facebook pages, two Zalo accounts (client requirement 1).
                 Only offered once the first account exists — "add another"
                 with nothing to add another TO is just a confusing Connect. -->
            <button class="cc-btn" t-if="card.can_add_account"
                    t-att-disabled="state.busy"
                    t-on-click="() => this.addAccount(card)">Add another account</button>
          </div>

          <!-- ZNS and any other capability-of-a-parent renders inside its parent -->
          <t t-foreach="subCards(card.channel)" t-as="sub" t-key="sub.channel">
            <div class="cc-sub">
              <div class="cc-sub-head">
                <span class="ic" t-att-class="style(sub.channel).ic"/>
                <span class="cc-sub-name" t-esc="sub.label"/>
                <span class="cc-chip small" t-att-class="'tone-' + tone(sub.state)"
                      t-esc="sub.state_chip"/>
              </div>
              <!-- Honest ZNS readiness: a template count we can see, and a
                   send Zalo has actually accepted. Nothing is asserted. -->
              <t t-if="sub.zns">
                <p class="cc-sub-line" t-esc="sub.zns.note"/>
                <p class="cc-sub-line"
                   t-att-class="sub.zns.approvals === 'pass' ? 'ok' : 'muted'"
                   t-esc="sub.zns.proof"/>
              </t>
            </div>
          </t>
        </section>
      </t>
    </div>

    <!-- ===================== stepper / manage modal ===================== -->
    <div t-if="state.open" class="cc-modal-wrap" t-on-keydown="onModalKeydown">
      <div class="cc-backdrop" t-on-click="closeStepper"/>
      <div class="cc-modal" role="dialog" aria-modal="true"
           t-att-aria-label="openCard and openCard.label" t-ref="modal">

        <header class="cc-modal-head">
          <span class="cc-bub" t-att-style="'--cv:' + style(state.open).cv">
            <span class="ic" t-att-class="style(state.open).ic"/>
          </span>
          <div>
            <h2 t-esc="openCard and openCard.label"/>
            <span class="cc-chip" t-if="openCard"
                  t-att-class="'tone-' + tone(openCard.state)"
                  t-esc="openCard.state_chip"/>
          </div>
          <button class="cc-x" t-on-click="closeStepper" aria-label="Close">
            <span class="ic ic-x"/>
          </button>
        </header>

        <!-- ===== manage panel (a connected channel) ===== -->
        <!-- Everything here reads `openAccount`, not `openCard`: with two
             accounts on one channel the card describes the healthier one, and
             showing its green checklist for the page the tenant came here to
             repair would be actively misleading. -->
        <div t-if="state.manage" class="cc-modal-body">
          <p class="cc-res" t-if="openAccount and openAccount.resource_line"
             t-esc="openAccount.resource_line"/>

          <!-- Naming an account is the only way to tell two Facebook pages
               apart in a picker; the provider's own name is often identical. -->
          <div class="cc-rename" t-if="state.connectionId">
            <t t-if="!state.renaming">
              <span class="cc-account-name"
                    t-esc="state.accountLabel or 'Unnamed account'"/>
              <button class="cc-btn tiny" t-on-click="startRename">Rename</button>
            </t>
            <t t-else="">
              <input type="text" class="cc-input" maxlength="120"
                     placeholder="e.g. Zalo OA — HCM"
                     t-att-value="state.accountLabel"
                     t-on-input="(ev) => this.onAccountLabel(ev)"/>
              <button class="cc-btn tiny primary" t-att-disabled="state.busy"
                      t-on-click="saveAccountLabel">Save</button>
            </t>
          </div>

          <ul class="cc-checklist" t-if="openAccount">
            <t t-foreach="openAccount.checks" t-as="chk" t-key="chk.key">
              <li t-att-class="'st-' + chk.status">
                <span class="ic" t-att-class="chk.status === 'pass' ? 'ic-check' : (chk.status === 'fail' ? 'ic-x' : 'ic-clock')"/>
                <span t-esc="chk.label"/>
              </li>
            </t>
          </ul>

          <!-- Provider approvals are STATE, not errors: business
               verification, display-name review and template review are
               Meta's human processes, and they render as pending tasks. -->
          <div class="cc-sub" t-if="state.approvals.length">
            <div class="cc-sub-head">
              <span class="ic ic-clock"/>
              <span class="cc-sub-name">Waiting on Meta</span>
            </div>
            <t t-foreach="state.approvals" t-as="ap" t-key="ap.key">
              <p class="cc-sub-line" t-att-class="'st-' + ap.status">
                <strong t-esc="ap.label"/>: <t t-esc="ap.message"/>
              </p>
            </t>
            <div class="cc-row">
              <button class="cc-btn ghost" t-att-disabled="state.busy"
                      t-on-click="refreshApprovals">Check again</button>
            </div>
          </div>

          <div class="cc-tech" t-if="openCard">
            <details>
              <summary>Technical details</summary>
              <dl>
                <dt>Status</dt><dd t-esc="openCard.state"/>
                <dt>Last received</dt>
                <dd t-esc="openCard.last_inbound_at or '—'"/>
                <dt>Last sent</dt>
                <dd t-esc="openCard.last_outbound_at or '—'"/>
              </dl>
            </details>
          </div>

          <div t-if="state.confirmOff" class="cc-alert warn">
            <p>New messages will stop arriving in Care Command. Conversation history stays.</p>
            <div class="cc-row">
              <button class="cc-btn ghost" t-on-click="cancelDisconnect">Keep it on</button>
              <button class="cc-btn danger" t-att-disabled="state.busy"
                      t-on-click="doDisconnect">Turn it off</button>
            </div>
          </div>
        </div>

        <footer t-if="state.manage" class="cc-modal-foot">
          <!-- No test button for Calls: there is no VoIP24h endpoint we hold
               a verified contract for, so the button could only ever explain
               why it cannot work. The card carries that sentence instead. -->
          <button class="cc-btn ghost" t-if="!isCall" t-att-disabled="state.busy"
                  t-on-click="sendTest">Send a test</button>
          <button class="cc-btn ghost" t-if="!state.confirmOff"
                  t-on-click="askDisconnect">Turn off</button>
          <button class="cc-btn primary" t-on-click="closeStepper">Done</button>
        </footer>

        <!-- ===== wizard ===== -->
        <div t-if="!state.manage" class="cc-modal-body">

          <ol class="cc-steps">
            <t t-foreach="state.steps" t-as="st" t-key="st.key">
              <li t-att-class="st_index === state.step ? 'on' : (st_index &lt; state.step ? 'done' : '')">
                <span class="cc-step-n" t-esc="st_index + 1"/>
                <span class="cc-step-t" t-esc="st.title"/>
              </li>
            </t>
          </ol>

          <div class="cc-step-body">
            <h3 t-esc="currentStep.title"/>
            <p t-if="currentStep.body" t-esc="currentStep.body"/>
            <p t-if="currentStep.link">
              <a t-att-href="currentStep.link" target="_blank" rel="noopener noreferrer"
                 class="cc-link" t-esc="currentStep.link_label or currentStep.link"/>
            </p>

            <!-- ===== Telegram: paste the key ===== -->
            <t t-if="isTelegram and state.step === 1">
              <label class="cc-label" for="cc_token">Bot key</label>
              <input id="cc_token" type="password" class="cc-input"
                     autocomplete="off" spellcheck="false"
                     placeholder="123456789:AAG…"
                     t-model="state.token"/>
              <p class="cc-help">We check the key with Telegram before saving it. It is stored encrypted and never shown again.</p>
            </t>

            <t t-if="isTelegram and state.step === 2 and state.botName">
              <p class="cc-ok"><span class="ic ic-check"/>
                 <span>Connected to <t t-esc="state.botName"/></span></p>
            </t>

            <!-- ===== Telegram: waiting for the first message ===== -->
            <t t-if="isTelegram and state.step === 3">
              <p class="cc-wait" t-if="openCard and !openCard.last_inbound_at">
                <span class="ic ic-clock"/> Waiting for your first message…
              </p>
              <p class="cc-ok"
                 t-if="openCard and openCard.last_inbound_at and openCard.state !== 'ready'">
                <span class="ic ic-check"/>
                <span>We received your message. Send a reply to finish.</span>
              </p>
              <p class="cc-ok" t-if="openCard and openCard.state === 'ready'">
                <span class="ic ic-check"/>
                <span>Telegram is connected. New messages arrive in Care Command.</span>
              </p>
            </t>

            <!-- ===== Zalo: sign in with the provider ===== -->
            <t t-if="isZalo and state.step === 0">
              <p class="cc-wait" t-if="state.popupBlocked">
                <span class="ic ic-clock"/>
                <span>Your browser blocked the sign-in window.</span>
              </p>
              <p t-if="state.popupBlocked and state.authUrl">
                <a class="cc-link" t-att-href="state.authUrl"
                   target="_blank" rel="noopener noreferrer">Open the Zalo sign-in page</a>
              </p>
              <p class="cc-ok" t-if="state.hasCredentials">
                <span class="ic ic-check"/>
                <span>Signed in<t t-if="openCard and openCard.resource_line">
                  — <t t-esc="openCard.resource_line"/></t></span>
              </p>
            </t>

            <!-- ===== Zalo: the portal-guided webhook checklist ===== -->
            <t t-if="isZalo and state.step === 1">
              <label class="cc-label" for="cc_zalo_hook">Webhook address</label>
              <textarea id="cc_zalo_hook" class="cc-input area mono" rows="2"
                        readonly="readonly"
                        aria-label="Webhook address"><t t-esc="state.webhookUrl"/></textarea>
              <div class="cc-row">
                <button class="cc-btn ghost" t-on-click="copyWebhookUrl">
                  <span class="ic" t-att-class="state.copiedWebhook ? 'ic-check' : 'ic-copy'"/>
                  <span t-if="state.copiedWebhook">Copied ✓</span>
                  <span t-if="!state.copiedWebhook">Copy</span>
                </button>
              </div>
              <label class="cc-label" for="cc_zalo_secret">Webhook secret</label>
              <input id="cc_zalo_secret" type="password" class="cc-input"
                     autocomplete="off" spellcheck="false"
                     t-model="state.webhookSecret"/>
              <p class="cc-help">Zalo shows this on the same page as the webhook address. It is stored encrypted and never shown again.</p>
              <p class="cc-ok" t-if="state.hasWebhookSecret and !state.webhookSecret">
                <span class="ic ic-check"/><span>A secret is already saved.</span>
              </p>
            </t>

            <!-- ===== Zalo: waiting for Zalo to confirm ===== -->
            <t t-if="isZalo and state.step === 2">
              <p class="cc-wait" t-if="openCard and !openCard.last_inbound_at">
                <span class="ic ic-clock"/> Waiting for Zalo to confirm…
              </p>
              <p class="cc-ok" t-if="openCard and openCard.last_inbound_at">
                <span class="ic ic-check"/>
                <span>We received a message from Zalo.</span>
              </p>
            </t>

            <!-- ===== Zalo: the synthetic test reply ===== -->
            <t t-if="isZalo and state.step === 3">
              <p class="cc-ok" t-if="openCard and openCard.state === 'ready'">
                <span class="ic ic-check"/>
                <span>Zalo is connected. New messages arrive in Care Command.</span>
              </p>
              <t t-if="znsCard and znsCard.zns">
                <div class="cc-sub">
                  <div class="cc-sub-head">
                    <span class="ic ic-send"/>
                    <span class="cc-sub-name" t-esc="znsCard.label"/>
                  </div>
                  <p class="cc-sub-line" t-esc="znsCard.zns.note"/>
                  <p class="cc-sub-line" t-esc="znsCard.zns.proof"/>
                </div>
              </t>
            </t>

            <!-- ===== Meta: sign in (ES popup for WA, FLB popup for FB) ===== -->
            <t t-if="isMeta and state.step === 0">
              <p class="cc-wait" t-if="state.metaSdkBlocked">
                <span class="ic ic-clock"/>
                <span>This needs Meta's own sign-in window, and your browser blocked it. Allow pop-ups for this site, or try another browser, then start again.</span>
              </p>
              <p class="cc-wait" t-if="state.popupBlocked and !state.metaSdkBlocked">
                <span class="ic ic-clock"/>
                <span>Your browser blocked the sign-in window.</span>
              </p>
              <p t-if="state.popupBlocked and state.authUrl">
                <a class="cc-link" t-att-href="state.authUrl"
                   target="_blank" rel="noopener noreferrer">Open the Facebook sign-in page</a>
              </p>
              <p class="cc-ok" t-if="state.hasCredentials">
                <span class="ic ic-check"/>
                <span>Signed in<t t-if="openCard and openCard.resource_line">
                  — <t t-esc="openCard.resource_line"/></t></span>
              </p>
              <div class="cc-alert warn" t-if="state.metaMissingScopes.length">
                <p>Meta did not grant everything Health19 needs. Ask whoever administers your Meta account for:</p>
                <ul>
                  <t t-foreach="state.metaMissingScopes" t-as="sc" t-key="sc">
                    <li t-esc="sc"/>
                  </t>
                </ul>
              </div>
              <div class="cc-alert warn"
                   t-if="scopesFailed and !state.metaMissingScopes.length">
                <p>Meta did not grant everything Health19 needs. Sign in again and allow every permission it asks for.</p>
              </div>
            </t>

            <!-- ===== Meta: choose a number / a Page ===== -->
            <t t-if="isMeta and state.step === 1">
              <p class="cc-wait" t-if="state.metaLoadingResources">
                <span class="ic ic-clock"/> Reading your Meta accounts…
              </p>
              <div class="cc-alert bad" role="alert"
                   t-if="state.metaResourceError" t-esc="state.metaResourceError"/>
              <p class="cc-help"
                 t-if="!state.metaLoadingResources and !state.metaResources.length and !state.metaResourceError">
                Meta returned nothing to choose from yet. Finish the sign-in, then try again.
              </p>
              <ul class="cc-picker" t-if="state.metaResources.length">
                <t t-foreach="state.metaResources" t-as="res" t-key="res.id">
                  <li>
                    <label>
                      <input type="radio" name="cc_meta_resource"
                             t-att-value="res.id"
                             t-att-checked="state.metaSelected === res.id"
                             t-on-change="() => this.pickMetaResource(res.id)"/>
                      <span class="cc-pick-name" t-esc="res.name"/>
                    </label>
                  </li>
                </t>
              </ul>
            </t>

            <!-- ===== Meta: we set things up ===== -->
            <t t-if="isMeta and state.step === 2">
              <p class="cc-res" t-if="openCard and openCard.resource_line"
                 t-esc="openCard.resource_line"/>
              <p class="cc-ok"
                 t-if="openCard and openCard.state !== 'select_resource' and openCard.state !== 'authorizing' and openCard.state !== 'configuring'">
                <span class="ic ic-check"/>
                <span>Meta is sending your messages to Health19.</span>
              </p>
            </t>

            <!-- ===== Meta: test + the approvals that are not ours ===== -->
            <t t-if="isMeta and state.step === 3">
              <p class="cc-wait" t-if="openCard and !openCard.last_inbound_at">
                <span class="ic ic-clock"/> Waiting for your first message…
              </p>
              <p class="cc-ok" t-if="openCard and openCard.state === 'ready'">
                <span class="ic ic-check"/>
                <span>Connected. New messages arrive in Care Command.</span>
              </p>
              <div class="cc-sub" t-if="state.approvals.length">
                <div class="cc-sub-head">
                  <span class="ic ic-clock"/>
                  <span class="cc-sub-name">Waiting on Meta</span>
                </div>
                <t t-foreach="state.approvals" t-as="ap" t-key="ap.key">
                  <p class="cc-sub-line" t-att-class="'st-' + ap.status">
                    <strong t-esc="ap.label"/>: <t t-esc="ap.message"/>
                  </p>
                </t>
              </div>
            </t>

            <!-- ===== Web chat: origins ===== -->
            <t t-if="isWebchat and state.step === 0">
              <label class="cc-label" for="cc_origins">Website addresses</label>
              <textarea id="cc_origins" class="cc-input area" rows="3"
                        placeholder="https://vietuc.vn"
                        t-model="state.origins"/>
              <p class="cc-help">One per line. Only these websites may show the chat bubble.</p>
              <label class="cc-label" for="cc_greeting">First message (optional)</label>
              <input id="cc_greeting" type="text" class="cc-input"
                     placeholder="Xin chào! Chúng tôi có thể giúp gì?"
                     t-model="state.greeting"/>
            </t>

            <!-- ===== Web chat: the snippet ===== -->
            <t t-if="isWebchat and state.step === 1">
              <!-- The snippet is TEXT inside the textarea, never markup in the
                   arch: an escaped <script> written into a template is served
                   as a live element (ledger §5.64). -->
              <textarea class="cc-input area mono" rows="3" readonly="readonly"
                        aria-label="Embed snippet"><t t-esc="state.snippet"/></textarea>
              <div class="cc-row">
                <button class="cc-btn ghost" t-on-click="copySnippet">
                  <span class="ic" t-att-class="state.copied ? 'ic-check' : 'ic-copy'"/>
                  <span t-if="state.copied">Copied ✓</span>
                  <span t-if="!state.copied">Copy</span>
                </button>
                <a t-if="state.demoUrl" class="cc-link" t-att-href="state.demoUrl"
                   target="_blank" rel="noopener noreferrer">Open the demo page</a>
              </div>
            </t>

            <!-- ===== Web chat: verify installation ===== -->
            <t t-if="isWebchat and state.step === 2">
              <p class="cc-wait" t-if="openCard and !openCard.last_inbound_at">
                <span class="ic ic-clock"/> Waiting for the first message…
              </p>
              <p class="cc-ok" t-if="openCard and openCard.last_inbound_at">
                <span class="ic ic-check"/>
                <span>Web chat is working. Messages appear in Care Command.</span>
              </p>
            </t>

            <!-- ===== Email: the mailbox, then the provider's own sign-in ===== -->
            <t t-if="isEmail and state.step === 0">
              <label class="cc-label" for="cc_mailbox">Mailbox address</label>
              <input id="cc_mailbox" type="email" class="cc-input"
                     autocomplete="off" spellcheck="false"
                     placeholder="lienhe@vietuc.vn"
                     t-model="state.mailbox"/>
              <ul class="cc-picker" t-if="state.emailProviders.length > 1">
                <t t-foreach="state.emailProviders" t-as="prov" t-key="prov.key">
                  <li>
                    <label>
                      <input type="radio" name="cc_email_provider"
                             t-att-value="prov.key"
                             t-att-disabled="!prov.available"
                             t-att-checked="state.emailProvider === prov.key"
                             t-on-change="() => this.pickEmailProvider(prov.key)"/>
                      <span class="cc-pick-name" t-esc="prov.label"/>
                    </label>
                  </li>
                </t>
              </ul>
              <p class="cc-wait" t-if="state.popupBlocked">
                <span class="ic ic-clock"/>
                <span>Your browser blocked the sign-in window.</span>
              </p>
              <p t-if="state.popupBlocked and state.authUrl">
                <a class="cc-link" t-att-href="state.authUrl"
                   target="_blank" rel="noopener noreferrer">Open the sign-in page</a>
              </p>
              <p class="cc-ok" t-if="state.emailSignedIn">
                <span class="ic ic-check"/>
                <span>Signed in<t t-if="state.mailbox"> — <t t-esc="state.mailbox"/></t></span>
              </p>
            </t>

            <!-- ===== Email: confirm the mailbox ===== -->
            <t t-if="isEmail and state.step === 1">
              <p class="cc-res" t-if="state.mailbox" t-esc="state.mailbox"/>
              <p class="cc-wait" t-if="!state.emailSignedIn">
                <span class="ic ic-clock"/>
                <span>We have not seen the sign-in finish yet. Check again, or
                      start it once more.</span>
              </p>
              <p class="cc-ok" t-if="state.emailSignedIn">
                <span class="ic ic-check"/>
                <span>Replies from Care Command will come from this address.</span>
              </p>
            </t>

            <!-- ===== Email: the round trip ===== -->
            <t t-if="isEmail and state.step === 2">
              <p class="cc-wait" t-if="openCard and !openCard.last_inbound_at">
                <span class="ic ic-clock"/>
                <span>Waiting for the first message to arrive…</span>
              </p>
              <p class="cc-ok" t-if="openCard and openCard.state === 'ready'">
                <span class="ic ic-check"/>
                <span>Email is connected. New messages arrive in Care Command.</span>
              </p>
            </t>

            <!-- ===== Calls: the account id ===== -->
            <t t-if="isCall and state.step === 0">
              <div class="cc-alert warn" t-if="state.callNotice">
                <p t-esc="state.callNotice"/>
              </div>
              <label class="cc-label" for="cc_call_account">Account name</label>
              <input id="cc_call_account" type="text" class="cc-input"
                     autocomplete="off" spellcheck="false"
                     t-model="state.callAccountId"/>
            </t>

            <!-- ===== Calls: the portal-guided webhook checklist ===== -->
            <t t-if="isCall and state.step === 1">
              <label class="cc-label" for="cc_call_hook">Webhook address</label>
              <textarea id="cc_call_hook" class="cc-input area mono" rows="2"
                        readonly="readonly"
                        aria-label="Webhook address"><t t-esc="state.webhookUrl"/></textarea>
              <div class="cc-row">
                <button class="cc-btn ghost" t-on-click="copyWebhookUrl">
                  <span class="ic" t-att-class="state.copiedWebhook ? 'ic-check' : 'ic-copy'"/>
                  <span t-if="state.copiedWebhook">Copied ✓</span>
                  <span t-if="!state.copiedWebhook">Copy</span>
                </button>
              </div>
              <label class="cc-label" for="cc_call_secret">Webhook secret</label>
              <input id="cc_call_secret" type="password" class="cc-input"
                     autocomplete="off" spellcheck="false"
                     t-model="state.callSecret"/>
              <p class="cc-help">Without this we cannot tell a real call event from a forged one, so we refuse every event. It is stored encrypted and never shown again.</p>
              <p class="cc-ok" t-if="state.hasCallSecret and !state.callSecret">
                <span class="ic ic-check"/><span>A secret is already saved.</span>
              </p>
            </t>

            <!-- ===== Calls: wait for a real call ===== -->
            <t t-if="isCall and state.step === 2">
              <p class="cc-wait" t-if="openCard and !openCard.last_inbound_at">
                <span class="ic ic-clock"/> Waiting for a call…
              </p>
              <p class="cc-ok" t-if="openCard and openCard.last_inbound_at">
                <span class="ic ic-check"/>
                <span>We received a call event.</span>
              </p>
              <div class="cc-alert warn" t-if="state.callNotice">
                <p t-esc="state.callNotice"/>
              </div>
            </t>
          </div>
        </div>

        <footer t-if="!state.manage" class="cc-modal-foot">
          <button class="cc-btn ghost" t-if="state.step &gt; 0"
                  t-att-disabled="state.busy" t-on-click="back">Back</button>

          <!-- Telegram -->
          <button t-if="isTelegram and state.step === 0"
                  class="cc-btn primary" t-on-click="next">I have my key</button>
          <button t-if="isTelegram and state.step === 1"
                  class="cc-btn primary" t-att-disabled="state.busy or !state.token"
                  t-on-click="validateToken">Check the key</button>
          <button t-if="isTelegram and state.step === 2"
                  class="cc-btn primary" t-att-disabled="state.busy"
                  t-on-click="registerWebhook">Connect</button>
          <button t-if="isTelegram and state.step === 3 and !(openCard and openCard.state === 'ready')"
                  class="cc-btn primary"
                  t-att-disabled="state.busy or !(openCard and openCard.last_inbound_at)"
                  t-on-click="sendTest">Send a reply</button>
          <button t-if="isTelegram and state.step === 3 and openCard and openCard.state === 'ready'"
                  class="cc-btn primary" t-on-click="closeStepper">Done</button>

          <!-- Zalo -->
          <button t-if="isZalo and state.step === 0 and !state.hasCredentials"
                  class="cc-btn primary" t-att-disabled="state.busy"
                  t-on-click="authorizeZalo">Sign in with Zalo</button>
          <button t-if="isZalo and state.step === 0 and state.hasCredentials"
                  class="cc-btn primary" t-on-click="next">Next</button>
          <button t-if="isZalo and state.step === 1"
                  class="cc-btn primary"
                  t-att-disabled="state.busy or !state.webhookSecret"
                  t-on-click="saveZaloSecret">Save the secret</button>
          <button t-if="isZalo and state.step === 1 and state.hasWebhookSecret and !state.webhookSecret"
                  class="cc-btn ghost" t-on-click="next">Skip</button>
          <button t-if="isZalo and state.step === 2"
                  class="cc-btn primary"
                  t-att-disabled="state.busy or !(openCard and openCard.last_inbound_at)"
                  t-on-click="next">Next</button>
          <button t-if="isZalo and state.step === 3 and !(openCard and openCard.state === 'ready')"
                  class="cc-btn primary" t-att-disabled="state.busy"
                  t-on-click="sendTest">Send a reply</button>
          <button t-if="isZalo and state.step === 3 and openCard and openCard.state === 'ready'"
                  class="cc-btn primary" t-on-click="closeStepper">Done</button>

          <!-- Meta (WhatsApp Embedded Signup + Messenger FLB) -->
          <button t-if="isMeta and state.step === 0 and !state.hasCredentials"
                  class="cc-btn primary" t-att-disabled="state.busy"
                  t-on-click="startMeta">
            <t t-if="isWhatsApp">Sign in with Meta</t>
            <t t-if="isMessenger">Sign in with Facebook</t>
          </button>
          <button t-if="isMeta and state.step === 0 and state.hasCredentials"
                  class="cc-btn primary" t-on-click="next">Next</button>
          <button t-if="isMeta and state.step === 1"
                  class="cc-btn ghost" t-att-disabled="state.busy"
                  t-on-click="loadMetaResources">Refresh the list</button>
          <button t-if="isMeta and state.step === 1"
                  class="cc-btn primary"
                  t-att-disabled="state.busy or !state.metaSelected"
                  t-on-click="selectMetaResource">Use this one</button>
          <button t-if="isMeta and state.step === 2"
                  class="cc-btn primary" t-att-disabled="state.busy"
                  t-on-click="subscribeMeta">Connect</button>
          <button t-if="isMeta and state.step === 3 and !(openCard and openCard.state === 'ready')"
                  class="cc-btn primary"
                  t-att-disabled="state.busy or !(openCard and openCard.last_inbound_at)"
                  t-on-click="sendTest">Send a reply</button>
          <button t-if="isMeta and state.step === 3 and openCard and openCard.state === 'ready'"
                  class="cc-btn primary" t-on-click="closeStepper">Done</button>

          <!-- Email -->
          <button t-if="isEmail and state.step === 0 and !state.emailSignedIn"
                  class="cc-btn primary"
                  t-att-disabled="state.busy or !state.mailbox"
                  t-on-click="startEmail">Sign in to this mailbox</button>
          <button t-if="isEmail and state.step === 0 and state.emailSignedIn"
                  class="cc-btn primary" t-on-click="next">Next</button>
          <button t-if="isEmail and state.step === 1 and !state.emailSignedIn"
                  class="cc-btn ghost" t-att-disabled="state.busy"
                  t-on-click="refreshEmailStatus">Check again</button>
          <button t-if="isEmail and state.step === 1 and state.emailSignedIn"
                  class="cc-btn primary" t-on-click="next">Next</button>
          <button t-if="isEmail and state.step === 2 and !(openCard and openCard.state === 'ready')"
                  class="cc-btn primary" t-att-disabled="state.busy"
                  t-on-click="sendTest">Send a test</button>
          <button t-if="isEmail and state.step === 2 and openCard and openCard.state === 'ready'"
                  class="cc-btn primary" t-on-click="closeStepper">Done</button>

          <!-- Calls (receive only — there is deliberately no "test" button:
               we have no verified VoIP24h endpoint to test against) -->
          <button t-if="isCall and state.step === 0"
                  class="cc-btn primary"
                  t-att-disabled="state.busy or !state.callAccountId"
                  t-on-click="next">Next</button>
          <button t-if="isCall and state.step === 1"
                  class="cc-btn primary"
                  t-att-disabled="state.busy or !(state.callSecret or state.hasCallSecret)"
                  t-on-click="saveCallSetup">Save</button>
          <button t-if="isCall and state.step === 2"
                  class="cc-btn primary" t-on-click="closeStepper">Done</button>

          <!-- Web chat -->
          <button t-if="isWebchat and state.step === 0"
                  class="cc-btn primary" t-att-disabled="state.busy"
                  t-on-click="enableWebchat">Turn on web chat</button>
          <button t-if="isWebchat and state.step === 1"
                  class="cc-btn primary" t-on-click="next">Next</button>
          <button t-if="isWebchat and state.step === 2"
                  class="cc-btn primary" t-on-click="closeStepper">Done</button>
        </footer>

        <div t-if="state.toast" class="cc-toast" t-esc="state.toast"/>
      </div>
    </div>
  </div>
</t>

</templates>
