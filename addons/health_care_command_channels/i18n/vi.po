msgstr "Khoá bí mật không được để trống."

#. module: health_care_command_channels
#. odoo-python
#: code:addons/health_care_command_channels/models/channel_platform_app.py:0
msgid "Secret stored"
msgstr "Đã lưu khoá bí mật"

#. module: health_care_command_channels
#. odoo-python
#: code:addons/health_care_command_channels/models/channel_platform_app.py:0
msgid ""
"The platform application secret is encrypted at rest and will never be "
"displayed again."
msgstr ""
"Khoá bí mật của ứng dụng nền tảng được mã hoá khi lưu trữ và sẽ không bao giờ "
"hiển thị lại."

#. module: health_care_command_channels
#. odoo-python
#: code:addons/health_care_command_channels/models/care_channel_connection.py:0
msgid ""
"Channel connection fields are maintained by the Channel Center, not by direct "
