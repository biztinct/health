#. module: health_care_command_channels
#. odoo-python
#: code:addons/health_care_command_channels/models/channel_platform_app.py:0
msgid "Only a platform administrator can set a platform application secret."
msgstr ""
"Chỉ quản trị viên nền tảng mới được đặt khoá bí mật của ứng dụng nền tảng."

#. module: health_care_command_channels
#. odoo-python
#: code:addons/health_care_command_channels/models/channel_platform_app.py:0
