#. odoo-python
#: code:addons/health_care_command_channels/models/channel_platform_app.py:0
msgid "Extra configuration must be valid JSON."
msgstr "Cấu hình bổ sung phải là JSON hợp lệ."

#. module: health_care_command_channels
#. odoo-python
#: code:addons/health_care_command_channels/models/channel_platform_app.py:0
