#. module: health_care_command_channels
#. odoo-python
#: code:addons/health_care_command_channels/models/care_channel_audit.py:0
msgid ""
"Channel audit entries are append-only operational evidence and can never be "
"modified or deleted."
msgstr ""
"Nhật ký kênh là bằng chứng vận hành chỉ ghi thêm, không thể sửa hoặc xoá."

#. module: health_care_command_channels
#. odoo-python
#: code:addons/health_care_command_channels/models/channel_platform_app.py:0
msgid ""
"An active platform application already exists for this provider. Archive it "
"before creating another."
msgstr ""
"Đã có ứng dụng nền tảng đang hoạt động cho nhà cung cấp này. Hãy lưu trữ nó "
"trước khi tạo cái mới."

