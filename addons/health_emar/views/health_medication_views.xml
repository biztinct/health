<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- health_base ships a health.medication model but its view file is
         not wired into that module's manifest (no medication view xmlids
         exist in the DB), so health_emar defines standalone catalog views
         instead of inheriting (spec 3.2.1 coding fields included). -->
    <record id="view_health_medication_form_emar" model="ir.ui.view">
        <field name="name">health.medication.form.emar</field>
        <field name="model">health.medication</field>
        <field name="arch" type="xml">
            <form string="Medication">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Medication name"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="generic_name"/>
                            <field name="brand_name"/>
                            <field name="medication_class"/>
                            <field name="active"/>
                        </group>
                        <group string="eMAR Coding" name="emar_coding">
                            <field name="rxnorm_code"/>
                            <field name="form"/>
                            <field name="strength"/>
                            <field name="dav_reg_no"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_health_medication_list_emar" model="ir.ui.view">
        <field name="name">health.medication.list.emar</field>
        <field name="model">health.medication</field>
        <field name="arch" type="xml">
            <list string="Medications">
                <field name="name"/>
                <field name="generic_name" optional="show"/>
                <field name="rxnorm_code" optional="show"/>
                <field name="form" optional="show"/>
                <field name="strength" optional="show"/>
                <field name="medication_class" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_health_medication_search_emar" model="ir.ui.view">
        <field name="name">health.medication.search.emar</field>
        <field name="model">health.medication</field>
        <field name="arch" type="xml">
            <search string="Medications">
                <field name="name"/>
                <field name="generic_name"/>
                <field name="rxnorm_code"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_health_medication_emar" model="ir.actions.act_window">
        <field name="name">Medication Catalog</field>
        <field name="res_model">health.medication</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_health_medication_list_emar"/>
        <field name="search_view_id" ref="view_health_medication_search_emar"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a medication</p>
            <p>Catalog entries carry RxNorm and DAV coding used by eMAR orders.</p>
        </field>
    </record>

</odoo>
