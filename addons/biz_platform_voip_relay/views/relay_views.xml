<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Customers served by the relay                                -->
    <!-- ============================================================ -->
    <record id="view_voip_relay_tenant_list" model="ir.ui.view">
        <field name="name">voip.relay.tenant.list</field>
        <field name="model">voip.relay.tenant</field>
        <field name="arch" type="xml">
            <list string="Customer phone relay" create="0"
                  decoration-muted="not active"
                  decoration-danger="last_error">
                <field name="slug"/>
                <field name="name"/>
                <field name="host"/>
                <field name="receiver_count"/>
                <field name="hotline_count"/>
                <field name="in_step" widget="boolean_toggle" readonly="1"/>
                <field name="last_forward_at"/>
                <field name="pending_count"/>
                <field name="last_error" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_voip_relay_tenant_form" model="ir.ui.view">
        <field name="name">voip.relay.tenant.form</field>
        <field name="model">voip.relay.tenant</field>
        <field name="arch" type="xml">
            <form string="Customer phone relay" create="0">
                <header>
                    <button name="action_sync_now" type="object"
                            string="Re-read the customers now"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"
                                   placeholder="Customer"/></h1>
                        <h3><field name="slug" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Where calls are handed to">
                            <field name="host" readonly="1"/>
                            <field name="in_step" readonly="1"/>
                            <field name="callback_base_pushed_at" readonly="1"/>
                        </group>
                        <group string="How it is going">
                            <field name="last_forward_at" readonly="1"/>
                            <field name="pending_count" readonly="1"/>
                            <field name="last_error" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Addresses and hotlines"
                              name="routes">
                            <div class="alert alert-info" role="status">
                                Call-back addresses are read from this
                                customer's own system every ten minutes and
                                cannot be edited here. Add a hotline number
                                only when several customers share one account
                                with the phone supplier, so that every call
                                arrives on the same address.
                            </div>
                            <field name="route_ids">
                                <list editable="bottom">
                                    <field name="kind"/>
                                    <field name="key"/>
                                    <field name="seen_at" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_voip_relay_tenant_search" model="ir.ui.view">
        <field name="name">voip.relay.tenant.search</field>
        <field name="model">voip.relay.tenant</field>
        <field name="arch" type="xml">
            <search string="Customer phone relay">
                <field name="slug"/>
                <field name="name"/>
                <filter name="filter_problem" string="Has a problem"
                        domain="[('last_error', '!=', False)]"/>
                <filter name="filter_not_in_step" string="Not set up yet"
                        domain="[('in_step', '=', False)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_voip_relay_tenant" model="ir.actions.act_window">
        <field name="name">Customer phone relay</field>
        <field name="res_model">voip.relay.tenant</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_voip_relay_tenant_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No customers are being served yet
            </p>
            <p>
                This platform hands each incoming call to the customer it
                belongs to, so the phone supplier only ever needs one address.
                Customers appear here on their own within ten minutes of going
                live.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Hand-offs waiting to be tried again                          -->
    <!-- ============================================================ -->
    <record id="view_voip_relay_delivery_list" model="ir.ui.view">
        <field name="name">voip.relay.delivery.list</field>
        <field name="model">voip.relay.delivery</field>
        <field name="arch" type="xml">
            <list string="Relay deliveries" create="0"
                  decoration-danger="state == 'dead'"
                  decoration-muted="state == 'delivered'">
                <field name="tenant_id"/>
                <field name="feed"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="next_at"/>
                <field name="delivered_at" optional="hide"/>
                <field name="last_error"/>
                <button name="action_retry_now" type="object"
                        string="Try this again" icon="fa-repeat"
                        invisible="state == 'delivered'"/>
            </list>
        </field>
    </record>

    <record id="view_voip_relay_delivery_search" model="ir.ui.view">
        <field name="name">voip.relay.delivery.search</field>
        <field name="model">voip.relay.delivery</field>
        <field name="arch" type="xml">
            <search string="Relay deliveries">
                <field name="tenant_id"/>
                <filter name="filter_pending" string="Waiting"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="filter_dead" string="Given up"
                        domain="[('state', '=', 'dead')]"/>
                <separator/>
                <!-- Group-by filters sit flat in the search, never wrapped in
                     a <group>: on Odoo 19 a search <group> may only contain
                     <field>, and `expand` is no longer an attribute of it.
                     Wrapping them fails the view's own schema check and takes
                     the whole module install down with it. -->
                <filter name="group_tenant" string="Customer"
                        context="{'group_by': 'tenant_id'}"/>
                <filter name="group_state" string="State"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_voip_relay_delivery" model="ir.actions.act_window">
        <field name="name">Relay deliveries</field>
        <field name="res_model">voip.relay.delivery</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_voip_relay_delivery_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Every call has reached the customer it belongs to
            </p>
            <p>
                A call only appears here when a customer's system could not be
                reached. It is tried again on its own, and the call itself is
                kept encrypted until it lands.
            </p>
        </field>
    </record>

</odoo>
