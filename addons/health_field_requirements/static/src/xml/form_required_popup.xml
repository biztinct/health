<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="health_field_requirements.MissingFieldsDialog">
        <Dialog title="this.t('Missing Required Fields')" size="'md'">
            <div class="fr-missing-dialog">

                <!-- Summary bar -->
                <div class="fr-missing-summary">
                    <div class="fr-missing-summary-icon">
                        <i class="fa fa-exclamation-triangle"/>
                    </div>
                    <div class="fr-missing-summary-text">
                        <strong><t t-esc="props.missingFields.length"/> <t t-esc="this.t('field(s)')"/></strong> <t t-esc="this.t('must be filled before saving.')"/>
                    </div>
                </div>

                <!-- Legend -->
                <div class="fr-missing-legend">
                    <t t-if="props.nativeCount > 0">
                        <span class="fr-legend-item">
                            <span class="fr-legend-dot fr-dot-native"/>
                            <t t-esc="this.t('Form Required')"/> (<t t-esc="props.nativeCount"/>)
                        </span>
                    </t>
                    <t t-if="props.configuredCount > 0">
                        <span class="fr-legend-item">
                            <span class="fr-legend-dot fr-dot-configured"/>
                            <t t-esc="this.t('Admin Configured')"/> (<t t-esc="props.configuredCount"/>)
                        </span>
                    </t>
                </div>

                <!-- Field list -->
                <div class="fr-missing-list">
                    <t t-foreach="props.missingFields" t-as="field" t-key="field.name">
                        <div class="fr-missing-item"
                             t-att-class="{'fr-item-native': field.source === 'native', 'fr-item-configured': field.source === 'configured'}">
                            <div class="fr-missing-item-left">
                                <i t-att-class="field.source === 'configured' ? 'fa fa-cog' : 'fa fa-asterisk'"
                                   class="fr-missing-item-icon"/>
                                <div class="fr-missing-item-info">
                                    <span class="fr-missing-item-label" t-esc="field.label"/>
                                    <span class="fr-missing-item-name" t-esc="field.name"/>
                                </div>
                            </div>
                            <span class="fr-missing-item-badge"
                                  t-att-class="field.source === 'configured' ? 'fr-badge-configured' : 'fr-badge-native'"
                                  t-esc="field.source === 'configured' ? this.t('Admin Rule') : this.t('Required')"/>
                        </div>
                    </t>
                </div>

            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="props.close">
                    <i class="fa fa-pencil me-1"/> <t t-esc="this.t('Go back and fill fields')"/>
                </button>
            </t>
        </Dialog>
    </t>

</templates>
