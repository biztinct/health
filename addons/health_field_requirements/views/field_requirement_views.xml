<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- List View — Main dashboard for all requirement rules         -->
    <!-- ============================================================ -->
    <record id="view_field_requirement_rule_list" model="ir.ui.view">
        <field name="name">field.requirement.rule.list</field>
        <field name="model">field.requirement.rule</field>
        <field name="arch" type="xml">
            <list string="Field Requirement Rules" editable="bottom">
                <field name="model_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="model_name" column_invisible="1"/>
                <field name="field_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="field_label" column_invisible="1"/>
                <field name="is_global"/>
                <field name="role_ids" widget="many2many_tags"
                       options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="state_values" string="Required in States"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Form View — Detailed editing of a single rule                -->
    <!-- ============================================================ -->
    <record id="view_field_requirement_rule_form" model="ir.ui.view">
        <field name="name">field.requirement.rule.form</field>
        <field name="model">field.requirement.rule</field>
        <field name="arch" type="xml">
            <form string="Field Requirement Rule">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group string="Target">
                            <field name="model_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="field_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="field_label" readonly="1"/>
                        </group>
                        <group string="Scope">
                            <field name="is_global"/>
                            <field name="role_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   invisible="is_global"/>
                            <field name="state_values"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Search View                                                  -->
    <!-- ============================================================ -->
    <record id="view_field_requirement_rule_search" model="ir.ui.view">
        <field name="name">field.requirement.rule.search</field>
        <field name="model">field.requirement.rule</field>
        <field name="arch" type="xml">
            <search string="Search Requirement Rules">
                <field name="model_id"/>
                <filter name="filter_global" string="Global Rules"
                        domain="[('is_global', '=', True)]"/>
                <filter name="filter_active" string="Active"
                        domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Action                                                       -->
    <!-- ============================================================ -->
    <record id="action_field_requirement_rules" model="ir.actions.act_window">
        <field name="name">Field Requirements</field>
        <field name="res_model">field.requirement.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure mandatory fields for your forms
            </p>
            <p>
                Add rules to make specific fields mandatory - globally or per role,
                always or only in certain states.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Client Action — Visual Dashboard                              -->
    <!-- ============================================================ -->
    <record id="action_field_requirements_dashboard" model="ir.actions.client">
        <field name="name">Field Requirements</field>
        <field name="tag">field_requirements_dashboard</field>
    </record>

</odoo>
