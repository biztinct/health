msgid "No patient to send a booking link to."
msgstr "Không có bệnh nhân để gửi link đặt lịch."

#. module: health_self_booking
msgid ""
"Cannot create a booking link: this client has no active package, no previous "
"booked service, and no fallback service product is configured."
msgstr ""
"Không thể tạo link đặt lịch: khách hàng này không có gói đang hoạt động, chưa "
"từng đặt dịch vụ, và chưa cấu hình dịch vụ mặc định."

#. module: health_self_booking
msgid "No usable phone for the patient."
msgstr "Không có số điện thoại hợp lệ cho bệnh nhân."

#. module: health_self_booking
msgid ""
"Khung giờ này không còn trống — vui lòng chọn giờ khác. (That time is no "
"longer available — please pick another.)"
msgstr ""
"Khung giờ này không còn trống — vui lòng chọn giờ khác."

