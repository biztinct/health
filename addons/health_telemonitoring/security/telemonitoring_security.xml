<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         Catchment province record rules (cloned in shape from
         health_vitals/security/health_vitals_security.xml:9-28).
         ===================================================================== -->

    <record id="rule_health_ews_score_catchment" model="ir.rule">
        <field name="name">NEWS2 Score: Healthcare users see own catchment</field>
        <field name="model_id" ref="model_health_ews_score"/>
        <field name="domain_force">['&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_nurse')), (4, ref('health_base.group_healthcare_head_nurse')), (4, ref('health_base.group_healthcare_doctor')), (4, ref('health_base.group_healthcare_operations_manager')), (4, ref('health_base.group_healthcare_manager'))]"/>
    </record>
    <record id="rule_health_ews_score_owner" model="ir.rule">
        <field name="name">NEWS2 Score: Owner sees all</field>
        <field name="model_id" ref="model_health_ews_score"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_owner'))]"/>
    </record>

    <record id="rule_health_monitor_alert_catchment" model="ir.rule">
        <field name="name">Deterioration Alert: Healthcare users see own catchment</field>
        <field name="model_id" ref="model_health_monitor_alert"/>
        <field name="domain_force">['&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_nurse')), (4, ref('health_base.group_healthcare_head_nurse')), (4, ref('health_base.group_healthcare_doctor')), (4, ref('health_base.group_healthcare_operations_manager')), (4, ref('health_base.group_healthcare_manager'))]"/>
    </record>
    <record id="rule_health_monitor_alert_owner" model="ir.rule">
        <field name="name">Deterioration Alert: Owner sees all</field>
        <field name="model_id" ref="model_health_monitor_alert"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_owner'))]"/>
    </record>

    <!-- =====================================================================
         Device registry — catchment + owner (Phase 2, same shape as above).
         ===================================================================== -->

    <record id="rule_health_monitor_device_catchment" model="ir.rule">
        <field name="name">Monitor Device: Healthcare users see own catchment</field>
        <field name="model_id" ref="model_health_monitor_device"/>
        <field name="domain_force">['&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_nurse')), (4, ref('health_base.group_healthcare_head_nurse')), (4, ref('health_base.group_healthcare_doctor')), (4, ref('health_base.group_healthcare_operations_manager')), (4, ref('health_base.group_healthcare_manager'))]"/>
    </record>
    <record id="rule_health_monitor_device_owner" model="ir.rule">
        <field name="name">Monitor Device: Owner sees all</field>
        <field name="model_id" ref="model_health_monitor_device"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_owner'))]"/>
    </record>

    <record id="rule_health_device_receipt_catchment" model="ir.rule">
        <field name="name">Device Receipt: Healthcare users see own catchment</field>
        <field name="model_id" ref="model_health_device_receipt"/>
        <field name="domain_force">['&amp;', ('device_id.catchment_province_id', '=', user.catchment_province_id.id), ('device_id.catchment_province_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_operations_manager')), (4, ref('health_base.group_healthcare_manager'))]"/>
    </record>
    <record id="rule_health_device_receipt_owner" model="ir.rule">
        <field name="name">Device Receipt: Owner sees all</field>
        <field name="model_id" ref="model_health_device_receipt"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_owner'))]"/>
    </record>

</odoo>
