<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_trend_sweep" model="ir.cron">
            <field name="name">Telemonitoring: nightly deterioration trend sweep</field>
            <field name="model_id" ref="model_health_monitor_alert"/>
            <field name="state">code</field>
            <field name="code">model.cron_trend_sweep()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=19, minute=30, second=0, microsecond=0))"/>
        </record>

        <record id="cron_device_receipt_gc" model="ir.cron">
            <field name="name">Telemonitoring: prune expired device ingestion receipts</field>
            <field name="model_id" ref="model_health_device_receipt"/>
            <field name="state">code</field>
            <field name="code">model.cron_gc_receipts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=0, second=0, microsecond=0))"/>
        </record>
    </data>
</odoo>
