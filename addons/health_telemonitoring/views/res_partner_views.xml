<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- NEWS2 SpO₂ Scale 2 flag on the patient form, inside the
         health_vitals "Alert Thresholds" page (its group gating applies). -->
    <record id="view_health_patient_form_telemonitoring" model="ir.ui.view">
        <field name="name">res.partner.health.patient.form.telemonitoring</field>
        <field name="model">res.partner</field>
        <field name="inherit_id"
               ref="health_vitals.view_health_patient_form_vitals"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='vitals_thresholds']/field[@name='vitals_threshold_ids']"
                   position="before">
                <group>
                    <field name="news2_spo2_scale2"/>
                </group>
            </xpath>
            <!-- Home-device registry tab (Phase 2). -->
            <xpath expr="//page[@name='vitals_thresholds']" position="after">
                <page name="monitor_devices" string="Monitoring Devices"
                      invisible="not is_patient">
                    <field name="monitor_device_ids"
                           context="{'default_client_id': id}">
                        <list string="Monitoring Devices"
                              decoration-muted="state == 'retired'"
                              decoration-warning="state == 'suspended'">
                            <field name="name"/>
                            <field name="device_type_id" widget="badge"/>
                            <field name="external_id"/>
                            <field name="vendor" optional="hide"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'active'"
                                   decoration-warning="state == 'suspended'"
                                   decoration-muted="state == 'retired'"/>
                            <field name="last_reading_at"/>
                            <field name="reading_count"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
