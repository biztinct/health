                            <circle class="cjx-jdot" cx="234.7" cy="-70" r="9.2"/>
                        </svg>
                    </div>
                    <div class="vu-rail-brandsub">CMS</div>
                </div>
                <button type="button" class="vu-rail-toggle vu-rail-label"
                        t-att-title="railToggleLabel"
                        t-att-aria-label="railToggleLabel"
                        t-att-aria-pressed="isCollapsed ? 'false' : 'true'"
                        t-on-click.stop="toggleRail">
                    <i t-attf-class="fa #{isCollapsed ? 'fa-angle-double-right' : 'fa-angle-double-left'}"/>
                </button>
            </div>

            <nav class="vu-rail-nav" aria-label="Areas" t-if="state.loaded"
                 t-on-keydown="onListKeydown">
                <t t-foreach="mainEntries" t-as="section" t-key="section.key">
                    <t t-call="health_cms_sidebar.RailEntry"/>
                </t>
                <div class="vu-rail-spacer"/>
                <t t-foreach="footEntries" t-as="section" t-key="section.key">
                    <t t-call="health_cms_sidebar.RailEntry"/>
                </t>
            </nav>

            <div class="vu-rail-user" t-att-title="currentUserName">
                <div class="vu-rail-avatar" t-esc="currentUserInitials"/>
                <div class="vu-rail-usertext vu-rail-label">
                    <div class="vu-rail-username" t-esc="currentUserName"/>
                    <div class="vu-rail-userrole">Viet UC CMS</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- ========================================================== tab column -->
    <!-- Drawn as an empty, fixed-width shell for the remembered section until
         the menu is read, so the page beside it never slides sideways. -->
    <nav class="vu-tabcol" t-ref="tabcol" t-if="showTabColumn"
         t-att-aria-label="activeSection ? railLabel(activeSection.name) : undefined"
         t-att-data-section="state.activeSectionKey"
         t-att-lang="langTag"
         t-on-keydown="onListKeydown">
        <t t-foreach="activeSection ? activeSection.items : []" t-as="item" t-key="item.id">
            <button type="button" data-nav="1"
                    t-att-class="{'vu-tab': true, 'is-active': isTabActive(item), 'has-children': item.children.length}"
                    t-att-data-item-id="item.id"
                    t-att-data-action="item.action_xmlid or item.action_tag"
                    t-att-title="item.name"
                    t-att-aria-current="isTabActive(item) ? 'page' : undefined"
                    t-on-click="() => this.openTab(item)">
                <i t-att-class="'vu-tab-icon ' + (item.icon or 'fa fa-circle-o')" aria-hidden="true"/>
                <span class="vu-tab-label" t-esc="item.name"/>
            </button>
        </t>
    </nav>

    <!-- ========================================================= page header -->
    <!-- Always drawn (a fixed 40px): the page below it must never move down
         when the menu is read. Its contents wait for the data. -->
    <header class="vu-pagehead">
        <button type="button" class="vu-pagehead-menu" title="Menu" aria-label="Menu"
                t-att-aria-expanded="state.sheetOpen ? 'true' : 'false'"
                t-on-click="toggleSheet">
            <i class="fa fa-bars" aria-hidden="true"/>
        </button>

        <!-- Catchment scope. A label for staff, a picker for owners — the
             server decides which by never sending options to anyone else. The
             picker stays a plain native select on purpose (§5.96). -->
        <div class="vu-catchment" title="Catchment Area" t-if="state.loaded">
            <span class="vu-catchment-label">Catchment Area</span>
            <t t-if="state.catchment.can_switch">
                <select class="vu-catchment-select" aria-label="Catchment Area"
                        t-on-change="onCatchmentChange">
                    <option value="" t-att-selected="isCatchmentPicked('') or undefined"
                            t-esc="myAreaLabel"/>
                    <t t-foreach="state.catchment.options" t-as="opt" t-key="opt.id">
                        <option t-att-value="opt.id"
                                t-att-selected="isCatchmentPicked(opt.id) or undefined"
                                t-esc="opt.name"/>
                    </t>
                    <option value="all" t-att-selected="isCatchmentPicked('all') or undefined">
                        All areas
                    </option>
                </select>
            </t>
            <t t-else="">
                <span class="vu-catchment-pill">
                    <i class="fa fa-map-marker" aria-hidden="true"/> <t t-esc="state.catchment.current_name"/>
                </span>
            </t>
        </div>

        <div class="vu-crumbs" t-if="crumbs.length" aria-label="You are here">
            <t t-foreach="crumbs" t-as="crumb" t-key="crumb_index">
                <span t-if="crumb_index" class="vu-crumb-sep" aria-hidden="true">›</span>
                <span t-att-class="{'vu-crumb': true, 'is-last': crumb_last}" t-esc="crumb"/>
            </t>
        </div>

        <nav class="vu-segments" t-if="segments.length"
             t-att-aria-label="activeRoot.name"
             t-on-keydown="onListKeydown">
            <t t-foreach="segments" t-as="child" t-key="child.id">
                <button type="button" data-nav="1"
                        t-att-class="{'vu-segment': true, 'is-active': isSegmentActive(child)}"
                        t-att-data-item-id="child.id"
                        t-att-data-action="child.action_xmlid or child.action_tag"
                        t-att-aria-current="isSegmentActive(child) ? 'page' : undefined"
                        t-on-click="() => this.navigateTo(child)">
                    <t t-esc="child.name"/>
                </button>
            </t>
        </nav>
    </header>

    <!-- ============================================= phone: the tap-to-open list -->
    <div t-if="state.phone and state.sheetOpen" class="vu-sheet-scrim" t-on-click="closeSheet"/>
    <div t-if="state.phone" t-att-class="{'vu-sheet': true, 'is-open': state.sheetOpen}"
         t-att-aria-hidden="state.sheetOpen ? 'false' : 'true'">
        <nav class="vu-sheet-nav" aria-label="Areas" t-on-keydown="onListKeydown">
            <t t-foreach="railEntries" t-as="section" t-key="section.key">
                <button type="button" data-nav="1"
                        t-att-class="{'vu-sheet-entry': true, 'is-active': isRailActive(section)}"
                        t-att-aria-current="isRailActive(section) ? 'page' : undefined"
                        t-att-tabindex="state.sheetOpen ? undefined : '-1'"
                        t-on-click="() => this.onRailClick(section)">
                    <i t-att-class="section.icon or 'fa fa-circle-o'" aria-hidden="true"/>
                    <span t-esc="railLabel(section.name)"/>
                </button>
            </t>
        </nav>
    </div>
</t>

<t t-name="health_cms_sidebar.RailEntry">
    <button type="button" data-nav="1"
            t-att-class="{'vu-rail-entry': true, 'is-active': isRailActive(section), 'is-settings': section.key === 'admin'}"
            t-att-data-section="section.key"
            t-att-title="railTitle(section)"
            t-att-aria-current="isRailActive(section) ? 'page' : undefined"
            t-on-click="() => this.onRailClick(section)">
        <i t-att-class="'vu-rail-icon ' + (section.icon or 'fa fa-circle-o')" aria-hidden="true"/>
        <span class="vu-rail-label vu-rail-text" t-esc="railLabel(section.name)"/>
    </button>
</t>

</templates>
