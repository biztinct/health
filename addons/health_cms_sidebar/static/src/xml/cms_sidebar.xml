<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- THE MENU SHELL (MENU M1). Three siblings of the action, laid out by
     `.ops-layout-wrapper` as a grid: the rail (sections), the tab column (the
     active section's root entries) and the page header (catchment, where you
     are, and the active tab's children as segments). -->
<t t-name="health_cms_sidebar.CmsSidebar">
    <!-- ================================================================ rail -->
    <aside t-att-class="railClass"
           t-on-mouseenter="onRailEnter"
           t-on-mouseleave="onRailLeave"
           t-on-focusin="onRailFocusIn"
           t-on-focusout="onRailFocusOut">
        <div class="vu-rail-panel">
            <div class="vu-rail-brand">
                <!-- Carejiox "Care Pulse" mark (canonical copy:
                     health_theme/static/src/img/carejiox-mark.svg). Inline so
                     the dot can beat once per screen load — the "Quick" moment
                     of the loading language, triggered by body:has(.o_loading_indicator)
                     in cms_sidebar.scss. -->
                <button type="button" class="vu-rail-logo" title="Home" t-on-click="openHome">
                    <svg class="cjx-mark" viewBox="0 0 100 100" role="img" aria-label="Carejiox">
                        <path class="cjx-ring" d="M76.05 28.14A34 34 0 1 0 76.05 71.86"/>
                        <path class="cjx-pulse" d="M28 50H40L46 37L54 63L60 50H80"/>
                        <circle class="cjx-dot" cx="89" cy="50" r="6.5"/>
                    </svg>
                </button>
                <div class="vu-rail-brandtext vu-rail-label">
                    <!-- Wordmark as outlined paths (Montserrat Bold), so it never
                         depends on a font being installed. Same file as above. -->
                    <div class="vu-rail-brandname">
                        <svg class="cjx-word" viewBox="0 -82 402 106" role="img" aria-label="carejiox">
                            <path d="M33.20 0.80L33.20 0.80Q24.50 0.80 17.70-2.75Q10.90-6.30 7.05-12.55Q3.20-18.80 3.20-26.90L3.20-26.90Q3.20-35 7.05-41.25Q10.90-47.50 17.70-51.05Q24.50-54.60 33.20-54.60L33.20-54.60Q41.70-54.60 48-51.05Q54.30-47.50 57.30-40.90L57.30-40.90L45.20-34.40Q43.10-38.20 39.95-40Q36.80-41.80 33.10-41.80L33.10-41.80Q27.10-41.80 23.05-37.85Q19-33.90 19-26.90L19-26.90Q19-19.80 23.05-15.90Q27.10-12 33.10-12L33.10-12Q36.80-12 39.95-13.75Q43.10-15.50 45.20-19.40L45.20-19.40L57.30-12.80Q54.30-6.40 48-2.80Q41.70 0.80 33.20 0.80ZM111.90 0L97.30 0L97.30-6.60Q92.80 0.80 80.90 0.80L80.90 0.80Q71.40 0.80 66.10-3.85Q60.80-8.50 60.80-15.50L60.80-15.50Q60.80-22.60 66.20-27.10Q71.60-31.60 83.90-31.60L83.90-31.60L96.30-31.60L96.30-31.60Q96.30-36.60 93.25-39.40Q90.20-42.20 83.90-42.20L83.90-42.20Q79.60-42.20 75.45-40.85Q71.30-39.50 68.40-37.20L68.40-37.20L62.80-48.10Q67.20-51.20 73.40-52.90Q79.60-54.60 86-54.60L86-54.60Q98.30-54.60 105.10-48.75Q111.90-42.90 111.90-30.70L111.90-30.70L111.90 0ZM96.30-17L96.30-17L96.30-22.50L85.60-22.50Q80.10-22.50 78.05-20.70Q76-18.90 76-16.20L76-16.20Q76-13.20 78.35-11.45Q80.70-9.70 84.80-9.70L84.80-9.70Q88.70-9.70 91.80-11.55Q94.90-13.40 96.30-17ZM139.60 0L124.00 0L124.00-53.80L138.90-53.80L138.90-46.70Q144.60-54.60 157.40-54.60L157.40-54.60L157.40-40.20Q155.40-40.40 153.90-40.40L153.90-40.40Q147.40-40.40 143.50-36.75Q139.60-33.10 139.60-25.40L139.60-25.40L139.60 0ZM191.80 0.80L191.80 0.80Q182.50 0.80 175.60-2.80Q168.70-6.40 164.90-12.65Q161.10-18.90 161.10-26.90L161.10-26.90Q161.10-35 164.85-41.25Q168.60-47.50 175.10-51.05Q181.60-54.60 189.80-54.60L189.80-54.60Q197.70-54.60 204.05-51.20Q210.40-47.80 214.10-41.55Q217.80-35.30 217.80-26.70L217.80-26.70Q217.80-25.80 217.70-24.65Q217.60-23.50 217.50-22.50L217.50-22.50L176.80-22.50Q178-17.50 182.05-14.60Q186.10-11.70 192.20-11.70L192.20-11.70Q196.50-11.70 199.75-13Q203-14.30 205.70-16.90L205.70-16.90L214-7.90Q206.40 0.80 191.80 0.80ZM176.70-31.60L176.70-31.60L203.10-31.60Q202.30-3