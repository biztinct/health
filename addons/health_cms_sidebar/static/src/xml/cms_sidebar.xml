<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="health_cms_sidebar.CmsSidebar">
    <aside class="ops-global-sidebar cms-sidebar">
        <div class="ops-sidebar-logo" t-on-click="navigateHome" style="cursor:pointer">
            <div class="ops-logo-icon cms-logo-icon"><img class="ops-logo-img" src="/health_fieldservice/static/img/vu-hibiscus.png" alt="Viet UC"/></div>
            <div>
                <div class="ops-logo-text">VIET UC</div>
                <div class="ops-logo-sub">CMS</div>
            </div>
        </div>

        <!-- Catchment scope. A label for staff, a picker for owners — the
             server decides which by never sending options to anyone else. -->
        <div class="cms-catchment" t-if="state.loaded">
            <div class="cms-catchment-label">Catchment Area</div>
            <t t-if="state.catchment.can_switch">
                <select class="cms-catchment-select"
                        t-on-change="onCatchmentChange">
                    <option value="" t-att-selected="isCatchmentPicked('') or undefined">
                        My area (<t t-esc="state.catchment.current_name"/>)
                    </option>
                    <t t-foreach="state.catchment.options" t-as="opt" t-key="opt.id">
                        <option t-att-value="opt.id"
                                t-att-selected="isCatchmentPicked(opt.id) or undefined"
                                t-esc="opt.name"/>
                    </t>
                    <option value="all" t-att-selected="isCatchmentPicked('all') or undefined">
                        All areas
                    </option>
                </select>
            </t>
            <t t-else="">
                <div class="cms-catchment-pill">
                    <i class="fa fa-map-marker"/> <t t-esc="state.catchment.current_name"/>
                </div>
            </t>
        </div>

        <nav class="ops-sidebar-nav" t-if="state.loaded">
            <t t-foreach="state.sections" t-as="section" t-key="section.id">
                <div class="cms-section-header"
                     t-on-click="() => this.toggleSection(section.key)">
                    <span class="cms-section-label" t-esc="section.name"/>
                    <i t-attf-class="fa #{isSectionCollapsed(section.key) ? 'fa-chevron-right' : 'fa-chevron-down'} cms-chevron"/>
                </div>

                <t t-if="!isSectionCollapsed(section.key)">
                    <t t-foreach="section.items" t-as="item" t-key="item.id">
                        <a t-attf-class="ops-nav-item #{isActive(item.id) ? 'active' : ''} #{item.children.length ? 'cms-has-children' : ''}"
                           t-on-click="() => this.onItemClick(item)">
                            <i t-att-class="item.icon"/> <span class="cms-item-label" t-esc="item.name"/>
                            <i t-if="item.children.length"
                               t-attf-class="fa #{isExpanded(item.id) ? 'fa-chevron-down' : 'fa-chevron-right'} cms-item-chevron"/>
                        </a>
                        <t t-if="item.children.length and isExpanded(item.id)">
                            <t t-foreach="item.children" t-as="child" t-key="child.id">
                                <a t-attf-class="ops-nav-item cms-subitem #{isActive(child.id) ? 'active' : ''}"
                                   t-on-click="() => this.navigateTo(child)">
                                    <i t-att-class="child.icon"/> <t t-esc="child.name"/>
                                </a>
                            </t>
                        </t>
                    </t>
                </t>
            </t>
        </nav>

        <div class="ops-sidebar-user">
            <div class="ops-user-avatar" t-esc="currentUserInitials"/>
            <div class="ops-user-info">
                <div class="ops-user-name" t-esc="currentUserName"/>
                <div class="ops-user-role">Viet UC CMS</div>
            </div>
        </div>
    </aside>
</t>

</templates>
