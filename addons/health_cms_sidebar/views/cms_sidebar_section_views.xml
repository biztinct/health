<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cms_sidebar_section_view_tree" model="ir.ui.view">
        <field name="name">cms.sidebar.section.tree</field>
        <field name="model">cms.sidebar.section</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="technical_key"/>
                <field name="icon"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="cms_sidebar_section_view_form" model="ir.ui.view">
        <field name="name">cms.sidebar.section.form</field>
        <field name="model">cms.sidebar.section</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="technical_key"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="icon"/>
                            <field name="color"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Menu Items">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="icon"/>
                                    <field name="action_xmlid"/>
                                    <field name="action_tag"/>
                                    <field name="role_ids" widget="many2many_tags"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cms_sidebar_section" model="ir.actions.act_window">
        <field name="name">Sidebar Sections</field>
        <field name="res_model">cms.sidebar.section</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
