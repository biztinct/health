<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cms_sidebar_section_view_tree" model="ir.ui.view">
        <field name="name">cms.sidebar.section.tree</field>
        <field name="model">cms.sidebar.section</field>
        <field name="arch" type="xml">
            <list editable="bottom" js_class="admin_model_navigator_view">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="technical_key"/>
                <field name="icon"/>
                <!-- Set roles here to gate the WHOLE section; every item under
                     it inherits them (an item's own roles are added, not
                     replaced). See cms.sidebar.item._compute_effective_role_ids. -->
                <field name="role_ids" widget="many2many_tags"
                       options="{'no_create': True, 'no_quick_create': True}"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="cms_sidebar_section_view_form" model="ir.ui.view">
        <field name="name">cms.sidebar.section.form</field>
        <field name="model">cms.sidebar.section</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="technical_key"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="icon"/>
                            <field name="color"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Access Control">
                        <field name="role_ids" widget="many2many_tags"
                               options="{'no_create': True, 'no_quick_create': True}"/>
                        <div colspan="2" class="text-muted">
                            Roles set here gate the whole section. Every menu item
                            below inherits them; an item that lists roles of its own
                            is shown to those roles <b>in addition</b> to these.
                            Leave empty to gate item by item.
                        </div>
                    </group>
                    <notebook>
                        <page string="Menu Items">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="icon"/>
                                    <field name="action_xmlid"/>
                                    <field name="action_tag"/>
                                    <field name="role_ids" widget="many2many_tags"/>
                                    <field name="effective_role_ids" widget="many2many_tags"
                                           readonly="1" optional="show"
                                           string="Effective (incl. inherited)"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cms_sidebar_section" model="ir.actions.act_window">
        <field name="name">Sidebar Sections</field>
        <field name="res_model">cms.sidebar.section</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
