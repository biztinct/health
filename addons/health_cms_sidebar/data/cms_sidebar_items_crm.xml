<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="item_crm_dashboard" model="cms.sidebar.item">
        <field name="name">Dashboard</field>
        <field name="section_id" ref="section_crm"/>
        <field name="sequence">10</field>
        <field name="icon">fa fa-th-large</field>
        <field name="action_xmlid">health_crm.action_crm_dashboard</field>
        <field name="action_tag">crm_dashboard</field>
        <field name="match_action_tags">crm_dashboard</field>
    </record>

    <record id="item_crm_contacts" model="cms.sidebar.item">
        <field name="name">Contacts</field>
        <field name="section_id" ref="section_crm"/>
        <field name="sequence">20</field>
        <field name="icon">fa fa-phone</field>
        <field name="action_xmlid">health_crm.action_crm_contact_list_native</field>
        <field name="match_action_tags">crm_new_contact,crm_booking_wizard</field>
        <field name="match_action_xmlids">health_crm.action_crm_contact_list_native,health_crm.action_crm_contact_form_native</field>
        <field name="match_models">crm.lead</field>
    </record>

    <record id="item_crm_activities" model="cms.sidebar.item">
        <field name="name">Activities</field>
        <field name="section_id" ref="section_crm"/>
        <field name="sequence">50</field>
        <field name="icon">fa fa-tasks</field>
        <field name="action_xmlid">health_crm.action_crm_activity_list</field>
        <field name="match_action_xmlids">health_crm.action_crm_activity_list</field>
    </record>

</odoo>
