<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- =====================================================================
         Two new sidebar sections wiring the clinical spine + interop modules
         into the Viet UC CMS sidebar. Parent items act as expanders (their
         action is ignored on click); leaf items navigate via action_xmlid.
         Items are ungated (no role_ids) → visible to every sidebar user;
         the underlying module ACLs still protect the data.
         ===================================================================== -->

    <record id="section_clinical" model="cms.sidebar.section">
        <field name="name">CLINICAL</field>
        <field name="technical_key">clinical</field>
        <field name="sequence">32</field>
        <field name="icon">fa fa-stethoscope</field>
    </record>

    <record id="section_interop" model="cms.sidebar.section">
        <field name="name">INTEROP &amp; COMPLIANCE</field>
        <field name="technical_key">interop</field>
        <field name="sequence">35</field>
        <field name="icon">fa fa-exchange</field>
    </record>

    <!-- ================= CLINICAL ================= -->

    <!-- Vitals & Observations -->
    <record id="item_clin_vitals" model="cms.sidebar.item">
        <field name="name">Vitals &amp; Observations</field>
        <field name="section_id" ref="section_clinical"/>
        <field name="sequence">10</field>
        <field name="icon">fa fa-heartbeat</field>
    </record>
    <record id="item_clin_vitals_obs" model="cms.sidebar.item">
        <field name="name">Observations</field>
        <field name="section_id" ref="section_clinical"/>
        <field name="parent_id" ref="item_clin_vitals"/>
        <field name="sequence">11</field>
        <field name="icon">fa fa-heartbeat</field>
        <field name="action_xmlid">health_vitals.action_health_observation</field>
        <field name="match_action_xmlids">health_vitals.action_health_observation</field>
        <field name="match_models">health.observation</field>
    </record>
    <record id="item_clin_vitals_thresholds" model="cms.sidebar.item">
        <field name="name">Thresholds</field>
        <field name="section_id" ref="section_clinical"/>
        <field name="parent_id" ref="item_clin_vitals"/>
        <field name="sequence">12</field>
        <field name="icon">fa fa-sliders</field>
        <field name="action_xmlid">health_vitals.action_health_vitals_threshold</field>
        <field name="match_action_xmlids">health_vitals.action_health_vitals_threshold</field>
    </record>
    <record id="item_clin_vitals_types" model="cms.sidebar.item">
        <field name="name">Observation Types</field>
        <field name="section_id" ref="section_clinical"/>
        <field name="parent_id" ref="item_clin_vitals"/>
        <field name="sequence">13</field>
        <field name="icon">fa fa-list</field>
        <field name="action_xmlid">health_vitals.action_health_vitals_type</field>
        <field name="match_action_xmlids">health_vitals.action_health_vitals_type</field>
    </record>

    <!-- Care Plans -->
    <record id="item_clin_careplan" model="cms.sidebar.item">
