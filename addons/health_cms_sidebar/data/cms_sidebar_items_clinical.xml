        <field name="section_id" ref="section_clinical"/>
        <field name="sequence">20</field>
        <field name="icon">fa fa-clipboard</field>
        <field name="action_xmlid">health_careplan.action_health_careplan</field>
        <field name="match_action_xmlids">health_careplan.action_health_careplan</field>
        <field name="match_models">health.careplan</field>
    </record>

