<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="section_crm" model="cms.sidebar.section">
        <field name="name">CRM</field>
        <field name="technical_key">crm</field>
        <field name="sequence">10</field>
        <field name="icon">fa fa-comments</field>
    </record>

    <record id="section_ops" model="cms.sidebar.section">
        <field name="name">OPERATIONS MANAGER</field>
        <field name="technical_key">ops</field>
        <field name="sequence">20</field>
        <field name="icon">fa fa-heartbeat</field>
    </record>

    <record id="section_finance" model="cms.sidebar.section">
        <field name="name">FINANCE</field>
        <field name="technical_key">finance</field>
        <field name="sequence">30</field>
        <field name="icon">fa fa-university</field>
    </record>

    <!-- HOME. First on the rail, never gated, never hidden. Its one entry
         opens the `cms_home` client action, which asks the server where this
         person's own dashboard is (cms.sidebar.item.home_action). -->
    <record id="section_home" model="cms.sidebar.section">
        <field name="name">Home</field>
        <field name="technical_key">home</field>
        <field name="sequence">0</field>
        <field name="icon">fa fa-home</field>
    </record>

    <!-- LEARN. Its own rail entry (owner ruling, MENU IA Q3), between
         ANALYTICS (37) and ADMIN (40), so ANALYTICS still sits between FINANCE
         and ADMIN. The Training journey (health_learn) and the Training
         admin expander (health_access) move into it. -->
    <record id="section_learn" model="cms.sidebar.section">
        <field name="name">Learn</field>
        <field name="technical_key">learn</field>
        <field name="sequence">38</field>
        <field name="icon">fa fa-graduation-cap</field>
    </record>

    <record id="section_admin" model="cms.sidebar.section">
        <field name="name">ADMIN</field>
        <field name="technical_key">admin</field>
        <field name="sequence">40</field>
        <field name="icon">fa fa-cogs</field>
    </record>

</odoo>
