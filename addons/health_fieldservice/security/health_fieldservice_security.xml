<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         Healthcare Field Service Security Groups
         ===================================================================== -->

    <!-- Module Category -->
    <record id="module_category_health_fieldservice" model="ir.module.category">
        <field name="name">Healthcare Field Service</field>
        <field name="description">Healthcare Field Service Management System</field>
        <field name="sequence">25</field>
    </record>



    <!-- Field Service Manager Group -->
    <record id="group_fieldservice_manager" model="res.groups">
        <field name="name">Field Service Manager</field>
        <field name="category_id" ref="module_category_health_fieldservice"/>
        <field name="implied_ids" eval="[(4, ref('health_base.group_healthcare_operations_manager'))]"/>
        <field name="comment">Managers - full access to field service system, analytics, and configuration</field>
    </record>

    <!-- Equipment Manager Group -->
    <record id="group_equipment_manager" model="res.groups">
        <field name="name">Equipment Manager</field>
        <field name="category_id" ref="module_category_health_fieldservice"/>
        <field name="comment">Equipment management - can manage portable equipment, maintenance, and assignments</field>
    </record>

    <!-- Clinical Protocol Manager Group -->
    <record id="group_protocol_manager" model="res.groups">
        <field name="name">Clinical Protocol Manager</field>
        <field name="category_id" ref="module_category_health_fieldservice"/>
        <field name="comment">Clinical protocols - can create and modify clinical protocol templates</field>
    </record>

    <!-- =====================================================================
         Record Rules - Field Service Order Access Control
         ===================================================================== -->

    <!-- Staff/User Rule: Only see FSOs where they are assigned -->
    <record id="fieldservice_order_staff_rule" model="ir.rule">
        <field name="name">Field Service Orders: Staff sees only assigned orders</field>
        <field name="model_id" ref="model_health_fieldservice_order"/>
        <field name="domain_force">[
            '|', '|',
            ('assignment_ids.staff_id.user_id', '=', user.id),
            ('primary_doctor_id.user_id', '=', user.id),
            ('primary_nurse_id.user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_nurse'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Manager/Dispatcher Rule: See all FSOs -->
    <record id="fieldservice_order_manager_rule" model="ir.rule">
        <field name="name">Field Service Orders: Managers see all orders</field>
        <field name="model_id" ref="model_health_fieldservice_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_fieldservice_manager')), (4, ref('health_base.group_healthcare_operations_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>