<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- Staff Assignment Module Category -->
    <record id="module_category_health_staff_assignment" model="ir.module.category">
        <field name="name">Healthcare Staff Assignment</field>
        <field name="description">Manage healthcare staff assignments and scheduling</field>
        <field name="sequence">20</field>
    </record>

    <!-- =====================================================================
         Staff Assignment User Groups
         ===================================================================== -->





    <!-- =====================================================================
         Record Rules for Staff Assignments
         ===================================================================== -->

    <!-- Sales Users: Can only see FSO bookings in draft/requested state -->
    <record id="rule_fso_sales_user" model="ir.rule">
        <field name="name">FSO Sales User Access</field>
        <field name="model_id" ref="model_health_fieldservice_order"/>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_sales'))]"/>
        <field name="domain_force">[
            '&amp;',
            '&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False),
            ('state', 'in', ['draft', 'requested'])
        ]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>






    <!-- Head Nurses: Can see FSO bookings ready for assignment -->
    <record id="rule_fso_head_nurse" model="ir.rule">
        <field name="name">FSO Head Nurse Access</field>
        <field name="model_id" ref="model_health_fieldservice_order"/>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_head_nurse'))]"/>
        <field name="domain_force">[
            '&amp;',
            '&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False),
            ('state', 'in', ['confirmed', 'in_progress', 'completed'])
        ]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Healthcare Staff: Can only see their own assignments -->
    <record id="rule_assignment_healthcare_staff" model="ir.rule">
        <field name="name">Staff Assignment Healthcare Staff Access</field>
        <field name="model_id" ref="model_health_staff_assignment"/>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_nurse'))]"/>
        <field name="domain_force">[
            '&amp;',
            '&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False),
            ('staff_id.user_id', '=', user.id)
        ]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Healthcare Staff: Can only see FSO bookings assigned to them -->
    <record id="rule_fso_healthcare_staff" model="ir.rule">
        <field name="name">FSO Healthcare Staff Access</field>
        <field name="model_id" ref="model_health_fieldservice_order"/>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_nurse'))]"/>
        <field name="domain_force">[
            '&amp;',
            '&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False),
            '|', '|',
            ('assignment_ids.staff_id.user_id', '=', user.id),
            ('primary_doctor_id.user_id', '=', user.id),
            ('primary_nurse_id.user_id', '=', user.id)
        ]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Healthcare Staff: Can only see their own availability -->
    <record id="rule_availability_healthcare_staff" model="ir.rule">
        <field name="name">Availability Matrix Healthcare Staff Access</field>
        <field name="model_id" ref="model_health_staff_availability_matrix"/>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_nurse'))]"/>
        <field name="domain_force">[
            '&amp;',
            '&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False),
            ('staff_id.user_id', '=', user.id)
        ]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_availability_manager_catchment" model="ir.rule">
        <field name="name">Availability Matrix Manager Own Catchment Access</field>
        <field name="model_id" ref="model_health_staff_availability_matrix"/>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_operations_manager'))]"/>
        <field name="domain_force">['&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Assignment Managers: Can see everything -->
    <record id="rule_assignment_manager_all" model="ir.rule">
        <field name="name">Assignment Manager Own Catchment Access</field>
        <field name="model_id" ref="model_health_staff_assignment"/>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_operations_manager'))]"/>
        <field name="domain_force">['&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- System Administrators: Full access to all FSO records -->
    <record id="rule_fso_system_admin" model="ir.rule">
        <field name="name">FSO System Administrator Access</field>
        <field name="model_id" ref="model_health_fieldservice_order"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Field Service Managers: Full access to all FSO records -->
    <record id="rule_fso_manager_all" model="ir.rule">
        <field name="name">FSO Field Service Manager Own Catchment Access</field>
        <field name="model_id" ref="model_health_fieldservice_order"/>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_operations_manager'))]"/>
        <field name="domain_force">['&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_assignment_owner_all" model="ir.rule">
        <field name="name">Assignment Owner Full Access</field>
        <field name="model_id" ref="model_health_staff_assignment"/>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_owner'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_availability_owner_all" model="ir.rule">
        <field name="name">Availability Matrix Owner Full Access</field>
        <field name="model_id" ref="model_health_staff_availability_matrix"/>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_owner'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- =====================================================================
         Portal and Public Access Rules
         ===================================================================== -->

    <!-- Portal Users: Can see their own FSO bookings -->
    <record id="rule_fso_portal" model="ir.rule">
        <field name="name">FSO Portal User Access</field>
        <field name="model_id" ref="model_health_fieldservice_order"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('patient_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</data>
</odoo>
