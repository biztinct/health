<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="health_fieldservice.OpsSidebar">
    <aside class="ops-global-sidebar">
        <div class="ops-sidebar-logo" t-on-click="navigateHome" style="cursor:pointer">
            <div class="ops-logo-icon"><i class="fa fa-heartbeat"/></div>
            <div>
                <div class="ops-logo-text">VIET UC</div>
                <div class="ops-logo-sub">Healthcare Platform</div>
            </div>
        </div>
        <nav class="ops-sidebar-nav">
            <div class="ops-nav-section-label">Main</div>
            <a t-attf-class="ops-nav-item #{isActive('dashboard') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('dashboard')"><i class="fa fa-th-large"/> Dashboard</a>
            <a t-attf-class="ops-nav-item #{isActive('bookings') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('bookings')"><i class="fa fa-calendar-check-o"/> Bookings</a>
            <a t-attf-class="ops-nav-item #{isActive('clients') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('clients')"><i class="fa fa-address-book-o"/> Clients</a>
            <a t-attf-class="ops-nav-item #{isActive('staff') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('staff')"><i class="fa fa-users"/> Staff</a>
            <a t-attf-class="ops-nav-item #{isActive('roster') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('roster')"><i class="fa fa-th"/> Roster</a>
            <div class="ops-nav-section-label">Reports</div>
            <a t-attf-class="ops-nav-item #{isActive('workload') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('workload')"><i class="fa fa-bar-chart"/> Workload</a>
            <a t-attf-class="ops-nav-item #{isActive('analytics') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('analytics')"><i class="fa fa-line-chart"/> Analytics</a>
            <div class="ops-nav-section-label">System</div>
            <a class="ops-nav-item" t-on-click="navigateHome"><i class="fa fa-arrow-left"/> Back to Odoo</a>
        </nav>
        <div class="ops-sidebar-user">
            <div class="ops-user-avatar" t-esc="currentUserInitials"/>
            <div class="ops-user-info">
                <div class="ops-user-name" t-esc="currentUserName"/>
                <div class="ops-user-role">Operations Manager</div>
            </div>
        </div>
    </aside>
</t>

</templates>
