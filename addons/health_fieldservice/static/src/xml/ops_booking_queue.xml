<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="health_fieldservice.OpsBookingQueue">
    <div class="ops-booking-queue-page">

        <!-- SIDEBAR -->
        <aside class="ops-sidebar">
            <div class="ops-sidebar-logo" t-on-click="navigateHome" style="cursor:pointer">
                <div class="ops-logo-icon"><i class="fa fa-heartbeat"/></div>
                <div>
                    <div class="ops-logo-text">VIET UC</div>
                    <div class="ops-logo-sub">Healthcare Platform</div>
                </div>
            </div>
            <nav class="ops-sidebar-nav">
                <div class="ops-nav-section-label">Main</div>
                <a class="ops-nav-item" t-on-click="() => this.navigateTo('dashboard')"><i class="fa fa-th-large"/> Dashboard</a>
                <a class="ops-nav-item active"><i class="fa fa-calendar-check-o"/> Bookings</a>
                <a class="ops-nav-item" t-on-click="() => this.navigateTo('clients')"><i class="fa fa-address-book-o"/> Clients</a>
                <a class="ops-nav-item" t-on-click="() => this.navigateTo('recurring')"><i class="fa fa-repeat"/> Recurring</a>
                <a class="ops-nav-item" t-on-click="() => this.navigateTo('staff')"><i class="fa fa-users"/> Staff</a>
                <a class="ops-nav-item" t-on-click="() => this.navigateTo('calendar')"><i class="fa fa-calendar"/> Calendar</a>
                <div class="ops-nav-section-label">Reports</div>
                <a class="ops-nav-item" t-on-click="() => this.navigateTo('workload')"><i class="fa fa-bar-chart"/> Workload</a>
                <a class="ops-nav-item" t-on-click="() => this.navigateTo('analytics')"><i class="fa fa-line-chart"/> Analytics</a>
                <div class="ops-nav-section-label">System</div>
                <a class="ops-nav-item" t-on-click="navigateHome"><i class="fa fa-arrow-left"/> Back to Odoo</a>
            </nav>
            <div class="ops-sidebar-user">
                <div class="ops-user-avatar" t-esc="currentUserInitials"/>
                <div class="ops-user-info">
                    <div class="ops-user-name" t-esc="currentUserName"/>
                    <div class="ops-user-role">Operations Manager</div>
                </div>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="ops-main-content">

            <!-- HEADER -->
            <header class="ops-top-header">
                <div class="ops-header-left">
                    <h1 class="ops-page-title">Booking Queue</h1>
                </div>
                <div class="ops-header-right">
                    <button class="ops-header-btn btn-outline" t-on-click="() => this.navigateTo('calendar')">
                        <i class="fa fa-calendar"/> Calendar View
                    </button>
                    <button class="ops-header-btn btn-primary" t-on-click="openCreateBooking">
                        <i class="fa fa-plus"/> Create Booking
                    </button>
                </div>
            </header>

            <!-- FILTER BAR -->
            <div class="ops-filter-bar">
                <div class="ops-search-wrapper">
                    <i class="fa fa-search ops-search-icon"/>
                    <input type="text" class="ops-search-input" placeholder="Search bookings..."
                           t-att-value="state.searchQuery"
                           t-on-input="onSearchInput"
                           t-on-keydown="onSearchKeydown"/>
                </div>
                <select class="ops-filter-select" t-on-change="onServiceTypeChange">
                    <option value="">All Services</option>
                    <option value="home_visit">Home Visit</option>
                    <option value="clinic_visit">Clinic Visit</option>
                    <option value="consultation">Consultation</option>
                    <option value="follow_up">Follow-up</option>
                    <option value="emergency">Emergency</option>
                    <option value="telemedicine">Telehealth</option>
                </select>
                <input type="date" class="ops-filter-select" t-att-value="state.dateFilter" t-on-change="onDateChange"/>
                <select class="ops-filter-select" t-on-change="onPriorityChange">
                    <option value="">All Priorities</option>
                    <option value="4">Emergency</option>
                    <option value="3">Urgent</option>
                    <option value="2">High</option>
                    <option value="1">Normal</option>
                    <option value="0">Low</option>
                </select>
            </div>

            <!-- STATUS TABS -->
            <div class="ops-queue-tabs">
                <button t-attf-class="ops-queue-tab #{state.activeTab === 'all' ? 'active' : ''}" t-on-click="() => this.setTab('all')">All</button>
                <button t-attf-class="ops-queue-tab #{state.activeTab === 'needs_staff' ? 'active' : ''}" t-on-click="() => this.setTab('needs_staff')">Needs Staff</button>
                <button t-attf-class="ops-queue-tab #{state.activeTab === 'active' ? 'active' : ''}" t-on-click="() => this.setTab('active')">Active</button>
                <button t-attf-class="ops-queue-tab #{state.activeTab === 'completed' ? 'active' : ''}" t-on-click="() => this.setTab('completed')">Completed</button>
                <button t-attf-class="ops-queue-tab #{state.activeTab === 'issues' ? 'active' : ''}" t-on-click="() => this.setTab('issues')">Issues</button>
            </div>

            <!-- LOADING -->
            <div t-if="state.isLoading" class="ops-loading">
                <div class="spinner-border text-primary" role="status"/>
                <span>Loading bookings...</span>
            </div>

            <!-- TABLE -->
            <div t-if="!state.isLoading" class="ops-queue-table-wrapper">
                <t t-if="state.bookings.length === 0">
                    <div class="ops-empty-state" style="padding:80px 20px">
                        <i class="fa fa-calendar-check-o" style="font-size:48px"/>
                        <h4>No bookings found</h4>
                        <p>Try adjusting your filters or create a new booking.</p>
                    </div>
                </t>
                <t t-if="state.bookings.length > 0">
                    <table class="ops-queue-table">
                        <thead>
                            <tr>
                                <th>Booking</th>
                                <th>Client</th>
                                <th>Service</th>
                                <th>Time</th>
                                <th>Duration</th>
                                <th>Status</th>
                                <th>Priority</th>
                                <th>Staff</th>
                                <th>Amount</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.bookings" t-as="b" t-key="b.id">
                                <tr class="ops-queue-row" t-on-click="() => this.openBooking(b.id)">
                                    <td class="ops-queue-booking-id" t-esc="b.name"/>
                                    <td>
                                        <div class="ops-queue-client-name" t-esc="getPatientName(b)"/>
                                    </td>
                                    <td>
                                        <span class="ops-queue-service" t-esc="getServiceLabel(b.service_type)"/>
                                    </td>
                                    <td t-esc="formatTime(b.scheduled_datetime)"/>
                                    <td t-esc="formatDuration(b.scheduled_duration)"/>
                                    <td>
                                        <span t-attf-class="ops-status-chip #{getStateChipClass(b.state)}">
                                            <t t-esc="getStateLabel(b.state)"/>
                                        </span>
                                    </td>
                                    <td>
                                        <t t-if="isUrgent(b)">
                                            <span class="ops-priority-urgent"><i class="fa fa-bolt"/> URGENT</span>
                                        </t>
                                        <t t-else="">
                                            <span style="font-size:11px; color:var(--vu-text-secondary)">Normal</span>
                                        </t>
                                    </td>
                                    <td>
                                        <t t-if="b.lead_staff_id">
                                            <span class="ops-queue-staff-badge" t-esc="getStaffName(b)"/>
                                        </t>
                                        <t t-if="!b.lead_staff_id and !b.has_staff_assigned">
                                            <div class="position-relative" t-on-click.stop="">
                                                <button class="ops-assign-btn-inline" t-on-click.stop="() => this.toggleDropdown(b.id)">
                                                    <i class="fa fa-user-plus"/> Assign
                                                </button>
                                                <div t-attf-class="ops-staff-dropdown-menu #{state.openDropdownId === b.id ? 'show' : ''}" style="min-width:200px">
                                                    <t t-foreach="state.availableStaff" t-as="staff" t-key="staff.id">
                                                        <div class="ops-staff-option" t-on-click.stop="() => this.selectStaff(b.id, staff.id)">
                                                            <div class="ops-staff-option-avatar" t-att-style="'background:' + staff.staffColor" t-esc="staff.initials"/>
                                                            <div>
                                                                <div class="ops-staff-option-name" t-esc="staff.name"/>
                                                                <div class="ops-staff-option-meta" t-esc="staff.access_role_display"/>
                                                            </div>
                                                        </div>
                                                    </t>
                                                </div>
                                            </div>
                                        </t>
                                    </td>
                                    <td t-esc="formatCurrency(b.total_price)"/>
                                    <td t-on-click.stop="">
                                        <button class="ops-action-btn-sm" t-on-click.stop="() => this.openBooking(b.id)">
                                            <i class="fa fa-eye"/> View
                                        </button>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- PAGINATION -->
                    <div class="ops-pagination">
                        <span class="ops-pagination-info">
                            Showing <t t-esc="showingFrom"/>-<t t-esc="showingTo"/> of <t t-esc="state.totalCount"/>
                        </span>
                        <div class="ops-pagination-btns">
                            <button class="ops-pagination-btn" t-att-disabled="state.page === 0" t-on-click="prevPage">
                                <i class="fa fa-chevron-left"/>
                            </button>
                            <span class="ops-pagination-page">Page <t t-esc="state.page + 1"/> of <t t-esc="totalPages"/></span>
                            <button class="ops-pagination-btn" t-att-disabled="state.page >= totalPages - 1" t-on-click="nextPage">
                                <i class="fa fa-chevron-right"/>
                            </button>
                        </div>
                    </div>
                </t>
            </div>

        </div><!-- /ops-main-content -->
    </div>
</t>

</templates>
