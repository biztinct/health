<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="health_fieldservice.StaffWorkloadDashboardTemplate" owl="1">
        <div class="o_staff_workload_dashboard">
            <!-- Header Controls -->
            <div class="o_dashboard_header">
                <div class="o_header_left">
                    <h2 class="o_dashboard_title">
                        <i class="fa fa-users me-2"/>
                        Staff Workload Management
                    </h2>
                </div>
                
                <div class="o_header_center">
                    <div class="o_time_range_selector">
                        <select class="form-select" t-model="state.selectedTimeRange" t-on-change="onTimeRangeChange">
                            <option value="today">Today</option>
                            <option value="week">This Week</option>
                            <option value="month">This Month</option>
                            <option value="quarter">This Quarter</option>
                        </select>
                    </div>
                </div>
                
                <div class="o_header_right">
                    <button class="btn btn-outline-secondary" t-on-click="onRefresh">
                        <i class="fa fa-refresh me-1"/>
                        Refresh
                    </button>
                </div>
            </div>

            <!-- Loading State -->
            <div t-if="state.isLoading" class="o_loading_container">
                <div class="text-center py-5">
                    <i class="fa fa-spinner fa-spin fa-3x text-muted"/>
                    <p class="text-muted mt-3">Loading staff workload data...</p>
                </div>
            </div>

            <!-- Main Dashboard Content -->
            <div t-else="" class="o_dashboard_content">
                <!-- Workload Summary Bar -->
                <div class="o_workload_summary">
                    <div class="row">
                        <div class="col-3">
                            <div class="o_summary_card o_optimal">
                                <div class="o_summary_icon">
                                    <i class="fa fa-check-circle"/>
                                </div>
                                <div class="o_summary_content">
                                    <div class="o_summary_number">
                                        <t t-esc="state.staffMembers.length"/>
                                    </div>
                                    <div class="o_summary_label">Available Staff</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="o_summary_card o_warning">
                                <div class="o_summary_icon">
                                    <i class="fa fa-exclamation-triangle"/>
                                </div>
                                <div class="o_summary_content">
                                    <div class="o_summary_number">
                                        0
                                    </div>
                                    <div class="o_summary_label">Busy Staff</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="o_summary_card o_overload">
                                <div class="o_summary_icon">
                                    <i class="fa fa-warning"/>
                                </div>
                                <div class="o_summary_content">
                                    <div class="o_summary_number">
                                        0
                                    </div>
                                    <div class="o_summary_label">Overloaded Staff</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="o_summary_card o_total">
                                <div class="o_summary_icon">
                                    <i class="fa fa-tasks"/>
                                </div>
                                <div class="o_summary_content">
                                    <div class="o_summary_number">
                                        <t t-esc="state.assignments.length"/>
                                    </div>
                                    <div class="o_summary_label">Total Assignments</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Staff Columns -->
                <div class="o_staff_columns_container">
                    <div class="row">
                        <div t-foreach="state.staffMembers" t-as="staff" t-key="staff.id" 
                             class="col-lg-3 col-md-4 col-sm-6">
                            <div class="o_staff_column" t-att-data-staff-id="staff.id">
                                <!-- Professional Staff Header with Combined Info -->
                                <div class="o_staff_header_professional" t-on-click="() => this.onStaffClick(staff.id)">
                                    <div class="o_staff_primary_info">
                                        <h3 class="o_staff_name_prominent">
                                            <t t-esc="staff.name || 'Staff Member'"/>
                                        </h3>
                                        <div class="o_staff_assignment_summary">
                                            <span class="o_assignment_count" t-esc="getStaffAssignments(staff.id).length"/>
                                            <span class="o_assignment_label">Current Assignments</span>
                                        </div>
                                    </div>
                                    <div class="o_staff_role_indicator">
                                        <span class="o_role_badge">
                                            <t t-esc="staff.healthcare_role || 'Staff'"/>
                                        </span>
                                    </div>
                                </div>

                                <!-- Assignment Cards -->
                                <div class="o_assignments_container">
                                    <div class="o_assignments_header">
                                        <h6>
                                            <i class="fa fa-tasks me-1"/>
                                            Current Assignments
                                        </h6>
                                    </div>
                                    
                                    <div class="o_assignments_list">
                                        <t t-foreach="getStaffAssignments(staff.id)" 
                                           t-as="assignment" t-key="assignment.id">
                                            <div class="o_assignment_card" 
                                                 t-att-data-assignment-id="assignment.id"
                                                 t-on-click="() => this.onAssignmentClick(assignment.id)">
                                                
                                                <!-- Assignment Content -->
                                                <div class="o_assignment_content">
                                                    <div class="o_assignment_header">
                                                        <h6 class="o_assignment_title" t-esc="assignment.name"/>
                                                        <div class="o_assignment_meta">
                                                            <span class="badge badge-info" t-esc="assignment.state"/>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="o_assignment_details">
                                                        <div class="o_detail_row" t-if="assignment.fso_id">
                                                            <i class="fa fa-stethoscope me-1"/>
                                                            <span t-esc="assignment.fso_id[1]"/>
                                                        </div>
                                                        <div class="o_detail_row" t-if="assignment.assignment_role">
                                                            <i class="fa fa-user me-1"/>
                                                            <span t-esc="assignment.assignment_role"/>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                        
                                        <!-- Empty State -->
                                        <div t-if="!getStaffAssignments(staff.id).length" 
                                             class="o_empty_assignments">
                                            <div class="text-center text-muted py-3">
                                                <i class="fa fa-inbox fa-2x mb-2"/>
                                                <p>No assignments</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Drop Zone Indicator -->
                                <div class="o_drop_zone_indicator">
                                    <div class="o_drop_message">
                                        <i class="fa fa-arrow-down"/>
                                        Drop assignment here
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Empty State -->
                <div t-if="!state.staffMembers.length" class="o_empty_state">
                    <div class="text-center py-5">
                        <i class="fa fa-users fa-4x text-muted mb-3"/>
                        <h4 class="text-muted">No Staff Members Found</h4>
                        <p class="text-muted">Add staff members to see workload management</p>
                        <button class="btn btn-primary">
                            <i class="fa fa-plus me-1"/>
                            Add Staff Member
                        </button>
                    </div>
                </div>
            </div>

            <!-- Drag Preview -->
            <div class="o_drag_preview" style="display: none;">
                <div class="o_preview_content">
                    <i class="fa fa-arrows-alt me-2"/>
                    <span class="o_preview_text">Moving assignment...</span>
                </div>
            </div>
        </div>
    </t>
</templates>