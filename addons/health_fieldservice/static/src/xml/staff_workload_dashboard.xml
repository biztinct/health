<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="health_fieldservice.StaffWorkloadDashboardTemplate" owl="1">
        <div class="swl">
            <!-- Header -->
            <div class="swl-head">
                <div class="swl-head__title">
                    <span class="swl-head__icon"><i class="fa fa-users"/></span>
                    <div>
                        <h2>Staff Workload</h2>
                        <div class="swl-head__sub">Current active assignments across healthcare staff</div>
                    </div>
                </div>
                <button class="swl-refresh" t-on-click="onRefresh">
                    <i class="fa fa-refresh"/> Refresh
                </button>
            </div>

            <!-- Loading -->
            <div t-if="state.isLoading" class="swl-loading">
                <i class="fa fa-circle-o-notch fa-spin"/> Loading workload…
            </div>

            <t t-else="">
                <!-- Filter bar (governs the KPIs and staff cards below) -->
                <div class="swl-filters">
                    <div class="swl-fgroup">
                        <span class="swl-flbl">Status</span>
                        <button t-attf-class="swl-fpill swl-fpill--assigned {{ isStatusOn('assigned') ? 'is-on' : '' }}"
                                t-on-click="() => this.toggleStatus('assigned')">
                            Assigned <span class="swl-fpill__n" t-esc="statusCount('assigned')"/>
                        </button>
                        <button t-attf-class="swl-fpill swl-fpill--confirmed {{ isStatusOn('confirmed') ? 'is-on' : '' }}"
                                t-on-click="() => this.toggleStatus('confirmed')">
                            Confirmed <span class="swl-fpill__n" t-esc="statusCount('confirmed')"/>
                        </button>
                        <button t-attf-class="swl-fpill swl-fpill--in_progress {{ isStatusOn('in_progress') ? 'is-on' : '' }}"
                                t-on-click="() => this.toggleStatus('in_progress')">
                            In Progress <span class="swl-fpill__n" t-esc="statusCount('in_progress')"/>
                        </button>
                    </div>
                    <div class="swl-fgroup">
                        <span class="swl-flbl">Date</span>
                        <button t-attf-class="swl-fpill {{ state.dateRange==='all' ? 'is-on' : '' }}" t-on-click="() => this.setDateRange('all')">All time</button>
                        <button t-attf-class="swl-fpill {{ state.dateRange==='today' ? 'is-on' : '' }}" t-on-click="() => this.setDateRange('today')">Today</button>
                        <button t-attf-class="swl-fpill {{ state.dateRange==='week' ? 'is-on' : '' }}" t-on-click="() => this.setDateRange('week')">This week</button>
                        <button t-attf-class="swl-fpill {{ state.dateRange==='month' ? 'is-on' : '' }}" t-on-click="() => this.setDateRange('month')">This month</button>
                        <button t-attf-class="swl-fpill {{ state.dateRange==='custom' ? 'is-on' : '' }}" t-on-click="() => this.setDateRange('custom')">Custom</button>
                        <t t-if="state.dateRange==='custom'">
                            <input type="date" class="swl-datein" t-model="state.customFrom" title="From"/>
                            <span class="swl-dash">–</span>
                            <input type="date" class="swl-datein" t-model="state.customTo" title="To"/>
                        </t>
                    </div>
                    <div class="swl-fspacer"/>
                    <div class="swl-ftools">
                        <div class="swl-staffpick" t-ref="staffPicker">
                            <button class="swl-staffpick__btn" t-on-click="toggleStaffPicker">
                                <i class="fa fa-user-o"/>
                                <span t-esc="staffPickerLabel"/>
                                <i class="fa fa-caret-down"/>
                            </button>
                            <div class="swl-staffpick__panel" t-if="state.staffPickerOpen">
                                <div class="swl-staffpick__search">
                                    <i class="fa fa-search"/>
                                    <input type="text" placeholder="Search staff…" t-model="state.search"/>
                                </div>
                                <div class="swl-staffpick__actions">
                                    <button t-on-click="selectAllStaff">Select all</button>
                                    <span class="swl-staffpick__sep">·</span>
                                    <button t-on-click="clearStaff">Clear</button>
                                </div>
                                <div class="swl-staffpick__list">
                                    <t t-foreach="pickerStaff" t-as="s" t-key="s.id">
                                        <label class="swl-staffpick__row">
                                            <input type="checkbox" t-att-checked="isStaffSelected(s.id)" t-on-change="() => this.toggleStaff(s.id)"/>
                                            <span t-attf-class="swl-av swl-av--sm swl-av-{{ avatarHue(s.name) }}" t-esc="initials(s.name)"/>
                                            <span class="swl-staffpick__name" t-esc="s.name"/>
                                        </label>
                                    </t>
                                    <div t-if="!pickerStaff.length" class="swl-staffpick__empty">No match</div>
                                </div>
                            </div>
                        </div>
                        <button t-attf-class="swl-ftoggle {{ state.sortByLoad ? 'is-on' : '' }}" t-on-click="toggleSort" title="Sort busiest first">
                            <i class="fa fa-sort-amount-desc"/>
                        </button>
                        <button t-attf-class="swl-ftoggle {{ state.hideEmpty ? 'is-on' : '' }}" t-on-click="toggleHideEmpty" title="Hide staff with no assignments">
                            <i class="fa fa-eye-slash"/>
                        </button>
                    </div>
                </div>

                <!-- KPI row (click a card to focus that group; click "Active assignments" to clear) -->
                <div class="swl-kpis">
                    <div t-attf-class="swl-kpi swl-kpi--available {{ isLoadFilter('available') ? 'is-active' : '' }}"
                         t-on-click="() => this.setLoadFilter('available')" title="Show only available staff">
                        <div class="swl-kpi__val" t-esc="availableCount"/>
                        <div class="swl-kpi__lbl">Available</div>
                    </div>
                    <div t-attf-class="swl-kpi swl-kpi--busy {{ isLoadFilter('busy') ? 'is-active' : '' }}"
                         t-on-click="() => this.setLoadFilter('busy')" title="Show only busy staff">
                        <div class="swl-kpi__val" t-esc="busyCount"/>
                        <div class="swl-kpi__lbl">Busy</div>
                    </div>
                    <div t-attf-class="swl-kpi swl-kpi--over {{ isLoadFilter('overloaded') ? 'is-active' : '' }}"
                         t-on-click="() => this.setLoadFilter('overloaded')" title="Show only overloaded staff">
                        <div class="swl-kpi__val" t-esc="overloadedCount"/>
                        <div class="swl-kpi__lbl">Overloaded</div>
                    </div>
                    <div t-attf-class="swl-kpi swl-kpi--total {{ !state.loadFilter ? 'is-active' : '' }}"
                         t-on-click="() => this.setLoadFilter(null)" title="Show all staff">
                        <div class="swl-kpi__val" t-esc="totalAssignments"/>
                        <div class="swl-kpi__lbl">Active assignments</div>
                    </div>
                </div>

                <!-- Staff grid -->
                <div class="swl-grid" t-if="visibleStaff.length">
                    <t t-foreach="visibleStaff" t-as="staff" t-key="staff.id">
                        <div t-attf-class="swl-card swl-card--{{ loadLevel(staffLoad(staff.id)) }}">
                            <div class="swl-card__head" t-on-click="() => this.onStaffClick(staff.id)">
                                <span t-attf-class="swl-av swl-av-{{ avatarHue(staff.name) }}" t-esc="initials(staff.name)"/>
                                <div class="swl-card__id">
                                    <div class="swl-card__name" t-esc="staff.name"/>
                                    <div class="swl-card__role" t-esc="staff.access_role_display"/>
                                </div>
                                <span t-attf-class="swl-pill swl-pill--{{ loadLevel(staffLoad(staff.id)) }}"
                                      t-attf-title="{{ staffLoad(staff.id) }} active assignments">
                                    <t t-esc="staffLoad(staff.id)"/>
                                </span>
                            </div>

                            <div class="swl-bar"><span t-attf-style="width:{{ loadPercent(staffLoad(staff.id)) }}%"/></div>

                            <div class="swl-asg">
                                <t t-if="getStaffAssignments(staff.id).length">
                                    <t t-foreach="getStaffAssignments(staff.id)" t-as="a" t-key="a.id">
                                        <div class="swl-asg__row" t-on-click="() => this.onAssignmentClick(a.id)">
                                            <span class="swl-asg__name" t-esc="a.fso_id ? a.fso_id[1] : a.name"/>
                                            <span t-attf-class="swl-asg__state swl-st-{{ a.state }}" t-esc="stateLabel(a.state)"/>
                                        </div>
                                    </t>
                                </t>
                                <div t-else="" class="swl-asg__empty">No current assignments</div>
                            </div>
                        </div>
                    </t>
                </div>

                <div t-else="" class="swl-empty">
                    <i class="fa fa-filter"/>
                    <div t-if="state.staffMembers.length">No staff match the current filters</div>
                    <div t-else="">No healthcare staff found</div>
                    <button t-if="state.staffMembers.length" class="swl-refresh" t-on-click="clearFilters">Clear filters</button>
                </div>
            </t>
        </div>
    </t>
</templates>
