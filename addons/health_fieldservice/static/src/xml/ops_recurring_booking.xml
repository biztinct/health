<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="health_fieldservice.OpsRecurringBooking">
    <div class="ops-recurring-page">
        <div class="ops-main-content">

            <header class="ops-top-header">
                <div class="ops-header-left">
                    <div class="cp-breadcrumb">
                        <a t-on-click="() => this.navigateTo('dashboard')">Dashboard</a>
                        <span class="cp-sep"><i class="fa fa-chevron-right" style="font-size:10px"/></span>
                        <a t-on-click="() => this.navigateTo('bookings')">Bookings</a>
                        <span class="cp-sep"><i class="fa fa-chevron-right" style="font-size:10px"/></span>
                        <span class="cp-current">Recurring Booking</span>
                    </div>
                </div>
            </header>

            <t t-if="state.isLoading">
                <div class="rb-loading">
                    <i class="fa fa-spinner fa-spin fa-2x"/>
                    <div>Loading...</div>
                </div>
            </t>

            <t t-if="!state.isLoading and !state.showConfirmation">
                <div class="rb-wizard-wrap">
                    <div class="rb-wizard">

                        <!-- HEADER -->
                        <div class="rb-wizard-header">
                            <div>
                                <div class="rb-wizard-title"><i class="fa fa-repeat"/> Recurring Booking</div>
                                <div class="rb-wizard-subtitle">
                                    Create multiple bookings on a regular schedule
                                    <t t-if="state.patient.name"> for <strong t-esc="state.patient.name"/></t>
                                </div>
                            </div>
                            <button class="rb-close-btn" t-on-click="goBack"><i class="fa fa-times"/></button>
                        </div>

                        <!-- VALIDATION ERRORS -->
                        <t t-if="state.validationErrors.length > 0">
                            <div class="rb-validation-popup">
                                <div class="rb-vp-header">
                                    <i class="fa fa-exclamation-triangle"/> Required fields missing
                                    <button class="rb-vp-close" t-on-click="dismissValidation"><i class="fa fa-times"/></button>
                                </div>
                                <ul class="rb-vp-list">
                                    <t t-foreach="state.validationErrors" t-as="err" t-key="err_index">
                                        <li><i class="fa fa-circle"/> <t t-esc="err"/></li>
                                    </t>
                                </ul>
                            </div>
                        </t>

                        <!-- BODY -->
                        <div class="rb-wizard-body">

                            <!-- SERVICE SECTION -->
                            <div class="rb-section-title rb-section-first"><i class="fa fa-stethoscope"/> Service</div>
                            <div class="rb-form-row">
                                <div class="rb-form-group">
                                    <div class="rb-form-label">Service Type <span class="rb-req">*</span></div>
                                    <select class="rb-form-input" t-on-change="onServiceTypeChange">
                                        <t t-foreach="state.serviceTypes" t-as="st" t-key="st.key">
                                            <option t-att-value="st.key"
                                                    t-att-selected="st.key === state.serviceType"
                                                    t-esc="st.label"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="rb-form-group">
                                    <div class="rb-form-label">Duration</div>
                                    <select class="rb-form-input" t-on-change="onDurationChange">
                                        <option value="1">1 hour</option>
                                        <option value="2" selected="">2 hours</option>
                                        <option value="3">3 hours</option>
                                        <option value="4">4 hours</option>
                                    </select>
                                </div>
                            </div>
                            <div class="rb-form-row">
                                <div class="rb-form-group">
                                    <div class="rb-form-label">Preferred Time</div>
                                    <select class="rb-form-input" t-on-change="onTimeChange">
                                        <option value="7">07:00</option>
                                        <option value="8">08:00</option>
                                        <option value="9" selected="">09:00</option>
                                        <option value="10">10:00</option>
                                        <option value="11">11:00</option>
                                        <option value="13">13:00</option>
                                        <option value="14">14:00</option>
                                        <option value="15">15:00</option>
                                        <option value="16">16:00</option>
                                    </select>
                                </div>
                                <div class="rb-form-group">
                                    <div class="rb-form-label">Facility <span class="rb-req">*</span></div>
                                    <select class="rb-form-input" t-on-change="onFacilityChange">
                                        <t t-foreach="state.facilities" t-as="f" t-key="f.id">
                                            <option t-att-value="f.id"
                                                    t-att-selected="f.id === state.facilityId"
                                                    t-esc="f.name"/>
                                        </t>
                                    </select>
                                </div>
                            </div>

                            <!-- QUOTE (Product Catalog) -->
                            <div class="rb-section-title"><i class="fa fa-file-text-o"/> Quote</div>

                            <button class="btn btn-outline-primary rb-add-services-btn"
                                    t-on-click="openServiceCatalog">
                                <i class="fa fa-plus-circle"/> Add Services
                            </button>

                            <!-- Selected Products Table -->
                            <t t-if="hasProducts">
                                <div class="rb-products-table">
                                    <div class="rb-pt-header">
                                        <div class="rb-pt-col rb-pt-name">Product</div>
                                        <div class="rb-pt-col rb-pt-price">Unit Price</div>
                                        <div class="rb-pt-col rb-pt-qty">Qty</div>
                                        <div class="rb-pt-col rb-pt-subtotal">Subtotal</div>
                                        <div class="rb-pt-col rb-pt-action"></div>
                                    </div>
                                    <t t-foreach="state.selectedProducts" t-as="item" t-key="item_index">
                                        <div class="rb-pt-row">
                                            <div class="rb-pt-col rb-pt-name" t-esc="item.name"/>
                                            <div class="rb-pt-col rb-pt-price" t-esc="formatCurrency(item.price)"/>
                                            <div class="rb-pt-col rb-pt-qty">
                                                <input type="number" class="rb-qty-input" min="1" max="99"
                                                       t-att-value="item.qty"
                                                       t-on-change="(ev) => this.updateProductQty(item_index, ev)"/>
                                            </div>
                                            <div class="rb-pt-col rb-pt-subtotal" t-esc="formatCurrency(item.price * item.qty)"/>
                                            <div class="rb-pt-col rb-pt-action">
                                                <button class="rb-remove-btn" t-on-click="() => this.removeProduct(item_index)">
                                                    <i class="fa fa-times"/>
                                                </button>
                                            </div>
                                        </div>
                                    </t>
                                    <div class="rb-pt-footer">
                                        <div class="rb-pt-total-label">Total per booking</div>
                                        <div class="rb-pt-total-value" t-esc="formatCurrency(productTotal)"/>
                                    </div>
                                </div>
                            </t>
                            <t t-if="!hasProducts">
                                <div class="rb-no-products">
                                    <i class="fa fa-info-circle"/> Click "Add Services" to select products for each booking
                                </div>
                            </t>

                            <!-- Package -->
                            <t t-if="state.packages.length > 0">
                                <div class="rb-form-group" style="margin-top:12px">
                                    <div class="rb-form-label">Prepaid Package</div>
                                    <select class="rb-form-input" t-on-change="onPackageChange">
                                        <option value="">— No package —</option>
                                        <t t-foreach="state.packages" t-as="pkg" t-key="pkg.id">
                                            <option t-att-value="pkg.id"
                                                    t-att-selected="pkg.id === state.packageId"
                                                    t-esc="pkg.name + ' — ' + pkg.remaining_services + '/' + pkg.total_services + ' remaining'"/>
                                        </t>
                                    </select>
                                </div>
                            </t>
                            <div class="rb-pkg-warning" t-if="packageWarning">
                                <i class="fa fa-exclamation-triangle"/>
                                Package has <t t-esc="selectedPackage.remaining_services"/> services remaining
                                but <t t-esc="state.preview.length"/> bookings will be created
                            </div>

                            <!-- BOOKING SCHEDULE -->
                            <div class="rb-section-title"><i class="fa fa-calendar"/> Booking Schedule</div>
                            <div class="rb-pattern-options">
                                <div t-attf-class="rb-pattern-btn #{state.pattern === 'daily' ? 'selected' : ''}"
                                     t-on-click="() => this.selectPattern('daily')">
                                    <i class="fa fa-calendar-o"/>
                                    <div class="rb-pb-label">Daily</div>
                                    <div class="rb-pb-desc">Every day</div>
                                </div>
                                <div t-attf-class="rb-pattern-btn #{state.pattern === 'weekly' ? 'selected' : ''}"
                                     t-on-click="() => this.selectPattern('weekly')">
                                    <i class="fa fa-calendar"/>
                                    <div class="rb-pb-label">Weekly</div>
                                    <div class="rb-pb-desc">Same days each week</div>
                                </div>
                                <div t-attf-class="rb-pattern-btn #{state.pattern === 'biweekly' ? 'selected' : ''}"
                                     t-on-click="() => this.selectPattern('biweekly')">
                                    <i class="fa fa-calendar"/>
                                    <div class="rb-pb-label">Bi-Weekly</div>
                                    <div class="rb-pb-desc">Every 2 weeks</div>
                                </div>
                                <div t-attf-class="rb-pattern-btn #{state.pattern === 'monthly' ? 'selected' : ''}"
                                     t-on-click="() => this.selectPattern('monthly')">
                                    <i class="fa fa-calendar"/>
                                    <div class="rb-pb-label">Monthly</div>
                                    <div class="rb-pb-desc">Same date each month</div>
                                </div>
                            </div>

                            <!-- DAY SELECTOR -->
                            <t t-if="state.pattern === 'weekly' or state.pattern === 'biweekly'">
                                <div class="rb-form-label" style="margin-bottom:6px">Repeat on days <span class="rb-req">*</span></div>
                                <div class="rb-day-selector">
                                    <button t-attf-class="rb-day-btn #{isDaySelected(0) ? 'selected' : ''}" t-on-click="() => this.toggleDay(0)">Mon</button>
                                    <button t-attf-class="rb-day-btn #{isDaySelected(1) ? 'selected' : ''}" t-on-click="() => this.toggleDay(1)">Tue</button>
                                    <button t-attf-class="rb-day-btn #{isDaySelected(2) ? 'selected' : ''}" t-on-click="() => this.toggleDay(2)">Wed</button>
                                    <button t-attf-class="rb-day-btn #{isDaySelected(3) ? 'selected' : ''}" t-on-click="() => this.toggleDay(3)">Thu</button>
                                    <button t-attf-class="rb-day-btn #{isDaySelected(4) ? 'selected' : ''}" t-on-click="() => this.toggleDay(4)">Fri</button>
                                    <button t-attf-class="rb-day-btn #{isDaySelected(5) ? 'selected' : ''}" t-on-click="() => this.toggleDay(5)">Sat</button>
                                    <button t-attf-class="rb-day-btn #{isDaySelected(6) ? 'selected' : ''}" t-on-click="() => this.toggleDay(6)">Sun</button>
                                </div>
                            </t>

                            <!-- DATE RANGE -->
                            <div class="rb-form-3col">
                                <div class="rb-form-group">
                                    <div class="rb-form-label">Start Date <span class="rb-req">*</span></div>
                                    <input class="rb-form-input" type="date"
                                           t-att-value="state.startDate"
                                           t-on-change="onStartDateChange"/>
                                </div>
                                <div class="rb-form-group">
                                    <div class="rb-form-label">End Type</div>
                                    <select class="rb-form-input" disabled="">
                                        <option>After X occurrences</option>
                                    </select>
                                </div>
                                <div class="rb-form-group">
                                    <div class="rb-form-label">Occurrences</div>
                                    <input class="rb-form-input" type="number" min="1" max="52"
                                           t-att-value="state.occurrences"
                                           t-on-change="onOccurrencesChange"/>
                                </div>
                            </div>

                            <!-- PREVIEW -->
                            <t t-if="state.preview.length > 0">
                                <div class="rb-preview-card">
                                    <div class="rb-preview-title">
                                        <i class="fa fa-eye"/>
                                        Booking Preview — <t t-esc="state.preview.length"/> bookings will be created
                                        <t t-if="conflictCount > 0">
                                            <span class="rb-conflict-badge"><t t-esc="conflictCount"/> conflicts</span>
                                        </t>
                                    </div>
                                    <div class="rb-preview-list">
                                        <t t-foreach="state.preview" t-as="item" t-key="item.num">
                                            <div class="rb-preview-item">
                                                <div class="rb-preview-num" t-esc="item.num"/>
                                                <div class="rb-preview-date" t-esc="item.date"/>
                                                <div class="rb-preview-day" t-esc="item.time"/>
                                                <div t-attf-class="rb-preview-status #{item.conflict ? 'conflict' : 'ok'}">
                                                    <t t-if="!item.conflict"><i class="fa fa-check-circle"/> Available</t>
                                                    <t t-if="item.conflict"><i class="fa fa-exclamation-triangle"/> Conflict</t>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>

                            <!-- NOTES -->
                            <div class="rb-form-group" style="margin-top:14px">
                                <div class="rb-form-label">Notes</div>
                                <input class="rb-form-input" type="text"
                                       placeholder="Optional notes for all bookings..."
                                       t-att-value="state.notes"
                                       t-on-change="onNotesChange"/>
                            </div>

                            <!-- STAFF ASSIGNMENT -->
                            <div class="rb-section-title"><i class="fa fa-user-md"/> Staff Assignment</div>

                            <!-- Assigned Staff (multi-select chips) -->
                            <div class="rb-form-group">
                                <div class="rb-form-label">Assigned Staff <span class="rb-optional">(optional)</span></div>
                                <div class="rb-staff-chips">
                                    <t t-foreach="state.staffList" t-as="staff" t-key="staff.id">
                                        <button t-attf-class="rb-staff-chip #{isStaffAssigned(staff.id) ? 'selected' : ''}"
                                                t-on-click="() => this.toggleAssignedStaff(staff.id)">
                                            <span class="rb-chip-initials" t-esc="staff.initials"/>
                                            <span t-esc="staff.name"/>
                                            <t t-if="staff.is_preferred"><i class="fa fa-star rb-chip-star"/></t>
                                            <i t-if="isStaffAssigned(staff.id)" class="fa fa-check rb-chip-check"/>
                                        </button>
                                    </t>
                                </div>
                            </div>

                            <div class="rb-form-row">
                                <div class="rb-form-group">
                                    <div class="rb-form-label">Lead Staff <span class="rb-optional">(optional)</span></div>
                                    <select class="rb-form-input" t-on-change="onStaffChange">
                                        <option value="">— No lead staff —</option>
                                        <t t-foreach="assignedStaffOptions" t-as="staff" t-key="staff.id">
                                            <option t-att-value="staff.id"
                                                    t-att-selected="staff.id === state.staffId"
                                                    t-esc="staff.name + (staff.job_title ? ' — ' + staff.job_title : '')"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="rb-form-group">
                                    <div class="rb-form-label">Doctor <span class="rb-optional">(optional)</span></div>
                                    <select class="rb-form-input" t-on-change="onDoctorChange">
                                        <option value="">— No doctor —</option>
                                        <t t-foreach="state.doctorList" t-as="doc" t-key="doc.id">
                                            <option t-att-value="doc.id"
                                                    t-att-selected="doc.id === state.doctorId"
                                                    t-esc="doc.name + (doc.specialization ? ' — ' + doc.specialization : '')"/>
                                        </t>
                                    </select>
                                </div>
                            </div>
                            <div class="rb-preferred-badge" t-if="state.staffId and state.staffId === state.preferredStaffId">
                                <i class="fa fa-star"/> Client's preferred staff
                            </div>

                            <!-- SUMMARY -->
                            <div class="rb-summary-box">
                                <div class="rb-summary-row">
                                    <span class="rb-sum-label">Service</span>
                                    <span class="rb-sum-value"><t t-esc="serviceLabel"/> (<t t-esc="state.durationHours"/>h)</span>
                                </div>
                                <div class="rb-summary-row" t-if="hasProducts">
                                    <span class="rb-sum-label">Products</span>
                                    <span class="rb-sum-value rb-sum-ok"><i class="fa fa-check-circle"/> <t t-esc="state.selectedProducts.length"/> selected</span>
                                </div>
                                <div class="rb-summary-row" t-if="selectedPackage">
                                    <span class="rb-sum-label">Package</span>
                                    <span class="rb-sum-value" t-esc="selectedPackage.name"/>
                                </div>
                                <div class="rb-summary-row" t-if="selectedStaffName">
                                    <span class="rb-sum-label">Staff</span>
                                    <span class="rb-sum-value" t-esc="selectedStaffName"/>
                                </div>
                                <div class="rb-summary-row" t-if="selectedDoctorName">
                                    <span class="rb-sum-label">Doctor</span>
                                    <span class="rb-sum-value" t-esc="selectedDoctorName"/>
                                </div>
                                <div class="rb-summary-row">
                                    <span class="rb-sum-label">Pattern</span>
                                    <span class="rb-sum-value" t-esc="previewSummary"/>
                                </div>
                                <div class="rb-summary-row">
                                    <span class="rb-sum-label">Date Range</span>
                                    <span class="rb-sum-value" t-esc="dateRange"/>
                                </div>
                                <div class="rb-summary-total">
                                    <span class="rb-sum-label">Total Bookings</span>
                                    <span class="rb-sum-value"><t t-esc="state.preview.length"/> bookings</span>
                                </div>
                            </div>
                        </div>

                        <!-- FOOTER -->
                        <div class="rb-wizard-footer">
                            <button class="rb-footer-btn rb-btn-back" t-on-click="goBack">
                                <i class="fa fa-arrow-left"/> Back
                            </button>
                            <div class="rb-footer-info">
                                <t t-esc="state.preview.length"/> bookings will be created
                            </div>
                            <button class="rb-footer-btn rb-btn-create" t-on-click="createBookings"
                                    t-att-disabled="state.isCreating or state.preview.length === 0">
                                <t t-if="state.isCreating"><i class="fa fa-spinner fa-spin"/> Creating...</t>
                                <t t-else=""><i class="fa fa-check"/> Create <t t-esc="state.preview.length"/> Bookings</t>
                            </button>
                        </div>

                    </div>
                </div>
            </t>

            <!-- CONFIRMATION MODAL -->
            <t t-if="state.showConfirmation and state.creationResult">
                <div class="rb-modal-overlay">
                    <div class="rb-modal-card">
                        <div class="rb-modal-header">
                            <div class="rb-modal-icon"><i class="fa fa-check-circle"/></div>
                            <div class="rb-modal-title">
                                <t t-esc="state.creationResult.count"/> Bookings Confirmed
                            </div>
                            <div class="rb-modal-subtitle">All bookings created with quotes and staff assigned</div>
                        </div>

                        <div class="rb-modal-body">
                            <!-- Schedule Info -->
                            <div class="rb-modal-info-grid">
                                <div class="rb-modal-info-item">
                                    <span class="rb-mi-label">Schedule</span>
                                    <span class="rb-mi-value" t-esc="previewSummary"/>
                                </div>
                                <div class="rb-modal-info-item">
                                    <span class="rb-mi-label">Period</span>
                                    <span class="rb-mi-value" t-esc="dateRange"/>
                                </div>
                                <div class="rb-modal-info-item">
                                    <span class="rb-mi-label">Staff</span>
                                    <span class="rb-mi-value" t-esc="selectedStaffName"/>
                                </div>
                                <div class="rb-modal-info-item" t-if="selectedDoctorName">
                                    <span class="rb-mi-label">Doctor</span>
                                    <span class="rb-mi-value" t-esc="selectedDoctorName"/>
                                </div>
                            </div>

                            <!-- Quote Summary Table -->
                            <t t-if="state.creationResult.quote_summary">
                                <div class="rb-modal-quote">
                                    <div class="rb-mq-title">Quote Summary</div>
                                    <div class="rb-mq-table">
                                        <div class="rb-mq-header">
                                            <div class="rb-mq-col rb-mq-name">Service</div>
                                            <div class="rb-mq-col rb-mq-qty">Qty</div>
                                            <div class="rb-mq-col rb-mq-price">Unit Price</div>
                                            <div class="rb-mq-col rb-mq-sub">Subtotal</div>
                                        </div>
                                        <t t-foreach="state.creationResult.quote_summary.lines" t-as="line" t-key="line_index">
                                            <div class="rb-mq-row">
                                                <div class="rb-mq-col rb-mq-name" t-esc="line.name"/>
                                                <div class="rb-mq-col rb-mq-qty" t-esc="line.qty"/>
                                                <div class="rb-mq-col rb-mq-price" t-esc="formatCurrency(line.unit_price)"/>
                                                <div class="rb-mq-col rb-mq-sub" t-esc="formatCurrency(line.subtotal)"/>
                                            </div>
                                        </t>
                                        <div class="rb-mq-footer">
                                            <div class="rb-mq-footer-row">
                                                <span>Per booking</span>
                                                <span t-esc="formatCurrency(state.creationResult.quote_summary.total_per_booking)"/>
                                            </div>
                                            <div class="rb-mq-footer-row rb-mq-grand">
                                                <span>x <t t-esc="state.creationResult.count"/> bookings</span>
                                                <span t-esc="formatCurrency(state.creationResult.quote_summary.total_all)"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- Modal Actions -->
                        <div class="rb-modal-actions">
                            <button class="rb-modal-btn rb-modal-delete" t-on-click="deleteBookings">
                                <i class="fa fa-undo"/> Undo &amp; Delete All
                            </button>
                            <button class="rb-modal-btn rb-modal-confirm" t-on-click="viewBookings">
                                <i class="fa fa-list"/> View Bookings
                            </button>
                        </div>
                    </div>
                </div>
            </t>

        </div>
    </div>
</t>

</templates>
