<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_quick_booking_wizard_form" model="ir.ui.view">
        <field name="name">health.quick.booking.wizard.form</field>
        <field name="model">health.quick.booking.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Booking" class="qbw-form">
                <sheet>
                    <!-- Step Progress -->
                    <div class="qbw-stepper">
                        <div class="qbw-step" invisible="current_step != '1_services'">
                            <div class="qbw-step__num qbw-step__num--active">1</div>
                            <span class="qbw-step__label qbw-step__label--active">Services</span>
                        </div>
                        <div class="qbw-step" invisible="current_step == '1_services'">
                            <div class="qbw-step__num qbw-step__num--done"><i class="fa fa-check"/></div>
                            <span class="qbw-step__label qbw-step__label--done">Services</span>
                        </div>
                        <div class="qbw-step__line">
                            <div class="qbw-step__line-fill" invisible="current_step == '1_services'"/>
                        </div>
                        <div class="qbw-step" invisible="current_step == '2_booking'">
                            <div class="qbw-step__num">2</div>
                            <span class="qbw-step__label">Booking</span>
                        </div>
                        <div class="qbw-step" invisible="current_step != '2_booking'">
                            <div class="qbw-step__num qbw-step__num--active">2</div>
                            <span class="qbw-step__label qbw-step__label--active">Booking</span>
                        </div>
                    </div>

                    <field name="current_step" invisible="1"/>

                    <!-- Client Selection -->
                    <div class="qbw-client-bar">
                        <span class="fa fa-user-circle qbw-client-bar__icon"/>
                        <field name="client_id" string="Client"
                               placeholder="Search client by name or phone..."
                               required="1"
                               options="{'no_create_edit': True}"
                               class="qbw-client-bar__field"/>
                    </div>

                    <!-- STEP 1: Services -->
                    <div invisible="current_step != '1_services'">
                        <div class="qbw-section-header">
                            <span class="qbw-section-header__icon fa fa-stethoscope"/>
                            <span class="qbw-section-header__text">Service Requirements</span>
                        </div>

                        <group>
                            <group string="SERVICE SELECTION">
                                <field name="service_category" string="Category"/>
                                <field name="service_type" string="Service Type" required="1"/>
                                <field name="service_subcategory" string="Sub-Category"/>
                                <field name="service_location" string="Service Location"/>
                            </group>
                            <group string="SERVICE NOTES">
                                <field name="service_notes" nolabel="1" placeholder="Additional service requirements..."/>
                            </group>
                        </group>
                    </div>

                    <!-- STEP 2: Booking -->
                    <div invisible="current_step != '2_booking'">
                        <div class="qbw-section-header">
                            <span class="qbw-section-header__icon fa fa-calendar"/>
                            <span class="qbw-section-header__text">Booking Details</span>
                        </div>

                        <group>
                            <group string="LOCATION &amp; FACILITY">
                                <field name="catchment_province_id" string="Catchment Province"/>
                                <field name="facility_id" string="Healthcare Facility" required="1"/>
                            </group>
                            <group string="DATE &amp; TIME">
                                <field name="booking_date" string="Date"/>
                                <field name="booking_time" string="Time" widget="time_picker"/>
                                <field name="booking_duration" string="Duration (Hours)"/>
                            </group>
                        </group>

                        <div class="qbw-notes-section">
                            <div class="qbw-notes-label">
                                <span class="fa fa-pencil-square-o qbw-notes-label__icon"/>
                                Special Instructions
                            </div>
                            <field name="booking_notes" nolabel="1"
                                   placeholder="Any special instructions or notes..."
                                   class="qbw-notes-field"/>
                        </div>
                    </div>

                </sheet>

                <footer>
                    <button name="action_prev_step" type="object"
                            string="&#x2190; Previous" class="btn-secondary"
                            icon="fa-chevron-left"
                            invisible="current_step == '1_services'"/>

                    <button name="action_next_step" type="object"
                            string="Next &#x2192;" class="btn-primary"
                            icon="fa-chevron-right"
                            invisible="current_step == '2_booking'"/>

                    <button name="action_create_booking" type="object"
                            string="&#x2714; Create Booking" class="btn-primary"
                            icon="fa-check-circle"
                            invisible="current_step != '2_booking'"/>

                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
