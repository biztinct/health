#. module: health_fieldservice
#: model:mail.template,body_html:health_fieldservice.email_template_status_update
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"                <div style=\"background: #2563eb; color: white; padding: 20px; text-align: center;\">\n"
"                    <h1 style=\"margin: 0;\">Service Booking Status Update</h1>\n"
"                </div>\n"
"                \n"
"                <div style=\"padding: 30px;\">\n"
"                    <h2>Hello {{ object.patient_id.name }},</h2>\n"
"                    \n"
"                    <p style=\"font-size: 16px; line-height: 1.6;\">\n"
"                        Your service booking status has been updated to: <strong>{{ object.state.title() }}</strong>\n"
"                    </p>\n"
"                    \n"
"                    <div style=\"background: #f1f5f9; padding: 20px; border-radius: 8px; margin: 20px 0;\">\n"
"                        <h3>Booking: {{ object.name }}</h3>\n"
"                        <p><strong>Service:</strong> {{ object.service_type.title() }}</p>\n"
"                        <p><strong>Date:</strong> {{ object.scheduled_datetime.strftime('%A, %B %d, %Y at %I:%M %p') if object.scheduled_datetime else 'To be scheduled' }}</p>\n"
"                        <p><strong>Current Status:</strong> {{ object.state.title() }}</p>\n"
"                    </div>\n"
"                    \n"
"                    <p style=\"color: #6b7280; font-size: 14px;\">\n"
"                        This is an automated update from VAFHS Healthcare System.\n"
"                    </p>\n"
"                </div>\n"
"            </div>\n"
"        "
msgstr ""

#. module: health_fieldservice
#: model:mail.template,body_html:health_fieldservice.email_template_assignment_confirmed
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"                <div style=\"background: linear-gradient(135deg, #2563eb, #059669); color: white; padding: 30px; text-align: center;\">\n"
"                    <h1 style=\"margin: 0; font-size: 28px;\">Assignment Confirmed</h1>\n"
"                    <p style=\"margin: 10px 0 0 0; font-size: 16px;\">Your healthcare appointment has been assigned</p>\n"
"                </div>\n"
"                \n"
"                <div style=\"padding: 30px; background: #f8fafc;\">\n"
"                    <h2 style=\"color: #1e293b; margin-bottom: 20px;\">Hello {{ object.appointment_id.patient_id.name }},</h2>\n"
"                    \n"
"                    <p style=\"font-size: 16px; line-height: 1.6; color: #475569;\">\n"
"                        Great news! Your appointment has been confirmed and assigned to our healthcare professional.\n"
"                    </p>\n"
"                    \n"
"                    <div style=\"background: white; padding: 25px; border-radius: 10px; margin: 25px 0; border-left: 4px solid #059669;\">\n"
"                        <h3 style=\"color: #059669; margin-top: 0;\">Appointment Details</h3>\n"
"                        <table style=\"width: 100%; border-collapse: collapse;\">\n"
"                            <tr>\n"
"                                <td style=\"padding: 8px 0; font-weight: bold; color: #374151;\">Service:</td>\n"
"                                <td style=\"padding: 8px 0; color: #6b7280;\">{{ object.appointment_id.appointment_type_id.name }}</td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 8px 0; font-weight: bold; color: #374151;\">Date &amp; Time:</td>\n"
"                                <td style=\"padding: 8px 0; color: #6b7280;\">{{ object.appointment_id.appointment_date.strftime('%A, %B %d, %Y at %I:%M %p') }}</td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 8px 0; font-weight: bold; color: #374151;\">Assigned Staff:</td>\n"
"                                <td style=\"padding: 8px 0; color: #6b7280;\">{{ ', '.join(object.assigned_staff_ids.mapped('name')) }}</td>\n"
"                            </tr>\n"
"                            <tr t-if=\"object.appointment_id.appointment_type_id.location_type == 'home'\">\n"
"                                <td style=\"padding: 8px 0; font-weight: bold; color: #374151;\">Visit Address:</td>\n"
"                                <td style=\"padding: 8px 0; color: #6b7280;\">{{ object.appointment_id.visit_address }}</td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"                    \n"
"                    <div style=\"background: #dbeafe; padding: 20px; border-radius: 8px; margin: 25px 0;\">\n"
"                        <h4 style=\"color: #1e40af; margin-top: 0;\">What happens next?</h4>\n"
"                        <ul style=\"color: #1e40af; margin: 0; padding-left: 20px;\">\n"
"                            <li>Our healthcare professional will confirm they can handle your appointment</li>\n"
"                            <li>You'll receive updates as your appointment status changes</li>\n"
"                            <li>On the day of service, you'll get real-time tracking updates</li>\n"
"                        </ul>\n"
"                    </div>\n"
"                </div>\n"
"                \n"
"                <div style=\"background: #374151; color: white; padding: 20px; text-align: center;\">\n"
"                    <p style=\"margin: 0; font-size: 14px;\">\n"
"                        Questions? Contact us at <a href=\"tel:+842812345678\" style=\"color: #60a5fa;\">+84 28 1234 5678</a>\n"
"                    </p>\n"
"                    <p style=\"margin: 10px 0 0 0; font-size: 12px; color: #9ca3af;\">\n"
"                        Vietnam-Australia Family Health Service (VAFHS)\n"
"                    </p>\n"
"                </div>\n"
"            </div>\n"
"        "
msgstr ""

