<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== OPS CLIENT LIST VIEW ===== -->
    <record id="view_health_client_list_ops" model="ir.ui.view">
        <field name="name">res.partner.list.ops.clients</field>
        <field name="model">res.partner</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <list js_class="ops_client_list_view"
                  default_order="name asc"
                  class="ops-cl-list"
                  decoration-danger="deleted" decoration-muted="deleted">
                <field name="deleted" column_invisible="1"/>
                <field name="name" string="Client"/>
                <field name="patient_code" string="Patient ID" optional="show"/>
                <field name="mobile" string="Phone" optional="show"/>
                <field name="email" string="Email" optional="hide"/>
                <field name="gender_id" string="Gender" optional="hide"/>
                <field name="primary_facility_id" string="Facility" optional="hide"/>
                <field name="patient_status" string="Status"
                       widget="badge"
                       decoration-success="patient_status == 'active'"
                       decoration-muted="patient_status == 'inactive'"
                       optional="hide"/>
                <field name="last_visit_date" string="Last Visit" optional="show"/>
                <field name="total_assignments" string="Bookings" optional="hide"/>
                <button name="action_create_fso" type="object"
                        string="Book" icon="fa-plus"
                        title="Create Booking"
                        class="ops-cl-btn ops-cl-btn--book"/>
                <button name="action_open_recurring_booking" type="object"
                        string="Recurring" icon="fa-repeat"
                        title="Recurring Booking"
                        class="ops-cl-btn ops-cl-btn--recurring"/>
                <field name="has_pending_collection" column_invisible="True"/>
                <field name="has_outstanding_invoice" column_invisible="True"/>
                <field name="collection_status" column_invisible="True"/>
                <field name="invoice_status" column_invisible="True"/>
                <button name="action_collect_cash" type="object"
                        string="Collect" icon="fa-money"
                        title="Collect Cash — Pending"
                        class="ops-cl-btn ops-cl-btn--danger"
                        invisible="collection_status != 'pending'"/>
                <button name="action_collect_cash" type="object"
                        string="Collect" icon="fa-money"
                        title="Collect Cash — Collected"
                        class="ops-cl-btn ops-cl-btn--success"
                        invisible="collection_status != 'collected'"/>
                <button name="action_collect_cash" type="object"
                        string="Collect" icon="fa-money"
                        title="Collect Cash"
                        class="ops-cl-btn ops-cl-btn--muted"
                        invisible="collection_status != 'none'"/>
                <button name="action_register_client_payment" type="object"
                        string="Payment" icon="fa-credit-card"
                        title="Payment — Unpaid"
                        class="ops-cl-btn ops-cl-btn--danger"
                        invisible="invoice_status != 'unpaid'"/>
                <button name="action_register_client_payment" type="object"
                        string="Payment" icon="fa-credit-card"
                        title="Payment — Paid"
                        class="ops-cl-btn ops-cl-btn--success"
                        invisible="invoice_status != 'paid'"/>
                <button name="action_register_client_payment" type="object"
                        string="Payment" icon="fa-credit-card"
                        title="Payment"
                        class="ops-cl-btn ops-cl-btn--muted"
                        invisible="invoice_status != 'none'"/>
                <!-- Record lifecycle: Delete is a user function, Archive a
                     custodian function (client data-governance spec). -->
                <button name="action_open_delete_wizard" type="object"
                        icon="fa-trash" title="Delete (reason required)"
                        class="ops-cl-btn ops-cl-btn--danger"
                        invisible="deleted"/>
                <button name="action_open_restore_wizard" type="object"
                        icon="fa-undo" title="Restore this deleted record"
                        class="ops-cl-btn ops-cl-btn--success"
                        groups="health_base.group_healthcare_custodian"
                        invisible="not deleted"/>
                <button name="action_open_archive_wizard" type="object"
                        icon="fa-archive" title="Archive (custodian)"
                        class="ops-cl-btn ops-cl-btn--muted"
                        groups="health_base.group_healthcare_custodian"
                        invisible="deleted"/>
            </list>
        </field>
    </record>

    <!-- ===== OPS CLIENT LIST ACTION ===== -->
    <record id="action_ops_client_list_native" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_patient', '=', True), '|', ('deleted', '=', False), ('deleted', '=', True)]</field>
        <field name="context">{'active_center': 'ops_center', 'deleted_test': False}</field>
        <field name="search_view_id" ref="health_base.view_health_patient_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_health_client_list_ops')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_health_patient_form_ops')})]"/>
    </record>

</odoo>
