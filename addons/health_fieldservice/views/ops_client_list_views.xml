<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== OPS CLIENT LIST VIEW ===== -->
    <record id="view_health_client_list_ops" model="ir.ui.view">
        <field name="name">res.partner.list.ops.clients</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list js_class="ops_client_list_view"
                  default_order="name asc"
                  class="ops-cl-list">
                <field name="name" string="Client"/>
                <field name="patient_code" string="Patient ID" optional="show"/>
                <field name="mobile" string="Phone" optional="show"/>
                <field name="email" string="Email" optional="hide"/>
                <field name="gender" string="Gender" optional="hide"/>
                <field name="primary_facility_id" string="Facility" optional="hide"/>
                <field name="patient_status" string="Status"
                       widget="badge"
                       decoration-success="patient_status == 'active'"
                       decoration-muted="patient_status == 'inactive'"
                       optional="hide"/>
                <field name="last_visit_date" string="Last Visit" optional="show"/>
                <field name="total_assignments" string="Bookings" optional="hide"/>
                <button name="action_create_fso" type="object"
                        string="Book" icon="fa-plus"
                        class="ops-cl-btn ops-cl-btn--book"/>
                <button name="action_open_recurring_booking" type="object"
                        string="Recurring" icon="fa-repeat"
                        class="ops-cl-btn ops-cl-btn--recurring"/>
                <button name="action_collect_cash" type="object"
                        string="Collect" icon="fa-money"
                        class="ops-cl-btn ops-cl-btn--collect"/>
                <button name="action_register_client_payment" type="object"
                        string="Payment" icon="fa-credit-card"
                        class="ops-cl-btn ops-cl-btn--payment"/>
            </list>
        </field>
    </record>

    <!-- ===== OPS CLIENT LIST ACTION ===== -->
    <record id="action_ops_client_list_native" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_patient', '=', True)]</field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="health_base.view_health_patient_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_health_client_list_ops')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_health_patient_form_ops')})]"/>
    </record>

</odoo>
