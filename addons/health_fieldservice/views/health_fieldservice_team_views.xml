<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Team Form View -->
    <record id="view_health_fieldservice_team_form" model="ir.ui.view">
        <field name="name">health.fieldservice.team.form</field>
        <field name="model">health.fieldservice.team</field>
        <field name="arch" type="xml">
            <form string="Field Service Team">
                <sheet>
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="users-group"/>
                            <div>
                                <span>Team Overview</span>
                                <small class="text-muted d-block">Leadership and performance</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <group col="2">
                                    <field name="name"/>
                                    <field name="leader_id"/>
                                    <field name="active"/>
                                </group>
                            </div>
                            <div class="vu-card">
                                <group col="2">
                                    <field name="current_fso_count"/>
                                    <field name="completed_fso_count"/>
                                    <field name="team_efficiency" widget="progressbar"/>
                                </group>
                            </div>
                        </div>
                    </div>
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="file-text"/>
                            <div>
                                <span>Description</span>
                                <small class="text-muted d-block">Team focus and specialization</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <field name="description"/>
                            </div>
                        </div>
                    </div>
                    <notebook>
                        <page string="Team Members">
                            <field name="member_ids" widget="many2many_tags"/>
                            <field name="healthcare_staff_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Service Areas">
                            <field name="service_area_ids"/>
                            <field name="service_type_ids"/>
                        </page>
                        <page string="Equipment">
                            <field name="equipment_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Team List View -->
    <record id="view_health_fieldservice_team_list" model="ir.ui.view">
        <field name="name">health.fieldservice.team.list</field>
        <field name="model">health.fieldservice.team</field>
        <field name="arch" type="xml">
            <list string="Field Service Teams">
                <field name="name"/>
                <field name="leader_id"/>
                <field name="current_fso_count"/>
                <field name="team_efficiency" widget="progressbar"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Team Action -->
    <record id="action_health_fieldservice_team" model="ir.actions.act_window">
        <field name="name">Field Service Teams</field>
        <field name="res_model">health.fieldservice.team</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No field service teams found!
            </p>
            <p>
                Create field service teams to organize healthcare staff for home visit operations.
                Teams can have assigned service areas, equipment, and specialized capabilities.
            </p>
        </field>
    </record>

</odoo>
