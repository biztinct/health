<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Equipment Form View -->
    <record id="view_health_portable_equipment_form" model="ir.ui.view">
        <field name="name">health.portable.equipment.form</field>
        <field name="model">health.portable.equipment</field>
        <field name="arch" type="xml">
            <form string="Portable Medical Equipment">
                <header>
                    <button name="action_mark_in_use" type="object" 
                            string="Mark In Use" class="oe_highlight"
                            invisible="status != 'available'"/>
                    
                    <button name="action_mark_available" type="object" 
                            string="Mark Available" class="oe_highlight"
                            invisible="status != 'in_use'"/>
                    
                    <button name="action_schedule_maintenance" type="object" 
                            string="Schedule Maintenance"
                            invisible="status == 'maintenance'"/>
                    
                    <field name="status" widget="statusbar"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_service_history" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Service History</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="stethoscope"/>
                            <div>
                                <span>Equipment Overview</span>
                                <small class="text-muted d-block">Asset details and assignment status</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="file-text"/>
                                    <span>Equipment Information</span>
                                </div>
                                <group col="2">
                                    <field name="name"/>
                                    <field name="equipment_type"/>
                                    <field name="category"/>
                                    <field name="manufacturer"/>
                                    <field name="model_number"/>
                                    <field name="serial_number"/>
                                </group>
                            </div>
                            
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="users-group"/>
                                    <span>Current Status</span>
                                </div>
                                <group col="2">
                                    <field name="current_fso_id" readonly="1"/>
                                    <field name="assigned_team_id"/>
                                    <field name="assigned_staff_id"/>
                                    <field name="usage_count" readonly="1"/>
                                    <field name="total_usage_hours" readonly="1"/>
                                </group>
                            </div>
                        </div>
                    </div>
                    
                    <notebook>
                        <page string="Specifications" name="specs">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="activity"/>
                                    <div>
                                        <span>Specifications</span>
                                        <small class="text-muted d-block">Physical and power details</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="timeline"/>
                                            <span>Physical</span>
                                        </div>
                                        <group>
                                            <field name="weight_kg"/>
                                            <field name="dimensions"/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="activity"/>
                                            <span>Power</span>
                                        </div>
                                        <group>
                                            <field name="power_source"/>
                                            <field name="battery_life_hours"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>
                        
                        <page string="Maintenance" name="maintenance">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="life-ring"/>
                                    <div>
                                        <span>Maintenance &amp; Calibration</span>
                                        <small class="text-muted d-block">Schedules and compliance</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="timeline"/>
                                            <span>Maintenance Schedule</span>
                                        </div>
                                        <group col="2">
                                            <field name="last_maintenance_date"/>
                                            <field name="next_maintenance_date"/>
                       	                    <field name="maintenance_interval_days"/>
                                            <field name="is_maintenance_due" widget="boolean_toggle"/>
                                            <field name="days_until_maintenance"/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="activity"/>
                                            <span>Calibration</span>
                                        </div>
                                        <group>
                                            <field name="calibration_due_date"/>
                                            <field name="calibration_interval_days"/>
                                            <field name="is_calibration_due" widget="boolean_toggle"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>
                        
                        <page string="Compliance" name="compliance">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="file-text"/>
                                    <div>
                                        <span>Compliance &amp; Financials</span>
                                        <small class="text-muted d-block">Certification and purchase data</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="shield"/>
                                            <span>Certification</span>
                                        </div>
                                        <group>
                                            <field name="certification_number"/>
                                            <field name="certification_expiry"/>
                                            <field name="regulatory_approval"/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="credit-card"/>
                                            <span>Financial</span>
                                        </div>
                                        <group>
                                            <field name="purchase_date"/>
                                            <field name="purchase_cost"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>
                        
                        <page string="Service Requirements" name="services">
                            <field name="required_for_service_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Equipment List View -->
    <record id="view_health_portable_equipment_list" model="ir.ui.view">
        <field name="name">health.portable.equipment.list</field>
        <field name="model">health.portable.equipment</field>
        <field name="arch" type="xml">
            <list string="Portable Medical Equipment" decoration-muted="deleted" decoration-danger="deleted">
                <field name="name"/>
                <field name="equipment_type"/>
                <field name="status" decoration-success="status == 'available'"
                       decoration-warning="status == 'in_use'"
                       decoration-danger="status in ['maintenance', 'repair']"/>
                <field name="assigned_team_id"/>
                <field name="current_fso_id"/>
                <field name="is_maintenance_due" decoration-danger="is_maintenance_due"/>
                <field name="usage_count"/>
                <field name="active"/>
                            <!-- Record lifecycle: Delete (user) / Archive (custodian) -->
                <field name="deleted" column_invisible="1"/>
                <button name="action_open_delete_wizard" type="object"
                        icon="fa-trash" title="Delete (reason required)"
                        invisible="deleted"/>
                <button name="action_open_restore_wizard" type="object"
                        icon="fa-undo" title="Restore this deleted record"
                        groups="health_base.group_healthcare_custodian"
                        invisible="not deleted"/>
                <button name="action_open_archive_wizard" type="object"
                        icon="fa-archive" title="Archive (custodian)"
                        groups="health_base.group_healthcare_custodian"
                        invisible="deleted"/>
</list>
        </field>
    </record>

    <!-- Equipment Search View -->
    <record id="view_health_portable_equipment_search" model="ir.ui.view">
        <field name="name">health.portable.equipment.search</field>
        <field name="model">health.portable.equipment</field>
        <field name="arch" type="xml">
            <search string="Equipment Search">
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Equipment Action -->
    <record id="action_health_portable_equipment" model="ir.actions.act_window">
        <field name="name">Portable Medical Equipment</field>
        <field name="res_model">health.portable.equipment</field>
        <field name="domain">['|', ('deleted', '=', False), ('deleted', '=', True)]</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_health_portable_equipment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No portable medical equipment found!
            </p>
            <p>
                Create and manage portable medical equipment used for field service visits.
                Track equipment status, maintenance schedules, and assignment to field teams.
            </p>
        </field>
    </record>

</odoo>
