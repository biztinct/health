<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Stage List View -->
    <record id="view_health_fieldservice_stage_list" model="ir.ui.view">
        <field name="name">health.fieldservice.stage.list</field>
        <field name="model">health.fieldservice.stage</field>
        <field name="arch" type="xml">
            <list string="Field Service Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="color" widget="color_picker"/>
                <field name="is_closed"/>
                <field name="allow_edit"/>
                <field name="fso_count"/>
            </list>
        </field>
    </record>

    <!-- Stage Form View -->
    <record id="view_health_fieldservice_stage_form" model="ir.ui.view">
        <field name="name">health.fieldservice.stage.form</field>
        <field name="model">health.fieldservice.stage</field>
        <field name="arch" type="xml">
            <form string="Field Service Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="is_closed"/>
                            <field name="is_default"/>
                            <field name="allow_edit"/>
                            <field name="fold"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Stage Action -->
    <record id="action_health_fieldservice_stage" model="ir.actions.act_window">
        <field name="name">Field Service Stages</field>
        <field name="res_model">health.fieldservice.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No field service stages found!
            </p>
            <p>
                Configure stages for field service order workflow.
                Stages define the progression from draft creation to service completion.
            </p>
        </field>
    </record>

</odoo>