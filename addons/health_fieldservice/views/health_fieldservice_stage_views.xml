<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Stage Form View -->
    <record id="view_health_fieldservice_stage_form" model="ir.ui.view">
        <field name="name">health.fieldservice.stage.form</field>
        <field name="model">health.fieldservice.stage</field>
        <field name="arch" type="xml">
            <form string="Booking Stage Configuration">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_fsos" type="object" class="oe_stat_button" icon="fa-tasks" invisible="fso_count == 0">
                            <field name="fso_count" widget="statinfo" string="Bookings"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="o_text_overflow" placeholder="Stage Name"/>
                        </h1>
                    </div>
                    
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="timeline"/>
                            <div>
                                <span>Stage Configuration</span>
                                <small class="text-muted d-block">State mapping and visual behavior</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="file-text"/>
                                    <span>Basic Information</span>
                                </div>
                                <group col="2">
                                    <field name="sequence"/>
                                    <field name="state" widget="selection"/>
                                    <field name="active"/>
                                    <field name="is_default"/>
                                </group>
                            </div>
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="activity"/>
                                    <span>Visual Settings</span>
                                </div>
                                <group col="2">
                                    <field name="color"/>
                                    <field name="fold"/>
                                    <field name="is_closed"/>
                                    <field name="allow_edit"/>
                                </group>
                            </div>
                        </div>
                    </div>
                    
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="alert-triangle"/>
                            <div>
                                <span>Stage Requirements</span>
                                <small class="text-muted d-block">Operational prerequisites</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <group>
                                    <field name="require_quote"/>
                                    <field name="require_quote_items"/>
                                </group>
                            </div>
                            <div class="vu-card">
                                <group>
                                    <field name="require_staff_assignment"/>
                                    <field name="require_patient_contact"/>
                                </group>
                            </div>
                        </div>
                    </div>
                    
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="file-text"/>
                            <div>
                                <span>Description</span>
                                <small class="text-muted d-block">Guidance for dispatch teams</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <field name="description" nolabel="1" placeholder="Describe what happens in this stage..."/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Stage List View -->
    <record id="view_health_fieldservice_stage_list" model="ir.ui.view">
        <field name="name">health.fieldservice.stage.list</field>
        <field name="model">health.fieldservice.stage</field>
        <field name="arch" type="xml">
            <list string="Booking Stages" default_order="sequence,name" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state" widget="selection" readonly="0"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-primary="state == 'assigned'"
                       decoration-success="state in ['in_progress', 'completed']"
                       decoration-muted="state in ['cancelled', 'closed']"/>
                <field name="require_quote" widget="boolean_toggle"/>
                <field name="require_quote_items" widget="boolean_toggle"/>
                <field name="require_staff_assignment" widget="boolean_toggle"/>
                <field name="fso_count" string="Bookings"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="color"/>
            </list>
        </field>
    </record>

    <!-- Stage Action -->
    <record id="action_health_fieldservice_stage" model="ir.actions.act_window">
        <field name="name">Booking Stages</field>
        <field name="res_model">health.fieldservice.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Booking stage!
            </p>
            <p>
                Configure stages to define your field service workflow. Each stage can have:
                <ul>
                    <li>State mapping for backend logic</li>
                    <li>Requirements (quotes, staff, etc.)</li>
                    <li>Visual settings for kanban view</li>
                </ul>
            </p>
        </field>
    </record>

</odoo>
