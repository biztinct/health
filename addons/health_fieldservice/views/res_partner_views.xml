<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_fso_buttons" model="ir.ui.view">
        <field name="name">res.partner.form.fso.buttons</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="health_base.view_health_patient_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_create_fso"
                        type="object"
                        string="Booking"
                        class="btn-primary"
                        invisible="not is_patient"/>
            </header>
        </field>
    </record>

    <record id="view_partner_form_fso_stats" model="ir.ui.view">
        <field name="name">res.partner.form.fso.stats</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="health_base.view_health_patient_form"/>
        <field name="arch" type="xml">
            <page name="service_history" position="inside">
                <!-- Client Timeline Section -->
                <group string="Client Timeline" invisible="not is_patient">
                    <field name="timeline_html" widget="html" readonly="1" nolabel="1"/>
                </group>

                <!-- Service History Summary -->
                <group string="Service History Summary" invisible="not is_patient">
                    <group>
                        <field name="total_assignments" readonly="1"/>
                        <field name="last_assignment_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="preferred_staff_id"/>
                        <field name="assignment_notes" placeholder="Special assignment notes (accessibility, language, etc.)"/>
                    </group>
                </group>
            </page>
        </field>
    </record>

    <!-- Smart button for FSO count - REMOVED: Duplicate of health_base smart button -->

</odoo>