<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Professional Staff Assignment Timeline View using web_timeline -->
    <record id="health_staff_assignment_timeline_view" model="ir.ui.view">
        <field name="name">Staff Assignment Timeline</field>
        <field name="model">health.staff.assignment</field>
        <field name="type">timeline</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <timeline date_start="planned_start_time"
                      date_stop="planned_end_time"
                      string="display_name"
                      default_group_by="staff_id"
                      event_open_popup="true"
                      create="true"
                      quick_create="false"
                      mode="day"
                      stack="true"
                      domain="[('state', '!=', 'template')]"
                      context="{'default_fso_id': context.get('default_fso_id'), 'default_assignment_date': context.get('default_assignment_date'), 'date': context.get('date'), 'initial_date': context.get('initial_date')}">
                
                <!-- Timeline Fields - fso_id listed first to ensure context works -->
                <field name="fso_id"/>
                <field name="name"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="staff_id"/>
                <field name="assignment_role"/>
                <field name="assignment_type"/>
                <field name="assignment_date"/>
                <field name="display_name"/>
                <field name="patient_name"/>
                <field name="planned_start_time"/>
                <field name="planned_end_time"/>
                <field name="predicted_duration"/>
                <field name="formatted_datetime"/>
                <field name="formatted_time"/>
                <field name="fso_duration_minutes"/>
                
                <templates>
                    <t t-name="timeline-item">

        <div class="hf-wt-card">
            <div class="hf-wt-title"><t t-esc="record.patient_name or 'Client'"/></div>
            <div class="hf-wt-meta">
                <t t-set="dur" t-value="record.fso_duration_minutes or 0"/>
                <span><t t-esc="record.formatted_time"/> (<t t-esc="dur"/> min)</span>
            </div>
        </div>
                    </t>
                </templates>
                
            </timeline>
        </field>
    </record>

    <!-- Professional Staff Assignment List View -->
    <record id="health_staff_assignment_list_view" model="ir.ui.view">
        <field name="name">Staff Assignment List</field>
        <field name="model">health.staff.assignment</field>
        <field name="type">list</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <list string="Staff Assignments" default_order="assignment_date desc" create="true">
                <field name="name"/>
                <field name="assignment_date"/>
                <field name="staff_id"/>
                <field name="assignment_role"/>
                <field name="state" decoration-success="state=='completed'" decoration-warning="state=='assigned'" decoration-danger="state=='cancelled'"/>
                <field name="priority"/>
                <field name="fso_id"/>
                <field name="assignment_type"/>
            </list>
        </field>
    </record>

    <!-- Professional Staff Assignment Form View -->
    <record id="health_staff_assignment_form_view" model="ir.ui.view">
        <field name="name">Staff Assignment Form</field>
        <field name="model">health.staff.assignment</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="Staff Assignment" class="o_form_view o_form_noheader health_staff_assignment_modal">
                <header>
                    <button name="action_assign_staff" type="object" string="Assign Staff" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_confirm_assignment" type="object" string="Confirm" class="oe_highlight" invisible="state != 'assigned'"/>
                    <!-- Start button hidden as per user request -->
                    <button name="action_start_assignment" type="object" string="Start" class="oe_highlight" invisible="1"/>
                    <button name="action_complete_assignment" type="object" string="Complete" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <!-- Cancel button hidden as per user request -->
                    <button name="action_cancel_assignment" type="object" string="Cancel" invisible="1"/>
                    <button name="action_confirm_date_change" type="object" string="⚠️ Confirm Date Change" class="btn-warning" invisible="1" help="Show confirmation about booking and assignment date changes"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,confirmed,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="patient_name" readonly="1"/>
                        </h1>
                        <div class="text-muted">
                            <field name="name" readonly="1" class="text-muted"/>
                        </div>
                    </div>
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="users-group"/>
                            <div>
                                <span>Assignment Details</span>
                                <small class="text-muted d-block">Booking, schedule and staff context</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="file-text"/>
                                    <span>Assignment Information</span>
                                </div>
                                <group col="2">
                                    <field name="fso_id" options="{'no_create': True}"/>
                                    <field name="assignment_date"/>
                                    <field name="assignment_type"/>
                                    <field name="priority"/>
                                </group>
                            </div>
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="users-group"/>
                                    <span>Staff Information</span>
                                </div>
                                <group col="2">
                                    <field name="staff_id" options="{'no_create': True}"/>
                                    <field name="assignment_role"/>
                                    <field name="assigned_by" readonly="1"/>
                                </group>
                            </div>
                        </div>
                    </div>
                    <notebook>
                    </notebook>
                </sheet>
                <!-- Odoo 18 Standard Chatter -->
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

</odoo>
