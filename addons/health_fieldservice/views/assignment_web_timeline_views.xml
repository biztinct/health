<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Professional Staff Assignment Timeline View using web_timeline -->
    <record id="health_staff_assignment_timeline_view" model="ir.ui.view">
        <field name="name">Staff Assignment Timeline</field>
        <field name="model">health.staff.assignment</field>
        <field name="type">timeline</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <timeline date_start="planned_start_time"
                      date_stop="planned_end_time"
                      string="display_name"
                      default_group_by="staff_id"
                      event_open_popup="true"
                      create="true"
                      quick_create="false"
                      mode="month"
                      stack="true"
                      domain="[('state', '!=', 'template')]"
                      colors="#cbd5e1:state == 'draft';#93c5fd:state == 'assigned';#7dd3fc:state == 'confirmed';#86efac:state == 'in_progress';#5eead4:state == 'completed';#fca5a5:state == 'cancelled';#fcd34d:state == 'deferred'"
                      context="{'default_fso_id': context.get('default_fso_id'), 'default_assignment_date': context.get('default_assignment_date'), 'date': context.get('date'), 'initial_date': context.get('initial_date')}">
                
                <!-- Timeline Fields - fso_id listed first to ensure context works -->
                <field name="fso_id"/>
                <field name="name"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="staff_id"/>
                <field name="assignment_role"/>
                <field name="assignment_type"/>
                <field name="assignment_date"/>
                <field name="display_name"/>
                <field name="patient_name"/>
                <field name="patient_code"/>
                <field name="patient_initials"/>
                <field name="avatar_hue"/>
                <field name="state_label"/>
                <field name="type_label"/>
                <field name="formatted_duration"/>
                <field name="planned_start_time"/>
                <field name="planned_end_time"/>
                <field name="predicted_duration"/>
                <field name="formatted_datetime"/>
                <field name="formatted_time"/>
                <field name="fso_duration_minutes"/>
                
                <templates>
                    <t t-name="timeline-item">
        <div t-attf-class="hf-wt-card hf-state-#{record.state} #{record.priority == '4' ? 'hf-prio-emergency' : ''}">
            <div class="hf-wt-row">
                <span t-attf-class="hf-wt-avatar hf-av-#{record.avatar_hue or '0'}"><t t-esc="record.patient_initials or '?'"/></span>
                <span class="hf-wt-title"><t t-esc="record.patient_name or 'Client'"/></span>
                <span class="hf-wt-end">
                    <t t-if="record.priority == '4'">
                        <span class="hf-wt-prio hf-prio-c-emergency">Emergency</span>
                    </t>
                    <t t-elif="record.priority == '3'">
                        <span class="hf-wt-prio hf-prio-c-urgent">Urgent</span>
                        <span class="hf-wt-status hf-wt-status-compact"><span class="hf-wt-dot"></span></span>
                    </t>
                    <t t-elif="record.priority == '2'">
                        <span class="hf-wt-prio hf-prio-c-high">High</span>
                        <span class="hf-wt-status hf-wt-status-compact"><span class="hf-wt-dot"></span></span>
                    </t>
                    <t t-else="">
                        <span class="hf-wt-status">
                            <t t-if="record.state == 'completed'"><span class="hf-wt-ico hf-ico-check"></span></t>
                            <t t-else=""><span class="hf-wt-dot"></span></t>
                            <span class="hf-wt-status-label"><t t-esc="record.state_label"/></span>
                        </span>
                    </t>
                </span>
            </div>
            <div class="hf-wt-meta">
                <span class="hf-wt-ico hf-ico-clock"></span>
                <span class="hf-wt-time"><t t-esc="record.formatted_time"/></span>
                <span class="hf-wt-sep">·</span>
                <span class="hf-wt-dur"><t t-esc="record.formatted_duration"/></span>
                <span t-attf-class="hf-wt-type hf-type-#{record.assignment_type}">
                    <span class="hf-wt-ico hf-wt-type-ico"></span>
                    <span class="hf-wt-type-label"><t t-esc="record.type_label"/></span>
                </span>
            </div>
            <div class="hf-wt-code" t-if="record.patient_code"><t t-esc="record.patient_code"/></div>
        </div>
                    </t>
                </templates>
                
            </timeline>
        </field>
    </record>

</odoo>
