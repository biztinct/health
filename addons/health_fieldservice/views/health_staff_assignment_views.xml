<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- =====================================================================
         Staff Assignment Form View - Clean Odoo 18 Layout
         ===================================================================== -->

    <record id="view_health_staff_assignment_form" model="ir.ui.view">
        <field name="name">health.staff.assignment.form</field>
        <field name="model">health.staff.assignment</field>
        <field name="arch" type="xml">
            <form string="Staff Assignment" class="o_form_view">
                <header>
                    <button name="action_confirm_assignment" 
                            type="object" 
                            string="Confirm Assignment" 
                            class="oe_highlight" 
                            invisible="state != 'assigned'"/>
                    
                    <button name="action_start_assignment" 
                            type="object" 
                            string="Start Assignment" 
                            class="oe_highlight" 
                            invisible="state != 'confirmed'"/>
                    
                    <button name="action_complete_assignment" 
                            type="object" 
                            string="Complete Assignment" 
                            class="oe_highlight" 
                            invisible="state != 'in_progress'"/>
                    
                    <button name="action_cancel_assignment" 
                            type="object" 
                            string="Cancel" 
                            confirm="Are you sure you want to cancel this assignment?"
                            invisible="state in ('completed', 'cancelled')"/>
                    
                    <button name="action_apply_ai_optimization" 
                            type="object" 
                            string="🤖 Apply AI Optimization" 
                            class="btn-secondary" 
                            invisible="state not in ('draft', 'assigned')"
                            groups="health_base.group_healthcare_operations_manager"
                            help="Use AI to optimize this assignment with the best staff recommendations"/>
                    
                    <button name="action_get_ai_predictions" 
                            type="object" 
                            string="📊 Get AI Predictions" 
                            class="btn-info" 
                            invisible="state in ('completed', 'cancelled')"
                            groups="health_base.group_healthcare_operations_manager"
                            help="Generate AI predictions for assignment complexity and duration"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,confirmed,in_progress,completed"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" placeholder="Assignment Reference"/>
                        </h1>
                        <div class="o_row">
                            <field name="priority" widget="priority"/>
                        </div>
                    </div>

                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="users-group"/>
                            <div>
                                <span>Assignment Overview</span>
                                <small class="text-muted d-block">Booking link, assignment type and staff</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="file-text"/>
                                    <span>Assignment Information</span>
                                </div>
                                <group col="2">
                                    <field name="fso_id"
                                           options="{'no_create': True}"
                                           readonly="1"/>
                                    <field name="assignment_date" required="1"/>
                                    <field name="assignment_type"/>
                                    <field name="assigned_by" readonly="1" groups="base.group_user"/>
                                </group>
                            </div>
                            
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="users-group"/>
                                    <span>Staff Assignment</span>
                                </div>
                                <group col="2">
                                    <field name="staff_id"
                                           options="{'no_create': True, 'no_edit': True}"
                                           domain="[('is_healthcare_staff', '=', True), ('employment_status', '=', 'active')]"
                                           placeholder="Unassigned - Drag to assign in timeline view"/>
                                    <field name="assignment_role"/>
                                    <field name="staff_confirmed_date" readonly="1" invisible="not staff_confirmed_date"/>
                                </group>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Location and Travel" name="location" invisible="assignment_type != 'home_visit'">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="map-pin"/>
                                    <div>
                                        <span>Location and Travel</span>
                                        <small class="text-muted d-block">Origin, destination and route insights</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="map-pin"/>
                                            <span>Location Details</span>
                                        </div>
                                        <group>
                                            <field name="origin_location" placeholder="Staff starting location"/>
                                            <field name="destination_location" placeholder="Patient address"/>
                                            <field name="current_location" readonly="1"/>
                                            <field name="location_last_updated" readonly="1"/>
                                        </group>
                                    </div>
                                    
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="timeline"/>
                                            <span>Travel Planning</span>
                                        </div>
                                        <group>
                                            <field name="estimated_travel_time" widget="float_time"/>
                                            <field name="estimated_travel_distance"/>
                                            <field name="departure_time"/>
                                            <field name="arrival_time"/>
                                            <field name="traffic_factor"/>
                                        </group>
                                    </div>
                                </div>
                                
                                <div class="vu-card" invisible="not optimal_route_json">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="timeline"/>
                                        <span>Route Optimization</span>
                                    </div>
                                    <group>
                                        <field name="optimal_route_json" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                                    </group>
                                </div>
                            </div>
                        </page>

                        <page string="Tracking and Timeline" name="tracking">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="timeline"/>
                                    <div>
                                        <span>Tracking and Timeline</span>
                                        <small class="text-muted d-block">Actual timestamps and quality metrics</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="timeline"/>
                                            <span>Actual Timeline</span>
                                        </div>
                                        <group>
                                            <field name="actual_departure_time" readonly="1"/>
                                            <field name="actual_arrival_time" readonly="1"/>
                                            <field name="actual_completion_time" readonly="1"/>
                                            <field name="real_time_status" widget="badge"/>
                                        </group>
                                    </div>
                                    
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="heart-pulse"/>
                                            <span>Quality Assessment</span>
                                        </div>
                                        <group>
                                            <field name="patient_satisfaction" widget="progressbar"/>
                                            <field name="staff_performance_rating" widget="progressbar"/>
                                            <field name="buffer_before"/>
                                            <field name="buffer_after"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <page string="🤖 AI Insights" name="ai_insights" groups="health_base.group_healthcare_operations_manager">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="timeline"/>
                                    <div>
                                        <span>AI Insights</span>
                                        <small class="text-muted d-block">Optimization signals, recommendations and quick actions</small>
                                    </div>
                                </div>
                                <div class="alert alert-info" role="alert" invisible="ml_optimization_applied">
                                    <i class="fa fa-lightbulb-o" title="AI tip"/> <strong>AI Optimization Available!</strong><br/>
                                    Click "Apply AI Optimization" above to get the best staff recommendations powered by machine learning.
                                </div>
                                
                                <div class="alert alert-success" role="alert" invisible="not ml_optimization_applied">
                                    <i class="fa fa-check-circle" title="AI optimized"/> <strong>AI Optimized Assignment</strong><br/>
                                    This assignment has been optimized using AI/ML algorithms for best results.
                                </div>
                                
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="activity"/>
                                            <span>AI Assignment Intelligence</span>
                                        </div>
                                        <group>
                                            <field name="ai_assignment_score" widget="progressbar" 
                                                   help="Overall AI assessment of assignment quality (0-100%)"/>
                                            <field name="assignment_confidence" widget="progressbar"
                                                   help="AI confidence in assignment success (0-100%)"/>
                                            <field name="predicted_success_probability" widget="progressbar"
                                                   help="ML predicted probability of successful completion"/>
                                            <field name="predicted_complexity" widget="badge"
                                                   help="AI assessment of assignment complexity level"/>
                                            <field name="predicted_duration" widget="float_time"
                                                   help="AI predicted duration for this assignment"/>
                                        </group>
                                    </div>
                                    
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="timeline"/>
                                            <span>ML Optimization Status</span>
                                        </div>
                                        <group>
                                            <field name="ml_optimization_applied" widget="boolean_toggle"
                                                   help="Whether ML optimization has been applied"/>
                                            <field name="optimization_timestamp" readonly="1"
                                                   help="When AI optimization was last applied"/>
                                            <field name="required_skills_json" widget="ace" options="{'mode': 'json'}" readonly="1"
                                                   invisible="not required_skills_json"/>
                                            <field name="staff_skills_match" widget="ace" options="{'mode': 'json'}" readonly="1"
                                                   invisible="not staff_skills_match"/>
                                        </group>
                                    </div>
                                </div>
                                
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="users-group"/>
                                            <span>Optimal Staff Suggestions</span>
                                        </div>
                                        <group>
                                            <field name="optimal_staff_suggestions" widget="ace" options="{'mode': 'json'}" 
                                                   placeholder="💭 AI-generated staff suggestions will appear here after optimization. Click 'Apply AI Optimization' to get recommendations."/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="file-text"/>
                                            <span>Optimization Insights</span>
                                        </div>
                                        <group>
                                            <field name="optimization_suggestions" widget="ace" options="{'mode': 'json'}" 
                                                   placeholder="💡 Optimization recommendations and insights will appear here after AI analysis."/>
                                        </group>
                                    </div>
                                </div>
                                
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="timeline"/>
                                        <span>Quick Actions</span>
                                    </div>
                                    <div class="d-flex gap-3 flex-wrap">
                                        <button name="action_apply_ai_optimization" type="object" 
                                                string="🤖 Apply AI Optimization" class="btn btn-primary"
                                                invisible="state not in ('draft', 'assigned')"
                                                help="Apply AI optimization to get the best staff recommendations"/>
                                        <button name="action_get_ai_predictions" type="object" 
                                                string="📊 Update AI Predictions" class="btn btn-secondary"
                                                invisible="state in ('completed', 'cancelled')"
                                                help="Generate fresh AI predictions for this assignment"/>
                                    </div>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>

                <!-- Odoo 18 Standard Chatter -->
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- Simple List View -->
    <record id="view_health_staff_assignment_list" model="ir.ui.view">
        <field name="name">health.staff.assignment.list</field>
        <field name="model">health.staff.assignment</field>
        <field name="arch" type="xml">
            <list string="Staff Assignments">
                <field name="name"/>
                <field name="fso_id"/>
                <field name="assignment_date"/>
                <field name="staff_id"/>
                <field name="assignment_role"/>
                <field name="state" decoration-success="state=='completed'" decoration-warning="state=='assigned'" decoration-danger="state=='cancelled'"/>
                <field name="priority"/>
                <field name="assignment_score" widget="percentage"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_health_staff_assignment_search" model="ir.ui.view">
        <field name="name">health.staff.assignment.search</field>
        <field name="model">health.staff.assignment</field>
        <field name="arch" type="xml">
            <search string="Staff Assignment Search">
                <field name="name"/>
                <field name="fso_id" filter_domain="[('fso_id.name', 'ilike', self)]"/>
                <field name="staff_id"/>
                <field name="assignment_role"/>
                
                <filter string="My Assignments" name="my_assignments" 
                        domain="[('staff_id.user_id', '=', uid)]"/>
                <filter string="High Priority" name="high_priority" 
                        domain="[('priority', 'in', ['2', '3', '4'])]"/>
                <filter string="Today" name="today" 
                        domain="[('assignment_date', '>=', context_today()), ('assignment_date', '&lt;', (context_today() + datetime.timedelta(days=1)))]"/>
                
                <separator/>
                
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Assigned" name="assigned" domain="[('state', '=', 'assigned')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                
                <group expand="0" string="Group By">
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Priority" name="group_by_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Assignment Date" name="group_by_date" context="{'group_by': 'assignment_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Staff Assignment -->
    <record id="action_health_staff_assignment" model="ir.actions.act_window">
        <field name="name">Staff Assignments</field>
        <field name="res_model">health.staff.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_health_staff_assignment_search"/>
        <field name="domain">[('state', '!=', 'template')]</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No staff assignments found!
            </p>
            <p>
                Staff assignments are created when appointments are approved.
                Create assignments to manage staff workload and track assignment performance.
            </p>
        </field>
    </record>

</data>
</odoo>
