<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Booking Cancellation Wizard Form View -->
    <record id="view_health_booking_cancel_wizard_form" model="ir.ui.view">
        <field name="name">health.booking.cancel.wizard.form</field>
        <field name="model">health.booking.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Booking">
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not show_invoice_warning">
                        <p><strong>Warning:</strong> This booking has an associated invoice. The draft invoice will be cancelled automatically.</p>
                    </div>

                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="timeline"/>
                            <div>
                                <span>Booking Information</span>
                                <small class="text-muted d-block">Reference, patient and schedule</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <group col="2">
                                    <field name="booking_reference"/>
                                    <field name="patient_name"/>
                                    <field name="scheduled_datetime"/>
                                    <field name="booking_id" invisible="1"/>
                                    <field name="show_invoice_warning" invisible="1"/>
                                </group>
                            </div>
                        </div>
                    </div>

                    <!-- WHO CANCELLED Section -->
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="users-group"/>
                            <div>
                                <span>WHO CANCELLED?</span>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <group col="2">
                                    <field name="canceller_name" placeholder="e.g., Mrs. Nguyen, Son of patient..."
                                           help="Name of person who requested the cancellation"/>
                                    <field name="canceller_relationship" 
                                           help="Relationship to the client"/>
                                </group>
                            </div>
                            <div class="vu-card">
                                <group col="2">
                                    <field name="reported_by" placeholder="Name of staff who took the call..."
                                           help="Name of staff who received the cancellation request"/>
                                    <field name="reporter_position" placeholder="e.g., Receptionist, OM..."
                                           help="Position or role of the staff"/>
                                </group>
                            </div>
                        </div>
                    </div>

                    <!-- Last Staff Field -->
                    <group>
                        <field name="last_staff_id" readonly="1"
                               help="Staff who last visited this client"/>
                    </group>

                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="alert-triangle"/>
                            <div>
                                <span>Cancellation Details</span>
                                <small class="text-muted d-block">Reason and supporting context</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <group>
                                    <field name="cancellation_reason_id" options="{'no_create': True, 'no_edit': True}"/>
                                    <field name="cancellation_notes" placeholder="Please provide detailed information about why this booking is being cancelled. Include any relevant context that may be useful for future reference."/>
                                </group>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info" role="alert">
                        <p><strong>Note:</strong> Cancellation details are mandatory and will be logged for record-keeping purposes.</p>
                    </div>
                </sheet>
                <footer>
                    <button string="Confirm Cancellation" name="action_confirm_cancellation" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
