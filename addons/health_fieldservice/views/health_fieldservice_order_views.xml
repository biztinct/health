<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Booking Form View -->
    <record id="view_health_fieldservice_order_form" model="ir.ui.view">
        <field name="name">health.fieldservice.order.form</field>
        <field name="model">health.fieldservice.order</field>
        <field name="arch" type="xml">
            <form string="Booking">
                <header>
                    <button name="action_ai_assign_staff" type="object" 
                            string="🚀 AI Assign Staff" class="oe_highlight"
                            invisible="True"
                            help="Automatically assign staff using AI matching"/>
                    
                    <button name="action_manual_assign_staff" type="object"
                            string="👥 Manual Staff Assignment" class="btn-primary"
                            invisible="state != 'confirmed'"
                            help="Manually assign or modify staff assignments"/>

                    <button name="action_start_service" type="object"
                            string="▶️ Start Service" class="oe_highlight"
                            invisible="state not in ('confirmed', 'assigned') or not assignment_ids"
                            help="Start the service - only available when staff is assigned"/>

                    <button name="action_create_final_invoice" type="object"
                            string="💰 Create Invoice" class="btn-success"
                            invisible="state not in ['completed', 'completed_pending_invoice'] or invoice_id"
                            help="Create final invoice and initiate payment workflow (Pay Now/Pay Later)"/>

                    <!-- View Invoice button removed - duplicate of Invoices smart button -->

                    <button name="action_close_fso" type="object"
                            string="📁 Close Booking"
                            invisible="state not in ['completed', 'completed_pending_invoice']"
                            help="Close the booking"/>

                    <button name="action_cancel_booking" type="object"
                            string="❌ Cancel Booking"
                            invisible="state in ['completed', 'completed_pending_invoice', 'cancelled']"/>
                    
                    <button name="action_confirm_booking" type="object"
                            string="✅ Confirm Booking" class="oe_highlight"
                            invisible="state != 'draft'"
                            groups="health_base.group_healthcare_operations_manager"
                            help="Confirm booking and move to next stage (quote is optional)"/>

                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                
                <!-- Quote Information Banner (Optional) -->
                <div class="alert alert-info" role="alert"
                     invisible="not sale_order_id or state != 'draft'"
                     groups="health_base.group_healthcare_operations_manager">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-info-circle me-2"/>
                        <div>
                            <strong>📋 Quote Available:</strong>
                            A quote exists for this booking. You can add items or confirm without a quote.
                            <a href="#" class="btn btn-link p-0" role="button" name="action_view_quote" type="object">
                                Click here to view/edit quote
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Part-Time Staff Completion Banner -->
                <div class="alert alert-warning" role="alert"
                     invisible="state != 'completed_pending_invoice'"
                     groups="health_base.group_healthcare_operations_manager">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-clock-o me-2"/>
                        <div>
                            <strong>⏳ Awaiting Invoice:</strong>
                            Service completed by part-time staff. Operations team needs to create the invoice.
                            <a href="#" class="btn btn-link p-0" role="button" name="action_create_final_invoice" type="object">
                                Click here to create invoice
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Completion Readiness Status Banner -->
                <div class="alert alert-info" role="alert"
                     invisible="state not in ['in_progress'] or (clinical_notes_submitted and invoice_submitted)">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-exclamation-circle me-2"/>
                        <div>
                            <strong>📋 Service Completion Requirements:</strong>
                            <ul class="mb-0 mt-2">
                                <li invisible="clinical_notes_submitted">
                                    <strong>Clinical Notes:</strong> Required - Please complete clinical documentation
                                </li>
                                <li invisible="invoice_submitted">
                                    <strong>Quote/Invoice:</strong> Required - Please create a quote with service items
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Smart buttons for enhanced user experience -->
                        <button name="action_view_all_invoices" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-file-text-o"
                                invisible="not invoice_count">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        
                        <button name="action_view_assignments" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-users"
                                invisible="not assignment_count">
                            <field name="assignment_count" widget="statinfo" string="Assignments"/>
                        </button>
                        
                        <button name="action_create_and_open_quote" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-file-text"
                                invisible="sale_order_id"
                                groups="health_base.group_healthcare_operations_manager">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Create</span>
                                <span class="o_stat_text">Quote</span>
                            </div>
                        </button>
                        
                        <button name="action_view_quote" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-file-text-o"
                                invisible="not sale_order_id"
                                groups="health_base.group_healthcare_operations_manager">
                            <field name="quote_count" widget="statinfo" string="Quote"/>
                        </button>
                        
                        <!-- Hidden button to trigger quote popup after save -->
                        <button name="action_check_and_open_quote_if_needed" 
                                type="object" 
                                string="Check Quote" 
                                invisible="1"
                                id="auto_quote_trigger"
                                groups="health_base.group_healthcare_operations_manager"/>
                    </div>
                    
                    <!-- Service Timer Widget - Top Right Position -->
                    <field name="service_timer_active" invisible="1"/>
                    <field name="actual_start_datetime" invisible="1"/>
                    <field name="actual_end_datetime" invisible="1"/>
                    <field name="assignment_ids" invisible="1"/>
                    <div class="timer-top-right-container">
                        <field name="actual_duration_display" widget="service_timer" nolabel="1"
                               invisible="not id"/>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <div class="o_row">
                            <field name="priority" widget="priority"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'completed'"
                                   decoration-info="state == 'assigned'"
                                   decoration-warning="state == 'in_progress'"
                                   decoration-danger="state == 'cancelled'"/>
                        </div>
                    </div>
                    
                    <group>
                        <group string="Service Information">
                            <field name="patient_id" readonly="1" 
                                   context="{'form_view_ref': 'health_base.view_health_patient_form'}"/>
                            <field name="service_type"/>
                            <field name="scheduled_datetime"/>
                            <field name="team_id"/>
                        </group>
                        
                        <group string="Assignment &amp; Staff">
                            <field name="assigned_staff_ids" widget="many2many_tags"
                                   domain="[('is_healthcare_staff', '=', True), ('employment_status', '=', 'active')]"
                                   options="{'color_field': 'color', 'no_create': True}"/>
                            <field name="lead_staff_id"
                                   domain="[('id', 'in', assigned_staff_ids)]"
                                   options="{'no_create': True}"/>
                            <field name="assigned_doctor_id" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Location &amp; Timing">
                            <field name="service_location" readonly="1"/>
                            <field name="actual_start_datetime"/>
                            <field name="actual_end_datetime"/>
                            <field name="adjusted_end_datetime"/>
                            <field name="actual_duration" readonly="1" string="Duration (Hours)"/>
                        </group>
                        
                        <group string="Quote &amp; Invoice Status">
                            <field name="sale_order_id" readonly="1" string="Healthcare Quote"/>
                            <field name="quote_state" widget="badge" invisible="not sale_order_id"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="invoice_state" widget="badge" invisible="not invoice_id"/>
                        </group>
                    </group>
                    
                    <notebook>
                        
                        <page string="Equipment" name="equipment">
                            <group>
                                <group string="Required Equipment">
                                    <field name="required_equipment_ids" widget="many2many_tags"/>
                                    <field name="equipment_checklist_complete" widget="boolean_toggle"/>
                                </group>
                                
                                <group string="Assigned Equipment">
                                    <field name="assigned_equipment_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>

                        <page string="Clinical Notes" name="clinical_notes">
                            <div class="alert alert-warning" role="alert" invisible="clinical_notes_submitted">
                                <p><strong>⚠️ Required:</strong> Clinical notes must be submitted before completing the service.</p>
                            </div>
                            <div class="alert alert-success" role="alert" invisible="not clinical_notes_submitted">
                                <p><strong>✓ Clinical Notes Submitted:</strong> Clinical documentation is complete.</p>
                            </div>
                            <group>
                                <group string="Clinical Documentation">
                                    <field name="clinical_notes_submitted" invisible="1"/>
                                    <field name="clinical_notes" widget="html" nolabel="1" placeholder="Enter clinical observations and notes..."/>
                                </group>
                            </group>
                            <group>
                                <group string="MOH Compliance - Diagnosis">
                                    <field name="diagnosis" widget="html" nolabel="1" placeholder="Enter medical diagnosis (Chuẩn đoán)..."/>
                                </group>
                            </group>
                            <group>
                                <group string="Treatment Details">
                                    <field name="treatment_performed" placeholder="Describe treatment provided..."/>
                                    <field name="medications_prescribed" placeholder="List medications prescribed..."/>
                                </group>
                                <group string='Client Assessment'>
                                    <field name="patient_condition_before" placeholder="Patient condition before service..."/>
                                    <field name="patient_condition_after" placeholder="Patient condition after service..."/>
                                    <field name="vital_signs" placeholder="Record vital signs..."/>
                                </group>
                            </group>
                            <group>
                                <group string="Follow-up">
                                    <field name="follow_up_required"/>
                                    <field name="follow_up_date" invisible="not follow_up_required"/>
                                    <field name="follow_up_notes" invisible="not follow_up_required" placeholder="Follow-up instructions..."/>
                                </group>
                                <group string="Service Quality">
                                    <field name="service_rating"/>
                                </group>
                            </group>
                        </page>

                        <page string="Real-time Communication" name="communication">
                            <field name="communication_ids" readonly="1">
                                <list string="Communications" create="false">
                                    <field name="create_date"/>
                                    <field name="sender_id"/>
                                    <field name="message_type"/>
                                    <field name="priority" decoration-danger="priority == 'urgent'"/>
                                    <field name="message"/>
                                    <field name="is_read" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="GPS Tracking" name="tracking">
                            <group>
                                <group string="Current Location">
                                    <field name="gps_coordinates" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Cancellation Details" name="cancellation" invisible="state != 'cancelled'">
                            <group>
                                <group string="Cancellation Information">
                                    <field name="cancellation_reason_id" readonly="1"/>
                                    <field name="cancelled_by" readonly="1"/>
                                    <field name="cancellation_date" readonly="1"/>
                                </group>
                            </group>
                            <group string="Cancellation Notes">
                                <field name="cancellation_notes" nolabel="1" readonly="1"/>
                            </group>
                        </page>

                        <page string="Completion Details" name="completion" invisible="state != 'completed_pending_invoice'">
                            <div class="alert alert-info" role="alert">
                                <p><strong>ℹ️ Part-Time Staff Workflow:</strong> This service was completed by part-time/casual staff who do not have invoice creation permissions. Operations team has been notified to create the invoice.</p>
                            </div>
                            <group>
                                <group string="Completion Information">
                                    <field name="lead_staff_id" readonly="1"/>
                                    <field name="actual_end_datetime" readonly="1"/>
                                    <field name="actual_duration" readonly="1"/>
                                </group>
                            </group>
                            <group string="Completion Notes">
                                <field name="completion_notes" nolabel="1" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- Booking List View -->
    <record id="view_health_fieldservice_order_list" model="ir.ui.view">
        <field name="name">health.fieldservice.order.list</field>
        <field name="model">health.fieldservice.order</field>
        <field name="arch" type="xml">
            <list string="Bookings" default_order="create_date desc">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="scheduled_datetime"/>
                <field name="assigned_staff_ids" widget="many2many_tags"/>
                <field name="state" decoration-success="state == 'completed'"
                       decoration-info="state == 'assigned'"
                       decoration-warning="state == 'in_progress'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="stage_id"/>
                <field name="priority" decoration-danger="priority == '3'"/>
            </list>
        </field>
    </record>

    <!-- Booking Kanban View -->
    <record id="view_health_fieldservice_order_kanban" model="ir.ui.view">
        <field name="name">health.fieldservice.order.kanban</field>
        <field name="model">health.fieldservice.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="assigned_staff_ids"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="stage_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle">
                                            <field name="patient_id"/>
                                        </span>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown">
                                        <a class="dropdown-toggle o-no-caret btn" data-toggle="dropdown" href="#" role="button" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a name="action_start_service" type="object" class="dropdown-item">Start Service</a>
                                            <a name="action_complete_service" type="object" class="dropdown-item">Complete Service</a>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="o_kanban_record_body">
                                    <field name="assigned_staff_ids" widget="many2many_tags"/>
                                    <br/>
                                    <i class="fa fa-clock-o"/> <field name="scheduled_datetime"/>
                                </div>
                                
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                        <field name="state" widget="label" 
                                               decoration-success="state == 'completed'"
                                               decoration-info="state == 'assigned'"
                                               decoration-warning="state == 'in_progress'"
                                               decoration-danger="state == 'cancelled'"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-if="record.priority.raw_value == '3'" 
                                              class="badge badge-danger">
                                            <i class="fa fa-exclamation"/> 
                                            High Priority
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Booking Calendar View -->
    <record id="view_health_fieldservice_order_calendar" model="ir.ui.view">
        <field name="name">health.fieldservice.order.calendar</field>
        <field name="model">health.fieldservice.order</field>
        <field name="arch" type="xml">
            <calendar string="Bookings Calendar"
                      date_start="scheduled_datetime"
                      date_stop="estimated_end_datetime"
                      color="lead_staff_id"
                      mode="month"
                      quick_create="0"
                      event_open_popup="1"
                      hide_time="true">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="lead_staff_id"
                       filters="1"
                       avatar_field="image_128"/>
                <field name="service_type"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_health_fieldservice_order" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">health.fieldservice.order</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No bookings found!
            </p>
            <p>
                Bookings are automatically created when home visit appointments are confirmed.
                They coordinate staff assignment, equipment, and service delivery for home healthcare visits.
            </p>
        </field>
    </record>

</odoo>