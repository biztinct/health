<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Booking Form View -->
    <record id="view_health_fieldservice_order_form" model="ir.ui.view">
        <field name="name">health.fieldservice.order.form</field>
        <field name="model">health.fieldservice.order</field>
        <field name="arch" type="xml">
            <form string="Booking">
                <header>
                    <button name="action_ai_assign_staff" type="object" 
                            string="AI Assign Staff" class="oe_highlight"
                            icon="fa-magic"
                            invisible="True"
                            help="Automatically assign staff using AI matching"/>
                    
                    <button name="action_manual_assign_staff" type="object"
                            string="Staff Assignment" class="btn-primary"
                            icon="fa-users"
                            invisible="state in ('draft', 'completed', 'completed_pending_invoice', 'cancelled', 'closed')"
                            help="Assign staff to this booking"/>

                    <button name="action_cancel_booking" type="object"
                            string="Cancel Booking" class="btn-danger"
                            icon="fa-times-circle"
                            invisible="state in ('completed', 'completed_pending_invoice', 'cancelled')"/>
                    
                    <button name="action_open_lead_dashboard" type="object"
                            string="Dashboard" class="btn-secondary"
                            icon="fa-bar-chart"
                            invisible="not crm_lead_id"
                            help="Open the lead dashboard for this booking"/>
                    
                    <button name="action_confirm_booking" type="object"
                            string="Confirm Booking" class="btn-success"
                            icon="fa-check-circle"
                            invisible="state != 'draft'"
                            groups="health_base.group_healthcare_operations_manager"
                            help="Confirm booking and move to next stage (quote is optional)"/>

                    <button name="action_open_reschedule_calendar" type="object"
                            string="Reschedule" class="btn-secondary"
                            icon="fa-calendar"
                            invisible="state in ('completed', 'completed_pending_invoice', 'cancelled', 'closed')"
                            help="Open calendar view to reschedule this booking"/>

                    <button name="action_create_and_open_quote" type="object"
                            string="Create Quote" class="btn-info"
                            icon="fa-file-text-o"
                            invisible="sale_order_id or state not in ('draft', 'confirmed')"
                            help="Create a quote for this booking"/>

                    <button name="action_view_quote" type="object"
                            string="Quote" class="btn-info"
                            icon="fa-file-text-o"
                            invisible="not sale_order_id"
                            help="Open the quote for this booking"/>

                    <button name="action_start_service" type="object"
                            string="Start Service" class="oe_highlight"
                            icon="fa-play-circle"
                            invisible="state not in ('confirmed', 'assigned') or not assignment_ids"
                            help="Start the service - only available when staff is assigned"/>

                    <button name="action_create_final_invoice" type="object"
                            string="Create Invoice" class="btn-warning"
                            icon="fa-money"
                            invisible="state not in ['completed', 'completed_pending_invoice'] or invoice_id"
                            help="Create final invoice and initiate payment workflow (Pay Now/Pay Later)"/>

                    <button name="action_close_fso" type="object"
                            string="Close Booking" class="btn-secondary"
                            icon="fa-folder"
                            invisible="state not in ['completed', 'completed_pending_invoice']"
                            help="Close the booking"/>
                </header>
                
                <!-- Quote Information Banner (Optional) -->
                <div class="alert alert-info" role="alert"
                     invisible="not sale_order_id or state != 'draft'"
                     groups="health_base.group_healthcare_operations_manager">
                    <div>
                        <div>
                            <strong><i class="fa fa-file-text-o"/> Quote Available:</strong>
                            A quote exists for this booking. You can add items or confirm without a quote.
                            <a href="#" class="btn btn-link p-0" role="button" name="action_view_quote" type="object">
                                Click here to view/edit quote
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Part-Time Staff Completion Banner -->
                <div class="alert alert-warning" role="alert"
                     invisible="state != 'completed_pending_invoice'"
                     groups="health_base.group_healthcare_operations_manager">
                    <div>
                        <div>
                            <strong><i class="fa fa-clock-o"/> Awaiting Invoice:</strong>
                            Service completed by part-time staff. Operations team needs to create the invoice.
                            <a href="#" class="btn btn-link p-0" role="button" name="action_create_final_invoice" type="object">
                                Click here to create invoice
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Completion Readiness Status Banner -->
                <div class="alert alert-info" role="alert"
                     invisible="state not in ['in_progress'] or (clinical_notes_submitted and invoice_submitted)">
                    <div>
                        <div>
                            <strong><i class="fa fa-clipboard"/> Service Completion Requirements:</strong>
                            <ul class="mb-0 mt-2">
                                <li invisible="clinical_notes_submitted">
                                    <strong>Clinical Notes:</strong> Required - Please complete clinical documentation
                                </li>
                                <li invisible="invoice_submitted">
                                    <strong>Quote/Invoice:</strong> Required - Please create a quote with service items
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Service Confirmation Requirements Banner -->
                <div class="alert alert-warning" role="alert"
                     invisible="state != 'draft'"
                     groups="health_base.group_healthcare_operations_manager">
                    <div>
                        <div>
                            <strong><i class="fa fa-check-circle text-success"/> Service Confirmation Requirements:</strong>
                            <p class="mb-0 mt-2">Before confirming this booking, you must complete ONE of the following:</p>
                            <ul class="mb-0 mt-2">
                                <li>
                                    <strong>Create a Quote:</strong> Add at least one service or product line item to the quote
                                </li>
                            </ul>
                            <p class="mb-0 mt-2 text-muted">
                                <small>This ensures proper service delivery and billing documentation.</small>
                            </p>
                        </div>
                    </div>
                </div>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Smart buttons for enhanced user experience -->
                        <button name="action_view_all_invoices" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-file-text-o"
                                invisible="not invoice_count">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        
                        <button name="action_view_assignments" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-users"
                                invisible="not assignment_count">
                            <field name="assignment_count" widget="statinfo" string="Assignments"/>
                        </button>
                        
                        <button name="action_create_and_open_quote" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-file-text"
                                invisible="sale_order_id"
                                groups="health_base.group_healthcare_operations_manager">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Create</span>
                                <span class="o_stat_text">Quote</span>
                            </div>
                        </button>
                        
                        <button name="action_view_quote" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-file-text-o"
                                invisible="not sale_order_id"
                                groups="health_base.group_healthcare_operations_manager">
                            <field name="quote_count" widget="statinfo" string="Quote"/>
                        </button>
                        
                        <!-- Hidden button to trigger quote popup after save -->
                        <button name="action_check_and_open_quote_if_needed" 
                                type="object" 
                                string="Check Quote" 
                                invisible="1"
                                id="auto_quote_trigger"
                                groups="health_base.group_healthcare_operations_manager"/>
                    </div>
                    
                    <!-- Stage Status Bar - Full Width above title -->
                    <div class="mb-2" style="width: 100%;">
                        <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                    </div>
                    
                    <!-- Title and Timer Row -->
                    <field name="service_timer_active" invisible="1"/>
                    <field name="actual_start_datetime" invisible="1"/>
                    <field name="actual_end_datetime" invisible="1"/>
                    <field name="assignment_ids" invisible="1"/>
                    
                    <div class="d-flex justify-content-between align-items-start" style="width: 100%;">
                        <div class="oe_title">
                            <h1>
                                <field name="display_name" readonly="1"/>
                            </h1>
                            <div class="o_row">
                                <field name="priority" widget="priority"/>
                            </div>
                        </div>
                        <div class="timer-top-right-container">
                            <field name="actual_duration_display" widget="service_timer" nolabel="1"
                                   invisible="not id"/>
                        </div>
                    </div>
                    
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="heart-pulse"/>
                            <div>
                            <span>Service Overview</span>
                                <small class="text-muted d-block">Client, service type and staffing snapshot</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="file-text"/>
                                    <span>Service Information</span>
                                </div>
                                <group col="2">
                                    <field name="patient_id" readonly="1"
                                           context="{'form_view_ref': 'health_base.view_health_patient_form'}"/>
                                    <field name="patient_phone" widget="phone" string="Phone"/>
                                    <field name="patient_national_id" string="National ID"/>
                                    <label for="patient_address_display" string="Client Address"/>
                                    <div class="o_row align-items-start">
                                        <field name="patient_address_display" nolabel="1" readonly="1" class="flex-grow-1"/>
                                        <button name="action_edit_patient_address"
                                                type="object"
                                                class="btn btn-link p-0 fa fa-pencil text-muted"
                                                title="Edit address"/>
                                    </div>
                                    <field name="service_type"/>
                                    <field name="has_staff_assigned" invisible="1"/>
                                    <field name="patient_catchment_province_id"/>
                                    <field name="facility_id"/>
                                    <field name="scheduled_datetime" readonly="has_staff_assigned"/>
                                    <field name="booking_timezone" readonly="1"/>
                                    <field name="scheduled_duration" widget="integer"/>
                                    <field name="team_id"/>
                                </group>
                            </div>

                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="users-group"/>
                                    <span>Assignment and Staff</span>
                                </div>
                                <group col="2">
                                    <field name="assigned_staff_ids" widget="many2many_tags"
                                           options="{'color_field': 'color', 'no_create': False}"/>
                                    <field name="lead_staff_id"
                                           options="{'no_create': False}"/>
                                    <field name="assigned_doctor_ids" widget="many2many_tags"
                                           options="{'color_field': 'color', 'no_create': False}"/>
                                </group>
                            </div>
                        </div>
                    </div>
                    
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="timeline"/>
                            <div>
                                <span>Execution and Financials</span>
                                <small class="text-muted d-block">Actual delivery data plus quote/invoice status</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="map-pin"/>
                                    <span>Location and Timing</span>
                                </div>
                                <group col="2">
                                    <field name="service_location" readonly="1"/>
                                    <field name="actual_start_datetime"/>
                                    <field name="actual_end_datetime"/>
                                    <field name="adjusted_end_datetime"/>
                                    <field name="actual_duration" readonly="1" string="Duration (Hours)"/>
                                </group>
                            </div>
                            
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="credit-card"/>
                                    <span>Quote and Invoice Status</span>
                                </div>
                                <group col="2">
                                    <field name="sale_order_id" readonly="1" string="Healthcare Quote"/>
                                    <field name="quote_state" widget="badge" invisible="not sale_order_id"/>
                                    <field name="invoice_id" readonly="1"/>
                                    <field name="invoice_state" widget="badge" invisible="not invoice_id"/>
                                </group>
                            </div>
                        </div>
                    </div>
                    
                    <notebook>

                        <page string="Staff Assignments" name="assignments">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="users-group"/>
                                    <span>Assignments</span>
                                </div>
                                <field name="assignment_ids"/>
                            </div>
                        </page>

                        <page string="Equipment" name="equipment">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="package"/>
                                    <div>
                                        <span>Equipment</span>
                                        <small class="text-muted d-block">Required supplies and assigned kits</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="package"/>
                                            <span>Required Equipment</span>
                                        </div>
                                        <group>
                                            <field name="required_equipment_ids" widget="many2many_tags"/>
                                            <field name="equipment_checklist_complete" widget="boolean_toggle"/>
                                        </group>
                                    </div>
                                    
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="package"/>
                                            <span>Assigned Equipment</span>
                                        </div>
                                        <group>
                                            <field name="assigned_equipment_ids" widget="many2many_tags"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <page string="Clinical Notes" name="clinical_notes">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="stethoscope"/>
                                    <div>
                                        <span>Clinical Documentation</span>
                                        <small class="text-muted d-block">Notes, diagnosis, treatment and follow-up</small>
                                    </div>
                                </div>
                                <div class="alert alert-warning" role="alert" invisible="clinical_notes_submitted">
                                    <p><strong><i class="fa fa-exclamation-triangle"/> Required:</strong> Clinical notes must be submitted before completing the service.</p>
                                </div>
                                <div class="alert alert-success" role="alert" invisible="not clinical_notes_submitted">
                                    <p><strong><i class="fa fa-check text-success"/> Clinical Notes Submitted:</strong> Clinical documentation is complete.</p>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="file-text"/>
                                            <span>Clinical Documentation</span>
                                        </div>
                                        <group>
                                            <field name="clinical_notes_submitted" invisible="1"/>
                                            <field name="clinical_notes" widget="html" nolabel="1" placeholder="Enter clinical observations and notes..."/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="heart-pulse"/>
                                            <span>MOH Compliance - Diagnosis</span>
                                        </div>
                                        <group>
                                            <field name="diagnosis" nolabel="1" placeholder="Enter medical diagnosis (Chuẩn đoán)..."/>
                                        </group>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="stethoscope"/>
                                            <span>Treatment Details</span>
                                        </div>
                                        <group>
                                            <field name="treatment_performed" placeholder="Describe treatment provided..."/>
                                            <field name="medications_prescribed" placeholder="List medications prescribed..."/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="activity"/>
                                            <span>Client Assessment</span>
                                        </div>
                                        <group>
                                            <field name="patient_condition_before" placeholder="Patient condition before service..."/>
                                            <field name="patient_condition_after" placeholder="Patient condition after service..."/>
                                            <field name="vital_signs" placeholder="Record vital signs..."/>
                                        </group>
                                    </div>
                                </div>
                                <div class="vu-section-grid" invisible="state not in ('in_progress', 'completed', 'completed_pending_invoice')">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="syringe"/>
                                            <span>Service Procedures</span>
                                        </div>
                                        <group col="4">
                                            <field name="injection_count"/>
                                            <field name="medication_count"/>
                                            <field name="wound_count"/>
                                            <field name="iv_fluid_count"/>
                                        </group>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="timeline"/>
                                            <span>Follow-up</span>
                                        </div>
                                        <group>
                                            <field name="follow_up_required"/>
                                            <field name="follow_up_date" invisible="not follow_up_required"/>
                                            <field name="follow_up_notes" invisible="not follow_up_required" placeholder="Follow-up instructions..."/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="users-group"/>
                                            <span>Service Quality</span>
                                        </div>
                                        <group>
                                            <field name="service_rating"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <page string="Intake Notes" name="intake_notes">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="clipboard-list"/>
                                    <div>
                                        <span>Intake Notes</span>
                                        <small class="text-muted d-block">Referring details and planning notes</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="users-group"/>
                                            <span>Referring Information</span>
                                        </div>
                                        <group>
                                            <field name="referring_doctor_id" placeholder="Select referring doctor or contact" options="{'no_create': True}"/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="heart-pulse"/>
                                            <span>Care Planning</span>
                                        </div>
                                        <group>
                                            <field name="goal_of_care" placeholder="Primary goal or objective of care"/>
                                            <field name="required_equipment" placeholder="Equipment or supplies required for care"/>
                                        </group>
                                    </div>
                                </div>
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="file-text"/>
                                        <span>Additional Notes</span>
                                    </div>
                                    <group>
                                        <field name="intake_notes" nolabel="1" placeholder="Additional intake assessment notes and observations"/>
                                    </group>
                                </div>
                            </div>
                        </page>

                        <page string="Real-time Communication" name="communication" invisible="1">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="timeline"/>
                                    <span>Communications</span>
                                </div>
                                <field name="communication_ids" readonly="1">
                                    <list string="Communications" create="false">
                                        <field name="create_date"/>
                                        <field name="sender_id"/>
                                        <field name="message_type"/>
                                        <field name="priority" decoration-danger="priority == 'urgent'"/>
                                        <field name="message"/>
                                        <field name="is_read" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </div>
                        </page>
                        
                        <page string="GPS Tracking" name="tracking">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="map-pin"/>
                                    <span>Current Location</span>
                                </div>
                                <group>
                                    <field name="gps_coordinates" readonly="1"/>
                                </group>
                            </div>
                        </page>

                        <page string="Cancellation Details" name="cancellation" invisible="state != 'cancelled'">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="alert-triangle"/>
                                    <div>
                                        <span>Cancellation Details</span>
                                        <small class="text-muted d-block">Reason, owner and supporting notes</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="file-text"/>
                                            <span>Information</span>
                                        </div>
                                        <group>
                                            <field name="cancellation_reason_id" readonly="1"/>
                                            <field name="cancelled_by" readonly="1"/>
                                            <field name="cancellation_date" readonly="1"/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="file-text"/>
                                            <span>Notes</span>
                                        </div>
                                        <group>
                                            <field name="cancellation_notes" nolabel="1" readonly="1"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <page string="Completion Details" name="completion" invisible="state != 'completed_pending_invoice'">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="timeline"/>
                                    <div>
                                        <span>Completion Details</span>
                                        <small class="text-muted d-block">Part-time workflow and summary notes</small>
                                    </div>
                                </div>
                                <div class="alert alert-info" role="alert">
                                    <p><strong><i class="fa fa-info-circle"/> Part-Time Staff Workflow:</strong> This service was completed by part-time/casual staff who do not have invoice creation permissions. Operations team has been notified to create the invoice.</p>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="users-group"/>
                                            <span>Completion Information</span>
                                        </div>
                                        <group>
                                            <field name="lead_staff_id" readonly="1"/>
                                            <field name="actual_end_datetime" readonly="1"/>
                       	                    <field name="actual_duration" readonly="1"/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="file-text"/>
                                            <span>Completion Notes</span>
                                        </div>
                                        <group>
                                            <field name="completion_notes" nolabel="1" readonly="1"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- Booking List View -->
    <record id="view_health_fieldservice_order_list" model="ir.ui.view">
        <field name="name">health.fieldservice.order.list</field>
        <field name="model">health.fieldservice.order</field>
        <field name="arch" type="xml">
            <list string="Bookings" default_order="create_date desc">
                <field name="display_name" string="Booking"/>
                <field name="patient_id" string="Client"/>
                <field name="patient_phone" string="Phone" widget="phone" optional="show"/>
                <field name="service_type"/>
                <field name="scheduled_datetime"/>
                <field name="assigned_staff_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="state" decoration-success="state == 'completed'"
                       decoration-info="state == 'assigned'"
                       decoration-warning="state == 'in_progress'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="stage_id"/>
                <field name="priority" decoration-danger="priority == '3'"/>
            </list>
        </field>
    </record>

    <!-- Booking Kanban View -->
    <record id="view_health_fieldservice_order_kanban" model="ir.ui.view">
        <field name="name">health.fieldservice.order.kanban</field>
        <field name="model">health.fieldservice.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="assigned_staff_ids"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="stage_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="display_name"/>
                                        </strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle">
                                            <field name="service_type"/>
                                        </span>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown">
                                        <a class="dropdown-toggle o-no-caret btn" data-toggle="dropdown" href="#" role="button" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a name="action_start_service" type="object" class="dropdown-item">Start Service</a>
                                            <a name="action_complete_service" type="object" class="dropdown-item">Complete Service</a>
                                        </div>
                                    </div>
                                </div>

                                <div class="o_kanban_record_body">
                                    <field name="assigned_staff_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    <br/>
                                    <i class="fa fa-clock-o" title="Scheduled time"/> <field name="scheduled_datetime"/>
                                </div>
                                
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                        <field name="state" widget="label" 
                                               decoration-success="state == 'completed'"
                                               decoration-info="state == 'assigned'"
                                               decoration-warning="state == 'in_progress'"
                                               decoration-danger="state == 'cancelled'"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-if="record.priority.raw_value == '3'" 
                                              class="badge badge-danger">
                                            <i class="fa fa-exclamation" title="Alert"/> 
                                            High Priority
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Booking Calendar View -->
    <record id="view_health_fieldservice_order_calendar" model="ir.ui.view">
        <field name="name">health.fieldservice.order.calendar</field>
        <field name="model">health.fieldservice.order</field>
        <field name="arch" type="xml">
            <calendar string="Bookings Calendar"
                      date_start="scheduled_datetime"
                      date_stop="estimated_end_datetime"
                      color="lead_staff_id"
                      mode="month"
                      scales="day,week,month,year"
                      quick_create="0"
                      event_open_popup="1"
                      hide_time="true">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="lead_staff_id"
                       filters="1"
                       avatar_field="image_128"/>
                <field name="service_type"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_health_fieldservice_order" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">health.fieldservice.order</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No bookings found!
            </p>
            <p>
                Bookings are automatically created when home visit appointments are confirmed.
                They coordinate staff assignment, equipment, and service delivery for home healthcare visits.
            </p>
        </field>
    </record>

</odoo>
