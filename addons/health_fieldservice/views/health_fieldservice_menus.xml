<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Field Service Main Menu under Healthcare -->
    <record id="menu_health_fieldservice_root" model="ir.ui.menu">
        <field name="name">Field Service</field>
        <field name="parent_id" ref="health_base.menu_healthcare_root"/>
        <field name="sequence">20</field>
    </record>

    <!-- Bookings Menu -->
    <record id="menu_fieldservice_orders" model="ir.ui.menu">
        <field name="name">Bookings</field>
        <field name="parent_id" ref="menu_health_fieldservice_root"/>
        <field name="action" ref="action_health_fieldservice_order"/>
        <field name="sequence">10</field>
    </record>

    <!-- Real-time Communications Menu -->
    <record id="menu_fieldservice_communications" model="ir.ui.menu">
        <field name="name">Communications</field>
        <field name="parent_id" ref="menu_health_fieldservice_root"/>
        <field name="action" ref="action_health_fieldservice_communication"/>
        <field name="sequence">20</field>
    </record>

    <!-- Equipment Menu -->
    <record id="menu_portable_equipment" model="ir.ui.menu">
        <field name="name">Portable Equipment</field>
        <field name="parent_id" ref="menu_health_fieldservice_root"/>
        <field name="action" ref="action_health_portable_equipment"/>
        <field name="sequence">30</field>
    </record>

    <!-- Configuration Submenu -->
    <record id="menu_fieldservice_configuration" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="parent_id" ref="menu_health_fieldservice_root"/>
        <field name="sequence">90</field>
    </record>

    <!-- Clinical Protocols Menu -->
    <record id="menu_clinical_protocols" model="ir.ui.menu">
        <field name="name">Clinical Protocols</field>
        <field name="parent_id" ref="menu_fieldservice_configuration"/>
        <field name="action" ref="action_health_clinical_protocol"/>
        <field name="sequence">10</field>
    </record>

    <!-- Field Service Teams Menu -->
    <record id="menu_fieldservice_teams" model="ir.ui.menu">
        <field name="name">Field Service Teams</field>
        <field name="parent_id" ref="menu_fieldservice_configuration"/>
        <field name="action" ref="action_health_fieldservice_team"/>
        <field name="sequence">20</field>
    </record>

    <!-- Booking Stages Menu -->
    <record id="menu_fieldservice_stages" model="ir.ui.menu">
        <field name="name">Booking Stages</field>
        <field name="parent_id" ref="menu_fieldservice_configuration"/>
        <field name="action" ref="action_health_fieldservice_stage"/>
        <field name="sequence">30</field>
    </record>

</odoo>