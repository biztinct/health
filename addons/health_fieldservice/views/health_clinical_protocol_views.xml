<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Clinical Protocol Form View -->
    <record id="view_health_clinical_protocol_form" model="ir.ui.view">
        <field name="name">health.clinical.protocol.form</field>
        <field name="model">health.clinical.protocol</field>
        <field name="arch" type="xml">
            <form string="Clinical Protocol">
                <header>
                    <button name="action_preview_steps" type="object" 
                            string="👁️ Preview Steps" class="btn-secondary"/>
                    
                    <button name="action_duplicate_protocol" type="object" 
                            string="📋 Duplicate Protocol" class="btn-secondary"/>
                </header>
                
                <sheet>
                    <group>
                        <group string="Protocol Information">
                            <field name="name"/>
                            <field name="version"/>
                            <field name="effective_date"/>
                            <field name="expiry_date"/>
                            <field name="active"/>
                        </group>
                        
                        <group string="Classification">
                            <field name="complexity_level"/>
                            <field name="duration_estimate_minutes"/>
                            <field name="infection_control_level"/>
                            <field name="usage_count" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="description"/>
                    </group>
                    
                    <notebook>
                        <page string="Action Steps Template" name="steps">
                            <group>
                                <field name="sample_action_steps" readonly="1"/>
                            </group>
                            <group>
                                <field name="action_steps_template" widget="ace" options="{'mode': 'json'}"
                                       placeholder='{"steps": [{"step": 1, "action": "Description", "required": true, "time_minutes": 2}]}'/>
                            </group>
                        </page>
                        
                        <page string="Service Types" name="services">
                            <field name="service_type_ids" widget="many2many_tags"/>
                        </page>
                        
                        <page string="Required Equipment" name="equipment">
                            <field name="required_equipment_ids"/>
                        </page>
                        
                        <page string="Safety and Compliance" name="safety">
                            <group>
                                <group string="Safety Requirements">
                                    <field name="safety_requirements"/>
                                    <field name="required_qualifications"/>
                                </group>
                                
                                <group string="Documentation">
                                    <field name="documentation_required"/>
                                    <field name="documentation_template" invisible="not documentation_required"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Clinical Protocol List View -->
    <record id="view_health_clinical_protocol_list" model="ir.ui.view">
        <field name="name">health.clinical.protocol.list</field>
        <field name="model">health.clinical.protocol</field>
        <field name="arch" type="xml">
            <list string="Clinical Protocols">
                <field name="name"/>
                <field name="version"/>
                <field name="complexity_level"/>
                <field name="duration_estimate_minutes"/>
                <field name="infection_control_level"/>
                <field name="usage_count"/>
                <field name="effective_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Clinical Protocol Search View -->
    <record id="view_health_clinical_protocol_search" model="ir.ui.view">
        <field name="name">health.clinical.protocol.search</field>
        <field name="model">health.clinical.protocol</field>
        <field name="arch" type="xml">
            <search string="Protocol Search">
                <field name="name"/>
                <field name="service_type_ids"/>
                
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Basic Complexity" name="basic" domain="[('complexity_level', '=', 'basic')]"/>
                <filter string="Intermediate Complexity" name="intermediate" domain="[('complexity_level', '=', 'intermediate')]"/>
                <filter string="Advanced Complexity" name="advanced" domain="[('complexity_level', '=', 'advanced')]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Complexity Level" name="group_by_complexity" context="{'group_by': 'complexity_level'}"/>
                    <filter string="Infection Control Level" name="group_by_infection" context="{'group_by': 'infection_control_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Clinical Protocol Action -->
    <record id="action_health_clinical_protocol" model="ir.actions.act_window">
        <field name="name">Clinical Protocols</field>
        <field name="res_model">health.clinical.protocol</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_health_clinical_protocol_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No clinical protocols found!
            </p>
            <p>
                Create clinical protocol templates with step-by-step action items for different healthcare services.
                These protocols guide field staff through standardized service delivery procedures.
            </p>
        </field>
    </record>

</odoo>
