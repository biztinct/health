<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== OPS CLIENT PROFILE FORM VIEW ===== -->
    <record id="view_health_patient_form_ops" model="ir.ui.view">
        <field name="name">res.partner.form.ops.client.profile</field>
        <field name="model">res.partner</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <form string="Client Profile" js_class="ops_client_profile_form"
                  class="ops-client-profile-form ws-workspace">

                <field name="active" invisible="1"/>
                <field name="deleted" invisible="1"/>

                <!-- Record lifecycle: Delete is a user function, Archive a
                     custodian function (client data-governance spec). This
                     form hides the native control panel, so the buttons must
                     live in the arch. Workspace kit (health_theme, WS-1):
                     buttons carrying `ws-more` render inside one "More" menu. -->
                <header>
                    <!-- the standing action of a client record; Next step keeps
                         the contextual one, the More menu the lifecycle ones -->
                    <button name="action_open_quick_booking_owl" type="object"
                            string="New booking" class="oe_highlight"
                            invisible="deleted or not active"/>
                    <button name="action_open_delete_wizard" type="object"
                            string="Delete" icon="fa-trash"
                            class="ws-more"
                            invisible="deleted"/>
                    <button name="action_open_restore_wizard" type="object"
                            string="Restore" icon="fa-undo"
                            class="ws-more"
                            groups="health_base.group_healthcare_custodian"
                            invisible="not deleted"/>
                    <button name="action_open_archive_wizard" type="object"
                            string="Archive" icon="fa-archive"
                            class="ws-more"
                            groups="health_base.group_healthcare_custodian"
                            invisible="deleted or not active"/>
                    <button name="action_open_unarchive_wizard" type="object"
                            string="Unarchive" icon="fa-archive"
                            class="ws-more"
                            groups="health_base.group_healthcare_custodian"
                            invisible="active"/>
                </header>
                <field name="patient_status" invisible="1"/>
                <field name="is_patient" invisible="1"/>
                <field name="source_type" invisible="1"/>

                <sheet>
                    <field name="name" invisible="1"/>
                    <field name="patient_code_display" invisible="1"/>
                    <field name="age_display" invisible="1"/>
                    <field name="patient_code" invisible="1"/>
                    <field name="age" invisible="1"/>
                    <field name="is_referrer" invisible="1"/>

                    <!-- ========================================================
                         WORKSPACE (WS-2) — main column (identity, notices, Next
                         step, tabs) + a pinned right rail (glance, people,
                         alerts, shortcuts). Layout + skin: health_theme
                         ws_workspace.scss; client rules: ops_client_profile_form.scss
                         ======================================================== -->
                    <div class="ws-page">
                        <div class="ws-main">

                            <!-- COMPACT BAR — name, status, code, phone and the Next step
                                 button, pinned at the top once the hero scrolls away -->
                            <widget name="ws_compact_bar" title_fields="name"
                                    badge_field="patient_status" badge_tones="active:ok,inactive:muted"
                                    fact_fields="patient_code_display,phone"/>

                            <!-- HERO — who the client is, how to reach them -->
                            <div class="ws-hero">
                                <div class="ws-hero__avatar">
                                    <field name="avatar_128" widget="image" readonly="1" nolabel="1"
                                           class="ws-hero__avatar-img"/>
                                </div>
                                <div class="ws-hero__main">
                                    <div class="ws-hero__title">
                                        <h1 class="ws-hero__name">
                                            <field name="name" readonly="1" class="d-inline"/>
                                        </h1>
                                        <field name="patient_code_display" readonly="1"
                                               class="ws-chip ws-chip--code"
                                               invisible="not patient_code"/>
                                        <!-- chips are block elements with a CSS icon, so each
                                             one is its own translation term (ledger §5.246) -->
                                        <div class="ws-chip ws-chip--ok ws-chip--dot"
                                             invisible="patient_status != 'active'">Active</div>
                                        <div class="ws-chip ws-chip--dot"
                                             invisible="patient_status != 'inactive'">Inactive</div>
                                        <field name="patient_category_id" readonly="1"
                                               options="{'no_open': True}"
                                               class="ws-chip ws-chip--category"
                                               invisible="not patient_category_id"/>
                                        <div class="ws-chip ws-chip--info" data-icon="users"
                                             invisible="not is_referrer">Referrer</div>
                                        <div class="ws-chip ws-chip--quiet" data-icon="history"
                                             invisible="not deceased">Deceased</div>
                                    </div>
                                    <div class="ws-hero__facts">
                                        <span class="ws-fact" invisible="not phone">
                                            <span class="ws-ico" data-icon="phone"/>
                                            <field name="phone" readonly="1"/>
                                        </span>
                                        <span class="ws-fact ws-fact--address" invisible="not vietnamese_address">
                                            <span class="ws-ico" data-icon="map-pin"/>
                                            <field name="vietnamese_address" readonly="1"/>
                                        </span>
                                        <span class="ws-fact" invisible="not email">
                                            <span class="ws-ico" data-icon="mail"/>
                                            <field name="email" readonly="1"/>
                                        </span>
                                        <span class="ws-fact ws-fact--person" invisible="not age and not gender_id">
                                            <span class="ws-ico" data-icon="user"/>
                                            <field name="age_display" readonly="1" invisible="not age"/>
                                            <span class="ws-fact__sep" invisible="not age or not gender_id">·</span>
                                            <field name="gender_id" readonly="1" options="{'no_open': True}"
                                                   invisible="not gender_id"/>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Lifecycle notices (this form has no ribbon seam). Their text
                                 keeps its old indentation on purpose: whitespace is part of
                                 the translation term (ledger §5.246). -->
                            <div class="alert alert-danger ws-banner ws-banner--danger" role="alert" invisible="not deleted">
                                <strong><i class="fa fa-trash"/> DELETED:</strong>
                        this client record is a Delete request — it stays visible here
                        but no longer counts in reports.
                                <field name="deleted_reason_id" readonly="1" class="d-inline ms-1"/>
                            </div>
                            <div class="alert alert-secondary ws-banner ws-banner--muted" role="alert" invisible="active or deleted">
                                <strong><i class="fa fa-archive"/> ARCHIVED:</strong>
                        hidden from normal views, still counted in reports.
                            </div>

                            <!-- Allergies — clinical safety: always shown, never folded,
                                 always above the fold -->
                            <div class="alert alert-danger ws-banner ws-banner--allergy" role="alert" invisible="not allergies">
                                <strong><i class="fa fa-exclamation-triangle"/> ALLERGIES:</strong>
                                <field name="allergies" readonly="1"/>
                            </div>

                            <!-- NEXT STEP — one sentence, one button -->
                            <div class="ws-next">
                                <widget name="ws_client_next"/>
                            </div>

                    <!-- ================================================
                         TABS — Overview first; every other page unchanged
                         ================================================ -->
                    <notebook>
                        <!-- ===== 1. OVERVIEW ===== cards pack tightly (masonry);
                             cards whose fields are ALL empty fold into the
                             "Not filled yet" tray below them. -->
                        <page string="Overview" name="profile_overview">
                            <div class="ws-pack">

                                <div class="vu-detail-card ws-card" name="personal_card">
                                    <div class="vu-card__title">
                                        <div class="vu-section__icon" data-icon="id-card"/>
                                        <div>Personal</div>
                                    </div>
                                    <group>
                                        <field name="title" placeholder="—"/>
                                        <field name="first_name" placeholder="—"/>
                                        <field name="middle_name" placeholder="—"/>
                                        <field name="last_name" placeholder="—"/>
                                        <field name="vietnamese_name" placeholder="Tên tiếng Việt"/>
                                        <field name="birth_date" placeholder="—"/>
                                        <field name="gender_id" placeholder="—"/>
                                        <field name="deceased"/>
                                    </group>
                                </div>

                                <div class="vu-detail-card ws-card" name="contact_card">
                                    <div class="vu-card__title">
                                        <div class="vu-section__icon" data-icon="phone"/>
                                        <div>Contact</div>
                                    </div>
                                    <group>
                                        <field name="phone" widget="phone" required="1"/>
                                        <field name="mobile" widget="phone" invisible="1"/>
                                        <field name="email" widget="email" placeholder="—"/>
                                    </group>
                                </div>

                                <div class="vu-detail-card ws-card" name="care_card">
                                    <div class="vu-card__title">
                                        <div class="vu-section__icon" data-icon="heart-pulse"/>
                                        <div>Care</div>
                                    </div>
                                    <group>
                                        <field name="patient_category_id" placeholder="—"/>
                                        <field name="catchment_province_id" required="1"/>
                                        <field name="primary_facility_id" placeholder="—"
                                               domain="[('catchment_province_id', '=', catchment_province_id)]"/>
                                        <field name="intake_referring_doctor_id"
                                               string="Referring Doctor" placeholder="—"
                                               options="{'no_create': True}"/>
                                        <field name="source_type" placeholder="—"/>
                                        <field name="source_details" placeholder="Specific source details"
                                               invisible="not source_type"/>
                                        <field name="referral_source"
                                               invisible="source_type != 'referral'"/>
                                    </group>
                                </div>

                                <div class="vu-detail-card ws-card" name="identity_card">
                                    <div class="vu-card__title">
                                        <div class="vu-section__icon" data-icon="shield-check"/>
                                        <div>Identity</div>
                                    </div>
                                    <group>
                                        <field name="national_id" placeholder="—"/>
                                        <field name="profession" string="Occupation" placeholder="—"/>
                                        <field name="ethnicity" placeholder="—"/>
                                    </group>
                                </div>

                                <div class="vu-detail-card ws-card" name="commission_card">
                                    <div class="vu-card__title">
                                        <div class="vu-section__icon" data-icon="credit-card"/>
                                        <div>Commission</div>
                                    </div>
                                    <group>
                                        <field name="commission_due_to" placeholder="—"/>
                                    </group>
                                </div>

                                <!-- Recent visits (the five newest bookings) -->
                                <widget name="ws_client_visits"/>
                            </div>

                            <widget name="ws_fold_tray" options="{'cards': {
                                'identity_card': ['national_id', 'profession', 'ethnicity'],
                                'commission_card': ['commission_due_to']}}"/>
                        </page><!-- /Overview -->

                        <!-- ===== 2. BOOKINGS & JOURNEY ===== -->
                        <page string="Bookings" name="bookings_journey">
                            <div class="vu-section">
                                <!-- Journey Stats Strip -->
                                <div class="bj-journey-stats">
                                    <div class="bj-jstat">
                                        <i class="fa fa-calendar-check-o"/>
                                        <div class="bj-jstat-info">
                                            <span class="bj-jstat-val"><field name="visit_count" nolabel="1" class="d-inline"/></span>
                                            <span class="bj-jstat-lbl">Total Bookings</span>
                                        </div>
                                    </div>
                                    <div class="bj-jstat">
                                        <i class="fa fa-clock-o"/>
                                        <div class="bj-jstat-info">
                                            <span class="bj-jstat-val"><field name="last_visit_date" nolabel="1" widget="date" class="d-inline"/></span>
                                            <span class="bj-jstat-lbl">Last Visit</span>
                                        </div>
                                    </div>
                                    <div class="bj-jstat">
                                        <i class="fa fa-calendar"/>
                                        <div class="bj-jstat-info">
                                            <span class="bj-jstat-val"><field name="next_visit_date" nolabel="1" widget="date" class="d-inline"/></span>
                                            <span class="bj-jstat-lbl">Next Scheduled</span>
                                        </div>
                                    </div>
                                    <div class="bj-jstat">
                                        <i class="fa fa-user-md"/>
                                        <div class="bj-jstat-info">
                                            <span class="bj-jstat-val"><field name="registration_date" nolabel="1" widget="date" class="d-inline"/></span>
                                            <span class="bj-jstat-lbl">Client Since</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Booking Timeline Widget -->
                                <widget name="vu_booking_timeline"/>

                                <!-- Bookings List (collapsible) -->
                                <div class="bj-bookings-section mt-3">
                                    <div class="bj-section-header">
                                        <h3><i class="fa fa-list-alt"/> All Bookings</h3>
                                        <button name="action_view_fso_orders" type="object"
                                                class="btn btn-sm btn-outline-primary">
                                            <i class="fa fa-external-link"/> Open Full List
                                        </button>
                                    </div>
                                    <field name="booking_ids" mode="list" readonly="1">
                                        <list decoration-success="state in ('completed','completed_pending_invoice')"
                                              decoration-info="state == 'confirmed'"
                                              decoration-warning="state == 'in_progress'"
                                              decoration-muted="state == 'cancelled'"
                                              default_order="scheduled_datetime desc">
                                            <button name="action_open_ops_booking_detail" type="object"
                                                    string="" icon="fa-external-link"
                                                    class="btn btn-link p-0 text-primary"
                                                    title="Open Booking"/>
                                            <field name="name" string="Booking #"/>
                                            <field name="scheduled_datetime" string="Scheduled" widget="datetime"/>
                                            <field name="service_type" string="Service"/>
                                            <field name="lead_staff_id" string="Staff" widget="many2one_avatar"/>
                                            <field name="estimated_duration" string="Duration" widget="float_time"/>
                                            <field name="state" string="Status" widget="badge"
                                                   decoration-success="state in ('completed','completed_pending_invoice')"
                                                   decoration-info="state == 'confirmed'"
                                                   decoration-warning="state in ('in_progress','assigned')"
                                                   decoration-danger="state == 'cancelled'"/>
                                        </list>
                                    </field>
                                </div>

                                <field name="timeline_html" invisible="1"/>
                            </div>
                        </page>

                        <!-- ===== 3. ADDRESS INFORMATION ===== -->
                        <page string="Address Information" name="address_info">
                            <div class="vu-section">
                                <div class="vu-section-grid">
                                    <div class="vu-detail-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="file-text"/>
                                            <span>Address Details</span>
                                        </div>
                                        <group col="2">
                                            <label for="vietnamese_address" string="Home Address"/>
                                            <div class="o_row align-items-start">
                                                <field name="vietnamese_address" nolabel="1" readonly="1"
                                                       widget="text" class="flex-grow-1"/>
                                                <button name="action_edit_vietnamese_address"
                                                        type="object"
                                                        class="btn btn-link p-0 fa fa-pencil text-muted"
                                                        title="Edit address"/>
                                            </div>
                                            <field name="address_search" invisible="1"/>
                                            <field name="partner_latitude" invisible="1"/>
                                            <field name="partner_longitude" invisible="1"/>
                                            <field name="date_localization" invisible="1"/>
                                        </group>
                                        <div class="mt-2" invisible="not clinic_distance_display">
                                            <span class="vu-section__icon" data-icon="navigation"/>
                                            <span class="text-muted">Driving distance to clinic: </span>
                                            <field name="clinic_distance_display" readonly="1" nolabel="1" class="fw-bold d-inline"/>
                                            <field name="clinic_drive_distance_km" invisible="1"/>
                                            <field name="clinic_drive_minutes" invisible="1"/>
                                        </div>
                                        <div class="mt-2">
                                            <button name="action_geocode_address_photon"
                                                    type="object"
                                                    class="btn btn-secondary btn-sm"
                                                    icon="fa-map-marker"
                                                    string="Geocode Address"/>
                                        </div>
                                    </div>
                                    <div class="vu-detail-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="map-pin"/>
                                            <span>Map Location</span>
                                        </div>
                                        <field name="geo_coordinates_display" widget="address_map" nolabel="1"/>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <!-- ===== 3. INTAKE NOTES ===== -->
                        <page string="Intake Notes" name="intake_notes">
                            <div class="vu-section">
                                <div class="vu-section-grid">
                                    <div class="vu-detail-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="file-text"/>
                                            <span>Assessment Information</span>
                                        </div>
                                        <group col="1">
                                            <field name="intake_diagnosis"
                                                   placeholder="Medical diagnosis and assessment findings"
                                                   nolabel="1"/>
                                        </group>
                                    </div>
                                    <div class="vu-detail-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="heart-pulse"/>
                                            <span>Care Planning</span>
                                        </div>
                                        <group col="2">
                                            <field name="intake_referring_doctor_id"
                                                   placeholder="Select referring doctor"
                                                   options="{'no_create': True}"/>
                                            <field name="intake_goal_of_care"
                                                   placeholder="Primary goal or objective of care"/>
                                            <field name="intake_required_equipment"
                                                   placeholder="Equipment or supplies required"/>
                                        </group>
                                    </div>
                                </div>
                                <div class="vu-detail-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="file-text"/>
                                        <span>Additional Notes</span>
                                    </div>
                                    <group>
                                        <field name="intake_notes"
                                               placeholder="Additional intake assessment notes"
                                               nolabel="1"/>
                                    </group>
                                </div>
                            </div>
                        </page>

                        <!-- ===== 4. INSURANCE & BILLING ===== -->
                        <page string="Insurance &amp; Billing" name="insurance_billing">
                            <div class="vu-section">
                                <div class="vu-section-grid">
                                    <div class="vu-detail-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="shield-check"/>
                                            <span>Insurance Details</span>
                                        </div>
                                        <group col="2">
                                            <field name="insurance_provider"/>
                                            <field name="insurance_number"/>
                                            <field name="insurance_expiry"/>
                                        </group>
                                        <div class="alert alert-warning"
                                             invisible="not insurance_expiry or insurance_expiry &gt; context_today()"
                                             role="alert">
                                            <i class="fa fa-exclamation-triangle"/> Insurance has expired
                                        </div>
                                    </div>
                                    <div class="vu-detail-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="credit-card"/>
                                            <span>Payment Preferences</span>
                                        </div>
                                        <group col="1">
                                            <field name="payment_method" required="1"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>


                        <!-- ===== 6. ACTIVE PACKAGES ===== -->
                        <page string="Active Packages" name="active_packages">
                            <div class="vu-section">
                                <div class="vu-detail-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="gift"/>
                                        <span>Packages</span>
                                    </div>
                                    <p class="text-muted">
                                        Active packages are shown on the client profile overview.
                                    </p>
                                </div>
                            </div>
                        </page>

                        <!-- ===== 7. HEALTHCARE RELATIONSHIPS ===== -->
                        <page string="Healthcare Relationships" name="healthcare_relationships">
                            <div class="vu-section">
                                <div class="vu-detail-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="users-group"/>
                                        <span>Relationship Network</span>
                                    </div>
                                    <widget name="relationship_hierarchy"/>
                                </div>
                            </div>
                        </page>


                        <!-- ===== 9. CLINICAL NOTES ===== -->
                        <page string="Clinical Notes" name="clinical_notes">
                            <div class="vu-section">
                                <div class="vu-section-grid">
                                    <div class="vu-detail-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="heart-pulse"/>
                                            <span>Medical Profile</span>
                                        </div>
                                        <group col="2">
                                            <field name="blood_group"/>
                                            <field name="deceased"/>
                                        </group>
                                        <separator string="Known Allergies"/>
                                        <field name="allergies" nolabel="1"
                                               placeholder="List any known allergies (drug, food, environmental)..."
                                               widget="text"/>
                                    </div>
                                    <div class="vu-detail-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="file-text"/>
                                            <span>Diagnosis &amp; Care Plan</span>
                                        </div>
                                        <group col="1">
                                            <field name="intake_diagnosis"
                                                   placeholder="Medical diagnosis and assessment findings..."
                                                   widget="text" nolabel="1"/>
                                        </group>
                                        <separator string="Goal of Care"/>
                                        <field name="intake_goal_of_care" nolabel="1"
                                               placeholder="Primary care objectives..."
                                               widget="text"/>
                                        <separator string="Required Equipment"/>
                                        <field name="intake_required_equipment" nolabel="1"
                                               placeholder="Specialized equipment or supplies..."
                                               widget="text"/>
                                    </div>
                                </div>
                                <div class="vu-detail-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="file-text"/>
                                        <span>Medical History</span>
                                    </div>
                                    <field name="medical_history" nolabel="1"
                                           placeholder="Past medical history, surgeries, chronic conditions, previous treatments..."
                                           widget="text"/>
                                </div>
                                <div class="vu-detail-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="file-text"/>
                                        <span>Intake Notes</span>
                                    </div>
                                    <field name="intake_notes" nolabel="1"
                                           placeholder="Additional notes from intake assessment..."
                                           widget="text"/>
                                </div>
                            </div>
                        </page>

                        <!-- ===== 10. FINANCIAL SUMMARY ===== -->
                        <page string="Financial Summary" name="financial_summary">
                            <div class="vu-section">
                                <!-- Financial Stats Strip -->
                                <div class="bj-journey-stats">
                                    <div class="bj-jstat">
                                        <i class="fa fa-money"/>
                                        <div class="bj-jstat-info">
                                            <span class="bj-jstat-val"><field name="total_invoiced" nolabel="1" class="d-inline" widget="monetary"/></span>
                                            <span class="bj-jstat-lbl">Total Invoiced</span>
                                        </div>
                                    </div>
                                    <!-- credit is the client's receivable (what they still owe);
                                         it was labelled "Total Paid" and debit (payable) was shown
                                         as Outstanding. debit stays loaded for anything reading it. -->
                                    <div class="bj-jstat">
                                        <i class="fa fa-exclamation-circle text-danger"/>
                                        <div class="bj-jstat-info">
                                            <span class="bj-jstat-val"><field name="credit" nolabel="1" class="d-inline" widget="monetary"/></span>
                                            <span class="bj-jstat-lbl">Outstanding</span>
                                        </div>
                                    </div>
                                    <field name="debit" invisible="1"/>
                                    <div class="bj-jstat">
                                        <i class="fa fa-credit-card"/>
                                        <div class="bj-jstat-info">
                                            <span class="bj-jstat-val"><field name="payment_method" nolabel="1" class="d-inline"/></span>
                                            <span class="bj-jstat-lbl">Payment Method</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Invoices List -->
                                <div class="bj-bookings-section">
                                    <div class="bj-section-header">
                                        <h3><i class="fa fa-file-text-o"/> Invoices</h3>
                                    </div>
                                    <field name="invoice_ids" mode="list" readonly="1"
                                           domain="[('move_type', '=', 'out_invoice')]">
                                        <list decoration-success="payment_state in ('paid','in_payment')"
                                              decoration-danger="payment_state == 'not_paid' and state == 'posted'"
                                              decoration-warning="payment_state == 'partial'"
                                              decoration-muted="state == 'cancel'"
                                              default_order="invoice_date desc">
                                            <field name="name" string="Invoice #"/>
                                            <field name="invoice_date" string="Date"/>
                                            <field name="amount_total" string="Amount"/>
                                            <field name="amount_residual" string="Due"/>
                                            <field name="payment_state" string="Payment" widget="badge"
                                                   decoration-success="payment_state in ('paid','in_payment')"
                                                   decoration-danger="payment_state == 'not_paid'"
                                                   decoration-warning="payment_state == 'partial'"/>
                                            <field name="state" column_invisible="1"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </page>

                    </notebook>
                        </div><!-- /ws-main -->

                        <!-- RAIL — pinned while the main column scrolls -->
                        <div class="ws-rail">
                            <!-- "Summary" head: folds the panels when they sit above the tabs -->
                            <widget name="ws_rail_fold"/>
                            <!-- Quick actions: call / message / email and the
                                 registered shortcuts, as tiles, first in the rail -->
                            <widget name="ws_client_shortcuts"/>

                            <!-- Needs attention: draws its own panel, or nothing -->
                            <widget name="ws_client_glance" mode="attention"/>

                            <widget name="ws_client_glance" mode="glance"/>

                            <!-- People: the main contact (health_crm fills this panel);
                                 the client's own phone is on the identity line and the
                                 call / message tiles above -->
                            <div class="ws-panel ws-panel--people" name="people_panel">
                                <div class="ws-panel__head">People</div>
                            </div>
                        </div><!-- /ws-rail -->
                    </div><!-- /ws-page -->
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===== OPS CLIENT PROFILE FORM ACTION ===== -->
    <record id="action_ops_client_profile_form" model="ir.actions.act_window">
        <field name="name">Edit Client</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_health_patient_form_ops"/>
        <field name="target">current</field>
    </record>

</odoo>
