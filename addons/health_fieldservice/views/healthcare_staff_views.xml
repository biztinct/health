<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- Healthcare Staff List View -->
    <record id="view_healthcare_staff_list" model="ir.ui.view">
        <field name="name">healthcare.staff.list</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list string="Healthcare Staff" create="true" edit="true" delete="true"
                  decoration-success="employment_status=='active'"
                  decoration-warning="employment_status=='on_leave'"
                  decoration-danger="employment_status=='inactive'">
                
                <field name="name"/>
                <field name="job_id"/>
                <field name="access_role_display" string="Role"/>
                <field name="work_email"/>
                <field name="work_phone"/>
                <field name="employment_status"/>
                <field name="is_healthcare_staff" invisible="1"/>
                
                <!-- Healthcare Staff Actions -->
                <button name="action_view_assignments" 
                        type="object" 
                        icon="fa-calendar" 
                        string="View Assignments" 
                        title="View staff assignments"/>
                
            </list>
        </field>
    </record>

    <!-- Healthcare Staff Form View -->
    <record id="view_healthcare_staff_form" model="ir.ui.view">
        <field name="name">healthcare.staff.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            
            <!-- Add Healthcare Tab as First Tab -->
            <xpath expr="//notebook/page[1]" position="before">
                <page string="Healthcare Information" name="healthcare_info">
                    <div class="d-flex align-items-center gap-2 mb-3" invisible="not is_healthcare_staff">
                        <span class="fw-bold">Duty Status:</span>
                        <field name="duty_status" widget="badge" nolabel="1"
                               decoration-success="duty_status == 'available'"
                               decoration-info="duty_status == 'busy'"
                               decoration-warning="duty_status in ('off_hours','full','break')"
                               decoration-danger="duty_status in ('on_leave','off','inactive')"/>
                        <button name="%(action_health_staff_schedule_wizard)d" type="action"
                                string="Working Hours" icon="fa-clock-o"
                                class="btn btn-sm btn-outline-secondary ms-auto"
                                context="{'default_employee_id': id}"/>
                        <button name="%(action_health_staff_timeoff_wizard)d" type="action"
                                string="Record Time Off" icon="fa-plane"
                                class="btn btn-sm btn-outline-secondary"
                                context="{'default_employee_ids': [(6, 0, [id])]}"/>
                    </div>
                    <group>
                        <group string="Healthcare Role and Status">
                            <field name="is_healthcare_staff"/>
                            <field name="access_role_id" readonly="1" string="Access Role"/>
                            <field name="is_doctor_role" invisible="1"/>
                            <field name="is_nurse_role" invisible="1"/>
                            <field name="is_duty_doctor" invisible="not is_doctor_role"/>
                            <field name="is_head_nurse" invisible="not is_nurse_role"/>
                            <field name="employment_status" required="is_healthcare_staff"/>
                            <field name="employment_type" required="is_healthcare_staff"
                                   help="Full-time staff can create invoices; Part-time/Casual require Operations invoicing"/>
                            <field name="can_create_invoices" readonly="1"
                                   invisible="not is_healthcare_staff"/>
                            <field name="license_number"/>
                            <field name="staff_catchment_province_id" string="Catchment Province"
                                   options="{'no_create': True}"/>
                            <field name="healthcare_facility_id" options="{'no_create': True}"
                                   domain="[('catchment_province_id', '=', staff_catchment_province_id)]"
                                   help="Staff's healthcare facility - determines catchment province for booking assignments"/>
                            <field name="certification_expiry"/>
                        </group>

                        <group string="Assignment Preferences">
                            <field name="max_daily_assignments"/>
                            <field name="preferred_shift"/>
                            <field name="travel_radius_km"/>
                            <field name="availability_status"/>
                        </group>
                    </group>
                    
                    <group string="Skills and Competencies" col="1">
                        <field name="healthcare_skill_ids" widget="many2many_tags" 
                               options="{'color_field': 'weight', 'no_create_edit': True}"/>
                    </group>
                    
                    <group string="Performance Metrics" col="4">
                        <field name="total_assignments"/>
                        <field name="completed_assignments"/>
                        <field name="assignment_success_rate" widget="percentage"/>
                        <field name="average_patient_rating" widget="progressbar"/>
                        <field name="booking_credit"/>
                    </group>
                    
                    <separator string="Emergency Contact Information"/>
                    <group col="4">
                        <field name="emergency_contact_name"/>
                        <field name="emergency_contact_phone"/>
                        <field name="emergency_contact_relation"/>
                        <field name="emergency_contact_email"/>
                    </group>
                </page>
            </xpath>
            
            <!-- Add Healthcare indicator to button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" 
                        type="object" 
                        name="action_view_assignments"
                        icon="fa-calendar-check-o"
                        invisible="not is_healthcare_staff">
                    <field string="Assignments" name="total_assignments" widget="statinfo"/>
                </button>
                
                <button class="oe_stat_button" 
                        type="object" 
                        name="action_view_availability"
                        icon="fa-clock-o"
                        invisible="not is_healthcare_staff">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="availability_status"/>
                        </span>
                        <span class="o_stat_text">Status</span>
                    </div>
                </button>
            </xpath>

            <!-- Hide the generic HR-presence badge for healthcare staff; the real
                 Duty Status badge (Healthcare Information tab) replaces it. -->
            <xpath expr="//field[@name='hr_icon_display']" position="attributes">
                <attribute name="invisible">not show_hr_icon_display or not id or is_healthcare_staff</attribute>
            </xpath>

        </field>
    </record>

    <!-- Staff sub-menu actions: Schedules + Time Off -->
    <record id="action_health_staff_schedules" model="ir.actions.act_window">
        <field name="name">Staff Schedules</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_healthcare_staff', '=', True)]</field>
        <field name="view_id" ref="view_healthcare_staff_list"/>
        <field name="context">{'search_default_is_healthcare_staff': 1}</field>
    </record>

    <record id="action_health_staff_timeoff" model="ir.actions.act_window">
        <field name="name">Staff Time Off</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="domain">[('employee_id.is_healthcare_staff', '=', True)]</field>
    </record>

    <!-- Healthcare Staff Search View -->
    <record id="view_healthcare_staff_search" model="ir.ui.view">
        <field name="name">healthcare.staff.search</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <search string="Healthcare Staff Search">
                <field name="name"/>
            </search>
        </field>
    </record>

</data>
</odoo>
