<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- =====================================================================
         Visual Assignment Scheduler - Calendar-based Drag and Drop Interface
         Inspired by: Google Calendar, Calendly, When2meet, Microsoft Bookings
         ===================================================================== -->

    <!-- Assignment Scheduler Calendar View -->
    <record id="view_assignment_scheduler_calendar" model="ir.ui.view">
        <field name="name">health.staff.assignment.scheduler.calendar</field>
        <field name="model">health.staff.assignment</field>
        <field name="arch" type="xml">
            <calendar string="Visual Assignment Scheduler" 
                      date_start="assignment_date" 
                      color="staff_id"
                      event_open_popup="true"
                      quick_create="true"
                      mode="week"
                      scales="day,week,month">
                
                <!-- Fields displayed in calendar events -->
                <field name="name"/>
                <field name="fso_id"/>
                <field name="staff_id"/>
                <field name="assignment_role"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="assignment_score"/>
                <field name="assignment_type"/>
                
            </calendar>
        </field>
    </record>

    <!-- Assignment Scheduler Kanban View (Alternative for mobile/small screens) -->
    <record id="view_assignment_scheduler_kanban" model="ir.ui.view">
        <field name="name">health.staff.assignment.scheduler.kanban</field>
        <field name="model">health.staff.assignment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="staff_id" 
                    class="o_kanban_scheduler"
                    quick_create="false">
                
                <field name="name"/>
                <field name="fso_id"/>
                <field name="assignment_date"/>
                <field name="staff_id"/>
                <field name="assignment_role"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="assignment_score"/>
                
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card o_scheduler_assignment_card">
                            <!-- Assignment Header -->
                            <div class="o_assignment_header">
                                <strong class="o_assignment_name">
                                    <t t-esc="record.name.value"/>
                                </strong>
                                <div class="o_assignment_score float-right">
                                    <span t-att-class="'badge ' + (record.assignment_score.raw_value >= 80 ? 'badge-success' : record.assignment_score.raw_value >= 60 ? 'badge-warning' : 'badge-danger')">
                                        <t t-esc="Math.round(record.assignment_score.raw_value || 0)"/>%
                                    </span>
                                </div>
                            </div>
                            
                            <!-- Patient/Appointment Info -->
                            <div class="o_appointment_info">
                                <field name="fso_id"/>
                            </div>
                            
                            <!-- Assignment Details -->
                            <div class="o_assignment_details">
                                <div class="o_assignment_date">
                                    <i class="fa fa-calendar text-primary mr-1"/>
                                    <field name="assignment_date"/>
                                </div>
                                
                                <div class="o_assignment_priority">
                                    <i class="fa fa-flag text-warning mr-1"/>
                                    <field name="priority"/>
                                </div>
                            </div>
                            
                            <!-- Status Indicator -->
                            <div class="o_assignment_status">
                                <span t-att-class="'badge o_status_' + record.state.raw_value">
                                    <field name="state"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Assignment Scheduler Action -->
    <record id="action_assignment_scheduler_grid" model="ir.actions.act_window">
        <field name="name">Visual Assignment Scheduler</field>
        <field name="res_model">health.staff.assignment</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="view_id" ref="view_assignment_scheduler_calendar"/>
        <field name="target">current</field>
        <field name="context">{
            'scheduler_mode': True,
            'default_view': 'calendar',
            'calendar_default_view': 'week'
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Welcome to the Visual Assignment Scheduler!
            </p>
            <p>
                Use the calendar view to visually manage staff assignments. You can:
                <ul>
                    <li>Drag and drop assignments between time slots</li>
                    <li>View assignments by day, week, or month</li>
                    <li>Color-code assignments by staff member</li>
                    <li>Quick create new assignments</li>
                </ul>
            </p>
        </field>
    </record>

</data>
</odoo>
