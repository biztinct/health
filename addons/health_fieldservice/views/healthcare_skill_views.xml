<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <!-- Healthcare Skills Views -->
    <record id="view_health_staff_skill_list" model="ir.ui.view">
        <field name="name">health.staff.skill.list</field>
        <field name="model">health.staff.skill</field>
        <field name="arch" type="xml">
            <list string="Healthcare Skills">
                <field name="name"/>
                <field name="skill_category"/>
                <field name="required_certification"/>
                <field name="weight"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="view_health_staff_skill_form" model="ir.ui.view">
        <field name="name">health.staff.skill.form</field>
        <field name="model">health.staff.skill</field>
        <field name="arch" type="xml">
            <form string="Healthcare Skill">
                <sheet>
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="stethoscope"/>
                            <div>
                                <span>Skill Details</span>
                                <small class="text-muted d-block">Classification and certification</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <group col="2">
                                    <field name="name"/>
                                    <field name="skill_category"/>
                                    <field name="required_certification"/>
                                </group>
                            </div>
                            <div class="vu-card">
                                <group col="2">
                                    <field name="weight"/>
                                    <field name="certification_body"/>
                                    <field name="is_active"/>
                                </group>
                            </div>
                        </div>
                    </div>
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="file-text"/>
                            <div>
                                <span>Description</span>
                                <small class="text-muted d-block">Guidance for assignment matching</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <field name="description"/>
                            </div>
                        </div>
                    </div>
                    <notebook>
                        <page name="employees" string="Employees with this Skill">
                            <field name="employee_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="job_id"/>
                                    <field name="work_email"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Healthcare Skills Action -->
    <record id="action_healthcare_skills" model="ir.actions.act_window">
        <field name="name">Healthcare Skills</field>
        <field name="res_model">health.staff.skill</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first healthcare skill!
            </p>
            <p>
                Define healthcare skills and competencies that can be assigned to staff members
                for intelligent assignment matching.
            </p>
        </field>
    </record>

    <!-- Service Areas Views -->
    <record id="view_health_service_area_list" model="ir.ui.view">
        <field name="name">health.service.area.list</field>
        <field name="model">health.service.area</field>
        <field name="arch" type="xml">
            <list string="Service Areas">
                <field name="name"/>
                <field name="area_code"/>
                <field name="travel_time_minutes"/>
                <field name="priority"/>
                <field name="assignment_count"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="view_health_service_area_form" model="ir.ui.view">
        <field name="name">health.service.area.form</field>
        <field name="model">health.service.area</field>
        <field name="arch" type="xml">
            <form string="Service Area">
                <sheet>
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="map-pin"/>
                            <div>
                                <span>Service Area Details</span>
                                <small class="text-muted d-block">Code, priority and activation</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <group col="2">
                                    <field name="name"/>
                                    <field name="area_code"/>
                                    <field name="priority"/>
                                    <field name="is_active"/>
                                </group>
                            </div>
                            <div class="vu-card">
                                <group col="2">
                                    <field name="travel_time_minutes"/>
                                    <field name="radius_km"/>
                                    <field name="assignment_count"/>
                                    <field name="average_response_time"/>
                                </group>
                            </div>
                        </div>
                    </div>
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="file-text"/>
                            <div>
                                <span>Description &amp; Coordinates</span>
                                <small class="text-muted d-block">Narrative notes and geo center</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <field name="description"/>
                            </div>
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="map-pin"/>
                                    <span>Geographic Coordinates</span>
                                </div>
                                <group col="2">
                                    <field name="center_latitude"/>
                                    <field name="center_longitude"/>
                                </group>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Service Areas Action -->
    <record id="action_service_areas" model="ir.actions.act_window">
        <field name="name">Service Areas</field>
        <field name="res_model">health.service.area</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your first service area!
            </p>
            <p>
                Create geographic service areas for optimized staff assignment and 
                travel time calculations.
            </p>
        </field>
    </record>

    <!-- Healthcare Staff Management Action -->
    <record id="action_healthcare_staff" model="ir.actions.act_window">
        <field name="name">Healthcare Staff</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_healthcare_staff', '=', True)]</field>
        <field name="context">{
            'default_is_healthcare_staff': True,
            'search_default_active_staff': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first healthcare staff member!
            </p>
            <p>
                Manage healthcare staff members who can be assigned to field service orders.
                Configure their skills, availability, and competencies for optimal assignment matching.
            </p>
        </field>
    </record>

</data>
</odoo>
