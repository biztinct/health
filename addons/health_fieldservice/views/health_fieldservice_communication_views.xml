<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Communication Form View -->
    <record id="view_health_fieldservice_communication_form" model="ir.ui.view">
        <field name="name">health.fieldservice.communication.form</field>
        <field name="model">health.fieldservice.communication</field>
        <field name="arch" type="xml">
            <form string="Field Service Communication">
                <header>
                    <button name="action_mark_read" type="object" 
                            string="✓ Mark Read" class="oe_highlight"
                            invisible="is_read"/>
                    
                    <button name="action_reply" type="object" 
                            string="↩️ Reply" class="btn-secondary"/>
                    
                    <button name="action_escalate" type="object" 
                            string="⬆️ Escalate" class="btn-warning"
                            invisible="escalation_level >= 3"
                            confirm="Escalate this communication to higher management?"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_quick_status_update" type="object"
                                context="{'status': 'arrived'}"
                                class="oe_stat_button" icon="fa-tachometer">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Quick Status</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="subject" readonly="1"/>
                        </h1>
                        <div class="o_row">
                            <field name="priority" widget="priority"/>
                            <field name="message_type" widget="badge"/>
                        </div>
                    </div>
                    
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="timeline"/>
                            <div>
                                <span>Communication Context</span>
                                <small class="text-muted d-block">Message metadata, recipients and response expectations</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="file-text"/>
                                    <span>Communication Details</span>
                                </div>
                                <group col="2">
                                    <field name="fieldservice_order_id" options="{'no_create': True}"/>
                                    <field name="sender_id" readonly="1"/>
                                    <field name="communication_channel" readonly="1"/>
                                    <field name="create_date" readonly="1"/>
                                </group>
                            </div>
                            
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="users-group"/>
                                    <span>Recipients &amp; Response</span>
                                </div>
                                <group col="2">
                                    <field name="recipient_ids" widget="many2many_tags"/>
                                    <field name="recipient_role"/>
                                    <field name="requires_response"/>
                                    <field name="response_deadline" invisible="not requires_response"/>
                                    <field name="response_received" readonly="1"/>
                                </group>
                            </div>
                        </div>
                    </div>
                    
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="alert-triangle"/>
                            <div>
                                <span>Status &amp; Escalation</span>
                                <small class="text-muted d-block">Read confirmations, urgency and escalation handling</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="activity"/>
                                    <span>Status Tracking</span>
                                </div>
                                <group col="2">
                                    <field name="is_read" widget="boolean_toggle"/>
                                    <field name="read_date" readonly="1" invisible="not is_read"/>
                                    <field name="is_overdue" widget="boolean_toggle" readonly="1"/>
                                    <field name="urgency_score" readonly="1"/>
                                </group>
                            </div>
                            
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="users-group"/>
                                    <span>Escalation</span>
                                </div>
                                <group col="2">
                                    <field name="escalation_level" readonly="1"/>
                                    <field name="escalated_to_ids" widget="many2many_tags" readonly="1"/>
                                    <field name="auto_escalate"/>
                                    <field name="escalation_minutes" invisible="not auto_escalate"/>
                                </group>
                            </div>
                        </div>
                    </div>
                    
                    <notebook>
                        <page string="Message" name="message">
                            <field name="message" widget="html"/>
                        </page>
                        
                        <page string="Location" name="location" invisible="not gps_latitude">
                            <group>
                                <group string="GPS Coordinates">
                                    <field name="gps_latitude"/>
                                    <field name="gps_longitude"/>
                                    <field name="location_description"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Attachments" name="attachments" invisible="not attachment_ids">
                            <field name="attachment_ids"/>
                            <group>
                                <field name="has_photo" readonly="1"/>
                                <field name="has_audio" readonly="1"/>
                            </group>
                        </page>
                        
                        <page string="Responses" name="responses" invisible="not response_ids">
                            <field name="response_ids" readonly="1">
                                <list string="Responses">
                                    <field name="create_date"/>
                                    <field name="sender_id"/>
                                    <field name="message_type"/>
                                    <field name="priority"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Communication List View -->
    <record id="view_health_fieldservice_communication_list" model="ir.ui.view">
        <field name="name">health.fieldservice.communication.list</field>
        <field name="model">health.fieldservice.communication</field>
        <field name="arch" type="xml">
            <list string="Field Service Communications" default_order="create_date desc">
                <field name="create_date"/>
                <field name="fieldservice_order_id"/>
                <field name="sender_id"/>
                <field name="message_type"/>
                <field name="priority" decoration-danger="priority in ['urgent', 'emergency']"/>
                <field name="subject"/>
                <field name="requires_response"/>
                <field name="is_read" decoration-danger="not is_read and priority in ['urgent', 'emergency']"/>
                <field name="is_overdue" decoration-danger="is_overdue"/>
                <field name="urgency_score"/>
            </list>
        </field>
    </record>

    <!-- Communication Search View -->
    <record id="view_health_fieldservice_communication_search" model="ir.ui.view">
        <field name="name">health.fieldservice.communication.search</field>
        <field name="model">health.fieldservice.communication</field>
        <field name="arch" type="xml">
            <search string="Communication Search">
                <field name="subject"/>
            </search>
        </field>
    </record>

    <!-- Communication Action -->
    <record id="action_health_fieldservice_communication" model="ir.actions.act_window">
        <field name="name">Field Service Communications</field>
        <field name="res_model">health.fieldservice.communication</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_health_fieldservice_communication_search"/>
        <field name="context">{'search_default_today': 1, 'search_default_unread': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No communications found!
            </p>
            <p>
                Real-time communications between field staff, dispatchers, and supervisors.
                Stay connected during field service operations with instant messaging and status updates.
            </p>
        </field>
    </record>

</odoo>
