<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Field Service Order Stages -->
    <record id="stage_draft" model="health.fieldservice.stage">
        <field name="name">Draft</field>
        <field name="description">FSO created but not yet dispatched</field>
        <field name="sequence">10</field>
        <field name="color">1</field>
        <field name="is_default" eval="True"/>
        <field name="allow_edit" eval="True"/>
    </record>

    <record id="stage_dispatched" model="health.fieldservice.stage">
        <field name="name">Dispatched</field>
        <field name="description">Staff assigned and notified</field>
        <field name="sequence">20</field>
        <field name="color">2</field>
        <field name="allow_edit" eval="True"/>
    </record>

    <record id="stage_en_route" model="health.fieldservice.stage">
        <field name="name">En Route</field>
        <field name="description">Staff traveling to patient location</field>
        <field name="sequence">30</field>
        <field name="color">3</field>
        <field name="allow_edit" eval="True"/>
    </record>

    <record id="stage_arrived" model="health.fieldservice.stage">
        <field name="name">Arrived</field>
        <field name="description">Staff arrived at patient location</field>
        <field name="sequence">40</field>
        <field name="color">4</field>
        <field name="allow_edit" eval="True"/>
    </record>

    <record id="stage_in_progress" model="health.fieldservice.stage">
        <field name="name">In Progress</field>
        <field name="description">Service delivery in progress</field>
        <field name="sequence">50</field>
        <field name="color">5</field>
        <field name="allow_edit" eval="True"/>
    </record>

    <record id="stage_completed" model="health.fieldservice.stage">
        <field name="name">Completed</field>
        <field name="description">Service completed successfully</field>
        <field name="sequence">60</field>
        <field name="color">10</field>
        <field name="is_closed" eval="True"/>
        <field name="allow_edit" eval="False"/>
    </record>

    <record id="stage_cancelled" model="health.fieldservice.stage">
        <field name="name">Cancelled</field>
        <field name="description">Service cancelled</field>
        <field name="sequence">70</field>
        <field name="color">1</field>
        <field name="is_closed" eval="True"/>
        <field name="allow_edit" eval="False"/>
        <field name="fold" eval="True"/>
    </record>

</odoo>