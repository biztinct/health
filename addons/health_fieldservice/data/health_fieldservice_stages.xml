<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- Field Service Order Stages -->
    <record id="stage_draft" model="health.fieldservice.stage">
        <field name="name">Draft</field>
        <field name="description">FSO created but not yet dispatched</field>
        <field name="sequence">10</field>
        <field name="state">draft</field>
        <field name="color">1</field>
        <field name="is_default" eval="True"/>
        <field name="allow_edit" eval="True"/>
    </record>

    <record id="stage_booked" model="health.fieldservice.stage">
        <field name="name">Booked</field>
        <field name="description">Booking confirmed with quote</field>
        <field name="sequence">15</field>
        <field name="state">confirmed</field>
        <field name="color">9</field>
        <field name="allow_edit" eval="True"/>
        <field name="require_quote" eval="True"/>
        <field name="require_quote_items" eval="True"/>
    </record>

    <record id="stage_assigned" model="health.fieldservice.stage">
        <field name="name">Assigned</field>
        <field name="description">Staff assigned to the order</field>
        <field name="sequence">20</field>
        <field name="state">assigned</field>
        <field name="color">2</field>
        <field name="allow_edit" eval="True"/>
        <field name="require_staff_assignment" eval="True"/>
    </record>

    <record id="stage_en_route" model="health.fieldservice.stage">
        <field name="name">En Route</field>
        <field name="description">Staff traveling to patient location</field>
        <field name="sequence">30</field>
        <field name="state">assigned</field>
        <field name="color">3</field>
        <field name="allow_edit" eval="True"/>
        <field name="require_staff_assignment" eval="True"/>
    </record>

    <record id="stage_arrived" model="health.fieldservice.stage">
        <field name="name">Arrived</field>
        <field name="description">Staff arrived at patient location</field>
        <field name="sequence">40</field>
        <field name="state">assigned</field>
        <field name="color">4</field>
        <field name="allow_edit" eval="True"/>
        <field name="require_staff_assignment" eval="True"/>
    </record>

    <record id="stage_in_progress" model="health.fieldservice.stage">
        <field name="name">In Progress</field>
        <field name="description">Service delivery in progress</field>
        <field name="sequence">50</field>
        <field name="state">in_progress</field>
        <field name="color">5</field>
        <field name="allow_edit" eval="True"/>
        <field name="require_staff_assignment" eval="True"/>
    </record>

    <record id="stage_completed" model="health.fieldservice.stage">
        <field name="name">Completed</field>
        <field name="description">Service completed successfully</field>
        <field name="sequence">60</field>
        <field name="state">completed</field>
        <field name="color">10</field>
        <field name="is_closed" eval="True"/>
        <field name="allow_edit" eval="False"/>
        <field name="require_staff_assignment" eval="True"/>
    </record>

    <record id="stage_completed_pending_invoice" model="health.fieldservice.stage">
        <field name="name">Completed - Pending Invoice</field>
        <field name="description">Service completed by part-time staff, awaiting Operations invoice creation</field>
        <field name="sequence">65</field>
        <field name="state">completed_pending_invoice</field>
        <field name="color">8</field>
        <field name="is_closed" eval="False"/>
        <field name="allow_edit" eval="False"/>
        <field name="require_staff_assignment" eval="True"/>
    </record>

    <record id="stage_cancelled" model="health.fieldservice.stage">
        <field name="name">Cancelled</field>
        <field name="description">Service cancelled</field>
        <field name="sequence">70</field>
        <field name="state">cancelled</field>
        <field name="color">1</field>
        <field name="is_closed" eval="True"/>
        <field name="allow_edit" eval="False"/>
        <field name="fold" eval="True"/>
    </record>

</odoo>