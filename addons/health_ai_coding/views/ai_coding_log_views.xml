<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_coding_log_list" model="ir.ui.view">
        <field name="name">health.ai.coding.log.list</field>
        <field name="model">health.ai.coding.log</field>
        <field name="arch" type="xml">
            <list string="AI Coding Call Log" create="0" edit="0" delete="0">
                <field name="created_at"/>
                <field name="note_id"/>
                <field name="provider_id"/>
                <field name="suggested_count"/>
                <field name="dropped_codes"/>
                <field name="duration_ms"/>
                <field name="error"/>
            </list>
        </field>
    </record>

    <record id="view_ai_coding_log_form" model="ir.ui.view">
        <field name="name">health.ai.coding.log.form</field>
        <field name="model">health.ai.coding.log</field>
        <field name="arch" type="xml">
            <form string="AI Coding Call Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="created_at"/>
                            <field name="note_id"/>
                            <field name="provider_id"/>
                        </group>
                        <group>
                            <field name="suggested_count"/>
                            <field name="dropped_codes"/>
                            <field name="duration_ms"/>
                            <field name="error"/>
                        </group>
                    </group>
                    <group string="Request (redacted)">
                        <field name="request_json" widget="json" nolabel="1"/>
                    </group>
                    <group string="Raw Response">
                        <field name="response_json" widget="json" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_coding_log" model="ir.actions.act_window">
        <field name="name">AI Coding Call Log</field>
        <field name="res_model">health.ai.coding.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
