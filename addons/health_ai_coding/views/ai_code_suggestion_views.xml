<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List: default-filtered to suggested, grouped by patient. -->
    <record id="view_ai_code_suggestion_list" model="ir.ui.view">
        <field name="name">health.ai.code.suggestion.list</field>
        <field name="model">health.ai.code.suggestion</field>
        <field name="arch" type="xml">
            <list string="AI Code Suggestions" create="0"
                  decoration-muted="state == 'rejected'"
                  decoration-success="state == 'approved'">
                <header>
                    <button name="action_approve" type="object"
                            groups="health_base.group_healthcare_doctor,health_base.group_healthcare_head_nurse,health_base.group_healthcare_manager"
                            string="Approve selected" class="btn-primary"/>
                    <button name="action_reject" type="object"
                            groups="health_base.group_healthcare_doctor,health_base.group_healthcare_head_nurse,health_base.group_healthcare_manager"
                            string="Reject selected"/>
                </header>
                <field name="patient_id"/>
                <field name="note_date" string="Note Date"/>
                <field name="code_display" string="ICD-10"/>
                <field name="confidence_pct" string="Confidence"
                       widget="progressbar"/>
                <field name="evidence"/>
                <field name="state"/>
                <field name="reviewed_by" optional="hide"/>
                <button name="action_approve" type="object"
                            groups="health_base.group_healthcare_doctor,health_base.group_healthcare_head_nurse,health_base.group_healthcare_manager" string="Approve"
                        icon="fa-check" class="text-success"
                        invisible="state != 'suggested'"/>
                <button name="action_reject" type="object"
                            groups="health_base.group_healthcare_doctor,health_base.group_healthcare_head_nurse,health_base.group_healthcare_manager" string="Reject"
                        icon="fa-times" class="text-danger"
                        invisible="state != 'suggested'"/>
            </list>
        </field>
    </record>

    <!-- Form: the code proposal alongside the note's source free text. -->
    <record id="view_ai_code_suggestion_form" model="ir.ui.view">
        <field name="name">health.ai.code.suggestion.form</field>
        <field name="model">health.ai.code.suggestion</field>
        <field name="arch" type="xml">
            <form string="AI Code Suggestion" create="0">
                <header>
                    <button name="action_approve" type="object"
                            groups="health_base.group_healthcare_doctor,health_base.group_healthcare_head_nurse,health_base.group_healthcare_manager"
                            string="Approve" class="btn-primary"
                            invisible="state != 'suggested'"/>
                    <button name="action_reject" type="object"
                            groups="health_base.group_healthcare_doctor,health_base.group_healthcare_head_nurse,health_base.group_healthcare_manager"
                            string="Reject"
                            invisible="state != 'suggested'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="suggested,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group string="Proposed Code">
                            <field name="code_id" readonly="1"/>
                            <field name="confidence" readonly="1"/>
                            <field name="evidence" readonly="1"/>
                        </group>
                        <group string="Context">
                            <field name="patient_id" readonly="1"/>
                            <field name="note_id" readonly="1"/>
                            <field name="note_date" readonly="1"/>
                            <field name="reviewed_by" readonly="1"/>
                            <field name="reviewed_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Source Note (read-only)">
                        <field name="note_diagnosis" nolabel="1" readonly="1"
                               placeholder="No free-text diagnosis."/>
                        <field name="note_clinical_notes" widget="html"
                               nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search: group-by filters go directly in <search> (ledger §10). -->
    <record id="view_ai_code_suggestion_search" model="ir.ui.view">
        <field name="name">health.ai.code.suggestion.search</field>
        <field name="model">health.ai.code.suggestion</field>
        <field name="arch" type="xml">
            <search string="AI Code Suggestions">
                <field name="patient_id"/>
                <field name="code_id"/>
                <filter name="suggested" string="Pending"
                        domain="[('state', '=', 'suggested')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="group_patient" string="Patient"
                        context="{'group_by': 'patient_id'}"/>
                <filter name="group_note" string="Clinical Note"
                        context="{'group_by': 'note_id'}"/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_ai_code_suggestion" model="ir.actions.act_window">
        <field name="name">AI Code Suggestions</field>
        <field name="res_model">health.ai.code.suggestion</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_code_suggestion_search"/>
        <field name="context">{'search_default_suggested': 1,
                               'search_default_group_patient': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI code suggestions yet</p>
            <p>The nightly retro-coding sweep proposes ICD-10 codes for
               un-coded clinical notes here for a clinician to approve.</p>
        </field>
    </record>

</odoo>
