<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Nightly AI retro-coding sweep — handover §2.2.
             20:00 UTC = 03:00 ICT: the quiet-hours intent is LOCAL (the
             routes phase hit the UTC/ICT trap). No-op while enabled=False. -->
        <record id="cron_ai_coding_sweep" model="ir.cron">
            <field name="name">AI Coding: nightly retro-coding sweep</field>
            <field name="model_id" ref="model_health_ai_code_suggestion"/>
            <field name="state">code</field>
            <field name="code">model.cron_ai_coding_sweep()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=20, minute=0, second=0) + timedelta(days=1))"/>
        </record>

    </data>
</odoo>
