<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_health_form_instance" model="ir.actions.act_window">
        <field name="name">Form Instances</field>
        <field name="res_model">health.form.instance</field>
        <field name="view_mode">list,form,graph</field>
        <field name="search_view_id" ref="view_health_form_instance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a clinical assessment
            </p>
            <p>
                Fill a published form template for a client — scores and
                coded observations are extracted automatically.
            </p>
        </field>
    </record>

    <record id="action_health_form_template" model="ir.actions.act_window">
        <field name="name">Form Templates</field>
        <field name="res_model">health.form.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_health_form_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Author a clinical form
            </p>
            <p>
                Build versioned, scored assessment forms rendered in both
                the backend and the nurse PWA from one JSON schema.
            </p>
        </field>
    </record>

    <menuitem id="menu_health_forms" name="Assessments &amp; Forms"
              parent="health_base.menu_healthcare_clinical" sequence="12"/>

    <menuitem id="menu_health_form_instances" name="Form Instances"
              parent="menu_health_forms" sequence="10"
              action="action_health_form_instance"/>

    <menuitem id="menu_health_form_templates" name="Form Templates"
              parent="menu_health_forms" sequence="20"
              action="action_health_form_template"
              groups="health_base.group_healthcare_manager,health_base.group_healthcare_admin,health_base.group_healthcare_owner"/>

    <!-- Mirror under Configuration for lookup management -->
    <menuitem id="menu_health_form_templates_config" name="Form Templates"
              parent="health_base.menu_healthcare_lookups" sequence="60"
              action="action_health_form_template"
              groups="health_base.group_healthcare_manager,health_base.group_healthcare_admin,health_base.group_healthcare_owner"/>

</odoo>
