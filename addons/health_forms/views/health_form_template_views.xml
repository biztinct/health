<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_health_form_template_list" model="ir.ui.view">
        <field name="name">health.form.template.list</field>
        <field name="model">health.form.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="version"/>
                <field name="category"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-muted="state == 'retired'"/>
                <field name="is_latest"/>
                <field name="instance_count"/>
            </list>
        </field>
    </record>

    <record id="view_health_form_template_form" model="ir.ui.view">
        <field name="name">health.form.template.form</field>
        <field name="model">health.form.template</field>
        <field name="arch" type="xml">
            <form string="Form Template">
                <header>
                    <button name="action_publish" type="object"
                            string="Publish" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_retire" type="object"
                            string="Retire"
                            invisible="state != 'published'"
                            confirm="Retire this form template? Existing instances keep rendering from their own schema snapshot."/>
                    <button name="action_new_version" type="object"
                            string="New Version"
                            invisible="state != 'published'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,retired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_instances" type="object"
                                class="oe_stat_button" icon="fa-list-alt">
                            <field name="instance_count" widget="statinfo"
                                   string="Instances"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Form title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name_vi"/>
                            <field name="code"/>
                            <field name="version"/>
                            <field name="category"/>
                            <field name="is_latest"/>
                        </group>
                        <group>
                            <field name="service_type_ids"
                                   widget="many2many_tags"/>
                            <field name="scoring_method"/>
                            <field name="score_vitals_type_id"/>
                            <field name="predecessor_id"/>
                            <field name="published_date"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Questions" name="questions">
                            <field name="question_ids"
                                   readonly="state == 'published'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="key"/>
                                    <field name="question_type"/>
                                    <field name="label"/>
                                    <field name="label_vi" optional="show"/>
                                    <field name="required"/>
                                    <field name="options_json"
                                           widget="health_json_edit"
                                           optional="show"/>
                                    <field name="min_value" optional="show"/>
                                    <field name="max_value" optional="show"/>
                                    <field name="score_weight"
                                           optional="show"/>
                                    <field name="loinc_code" optional="show"/>
                                    <field name="vitals_type_id"
                                           optional="show"/>
                                    <field name="ucum_unit" optional="hide"/>
                                    <field name="visible_if_json"
                                           widget="health_json_edit"
                                           optional="hide"/>
                                    <field name="help" optional="hide"/>
                                    <field name="help_vi" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Scoring Bands" name="scoring_bands">
                            <field name="scoring_bands_json"
                                   widget="health_json_edit"
                                   readonly="state == 'published'"/>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Preview" name="preview">
                            <field name="schema_json"
                                   widget="health_form_renderer"
                                   options="{'preview': true}"
                                   readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_health_form_template_search" model="ir.ui.view">
        <field name="name">health.form.template.search</field>
        <field name="model">health.form.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="published" string="Published"
                        domain="[('state', '=', 'published')]"/>
                <filter name="latest" string="Latest only"
                        domain="[('is_latest', '=', True)]"/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="group_by_code" string="Form Code"
                        context="{'group_by': 'code'}"/>
                <filter name="group_by_category" string="Category"
                        context="{'group_by': 'category'}"/>
            </search>
        </field>
    </record>

</odoo>
