#. module: health_forms
#: code:addons/health_forms/models/health_form_template.py:0
msgid "Cannot publish a form template without questions."
msgstr "Không thể xuất bản mẫu biểu mẫu không có câu hỏi."

#. module: health_forms
#: code:addons/health_forms/models/health_form_template.py:0
msgid "Question keys must be unique within the template."
msgstr "Khóa câu hỏi phải là duy nhất trong mẫu."

#. module: health_forms
#: code:addons/health_forms/models/health_form_template.py:0
msgid "Only draft templates can be published."
msgstr "Chỉ mẫu ở trạng thái nháp mới được xuất bản."

#. module: health_forms
#: code:addons/health_forms/models/health_form_template.py:0
msgid "Only published templates can be retired."
msgstr "Chỉ mẫu đã xuất bản mới có thể ngừng sử dụng."

#. module: health_forms
#: code:addons/health_forms/models/health_form_question.py:0
msgid ""
"Questions of a published form template are immutable. Create a new "
"version instead."
msgstr ""
"Câu hỏi của mẫu đã xuất bản không thể chỉnh sửa. Hãy tạo phiên bản mới."

#. module: health_forms
#: code:addons/health_forms/models/health_form_instance.py:0
msgid "Only draft form instances can be completed."
msgstr "Chỉ phiếu đánh giá ở trạng thái nháp mới có thể hoàn thành."

#. module: health_forms
#: code:addons/health_forms/models/health_form_instance.py:0
msgid "Required question \"%s\" is not answered."
msgstr "Câu hỏi bắt buộc \"%s\" chưa được trả lời."

#. module: health_forms
#: code:addons/health_forms/models/health_form_instance.py:0
msgid "Answer to \"%s\" must be a number."
msgstr "Câu trả lời cho \"%s\" phải là một số."

#. module: health_forms
#: code:addons/health_forms/models/health_form_instance.py:0
msgid "Answer to \"%s\" is below the minimum (%s)."
msgstr "Câu trả lời cho \"%s\" thấp hơn giá trị tối thiểu (%s)."

#. module: health_forms
#: code:addons/health_forms/models/health_form_instance.py:0
msgid "Answer to \"%s\" is above the maximum (%s)."
msgstr "Câu trả lời cho \"%s\" cao hơn giá trị tối đa (%s)."

#. module: health_forms
#: code:addons/health_forms/models/health_form_instance.py:0
msgid "Only head nurses and above can amend a completed form instance."
msgstr ""
"Chỉ điều dưỡng trưởng trở lên mới được sửa phiếu đánh giá đã hoàn thành."

#. module: health_forms
#: code:addons/health_forms/models/health_form_instance.py:0
msgid "Only head nurses and above can cancel form instances."
msgstr "Chỉ điều dưỡng trưởng trở lên mới được hủy phiếu đánh giá."

#. module: health_forms
#: code:addons/health_forms/models/health_form_instance.py:0
msgid "Only draft or completed form instances can be cancelled."
msgstr ""
"Chỉ phiếu đánh giá ở trạng thái nháp hoặc đã hoàn thành mới có thể hủy."

#. module: health_forms
#: code:addons/health_forms/models/health_form_instance.py:0
msgid ""
"Completed form instances cannot be deleted (clinical record integrity). "
"Cancel or amend instead."
msgstr ""
"Không thể xóa phiếu đánh giá đã hoàn thành (bảo toàn hồ sơ lâm sàng). "
"Hãy hủy hoặc sửa đổi."

#. module: health_forms
#: code:addons/health_forms/models/health_form_instance.py:0
msgid "Form instances can only be created from published templates."
msgstr "Phiếu đánh giá chỉ được tạo từ mẫu đã xuất bản."

