<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ================================================================
         The Studio button on the Client and Contact records.

         Both screens hide the standard control panel and draw their own top
         bar, so the button the core puts beside the cog is never seen there.
         The same markup (biz_form_studio.StudioButton) is called from each
         bar's right-hand slot, just left of the save indicator. The
         controllers extend the form controller, so the core's patch already
         gives them `fsCanEdit`, `fsIcon` and `openFormStudio`.
         ================================================================ -->
    <t t-inherit="health_fieldservice.OpsClientProfileFormView" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('ops-header-right')]/t[@t-if='canEdit']" position="before">
            <t t-call="biz_form_studio.StudioButton"/>
        </xpath>
    </t>

    <t t-inherit="health_crm.CrmContactFormView" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('crm-form-header-right')]/t[@t-if='canEdit']" position="before">
            <t t-call="biz_form_studio.StudioButton"/>
        </xpath>
    </t>

</templates>
