<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Health Related Party Tree View -->
    <record id="view_health_related_party_tree" model="ir.ui.view">
        <field name="name">health.related.party.tree</field>
        <field name="model">health.related.party</field>
        <field name="arch" type="xml">
            <tree string="Healthcare Related Parties">
                <field name="client_id"/>
                <field name="partner_id"/>
                <field name="relationship_type"/>
                <field name="caregiver_relationship" groups="base.group_no_one"/>
                <field name="payer_relationship" groups="base.group_no_one"/>
                <field name="referrer_type" groups="base.group_no_one"/>
                <field name="is_active"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </tree>
        </field>
    </record>

    <!-- Health Related Party Form View -->
    <record id="view_health_related_party_form" model="ir.ui.view">
        <field name="name">health.related.party.form</field>
        <field name="model">health.related.party</field>
        <field name="arch" type="xml">
            <form string="Healthcare Related Party">
                <header>
                    <field name="is_active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <group name="basic_info">
                            <field name="client_id" options="{'no_create': True}"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="relationship_type"/>
                        </group>
                        <group name="dates">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>

                    <!-- Caregiver Details -->
                    <group name="caregiver_details" string="Caregiver Details" 
                           invisible="relationship_type != 'caregiver'">
                        <group>
                            <field name="caregiver_relationship"/>
                            <field name="caregiver_availability"/>
                        </group>
                        <group>
                            <field name="caregiver_notes" colspan="2"/>
                        </group>
                    </group>

                    <!-- Payer Details -->
                    <group name="payer_details" string="Payer Details" 
                           invisible="relationship_type != 'payer'">
                        <group>
                            <field name="payer_relationship"/>
                            <field name="payment_responsibility"/>
                            <field name="tax_id_number"/>
                            <field name="insurance_policy_number"/>
                        </group>
                        <group>
                            <field name="payer_notes" colspan="2"/>
                        </group>
                    </group>

                    <!-- Referrer Details -->
                    <group name="referrer_details" string="Referrer Details" 
                           invisible="relationship_type != 'referrer'">
                        <group>
                            <field name="referrer_type"/>
                            <field name="referral_date"/>
                            <field name="commission_rate"/>
                        </group>
                        <group>
                            <field name="referral_notes" colspan="2"/>
                        </group>
                    </group>

                    <!-- Contact Information -->
                    <group name="contact_info" string="Alternative Contact Information">
                        <group>
                            <field name="alternative_phone"/>
                            <field name="alternative_email"/>
                        </group>
                        <group>
                            <field name="contact_notes" colspan="2"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Health Related Party Search View -->
    <record id="view_health_related_party_search" model="ir.ui.view">
        <field name="name">health.related.party.search</field>
        <field name="model">health.related.party</field>
        <field name="arch" type="xml">
            <search string="Healthcare Related Parties">
                <field name="client_id"/>
                <field name="partner_id"/>
                <field name="relationship_type"/>
                <field name="caregiver_relationship"/>
                <field name="payer_relationship"/>
                <field name="referrer_type"/>
                
                <filter name="active" string="Active" domain="[('is_active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('is_active', '=', False)]"/>
                
                <separator/>
                <filter name="caregivers" string="Caregivers" domain="[('relationship_type', '=', 'caregiver')]"/>
                <filter name="payers" string="Payers" domain="[('relationship_type', '=', 'payer')]"/>
                <filter name="referrers" string="Referrers" domain="[('relationship_type', '=', 'referrer')]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_by_client" string="Client" context="{'group_by': 'client_id'}"/>
                    <filter name="group_by_relationship_type" string="Relationship Type" context="{'group_by': 'relationship_type'}"/>
                    <filter name="group_by_partner" string="Related Person" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Health Related Party Action -->
    <record id="action_health_related_party" model="ir.actions.act_window">
        <field name="name">Healthcare Related Parties</field>
        <field name="res_model">health.related.party</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_health_related_party_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a healthcare relationship
            </p>
            <p>
                Healthcare related parties link patients with their caregivers, 
                payers, and referrers to manage the complete care network.
            </p>
        </field>
    </record>

</odoo>