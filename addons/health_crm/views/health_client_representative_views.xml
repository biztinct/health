<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client Representative Tree View -->
    <record id="view_health_client_representative_tree" model="ir.ui.view">
        <field name="name">health.client.representative.tree</field>
        <field name="model">health.client.representative</field>
        <field name="arch" type="xml">
            <tree string="Client Representatives">
                <field name="contact_id"/>
                <field name="representative_name"/>
                <field name="kinship_title"/>
                <field name="preferred_name"/>
                <field name="relationship"/>
                <field name="representative_phone_1"/>
                <field name="email"/>
                <field name="zalo"/>
                <field name="is_primary"/>
                <field name="details_complete"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Client Representative Form View -->
    <record id="view_health_client_representative_form" model="ir.ui.view">
        <field name="name">health.client.representative.form</field>
        <field name="model">health.client.representative</field>
        <field name="arch" type="xml">
            <form string="Client Representative">
                <header>
                    <button name="action_set_as_primary" 
                            string="Set as Primary" 
                            type="object" 
                            class="btn-primary"
                            invisible="is_primary"/>
                    <button name="action_create_followup_activity" 
                            string="Create Follow-up" 
                            type="object" 
                            class="btn-secondary"
                            invisible="details_complete"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="representative_name" placeholder="Representative Name..."/>
                        </h1>
                        <h2>
                            <field name="kinship_title" placeholder="Kinship Title (Ông, Bà, Anh, Chị...)"/>
                        </h2>
                    </div>

                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="contact_id" options="{'no_create': True}"/>
                            <field name="preferred_name"/>
                            <field name="relationship"/>
                            <field name="is_primary"/>
                            <field name="details_complete" readonly="1"/>
                        </group>
                    </group>

                    <!-- Contact Information from Excel -->
                    <group name="contact_info" string="Contact Information">
                        <group>
                            <field name="representative_phone_1"/>
                            <field name="representative_phone_2"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="zalo"/>
                        </group>
                    </group>

                    <!-- Notes -->
                    <group name="notes" string="Notes">
                        <field name="notes" nolabel="1" placeholder="Additional notes about this representative..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Client Representative Search View -->
    <record id="view_health_client_representative_search" model="ir.ui.view">
        <field name="name">health.client.representative.search</field>
        <field name="model">health.client.representative</field>
        <field name="arch" type="xml">
            <search string="Client Representatives">
                <field name="representative_name"/>
                <field name="contact_id"/>
                <field name="kinship_title"/>
                <field name="preferred_name"/>
                <field name="representative_phone_1"/>
                <field name="email"/>
                <field name="zalo"/>
                
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                
                <separator/>
                <filter name="primary" string="Primary Representatives" domain="[('is_primary', '=', True)]"/>
                <filter name="incomplete_details" string="Incomplete Details" domain="[('details_complete', '=', False)]"/>
                
                <separator/>
                <filter name="is_client" string="Is Client" domain="[('relationship', '=', 'is_client')]"/>
                <filter name="relatives" string="Relatives" domain="[('relationship', '=', 'relative')]"/>
                <filter name="friends" string="Friends" domain="[('relationship', '=', 'friend')]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_by_contact" string="Contact" context="{'group_by': 'contact_id'}"/>
                    <filter name="group_by_relationship" string="Relationship" context="{'group_by': 'relationship'}"/>
                    <filter name="group_by_kinship" string="Kinship Title" context="{'group_by': 'kinship_title'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Client Representative Action -->
    <record id="action_health_client_representative" model="ir.actions.act_window">
        <field name="name">Client Representatives</field>
        <field name="res_model">health.client.representative</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_health_client_representative_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a client representative
            </p>
            <p>
                Client representatives are people who can represent clients 
                when they cannot communicate directly. This is particularly 
                important for elderly patients or those with communication barriers.
            </p>
            <p>
                From Excel requirements: Links to Contact table with representative details, 
                contact information, and completeness tracking for follow-up workflows.
            </p>
        </field>
    </record>

</odoo>