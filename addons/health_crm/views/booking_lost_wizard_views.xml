<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Booking Lost Wizard Form -->
    <record id="view_booking_lost_wizard_form" model="ir.ui.view">
        <field name="name">health.crm.booking.lost.wizard.form</field>
        <field name="model">health.crm.booking.lost.wizard</field>
        <field name="arch" type="xml">
            <form string="Booking Lost Reason">
                <group>
                    <field name="lead_id" invisible="1"/>
                    <field name="booking_lost_reason" placeholder="Please explain why this booking was lost..." nolabel="1"/>
                </group>
                <footer>
                    <button string="Confirm" name="action_confirm_booking_lost" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
