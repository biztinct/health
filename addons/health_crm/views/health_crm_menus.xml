<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Healthcare CRM Menu under main Healthcare menu -->
    <menuitem 
        id="menu_healthcare_crm_root"
        name="CRM"
        parent="health_base.menu_healthcare_root"
        sequence="20"
        groups="group_health_crm_user"/>

    <!-- Leads/Opportunities -->
    <menuitem 
        id="menu_healthcare_leads"
        name="Leads &amp; Opportunities"
        parent="menu_healthcare_crm_root"
        action="crm.crm_lead_all_leads"
        sequence="10"/>

    <!-- Pipeline -->
    <menuitem 
        id="menu_healthcare_pipeline"
        name="Pipeline"
        parent="menu_healthcare_crm_root"
        action="crm.crm_lead_opportunities"
        sequence="20"/>

    <!-- Customers/Contacts -->
    <menuitem 
        id="menu_healthcare_customers"
        name="Customers"
        parent="menu_healthcare_crm_root"
        action="base.action_partner_form"
        sequence="30"/>

    <!-- Client Representatives (FROM EXCEL REQUIREMENTS) -->
    <menuitem 
        id="menu_healthcare_client_representatives"
        name="Client Representatives"
        parent="menu_healthcare_crm_root"
        action="action_health_client_representative"
        sequence="45"/>

    <!-- Reporting -->
    <menuitem 
        id="menu_healthcare_crm_reporting"
        name="Reporting"
        parent="menu_healthcare_crm_root"
        sequence="50"
        groups="group_health_crm_manager"/>

    <!-- Configuration -->
    <menuitem 
        id="menu_healthcare_crm_config"
        name="Configuration"
        parent="menu_healthcare_crm_root"
        sequence="60"
        groups="group_health_crm_manager"/>

    <!-- CRM Teams -->
    <menuitem 
        id="menu_healthcare_crm_teams"
        name="Sales Teams"
        parent="menu_healthcare_crm_config"
        action="sales_team.crm_team_action_config"
        sequence="10"/>

    <!-- CRM Stages -->
    <menuitem 
        id="menu_healthcare_crm_stages"
        name="Stages"
        parent="menu_healthcare_crm_config"
        action="crm.crm_stage_action"
        sequence="20"/>

