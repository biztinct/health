<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== CLIENT ACTIONS (OWL Components) ===== -->

    <record id="action_crm_dashboard" model="ir.actions.client">
        <field name="name">CRM Dashboard</field>
        <field name="tag">crm_dashboard</field>
        <field name="target">current</field>
        <field name="context">{'active_center': 'crm_center'}</field>
    </record>

    <record id="action_crm_new_contact" model="ir.actions.client">
        <field name="name">New Contact</field>
        <field name="tag">crm_new_contact</field>
        <field name="target">current</field>
        <field name="context">{'active_center': 'crm_center'}</field>
    </record>

    <record id="action_crm_settings" model="ir.actions.client">
        <field name="name">CRM Settings</field>
        <field name="tag">crm_settings</field>
        <field name="target">current</field>
        <field name="context">{'active_center': 'crm_center'}</field>
    </record>

    <record id="action_crm_booking_wizard" model="ir.actions.client">
        <field name="name">CRM Booking</field>
        <field name="tag">crm_booking_wizard</field>
        <field name="target">current</field>
        <field name="context">{'active_center': 'crm_center'}</field>
    </record>

    <!-- NOTE: act_window actions are defined in crm_center_views.xml (with view bindings) -->

    <!-- ===== ROOT MENU: CRM Center ===== -->

    <menuitem id="menu_crm_center_root"
              name="CRM Center"
              groups="health_crm.group_health_crm_user"
              web_icon="health_crm,static/description/icon.png"
              sequence="11"/>

    <!-- Sub-menus -->

    <menuitem id="menu_crm_dashboard"
              name="Dashboard"
              parent="menu_crm_center_root"
              action="action_crm_dashboard"
              sequence="10"/>

    <menuitem id="menu_crm_new_contact"
              name="New Contact"
              parent="menu_crm_center_root"
              action="action_crm_new_contact"
              sequence="15"/>

    <menuitem id="menu_crm_contacts"
              name="Contacts"
              parent="menu_crm_center_root"
              action="action_crm_contact_list_native"
              sequence="20"/>

    <menuitem id="menu_crm_clients"
              name="Clients"
              parent="menu_crm_center_root"
              action="action_crm_client_list"
              sequence="25"/>

    <menuitem id="menu_crm_bookings"
              name="Bookings"
              parent="menu_crm_center_root"
              action="action_crm_bookings_calendar"
              sequence="27"/>

    <menuitem id="menu_crm_calendar"
              name="Follow-up Calendar"
              parent="menu_crm_center_root"
              action="action_crm_followup_calendar"
              sequence="30"/>

    <menuitem id="menu_crm_activities"
              name="Activities"
              parent="menu_crm_center_root"
              action="action_crm_activity_list"
              sequence="40"/>

    <menuitem id="menu_crm_settings"
              name="Settings"
              parent="menu_crm_center_root"
              action="action_crm_settings"
              sequence="90"/>

</odoo>
