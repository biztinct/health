<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================
         Clients LIST (health_fieldservice.view_health_client_list_ops):
         add a "Log Activity" button before "Book". Logs an activity against
         the client's originating CRM contact so it surfaces in Activities.
         =================================================================== -->
    <record id="view_health_client_list_ops_crm_logactivity" model="ir.ui.view">
        <field name="name">res.partner.list.ops.client.log-activity</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="health_fieldservice.view_health_client_list_ops"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_create_fso']" position="before">
                <button name="action_log_activity_client" type="object"
                        string="Log Activity" icon="fa-clock-o"
                        title="Log Activity for this client's main contact"
                        class="ops-cl-btn ops-cl-btn--lead"/>
            </xpath>
        </field>
    </record>

    <!-- ===================================================================
         Client PROFILE (health_fieldservice.view_health_patient_form_ops):
         the editable Main Contact (+ its phone) sits in the Workspace rail's
         People panel, under the client's own row (WS-2). It used to be drawn
         by a controller-template extension in the old identity header; that
         header is gone, and so is the extension.
         =================================================================== -->
    <record id="view_health_patient_form_ops_crm_maincontact" model="ir.ui.view">
        <field name="name">res.partner.form.ops.client.main-contact</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="health_fieldservice.view_health_patient_form_ops"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='people_panel']" position="inside">
                <field name="allowed_main_contact_ids" invisible="1"/>
                <div class="ws-person ws-person--main-contact">
                    <div class="ws-person__body">
                        <div class="ws-person__role">Main contact</div>
                        <field name="main_contact_id" nolabel="1" class="ws-person__field"
                               domain="[('id', 'in', allowed_main_contact_ids)]"
                               options="{'no_create': True}"/>
                        <div class="ws-person__sub" invisible="not main_contact_phone">
                            <field name="main_contact_phone" readonly="1"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
