<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Healthcare Contact Reason Views -->
    <record id="view_health_contact_reason_form" model="ir.ui.view">
        <field name="name">health.contact.reason.form</field>
        <field name="model">health.contact.reason</field>
        <field name="arch" type="xml">
            <form string="Healthcare Contact Reason">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Contact Reason Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="usage_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Multilingual Support">
                        <field name="name_vietnamese"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Detailed description of when to use this contact reason..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_health_contact_reason_tree" model="ir.ui.view">
        <field name="name">health.contact.reason.tree</field>
        <field name="model">health.contact.reason</field>
        <field name="arch" type="xml">
            <list string="Healthcare Contact Reasons">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="usage_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_health_contact_reason_search" model="ir.ui.view">
        <field name="name">health.contact.reason.search</field>
        <field name="model">health.contact.reason</field>
        <field name="arch" type="xml">
            <search string="Search Contact Reasons">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_health_contact_reason" model="ir.actions.act_window">
        <field name="name">Contact Reasons</field>
        <field name="res_model">health.contact.reason</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create contact reasons for CRM leads!
            </p>
            <p>
                Contact reasons help categorize why contacts are reaching out to your healthcare organization.
                This is useful for Sales and Operations Management reporting.
            </p>
        </field>
    </record>

    <!-- Healthcare Lead Reason Views -->
    <record id="view_health_lead_reason_form" model="ir.ui.view">
        <field name="name">health.lead.reason.form</field>
        <field name="model">health.lead.reason</field>
        <field name="arch" type="xml">
            <form string="Healthcare Lead Reason">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Lead Reason Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="lead_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="usage_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Multilingual Support">
                        <field name="name_vietnamese"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Detailed description of when to use this lead reason..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_health_lead_reason_tree" model="ir.ui.view">
        <field name="name">health.lead.reason.tree</field>
        <field name="model">health.lead.reason</field>
        <field name="arch" type="xml">
            <list string="Healthcare Lead Reasons">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="lead_type"/>
                <field name="usage_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_health_lead_reason_search" model="ir.ui.view">
        <field name="name">health.lead.reason.search</field>
        <field name="model">health.lead.reason</field>
        <field name="arch" type="xml">
            <search string="Search Lead Reasons">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_health_lead_reason" model="ir.actions.act_window">
        <field name="name">Lead Reasons</field>
        <field name="res_model">health.lead.reason</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create lead reasons for CRM opportunities!
            </p>
            <p>
                Lead reasons help categorize the motivation or source behind leads and opportunities.
                This is useful for tracking conversion sources and marketing effectiveness.
            </p>
        </field>
    </record>

    <!-- Healthcare Province Views -->
    <record id="view_health_province_form" model="ir.ui.view">
        <field name="name">health.province.form</field>
        <field name="model">health.province</field>
        <field name="arch" type="xml">
            <form string="Vietnamese Province">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Province Name (English)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name_vietnamese"/>
                            <field name="code"/>
                            <field name="region"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="usage_count" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_health_province_tree" model="ir.ui.view">
        <field name="name">health.province.tree</field>
        <field name="model">health.province</field>
        <field name="arch" type="xml">
            <list string="Vietnamese Provinces">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="name_vietnamese"/>
                <field name="region"/>
                <field name="usage_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

        <record id="view_health_province_search" model="ir.ui.view">
        <field name="name">health.province.search</field>
        <field name="model">health.province</field>
        <field name="arch" type="xml">
            <search string="Search Provinces">
                <field name="name"/>
            </search>
        </field>
    </record>


    <record id="action_health_province" model="ir.actions.act_window">
        <field name="name">Provinces/Cities</field>
        <field name="res_model">health.province</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Vietnamese provinces and cities!
            </p>
            <p>
                Province lookup table for Vietnamese locations used in CRM leads.
                This helps track geographic distribution of leads and customers.
            </p>
        </field>
    </record>

</odoo>
