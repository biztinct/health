<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Patient Form View with Relationship Smart Buttons (Section 2.2) -->
    <record id="view_health_patient_form_relation_buttons" model="ir.ui.view">
        <field name="name">res.partner.patient.form.relation.buttons</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="health_base.view_health_patient_form"/>
        <field name="arch" type="xml">
            <!-- Add relationship smart buttons after existing buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- PATIENT SIDE: My Representatives (Section 2.2) -->
                <button name="action_view_all_relationships" type="object" class="oe_stat_button" icon="fa-users"
                        invisible="relationship_total_count == 0">
                    <field name="relationship_total_count" string="All Relationships" widget="statinfo"/>
                </button>
                <button name="action_view_my_caregivers" type="object" class="oe_stat_button" icon="fa-heartbeat"
                        invisible="not is_patient or total_caregivers == 0">
                    <field name="total_caregivers" string="Caregivers" widget="statinfo"/>
                </button>
                <button name="action_view_my_payers" type="object" class="oe_stat_button" icon="fa-money"
                        invisible="not is_patient or total_payers == 0">
                    <field name="total_payers" string="Payers" widget="statinfo"/>
                </button>
                <button name="action_view_my_referrers" type="object" class="oe_stat_button" icon="fa-handshake-o"
                        invisible="not is_patient or total_referrers == 0">
                    <field name="total_referrers" string="Referrers" widget="statinfo"/>
                </button>
                <button name="action_view_my_emergency_contacts" type="object" class="oe_stat_button" icon="fa-phone"
                        invisible="not is_patient or total_emergency_contacts == 0">
                    <field name="total_emergency_contacts" string="Emergency Contacts" widget="statinfo"/>
                </button>
                <button name="action_view_my_legal_guardians" type="object" class="oe_stat_button" icon="fa-gavel"
                        invisible="not is_patient or total_legal_guardians == 0">
                    <field name="total_legal_guardians" string="Legal Guardians" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
