<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Form View -->
    <record id="view_health_client_relation_form" model="ir.ui.view">
      <field name="name">health.client.relation.form</field>
      <field name="model">health.client.relation</field>
      <field name="arch" type="xml">
        <form string="Healthcare Client Relationship">
          <header>
            <button name="action_set_as_primary" type="object"
                    string="Set as Primary" class="btn-primary"
                    invisible="is_primary or deleted or not active"/>
            <button name="action_open_delete_wizard" type="object"
                    string="Delete" class="btn-secondary" invisible="deleted"/>
            <button name="action_open_restore_wizard" type="object"
                    string="Restore" class="btn-secondary"
                    groups="health_base.group_healthcare_custodian"
                    invisible="not deleted"/>
            <button name="action_open_archive_wizard" type="object"
                    string="Archive" class="btn-secondary"
                    groups="health_base.group_healthcare_custodian"
                    invisible="deleted or not active"/>
            <field name="relationship_status" widget="badge"
                   decoration-success="relationship_status == 'active'"
                   decoration-info="relationship_status == 'scheduled'"
                   decoration-warning="relationship_status == 'ended'"
                   decoration-muted="relationship_status == 'archived'"
                   decoration-danger="relationship_status == 'deleted'"/>
          </header>
          <sheet class="o_health_relationship_form">
            <field name="active" invisible="1"/>
            <field name="deleted" invisible="1"/>
            <widget name="web_ribbon" title="Deleted" bg_color="text-bg-danger"
                    invisible="not deleted"/>
            <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary"
                    invisible="active or deleted"/>

            <div class="hr-relationship-hero">
              <section class="hr-person-card hr-person-card--client">
                <span class="hr-eyebrow">Client / Patient</span>
                <field name="client_id" widget="many2one_avatar" nolabel="1"
                       class="hr-person-field"
                       options="{'no_create': True, 'no_quick_create': True}"/>
                <div class="hr-contact-lines">
                  <field name="client_phone" widget="phone" nolabel="1"
                         readonly="1" invisible="not client_phone"/>
                  <field name="client_email" widget="email" nolabel="1"
                         readonly="1" invisible="not client_email"/>
                  <span class="text-muted" invisible="client_phone or client_email">
                    No contact details recorded
                  </span>
                </div>
              </section>

              <section class="hr-relationship-bridge">
                <div class="hr-bridge-line"><span>↔</span></div>
                <label for="role" string="Acts as"/>
                <field name="role" nolabel="1" class="hr-role-field"/>
                <label for="relationship_type_id" string="Personal relationship"/>
                <field name="relationship_type_id" nolabel="1"
                       placeholder="e.g. Parent, Spouse, Sibling"/>
                <div class="hr-primary-switch">
                  <field name="is_primary" widget="boolean_toggle" nolabel="1"/>
                  <label for="is_primary" string="Primary for this role"/>
                </div>
              </section>

              <section class="hr-person-card hr-person-card--representative">
                <span class="hr-eyebrow">Representative</span>
                <field name="representative_id" widget="many2one_avatar" nolabel="1"
                       class="hr-person-field"
                       options="{'no_create': True, 'no_quick_create': True}"/>
                <div class="hr-contact-lines">
                  <field name="representative_phone" widget="phone" nolabel="1"
                         readonly="1" invisible="not representative_phone"/>
                  <field name="representative_email" widget="email" nolabel="1"
                         readonly="1" invisible="not representative_email"/>
                  <span class="text-muted"
                        invisible="representative_phone or representative_email">
                    No contact details recorded
                  </span>
                </div>
              </section>
            </div>

            <div class="hr-relationship-grid">
              <section class="hr-detail-card">
                <div class="hr-card-heading">
                  <span class="hr-card-kicker">Validity</span>
                  <h3>Relationship timeline</h3>
                  <p>When this connection applies and who should be contacted first.</p>
                </div>
                <group col="2">
                  <field name="start_date"/>
                  <field name="end_date"/>
                  <field name="priority_order"/>
                  <field name="catchment_province_id" readonly="1"/>
                </group>
              </section>

              <section class="hr-detail-card hr-authority-card">
                <div class="hr-card-heading">
                  <span class="hr-card-kicker">Authority</span>
                  <h3>What can this person do?</h3>
                  <p>Grant only the permissions this representative needs.</p>
                </div>
                <div class="hr-permission-list">
                  <div class="hr-permission-row">
                    <div><strong>Medical decisions</strong><small>May consent to care decisions</small></div>
                    <field name="can_make_medical_decisions" widget="boolean_toggle" nolabel="1"/>
                  </div>
                  <div class="hr-permission-row">
                    <div><strong>Medical information</strong><small>May receive clinical updates</small></div>
                    <field name="can_receive_medical_info" widget="boolean_toggle" nolabel="1"/>
                  </div>
                  <div class="hr-permission-row">
                    <div><strong>Appointment scheduling</strong><small>May book or change visits</small></div>
                    <field name="can_schedule_appointments" widget="boolean_toggle" nolabel="1"/>
                  </div>
                  <div class="hr-permission-row hr-permission-row--financial">
                    <div><strong>Financial responsibility</strong><small>Share of charges assigned to this person</small></div>
                    <field name="financial_responsibility" widget="percentage" nolabel="1"/>
                  </div>
                </div>
              </section>
            </div>

            <notebook class="hr-relationship-notebook">
              <page string="Legal Documentation" name="legal_documentation">
                <div class="hr-tab-intro">
                  <h3>Evidence supporting this relationship</h3>
                  <p>Capture legal authority only when documentation is required.</p>
                </div>
                <group col="2">
                  <field name="legal_document_type"/>
                  <field name="legal_document_number"/>
                  <field name="issued_by"/>
                  <field name="issued_date"/>
                </group>
              </page>
              <page string="Notes" name="notes">
                <div class="hr-tab-intro">
                  <h3>Context for the care team</h3>
                  <p>Record practical details that help staff work with this representative.</p>
                </div>
                <field name="notes" nolabel="1"
                       placeholder="Add communication preferences, restrictions, or other useful context…"/>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Tree View -->
    <record id="view_health_client_relation_tree" model="ir.ui.view">
      <field name="name">health.client.relation.tree</field>
      <field name="model">health.client.relation</field>
      <field name="arch" type="xml">
        <list string="Healthcare Client Relationships"
              class="o_health_relationship_list"
              default_order="client_id, is_primary desc, priority_order"
              decoration-muted="relationship_status in ('archived', 'deleted', 'ended')"
              decoration-danger="relationship_status == 'deleted'">
          <field name="client_id" string="Client / Patient" widget="many2one_avatar"/>
          <field name="relationship_type_id" string="Relationship" widget="badge"
                 optional="show"/>
          <field name="representative_id" widget="many2one_avatar"/>
          <field name="role" string="Acts as" widget="badge"
                 decoration-success="role == 'caregiver'"
                 decoration-info="role in ('payer', 'client_representative')"
                 decoration-warning="role == 'referrer'"
                 decoration-danger="role == 'emergency_contact'"
                 decoration-primary="role == 'legal_guardian'"/>
          <field name="is_primary" string="Primary" widget="boolean_toggle"/>
          <field name="authority_summary" string="Delegated Authority" optional="show"/>
          <field name="start_date" string="Since" optional="show"/>
          <field name="end_date" optional="hide"/>
          <field name="financial_responsibility" widget="percentage" optional="hide"/>
          <field name="can_make_medical_decisions" widget="boolean_toggle" optional="hide"/>
          <field name="relationship_status" string="Status" widget="badge"
                 decoration-success="relationship_status == 'active'"
                 decoration-info="relationship_status == 'scheduled'"
                 decoration-warning="relationship_status == 'ended'"
                 decoration-muted="relationship_status == 'archived'"
                 decoration-danger="relationship_status == 'deleted'"/>
          <field name="active" column_invisible="1"/>
                        <!-- Record lifecycle: Delete (user) / Archive (custodian) -->
                <field name="deleted" column_invisible="1"/>
                <button name="action_open_delete_wizard" type="object"
                        icon="fa-trash" title="Delete (reason required)"
                        invisible="deleted"/>
                <button name="action_open_restore_wizard" type="object"
                        icon="fa-undo" title="Restore this deleted record"
                        groups="health_base.group_healthcare_custodian"
                        invisible="not deleted"/>
                <button name="action_open_archive_wizard" type="object"
                        icon="fa-archive" title="Archive (custodian)"
                        groups="health_base.group_healthcare_custodian"
                        invisible="deleted"/>
</list>
      </field>
    </record>

    <!-- Kanban (minimal, to keep action compatibility) -->
    <record id="view_health_client_relation_kanban" model="ir.ui.view">
      <field name="name">health.client.relation.kanban</field>
      <field name="model">health.client.relation</field>
      <field name="arch" type="xml">
        <kanban class="o_kanban_mobile o_health_relationship_kanban" default_group_by="role">
          <field name="client_id"/>
          <field name="representative_id"/>
          <field name="role"/>
          <field name="relationship_type_id"/>
          <field name="is_primary"/>
          <field name="relationship_status"/>
          <field name="authority_summary"/>
          <templates>
            <t t-name="kanban-box">
              <div class="oe_kanban_card oe_kanban_global_click hr-kanban-card">
                <div class="hr-kanban-path">
                  <div><small>Client</small><strong><field name="client_id"/></strong></div>
                  <span>↔</span>
                  <div><small>Representative</small><strong><field name="representative_id"/></strong></div>
                </div>
                <div class="hr-kanban-meta">
                  <field name="role" widget="badge"/>
                  <field name="relationship_type_id" widget="badge"/>
                  <field name="relationship_status" widget="badge"/>
                </div>
                <div class="text-muted mt-2"><field name="authority_summary"/></div>
              </div>
            </t>
            <!-- OWL kanban compatibility -->
            <t t-name="card">
              <t t-call="kanban-box"/>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <!-- Pivot View -->
    <record id="view_health_client_relation_pivot" model="ir.ui.view">
      <field name="name">health.client.relation.pivot</field>
      <field name="model">health.client.relation</field>
      <field name="arch" type="xml">
        <pivot string="Relationship Analysis">
          <field name="client_id" type="row"/>
          <field name="role" type="col"/>
          <field name="financial_responsibility" type="measure"/>
        </pivot>
      </field>
    </record>

    <!-- Calendar View -->
    <record id="view_health_client_relation_calendar" model="ir.ui.view">
      <field name="name">health.client.relation.calendar</field>
      <field name="model">health.client.relation</field>
      <field name="arch" type="xml">
        <calendar string="Relationship Timeline" date_start="start_date" date_stop="end_date" color="role">
          <field name="client_id"/>
          <field name="representative_id"/>
          <field name="role"/>
        </calendar>
      </field>
    </record>

    <!-- Search View -->
    <record id="view_health_client_relation_search" model="ir.ui.view">
      <field name="name">health.client.relation.search</field>
      <field name="model">health.client.relation</field>
      <field name="arch" type="xml">
        <search string="Search Healthcare Relationships">
          <field name="client_id" string="Client/Patient"/>
          <field name="representative_id"/>
          <field name="role"/>
          <field name="relationship_type_id"/>
          <field name="catchment_province_id" string="Catchment Area"/>
          <separator/>
          <filter name="filter_primary" string="Primary Contacts"
                  domain="[('is_primary', '=', True)]"/>
          <filter name="filter_medical_authority" string="Medical Decision Makers"
                  domain="[('can_make_medical_decisions', '=', True)]"/>
          <filter name="filter_current" string="Current"
                  domain="[('active', '=', True), ('deleted', '=', False), '|', ('end_date', '=', False), ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
          <filter name="filter_ended" string="Ended"
                  domain="[('end_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
          <separator string="Group By"/>
          <filter name="group_by_client" string="Client"
                  context="{'group_by': 'client_id'}"/>
          <filter name="group_by_role" string="Role"
                  context="{'group_by': 'role'}"/>
          <filter name="group_by_relationship_type" string="Relationship Type"
                  context="{'group_by': 'relationship_type_id'}"/>
          <filter name="group_by_catchment_province" string="Catchment Area"
                  context="{'group_by': 'catchment_province_id'}"/>
        </search>
      </field>
    </record>

    <!-- Window Action -->
    <record id="action_health_client_relation" model="ir.actions.act_window">
      <field name="name">Healthcare Relationships</field>
      <field name="res_model">health.client.relation</field>
        <field name="domain">['|', ('deleted', '=', False), ('deleted', '=', True)]</field>
      <field name="view_mode">list,form,kanban</field>
      <field name="view_id" ref="view_health_client_relation_tree"/>
      <field name="search_view_id" ref="view_health_client_relation_search"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Create your first healthcare relationship!
        </p>
        <p>
          Track links between patients/clients and their representatives, caregivers, payers, and other roles.
        </p>
      </field>
    </record>
  </data>
</odoo>
