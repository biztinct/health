    <!-- All Clients Action - List view sorted by creation date descending -->
    <record id="action_all_clients_list" model="ir.actions.act_window">
        <field name="name">All Clients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="view_id" ref="health_base.view_health_patient_tree"/>
        <field name="domain">[('is_patient', '=', True)]</field>
        <field name="context">{
            'default_is_patient': True,
            'search_default_customer': 0,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No clients found!
            </p><p>
                Clients are contacts who have received or are scheduled to receive healthcare services.
            </p>
        </field>
    </record>

