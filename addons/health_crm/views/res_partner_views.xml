<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Healthcare Contact Form View Extension -->
    <record id="view_healthcare_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.healthcare</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add healthcare identification fields -->
            <xpath expr="//field[@name='vat']" position="after">
                <field name="cccd_number" invisible="not is_patient and not is_caregiver and not is_payer"/>
                <field name="ethnicity" invisible="not is_patient and not is_caregiver"/>
            </xpath>

            <!-- Add Vietnamese naming fields -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="kinship_title" placeholder="Ông, Bà, Anh, Chị..."/>
                <field name="preferred_name" placeholder="Preferred calling name"/>
            </xpath>

            <!-- Add healthcare role flags with visual tags.
                 NOTE: injected after the PARENT group (…/..), not after the
                 category_id field — a <group> nested inside an inner group
                 turns that inner group into an outer one, which silently
                 dropped the labels of every sibling field (Job Position,
                 VAT, Website, Language, Tags rendered placeholder-only). -->
            <xpath expr="//field[@name='category_id']/.." position="after">
                <group name="healthcare_roles" string="Healthcare Roles">
                    <!-- Hidden boolean fields for computation -->
                    <field name="is_patient" invisible="1"/>
                    <field name="is_representative" invisible="1"/>
                    <field name="is_caregiver" invisible="1"/>
                    <field name="is_payer" invisible="1"/>
                    <field name="is_referrer" invisible="1"/>
                    <field name="is_emergency_contact" invisible="1"/>
                    <field name="is_healthcare_provider" invisible="1"/>

                    <!-- Visual role display -->
                    <field name="healthcare_role_tags" nolabel="1"/>
                </group>
            </xpath>

            <!-- Add Vietnamese communication fields -->
            <xpath expr="//field[@name='phone']" position="after">
                <field name="zalo_number" placeholder="Zalo number"/>
                <field name="facebook_profile" placeholder="Facebook profile"/>
                <field name="preferred_contact_method"/>
            </xpath>

            <!-- Add healthcare communication section -->
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page name="healthcare_info" string="Healthcare Info" 
                      invisible="not is_patient and not is_caregiver and not is_payer and not is_referrer">
                    
                    <!-- Healthcare Preferences -->
                    <group name="healthcare_preferences" string="Healthcare Preferences">
                        <group>
                            <field name="distance_from_clinic"/>
                            <field name="gps_coordinates"/>
                        </group>
                        <group>
                            <field name="service_area_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <!-- Emergency Contact -->
                    <group name="emergency_contact" string="Emergency Contact">
                        <group>
                            <field name="emergency_contact_name"/>
                            <field name="emergency_contact_phone"/>
                        </group>
                        <group>
                            <field name="emergency_contact_relationship"/>
                        </group>
                    </group>

                    <!-- Healthcare Notes -->
                    <group name="healthcare_notes" string="Healthcare Notes">
                        <field name="healthcare_notes" nolabel="1" placeholder="Healthcare-related notes and observations..."/>
                    </group>


                    <!-- Patient relationships now handled in health_base with simple Many2one fields -->
                </page>
                
                <page name="healthcare_relationships" string="Healthcare Relationships" 
                      invisible="not is_patient and not is_representative">
                    
                    <!-- Relationships where this person is a client/patient -->
                    <group name="my_representatives" string="My Representatives" 
                           invisible="not is_patient">
                        <field name="client_relationships" nolabel="1">
                            <list>
                                <field name="representative_id"/>
                                <field name="role"/>
                                <field name="relationship_type"/>
                                <field name="is_primary" widget="boolean_toggle"/>
                                <field name="can_make_medical_decisions" widget="boolean_toggle"/>
                                <field name="financial_responsibility" widget="percentage"/>
                                <field name="active" widget="boolean_toggle"/>
                            </list>
                        </field>
                    </group>
                    
                    <!-- Relationships where this person is a representative -->
                    <group name="clients_i_represent" string="Clients I Represent" 
                           invisible="not is_representative">
                        <field name="representative_relationships" nolabel="1">
                            <list>
                                <field name="client_id"/>
                                <field name="role"/>
                                <field name="relationship_type"/>
                                <field name="is_primary" widget="boolean_toggle"/>
                                <field name="can_make_medical_decisions" widget="boolean_toggle"/>
                                <field name="financial_responsibility" widget="percentage"/>
                                <field name="active" widget="boolean_toggle"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>

            <!-- Add healthcare action buttons -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_create_healthcare_lead" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-user-plus"
                        invisible="is_company">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Create</span>
                        <span class="o_stat_text">Healthcare Lead</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

