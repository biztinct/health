<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Healthcare Convert to Contact Wizard - Customize for healthcare -->
    <record id="view_healthcare_lead2opportunity_partner" model="ir.ui.view">
        <field name="name">crm.lead2opportunity.partner.form.healthcare</field>
        <field name="model">crm.lead2opportunity.partner</field>
        <field name="inherit_id" ref="crm.view_crm_lead2opportunity_partner"/>
        <field name="arch" type="xml">
            <!-- Change form title -->
            <xpath expr="//form" position="attributes">
                <attribute name="string">Convert to Contact</attribute>
            </xpath>
            
            <!-- Change radio button labels for conversion action -->
            <xpath expr="//field[@name='name']" position="replace">
                <field name="name" widget="radio">
                    <option value="convert">Convert to contact</option>
                    <option value="merge">Merge with existing contacts</option>
                </field>
            </xpath>
            
            <!-- Change assign section title -->
            <xpath expr="//group[field[@name='user_id']]" position="attributes">
                <attribute name="string">Assign this contact to</attribute>
            </xpath>
            
            <!-- Change opportunities section title to contacts -->
            <xpath expr="//group[@invisible=&quot;name != 'merge'&quot;]" position="attributes">
                <attribute name="string">Contacts</attribute>
            </xpath>
            
            <!-- Change button text -->
            <xpath expr="//button[@name='action_apply']" position="attributes">
                <attribute name="string">Create Contact</attribute>
            </xpath>
        </field>
    </record>

    <!-- Healthcare Convert to Contact Action - Change name -->
    <record id="action_healthcare_lead2opportunity_partner" model="ir.actions.act_window">
        <field name="name">Convert to Contact</field>
        <field name="res_model">crm.lead2opportunity.partner</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_healthcare_lead2opportunity_partner"/>
    </record>


    <!-- NEW: Dedicated Healthcare Opportunity Form View (No Inheritance) -->
    <record id="view_healthcare_opportunity_form" model="ir.ui.view">
        <field name="name">crm.lead.form.healthcare.opportunity</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <form string="CRM Contact">
                <header>
                    <button name="action_convert_to_booking"
                            string="Convert to Client"
                            type="object"
                            class="btn-primary"
                            invisible="health_contact_outcome == 'service_booked' or contact_outcome == 'booking_lost'"/>
                    <button name="action_schedule_follow_up"
                            string="Schedule Follow-up"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_booking_lost"
                            string="Booking Lost"
                            type="object"
                            class="btn-secondary"
                            invisible="contact_outcome == 'booking_lost'"/>
                    <field name="contact_outcome" invisible="1"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}" domain="[('team_ids', '=', False)]"/>
                </header>
                
                <sheet string="CRM Contact">
                    <!-- Diagonal Ribbon Banner for Booking Lost -->
                    <div invisible="contact_outcome != 'booking_lost'"
                         style="position: absolute; top: 25px; right: -35px; transform: rotate(45deg);
                                background-color: #dc3545; color: white; padding: 5px 40px;
                                font-weight: bold; font-size: 13px; z-index: 999;
                                box-shadow: 0 3px 10px rgba(0,0,0,0.2); text-align: center;">
                        BOOKING LOST
                    </div>

                    <!-- Contact Code Badge -->
                    <div style="position: absolute; top: 10px; right: 150px; z-index: 1000;">
                        <span class="badge rounded-pill" style="background-color: #875A7B; color: white; font-size: 13px; padding: 6px 14px; font-weight: 500;">
                            <field name="unique_contact_code" readonly="1" nolabel="1"/>
                        </span>
                    </div>

                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_merge_similar_leads"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-clone"
                                invisible="duplicate_lead_count == 0">
                            <field name="duplicate_lead_count" widget="statinfo" string="Similar Leads"/>
                        </button>
                    </div>

                    <!-- Title and Basic Info -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" string="Contact Name" placeholder="Contact name..." required="1"/>
                        </h1>
                        <!-- Booking Lost Reason Alert -->
                        <div class="alert alert-warning" role="alert" invisible="contact_outcome != 'booking_lost'" style="margin-top: 10px;">
                            <strong>Booking Lost:</strong>
                            <field name="booking_lost_reason" readonly="1" nolabel="1"/>
                        </div>
                    </div>

                    <!-- Relationship Selection -->
                    <div class="vu-card" style="margin-bottom: var(--vu-space-lg);">
                        <div class="vu-card__title">
                            <span class="vu-section__icon" data-icon="users-group"/>
                            <span>Relationship Context</span>
                        </div>
                        <group col="2">
                            <field name="contact_relationship_type" string="I am the:" widget="radio"
                                   options="{'horizontal': true}" style="font-size: 14px; font-weight: normal;"/>
                            <field name="client_name" string="Client Name" placeholder="Enter client name..."
                                   style="font-size: 14px; font-weight: normal;"
                                   invisible="contact_relationship_type == 'client'"
                                   required="contact_relationship_type != 'client'"/>
                        </group>
                    </div>
                    
                    <!-- Main Content Tabs -->
                    <notebook>
                        <!-- Contact Details Tab -->
                        <page string="Contact Details" name="contact_details">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="users-group"/>
                                    <div>
                                        <span>Contact Details</span>
                                        <small class="text-muted d-block">Communication channels and classification</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="users-group"/>
                                            <span>Contact Information</span>
                                        </div>
                                        <group col="2">
                                            <field name="email_from" string="Email" widget="email"/>
                                            <field name="phone" widget="phone"/>
                                            <field name="contact_datetime" string="Contact Date and Time"/>
                                        </group>
                                    </div>
                                    
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="map-pin"/>
                                            <span>Address Details</span>
                                        </div>
                                        <group col="2">
                                            <field name="province_code" string="Province Code"/>
                                            <field name="house_number" string="House Number"/>
                                            <field name="sub_alley_number" string="Sub-Alley Number"/>
                                            <field name="alley_number" string="Alley Number"/>
                                            <field name="ward_commune" string="Ward/Commune"/>
                                            <field name="named_area" string="Named Area"/>
                                            <field name="apartment_number" string="Apartment Number"/>
                                            <field name="building_name" string="Building Name"/>
                                            <field name="zip" string="Postal Code"/>
                                            <field name="street" string="Street" placeholder="Street name / Main road"/>
                                            <field name="city" string="City" placeholder="District / City"/>
                                            <field name="state_id" string="Province" options="{'no_create': True}" placeholder="Select province"/>
                                            <field name="country_id" string="Country" options="{'no_create': True}"/>
                                            <field name="full_vietnamese_address" string="Full Vietnamese Address" colspan="2"/>
                                            <field name="facility_id" string="Healthcare Facility" options="{'no_create': True}" colspan="2"/>
                                        </group>
                                    </div>
                                    
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="tag"/>
                                            <span>Contact Classification</span>
                                        </div>
                                        <group col="2">
                                            <field name="contact_type" string="Contact Type"/>
                                            <field name="contact_reason_id" string="Contact Reason" options="{'no_create': True}"/>
                                            <field name="reason_if_rejected" string="Reason if Rejected" invisible="stage_id != 'lost'"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>
                        
                        <!-- Source and Campaign Tab -->
                        <page string="Source and Campaign" name="source_campaign">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="timeline"/>
                                    <div>
                                        <span>Source Tracking</span>
                                        <small class="text-muted d-block">Marketing attribution and campaign context</small>
                                    </div>
                                </div>
                                <div class="vu-card">
                                    <group col="2">
                                        <field name="source_id" string="Source" options="{'no_create': True}"/>
                                        <field name="medium_id" string="Medium" options="{'no_create': True}"/>
                                        <field name="campaign_id" string="Campaign" options="{'no_create': True}"/>
                                    </group>
                                </div>
                            </div>
                        </page>
                        
                        <!-- Service and Booking Tab -->
                        <page string="Service and Booking" name="service_booking">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="heart-pulse"/>
                                    <div>
                                        <span>Service and Booking</span>
                                        <small class="text-muted d-block">Interest captured and follow-up plan</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="file-text"/>
                                            <span>Service Information</span>
                                        </div>
                                        <group col="2">
                                            <field name="service_interest" string="Service Interest"/>
                                            <field name="booking_status" string="Booking Status"/>
                                            <field name="lead_reason_id" string="Lead Reason" options="{'no_create': True}"/>
                                        </group>
                                    </div>
                                    
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="timeline"/>
                                            <span>Follow-up Management</span>
                                        </div>
                                        <group col="2">
                                            <field name="follow_up_count" string="Follow-up Count" readonly="1"/>
                                            <field name="next_follow_up_date" string="Next Follow-up Date"/>
                                            <field name="lead_followup_required" string="Follow-up Required"/>
                                            <field name="follow_up_notes" string="Follow-up Notes" colspan="2"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>
                        
                        <!-- Relationships Tab -->
                        <page string="Healthcare Relationships" name="relationships">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="users-group"/>
                                    <div>
                                        <span>Healthcare Relationships</span>
                                        <small class="text-muted d-block">Client and care team linkages</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="id-card"/>
                                            <span>Client Information</span>
                                        </div>
                                        <group>
                                            <field name="patient_id" string="Client" options="{'no_create': True}" colspan="2"/>
                                        </group>
                                    </div>
                                    
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="users-group"/>
                                            <span>Care Team</span>
                                        </div>
                                        <group col="2">
                                            <field name="primary_caregiver_id" string="Primary Caregiver" options="{'no_create': True}"/>
                                            <field name="secondary_caregiver_id" string="Secondary Caregiver" options="{'no_create': True}"/>
                                            <field name="primary_payer_id" string="Payer" options="{'no_create': True}"/>
                                            <field name="client_representative_id" string="Client Representative" options="{'no_create': True}"/>
                                        </group>
                                    </div>
                                    
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="life-ring"/>
                                            <span>Referral and Emergency</span>
                                        </div>
                                        <group col="2">
                                            <field name="referrer_id" string="Referrer" options="{'no_create': True}"/>
                                            <field name="emergency_contact_id" string="Emergency Contact" options="{'no_create': True}"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>
                        
                        <!-- Analytics Tab -->
                        <page string="Analytics and Tracking" name="analytics" invisible="1">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="timeline"/>
                                    <div>
                                        <span>Analytics and Tracking</span>
                                        <small class="text-muted d-block">Lifecycle timing metrics</small>
                                    </div>
                                </div>
                                <div class="vu-card">
                                    <group col="2">
                                        <field name="day_open" string="Days Open" readonly="1"/>
                                        <field name="day_close" string="Days to Close" readonly="1"/>
                                        <field name="create_date" string="Created On" readonly="1"/>
                                        <field name="date_closed" string="Closed On" readonly="1"/>
                                    </group>
                                </div>
                            </div>
                        </page>
                        
                        <!-- Notes Tab -->
                        <page string="Internal Notes" name="notes">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="file-text"/>
                                    <span>Internal Notes</span>
                                </div>
                                <group>
                                    <field name="description" string="Internal Notes" nolabel="1"
                                           placeholder="Internal notes about this healthcare contact..."/>
                                </group>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- Healthcare Opportunities Action - Uses dedicated form for type=opportunity -->
    <record id="action_healthcare_opportunities" model="ir.actions.act_window">
        <field name="name">CRM Contacts</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
        <field name="domain">[('type', '=', 'opportunity')]</field>
        <field name="context">{
            'default_type': 'opportunity',
            'form_view_ref': 'health_crm.view_healthcare_opportunity_form',
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'list'}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_healthcare_opportunity_form')}),
            (0, 0, {'view_mode': 'calendar'}),
            (0, 0, {'view_mode': 'pivot'}),
            (0, 0, {'view_mode': 'graph'}),
            (0, 0, {'view_mode': 'activity'}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first healthcare contact!
            </p><p>
                A healthcare contact is a potential patient, caregiver, or payer who has shown interest in your services.
                Use this section to manage your healthcare relationships and track your interactions.
            </p>
        </field>
    </record>

    <!-- Healthcare Lead Form - Change Convert button label for leads -->
    <record id="view_healthcare_lead_form_button" model="ir.ui.view">
        <field name="name">crm.lead.form.healthcare.button</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Change "Convert to Opportunity" button text to "Convert to Contact" and use our custom action -->
            <xpath expr="//button[@name='%(crm.action_crm_lead2opportunity_partner)d']" position="attributes">
                <attribute name="string">Convert to Contact</attribute>
                <attribute name="name">%(action_healthcare_lead2opportunity_partner)d</attribute>
            </xpath>
        </field>
    </record>

    <!-- Healthcare Lead List View Extension - Change name field label -->
    <record id="view_healthcare_lead_tree" model="ir.ui.view">
        <field name="name">crm.lead.tree.healthcare</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <!-- Change field label 'name' to 'Contact name' in list view -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Contact name</attribute>
            </xpath>
        </field>
    </record>

    <!-- Healthcare Lead Kanban View Extension - Change name field label and remove partner_id -->
    <record id="view_healthcare_lead_kanban" model="ir.ui.view">
        <field name="name">crm.lead.kanban.healthcare</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <!-- Set quick_create_view to use our custom form -->
            <xpath expr="//kanban" position="attributes">
                <attribute name="quick_create_view">health_crm.view_healthcare_crm_lead_quick_create</attribute>
            </xpath>

            <!-- Change field label 'name' to 'Contact name' in kanban view -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Contact name</attribute>
            </xpath>

            <!-- Remove partner_id field from kanban view -->
            <xpath expr="//field[@name='partner_id' and @class='text-truncate']" position="replace"/>
        </field>
    </record>

    <!-- Healthcare Opportunities List View Extension - Change name field label -->
    <record id="view_healthcare_opportunity_tree" model="ir.ui.view">
        <field name="name">crm.lead.tree.opportunities.healthcare</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <!-- Change field label 'name' to 'Contact name' in opportunity list view -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Contact name</attribute>
            </xpath>
        </field>
    </record>

    <!-- Healthcare Quick Create Form - Customized for CRM Contacts -->
    <record id="view_healthcare_crm_lead_quick_create" model="ir.ui.view">
        <field name="name">crm.lead.form.quick.healthcare</field>
        <field name="model">crm.lead</field>
        <field name="mode">primary</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Quick Create Contact">
                <group>
                    <field name="type" invisible="1"/>
                    <field name="name" string="Contact Name" placeholder="e.g. John Doe"/>
                    <field name="facility_id" string="Primary Facility" options="{'no_create': True}"/>
                    <field name="email_from" string="Email" placeholder="e.g. &quot;email@address.com&quot;"/>
                    <field name="phone" placeholder="e.g. &quot;0123456789&quot;"/>
                </group>
            </form>
        </field>
    </record>


</odoo>
