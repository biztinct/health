<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="health_crm.CrmDashboard">
    <div class="cd-dashboard crm-dashboard" t-ref="dashboardRoot">

        <!-- HEADER -->
        <header class="cd-header">
            <div class="cd-header-left">
                <h1 class="cd-title">CRM Center</h1>
                <span class="cd-subtitle">Sales &amp; Contact Management</span>
            </div>
            <div class="cd-header-right">
                <div class="cd-period-toggle">
                    <button t-attf-class="cd-period-btn #{state.period === 'today' ? 'active' : ''}"
                            t-on-click="() => this.onPeriodChange('today')">Today</button>
                    <button t-attf-class="cd-period-btn #{state.period === 'week' ? 'active' : ''}"
                            t-on-click="() => this.onPeriodChange('week')">This Week</button>
                    <button t-attf-class="cd-period-btn #{state.period === 'month' ? 'active' : ''}"
                            t-on-click="() => this.onPeriodChange('month')">This Month</button>
                    <button t-attf-class="cd-period-btn #{state.period === 'all' ? 'active' : ''}"
                            t-on-click="() => this.onPeriodChange('all')">All Dates</button>
                    <button t-attf-class="cd-period-btn #{state.period === 'custom' ? 'active' : ''}"
                            t-on-click="() => this.onPeriodChange('custom')">Custom</button>
                </div>
                <div t-if="state.period === 'custom'" class="cd-custom-dates">
                    <input type="date" class="cd-date-input" t-att-value="state.customFrom"
                           t-on-change="(ev) => this.onCustomDateChange('from', ev.target.value)" title="From"/>
                    <span class="cd-date-dash">–</span>
                    <input type="date" class="cd-date-input" t-att-value="state.customTo"
                           t-on-change="(ev) => this.onCustomDateChange('to', ev.target.value)" title="To"/>
                </div>
                <button class="cd-refresh-btn" t-on-click="onRefresh">
                    <i class="fa fa-refresh"/>
                </button>
            </div>
        </header>

        <!-- LOADING -->
        <div t-if="state.isLoading" class="cd-loading">
            <div class="spinner-border text-primary" role="status"/>
            <span>Loading dashboard...</span>
        </div>

        <!-- DASHBOARD BODY -->
        <div t-if="!state.isLoading" class="cd-body">

            <!-- ZONE 1: KPI STRIP -->
            <div class="cd-kpi-strip">
                <t t-foreach="kpiCards" t-as="kpi" t-key="kpi.key">
                    <div class="cd-kpi-card" t-att-data-kpi-key="kpi.key"
                         t-on-click="() => this.onKpiClick(kpi.key)">
                        <div class="cd-kpi-icon">
                            <i t-attf-class="fa #{kpi.icon}"/>
                        </div>
                        <div class="cd-kpi-body">
                            <div class="cd-kpi-value">
                                <t t-esc="formatKpiValue(kpi.key, kpi.format)"/>
                            </div>
                            <div class="cd-kpi-label"><t t-esc="kpi.label"/></div>
                        </div>
                        <div class="cd-kpi-right">
                            <div t-attf-class="cd-kpi-trend #{getTrendClass(kpi.key)}">
                                <i t-attf-class="fa #{getTrendIcon(kpi.key)}"/>
                                <span t-esc="getTrendValue(kpi.key)"/>
                            </div>
                            <canvas t-att-data-spark-key="kpi.key" class="cd-kpi-sparkline"/>
                        </div>
                    </div>
                </t>
            </div>

            <!-- SUMMARY STRIP -->
            <div class="cd-summary-strip">
                <div class="cd-summary-stat">
                    <div class="cd-summary-icon" style="background: #1A237E;">
                        <i class="fa fa-users"/>
                    </div>
                    <div class="cd-summary-body">
                        <div class="cd-summary-value" t-esc="state.monthlySummary.new_contacts || 0"/>
                        <div class="cd-summary-label">New This Month</div>
                    </div>
                </div>
                <div class="cd-summary-stat">
                    <div class="cd-summary-icon" style="background: #2E7D32;">
                        <i class="fa fa-check-circle"/>
                    </div>
                    <div class="cd-summary-body">
                        <div class="cd-summary-value" t-esc="state.monthlySummary.converted || 0"/>
                        <div class="cd-summary-label">Converted</div>
                    </div>
                </div>
                <div class="cd-summary-stat">
                    <div class="cd-summary-icon" style="background: #C62828;">
                        <i class="fa fa-times-circle"/>
                    </div>
                    <div class="cd-summary-body">
                        <div class="cd-summary-value" t-esc="state.monthlySummary.lost || 0"/>
                        <div class="cd-summary-label">Lost</div>
                    </div>
                </div>
                <div class="cd-summary-stat">
                    <div class="cd-summary-icon" style="background: #FF6F00;">
                        <i class="fa fa-bullseye"/>
                    </div>
                    <div class="cd-summary-body">
                        <div class="cd-summary-value" t-esc="state.monthlySummary.active_pipeline || 0"/>
                        <div class="cd-summary-label">Active Pipeline</div>
                    </div>
                </div>
            </div>

            <!-- ZONE 2: CHARTS -->
            <div class="cd-zone2">
                <div class="cd-chart-panel">
                    <div class="cd-chart-header">
                        <span>Contact Pipeline</span>
                    </div>
                    <div class="cd-chart-body">
                        <canvas t-ref="donutCanvas" class="cd-chart-canvas"/>
                        <div t-if="!hasPipelineData" class="cd-chart-empty">
                            <i class="fa fa-pie-chart"/>
                            <span>No contact data for this period</span>
                        </div>
                    </div>
                </div>
                <div class="cd-chart-panel">
                    <div class="cd-chart-header">
                        <span>Source Channels</span>
                    </div>
                    <div class="cd-chart-body">
                        <canvas t-ref="barCanvas" class="cd-chart-canvas"/>
                        <div t-if="!hasChannelData" class="cd-chart-empty">
                            <i class="fa fa-bar-chart"/>
                            <span>No channel data yet</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ZONE 3: FEEDS + STATUS (3-Column) -->
            <div class="cd-zone3">

                <!-- Column 1: Recent Contacts -->
                <div class="cd-feed-panel">
                    <div class="cd-panel-header">
                        <div style="display:flex;align-items:center;">
                            <div class="cd-panel-icon"><i class="fa fa-clock-o"/></div>
                            <span>Recent Contacts</span>
                        </div>
                        <button class="cd-panel-header-link" t-on-click="openContacts">
                            View All <i class="fa fa-arrow-right"/>
                        </button>
                    </div>
                    <div class="cd-feed">
                        <t t-if="state.recentContacts.length === 0">
                            <div class="cd-feed-empty">
                                <i class="fa fa-inbox"/>
                                No recent contacts
                            </div>
                        </t>
                        <t t-foreach="state.recentContacts" t-as="item" t-key="item.id">
                            <div class="cd-feed-item" t-on-click="() => this.onFeedItemClick(item.id)">
                                <div class="cd-feed-accent"/>
                                <div class="cd-feed-dot pulse"
                                     t-att-style="'background:' + getStatusColor(item.contact_status)"/>
                                <div class="cd-feed-content">
                                    <div class="cd-feed-title">
                                        <t t-if="item.code"><span style="font-family:monospace;font-size:11px;margin-right:6px;opacity:0.6"><t t-esc="item.code"/></span></t>
                                        <t t-esc="item.name"/>
                                    </div>
                                    <div class="cd-feed-subtitle">
                                        <t t-esc="getStatusLabel(item.contact_status)"/>
                                        <t t-if="item.channel"> · <t t-esc="item.channel"/></t>
                                        <t t-if="item.province"> · <t t-esc="item.province"/></t>
                                    </div>
                                </div>
                                <div class="cd-feed-time" t-esc="item.time_ago"/>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Column 2: Upcoming Bookings -->
                <div class="cd-feed-panel">
                    <div class="cd-panel-header">
                        <div style="display:flex;align-items:center;">
                            <div class="cd-panel-icon"><i class="fa fa-calendar-check-o"/></div>
                            <span>Upcoming Bookings</span>
                        </div>
                        <button class="cd-panel-header-link" t-on-click="openBookings">
                            View All <i class="fa fa-arrow-right"/>
                        </button>
                    </div>
                    <div class="cd-feed">
                        <t t-if="state.upcomingBookings.length === 0">
                            <div class="cd-feed-empty">
                                <i class="fa fa-calendar-o"/>
                                No upcoming bookings
                            </div>
                        </t>
                        <t t-foreach="state.upcomingBookings" t-as="item" t-key="item.id">
                            <div class="cd-feed-item" t-on-click="() => this.onBookingClick(item)">
                                <div class="cd-feed-accent"/>
                                <div class="cd-feed-dot" style="background: #2E7D32;"/>
                                <div class="cd-feed-content">
                                    <div class="cd-feed-title">
                                        <t t-if="item.code"><span style="font-family:monospace;font-size:11px;margin-right:6px;opacity:0.6"><t t-esc="item.code"/></span></t>
                                        <t t-esc="item.name"/>
                                    </div>
                                    <div class="cd-feed-subtitle">
                                        <t t-if="item.scheduled">
                                            <i class="fa fa-calendar" style="margin-right:4px;opacity:0.7"/><t t-esc="item.scheduled"/>
                                        </t>
                                        <t t-if="item.province"> · <t t-esc="item.province"/></t>
                                    </div>
                                </div>
                                <div class="cd-feed-time" t-esc="item.time_ago"/>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Column 3: Contact Status Breakdown -->
                <div class="cd-stats-card">
                    <div class="cd-stats-title">Contact Status</div>
                    <t t-foreach="state.statusBreakdown" t-as="item" t-key="item.status">
                        <t t-if="item.count > 0">
                            <div class="cd-stats-row">
                                <div class="cd-stats-dot"
                                     t-att-style="'background:' + getStatusColor(item.status)"/>
                                <span class="cd-stats-label" t-esc="item.label || item.status"/>
                                <div class="cd-stats-bar">
                                    <div class="cd-stats-bar-fill"
                                         t-att-style="'width:' + (item.percent || 0) + '%;background:' + getStatusColor(item.status)"/>
                                </div>
                                <span class="cd-stats-count" t-esc="item.count"/>
                            </div>
                        </t>
                    </t>
                </div>

            </div>

        </div>

    </div>
</t>

</templates>
