<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="health_crm.CrmDashboard">
    <div class="crm-dashboard">
        <div class="crm-main-content">

            <!-- HEADER -->
            <header class="crm-top-header">
                <div class="crm-header-left">
                    <h1 class="crm-page-title">CRM Center</h1>
                    <span class="crm-page-subtitle">Sales &amp; Contact Management</span>
                </div>
                <div class="crm-header-right">
                    <button class="crm-header-btn btn-primary" t-on-click="openNewContact">
                        <i class="fa fa-plus"/> New Contact
                    </button>
                    <button class="crm-header-btn btn-outline" t-on-click="onRefresh">
                        <i class="fa fa-refresh"/>
                    </button>
                </div>
            </header>

            <!-- LOADING -->
            <div t-if="state.isLoading" class="crm-loading">
                <div class="spinner-border text-primary" role="status"/>
                <span>Loading dashboard...</span>
            </div>

            <!-- DASHBOARD BODY -->
            <div t-if="!state.isLoading" class="crm-dashboard-body">

                <!-- KPI ROW -->
                <div class="crm-kpi-row">
                    <div class="crm-kpi-card kpi-contacts">
                        <div class="crm-kpi-icon"><i class="fa fa-phone"/></div>
                        <div class="crm-kpi-value" t-esc="state.kpis.contacts_today || 0"/>
                        <div class="crm-kpi-label">Contacts Today</div>
                    </div>
                    <div class="crm-kpi-card kpi-followups">
                        <div class="crm-kpi-icon"><i class="fa fa-clock-o"/></div>
                        <div class="crm-kpi-value" t-esc="state.kpis.pending_followups || 0"/>
                        <div class="crm-kpi-label">Pending Follow-ups</div>
                    </div>
                    <div class="crm-kpi-card kpi-leads">
                        <div class="crm-kpi-icon"><i class="fa fa-bullseye"/></div>
                        <div class="crm-kpi-value" t-esc="state.kpis.active_leads || 0"/>
                        <div class="crm-kpi-label">Active Leads</div>
                    </div>
                    <div class="crm-kpi-card kpi-bookings">
                        <div class="crm-kpi-icon"><i class="fa fa-calendar-check-o"/></div>
                        <div class="crm-kpi-value" t-esc="state.kpis.bookings_this_week || 0"/>
                        <div class="crm-kpi-label">Bookings This Week</div>
                    </div>
                    <div class="crm-kpi-card kpi-conversion">
                        <div class="crm-kpi-icon"><i class="fa fa-line-chart"/></div>
                        <div class="crm-kpi-value" t-esc="formatPercent(state.kpis.conversion_rate)"/>
                        <div class="crm-kpi-label">Conversion Rate</div>
                        <div class="crm-kpi-sublabel">This month</div>
                    </div>
                    <div class="crm-kpi-card kpi-spam">
                        <div class="crm-kpi-icon"><i class="fa fa-ban"/></div>
                        <div class="crm-kpi-value" t-esc="formatPercent(state.kpis.spam_rate)"/>
                        <div class="crm-kpi-label">Spam Rate</div>
                        <div class="crm-kpi-sublabel">This month</div>
                    </div>
                </div>

                <!-- MAIN GRID -->
                <div class="crm-main-grid">

                    <!-- RECENT CONTACTS PANEL -->
                    <div class="crm-panel">
                        <div class="crm-panel-header">
                            <div class="crm-panel-title"><i class="fa fa-clock-o"/> Recent Contacts</div>
                        </div>
                        <div class="crm-panel-body">
                            <t t-if="state.recentContacts.length === 0">
                                <div class="crm-empty-state">
                                    <i class="fa fa-inbox"/>
                                    <h4>No contacts yet</h4>
                                    <p>Create your first contact to get started.</p>
                                </div>
                            </t>
                            <t t-foreach="state.recentContacts" t-as="contact" t-key="contact.id">
                                <div class="crm-contact-card" t-on-click="() => this.openContact(contact.id)">
                                    <div class="crm-contact-card-top">
                                        <div>
                                            <span class="crm-contact-code" t-esc="contact.code"/>
                                            <span class="crm-contact-name" t-esc="contact.name"/>
                                        </div>
                                        <span t-attf-class="crm-status-badge #{getStatusClass(contact.contact_status)}">
                                            <t t-esc="getStatusLabel(contact.contact_status)"/>
                                        </span>
                                    </div>
                                    <div class="crm-contact-card-details">
                                        <t t-if="contact.phone">
                                            <span class="crm-contact-detail"><i class="fa fa-phone"/> <t t-esc="contact.phone"/></span>
                                        </t>
                                        <t t-if="contact.province">
                                            <span class="crm-contact-detail"><i class="fa fa-map-marker"/> <t t-esc="contact.province"/></span>
                                        </t>
                                        <t t-if="contact.channel">
                                            <span class="crm-contact-detail"><i class="fa fa-hashtag"/> <t t-esc="contact.channel"/></span>
                                        </t>
                                        <span class="crm-contact-detail"><i class="fa fa-clock-o"/> <t t-esc="contact.time_ago"/></span>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <div class="crm-panel-footer">
                            <button class="crm-footer-link" t-on-click="openContacts">View All Contacts <i class="fa fa-arrow-right"/></button>
                        </div>
                    </div>

                    <!-- QUICK ACTIONS + STATUS BREAKDOWN -->
                    <div class="crm-side-panels">
                        <!-- Quick Actions -->
                        <div class="crm-panel crm-quick-actions">
                            <div class="crm-panel-header">
                                <div class="crm-panel-title"><i class="fa fa-bolt"/> Quick Actions</div>
                            </div>
                            <div class="crm-panel-body">
                                <button class="crm-action-tile" t-on-click="openNewContact">
                                    <i class="fa fa-plus-circle"/>
                                    <span>New Contact</span>
                                </button>
                                <button class="crm-action-tile" t-on-click="openContacts">
                                    <i class="fa fa-list"/>
                                    <span>All Contacts</span>
                                </button>
                                <button class="crm-action-tile" t-on-click="openCalendar">
                                    <i class="fa fa-calendar"/>
                                    <span>Calendar</span>
                                </button>
                                <button class="crm-action-tile" t-on-click="openActivities">
                                    <i class="fa fa-tasks"/>
                                    <span>Activities</span>
                                </button>
                            </div>
                        </div>

                        <!-- Status Breakdown -->
                        <div class="crm-panel crm-status-breakdown">
                            <div class="crm-panel-header">
                                <div class="crm-panel-title"><i class="fa fa-pie-chart"/> Contact Status</div>
                                <span class="crm-panel-subtitle">This month</span>
                            </div>
                            <div class="crm-panel-body">
                                <t t-foreach="state.statusBreakdown" t-as="item" t-key="item.status">
                                    <div class="crm-status-row">
                                        <div class="crm-status-bar-label">
                                            <span class="crm-status-dot" t-att-style="'background:' + getStatusColor(item.status)"/>
                                            <span t-esc="getStatusLabel(item.status)"/>
                                        </div>
                                        <div class="crm-status-bar-track">
                                            <div class="crm-status-bar-fill"
                                                 t-att-style="'width:' + (item.percent || 0) + '%; background:' + getStatusColor(item.status)"/>
                                        </div>
                                        <span class="crm-status-bar-count" t-esc="item.count"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                </div><!-- /crm-main-grid -->

            </div><!-- /crm-dashboard-body -->

        </div><!-- /crm-main-content -->
    </div>
</t>

</templates>
