<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="health_crm.RelationshipGraphWidget">
        <div class="o_relationship_graph_widget">
            <t t-if="state.error">
                <div class="alert alert-danger m-3">
                    <strong>Error:</strong>
                    <t t-esc="state.error"/>
                    <br/>
                    <small>Check browser console for details</small>
                </div>
            </t>
            <t t-elif="state.loading">
                <div class="text-center p-5">
                    <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                    <p class="mt-3">Loading relationship network...</p>
                </div>
            </t>
            <t t-else="">
                <div class="relationship-graph-container">
                <div class="graph-header p-2 bg-light border-bottom">
                    <h5 class="mb-0">
                        <i class="fa fa-project-diagram"/> Relationship Network Graph
                    </h5>
                    <small class="text-muted">
                        Interactive force-directed graph • Drag nodes to reposition • Hover for details
                    </small>
                </div>
                <svg t-ref="relationshipGraph"
                     class="relationship-graph-svg"
                     width="100%"
                     height="600">
                </svg>
                <div class="graph-footer p-2 bg-light border-top">
                    <small class="text-muted">
                        <strong>👤 Blue circles:</strong> Patients  •
                        <strong>👥 Light blue circles:</strong> Representatives  •
                        <strong>Thick lines:</strong> Primary relationships  •
                        <strong>Arrows:</strong> Relationship direction (Patient → Representative)
                    </small>
                </div>
                </div>
            </t>
        </div>
    </t>

</templates>
