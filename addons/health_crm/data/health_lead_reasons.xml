<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Healthcare Lead Reasons Demo Data -->
    
    <!-- Service Interest Reasons -->
    <record id="lead_reason_preventive_care" model="health.lead.reason">
        <field name="name">Preventive Healthcare</field>
        <field name="code">PREV</field>
        <field name="category">service_interest</field>
        <field name="lead_type">both</field>
        <field name="sequence">10</field>
        <field name="description">Interest in preventive healthcare services</field>
        <field name="name_vietnamese">Chăm sóc sức khỏe dự phòng</field>
    </record>

    <record id="lead_reason_chronic_care" model="health.lead.reason">
