<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Relationship Wizard Form View -->
    <record id="view_relationship_add_wizard_form" model="ir.ui.view">
        <field name="name">relationship.add.wizard.form</field>
        <field name="model">health.relationship.add.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Relationship">
                <sheet>
                    <group>
                        <group>
                            <field name="client_name" readonly="1"/>
                            <field name="role_label" readonly="1"/>
                            <field name="client_id" invisible="1"/>
                            <field name="role" invisible="1"/>
                        </group>
                    </group>

                    <group string="Select Representative">
                        <field name="representative_id" string="Name" options="{'no_create_edit': False}" placeholder="Search or create new partner..."/>
                        <field name="relationship_type"/>
                        <field name="is_primary"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Add Relationship" type="object" name="action_create_relationship" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
