<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Patient List View for Selection -->
    <record id="view_patient_selection_list" model="ir.ui.view">
        <field name="name">res.partner.selection.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="street"/>
                <field name="city"/>
            </list>
        </field>
    </record>

    <!-- Client Selection Wizard Form -->
    <record id="view_client_selection_wizard_form" model="ir.ui.view">
        <field name="name">health.client.selection.wizard.form</field>
        <field name="model">health.client.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Client">
                <group>
                    <field name="lead_id" invisible="1"/>
                    <div class="alert alert-info" role="alert">
                        <strong>Multiple clients found!</strong><br/>
                        We found multiple patients with the name "<field name="client_name" nolabel="1" readonly="1"/>".<br/>
                        Please select the correct client from the list below, or create a new client.
                    </div>
                </group>
                
                <group string="Select Existing Client">
                    <field name="selected_patient_id" widget="radio" nolabel="1"/>
                </group>
                
                <group string="Available Clients" col="1">
                    <field name="patient_ids" nolabel="1" readonly="1" 
                           context="{'list_view_ref': 'health_crm.view_patient_selection_list'}"
                           options="{'no_create': True, 'no_open': True}"/>
                </group>
                
                <footer>
                    <button name="action_select_client" 
                            type="object" 
                            string="Select This Client" 
                            class="btn-primary"/>
                    <button name="action_create_new_client" 
                            type="object" 
                            string="Create New Client" 
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Client Selection Wizard Action -->
    <record id="action_client_selection_wizard" model="ir.actions.act_window">
        <field name="name">Select Client</field>
        <field name="res_model">health.client.selection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

</odoo>