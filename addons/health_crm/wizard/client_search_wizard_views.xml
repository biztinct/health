<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client Search Wizard Form View -->
    <record id="view_client_search_wizard_form" model="ir.ui.view">
        <field name="name">health.client.search.wizard.form</field>
        <field name="model">health.client.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Client">
                <sheet>
                    <div class="oe_title" style="margin-bottom: 20px;">
                        <h1>
                            <span class="fa fa-search" style="color: #4299e1; margin-right: 10px;"/>
                            Search Results
                        </h1>
                        <p class="text-muted">
                            Searching for: <strong><field name="search_term" nolabel="1" readonly="1"/></strong>
                        </p>
                    </div>
                    
                    <field name="source_lead_id" invisible="1"/>
                    
                    <!-- Clients Section -->
                    <div style="margin-bottom: 20px;" invisible="not line_ids">
                        <h3 style="color: #38a169; border-bottom: 2px solid #38a169; padding-bottom: 5px;">
                            <span class="fa fa-user" style="margin-right: 8px;"/>
                            Clients
                            <small class="text-muted"> - Existing clients matching your search</small>
                        </h3>
                        <field name="line_ids" nolabel="1">
                            <list create="false" delete="false">
                                <field name="name" string="Name" readonly="1"/>
                                <field name="phone" string="Phone"/>
                                <field name="email" string="Email" widget="email"/>
                                <field name="code" string="Client ID" readonly="1"/>
                                <button name="action_select" type="object" 
                                        string="→ Select" class="btn btn-sm btn-success"/>
                            </list>
                        </field>
                    </div>
                    
                    <!-- No Results Message -->
                    <div class="alert alert-info" role="alert" invisible="line_ids" style="margin-top: 20px;">
                        <span class="fa fa-info-circle" style="margin-right: 8px;"/>
                        <strong>No clients found matching your search.</strong>
                        <br/>
                        <small class="text-muted">You can continue with the name you entered.</small>
                    </div>

                </sheet>
                <footer>
                    <button name="action_cancel" type="object" 
                            string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Client Search Line Form View - shown when clicking a record -->
    <record id="view_client_search_line_form" model="ir.ui.view">
        <field name="name">health.client.search.line.form</field>
        <field name="model">health.client.search.line</field>
        <field name="arch" type="xml">
            <form string="Client Details">
                <sheet>
                    <field name="wizard_id" invisible="1"/>
                    <field name="partner_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="name" string="Name" readonly="1"/>
                            <field name="phone" string="Phone" widget="phone"/>
                            <field name="email" string="Email" widget="email"/>
                        </group>
                        <group>
                            <field name="code" string="Client Code" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" special="save"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
