<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Multi-Step Booking Wizard Form View -->
    <record id="view_booking_wizard_form" model="ir.ui.view">
        <field name="name">health.booking.wizard.form</field>
        <field name="model">health.booking.wizard</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Create Booking">
                <sheet>
                    <!-- Step Progress Indicator -->
                    <div style="margin-bottom: 20px; padding: 15px; background: linear-gradient(135deg, #0D47A1 0%, #1565C0 100%); border-radius: 8px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; color: white;">
                            <!-- Step 1 Indicator -->
                            <div style="text-align: center; flex: 1;">
                                <span style="background: white; color: #1565C0; padding: 8px 16px; border-radius: 20px; font-weight: bold;" invisible="current_step != '1_client'">
                                    1. Client Details
                                </span>
                                <span style="background: rgba(255,255,255,0.3); color: white; padding: 8px 16px; border-radius: 20px;" invisible="current_step == '1_client'">
                                    1. Client
                                </span>
                            </div>
                            <div style="width: 50px; height: 2px; background: rgba(255,255,255,0.3);"/>
                            <!-- Step 2 Indicator -->
                            <div style="text-align: center; flex: 1;">
                                <span style="background: white; color: #1565C0; padding: 8px 16px; border-radius: 20px; font-weight: bold;" invisible="current_step != '2_services'">
                                    2. Services
                                </span>
                                <span style="background: rgba(255,255,255,0.3); color: white; padding: 8px 16px; border-radius: 20px;" invisible="current_step == '2_services'">
                                    2. Services
                                </span>
                            </div>
                            <div style="width: 50px; height: 2px; background: rgba(255,255,255,0.3);"/>
                            <!-- Step 3 Indicator -->
                            <div style="text-align: center; flex: 1;">
                                <span style="background: white; color: #1565C0; padding: 8px 16px; border-radius: 20px; font-weight: bold;" invisible="current_step != '3_booking'">
                                    3. Booking
                                </span>
                                <span style="background: rgba(255,255,255,0.3); color: white; padding: 8px 16px; border-radius: 20px;" invisible="current_step == '3_booking'">
                                    3. Booking
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Hidden fields -->
                    <field name="current_step" invisible="1"/>
                    <field name="lead_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="address_edit_mode" invisible="1"/>

                    <!-- STEP 1: Client Details -->
                    <div invisible="current_step != '1_client'">
                        <h2 style="margin-bottom: 20px;">
                            <span class="fa fa-user" style="margin-right: 10px; color: #1565C0;"/>
                            Client Details
                        </h2>
                        
                        <group>
                            <field name="is_new_client" string="This is a New Client" readonly="1"/>
                        </group>
                        
                        <!-- Hidden client_id for existing client reference -->
                        <field name="client_id" invisible="1"/>
                        
                        <!-- Client Fields - shown in both modes -->
                        <group>
                            <group string="Client Information">
                                <field name="client_name" string="Full Name" 
                                       required="1"
                                       readonly="not is_new_client"/>
                                <field name="client_phone" string="Phone" widget="phone"/>
                                <field name="client_email" string="Email" widget="email"/>
                            </group>
                            <group>
                                <field name="client_dob" string="Date of Birth"/>
                                <field name="client_gender" string="Gender"/>
                                <!-- Consolidated Address with Edit Button -->
                                <div class="d-flex align-items-center">
                                    <label for="consolidated_address" string="Address"/>
                                    <div class="d-flex align-items-center" style="flex: 1;">
                                        <field name="consolidated_address" string="Address" readonly="1" 
                                               class="flex-grow-1" nolabel="1"
                                               placeholder="Click edit to add address"/>
                                        <button name="action_edit_address" type="object" 
                                                class="btn btn-link p-0 ms-2" 
                                                title="Edit Address"
                                                icon="fa-pencil"/>
                                    </div>
                                </div>
                            </group>
                        </group>
                    </div>

                    <!-- STEP 2: Service Requirements -->
                    <div invisible="current_step != '2_services'">
                        <h2 style="margin-bottom: 20px;">
                            <span class="fa fa-stethoscope" style="margin-right: 10px; color: #1565C0;"/>
                            Service Requirements
                        </h2>
                        
                        <group>
                            <group string="Service Selection">
                                <field name="service_category" string="Category"/>
                                <field name="service_type" string="Service Type" required="1"/>
                                <field name="service_subcategory" string="Sub-Category"/>
                                <field name="service_location" string="Service Location"/>
                            </group>
                            <group string="Service Notes">
                            </group>
                        </group>
                        <group>
                            <field name="service_notes" string="Service Notes" nolabel="1" placeholder="Additional service requirements..." colspan="2"/>
                        </group>
                        
                        <separator string="Commission Details"/>
                        
                        <group>
                            <group>
                                <field name="commission_due_to" string="Commission Due To"/>
                                <field name="commission_percentage" string="Commission %"/>
                                <field name="commission_duration" string="Duration"/>
                            </group>
                            <group>
                                <field name="service_fee_vnd" string="Service Fee (VND)"/>
                            </group>
                        </group>
                    </div>

                    <!-- STEP 3: Booking Details -->
                    <div invisible="current_step != '3_booking'">
                        <h2 style="margin-bottom: 20px;">
                            <span class="fa fa-calendar" style="margin-right: 10px; color: #1565C0;"/>
                            Booking Details
                        </h2>
                        
                        <group>
                            <group string="Location &amp; Facility">
                                <field name="catchment_province_id" string="Catchment Province"/>
                                <field name="facility_id" string="Healthcare Facility"/>
                            </group>
                            <group string="Date &amp; Time">
                                <field name="booking_date" string="Date"/>
                                <field name="booking_time" string="Time" widget="time_picker"/>
                                <field name="booking_duration" string="Duration (Hours)"/>
                            </group>
                        </group>
                        
                        <group>
                            <field name="booking_notes" string="Additional Notes" nolabel="1"
                                   placeholder="Any special instructions or notes..."/>
                        </group>
                    </div>


                </sheet>

                <!-- Footer with Navigation Buttons -->
                <footer>
                    <!-- Back to Contact (always visible) -->
                    <button name="action_back_to_contact" type="object"
                            string="&#x2190; Back to Contact" class="btn-secondary"
                            icon="fa-arrow-left"/>

                    <!-- Previous Step (not on step 1) -->
                    <button name="action_prev_step" type="object"
                            string="&#x2190; Previous" class="btn-secondary"
                            icon="fa-chevron-left"
                            invisible="current_step == '1_client'"/>

                    <!-- Next Step (not on final step) -->
                    <button name="action_next_step" type="object"
                            string="Next &#x2192;" class="btn-primary"
                            icon="fa-chevron-right"
                            invisible="current_step == '3_booking'"/>

                    <!-- Create Booking (on final step 3) -->
                    <button name="action_create_booking" type="object"
                            string="&#x2714; Create Booking" class="btn-primary"
                            icon="fa-check-circle"
                            invisible="current_step != '3_booking'"/>

                    <!-- Cancel -->
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Address Edit Popup Wizard - High priority number means low priority (only used when explicitly called) -->
    <record id="view_booking_address_edit_form" model="ir.ui.view">
        <field name="name">health.booking.wizard.address.edit</field>
        <field name="model">health.booking.wizard</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <form string="Edit Address">
                <sheet>
                    <h2 style="margin-bottom: 20px;">
                        <span class="fa fa-map-marker" style="margin-right: 10px; color: #1565C0;"/>
                        Address Details
                    </h2>
                    
                    <group col="2">
                        <field name="address_house_number" string="House Number"/>
                        <field name="address_street" string="Street"/>
                        <field name="address_alley" string="Alley/Lane"/>
                        <field name="address_sub_alley" string="Sub-Alley"/>
                        <field name="address_ward" string="Ward/Commune"/>
                        <field name="address_district" string="District"/>
                        <field name="address_city" string="City/Province"/>
                        <field name="address_building" string="Building Name"/>
                        <field name="address_apartment" string="Apartment/Unit"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save_address" type="object" 
                            string="Save Address" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open Booking Wizard -->
    <record id="action_booking_wizard" model="ir.actions.act_window">
        <field name="name">Create Booking</field>
        <field name="res_model">health.booking.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_booking_wizard_form"/>
    </record>

    <!-- Action to open Address Edit popup -->
    <record id="action_booking_address_edit" model="ir.actions.act_window">
        <field name="name">Edit Address</field>
        <field name="res_model">health.booking.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_booking_address_edit_form"/>
    </record>

</odoo>
