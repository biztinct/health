<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_booking_summary_wizard_form" model="ir.ui.view">
        <field name="name">health.booking.summary.wizard.form</field>
        <field name="model">health.booking.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Bookings Created">
                <sheet>
                    <div style="text-align: center; padding: 30px 20px;">
                        <span class="fa fa-check-circle" style="font-size: 48px; color: #28a745;"/>
                        <h2 style="margin-top: 15px; color: #333;">
                            <field name="booking_count" readonly="1" nolabel="1" class="d-inline"/>
                            Booking(s) Created Successfully
                        </h2>
                        <p style="font-size: 14px; color: #666; margin-top: 10px;">
                            <field name="summary_text" readonly="1" nolabel="1"/>
                        </p>
                    </div>
                    <field name="source_wizard" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_add_services" type="object"
                            string="Add Services &amp; Assignment" class="btn-primary"
                            icon="fa-plus-circle"/>
                    <button name="action_view_bookings" type="object"
                            string="View Bookings" class="btn-secondary"
                            icon="fa-list"/>
                    <button name="action_done" type="object"
                            string="Done" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
