<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="health_voip24h.ClickToDialWidget">
        <div class="o_field_click_to_dial d-inline-flex align-items-center gap-2">
            <!-- Phone number display -->
            <a t-if="phoneNumber" class="o_field_phone" t-attf-href="tel:{{phoneNumber}}" t-esc="phoneNumber"/>

            <!-- Dial button (only visible if a phone number exists) -->
            <button
                t-if="phoneNumber"
                class="btn btn-sm btn-primary o_voip_dial_btn"
                t-on-click.prevent="onClickDial"
                title="Click to dial">
                <i class="fa fa-phone"/> Call
            </button>
        </div>
    </t>

</templates>
