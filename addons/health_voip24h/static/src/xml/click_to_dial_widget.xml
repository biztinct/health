<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="health_voip24h.ClickToDialWidget">
        <div class="o_field_click_to_dial d-inline-flex align-items-center gap-2">
            <!-- Phone number display -->
            <span class="o_field_phone" t-esc="props.phoneNumber"/>

            <!-- Dial button (only visible if phone number exists) -->
            <button
                t-if="isVisible"
                class="btn btn-sm btn-primary o_voip_dial_btn"
                t-on-click="onClickDial"
                t-att-title="this.t('Click to dial')">
                <i class="fa fa-phone"/> <t t-esc="this.t('Call')"/>
            </button>
        </div>
    </t>

</templates>
