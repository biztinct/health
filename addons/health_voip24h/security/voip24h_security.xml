<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Module Category -->
    <record id="module_category_voip24h" model="ir.module.category">
        <field name="name">VoIP24h</field>
        <field name="description">VoIP24h call logging and telephony integration</field>
        <field name="sequence">20</field>
    </record>

    <!-- Base User Group -->
    <record id="group_voip_user" model="res.groups">
        <field name="name">VoIP: User</field>
        <field name="category_id" ref="module_category_voip24h"/>
        <field name="privilege_id" ref="health_base.res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('health_base.group_healthcare_base'))]"/>
        <field name="comment">Basic access to view call logs and make calls</field>
    </record>

    <!-- Manager Group -->
    <record id="group_voip_manager" model="res.groups">
        <field name="name">VoIP: Manager</field>
        <field name="category_id" ref="module_category_voip24h"/>
        <field name="privilege_id" ref="health_base.res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_voip_user'))]"/>
        <field name="comment">Full access to VoIP configuration and all call logs</field>
    </record>

    <!-- Record Rules -->

    <!-- Users can see their own call logs -->
    <record id="voip_call_log_user_rule" model="ir.rule">
        <field name="name">Call Logs: User Own Logs</field>
        <field name="model_id" ref="model_voip_call_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_voip_user'))]"/>
    </record>

    <!-- Managers can see all logs -->
    <record id="voip_call_log_manager_rule" model="ir.rule">
        <field name="name">Call Logs: Manager All Access</field>
        <field name="model_id" ref="model_voip_call_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_voip_manager'))]"/>
    </record>

    <!-- Config access for managers only -->
    <record id="voip_config_manager_rule" model="ir.rule">
        <field name="name">VoIP Config: Manager Access</field>
        <field name="model_id" ref="model_voip_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_voip_manager'))]"/>
    </record>

</odoo>
