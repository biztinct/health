<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_voip_sync_wizard_form" model="ir.ui.view">
        <field name="name">voip.sync.wizard.form</field>
        <field name="model">voip.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Call History">
                <group>
                    <group>
                        <field name="voip_config_id" options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="download_recordings"/>
                    </group>
                </group>
                <footer>
                    <button name="action_sync" type="object" string="Sync Now" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_voip_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sync Call History</field>
        <field name="res_model">voip.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
