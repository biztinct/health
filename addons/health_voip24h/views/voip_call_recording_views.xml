<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_voip_call_recording_list" model="ir.ui.view">
        <field name="name">voip.call.recording.list</field>
        <field name="model">voip.call.recording</field>
        <field name="arch" type="xml">
            <list string="Call Recordings"
                  decoration-muted="state == 'unavailable'"
                  decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="call_log_id"/>
                <field name="duration_seconds"/>
                <field name="state"/>
                <field name="mimetype" string="What it is"/>
                <field name="is_playable" string="Plays in a browser"/>
                <field name="is_downloaded" optional="hide"/>
                <field name="play_count" string="Played" optional="hide"/>
                <button name="action_play_recording" type="object" string="Listen"
                        icon="fa-play" invisible="state == 'unavailable'"/>
                <button name="action_fetch_recording" type="object" string="Fetch"
                        icon="fa-download" invisible="is_downloaded"/>
            </list>
        </field>
    </record>

    <record id="view_voip_call_recording_form" model="ir.ui.view">
        <field name="name">voip.call.recording.form</field>
        <field name="model">voip.call.recording</field>
        <field name="arch" type="xml">
            <form string="Call Recording">
                <header>
                    <button name="action_play_recording" type="object"
                            string="Listen" class="oe_highlight"
                            invisible="state == 'unavailable'"/>
                    <button name="action_fetch_recording" type="object"
                            string="Fetch a copy" invisible="is_downloaded"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="not download_error">
                        <field name="download_error" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="call_log_id"/>
                            <field name="session_id"/>
                            <field name="duration_seconds"/>
                            <field name="access_mode"/>
                            <field name="has_link" readonly="1"/>
                        </group>
                        <group>
                            <field name="mimetype" readonly="1"/>
                            <field name="file_format" readonly="1"/>
                            <field name="is_playable" readonly="1"/>
                            <field name="file_size_bytes" readonly="1"/>
                            <field name="checksum" readonly="1" optional="hide"/>
                            <field name="retention_deadline" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="is_playable or state != 'available'">
                        This recording is not in a format the browser can play.
                        Download it and open it in an audio player instead.
                    </div>
                    <group string="Who has listened">
                        <group>
                            <field name="play_count" readonly="1"/>
                            <field name="last_played_at" readonly="1"/>
                            <field name="last_played_by" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_voip_call_recording" model="ir.actions.act_window">
        <field name="name">Call Recordings</field>
        <field name="res_model">voip.call.recording</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
