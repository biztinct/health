<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Call Log List View -->
    <record id="view_voip_call_log_list" model="ir.ui.view">
        <field name="name">voip.call.log.list</field>
        <field name="model">voip.call.log</field>
        <field name="arch" type="xml">
            <list string="Call Logs" decoration-danger="call_type == 'missed'" decoration-success="call_type == 'answered'">
                <field name="call_date"/>
                <field name="direction"/>
                <field name="call_type"/>
                <field name="caller_number"/>
                <field name="called_number"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <field name="duration_display"/>
                <field name="state"/>
                <field name="has_recording" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Call Log Form View -->
    <record id="view_voip_call_log_form" model="ir.ui.view">
        <field name="name">voip.call.log.form</field>
        <field name="model">voip.call.log</field>
        <field name="arch" type="xml">
            <form string="Call Log">
                <header>
                    <button name="action_match_contact" type="object" string="Match Contact" invisible="partner_id"/>
                    <button name="action_create_lead" type="object" string="Create Lead" invisible="lead_id"/>
                    <button name="action_create_activity" type="object" string="Create Activity" class="oe_highlight"/>
                    <button name="action_play_recording" type="object" string="Play Recording" invisible="not has_recording"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Call Information">
                            <field name="call_id"/>
                            <field name="call_date"/>
                            <field name="direction"/>
                            <field name="call_type"/>
                            <field name="call_status"/>
                        </group>
                        <group string="Timing">
                            <field name="duration_seconds"/>
                            <field name="talk_duration_seconds"/>
                            <field name="duration_display"/>
                        </group>
                    </group>

                    <group>
                        <group string="Phone Numbers">
                            <field name="caller_number"/>
                            <field name="called_number"/>
                            <field name="extension_number"/>
                        </group>
                        <group string="CRM Integration">
                            <field name="partner_id"/>
                            <field name="lead_id"/>
                            <field name="auto_matched" readonly="1"/>
                            <field name="match_confidence" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Recording">
                            <field name="has_recording"/>
                            <field name="recording_count"/>
                        </group>
                        <group string="Activity">
                            <field name="activity_id"/>
                            <field name="activity_created" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notes &amp; Outcome">
                            <group>
                                <field name="call_outcome"/>
                                <field name="call_notes" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Recordings" invisible="not has_recording">
                            <field name="recording_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="duration_seconds"/>
                                    <field name="state"/>
                                    <button name="action_play_recording" type="object" string="Play" icon="fa-play"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- Call Log Kanban View -->
    <record id="view_voip_call_log_kanban" model="ir.ui.view">
        <field name="name">voip.call.log.kanban</field>
        <field name="model">voip.call.log</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="call_date"/>
                <field name="direction"/>
                <field name="call_type"/>
                <field name="caller_number"/>
                <field name="called_number"/>
                <field name="partner_id"/>
                <field name="duration_display"/>
                <field name="has_recording"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong>
                                            <i t-if="record.direction.raw_value == 'incoming'" class="fa fa-arrow-down text-primary"/>
                                            <i t-if="record.direction.raw_value == 'outgoing'" class="fa fa-arrow-up text-success"/>
                                            <field name="partner_id"/>
                                        </strong>
                                        <div class="text-muted">
                                            <field name="caller_number"/> → <field name="called_number"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="badge badge-pill" t-att-class="record.call_type.raw_value == 'missed' ? 'badge-danger' : 'badge-success'">
                                            <field name="call_type"/>
                                        </span>
                                        <span><i class="fa fa-clock-o"/> <field name="duration_display"/></span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <i t-if="record.has_recording.raw_value" class="fa fa-microphone text-info" title="Has Recording"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Call Log Search View -->
    <record id="view_voip_call_log_search" model="ir.ui.view">
        <field name="name">voip.call.log.search</field>
        <field name="model">voip.call.log</field>
        <field name="arch" type="xml">
            <search string="Call Logs">
                <field name="call_id"/>
                <field name="caller_number"/>
                <field name="called_number"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <filter name="incoming" string="Incoming" domain="[('direction', '=', 'incoming')]"/>
                <filter name="outgoing" string="Outgoing" domain="[('direction', '=', 'outgoing')]"/>
                <filter name="missed" string="Missed" domain="[('call_type', '=', 'missed')]"/>
                <filter name="answered" string="Answered" domain="[('call_type', '=', 'answered')]"/>
                <filter name="has_recording" string="Has Recording" domain="[('has_recording', '=', True)]"/>
                <filter name="today" string="Today" domain="[('call_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_direction" string="Direction" context="{'group_by': 'direction'}"/>
                    <filter name="group_call_type" string="Call Type" context="{'group_by': 'call_type'}"/>
                    <filter name="group_partner" string="Contact" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'call_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Call Log Actions -->
    <record id="action_voip_call_log" model="ir.actions.act_window">
        <field name="name">Call Logs</field>
        <field name="res_model">voip.call.log</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No call logs yet
            </p>
            <p>
                Call logs will appear here automatically when calls are synced from VoIP24h.
            </p>
        </field>
    </record>

    <record id="action_voip_call_log_missed" model="ir.actions.act_window">
        <field name="name">Missed Calls</field>
        <field name="res_model">voip.call.log</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_missed': 1}</field>
        <field name="domain">[('call_type', '=', 'missed')]</field>
    </record>

</odoo>
