<?xml version="1.0" encoding="utf-8"?>

<templates xml:space="preserve">
    <t t-name="synconics_bi_dashboard.DashboardChartWrapper">
        <div t-attf-class="#{['tile','kpi'].includes(state.chart_type) &amp;&amp; !state.isKpiError ? 'grid-stack-item-content' : 'grid-stack-item-content p-2'}" style="border-radius: 10px; background: white; border: 1px #dfdfdff5 solid;">
            <div style="height: 100%; position: relative;">
                <div class="chart-header" t-att-style="['tile', 'kpi'].includes(state.chart_type) &amp;&amp; !state.isKpiError ? 'position: absolute; right: 0; z-index: 9; background-color:' + state.background_color +'!important;' : 'height: 6%;'">
                    <span class="title" t-out="(state.isKpiError || !['tile', 'kpi'].includes(state.chart_type)) ? state.name : ''"></span>
                    <div class="button-box">
                        <!-- External window and maximize buttons for embedded views -->
                        <t t-if="['odoo_list_view', 'odoo_kanban_view', 'odoo_pivot_view', 'odoo_calendar_view'].includes(state.chart_type)">
                            <button class="btn" title="Open in New Window" t-on-click="(ev) => onOpenExternalWindow(ev)">
                                <i class="fa fa-window-restore" />
                            </button>
                            <button class="btn" title="Open in Full Screen" t-on-click="(ev) => onMaximizeView(ev)">
                                <i class="fa fa-external-link" />
                            </button>
                        </t>
                        <!-- Download dropdown for other chart types -->
                        <div t-else="" class="dropdown">
                          <button class="btn dropdown-toggle" title="Download Chart" type="button" id="downloadMenuButton" data-bs-toggle="dropdown" aria-expanded="false" style="padding-right: 5px;">
                            <i class="fa fa-download" />
                          </button>
                          <ul class="dropdown-menu" aria-labelledby="downloadMenuButton">
                            <li t-if="!['kpi', 'tile', 'meter_chart'].includes(state.chart_type)"><a class="dropdown-item" t-on-click="(ev) => onDownloadExcel(ev)" href="#">Excel</a></li>
                            <li t-if="!['kpi', 'tile', 'meter_chart'].includes(state.chart_type)"><a class="dropdown-item" t-on-click="(ev) => onDownloadCSV(ev)" href="#">CSV</a></li>
                            <li><a class="dropdown-item" t-on-click="(ev) => onDownloadImage(ev)" href="#">Image</a></li>
                          </ul>
                        </div>
                        <button class="btn" title="Edit Chart" t-on-click="(ev) => onEditChart(ev, state.chartId)"><i class="fa fa-pencil" /></button>
                    </div>
                </div>
                <AreaChart t-if="state.chart_type == 'area_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <BarChart t-if="state.chart_type == 'bar_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <ColumnChart t-if="state.chart_type == 'column_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <DoughnutChart t-if="state.chart_type == 'doughnut_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" show_data_value_type="state.show_data_value_type" />
                <FunnelChart t-if="state.chart_type == 'funnel_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <PyramidChart t-if="state.chart_type == 'pyramid_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <LineChart t-if="state.chart_type == 'line_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <PieChart t-if="state.chart_type == 'pie_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" show_data_value_type="state.show_data_value_type" />
                <RadarChart t-if="state.chart_type == 'radar_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <StackedColumnChart t-if="state.chart_type == 'stackedcolumn_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <RadialChart t-if="state.chart_type == 'radial_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <ScatterChart t-if="state.chart_type == 'scatter_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <MapChart t-if="state.chart_type == 'map_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <MeterChart t-if="state.chart_type == 'meter_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.onApplyCrossFilter" apply_cross_filter="this.onApplyCrossFilter" />
                <SankeyChart t-if="state.chart_type == 'sankey_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <ChordChart t-if="state.chart_type == 'chord_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <TreemapChart t-if="state.chart_type == 'treemap_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <HeatmapChart t-if="state.chart_type == 'heatmap_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <WaterfallChart t-if="state.chart_type == 'waterfall_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <CandlestickChart t-if="state.chart_type == 'candlestick_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <BoxPlotChart t-if="state.chart_type == 'boxplot_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <NetworkChart t-if="state.chart_type == 'network_chart'" theme="state.theme" chartId="state.chartId" name="state.name" export="setExporting" recordSets="state.recordSets" update_chart="this.update_chart" apply_cross_filter="this.onApplyCrossFilter" />
                <ListView t-if="state.chart_type == 'list'" theme="state.theme" chartId="state.chartId" name="state.name" recordSets="state.recordSets" update_chart="this.update_chart" />
                <div t-if="state.chart_type == 'tile'"
                     t-attf-style="height: 100%; {{ props.action_id ? 'cursor: pointer;' : '' }}"
                     t-on-click="() => this.onChartClick()">
                    <TileView theme="state.theme" chartId="state.chartId" name="state.name" recordSets="state.recordSets" update_chart="this.update_chart" />
                </div>
                <div t-if="state.chart_type == 'kpi'"
                     t-attf-style="height: 100%; {{ props.action_id ? 'cursor: pointer;' : '' }}"
                     t-on-click="() => this.onChartClick()">
                    <KPIView theme="state.theme" chartId="state.chartId" name="state.name" recordSets="state.recordSets" update_chart="this.update_chart" />
                </div>
                <TodoView t-if="state.chart_type == 'to_do'" theme="state.theme" chartId="state.chartId" name="state.name" recordSets="state.recordSets" update_chart="this.update_chart" />
                <OdooEmbeddedView t-if="['odoo_list_view', 'odoo_kanban_view', 'odoo_pivot_view', 'odoo_calendar_view'].includes(state.chart_type)" theme="state.theme" chartId="state.chartId" name="state.name" recordSets="state.recordSets" />
            </div>
        </div>
    </t>
</templates>
