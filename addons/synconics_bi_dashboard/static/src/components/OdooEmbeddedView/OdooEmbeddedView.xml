<?xml version="1.0" encoding="utf-8"?>

<templates xml:space="preserve">
    <t t-name="synconics_bi_dashboard.OdooEmbeddedView">
        <div class="o_embedded_view_container" style="height: 100%; width: 100%; position: relative;">

            <!-- Error State -->
            <t t-if="state.errorMessage">
                <div class="alert alert-warning text-center m-3" role="alert">
                    <i class="fa fa-exclamation-triangle fa-2x mb-2"/>
                    <p><t t-esc="state.errorMessage"/></p>
                </div>
            </t>

            <!-- Loading State -->
            <t t-elif="state.loading">
                <div class="d-flex justify-content-center align-items-center" style="height: 100%;">
                    <div class="text-center">
                        <i class="fa fa-spinner fa-spin fa-3x text-muted mb-3"/>
                        <p class="text-muted">Loading view...</p>
                    </div>
                </div>
            </t>

            <!-- Native Odoo View Embedded -->
            <t t-else="">
                <t t-if="state.viewProps">
                    <View t-props="state.viewProps"/>
                </t>
            </t>

        </div>
    </t>
</templates>
