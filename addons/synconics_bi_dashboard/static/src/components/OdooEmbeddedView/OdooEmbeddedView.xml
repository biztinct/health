<?xml version="1.0" encoding="utf-8"?>

<templates xml:space="preserve">
    <t t-name="synconics_bi_dashboard.OdooEmbeddedView">
        <div class="o_embedded_view_container d-flex flex-column" style="height: 100%; width: 100%;">

            <!-- Error State -->
            <t t-if="state.errorMessage">
                <div class="alert alert-warning text-center m-3" role="alert">
                    <i class="fa fa-exclamation-triangle fa-2x mb-2"/>
                    <p><t t-esc="state.errorMessage"/></p>
                </div>
            </t>

            <!-- Loading State -->
            <t t-elif="state.loading">
                <div class="d-flex justify-content-center align-items-center" style="height: 100%;">
                    <div class="text-center">
                        <i class="fa fa-spinner fa-spin fa-3x text-muted mb-3"/>
                        <p class="text-muted">Loading records...</p>
                    </div>
                </div>
            </t>

            <!-- Embedded List View -->
            <t t-else="">
                <!-- Header with record count and open button -->
                <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom bg-light">
                    <div class="text-muted small">
                        <i t-attf-class="fa {{getViewTypeIcon()}} me-1"/>
                        <strong><t t-esc="state.recordCount"/></strong>
                        <t t-if="state.recordCount == 1">record</t>
                        <t t-else="">records</t>
                        <t t-if="state.viewConfig.domain and state.viewConfig.domain.length &gt; 0">
                            <i class="fa fa-filter ms-2" title="Filtered"/>
                        </t>
                    </div>
                    <button class="btn btn-sm btn-primary" t-on-click="openFullView">
                        <i class="fa fa-external-link me-1"/> Open Full View
                    </button>
                </div>

                <!-- Records Table -->
                <div class="flex-grow-1" style="overflow: auto;">
                    <t t-if="state.records.length == 0">
                        <div class="text-center text-muted p-5">
                            <i class="fa fa-inbox fa-3x mb-3" style="opacity: 0.3;"/>
                            <p>No records found</p>
                        </div>
                    </t>
                    <t t-else="">
                        <table class="table table-sm table-hover mb-0" style="font-size: 0.9em;">
                            <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                                <tr>
                                    <th t-foreach="state.displayFields" t-as="field" t-key="field.name" class="text-nowrap">
                                        <t t-esc="field.string"/>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.records" t-as="record" t-key="record.id">
                                    <td t-foreach="state.displayFields" t-as="field" t-key="field.name">
                                        <t t-if="field.type == 'many2one' and Array.isArray(record[field.name])">
                                            <t t-esc="record[field.name][1]"/>
                                        </t>
                                        <t t-elif="field.type == 'boolean'">
                                            <i t-if="record[field.name]" class="fa fa-check text-success"/>
                                            <i t-else="" class="fa fa-times text-danger"/>
                                        </t>
                                        <t t-elif="field.type == 'selection'">
                                            <span class="badge bg-secondary"><t t-esc="record[field.name]"/></span>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="record[field.name]"/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </div>
            </t>

        </div>
    </t>
</templates>
