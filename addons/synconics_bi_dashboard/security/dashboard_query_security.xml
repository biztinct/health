<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_bi_dashboard_query" model="ir.module.category">
        <field name="name">BI Dashboard - Query Builder</field>
        <field name="description">Manage SQL Query Builder access and permissions</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_dashboard_query_user" model="res.groups">
        <field name="name">Query Builder User</field>
        <field name="category_id" ref="module_category_bi_dashboard_query"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can execute pre-defined queries</field>
    </record>

    <record id="group_dashboard_query_manager" model="res.groups">
        <field name="name">Query Builder Manager</field>
        <field name="category_id" ref="module_category_bi_dashboard_query"/>
        <field name="implied_ids" eval="[(4, ref('group_dashboard_query_user'))]"/>
        <field name="comment">Can create and manage custom queries</field>
    </record>

    <record id="dashboard_query_rule_user" model="ir.rule">
        <field name="name">Dashboard Query: User Access</field>
        <field name="model_id" ref="model_dashboard_query"/>
        <field name="domain_force">[
            '|',
            ('allowed_user_ids', '=', False),
            ('allowed_user_ids', 'in', [user.id])
        ]</field>
        <field name="groups" eval="[(4, ref('group_dashboard_query_user'))]"/>
    </record>

    <record id="dashboard_query_rule_manager" model="ir.rule">
        <field name="name">Dashboard Query: Manager Full Access</field>
        <field name="model_id" ref="model_dashboard_query"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dashboard_query_manager'))]"/>
    </record>

</odoo>
