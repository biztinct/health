    <!-- Doughnut Chart: Clients by Active Status -->
    <record id="chart_clients_active" model="dashboard.chart">
        <field name="name">Client Distribution</field>
        <field name="dashboard_id" ref="synconics_bi_dashboard.my_dashboard_default"/>
        <field name="chart_type">doughnut_chart</field>
        <field name="active" eval="True"/>
        <field name="data_source">model</field>
        <field name="model_id" search="[('model', '=', 'res.partner')]"/>
        <field name="group_by_id" search="[('model_id.model', '=', 'res.partner'), ('name', '=', 'active')]"/>
        <field name="data_type">count</field>
        <field name="domain">[('is_patient', '=', True)]</field>
        <field name="limit_record">0</field>
        <field name="background_color">#ffffff</field>
        <field name="theme">material</field>
        <field name="hide_false_value" eval="True"/>
    </record>

    <!-- ================================================================= -->
    <!-- ROW 5: ADDITIONAL KPIs                                           -->
    <!-- ================================================================= -->

    <!-- KPI: Today's Bookings -->
    <record id="kpi_today_bookings" model="dashboard.chart">
        <field name="name">Today's Bookings</field>
        <field name="dashboard_id" ref="synconics_bi_dashboard.my_dashboard_default"/>
        <field name="chart_type">kpi</field>
        <field name="active" eval="True"/>
        <field name="data_source">model</field>
        <field name="model_id" search="[('model', '=', 'health.fieldservice.order')]"/>
        <field name="data_type">count</field>
        <field name="domain">[]</field>
        <field name="limit_record">0</field>
        <field name="date_filter_option">today</field>
        <field name="date_filter_field_id" search="[('model_id.model', '=', 'health.fieldservice.order'), ('name', '=', 'scheduled_date')]"/>
        <field name="background_color">#2c3e50</field>
        <field name="font_color">#ffffff</field>
        <field name="layout_type">layout2</field>
        <field name="icon_option">default</field>
        <field name="default_icon">&lt;span class="fa fa-calendar fa-2x"&gt;&lt;/span&gt;</field>
        <field name="previous_period_comparision" eval="True"/>
        <field name="previous_period_type">percentage</field>
        <field name="previous_period_duration">1</field>
    </record>

    <!-- KPI: This Week's Bookings -->
    <record id="kpi_week_bookings" model="dashboard.chart">
        <field name="name">This Week</field>
        <field name="dashboard_id" ref="synconics_bi_dashboard.my_dashboard_default"/>
        <field name="chart_type">kpi</field>
        <field name="active" eval="True"/>
