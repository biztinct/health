        <field name="active" eval="True"/>
        <field name="data_source">model</field>
        <field name="model_id" search="[('model', '=', 'health.fieldservice.order')]"/>
        <field name="group_by_id" search="[('model_id.model', '=', 'health.fieldservice.order'), ('name', '=', 'state')]"/>
        <field name="data_type">count</field>
        <field name="domain">[]</field>
        <field name="limit_record">0</field>
        <field name="background_color">#ffffff</field>
        <field name="theme">animated</field>
        <field name="hide_false_value" eval="True"/>
    </record>

    <!-- Radar Chart: Leads by Stage -->
    <record id="chart_leads_radar" model="dashboard.chart">
        <field name="name">Leads by Stage</field>
        <field name="dashboard_id" ref="synconics_bi_dashboard.my_dashboard_default"/>
        <field name="chart_type">radar_chart</field>
        <field name="active" eval="True"/>
