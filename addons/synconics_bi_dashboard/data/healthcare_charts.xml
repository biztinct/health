        <field name="sub_group_by_id" search="[('model_id.model', '=', 'health.fieldservice.order'), ('name', '=', 'state')]"/>
        <field name="data_type">count</field>
        <field name="domain">[]</field>
        <field name="limit_record">10</field>
        <field name="sort_order">desc</field>
        <field name="background_color">#ffffff</field>
        <field name="theme">kelly</field>
        <field name="hide_false_value" eval="True"/>
    </record>

