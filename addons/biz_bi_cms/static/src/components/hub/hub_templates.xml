<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="biz_bi_cms.Hub">
        <div class="bi-hub">
            <div class="bi-hub-page">

                <!-- ================================================ HEADER -->
                <div class="bi-hub-head">
                    <div class="bi-hub-head-text">
                        <h1 class="bi-hub-h1">Analytics</h1>
                        <p class="bi-hub-sub">Every dashboard you can see, in one place.</p>
                    </div>
                    <button t-if="state.isCreator" type="button"
                            class="bi-hub-btn bi-hub-btn-primary"
                            t-on-click="createReport">
                        <span class="bi-hub-btn-ico" t-out="uiIcon('plus')"/>
                        <span>Create Report</span>
                    </button>
                </div>

                <!-- ================================================ SEARCH -->
                <div class="bi-hub-search">
                    <span class="bi-hub-search-ico" t-out="uiIcon('search')"/>
                    <!-- id + name are not decoration: without them Chrome
                         raises "A form field element should have an id or
                         name attribute" as a console issue on every load. -->
                    <input type="text" class="bi-hub-search-input"
                           id="bi_hub_search" name="bi_hub_search"
                           autocomplete="off"
                           t-att-placeholder="searchPlaceholder"
                           t-att-aria-label="searchPlaceholder"
                           t-model="state.query"/>
                    <button t-if="isSearching" type="button"
                            class="bi-hub-search-clear"
                            t-att-title="clearLabel" t-att-aria-label="clearLabel"
                            t-on-click="clearSearch">
                        <span t-out="uiIcon('clear', 14)"/>
                    </button>
                </div>

                <!-- =============================================== LOADING -->
                <div t-if="state.loading" class="bi-hub-skeleton-wrap">
                    <div class="bi-hub-skeleton bi-hub-skeleton-strip"/>
                    <div class="bi-hub-grid">
                        <div t-foreach="[1, 2, 3, 4]" t-as="slot" t-key="slot"
                             class="bi-hub-skeleton bi-hub-skeleton-card"/>
                    </div>
                </div>

                <!-- ================================================ DENIED -->
                <div t-elif="state.denied" class="bi-hub-empty">
                    <span class="bi-hub-empty-ico" t-out="bigEmptyIcon"/>
                    <div class="bi-hub-empty-title">Analytics access has not been set up for your account yet</div>
                    <div class="bi-hub-empty-text">Ask an administrator to give you an Analytics role, and your dashboards will appear here.</div>
                </div>

                <t t-else="">

                    <!-- ======================================== RESULTS -->
                    <div t-if="isSearching" class="bi-hub-section">
                        <div class="bi-hub-section-title">Results</div>
                        <div class="bi-hub-results">
                            <button t-foreach="searchResults" t-as="hit" t-key="hit.id"
                                    type="button" class="bi-hub-result"
                                    t-on-click="() => this.openDashboard(hit.id)">
                                <span class="bi-hub-result-dot"/>
                                <span class="bi-hub-result-text">
                                    <span class="bi-hub-result-name" t-esc="hit.name"/>
                                    <span class="bi-hub-result-ws" t-esc="hit.workspace"/>
                                </span>
                            </button>
                            <div t-if="!searchResults.length" class="bi-hub-none">
                                No dashboard matches your search.
                            </div>
                        </div>
                    </div>

                    <t t-else="">

                        <!-- ==================================== RECENTS -->
                        <div t-if="state.recents.length" class="bi-hub-section">
                            <div class="bi-hub-section-title">Continue where you left off</div>
                            <div class="bi-hub-recents">
                                <button t-foreach="state.recents" t-as="recent"
                                        t-key="recent.id" type="button"
                                        class="bi-hub-chip"
                                        t-on-click="() => this.openDashboard(recent.id)">
                                    <span class="bi-hub-chip-ico" t-out="uiIcon('clock', 14)"/>
                                    <span class="bi-hub-chip-text">
                                        <span class="bi-hub-chip-name" t-esc="recent.name"/>
                                        <span class="bi-hub-chip-ws" t-esc="recent.workspace"/>
                                    </span>
                                </button>
                            </div>
                        </div>

                        <!-- ================================== WORKSPACES -->
                        <div class="bi-hub-section">
                            <div class="bi-hub-section-title">Workspaces</div>

                            <div t-if="!state.workspaces.length" class="bi-hub-empty">
                                <span class="bi-hub-empty-ico" t-out="bigEmptyIcon"/>
                                <div class="bi-hub-empty-title">No workspace is shared with you yet</div>
                                <div class="bi-hub-empty-text">Once a workspace is shared with you, its dashboards will be listed here.</div>
                            </div>

                            <!-- ==================== FIRST RUN -->
                            <!-- Workspaces exist, not one dashboard does. -->
                            <div t-elif="isFirstRun" class="bi-hub-firstrun">
                                <span class="bi-hub-firstrun-ico" t-out="firstRunIcon"/>
                                <div class="bi-hub-firstrun-title">Your first report starts here</div>
                                <div t-if="state.isCreator" class="bi-hub-firstrun-text">
                                    Nothing has been built yet. Pick what you want to see, and it will be waiting on this page next time.
                                </div>
                                <div t-else="" class="bi-hub-firstrun-text">
                                    Ask your administrator to set up Analytics, and the dashboards prepared for you will be listed here.
                                </div>
                                <button t-if="state.isCreator" type="button"
                                        class="bi-hub-btn bi-hub-btn-primary"
                                        t-on-click="createReport">
                                    <span class="bi-hub-btn-ico" t-out="uiIcon('plus')"/>
                                    <span>Create Report</span>
                                </button>
                            </div>

                            <div t-else="" class="bi-hub-grid">
                                <section t-foreach="state.workspaces" t-as="ws" t-key="ws.id"
                                         class="bi-hub-card"
                                         t-attf-class="bi-hub-accent-{{ accentOf(ws) }}">
                                    <div class="bi-hub-card-bar"/>
                                    <div class="bi-hub-card-body">
                                        <div class="bi-hub-card-head">
                                            <span class="bi-hub-card-ico"
                                                  t-out="workspaceIcon(ws.icon)"/>
                                            <div class="bi-hub-card-titles">
                                                <div class="bi-hub-card-name" t-esc="ws.name"/>
                                                <!-- Always rendered (reserved
                                                     line): a card without a
                                                     description otherwise
                                                     lifted its counts row and
                                                     divider 7px above its
                                                     neighbours'. -->
                                                <div class="bi-hub-card-desc"
                                                     t-att-title="ws.description"
                                                     t-esc="ws.description or ''"/>
                                            </div>
                                        </div>
                                        <div class="bi-hub-card-counts" t-esc="countsLabel(ws)"/>
                                        <div class="bi-hub-card-list">
                                            <button t-foreach="ws.dashboards" t-as="dash"
                                                    t-key="dash.id" type="button"
                                                    class="bi-hub-row"
                                                    t-att-title="dash.description"
                                                    t-on-click="() => this.openDashboard(dash.id)">
                                                <span class="bi-hub-row-dot"/>
                                                <span class="bi-hub-row-name" t-esc="dash.name"/>
                                            </button>
                                            <div t-if="!ws.dashboards.length" class="bi-hub-none">
                                                <span>No dashboards yet</span>
                                                <button t-if="state.isCreator" type="button"
                                                        class="bi-hub-link"
                                                        t-on-click="createReport">Create one</button>
                                            </div>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        </div>

                    </t>
                </t>

            </div>

            <!-- ========================================== CREATE WIZARD -->
            <!-- A full-viewport overlay, mounted only while it is open so
                 that closing it disposes the ECharts instance and the
                 debounced preview timer with it. -->
            <ReportWizard t-if="state.wizardOpen" onClose.bind="closeWizard"/>
        </div>
    </t>

</templates>
