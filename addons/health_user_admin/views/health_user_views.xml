<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================
         Simplified User List View (for Tenant Admins) 
         ==================================================== -->
    <record id="view_health_users_list" model="ir.ui.view">
        <field name="name">Healthcare Users List</field>
        <field name="model">res.users</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Users"
                  decoration-muted="active==False"
                  create="true" delete="false"
                  default_order="name">
                <field name="name" string="Name"/>
                <field name="login" string="Email"/>
                <field name="phone" optional="show"/>
                <field name="access_role_id" string="Access Role"/>
                <field name="catchment_province_id" string="Catchment Area" optional="show"/>
                <field name="company_id" string="Company" groups="base.group_multi_company"/>
                <field name="active" string="Status" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ====================================================
         Simplified User Form View (for Tenant Admins)
         No groups_id field — roles control permissions
         ==================================================== -->
    <record id="view_health_users_form" model="ir.ui.view">
        <field name="name">Healthcare User Form</field>
        <field name="model">res.users</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="User">
                <header>
                    <button name="action_saas_reset_password" type="object"
                            string="Send Password Reset" class="btn-primary"
                            groups="health_user_admin.group_health_user_admin"/>
                    <button name="action_saas_deactivate" type="object"
                            string="Deactivate" class="btn-secondary"
                            invisible="active == False"
                            groups="health_user_admin.group_health_user_admin"
                            confirm="Are you sure you want to deactivate this user?"/>
                    <button name="action_saas_activate" type="object"
                            string="Activate" class="btn-success"
                            invisible="active == True"
                            groups="health_user_admin.group_health_user_admin"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_staff_details" type="object"
                                class="oe_stat_button" icon="fa-user-md">
                            <span>Staff Details</span>
                        </button>
                        <button name="action_saas_reset_password" type="object"
                                class="oe_stat_button" icon="fa-key"
                                groups="health_user_admin.group_health_user_admin">
                            <span>Reset Password</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active == True"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. John Smith" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Account Information">
                            <field name="login" string="Email" required="1"
                                   placeholder="e.g. john@company.com"/>
                            <field name="phone" string="Phone"/>
                            <field name="company_id" string="Company"
                                   groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                            <field name="lang" string="Language"/>
                            <field name="tz" string="Timezone"/>
                        </group>
                        <group string="Access Control">
                            <!-- Role CREATION is ring-0 work: tenant admins
                                 assign predefined roles only (ACL denies the
                                 create anyway; the option must not invite it).
                                 The is_privileged domain is belt-and-braces on
                                 top of rule_tenant_admin_safe_roles. -->
                            <field name="access_role_id" string="Access Role"
                                   domain="[('is_privileged', '=', False)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="active" string="Active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <!-- Hidden fields for functionality -->
                    <field name="group_ids" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ====================================================
         Simplified User Search View
         ==================================================== -->
    <record id="view_health_users_search" model="ir.ui.view">
        <field name="name">Healthcare Users Search</field>
        <field name="model">res.users</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <search string="Search Users">
                <field name="name"/>
                <field name="login"/>
                <field name="access_role_id"/>
                <field name="catchment_province_id" string="Catchment Area"/>
                <filter name="active_users" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive_users" string="Inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_catchment" string="Catchment Area"
                        context="{'group_by': 'catchment_province_id'}"/>
            </search>
        </field>
    </record>

</odoo>
