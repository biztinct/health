msgid ""
"// Health PWA Service Worker v1.0.95\n"
"// IMPORTANT: Increment version number when deploying updates!\n"
"\n"
"const CACHE_VERSION = '1.0.95';\n"
"const CACHE_NAME = `health-pwa-v${CACHE_VERSION}`;\n"
"const OFFLINE_URL = '/health_pwa/offline';\n"
"const API_CACHE_NAME = `health-pwa-api-v${CACHE_VERSION}`;\n"
"\n"
"// Listen for SKIP_WAITING message to activate new service worker immediately\n"
"self.addEventListener('message', (event) =&gt; {\n"
"    if (event.data &amp;&amp; event.data.type === 'SKIP_WAITING') {\n"
"        self.skipWaiting();\n"
"    }\n"
"});\n"
"\n"
"// Files to cache for offline functionality\n"
"const STATIC_CACHE_URLS = [\n"
"    '/health_pwa',\n"
"    '/health_pwa/offline',\n"
"    `/health_pwa/static/src/css/app.css?v=${CACHE_VERSION}`,\n"
"    `/health_pwa/static/src/css/mobile.css?v=${CACHE_VERSION}`,\n"
"    `/health_pwa/static/src/js/utils/pwa-utils.js?v=${CACHE_VERSION}`,\n"
"    `/health_pwa/static/src/js/app.js?v=${CACHE_VERSION}`,\n"
"    `/health_pwa/static/src/js/router.js?v=${CACHE_VERSION}`,\n"
"    '/health_pwa/static/icons/icon-192.png',\n"
"    // Note: External CDN URLs removed from pre-cache - they fail with CORS errors\n"
"    // and cause the entire SW installation to fail, preventing cache updates.\n"
"    // These are loaded directly via &lt;script&gt; tags and cached by the browser normally.\n"
"];\n"
"\n"
"// API endpoints to cache\n"
"const API_CACHE_PATTERNS = [\n"
"    /^\\/health_pwa\\/api\\/patients/,\n"
"    /^\\/health_pwa\\/api\\/fso/,\n"
"    /^\\/health_pwa\\/api\\/teams/,\n"
"    /^\\/health_pwa\\/api\\/user/,\n"
"];\n"
"\n"
"// Install event - cache static files\n"
"self.addEventListener('install', event =&gt; {\n"
"    console.log('Service Worker installing...');\n"
"    event.waitUntil(\n"
"        caches.open(CACHE_NAME)\n"
"            .then(cache =&gt; {\n"
"                console.log('Caching static files');\n"
"                return cache.addAll(STATIC_CACHE_URLS);\n"
"            })\n"
"            .then(() =&gt; {\n"
"                console.log('Service Worker installed successfully');\n"
"                return self.skipWaiting();\n"
"            })\n"
"            .catch(error =&gt; {\n"
"                console.error('Service Worker installation failed:', error);\n"
"            })\n"
"    );\n"
"});\n"
"\n"
"// Activate event - clean up old caches\n"
"self.addEventListener('activate', event =&gt; {\n"
"    console.log('Service Worker activating...');\n"
"    event.waitUntil(\n"
"        caches.keys().then(cacheNames =&gt; {\n"
"            return Promise.all(\n"
"                cacheNames.map(cacheName =&gt; {\n"
"                    if (cacheName !== CACHE_NAME &amp;&amp; cacheName !== API_CACHE_NAME) {\n"
"                        console.log('Deleting old cache:', cacheName);\n"
"                        return caches.delete(cacheName);\n"
"                    }\n"
"                })\n"
"            );\n"
"        }).then(() =&gt; {\n"
"            console.log('Service Worker activated');\n"
"            return self.clients.claim();\n"
"        })\n"
"    );\n"
"});\n"
"\n"
"// Fetch event - handle network requests with caching strategy\n"
"self.addEventListener('fetch', event =&gt; {\n"
"    const request = event.request;\n"
"    const url = new URL(request.url);\n"
"    \n"
"    // Skip non-GET requests and chrome-extension requests\n"
"    if (request.method !== 'GET' || url.protocol === 'chrome-extension:') {\n"
"        return;\n"
"    }\n"
"    \n"
"    // Handle PWA app requests\n"
"    if (url.pathname.startsWith('/health_pwa')) {\n"
"        if (url.pathname.startsWith('/health_pwa/api/') || url.pathname.startsWith('/health_pwa/sync/')) {\n"
"            // API requests - Network First with Cache Fallback\n"
"            event.respondWith(handleAPIRequest(request));\n"
"        } else if (request.mode === 'navigate' || url.pathname === '/health_pwa' || url.pathname === '/health_pwa/') {\n"
"            // Navigation requests (HTML) - Network First to always get latest version\n"
"            event.respondWith(handleNavigationRequest(request));\n"
"        } else {\n"
"            // Static files (JS, CSS, images) - Cache First (versioned via query param)\n"
"            event.respondWith(handleStaticRequest(request));\n"
"        }\n"
"    }\n"
"});\n"
"// Handle navigation (HTML page) requests with Network First strategy\n"
"async function handleNavigationRequest(request) {\n"
"    try {\n"
"        const response = await fetch(request);\n"
"        if (response.ok) {\n"
"            // Cache the latest HTML for offline use\n"
"            const cache = await caches.open(CACHE_NAME);\n"
"            cache.put(request, response.clone());\n"
"        }\n"
"        return response;\n"
"    } catch (error) {\n"
"        console.log('Navigation fetch failed, using cache');\n"
"        const cache = await caches.open(CACHE_NAME);\n"
"        const cachedResponse = await cache.match(request);\n"
"        if (cachedResponse) return cachedResponse;\n"
"        // Fallback to offline page\n"
"        const offlineResponse = await cache.match(OFFLINE_URL);\n"
"        return offlineResponse || new Response('Offline', { status: 503 });\n"
"    }\n"
"}\n"
"\n"
"// Handle API requests with Network First strategy\n"
"async function handleAPIRequest(request) {\n"
"    const url = new URL(request.url);\n"
"    \n"
"    try {\n"
"        // Try network first\n"
"        const response = await fetch(request);\n"
"        \n"
"        // Cache successful GET responses for offline use\n"
"        if (response.ok &amp;&amp; request.method === 'GET') {\n"
"            const cache = await caches.open(API_CACHE_NAME);\n"
"            cache.put(request, response.clone());\n"
"        }\n"
"        \n"
"        return response;\n"
"    } catch (error) {\n"
"        console.log('Network failed, trying cache for:', url.pathname);\n"
"        \n"
"        // Network failed, try cache\n"
"        const cache = await caches.open(API_CACHE_NAME);\n"
"        const cachedResponse = await cache.match(request);\n"
"        \n"
"        if (cachedResponse) {\n"
"            // Add offline indicator header\n"
"            const response = cachedResponse.clone();\n"
"            response.headers.set('X-Served-By', 'ServiceWorker-Cache');\n"
"            return response;\n"
"        }\n"
"        \n"
"        // Return offline response for API requests\n"
"        return new Response(JSON.stringify({\n"
"            success: false,\n"
"            error: 'Network unavailable and no cached data',\n"
"            offline: true,\n"
"            timestamp: new Date().toISOString()\n"
"        }), {\n"
"            status: 503,\n"
"            headers: { 'Content-Type': 'application/json' }\n"
"        });\n"
"    }\n"
"}\n"
"\n"
"// Handle static requests with Cache First strategy\n"
"async function handleStaticRequest(request) {\n"
"    const cache = await caches.open(CACHE_NAME);\n"
"    const cachedResponse = await cache.match(request);\n"
"    \n"
"    if (cachedResponse) {\n"
"        return cachedResponse;\n"
"    }\n"
"    \n"
"    try {\n"
"        const response = await fetch(request);\n"
"        if (response.ok) {\n"
"            cache.put(request, response.clone());\n"
"        }\n"
"        return response;\n"
"    } catch (error) {\n"
"        console.log('Static request failed:', request.url);\n"
"        \n"
"        // Return offline page for navigation requests\n"
"        if (request.mode === 'navigate') {\n"
"            const offlineResponse = await cache.match(OFFLINE_URL);\n"
"            return offlineResponse || new Response('Offline', { status: 503 });\n"
"        }\n"
"        \n"
"        // Return minimal response for other requests\n"
"        return new Response('Offline', { status: 503 });\n"
"    }\n"
"}\n"
"\n"
"// Background sync for offline actions\n"
"self.addEventListener('sync', event =&gt; {\n"
"    console.log('Background sync triggered:', event.tag);\n"
"    \n"
"    if (event.tag === 'health-pwa-sync') {\n"
"        event.waitUntil(performBackgroundSync());\n"
"    }\n"
"});\n"
"\n"
"// Perform background sync\n"
"async function performBackgroundSync() {\n"
"    try {\n"
"        // Get pending sync data from IndexedDB (handled by PouchDB)\n"
"        console.log('Performing background sync...');\n"
"        \n"
"        // Send message to active clients to trigger sync\n"
"        const clients = await self.clients.matchAll();\n"
"        clients.forEach(client =&gt; {\n"
"            client.postMessage({\n"
"                type: 'BACKGROUND_SYNC',\n"
"                timestamp: new Date().toISOString()\n"
"            });\n"
"        });\n"
"        \n"
"    } catch (error) {\n"
"        console.error('Background sync failed:', error);\n"
"    }\n"
"}\n"
"\n"
"// Push notification handler\n"
"self.addEventListener('push', event =&gt; {\n"
"    console.log('[SW] Push notification received');\n"
"    \n"
"    let notifData = {\n"
"        title: 'Viet Uc',\n"
"        body: 'New notification',\n"
"        icon: '/health_pwa/static/icons/icon-192.png',\n"
"        badge: '/health_pwa/static/icons/icon-96.png',\n"
"        tag: 'health-pwa-notification',\n"
"        data: {},\n"
"    };\n"
"\n"
"    if (event.data) {\n"
"        try {\n"
"            const payload = event.data.json();\n"
"            notifData.title = payload.title || notifData.title;\n"
"            notifData.body = payload.body || notifData.body;\n"
"            notifData.icon = payload.icon || notifData.icon;\n"
"            notifData.badge = payload.badge || notifData.badge;\n"
"            notifData.tag = payload.tag || notifData.tag;\n"
"            notifData.data = payload.data || {};\n"
"        } catch (e) {\n"
"            notifData.body = event.data.text();\n"
"        }\n"
"    }\n"
"\n"
"    // Build notification actions based on type\n"
"    let actions = [\n"
"        { action: 'open', title: 'Mở / Open' },\n"
"        { action: 'close', title: 'Đóng / Close' }\n"
"    ];\n"
"\n"
"    // Assignment notifications get Accept/Decline buttons\n"
"    if (notifData.data &amp;&amp; notifData.data.type === 'assignment' &amp;&amp; notifData.data.assignment_id) {\n"
"        actions = [\n"
"            { action: 'accept', title: '✅ Accept' },\n"
"            { action: 'decline', title: '❌ Decline' },\n"
"        ];\n"
"    }\n"
"\n"
"    const options = {\n"
"        body: notifData.body,\n"
"        icon: notifData.icon,\n"
"        badge: notifData.badge,\n"
"        vibrate: [200, 100, 200],\n"
"        tag: notifData.tag,\n"
"        data: notifData.data,\n"
"        actions: actions,\n"
"        requireInteraction: true,\n"
"    };\n"
"\n"
"    event.waitUntil(\n"
"        self.registration.showNotification(notifData.title, options).then(() =&gt; {\n"
"            // Notify all open clients to refresh notification count\n"
"            return self.clients.matchAll({ type: 'window' }).then(clientList =&gt; {\n"
"                clientList.forEach(client =&gt; {\n"
"                    client.postMessage({ type: 'PUSH_RECEIVED' });\n"
"                });\n"
"            });\n"
"        })\n"
"    );\n"
"});\n"
"\n"
"// Notification click handler\n"
"self.addEventListener('notificationclick', event =&gt; {\n"
"    console.log('[SW] Notification clicked:', event.action);\n"
"    event.notification.close();\n"
"    \n"
"    if (event.action === 'close') return;\n"
"\n"
"    const notifData = event.notification.data || {};\n"
"    const assignmentId = notifData.assignment_id;\n"
"\n"
"    // Handle Accept/Decline actions for assignments\n"
"    if (assignmentId &amp;&amp; (event.action === 'accept' || event.action === 'decline')) {\n"
"        event.waitUntil(\n"
"            fetch(`/health_pwa/api/assignments/${assignmentId}/respond`, {\n"
"                method: 'POST',\n"
"                headers: { 'Content-Type': 'application/json' },\n"
"                body: JSON.stringify({ action: event.action }),\n"
"            }).then(resp =&gt; resp.json()).then(data =&gt; {\n"
"                console.log('[SW] Assignment response:', data);\n"
"                // Notify clients to refresh\n"
"                return self.clients.matchAll({ type: 'window' }).then(clientList =&gt; {\n"
"                    clientList.forEach(client =&gt; {\n"
"                        client.postMessage({ type: 'PUSH_RECEIVED' });\n"
"                    });\n"
"                    // If no open clients, show a confirmation notification\n"
"                    if (clientList.length === 0) {\n"
"                        const msg = event.action === 'accept'\n"
"                            ? '✅ Assignment confirmed'\n"
"                            : '❌ Assignment declined';\n"
"                        return self.registration.showNotification('Viet Uc', {\n"
"                            body: msg,\n"
"                            icon: '/health_pwa/static/icons/icon-192.png',\n"
"                            tag: 'assignment-response',\n"
"                        });\n"
"                    }\n"
"                });\n"
"            }).catch(err =&gt; {\n"
"                console.error('[SW] Failed to respond to assignment:', err);\n"
"                return self.registration.showNotification('Viet Uc', {\n"
"                    body: '⚠️ Error responding to assignment. Please open the app.',\n"
"                    icon: '/health_pwa/static/icons/icon-192.png',\n"
"                    tag: 'assignment-response-error',\n"
"                });\n"
"            })\n"
"        );\n"
"        return;\n"
"    }\n"
"\n"
"    // Default: open the app (with notifications panel if assignment)\n"
"    const urlToOpen = (notifData &amp;&amp; notifData.type === 'assignment')\n"
"        ? '/health_pwa#/today?showNotifications=1'\n"
"        : (notifData &amp;&amp; notifData.url)\n"
"            ? notifData.url\n"
"            : '/health_pwa';\n"
"\n"
"    event.waitUntil(\n"
"        clients.matchAll({ type: 'window', includeUncontrolled: true }).then(clientList =&gt; {\n"
"            // Try to focus existing window\n"
"            for (const client of clientList) {\n"
"                if (client.url.includes('/health_pwa') &amp;&amp; 'focus' in client) {\n"
"                    client.navigate(urlToOpen);\n"
"                    return client.focus();\n"
"                }\n"
"            }\n"
"            // Open new window if no existing window\n"
"            if (clients.openWindow) {\n"
"                return clients.openWindow(urlToOpen);\n"
"            }\n"
"        })\n"
"    );\n"
"});\n"
"\n"
"console.log('Health PWA Service Worker loaded successfully');"
msgstr "// Health PWA Service Worker v1.0.95\n// IMPORTANT: Increment version number when deploying updates!\n\nconst CACHE_VERSION = '1.0.95';\nconst CACHE_NAME = `health-pwa-v${CACHE_VERSION}`;\nconst OFFLINE_URL = '/health_pwa/offline';\nconst API_CACHE_NAME = `health-pwa-api-v${CACHE_VERSION}`;\n\n// Listen for SKIP_WAITING message to activate new service worker immediately\nself.addEventListener('message', (event) =&gt; {\n    if (event.data &amp;&amp; event.data.type === 'SKIP_WAITING') {\n        self.skipWaiting();\n    }\n});\n\n// Files to cache for offline functionality\nconst STATIC_CACHE_URLS = [\n    '/health_pwa',\n    '/health_pwa/offline',\n    `/health_pwa/static/src/css/app.css?v=${CACHE_VERSION}`,\n    `/health_pwa/static/src/css/mobile.css?v=${CACHE_VERSION}`,\n    `/health_pwa/static/src/js/utils/pwa-utils.js?v=${CACHE_VERSION}`,\n    `/health_pwa/static/src/js/app.js?v=${CACHE_VERSION}`,\n    `/health_pwa/static/src/js/router.js?v=${CACHE_VERSION}`,\n    '/health_pwa/static/icons/icon-192.png',\n    // Note: External CDN URLs removed from pre-cache - they fail with CORS errors\n    // and cause the entire SW installation to fail, preventing cache updates.\n    // These are loaded directly via &lt;script&gt; tags and cached by the browser normally.\n];\n\n// API endpoints to cache\nconst API_CACHE_PATTERNS = [\n    /^\\/health_pwa\\/api\\/patients/,\n    /^\\/health_pwa\\/api\\/fso/,\n    /^\\/health_pwa\\/api\\/teams/,\n    /^\\/health_pwa\\/api\\/user/,\n];\n\n// Install event - cache static files\nself.addEventListener('install', event =&gt; {\n    console.log('Service Worker installing...');\n    event.waitUntil(\n        caches.open(CACHE_NAME)\n            .then(cache =&gt; {\n                console.log('Caching static files');\n                return cache.addAll(STATIC_CACHE_URLS);\n            })\n            .then(() =&gt; {\n                console.log('Service Worker installed successfully');\n                return self.skipWaiting();\n            })\n            .catch(error =&gt; {\n                console.error('Service Worker installation failed:', error);\n            })\n    );\n});\n\n// Activate event - clean up old caches\nself.addEventListener('activate', event =&gt; {\n    console.log('Service Worker activating...');\n    event.waitUntil(\n        caches.keys().then(cacheNames =&gt; {\n            return Promise.all(\n                cacheNames.map(cacheName =&gt; {\n                    if (cacheName !== CACHE_NAME &amp;&amp; cacheName !== API_CACHE_NAME) {\n                        console.log('Deleting old cache:', cacheName);\n                        return caches.delete(cacheName);\n                    }\n                })\n            );\n        }).then(() =&gt; {\n            console.log('Service Worker activated');\n            return self.clients.claim();\n        })\n    );\n});\n\n// Fetch event - handle network requests with caching strategy\nself.addEventListener('fetch', event =&gt; {\n    const request = event.request;\n    const url = new URL(request.url);\n    \n    // Skip non-GET requests and chrome-extension requests\n    if (request.method !== 'GET' || url.protocol === 'chrome-extension:') {\n        return;\n    }\n    \n    // Handle PWA app requests\n    if (url.pathname.startsWith('/health_pwa')) {\n        if (url.pathname.startsWith('/health_pwa/api/') || url.pathname.startsWith('/health_pwa/sync/')) {\n            // API requests - Network First with Cache Fallback\n            event.respondWith(handleAPIRequest(request));\n        } else if (request.mode === 'navigate' || url.pathname === '/health_pwa' || url.pathname === '/health_pwa/') {\n            // Navigation requests (HTML) - Network First to always get latest version\n            event.respondWith(handleNavigationRequest(request));\n        } else {\n            // Static files (JS, CSS, images) - Cache First (versioned via query param)\n            event.respondWith(handleStaticRequest(request));\n        }\n    }\n});\n// Handle navigation (HTML page) requests with Network First strategy\nasync function handleNavigationRequest(request) {\n    try {\n        const response = await fetch(request);\n        if (response.ok) {\n            // Cache the latest HTML for offline use\n            const cache = await caches.open(CACHE_NAME);\n            cache.put(request, response.clone());\n        }\n        return response;\n    } catch (error) {\n        console.log('Navigation fetch failed, using cache');\n        const cache = await caches.open(CACHE_NAME);\n        const cachedResponse = await cache.match(request);\n        if (cachedResponse) return cachedResponse;\n        // Fallback to offline page\n        const offlineResponse = await cache.match(OFFLINE_URL);\n        return offlineResponse || new Response('Offline', { status: 503 });\n    }\n}\n\n// Handle API requests with Network First strategy\nasync function handleAPIRequest(request) {\n    const url = new URL(request.url);\n    \n    try {\n        // Try network first\n        const response = await fetch(request);\n        \n        // Cache successful GET responses for offline use\n        if (response.ok &amp;&amp; request.method === 'GET') {\n            const cache = await caches.open(API_CACHE_NAME);\n            cache.put(request, response.clone());\n        }\n        \n        return response;\n    } catch (error) {\n        console.log('Network failed, trying cache for:', url.pathname);\n        \n        // Network failed, try cache\n        const cache = await caches.open(API_CACHE_NAME);\n        const cachedResponse = await cache.match(request);\n        \n        if (cachedResponse) {\n            // Add offline indicator header\n            const response = cachedResponse.clone();\n            response.headers.set('X-Served-By', 'ServiceWorker-Cache');\n            return response;\n        }\n        \n        // Return offline response for API requests\n        return new Response(JSON.stringify({\n            success: false,\n            error: 'Network unavailable and no cached data',\n            offline: true,\n            timestamp: new Date().toISOString()\n        }), {\n            status: 503,\n            headers: { 'Content-Type': 'application/json' }\n        });\n    }\n}\n\n// Handle static requests with Cache First strategy\nasync function handleStaticRequest(request) {\n    const cache = await caches.open(CACHE_NAME);\n    const cachedResponse = await cache.match(request);\n    \n    if (cachedResponse) {\n        return cachedResponse;\n    }\n    \n    try {\n        const response = await fetch(request);\n        if (response.ok) {\n            cache.put(request, response.clone());\n        }\n        return response;\n    } catch (error) {\n        console.log('Static request failed:', request.url);\n        \n        // Return offline page for navigation requests\n        if (request.mode === 'navigate') {\n            const offlineResponse = await cache.match(OFFLINE_URL);\n            return offlineResponse || new Response('Offline', { status: 503 });\n        }\n        \n        // Return minimal response for other requests\n        return new Response('Offline', { status: 503 });\n    }\n}\n\n// Background sync for offline actions\nself.addEventListener('sync', event =&gt; {\n    console.log('Background sync triggered:', event.tag);\n    \n    if (event.tag === 'health-pwa-sync') {\n        event.waitUntil(performBackgroundSync());\n    }\n});\n\n// Perform background sync\nasync function performBackgroundSync() {\n    try {\n        // Get pending sync data from IndexedDB (handled by PouchDB)\n        console.log('Performing background sync...');\n        \n        // Send message to active clients to trigger sync\n        const clients = await self.clients.matchAll();\n        clients.forEach(client =&gt; {\n            client.postMessage({\n                type: 'BACKGROUND_SYNC',\n                timestamp: new Date().toISOString()\n            });\n        });\n        \n    } catch (error) {\n        console.error('Background sync failed:', error);\n    }\n}\n\n// Push notification handler\nself.addEventListener('push', event =&gt; {\n    console.log('[SW] Push notification received');\n    \n    let notifData = {\n        title: 'Viet Uc',\n        body: 'New notification',\n        icon: '/health_pwa/static/icons/icon-192.png',\n        badge: '/health_pwa/static/icons/icon-96.png',\n        tag: 'health-pwa-notification',\n        data: {},\n    };\n\n    if (event.data) {\n        try {\n            const payload = event.data.json();\n            notifData.title = payload.title || notifData.title;\n            notifData.body = payload.body || notifData.body;\n            notifData.icon = payload.icon || notifData.icon;\n            notifData.badge = payload.badge || notifData.badge;\n            notifData.tag = payload.tag || notifData.tag;\n            notifData.data = payload.data || {};\n        } catch (e) {\n            notifData.body = event.data.text();\n        }\n    }\n\n    // Build notification actions based on type\n    let actions = [\n        { action: 'open', title: 'Mở / Open' },\n        { action: 'close', title: 'Đóng / Close' }\n    ];\n\n    // Assignment notifications get Accept/Decline buttons\n    if (notifData.data &amp;&amp; notifData.data.type === 'assignment' &amp;&amp; notifData.data.assignment_id) {\n        actions = [\n            { action: 'accept', title: '✅ Accept' },\n            { action: 'decline', title: '❌ Decline' },\n        ];\n    }\n\n    const options = {\n        body: notifData.body,\n        icon: notifData.icon,\n        badge: notifData.badge,\n        vibrate: [200, 100, 200],\n        tag: notifData.tag,\n        data: notifData.data,\n        actions: actions,\n        requireInteraction: true,\n    };\n\n    event.waitUntil(\n        self.registration.showNotification(notifData.title, options).then(() =&gt; {\n            // Notify all open clients to refresh notification count\n            return self.clients.matchAll({ type: 'window' }).then(clientList =&gt; {\n                clientList.forEach(client =&gt; {\n                    client.postMessage({ type: 'PUSH_RECEIVED' });\n                });\n            });\n        })\n    );\n});\n\n// Notification click handler\nself.addEventListener('notificationclick', event =&gt; {\n    console.log('[SW] Notification clicked:', event.action);\n    event.notification.close();\n    \n    if (event.action === 'close') return;\n\n    const notifData = event.notification.data || {};\n    const assignmentId = notifData.assignment_id;\n\n    // Handle Accept/Decline actions for assignments\n    if (assignmentId &amp;&amp; (event.action === 'accept' || event.action === 'decline')) {\n        event.waitUntil(\n            fetch(`/health_pwa/api/assignments/${assignmentId}/respond`, {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify({ action: event.action }),\n            }).then(resp =&gt; resp.json()).then(data =&gt; {\n                console.log('[SW] Assignment response:', data);\n                // Notify clients to refresh\n                return self.clients.matchAll({ type: 'window' }).then(clientList =&gt; {\n                    clientList.forEach(client =&gt; {\n                        client.postMessage({ type: 'PUSH_RECEIVED' });\n                    });\n                    // If no open clients, show a confirmation notification\n                    if (clientList.length === 0) {\n                        const msg = event.action === 'accept'\n                            ? '✅ Assignment confirmed'\n                            : '❌ Assignment declined';\n                        return self.registration.showNotification('Viet Uc', {\n                            body: msg,\n                            icon: '/health_pwa/static/icons/icon-192.png',\n                            tag: 'assignment-response',\n                        });\n                    }\n                });\n            }).catch(err =&gt; {\n                console.error('[SW] Failed to respond to assignment:', err);\n                return self.registration.showNotification('Viet Uc', {\n                    body: '⚠️ Error responding to assignment. Please open the app.',\n                    icon: '/health_pwa/static/icons/icon-192.png',\n                    tag: 'assignment-response-error',\n                });\n            })\n        );\n        return;\n    }\n\n    // Default: open the app (with notifications panel if assignment)\n    const urlToOpen = (notifData &amp;&amp; notifData.type === 'assignment')\n        ? '/health_pwa#/today?showNotifications=1'\n        : (notifData &amp;&amp; notifData.url)\n            ? notifData.url\n            : '/health_pwa';\n\n    event.waitUntil(\n        clients.matchAll({ type: 'window', includeUncontrolled: true }).then(clientList =&gt; {\n            // Try to focus existing window\n            for (const client of clientList) {\n                if (client.url.includes('/health_pwa') &amp;&amp; 'focus' in client) {\n                    client.navigate(urlToOpen);\n                    return client.focus();\n                }\n            }\n            // Open new window if no existing window\n            if (clients.openWindow) {\n                return clients.openWindow(urlToOpen);\n            }\n        })\n    );\n});\n\nconsole.log('Health PWA Service Worker loaded successfully');"

