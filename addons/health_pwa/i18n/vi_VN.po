#: model_terms:ir.ui.view,arch_db:health_pwa.service_worker_js
msgid ""
"// Health PWA Service Worker v1.0.0\n"
"\n"
"const CACHE_NAME = 'health-pwa-v1.0.0';\n"
"const OFFLINE_URL = '/health_pwa/offline';\n"
"const API_CACHE_NAME = 'health-pwa-api-v1.0.0';\n"
"\n"
"// Files to cache for offline functionality\n"
"const STATIC_CACHE_URLS = [\n"
"    '/health_pwa',\n"
"    '/health_pwa/offline',\n"
"    '/health_pwa/static/src/css/app.css',\n"
"    '/health_pwa/static/src/css/mobile.css',\n"
"    '/health_pwa/static/src/js/app.js',\n"
"    '/health_pwa/static/src/js/router.js',\n"
"    '/health_pwa/static/icons/icon-192.png',\n"
"    'https://unpkg.com/vue@3.4.0/dist/vue.global.prod.js',\n"
"    'https://unpkg.com/quasar@2.14.0/dist/quasar.umd.min.js',\n"
"    'https://unpkg.com/pouchdb@8.0.0/dist/pouchdb.min.js',\n"
"];\n"
"\n"
"// API endpoints to cache\n"
"const API_CACHE_PATTERNS = [\n"
"    /^\\/health_pwa\\/api\\/patients/,\n"
"    /^\\/health_pwa\\/api\\/fso/,\n"
"    /^\\/health_pwa\\/api\\/teams/,\n"
"    /^\\/health_pwa\\/api\\/user/,\n"
"];\n"
"\n"
"// Install event - cache static files\n"
"self.addEventListener('install', event =&gt; {\n"
"    console.log('Service Worker installing...');\n"
"    event.waitUntil(\n"
"        caches.open(CACHE_NAME)\n"
"            .then(cache =&gt; {\n"
"                console.log('Caching static files');\n"
"                return cache.addAll(STATIC_CACHE_URLS);\n"
"            })\n"
"            .then(() =&gt; {\n"
"                console.log('Service Worker installed successfully');\n"
"                return self.skipWaiting();\n"
"            })\n"
"            .catch(error =&gt; {\n"
"                console.error('Service Worker installation failed:', "
"error);\n"
"            })\n"
"    );\n"
"});\n"
"\n"
"// Activate event - clean up old caches\n"
"self.addEventListener('activate', event =&gt; {\n"
"    console.log('Service Worker activating...');\n"
"    event.waitUntil(\n"
"        caches.keys().then(cacheNames =&gt; {\n"
"            return Promise.all(\n"
"                cacheNames.map(cacheName =&gt; {\n"
"                    if (cacheName !== CACHE_NAME &amp;&amp; cacheName !== "
"API_CACHE_NAME) {\n"
"                        console.log('Deleting old cache:', cacheName);\n"
"                        return caches.delete(cacheName);\n"
"                    }\n"
"                })\n"
"            );\n"
"        }).then(() =&gt; {\n"
"            console.log('Service Worker activated');\n"
"            return self.clients.claim();\n"
"        })\n"
"    );\n"
"});\n"
"\n"
"// Fetch event - handle network requests with caching strategy\n"
"self.addEventListener('fetch', event =&gt; {\n"
"    const request = event.request;\n"
"    const url = new URL(request.url);\n"
"    \n"
"    // Skip non-GET requests and chrome-extension requests\n"
"    if (request.method !== 'GET' || url.protocol === 'chrome-extension:') {\n"
"        return;\n"
"    }\n"
"    \n"
"    // Handle PWA app requests\n"
"    if (url.pathname.startsWith('/health_pwa')) {\n"
"        if (url.pathname.startsWith('/health_pwa/api/') || "
"url.pathname.startsWith('/health_pwa/sync/')) {\n"
"            // API requests - Network First with Cache Fallback\n"
"            event.respondWith(handleAPIRequest(request));\n"
"        } else {\n"
"            // Static files - Cache First\n"
"            event.respondWith(handleStaticRequest(request));\n"
"        }\n"
"    }\n"
"});\n"
"\n"
"// Handle API requests with Network First strategy\n"
"async function handleAPIRequest(request) {\n"
"    const url = new URL(request.url);\n"
"    \n"
"    try {\n"
"        // Try network first\n"
"        const response = await fetch(request);\n"
"        \n"
"        // Cache successful GET responses for offline use\n"
"        if (response.ok &amp;&amp; request.method === 'GET') {\n"
"            const cache = await caches.open(API_CACHE_NAME);\n"
"            cache.put(request, response.clone());\n"
"        }\n"
"        \n"
"        return response;\n"
"    } catch (error) {\n"
"        console.log('Network failed, trying cache for:', url.pathname);\n"
"        \n"
"        // Network failed, try cache\n"
"        const cache = await caches.open(API_CACHE_NAME);\n"
"        const cachedResponse = await cache.match(request);\n"
"        \n"
"        if (cachedResponse) {\n"
"            // Add offline indicator header\n"
"            const response = cachedResponse.clone();\n"
"            response.headers.set('X-Served-By', 'ServiceWorker-Cache');\n"
"            return response;\n"
"        }\n"
"        \n"
"        // Return offline response for API requests\n"
"        return new Response(JSON.stringify({\n"
"            success: false,\n"
"            error: 'Network unavailable and no cached data',\n"
"            offline: true,\n"
"            timestamp: new Date().toISOString()\n"
"        }), {\n"
"            status: 503,\n"
"            headers: { 'Content-Type': 'application/json' }\n"
"        });\n"
"    }\n"
"}\n"
"\n"
"// Handle static requests with Cache First strategy\n"
"async function handleStaticRequest(request) {\n"
"    const cache = await caches.open(CACHE_NAME);\n"
"    const cachedResponse = await cache.match(request);\n"
"    \n"
"    if (cachedResponse) {\n"
"        return cachedResponse;\n"
"    }\n"
"    \n"
"    try {\n"
"        const response = await fetch(request);\n"
"        if (response.ok) {\n"
"            cache.put(request, response.clone());\n"
"        }\n"
"        return response;\n"
"    } catch (error) {\n"
"        console.log('Static request failed:', request.url);\n"
"        \n"
"        // Return offline page for navigation requests\n"
"        if (request.mode === 'navigate') {\n"
"            const offlineResponse = await cache.match(OFFLINE_URL);\n"
"            return offlineResponse || new Response('Offline', { status: "
"503 });\n"
"        }\n"
"        \n"
"        // Return minimal response for other requests\n"
"        return new Response('Offline', { status: 503 });\n"
"    }\n"
"}\n"
"\n"
"// Background sync for offline actions\n"
"self.addEventListener('sync', event =&gt; {\n"
"    console.log('Background sync triggered:', event.tag);\n"
"    \n"
"    if (event.tag === 'health-pwa-sync') {\n"
"        event.waitUntil(performBackgroundSync());\n"
"    }\n"
"});\n"
"\n"
"// Perform background sync\n"
"async function performBackgroundSync() {\n"
"    try {\n"
"        // Get pending sync data from IndexedDB (handled by PouchDB)\n"
"        console.log('Performing background sync...');\n"
"        \n"
"        // Send message to active clients to trigger sync\n"
"        const clients = await self.clients.matchAll();\n"
"        clients.forEach(client =&gt; {\n"
"            client.postMessage({\n"
"                type: 'BACKGROUND_SYNC',\n"
"                timestamp: new Date().toISOString()\n"
"            });\n"
"        });\n"
"        \n"
"    } catch (error) {\n"
"        console.error('Background sync failed:', error);\n"
"    }\n"
"}\n"
"\n"
"// Push notification handler (for future use)\n"
"self.addEventListener('push', event =&gt; {\n"
"    console.log('Push notification received:', event);\n"
"    \n"
"    const options = {\n"
"        body: event.data ? event.data.text() : 'New health update "
"available',\n"
"        icon: '/health_pwa/static/icons/icon-192.png',\n"
"        badge: '/health_pwa/static/icons/icon-96.png',\n"
"        vibrate: [200, 100, 200],\n"
"        tag: 'health-pwa-notification',\n"
"        actions: [\n"
"            {\n"
"                action: 'open',\n"
"                title: 'Open App',\n"
"                icon: '/health_pwa/static/icons/icon-96.png'\n"
"            },\n"
"            {\n"
"                action: 'close',\n"
"                title: 'Close',\n"
"                icon: '/health_pwa/static/icons/icon-96.png'\n"
"            }\n"
"        ]\n"
"    };\n"
"    \n"
"    event.waitUntil(\n"
"        self.registration.showNotification('Health Mobile', options)\n"
"    );\n"
"});\n"
"\n"
"// Notification click handler\n"
"self.addEventListener('notificationclick', event =&gt; {\n"
"    console.log('Notification clicked:', event);\n"
"    event.notification.close();\n"
"    \n"
"    if (event.action === 'open') {\n"
"        event.waitUntil(\n"
"            clients.matchAll().then(clientList =&gt; {\n"
"                // Try to focus existing window\n"
"                for (const client of clientList) {\n"
"                    if (client.url.includes('/health_pwa') &amp;&amp; "
"'focus' in client) {\n"
"                        return client.focus();\n"
"                    }\n"
"                }\n"
"                \n"
"                // Open new window if no existing window\n"
"                if (clients.openWindow) {\n"
"                    return clients.openWindow('/health_pwa');\n"
"                }\n"
"            })\n"
"        );\n"
"    }\n"
"});\n"
"\n"
"console.log('Health PWA Service Worker loaded successfully');"
msgstr ""
"// Y tế PWA Service Worker v1.0.0\n"
"\n"
"const CACHE_NAME = 'Y tế-pwa-v1.0.0';\n"
"const OFFLINE_URL = '/health_pwa/offline';\n"
"const API_CACHE_NAME = 'Y tế-pwa-api-v1.0.0';\n"
"\n"
"// Files Đến cache for offline functionality\n"
"const STATIC_CACHE_URLS = [\n"
"    '/health_pwa',\n"
"    '/health_pwa/offline',\n"
"    '/health_pwa/static/src/css/app.css',\n"
"    '/health_pwa/static/src/css/Di động.css',\n"
"    '/health_pwa/static/src/js/app.js',\n"
"    '/health_pwa/static/src/js/router.js',\n"
"    '/health_pwa/static/icons/icon-192.png',\n"
"    'https://unpkg.com/vue@3.4.0/dist/vue.global.prod.js',\n"
"    'https://unpkg.com/quasar@2.14.0/dist/quasar.umd.min.js',\n"
"    'https://unpkg.com/pouchdb@8.0.0/dist/pouchdb.min.js',\n"
"];\n"
"\n"
"// API endpoints Đến cache\n"
"const API_CACHE_PATTERNS = [\n"
"    /^\\/health_pwa\\/api\\/Bệnh nhân/,\n"
"    /^\\/health_pwa\\/api\\/fso/,\n"
"    /^\\/health_pwa\\/api\\/teams/,\n"
"    /^\\/health_pwa\\/api\\/Người dùng/,\n"
"];\n"
"\n"
"// Install event - cache static files\n"
"self.addEventListener('install', event =&gt; {\n"
"    console.log('Service Worker installing...');\n"
"    event.waitUntil(\n"
"        caches.Mở(CACHE_NAME)\n"
"            .then(cache =&gt; {\n"
"                console.log('Caching static files');\n"
"                return cache.addAll(STATIC_CACHE_URLS);\n"
"            })\n"
"            .then(() =&gt; {\n"
"                console.log('Service Worker installed successfully');\n"
"                return self.skipWaiting();\n"
"            })\n"
"            .catch(Lỗi =&gt; {\n"
"                console.Lỗi('Service Worker installation Thất bại:', Lỗi);\n"
"            })\n"
"    );\n"
"});\n"
"\n"
"// Kích hoạt event - clean up old caches\n"
"self.addEventListener('Kích hoạt', event =&gt; {\n"
"    console.log('Service Worker activating...');\n"
"    event.waitUntil(\n"
"        caches.keys().then(cacheNames =&gt; {\n"
"            return Promise.Tất cả(\n"
"                cacheNames.Bản đồ(cacheName =&gt; {\n"
"                    if (cacheName !== CACHE_NAME &amp;&amp; cacheName !== "
"API_CACHE_NAME) {\n"
"                        console.log('Deleting old cache:', cacheName);\n"
"                        return caches.Xóa(cacheName);\n"
"                    }\n"
"                })\n"
"            );\n"
"        }).then(() =&gt; {\n"
"            console.log('Service Worker activated');\n"
"            return self.Khách hàng.claim();\n"
"        })\n"
"    );\n"
"});\n"
"\n"
"// Fetch event - handle network requests with caching strategy\n"
"self.addEventListener('fetch', event =&gt; {\n"
"    const request = event.request;\n"
"    const url = Mới URL(request.url);\n"
"    \n"
"    // Skip non-GET requests and chrome-extension requests\n"
"    if (request.method !== 'GET' || url.protocol === 'chrome-extension:') {\n"
"        return;\n"
"    }\n"
"    \n"
"    // Handle PWA app requests\n"
"    if (url.pathname.startsWith('/health_pwa')) {\n"
"        if (url.pathname.startsWith('/health_pwa/api/') || "
"url.pathname.startsWith('/health_pwa/sync/')) {\n"
"            // API requests - Network First with Cache Fallback\n"
"            event.respondWith(handleAPIRequest(request));\n"
"        } else {\n"
"            // Static files - Cache First\n"
"            event.respondWith(handleStaticRequest(request));\n"
"        }\n"
"    }\n"
"});\n"
"\n"
"// Handle API requests with Network First strategy\n"
"async function handleAPIRequest(request) {\n"
"    const url = Mới URL(request.url);\n"
"    \n"
"    try {\n"
"        // Try network first\n"
"        const response = await fetch(request);\n"
"        \n"
"        // Cache successful GET responses for offline use\n"
"        if (response.ok &amp;&amp; request.method === 'GET') {\n"
"            const cache = await caches.Mở(API_CACHE_NAME);\n"
"            cache.put(request, response.clone());\n"
"        }\n"
"        \n"
"        return response;\n"
"    } catch (Lỗi) {\n"
"        console.log('Network Thất bại, trying cache for:', url.pathname);\n"
"        \n"
"        // Network Thất bại, try cache\n"
"        const cache = await caches.Mở(API_CACHE_NAME);\n"
"        const cachedResponse = await cache.match(request);\n"
"        \n"
"        if (cachedResponse) {\n"
"            // Thêm offline indicator header\n"
"            const response = cachedResponse.clone();\n"
"            response.headers.set('X-Served-By', 'ServiceWorker-Cache');\n"
"            return response;\n"
"        }\n"
"        \n"
"        // Return offline response for API requests\n"
"        return Mới Response(JSON.stringify({\n"
"            Thành công: Sai,\n"
"            Lỗi: 'Network unavailable and Không cached data',\n"
"            offline: Đúng,\n"
"            timestamp: Mới Ngày().toISOString()\n"
"        }), {\n"
"            Trạng thái: 503,\n"
"            headers: { 'Content-Loại': 'application/json' }\n"
"        });\n"
"    }\n"
"}\n"
"\n"
"// Handle static requests with Cache First strategy\n"
"async function handleStaticRequest(request) {\n"
"    const cache = await caches.Mở(CACHE_NAME);\n"
"    const cachedResponse = await cache.match(request);\n"
"    \n"
"    if (cachedResponse) {\n"
"        return cachedResponse;\n"
"    }\n"
"    \n"
"    try {\n"
"        const response = await fetch(request);\n"
"        if (response.ok) {\n"
"            cache.put(request, response.clone());\n"
"        }\n"
"        return response;\n"
"    } catch (Lỗi) {\n"
"        console.log('Static request Thất bại:', request.url);\n"
"        \n"
"        // Return offline page for navigation requests\n"
"        if (request.mode === 'navigate') {\n"
"            const offlineResponse = await cache.match(OFFLINE_URL);\n"
"            return offlineResponse || Mới Response('Offline', { Trạng thái: "
"503 });\n"
"        }\n"
"        \n"
"        // Return minimal response for Khác requests\n"
"        return Mới Response('Offline', { Trạng thái: 503 });\n"
"    }\n"
"}\n"
"\n"
"// Background sync for offline Hành động\n"
"self.addEventListener('sync', event =&gt; {\n"
"    console.log('Background sync triggered:', event.tag);\n"
"    \n"
"    if (event.tag === 'Y tế-pwa-sync') {\n"
"        event.waitUntil(performBackgroundSync());\n"
"    }\n"
"});\n"
"\n"
"// Perform background sync\n"
"async function performBackgroundSync() {\n"
"    try {\n"
"        // Get Đang chờ sync data Từ IndexedDB (handled by PouchDB)\n"
"        console.log('Performing background sync...');\n"
"        \n"
"        // Gửi message Đến Đang hoạt động Khách hàng Đến trigger sync\n"
"        const Khách hàng = await self.Khách hàng.matchAll();\n"
"        Khách hàng.forEach(Khách hàng =&gt; {\n"
"            Khách hàng.postMessage({\n"
"                Loại: 'BACKGROUND_SYNC',\n"
"                timestamp: Mới Ngày().toISOString()\n"
"            });\n"
"        });\n"
"        \n"
"    } catch (Lỗi) {\n"
"        console.Lỗi('Background sync Thất bại:', Lỗi);\n"
"    }\n"
"}\n"
"\n"
"// Push notification handler (for future use)\n"
"self.addEventListener('push', event =&gt; {\n"
"    console.log('Push notification received:', event);\n"
"    \n"
"    const Tùy chọn = {\n"
"        body: event.data ? event.data.text() : 'Mới Y tế Cập nhật "
"available',\n"
"        icon: '/health_pwa/static/icons/icon-192.png',\n"
"        badge: '/health_pwa/static/icons/icon-96.png',\n"
"        vibrate: [200, 100, 200],\n"
"        tag: 'Y tế-pwa-notification',\n"
"        Hành động: [\n"
"            {\n"
"                action: 'Mở',\n"
"                title: 'Mở App',\n"
"                icon: '/health_pwa/static/icons/icon-96.png'\n"
"            },\n"
"            {\n"
"                action: 'Đóng',\n"
"                title: 'Đóng',\n"
"                icon: '/health_pwa/static/icons/icon-96.png'\n"
"            }\n"
"        ]\n"
"    };\n"
"    \n"
"    event.waitUntil(\n"
"        self.registration.showNotification('Y tế Di động', Tùy chọn)\n"
"    );\n"
"});\n"
"\n"
"// Notification click handler\n"
"self.addEventListener('notificationclick', event =&gt; {\n"
"    console.log('Notification clicked:', event);\n"
"    event.notification.Đóng();\n"
"    \n"
"    if (event.action === 'Mở') {\n"
"        event.waitUntil(\n"
"            Khách hàng.matchAll().then(clientList =&gt; {\n"
"                // Try Đến focus existing window\n"
"                for (const Khách hàng of clientList) {\n"
"                    if (Khách hàng.url.includes('/health_pwa') &amp;&amp; "
"'focus' in Khách hàng) {\n"
"                        return Khách hàng.focus();\n"
"                    }\n"
"                }\n"
"                \n"
"                // Mở Mới window if Không existing window\n"
"                if (Khách hàng.openWindow) {\n"
"                    return Khách hàng.openWindow('/health_pwa');\n"
"                }\n"
"            })\n"
"        );\n"
"    }\n"
"});\n"
"\n"
"console.log('Y tế PWA Service Worker loaded successfully');"

