<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_redinvoice_pdf_preview_wizard" model="ir.ui.view">
        <field name="name">redinvoice.pdf.preview.wizard.form</field>
        <field name="model">redinvoice.pdf.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Red Invoice PDF" create="0" edit="0">
                <field name="pdf_url" widget="redinvoice_pdf_frame" nolabel="1"/>
                <footer>
                    <button string="Download" type="object" name="action_download" class="btn-primary"/>
                    <button string="Email to Client" type="object" name="action_email_client" class="btn-secondary"/>
                    <button string="Print" type="object" name="action_print" class="btn-secondary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
