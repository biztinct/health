<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Healthcare Invoices List to add Red Invoice State column -->
    <record id="view_healthcare_invoices_list_redinvoice" model="ir.ui.view">
        <field name="name">Healthcare Invoices List - Red Invoice Extension</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="health_invoicing.view_healthcare_invoices_list"/>
        <field name="arch" type="xml">
            <!-- Add Red Invoice State column and quick action after payment_state -->
            <xpath expr="//field[@name='payment_state']" position="after">
                <field name="red_invoice_state" widget="badge"
                       decoration-success="red_invoice_state=='issued'"
                       decoration-warning="red_invoice_state=='pending'"
                       decoration-info="red_invoice_state=='issuing'"
                       decoration-danger="red_invoice_state=='failed'"
                       decoration-muted="red_invoice_state in ('not_required', 'cancelled')"
                       string="Red Invoice Status"
                       optional="hide"/>
                <field name="red_invoice_pdf_attachment_id"
                       string="Red Invoice PDF"
                       optional="hide"/>
                <field name="red_invoice_download_attachment_id"
                       string="Red Invoice File"
                       optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Healthcare Invoices Search to add Red Invoice filters -->
    <record id="view_healthcare_invoices_filter_redinvoice" model="ir.ui.view">
        <field name="name">Healthcare Invoices Search - Red Invoice Extension</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="health_invoicing.view_healthcare_invoices_filter"/>
        <field name="arch" type="xml">
            <!-- Inject simple red-invoice filters into the search view -->
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="red_invoice_issued" string="Red Invoice Issued"
                        domain="[('red_invoice_state', '=', 'issued')]"/>
                <filter name="red_invoice_pending" string="Red Invoice Pending"
                        domain="[('red_invoice_state', '=', 'pending')]"/>
                <filter name="red_invoice_failed" string="Red Invoice Failed"
                        domain="[('red_invoice_state', '=', 'failed')]"/>
                <filter string="Red Invoice State" domain="[]" context="{'group_by': 'red_invoice_state'}" name="group_by_red_invoice_state"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_redinvoice" model="ir.ui.view">
        <field name="name">account.move.form.redinvoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="red_invoice_enabled" invisible="1"/>
                <button name="action_redinvoice_generate" type="object" string="Generate Red Invoice"
                        class="btn-primary"
                        invisible="not red_invoice_enabled or move_type not in ('out_invoice','out_refund') or state != 'posted' or red_invoice_state == 'issued'"/>
                <button name="action_redinvoice_download_zip" type="object" string="Download Red Invoice"
                        class="btn-secondary"
                        invisible="not red_invoice_enabled or red_invoice_state != 'issued' or move_type not in ('out_invoice','out_refund')"/>
                <!-- 'Download PDF' (converted/exchange invoice) hidden for now; use the
                     representation PDF via 'Open Red Invoice'. -->
                <button name="action_open_red_invoice_pdf" type="object" string="Open Red Invoice"
                        class="btn-secondary"
                        invisible="not red_invoice_enabled or red_invoice_state != 'issued' or move_type not in ('out_invoice','out_refund')"/>
                <!-- Cancelling an ISSUED red invoice is a filing event with the tax
                     authority, not an edit: it calls Viettel's
                     cancelTransactionInvoice against a document the buyer may
                     already hold. It was reachable by anyone who could open a
                     posted customer invoice. Gated to the group that already
                     exists for exactly this — "Users who can submit invoices to
                     Vietnamese Tax Authorities and manage compliance". -->
                <button name="action_redinvoice_cancel" type="object" string="Cancel Red Invoice"
                        groups="health_invoicing.group_vietnamese_tax_compliance"
                        invisible="not red_invoice_enabled or red_invoice_state != 'issued' or move_type not in ('out_invoice','out_refund')"/>
            </header>

            <notebook position="inside">
                <page string="Red Invoice" name="red_invoice_tab"
                      invisible="not red_invoice_enabled or move_type not in ('out_invoice','out_refund')">
                    <group>
                        <group string="Status">
                            <field name="red_invoice_state" widget="badge"/>
                            <field name="red_invoice_last_sync"/>
                            <field name="red_invoice_last_error" readonly="1"/>
                        </group>
                        <group string="Identifiers">
                            <field name="red_invoice_no"/>
                            <field name="red_invoice_template_code"/>
                            <field name="red_invoice_series"/>
                            <field name="red_invoice_reservation_code"/>
                            <field name="red_invoice_transaction_uuid" readonly="1"/>
                            <field name="red_invoice_transaction_id" readonly="1"/>
                            <field name="red_invoice_code_of_tax" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Payment">
                            <field name="red_invoice_payment_method"/>
                            <field name="red_invoice_payment_method_name"/>
                            <field name="red_invoice_secret_mode"/>
                        </group>
                        <group string="Files">
                            <field name="red_invoice_download_attachment_id"/>
                            <field name="red_invoice_pdf_attachment_id"/>
                            <field name="red_invoice_lookup_url" readonly="1"/>
                        </group>
                    </group>
                </page>
                <page string="Red Invoice Log" name="red_invoice_log"
                      invisible="not red_invoice_enabled or move_type not in ('out_invoice','out_refund')">
                    <field name="red_invoice_request_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="create_date"/>
                            <field name="state"/>
                            <field name="endpoint"/>
                            <field name="response_code"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Red Invoice status badge + PDF icon on the Finance Invoices list -->
    <record id="view_fin_invoice_list_redinvoice" model="ir.ui.view">
        <field name="name">fin.invoice.list.redinvoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="health_invoicing.view_fin_invoice_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_state']" position="after">
                <field name="red_invoice_state" widget="badge" string="Red Invoice"
                       decoration-success="red_invoice_state=='issued'"
                       decoration-danger="red_invoice_state=='failed'"
                       decoration-warning="red_invoice_state=='pending'"
                       decoration-info="red_invoice_state=='issuing'"
                       decoration-muted="red_invoice_state in ('not_required','cancelled')"
                       optional="show"/>
                <button name="action_open_red_invoice_pdf" type="object"
                        icon="/health_redinvoice/static/src/img/red_invoice.svg" title="Open Red Invoice"
                        invisible="red_invoice_state != 'issued'"/>
            </xpath>
        </field>
    </record>

    <!-- Red Invoice status badge + PDF icon on the VAT Invoices Log -->
    <record id="view_vat_log_list_redinvoice" model="ir.ui.view">
        <field name="name">vat.log.list.redinvoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="health_invoicing.view_healthcare_vat_invoice_log_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="red_invoice_state" widget="badge" string="Red Invoice"
                       decoration-success="red_invoice_state=='issued'"
                       decoration-danger="red_invoice_state=='failed'"
                       decoration-warning="red_invoice_state=='pending'"
                       decoration-info="red_invoice_state=='issuing'"
                       decoration-muted="red_invoice_state in ('not_required','cancelled')"
                       optional="show"/>
                <button name="action_open_red_invoice_pdf" type="object"
                        icon="/health_redinvoice/static/src/img/red_invoice.svg" title="Open Red Invoice"
                        invisible="red_invoice_state != 'issued'"/>
            </xpath>
        </field>
    </record>

    <!-- Red Invoice drill-down list (used by the dashboard cards): shows the
         failure reason + Retry / Open PDF actions -->
    <record id="view_redinvoice_drill_list" model="ir.ui.view">
        <field name="name">redinvoice.drill.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Red Invoices" decoration-danger="red_invoice_state=='failed'"
                  decoration-success="red_invoice_state=='issued'"
                  decoration-warning="red_invoice_state in ('pending','issuing')">
                <field name="name" string="Number"/>
                <field name="partner_id" string="Patient"/>
                <field name="invoice_date" string="Date"/>
                <field name="amount_total" string="Total" sum="Total"/>
                <field name="red_invoice_no" string="Red Invoice No" optional="show"/>
                <field name="red_invoice_state" widget="badge" string="Status"
                       decoration-success="red_invoice_state=='issued'"
                       decoration-danger="red_invoice_state=='failed'"
                       decoration-warning="red_invoice_state in ('pending','issuing')"
                       decoration-muted="red_invoice_state in ('not_required','cancelled')"/>
                <field name="red_invoice_last_error" string="Reason"/>
                <button name="action_redinvoice_generate" type="object" icon="fa-refresh"
                        title="Retry / Generate Red Invoice" invisible="red_invoice_state == 'issued'"/>
                <button name="action_open_red_invoice_pdf" type="object" icon="/health_redinvoice/static/src/img/red_invoice.svg"
                        title="Open Red Invoice" invisible="red_invoice_state != 'issued'"/>
                <!-- Record lifecycle: Delete is a user function (posted moves
                     must be reversed first — server gate), Archive custodian. -->
                <field name="deleted" column_invisible="1"/>
                <button name="action_open_delete_wizard" type="object"
                        icon="fa-trash" title="Delete (reason required; posted entries must be reversed first)"
                        invisible="deleted"/>
                <button name="action_open_restore_wizard" type="object"
                        icon="fa-undo" title="Restore this deleted record"
                        groups="health_base.group_healthcare_custodian"
                        invisible="not deleted"/>
                <button name="action_open_archive_wizard" type="object"
                        icon="fa-archive" title="Archive (custodian)"
                        groups="health_base.group_healthcare_custodian"
                        invisible="deleted"/>
            </list>
        </field>
    </record>

    <record id="action_redinvoice_failed" model="ir.actions.act_window">
        <field name="name">Red Invoice — Failed</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type','=','out_invoice'),('red_invoice_state','=','failed')]</field>
        <field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('view_redinvoice_drill_list')})]"/>
    </record>

    <record id="action_redinvoice_pending" model="ir.actions.act_window">
        <field name="name">Red Invoice — Pending</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type','=','out_invoice'),('state','=','posted'),('red_invoice_state','in',['pending','issuing'])]</field>
        <field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('view_redinvoice_drill_list')})]"/>
    </record>

    <record id="action_redinvoice_issued" model="ir.actions.act_window">
        <field name="name">Red Invoice — Issued</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type','=','out_invoice'),('red_invoice_state','=','issued')]</field>
        <field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('view_redinvoice_drill_list')})]"/>
    </record>
</odoo>
