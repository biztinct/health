<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="hr_development_ai.ScoreRing">
    <div class="bfsi-ring" t-attf-style="width:{{size}}px;height:{{size}}px">
        <svg t-att-width="size" t-att-height="size">
            <circle t-att-cx="size/2" t-att-cy="size/2" t-att-r="radius"
                    fill="none" stroke="#EEF0F6" t-att-stroke-width="thickness"/>
            <circle t-att-cx="size/2" t-att-cy="size/2" t-att-r="radius"
                    fill="none" t-att-stroke="color" t-att-stroke-width="thickness"
                    stroke-linecap="round"
                    t-att-stroke-dasharray="circumference"
                    t-att-stroke-dashoffset="offset"
                    t-attf-style="transform:rotate(-90deg);transform-origin:center;transition:stroke-dashoffset .6s cubic-bezier(.16,1,.3,1)"/>
        </svg>
        <div class="bfsi-ring-val" t-attf-style="font-size:{{fontSize}}px">
            <t t-esc="Math.round(props.value || 0)"/>
        </div>
        <div t-if="props.label" class="bfsi-ring-label"><t t-esc="props.label"/></div>
    </div>
</t>

</templates>
