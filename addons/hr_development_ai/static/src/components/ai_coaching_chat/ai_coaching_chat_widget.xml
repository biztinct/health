<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_development_ai.AiCoachingChatWidget">
        <t t-if="!props.record">
            <div class="alert alert-info">Loading...</div>
        </t>
        <div t-else="" class="ai-coaching-chat-widget" t-att-class="{ 'expanded': state.isExpanded }">
            <!-- Widget Header -->
            <div class="chat-header">
                <div class="chat-title">
                    <i class="fa fa-robot me-2"/>
                    <span>AI Coach</span>
                </div>
                <div class="chat-actions">
                    <button
                        t-if="supportsSummary"
                        class="btn btn-sm btn-secondary"
                        t-on-click="generateSummary"
                        t-att-disabled="state.isLoading"
                        title="Generate Summary">
                        <i class="fa fa-magic"/>
                    </button>
                    <button
                        class="btn btn-sm btn-secondary"
                        t-on-click="clearChat"
                        t-att-disabled="state.isLoading"
                        title="Clear Chat">
                        <i class="fa fa-trash"/>
                    </button>
                    <button
                        class="btn btn-sm btn-secondary"
                        t-on-click="toggleExpanded"
                        title="Toggle Size">
                        <i t-att-class="state.isExpanded ? 'fa fa-compress' : 'fa fa-expand'"/>
                    </button>
                </div>
            </div>

            <!-- Chat Messages -->
            <div class="chat-messages">
                <t t-if="state.messages.length === 0">
                    <div class="chat-empty-state">
                        <i class="fa fa-comments fa-3x mb-3"/>
                        <p>Start a conversation with your AI coach</p>
                        <p class="text-muted">Ask questions, discuss goals, or get guidance</p>
                    </div>
                </t>

                <t t-else="">
                    <t t-foreach="state.messages" t-as="message" t-key="message_index">
                        <div class="chat-message" t-att-class="message.role">
                            <div class="message-avatar">
                                <i t-if="message.role === 'user'" class="fa fa-user"/>
                                <i t-else="" class="fa fa-robot"/>
                            </div>
                            <div class="message-content">
                                <div class="message-bubble">
                                    <t t-esc="message.content"/>
                                </div>
                                <div class="message-time">
                                    <t t-esc="formatTime(message.timestamp)"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- Loading Indicator -->
                <t t-if="state.isLoading">
                    <div class="chat-message assistant">
                        <div class="message-avatar">
                            <i class="fa fa-robot"/>
                        </div>
                        <div class="message-content">
                            <div class="message-bubble">
                                <div class="typing-indicator">
                                    <span/>
                                    <span/>
                                    <span/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- Scroll anchor -->
                <div t-ref="chatEnd"/>
            </div>

            <!-- Chat Input -->
            <div class="chat-input">
                <textarea
                    class="form-control"
                    rows="2"
                    placeholder="Type your message..."
                    t-model="state.inputMessage"
                    t-on-keydown="onKeydown"
                    t-att-disabled="state.isLoading"/>
                <button
                    class="btn btn-primary"
                    t-on-click="sendMessage"
                    t-att-disabled="state.isLoading or !state.inputMessage.trim()">
                    <i class="fa fa-paper-plane"/>
                </button>
            </div>
        </div>
    </t>

</templates>
