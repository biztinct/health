<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- AI Coaching Wizard Form View -->
    <record id="view_ai_coaching_wizard_form" model="ir.ui.view">
        <field name="name">ai.coaching.wizard.form</field>
        <field name="model">ai.coaching.wizard</field>
        <field name="arch" type="xml">
            <form string="AI Coaching Chat">
                <sheet>
                    <div class="oe_title">
                        <h1>AI Coaching Session</h1>
                        <h3>
                            For: <field name="employee_id" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="topic"/>
                            <field name="ai_provider" readonly="1"/>
                        </group>
                    </group>
                    <group col="1">
                        <field name="ai_transcript" invisible="1"/>
                        <field name="user_message" invisible="1"/>
                        <widget name="ai_coaching_chat_form"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Save as Session" type="object" name="action_save_as_session" class="btn-secondary" invisible="not ai_transcript"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- AI Coaching Wizard Action -->
    <record id="action_ai_coaching_wizard" model="ir.actions.act_window">
        <field name="name">AI Coaching Chat</field>
        <field name="res_model">ai.coaching.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
