<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <record id="group_hr_development_user" model="res.groups">
        <field name="name">HR Development / User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_hr_development_manager" model="res.groups">
        <field name="name">HR Development / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_hr_development_user'))]"/>
    </record>

    <record id="group_hr_development_admin" model="res.groups">
        <field name="name">HR Development / Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_hr_development_manager')), (4, ref('hr.group_hr_manager'))]"/>
    </record>

    <!-- BFSI Performance Coaching Groups -->
    <record id="group_bfsi_banker" model="res.groups">
        <field name="name">BFSI / Banker</field>
        <field name="implied_ids" eval="[(4, ref('group_hr_development_user'))]"/>
    </record>

    <record id="group_bfsi_branch_manager" model="res.groups">
        <field name="name">BFSI / Branch Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_bfsi_banker'))]"/>
    </record>

    <record id="group_bfsi_regional_manager" model="res.groups">
        <field name="name">BFSI / Regional Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_bfsi_branch_manager'))]"/>
    </record>

</odoo>
