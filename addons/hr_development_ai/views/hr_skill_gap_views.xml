<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_skill_gap_form" model="ir.ui.view">
        <field name="name">hr.skill.gap.form</field>
        <field name="model">hr.skill.gap</field>
        <field name="arch" type="xml">
            <form string="Skill Gap">
                <header>
                    <button name="action_view_recommended_courses" string="View Recommended Courses" type="object" class="oe_highlight" invisible="not recommended_courses"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="skill_id" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="employee_id" readonly="1"/> → <field name="job_id" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Current vs Required">
                            <field name="current_score" widget="progressbar"/>
                            <field name="required_score" widget="progressbar"/>
                            <field name="gap_score"/>
                            <field name="gap_percentage" widget="progressbar"/>
                        </group>
                        <group string="Gap Assessment">
                            <field name="is_required"/>
                            <field name="priority" widget="priority"/>
                            <field name="estimated_time_to_close"/>
                            <field name="analysis_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="AI Recommendations">
                            <group>
                                <field name="recommended_actions" placeholder="AI-generated recommendations..." colspan="2"/>
                            </group>
                            <field name="recommended_courses">
                                <list>
                                    <field name="name"/>
                                    <field name="total_slides"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_skill_gap_list" model="ir.ui.view">
        <field name="name">hr.skill.gap.list</field>
        <field name="model">hr.skill.gap</field>
        <field name="arch" type="xml">
            <list string="Skill Gaps" decoration-danger="status == 'major_gap'" decoration-warning="status == 'minor_gap'" decoration-success="status == 'meets'">
                <field name="employee_id"/>
                <field name="skill_id"/>
                <field name="job_id"/>
                <field name="gap_score"/>
                <field name="status"/>
                <field name="priority" widget="priority"/>
                <field name="is_required"/>
            </list>
        </field>
    </record>

    <!-- Search view removed - relying on Odoo's automatic search view generation -->

    <record id="action_hr_skill_gap" model="ir.actions.act_window">
        <field name="name">Skill Gaps</field>
        <field name="res_model">hr.skill.gap</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No skill gaps found
            </p>
            <p>
                Run skill gap analysis to identify development needs.
            </p>
        </field>
    </record>

    <!-- hr.job.skill Views -->
    <record id="view_hr_job_skill_form" model="ir.ui.view">
        <field name="name">hr.job.skill.form</field>
        <field name="model">hr.job.skill</field>
        <field name="arch" type="xml">
            <form string="Job Skill Requirement">
                <sheet>
                    <group>
                        <group>
                            <field name="job_id"/>
                            <field name="skill_id"/>
                            <field name="required_level_id"/>
                        </group>
                        <group>
                            <field name="required_score" widget="progressbar"/>
                            <field name="is_required"/>
                            <field name="weight"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="How this skill is used in this role..." colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_job_skill_list" model="ir.ui.view">
        <field name="name">hr.job.skill.list</field>
        <field name="model">hr.job.skill</field>
        <field name="arch" type="xml">
            <list string="Job Skill Requirements" editable="bottom">
                <field name="job_id"/>
                <field name="skill_id"/>
                <field name="required_level_id"/>
                <field name="required_score" widget="progressbar"/>
                <field name="is_required" widget="boolean_toggle"/>
                <field name="weight"/>
            </list>
        </field>
    </record>

</odoo>
