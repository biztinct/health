<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Learning Path Form View -->
    <record id="view_hr_learning_path_form" model="ir.ui.view">
        <field name="name">hr.learning.path.form</field>
        <field name="model">hr.learning.path</field>
        <field name="arch" type="xml">
            <form string="Learning Path">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_enroll_employee" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="enrollment_count" widget="statinfo" string="Enrollments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="o_text_overflow" placeholder="Learning Path Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="category"/>
                            <field name="level"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Statistics">
                            <field name="item_count"/>
                            <field name="total_duration" widget="integer"/>
                            <field name="is_ai_recommended" widget="boolean_toggle"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe what employees will learn in this path..."/>
                    </group>
                    <notebook>
                        <page string="Learning Items" name="items">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="course_id"/>
                                    <field name="is_mandatory" widget="boolean_toggle"/>
                                    <field name="estimated_duration"/>
                                    <field name="prerequisite_item_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                        <page string="Skills Developed" name="skills">
                            <field name="skill_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="employee_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Enrollments" name="enrollments">
                            <field name="enrollment_ids">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="start_date"/>
                                    <field name="target_completion_date"/>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-info="state == 'in_progress'" decoration-warning="state == 'on_hold'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- Learning Path List View -->
    <record id="view_hr_learning_path_list" model="ir.ui.view">
        <field name="name">hr.learning.path.list</field>
        <field name="model">hr.learning.path</field>
        <field name="arch" type="xml">
            <list string="Learning Paths">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="level"/>
                <field name="item_count"/>
                <field name="total_duration"/>
                <field name="enrollment_count"/>
                <field name="is_ai_recommended" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Learning Path Kanban View -->
    <record id="view_hr_learning_path_kanban" model="ir.ui.view">
        <field name="name">hr.learning.path.kanban</field>
        <field name="model">hr.learning.path</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="category"/>
                <field name="level"/>
                <field name="item_count"/>
                <field name="total_duration"/>
                <field name="enrollment_count"/>
                <field name="is_ai_recommended"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary"><field name="name"/></div>
                                    <div class="o_secondary">
                                        <span class="badge" t-att-class="record.category.raw_value == 'technical' ? 'text-bg-primary' : record.category.raw_value == 'leadership' ? 'text-bg-success' : 'text-bg-info'">
                                            <field name="category"/>
                                        </span>
                                        <span class="badge text-bg-secondary ms-1">
                                            <field name="level"/>
                                        </span>
                                        <span t-if="record.is_ai_recommended.raw_value" class="badge text-bg-warning ms-1">
                                            AI Recommended
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_card_content">
                                <div class="row">
                                    <div class="col-6">
                                        <field name="item_count"/> courses
                                    </div>
                                    <div class="col-6">
                                        <field name="total_duration"/> hours
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_card_footer">
                                <field name="enrollment_count"/> enrollments
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search view removed - relying on Odoo's automatic search view generation -->

    <!-- Learning Path Action -->
    <record id="action_hr_learning_path" model="ir.actions.act_window">
        <field name="name">Learning Paths</field>
        <field name="res_model">hr.learning.path</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Learning Path
            </p>
            <p>
                Learning paths are structured sequences of courses designed to develop specific skills.
            </p>
        </field>
    </record>

    <!-- Learning Enrollment Form View -->
    <record id="view_hr_learning_enrollment_form" model="ir.ui.view">
        <field name="name">hr.learning.enrollment.form</field>
        <field name="model">hr.learning.enrollment</field>
        <field name="arch" type="xml">
            <form string="Learning Enrollment">
                <header>
                    <button name="action_start" string="Start Learning" type="object" class="oe_highlight" invisible="state != 'enrolled'"/>
                    <button name="action_complete" string="Mark Complete" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_put_on_hold" string="Put On Hold" type="object" invisible="state not in ['enrolled', 'in_progress']"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ['completed', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="enrolled,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="learning_path_name" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="employee_id"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Enrollment Details">
                            <field name="learning_path_id" readonly="state in ['completed', 'cancelled']"/>
                            <field name="enrollment_source"/>
                            <field name="start_date"/>
                            <field name="target_completion_date"/>
                        </group>
                        <group string="Progress">
                            <field name="progress" widget="progressbar"/>
                            <field name="completed_items"/>
                            <field name="total_items"/>
                            <field name="actual_completion_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Add notes about this enrollment..."/>
                    </group>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- Learning Enrollment List View -->
    <record id="view_hr_learning_enrollment_list" model="ir.ui.view">
        <field name="name">hr.learning.enrollment.list</field>
        <field name="model">hr.learning.enrollment</field>
        <field name="arch" type="xml">
            <list string="Enrollments" decoration-success="state == 'completed'" decoration-info="state == 'in_progress'" decoration-muted="state == 'cancelled'">
                <field name="employee_id"/>
                <field name="learning_path_name"/>
                <field name="start_date"/>
                <field name="target_completion_date"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge" decoration-success="state == 'completed'" decoration-info="state == 'in_progress'" decoration-warning="state == 'on_hold'"/>
                <field name="enrollment_source" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Learning Enrollment Kanban View -->
    <record id="view_hr_learning_enrollment_kanban" model="ir.ui.view">
        <field name="name">hr.learning.enrollment.kanban</field>
        <field name="model">hr.learning.enrollment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="employee_id"/>
                <field name="learning_path_name"/>
                <field name="progress"/>
                <field name="state"/>
                <field name="start_date"/>
                <field name="target_completion_date"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary"><field name="employee_id"/></div>
                                    <div class="o_secondary"><field name="learning_path_name"/></div>
                                </div>
                            </div>
                            <div class="o_kanban_card_content">
                                <div class="mb-2">
                                    <field name="progress" widget="progressbar"/>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        Started: <field name="start_date"/>
                                    </div>
                                    <div class="col-6">
                                        Target: <field name="target_completion_date"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_card_footer">
                                <field name="state" widget="label" decoration-success="state == 'completed'" decoration-info="state == 'in_progress'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search view removed - relying on Odoo's automatic search view generation -->

    <!-- Learning Enrollment Action -->
    <record id="action_hr_learning_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">hr.learning.enrollment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No enrollments found
            </p>
            <p>
                Enroll employees in learning paths to track their progress and development.
            </p>
        </field>
    </record>

</odoo>
