<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- hr.skill.category Views -->
    <record id="view_hr_skill_category_form" model="ir.ui.view">
        <field name="name">hr.skill.category.form</field>
        <field name="model">hr.skill.category</field>
        <field name="arch" type="xml">
            <form string="Skill Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="skill_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Description of this skill category..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_skill_category_list" model="ir.ui.view">
        <field name="name">hr.skill.category.list</field>
        <field name="model">hr.skill.category</field>
        <field name="arch" type="xml">
            <list string="Skill Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="skill_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- hr.skill.level Views -->
    <record id="view_hr_skill_level_form" model="ir.ui.view">
        <field name="name">hr.skill.level.form</field>
        <field name="model">hr.skill.level</field>
        <field name="arch" type="xml">
            <form string="Skill Level">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="level_value"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="What this proficiency level means..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_skill_level_list" model="ir.ui.view">
        <field name="name">hr.skill.level.list</field>
        <field name="model">hr.skill.level</field>
        <field name="arch" type="xml">
            <list string="Skill Levels" default_order="level_value">
                <field name="level_value"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- hr.skill Views -->
    <record id="view_hr_skill_form" model="ir.ui.view">
        <field name="name">hr.skill.form</field>
        <field name="model">hr.skill</field>
        <field name="arch" type="xml">
            <form string="Skill">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_employees" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="employee_count" widget="statinfo" string="Employees"/>
                        </button>
                        <button name="action_view_courses" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Courses</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Skill Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="avg_proficiency" widget="progressbar"/>
                            <field name="demand_score"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Detailed description of this skill..."/>
                        </page>
                        <page string="Related Courses">
                            <field name="course_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="total_slides"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_skill_list" model="ir.ui.view">
        <field name="name">hr.skill.list</field>
        <field name="model">hr.skill</field>
        <field name="arch" type="xml">
            <list string="Skills">
                <field name="name"/>
                <field name="category_id"/>
                <field name="employee_count"/>
                <field name="avg_proficiency" widget="progressbar"/>
                <field name="demand_score"/>
            </list>
        </field>
    </record>

    <record id="view_hr_skill_kanban" model="ir.ui.view">
        <field name="name">hr.skill.kanban</field>
        <field name="model">hr.skill</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="category_id"/>
                <field name="employee_count"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="category_id"/>
                                <div><t t-esc="record.employee_count.value"/> employees</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search view removed - using base hr.skill search view -->

    <record id="action_hr_skill" model="ir.actions.act_window">
        <field name="name">Skills Library</field>
        <field name="res_model">hr.skill</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new skill
            </p>
            <p>
                Build your skills taxonomy to track employee capabilities.
            </p>
        </field>
    </record>

    <record id="action_hr_skill_category" model="ir.actions.act_window">
        <field name="name">Skill Categories</field>
        <field name="res_model">hr.skill.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_hr_skill_level" model="ir.actions.act_window">
        <field name="name">Skill Levels</field>
        <field name="res_model">hr.skill.level</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
