<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Performance KPI Views -->
    <record id="view_bfsi_performance_kpi_list" model="ir.ui.view">
        <field name="name">bfsi.performance.kpi.list</field>
        <field name="model">bfsi.performance.kpi</field>
        <field name="arch" type="xml">
            <list string="Performance KPIs" decoration-danger="coaching_priority == 'critical'" decoration-warning="coaching_priority == 'high'" default_order="period_date desc">
                <field name="period_date"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="branch_id"/>
                <field name="overall_score" widget="badge" decoration-danger="overall_score &lt; 40" decoration-warning="overall_score &lt; 60" decoration-success="overall_score &gt;= 80"/>
                <field name="branch_rank"/>
                <field name="rank_movement"/>
                <field name="revenue" widget="monetary"/>
                <field name="conversions"/>
                <field name="coaching_session_count" string="Sessions" optional="show"/>
                <field name="coaching_priority" widget="badge" decoration-danger="coaching_priority == 'critical'" decoration-warning="coaching_priority == 'high'" decoration-info="coaching_priority == 'medium'" decoration-success="coaching_priority == 'low'"/>
            </list>
        </field>
    </record>

    <record id="view_bfsi_performance_kpi_form" model="ir.ui.view">
        <field name="name">bfsi.performance.kpi.form</field>
        <field name="model">bfsi.performance.kpi</field>
        <field name="arch" type="xml">
            <form string="Performance KPI">
                <header>
                    <button name="action_generate_ai_analysis" type="object" string="Generate AI Analysis" class="btn-primary" icon="fa-magic"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-trophy">
                            <field name="branch_rank" widget="statinfo" string="Branch Rank"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-arrow-up" invisible="rank_movement &lt;= 0">
                            <field name="rank_movement" widget="statinfo" string="Improved"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-arrow-down" invisible="rank_movement &gt;= 0">
                            <field name="rank_movement" widget="statinfo" string="Dropped"/>
                        </button>
                    </div>

                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="activity"/>
                            <div>
                                <span>Performance Overview</span>
                                <small class="text-muted d-block">Banker details, period, and overall score</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="id-card"/>
                                    <span>Record Info</span>
                                </div>
                                <group col="2">
                                    <field name="employee_id" widget="many2one_avatar_employee"/>
                                    <field name="branch_id"/>
                                    <field name="period_date"/>
                                    <field name="period_type"/>
                                </group>
                            </div>
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="timeline"/>
                                    <span>Overall Performance</span>
                                </div>
                                <group col="2">
                                    <field name="overall_score" widget="progressbar"/>
                                    <field name="deviation_score"/>
                                    <field name="coaching_priority" widget="badge"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Input KPIs" name="input_kpis">
                            <div class="vu-section-grid">
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="file-text"/>
                                        <span>Call Activity</span>
                                    </div>
                                    <group>
                                        <field name="dials_per_hour"/>
                                        <field name="total_dials"/>
                                        <field name="connects"/>
                                        <field name="connect_rate"/>
                                    </group>
                                </div>
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="calendar"/>
                                        <span>Meetings and Hours</span>
                                    </div>
                                    <group>
                                        <field name="meetings_scheduled"/>
                                        <field name="meetings_conducted"/>
                                        <field name="calls_made"/>
                                        <field name="hours_worked"/>
                                    </group>
                                </div>
                            </div>
                        </page>
                        <page string="Behavior KPIs" name="behavior_kpis">
                            <div class="vu-section-grid">
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="shield-check"/>
                                        <span>Skills and Compliance</span>
                                    </div>
                                    <group>
                                        <field name="script_adherence"/>
                                        <field name="objection_handling_score"/>
                                        <field name="need_analysis_quality"/>
                                    </group>
                                </div>
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="heart-pulse"/>
                                        <span>Knowledge and Satisfaction</span>
                                    </div>
                                    <group>
                                        <field name="product_knowledge_score"/>
                                        <field name="compliance_score"/>
                                        <field name="customer_satisfaction"/>
                                    </group>
                                </div>
                            </div>
                        </page>
                        <page string="Output KPIs" name="output_kpis">
                            <div class="vu-section-grid">
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="activity"/>
                                        <span>Conversions</span>
                                    </div>
                                    <group>
                                        <field name="conversions"/>
                                        <field name="conversion_rate"/>
                                        <field name="products_sold"/>
                                    </group>
                                </div>
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="clipboard-list"/>
                                        <span>Pipeline</span>
                                    </div>
                                    <group>
                                        <field name="appointments_set"/>
                                        <field name="leads_generated"/>
                                        <field name="proposals_submitted"/>
                                    </group>
                                </div>
                            </div>
                        </page>
                        <page string="Outcome KPIs" name="outcome_kpis">
                            <div class="vu-section-grid">
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="credit-card"/>
                                        <span>Revenue and Commission</span>
                                    </div>
                                    <group>
                                        <field name="revenue" widget="monetary"/>
                                        <field name="commission" widget="monetary"/>
                                    </group>
                                </div>
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="building"/>
                                        <span>Assets and Lending</span>
                                    </div>
                                    <group>
                                        <field name="aum" widget="monetary"/>
                                        <field name="loan_amount" widget="monetary"/>
                                        <field name="premium_collected" widget="monetary"/>
                                    </group>
                                </div>
                            </div>
                        </page>
                        <page string="AI Analysis" name="ai_analysis">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="heart-pulse"/>
                                    <span>AI Performance Analysis</span>
                                </div>
                                <field name="ai_analysis" nolabel="1" placeholder="Click 'Generate AI Analysis' to get insights..."/>
                            </div>
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="book-open"/>
                                    <span>AI Recommendations</span>
                                </div>
                                <field name="ai_recommendations" nolabel="1"/>
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="file-text"/>
                                    <span>Additional Notes</span>
                                </div>
                                <field name="notes" placeholder="Additional notes..."/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <record id="view_bfsi_performance_kpi_search" model="ir.ui.view">
        <field name="name">bfsi.performance.kpi.search</field>
        <field name="model">bfsi.performance.kpi</field>
        <field name="arch" type="xml">
            <search string="Search KPIs">
                <field name="employee_id"/>
                <field name="branch_id"/>
                <field name="period_date"/>
                <separator/>
                <filter name="today" string="Today" domain="[('period_date', '=', context_today())]"/>
                <filter name="this_week" string="This Week" domain="[('period_date', '&gt;=', (context_today() - relativedelta(days=7)))]"/>
                <filter name="this_month" string="This Month" domain="[('period_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter name="critical" string="Critical Priority" domain="[('coaching_priority', '=', 'critical')]"/>
                <filter name="high" string="High Priority" domain="[('coaching_priority', '=', 'high')]"/>
                <filter name="needs_coaching" string="Needs Coaching" domain="[('coaching_priority', 'in', ['high', 'critical'])]"/>
                <group>
                    <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'period_date:month'}"/>
                    <filter name="group_by_priority" string="Coaching Priority" context="{'group_by': 'coaching_priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- KPI Target Views -->
    <record id="view_bfsi_kpi_target_list" model="ir.ui.view">
        <field name="name">bfsi.kpi.target.list</field>
        <field name="model">bfsi.kpi.target</field>
        <field name="arch" type="xml">
            <list string="KPI Targets">
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee" optional="show"/>
                <field name="job_id" optional="show"/>
                <field name="branch_id" optional="show"/>
                <field name="banker_type" optional="hide"/>
                <field name="period_type"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="target_overall_score"/>
                <field name="target_revenue" widget="monetary"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_bfsi_kpi_target_form" model="ir.ui.view">
        <field name="name">bfsi.kpi.target.form</field>
        <field name="model">bfsi.kpi.target</field>
        <field name="arch" type="xml">
            <form string="KPI Target">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="clipboard-list"/>
                            <div>
                                <span>Target Configuration</span>
                                <small class="text-muted d-block">Scope, validity, and priority settings</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="users-group"/>
                                    <span>Target Scope</span>
                                </div>
                                <group col="2">
                                    <field name="employee_id" widget="many2one_avatar_employee"/>
                                    <field name="job_id"/>
                                    <field name="branch_id"/>
                                    <field name="banker_type"/>
                                </group>
                            </div>
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="calendar"/>
                                    <span>Validity</span>
                                </div>
                                <group col="2">
                                    <field name="period_type"/>
                                    <field name="valid_from"/>
                                    <field name="valid_to"/>
                                    <field name="priority"/>
                                    <field name="is_active" widget="boolean_toggle"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Input Targets" name="input_targets">
                            <div class="vu-section-grid">
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="file-text"/>
                                        <span>Call Targets</span>
                                    </div>
                                    <group>
                                        <field name="target_dials_per_hour"/>
                                        <field name="target_total_dials"/>
                                        <field name="target_connects"/>
                                    </group>
                                </div>
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="calendar"/>
                                        <span>Meeting Targets</span>
                                    </div>
                                    <group>
                                        <field name="target_meetings_scheduled"/>
                                        <field name="target_meetings_conducted"/>
                                        <field name="target_calls_made"/>
                                    </group>
                                </div>
                            </div>
                        </page>
                        <page string="Behavior Targets" name="behavior_targets">
                            <div class="vu-section-grid">
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="shield-check"/>
                                        <span>Skills Targets</span>
                                    </div>
                                    <group>
                                        <field name="target_script_adherence"/>
                                        <field name="target_objection_handling"/>
                                        <field name="target_need_analysis"/>
                                    </group>
                                </div>
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="heart-pulse"/>
                                        <span>Quality Targets</span>
                                    </div>
                                    <group>
                                        <field name="target_product_knowledge"/>
                                        <field name="target_compliance"/>
                                        <field name="target_customer_satisfaction"/>
                                    </group>
                                </div>
                            </div>
                        </page>
                        <page string="Output Targets" name="output_targets">
                            <div class="vu-section-grid">
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="activity"/>
                                        <span>Conversion Targets</span>
                                    </div>
                                    <group>
                                        <field name="target_conversions"/>
                                        <field name="target_conversion_rate"/>
                                        <field name="target_products_sold"/>
                                    </group>
                                </div>
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="clipboard-list"/>
                                        <span>Pipeline Targets</span>
                                    </div>
                                    <group>
                                        <field name="target_appointments_set"/>
                                        <field name="target_leads_generated"/>
                                        <field name="target_proposals_submitted"/>
                                        <field name="target_connect_rate"/>
                                    </group>
                                </div>
                            </div>
                        </page>
                        <page string="Outcome Targets" name="outcome_targets">
                            <div class="vu-section-grid">
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="credit-card"/>
                                        <span>Revenue Targets</span>
                                    </div>
                                    <group>
                                        <field name="target_revenue" widget="monetary"/>
                                        <field name="target_commission" widget="monetary"/>
                                        <field name="target_overall_score"/>
                                    </group>
                                </div>
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="building"/>
                                        <span>Asset Targets</span>
                                    </div>
                                    <group>
                                        <field name="target_aum" widget="monetary"/>
                                        <field name="target_loan_amount" widget="monetary"/>
                                        <field name="target_premium" widget="monetary"/>
                                    </group>
                                </div>
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="file-text"/>
                                    <span>Additional Notes</span>
                                </div>
                                <field name="notes" placeholder="Additional notes..."/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bfsi_kpi_target_search" model="ir.ui.view">
        <field name="name">bfsi.kpi.target.search</field>
        <field name="model">bfsi.kpi.target</field>
        <field name="arch" type="xml">
            <search string="Search Targets">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="branch_id"/>
                <filter name="active" string="Active" domain="[('is_active', '=', True)]"/>
                <filter name="daily" string="Daily" domain="[('period_type', '=', 'daily')]"/>
                <filter name="monthly" string="Monthly" domain="[('period_type', '=', 'monthly')]"/>
                <group>
                    <filter name="group_by_job" string="Job Position" context="{'group_by': 'job_id'}"/>
                    <filter name="group_by_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_by_period" string="Period Type" context="{'group_by': 'period_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_bfsi_performance_kpi" model="ir.actions.act_window">
        <field name="name">Performance KPIs</field>
        <field name="res_model">bfsi.performance.kpi</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_date': 1, 'search_default_group_by_employee': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record performance KPIs
            </p>
            <p>Track daily KPIs for bankers to identify coaching opportunities.</p>
        </field>
    </record>

    <record id="action_bfsi_kpi_target" model="ir.actions.act_window">
        <field name="name">KPI Targets</field>
        <field name="res_model">bfsi.kpi.target</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set KPI targets
            </p>
            <p>Define targets by employee, job position, or branch.</p>
        </field>
    </record>

    <!-- Strategic Selection View - Manager selects bankers for coaching -->
    <record id="view_bfsi_strategic_selection_list" model="ir.ui.view">
        <field name="name">bfsi.performance.kpi.strategic.selection</field>
        <field name="model">bfsi.performance.kpi</field>
        <field name="arch" type="xml">
            <list string="Strategic Selection" decoration-danger="coaching_priority == 'critical'" decoration-warning="coaching_priority == 'high'" default_order="coaching_priority desc, overall_score asc">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="branch_id"/>
                <field name="period_date"/>
                <field name="overall_score" widget="badge" decoration-danger="overall_score &lt; 40" decoration-warning="overall_score &lt; 60" decoration-success="overall_score &gt;= 80"/>
                <field name="deviation_score"/>
                <field name="branch_rank"/>
                <field name="coaching_session_count" string="Sessions"/>
                <field name="coaching_priority" widget="badge" decoration-danger="coaching_priority == 'critical'" decoration-warning="coaching_priority == 'high'" decoration-info="coaching_priority == 'medium'" decoration-success="coaching_priority == 'low'"/>
                <button name="%(action_bfsi_coaching_strategy)d" type="action" string="Coach" icon="fa-magic" class="btn-link" context="{'default_banker_id': employee_id}"/>
            </list>
        </field>
    </record>

    <!-- Strategic Selection Action -->
    <record id="action_bfsi_strategic_selection" model="ir.actions.act_window">
        <field name="name">Strategic Selection</field>
        <field name="res_model">bfsi.performance.kpi</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_bfsi_strategic_selection_list"/>
        <field name="context">{'search_default_group_by_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Select Bankers for Coaching
            </p>
            <p>View bankers ranked by AI-identified coaching needs. Click "Coach" to generate a coaching strategy.</p>
        </field>
    </record>

</odoo>
