<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Progress Report Wizard Form -->
    <record id="view_bfsi_progress_wizard_form" model="ir.ui.view">
        <field name="name">bfsi.action.plan.progress.wizard.form</field>
        <field name="model">bfsi.action.plan.progress.wizard</field>
        <field name="arch" type="xml">
            <form string="Report Progress">
                <sheet>
                    <group>
                        <field name="action_plan_id" readonly="1"/>
                    </group>
                    <separator string="Progress Notes"/>
                    <field name="employee_notes"
                           placeholder="Describe what progress you have made on this action plan..."
                           nolabel="1"
                           style="min-height: 100px;"/>
                </sheet>
                <footer>
                    <button string="Submit Progress"
                            name="action_submit_progress"
                            type="object"
                            class="btn-primary"
                            icon="fa-check"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
