    <!-- BFSI Demo Data - Coaching Strategies      -->
    <!-- ========================================= -->

    <record id="coaching_strategy_bob" model="bfsi.coaching.strategy">
        <field name="name">Sales Excellence Coaching - Bob Williams</field>
        <field name="banker_id" ref="employee_banker_bob"/>
        <field name="manager_id" ref="employee_manager_john"/>
        <field name="branch_id" ref="bfsi_branch_downtown"/>
        <field name="state">generated</field>
        <field name="ai_confidence">85</field>
        <field name="performance_summary">&lt;p&gt;Bob is a mid-level performer with potential for improvement. Current overall score: 68%. Main areas for development:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Script adherence: 75% (target: 85%)&lt;/li&gt;
&lt;li&gt;Objection handling: 70% (target: 80%)&lt;/li&gt;
&lt;li&gt;Conversion rate: Below target&lt;/li&gt;
&lt;/ul&gt;</field>
        <field name="root_cause_analysis">&lt;p&gt;Analysis indicates:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Tendency to deviate from script when customer asks unexpected questions&lt;/li&gt;
&lt;li&gt;Lacks confidence in handling price objections&lt;/li&gt;
&lt;li&gt;Good rapport building but struggles to close&lt;/li&gt;
&lt;/ul&gt;</field>
        <field name="strengths">Strong customer rapport
Good product knowledge
Consistent attendance and punctuality
Positive attitude toward coaching</field>
        <field name="improvement_areas">Script adherence
Objection handling
Closing techniques
Time management on calls</field>
        <field name="coaching_themes">Sales fundamentals
Objection handling mastery
Closing techniques</field>
        <field name="ai_strategy">&lt;p&gt;&lt;strong&gt;Recommended Coaching Approach:&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Use a supportive coaching style. Bob responds well to positive reinforcement. Focus on building confidence through role-play practice.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Key Focus Areas:&lt;/strong&gt;&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;Script practice with scenario variations&lt;/li&gt;
&lt;li&gt;Top 5 objection responses&lt;/li&gt;
&lt;li&gt;Assumptive close techniques&lt;/li&gt;
&lt;/ol&gt;</field>
        <field name="session_guide">1. Start with wins - acknowledge recent improvements
2. Review specific call recordings showing script deviation
3. Practice the LAER objection handling method
4. Role-play 3 common scenarios
5. Set specific, measurable weekly goals
6. Schedule follow-up check-in</field>
        <field name="opening_questions">What do you feel went well in your sales calls this week?
When you think about your most successful sale, what made it work?</field>
        <field name="probing_questions">What typically happens when a customer raises a price objection?
Walk me through your thought process when you deviate from the script.
What would help you feel more confident in closing?</field>
        <field name="closing_questions">What specific actions will you commit to this week?
How can I best support you in reaching your targets?</field>
        <field name="coaching_tips">Use call recordings as teaching moments
Celebrate small wins to build confidence
Practice makes perfect - schedule regular role-play sessions</field>
        <field name="roleplay_scenarios">Customer says: "I need to think about it" - Practice the Feel, Felt, Found technique
Customer says: "Your competitor is cheaper" - Practice value-based response
Customer is ready but hesitant - Practice the assumptive close</field>
        <field name="learning_recommendations">Complete Objection Handling Masterclass (online module)
Review top performer call recordings
Practice script variations with peer buddy</field>
    </record>

