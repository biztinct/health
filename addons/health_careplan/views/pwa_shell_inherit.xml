<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inject the Care Plan PWA scripts into the app shell without
         touching health_pwa's template body (health_evv /
         health_vitals pattern). careplan-service.js owns the API
         client + offline tick outbox used by careplan-components.js,
         so order matters. -->
    <template id="app_shell_careplan" inherit_id="health_pwa.app_shell"
              name="Health PWA App Shell — Care Plan Scripts">
        <xpath expr="//script[contains(@t-attf-src, 'js/router.js')]"
               position="after">
            <script t-attf-src="/health_careplan/static/src/js/careplan-service.js?v=#{pwa_asset_version}"></script>
            <script t-attf-src="/health_careplan/static/src/js/careplan-components.js?v=#{pwa_asset_version}"></script>
        </xpath>
    </template>

</odoo>
