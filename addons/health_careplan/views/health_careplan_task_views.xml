<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Task list -->
    <record id="view_health_careplan_task_list" model="ir.ui.view">
        <field name="name">health.careplan.task.list</field>
        <field name="model">health.careplan.task</field>
        <field name="arch" type="xml">
            <list string="Visit Tasks"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'not_done'">
                <field name="fso_id"/>
                <field name="client_id"/>
                <field name="name"/>
                <field name="is_prn" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'not_done'"/>
                <field name="not_done_reason" optional="show"/>
                <field name="completed_by_id"/>
                <field name="completed_datetime"/>
                <field name="careplan_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Task form -->
    <record id="view_health_careplan_task_form" model="ir.ui.view">
        <field name="name">health.careplan.task.form</field>
        <field name="model">health.careplan.task</field>
        <field name="arch" type="xml">
            <form string="Visit Task">
                <header>
                    <button name="action_mark_done" type="object"
                            string="Mark Done" class="btn-primary"
                            invisible="state == 'done'"
                            groups="health_base.group_healthcare_nurse"/>
                    <button name="action_mark_not_done" type="object"
                            string="Mark Not Done"
                            invisible="state == 'not_done'"
                            groups="health_base.group_healthcare_nurse"/>
                    <button name="action_reset_pending" type="object"
                            string="Reset to Pending"
                            invisible="state == 'pending'"
                            groups="health_base.group_healthcare_nurse"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Task">
                            <field name="careplan_id"/>
                            <field name="activity_id"/>
                            <field name="fso_id"/>
                            <field name="client_id"/>
                            <field name="is_prn"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Completion">
                            <field name="not_done_reason"
                                   required="state == 'not_done'"/>
                            <field name="not_done_note"/>
                            <field name="completed_by_id"/>
                            <field name="completed_datetime"/>
                            <field name="catchment_province_id"/>
                        </group>
                    </group>
                    <group string="Instructions">
                        <field name="instructions" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Task search -->
    <record id="view_health_careplan_task_search" model="ir.ui.view">
        <field name="name">health.careplan.task.search</field>
        <field name="model">health.careplan.task</field>
        <field name="arch" type="xml">
            <search string="Visit Tasks">
                <field name="name"/>
                <field name="client_id"/>
                <field name="fso_id"/>
                <field name="careplan_id"/>
                <filter string="Pending" name="pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter string="Done" name="done"
                        domain="[('state', '=', 'done')]"/>
                <filter string="Not Done" name="not_done"
                        domain="[('state', '=', 'not_done')]"/>
                <separator/>
                <filter string="PRN" name="prn"
                        domain="[('is_prn', '=', True)]"/>
                <filter string="Visit" name="group_fso"
                        context="{'group_by': 'fso_id'}"/>
                <filter string="Care Plan" name="group_careplan"
                        context="{'group_by': 'careplan_id'}"/>
                <filter string="Status" name="group_state"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- Task register action (manager+, spec §1.5) -->
    <record id="action_health_careplan_task" model="ir.actions.act_window">
        <field name="name">Visit Tasks</field>
        <field name="res_model">health.careplan.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_health_careplan_task_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No visit tasks yet
            </p>
            <p>
                Tasks compile automatically from active care plans when
                a visit is confirmed.
            </p>
        </field>
    </record>

    <!-- Standalone goal / activity lists (smart-button targets) -->
    <record id="view_health_careplan_goal_list" model="ir.ui.view">
        <field name="name">health.careplan.goal.list</field>
        <field name="model">health.careplan.goal</field>
        <field name="arch" type="xml">
            <list string="Goals">
                <field name="sequence" widget="handle"/>
                <field name="careplan_id" optional="hide"/>
                <field name="client_id" optional="show"/>
                <field name="name"/>
                <field name="vitals_type_id"/>
                <field name="baseline_value"/>
                <field name="target_value_min"/>
                <field name="target_value_max"/>
                <field name="due_date"/>
                <field name="lifecycle_status"/>
                <field name="achievement_status"/>
                <field name="latest_value"/>
                <field name="is_on_target"/>
            </list>
        </field>
    </record>

    <record id="view_health_careplan_activity_list" model="ir.ui.view">
        <field name="name">health.careplan.activity.list</field>
        <field name="model">health.careplan.activity</field>
        <field name="arch" type="xml">
            <list string="Interventions">
                <field name="sequence" widget="handle"/>
                <field name="careplan_id" optional="hide"/>
                <field name="client_id" optional="show"/>
                <field name="name"/>
                <field name="service_type_id"/>
                <field name="frequency"/>
                <field name="frequency_interval"/>
                <field name="visit_filter"/>
                <field name="status"/>
            </list>
        </field>
    </record>

</odoo>
