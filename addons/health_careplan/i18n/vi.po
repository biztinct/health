#. module: health_careplan
msgid "Add at least one goal before activating the plan."
msgstr "Thêm ít nhất một mục tiêu trước khi kích hoạt kế hoạch."

#. module: health_careplan
msgid "Add at least one intervention before activating the plan."
msgstr "Thêm ít nhất một can thiệp trước khi kích hoạt kế hoạch."

#. module: health_careplan
msgid "Set the plan start date before activating."
msgstr "Đặt ngày bắt đầu kế hoạch trước khi kích hoạt."

#. module: health_careplan
msgid "Only a draft care plan can be activated."
msgstr "Chỉ kế hoạch nháp mới có thể kích hoạt."

#. module: health_careplan
msgid "Only an active care plan can be put under review."
msgstr "Chỉ kế hoạch đang hiệu lực mới có thể đưa vào xem xét."

#. module: health_careplan
msgid "Only a care plan under review can be confirmed."
msgstr "Chỉ kế hoạch đang xem xét mới có thể xác nhận."

#. module: health_careplan
msgid "Only an active care plan can be completed."
msgstr "Chỉ kế hoạch đang hiệu lực mới có thể hoàn thành."

#. module: health_careplan
msgid "This care plan cannot be cancelled from its current state."
msgstr "Không thể hủy kế hoạch chăm sóc từ trạng thái hiện tại."

#. module: health_careplan
msgid "Only a cancelled care plan can be reset to draft."
msgstr "Chỉ kế hoạch đã hủy mới có thể đặt lại về nháp."

#. module: health_careplan
msgid "Only head nurses, doctors or managers may change the state of a care plan."
msgstr "Chỉ điều dưỡng trưởng, bác sĩ hoặc quản lý mới được thay đổi trạng thái kế hoạch chăm sóc."

#. module: health_careplan
msgid "Only managers may reset a cancelled care plan."
msgstr "Chỉ quản lý mới được đặt lại kế hoạch đã hủy."

#. module: health_careplan
msgid "End date must be after start date."
msgstr "Ngày kết thúc phải sau ngày bắt đầu."

#. module: health_careplan
msgid "Review cycle must be positive."
msgstr "Chu kỳ xem xét phải là số dương."

#. module: health_careplan
msgid "Frequency interval must be at least 1."
msgstr "Khoảng tần suất phải ít nhất là 1."

#. module: health_careplan
msgid "Times per period must be at least 1."
msgstr "Số lần mỗi chu kỳ phải ít nhất là 1."

#. module: health_careplan
msgid "This activity already has a task on this visit."
msgstr "Hoạt động này đã có nhiệm vụ trong lần khám này."

#. module: health_careplan
msgid "A reason is required to mark a task not done."
msgstr "Cần có lý do để đánh dấu nhiệm vụ không thực hiện."

#. module: health_careplan
msgid "This intervention belongs to a different client."
msgstr "Can thiệp này thuộc về khách hàng khác."

#. module: health_careplan
msgid "The care plan of this intervention is not active."
msgstr "Kế hoạch chăm sóc của can thiệp này không còn hiệu lực."

#. module: health_careplan
msgid "Care plan review due: %s"
msgstr "Đến hạn xem xét kế hoạch chăm sóc: %s"

#. module: health_careplan
