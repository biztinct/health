msgid "Task marked done"
msgstr "Đã đánh dấu hoàn thành"

#. module: health_careplan
msgid "Task marked not done"
msgstr "Đã đánh dấu không thực hiện"

#. module: health_careplan
msgid "Task reset to pending"
msgstr "Đã đặt lại chờ thực hiện"

#. module: health_careplan
msgid "Invalid state: %s"
msgstr "Trạng thái không hợp lệ: %s"

#. module: health_careplan
msgid "Open care-plan tasks remain on this visit."
