<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Payroll Analytics Security Groups -->
    <record id="group_payroll_analytics_user" model="res.groups">
        <field name="name">Payroll Analytics User</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('pb_hr_payroll_base.group_payroll_base_user'))]"/>
        <field name="comment">Can view payroll analytics and reports</field>
    </record>
    
    <record id="group_payroll_analytics_manager" model="res.groups">
        <field name="name">Payroll Analytics Manager</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('group_payroll_analytics_user')), (4, ref('pb_hr_payroll_base.group_payroll_base_manager'))]"/>
        <field name="comment">Can manage payroll analytics, approve payrolls, and export bank files</field>
    </record>
    
    <record id="group_payroll_final_approver" model="res.groups">
        <field name="name">Payroll Final Approver</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('group_payroll_analytics_manager'))]"/>
        <field name="comment">Can perform final approval of payroll batches</field>
    </record>
    
    <!-- Record Rules -->
    <record id="payroll_analytics_rule_user" model="ir.rule">
        <field name="name">Payroll Analytics: User Access</field>
        <field name="model_id" ref="model_payroll_analytics"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('state', 'in', ['ready', 'approved'])]</field>
        <field name="groups" eval="[(4, ref('group_payroll_analytics_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <record id="payroll_analytics_rule_manager" model="ir.rule">
        <field name="name">Payroll Analytics: Manager Access</field>
        <field name="model_id" ref="model_payroll_analytics"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_payroll_analytics_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    
    <!-- Approval Rules -->
    <record id="payroll_analytics_approval_rule" model="ir.rule">
        <field name="name">Payroll Analytics: Final Approval</field>
        <field name="model_id" ref="model_payroll_analytics"/>
        <field name="domain_force">[('state', '=', 'ready')]</field>
        <field name="groups" eval="[(4, ref('group_payroll_final_approver'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
</odoo>