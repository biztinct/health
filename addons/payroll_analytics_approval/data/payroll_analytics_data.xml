<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Default Analytics Settings -->
    <record id="default_analytics_settings" model="payroll.analytics.settings">
        <field name="name">Default Analytics Settings</field>
        <field name="variance_threshold">10.0</field>
        <field name="anomaly_detection_enabled">True</field>
        <field name="auto_generate_analytics">True</field>
        <field name="email_notifications">True</field>
        <field name="chart_library">chartjs</field>
    </record>
    
