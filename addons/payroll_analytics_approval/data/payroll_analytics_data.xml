    <!-- Default Dashboard Tiles Configuration -->
    <record id="dashboard_config_indonesia" model="dashboard.tile.config">
        <field name="country">ID</field>
        <field name="tile_type">payroll_approval</field>
        <field name="title">Payroll Approval</field>
        <field name="subtitle">Level 2 Approve</field>
        <field name="icon">fa-gavel</field>
        <field name="action_model">payroll.dashboard</field>
        <field name="action_method">action_open_analytics_dashboard</field>
        <field name="is_active">True</field>
        <field name="sequence">10</field>
    </record>
    
    <record id="dashboard_config_indonesia_bank" model="dashboard.tile.config">
