<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Payroll Analytics Approval Search View -->
    <record id="view_payroll_approval_search" model="ir.ui.view">
        <field name="name">payroll.analytics.approval.search</field>
        <field name="model">payroll.analytics</field>
        <field name="arch" type="xml">
            <search string="Payroll Analytics Search">
                <field name="period_name" string="Period"/>
                <field name="country" string="Country"/>
                <field name="state" string="Status"/>
                <field name="date_from" string="Date From"/>
                <field name="date_to" string="Date To"/>
                <field name="total_employees" string="Total Employees"/>
                <field name="total_payroll" string="Total Payroll"/>
                
                <separator/>
                
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Ready for Approval" name="ready" domain="[('state', '=', 'ready')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Exported" name="exported" domain="[('state', '=', 'exported')]"/>
                
                <separator/>
                
                <filter string="High Variance" name="high_variance" domain="[('variance_percentage', '&gt;', 15)]"/>
                <filter string="Low Variance" name="low_variance" domain="[('variance_percentage', '&lt;', 5)]"/>
                <filter string="Negative Variance" name="negative_variance" domain="[('variance_percentage', '&lt;', 0)]"/>
                
                <separator/>
                
                <filter string="Current Month" name="current_month" 
                        domain="[('date_from', '&gt;=', (context_today - relativedelta(months=1)).strftime('%Y-%m-01')), 
                                 ('date_from', '&lt;', context_today.strftime('%Y-%m-01'))]"/>
                <filter string="This Month" name="this_month" 
                        domain="[('date_from', '&gt;=', context_today.strftime('%Y-%m-01'))]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Country" name="group_country" context="{'group_by': 'country'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'date_from:month'}"/>
                    <filter string="Year" name="group_year" context="{'group_by': 'date_from:year'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Payroll Analytics Tree View for Approval -->
    <record id="view_payroll_approval_tree" model="ir.ui.view">
        <field name="name">payroll.analytics.approval.tree</field>
        <field name="model">payroll.analytics</field>
        <field name="arch" type="xml">
            <tree string="Payroll Analytics - Approval Queue" 
                  decoration-info="state == 'draft'" 
                  decoration-warning="state == 'ready'" 
                  decoration-success="state == 'approved'"
                  decoration-muted="state == 'exported'"
                  default_order="date_from desc, id desc">
                
                <field name="period_name"/>
                <field name="country"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_employees"/>
                <field name="total_payroll" widget="monetary"/>
                <field name="average_salary" widget="monetary"/>
                <field name="variance_percentage" widget="percentage" 
                       decoration-danger="variance_percentage &lt; -10 or variance_percentage &gt; 20"
                       decoration-warning="variance_percentage &lt; -5 or variance_percentage &gt; 10"/>
                <field name="state" widget="badge"/>
                
                <button name="action_open_dashboard" 
                        type="object" 
                        string="Open Dashboard" 
                        class="btn-primary"
                        icon="fa-bar-chart"
                        states="ready,approved"/>
                        
                <button name="action_approve_payroll" 
                        type="object" 
                        string="Approve" 
                        class="btn-success"
                        icon="fa-check"
                        states="ready"
                        confirm="Are you sure you want to approve this payroll?"/>
                        
                <button name="action_export_bank_file" 
                        type="object" 
                        string="Export" 
                        class="btn-info"
                        icon="fa-download"
                        states="approved"/>
                        
                <button name="action_refresh_analytics" 
                        type="object" 
                        string="Refresh Data" 
                        class="btn-secondary"
                        icon="fa-refresh"
                        help="Update analytics with current payslip data"/>
            </tree>
        </field>
    </record>
    
    <!-- Payroll Analytics Kanban View for Visual Approval -->
    <record id="view_payroll_approval_kanban" model="ir.ui.view">
        <field name="name">payroll.analytics.approval.kanban</field>
        <field name="model">payroll.analytics</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="period_name"/>
                <field name="country"/>
                <field name="total_employees"/>
                <field name="total_payroll"/>
                <field name="variance_percentage"/>
                <field name="state"/>
                <field name="date_from"/>
                <field name="date_to"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="period_name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="country"/> • <field name="date_from"/> to <field name="date_to"/>
                                        </div>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown">
                                        <a class="dropdown-toggle o-no-caret btn" data-toggle="dropdown" href="#" role="button" aria-label="Dropdown" aria-haspopup="true" aria-expanded="false">
                                            <span class="fa fa-ellipsis-v" aria-hidden="true"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a t-if="record.state.raw_value == 'ready'" 
                                               name="action_approve_payroll" 
                                               type="object" 
                                               class="dropdown-item">Approve Payroll</a>
                                            <a t-if="record.state.raw_value == 'approved'" 
                                               name="action_export_bank_file" 
                                               type="object" 
                                               class="dropdown-item">Export Bank File</a>
                                            <a name="action_open_dashboard" 
                                               type="object" 
                                               class="dropdown-item">Open Dashboard</a>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="o_kanban_record_body">
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="o_field_widget">
                                                <strong><field name="total_employees"/></strong> Employees
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="o_field_widget">
                                                <strong><field name="total_payroll" widget="monetary"/></strong>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div t-if="record.variance_percentage.raw_value != 0" class="mt-2">
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar" 
                                                 t-attf-class="progress-bar #{record.variance_percentage.raw_value > 0 ? 'bg-success' : 'bg-danger'}"
                                                 t-attf-style="width: #{Math.min(Math.abs(record.variance_percentage.raw_value), 100)}%"/>
                                        </div>
                                        <small t-attf-class="#{record.variance_percentage.raw_value > 0 ? 'text-success' : 'text-danger'}">
                                            <t t-if="record.variance_percentage.raw_value > 0">+</t>
                                            <field name="variance_percentage" widget="percentage"/> vs last month
                                        </small>
                                    </div>
                                </div>
                                
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="state" widget="priority"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <button t-if="record.state.raw_value == 'ready'" 
                                                name="action_open_dashboard" 
                                                type="object" 
                                                class="btn btn-primary btn-sm">
                                            <i class="fa fa-bar-chart"/> Dashboard
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Approval Dashboard Action with Auto-Refresh -->
    <record id="action_payroll_approval_dashboard" model="ir.actions.act_window">
        <field name="name">Payroll Approval Dashboard</field>
        <field name="res_model">payroll.analytics</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
                                      (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_payroll_approval_kanban')}),
                                      (0, 0, {'view_mode': 'tree', 'view_id': ref('view_payroll_approval_tree')}),
                                      (0, 0, {'view_mode': 'form', 'view_id': ref('view_payroll_analytics_dashboard')})]"/>
        <field name="domain">[('state', 'in', ['ready', 'approved'])]</field>
        <field name="context">{'search_default_ready': 1, 'auto_refresh_analytics': 1}</field>
        <field name="limit">50</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No payroll analytics ready for approval!
            </p>
            <p>
                Analytics are automatically generated when payslip batches reach Level 2 approval status.
            </p>
        </field>
    </record>

</odoo>