<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ===================================================================
             Pre-configured Business Domains
             =================================================================== -->

        <!-- Finance Analytics -->
        <record id="domain_finance" model="bi.business.domain">
            <field name="name">Finance Analytics</field>
            <field name="description">Revenue, invoicing, payments, and accounting insights</field>
            <field name="icon">fa-money</field>
            <field name="color">#10b981</field>
            <field name="sequence">10</field>
        </record>

        <!-- Healthcare Analytics -->
        <record id="domain_healthcare" model="bi.business.domain">
            <field name="name">Healthcare Analytics</field>
            <field name="description">Patient appointments, staff assignments, and service delivery</field>
            <field name="icon">fa-heartbeat</field>
            <field name="color">#ef4444</field>
            <field name="sequence">20</field>
        </record>

        <!-- HR &amp; Payroll Analytics -->
        <record id="domain_hr" model="bi.business.domain">
            <field name="name">HR &amp; Payroll Analytics</field>
            <field name="description">Employee metrics, payroll, contracts, and workforce planning</field>
            <field name="icon">fa-users</field>
            <field name="color">#8b5cf6</field>
            <field name="sequence">30</field>
        </record>

        <!-- Sales &amp; CRM Analytics -->
        <record id="domain_sales" model="bi.business.domain">
            <field name="name">Sales &amp; CRM Analytics</field>
            <field name="description">Sales pipeline, quotations, orders, and customer insights</field>
            <field name="icon">fa-line-chart</field>
            <field name="color">#f59e0b</field>
            <field name="sequence">40</field>
        </record>

        <!-- BFSI Performance Analytics -->
        <record id="domain_bfsi" model="bi.business.domain">
            <field name="name">BFSI Performance Analytics</field>
            <field name="description">Banker KPIs, action plans, coaching sessions, and team performance</field>
            <field name="icon">fa-university</field>
            <field name="color">#3b82f6</field>
            <field name="sequence">50</field>
        </record>

        <!-- Advanced — All Models (power users) -->
        <record id="domain_advanced" model="bi.business.domain">
            <field name="name">Advanced — All Models</field>
            <field name="description">Access all available Odoo models (for power users)</field>
            <field name="icon">fa-database</field>
            <field name="color">#6b7280</field>
            <field name="sequence">99</field>
            <field name="group_ids" eval="[(4, ref('bi_studio.group_bi_admin'))]"/>
        </record>

    </data>
</odoo>
