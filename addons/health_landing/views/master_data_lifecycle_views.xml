    <record id="view_admin_lookup_category_lifecycle" model="ir.ui.view">
        <field name="name">admin.lookup.category.lifecycle</field><field name="model">health.lookup.category</field>
        <field name="inherit_id" ref="view_admin_lookup_category_list"/>
