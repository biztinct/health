        <field name="inherit_id" ref="view_admin_cancel_reason_list"/>
        <field name="arch" type="xml"><xpath expr="//list" position="inside"><field name="deleted" column_invisible="1"/></xpath></field>
    </record>
    <record id="view_admin_deletion_reason_lifecycle" model="ir.ui.view">
        <field name="name">admin.deletion.reason.lifecycle</field><field name="model">health.deletion.reason</field>
        <field name="inherit_id" ref="view_admin_deletion_reason_list"/>
        <field name="arch" type="xml"><xpath expr="//list" position="inside"><field name="deleted" column_invisible="1"/></xpath></field>
    </record>

    <!-- Deleted rows remain visible in the management table, while archived
         rows follow Odoo's normal active_test behaviour and disappear. -->
    <record id="action_admin_facilities" model="ir.actions.act_window"><field name="context">{'deleted_test': False}</field></record>
    <record id="action_admin_catchments" model="ir.actions.act_window"><field name="context">{'deleted_test': False}</field></record>
    <record id="action_admin_provinces" model="ir.actions.act_window"><field name="context">{'deleted_test': False}</field></record>
    <record id="action_admin_districts" model="ir.actions.act_window"><field name="context">{'deleted_test': False}</field></record>
    <record id="action_admin_categories" model="ir.actions.act_window"><field name="context">{'deleted_test': False}</field></record>
    <record id="action_admin_contact_reasons" model="ir.actions.act_window"><field name="context">{'deleted_test': False}</field></record>
    <record id="action_admin_lead_reasons" model="ir.actions.act_window"><field name="context">{'deleted_test': False}</field></record>
    <record id="action_admin_referral_sources" model="ir.actions.act_window"><field name="context">{'deleted_test': False}</field></record>
