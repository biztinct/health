    </record>
    <record id="view_admin_lead_reason_lifecycle" model="ir.ui.view">
        <field name="name">admin.lead.reason.lifecycle</field><field name="model">health.lead.reason</field>
        <field name="inherit_id" ref="view_admin_lead_reason_list"/>
        <field name="arch" type="xml"><xpath expr="//list" position="inside"><field name="deleted" column_invisible="1"/></xpath></field>
