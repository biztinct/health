    <record id="view_admin_booking_stage_lifecycle" model="ir.ui.view">
        <field name="name">admin.booking.stage.lifecycle</field><field name="model">health.fieldservice.stage</field>
        <field name="inherit_id" ref="view_admin_booking_stage_list"/>
