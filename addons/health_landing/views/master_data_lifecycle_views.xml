    </record>
    <record id="view_admin_service_category_lifecycle" model="ir.ui.view">
        <field name="name">admin.service.category.lifecycle</field><field name="model">product.category</field>
        <field name="inherit_id" ref="view_admin_service_category_list"/>
        <field name="arch" type="xml"><xpath expr="//list" position="inside"><field name="active" column_invisible="1"/><field name="deleted" column_invisible="1"/></xpath></field>
    </record>
    <record id="view_admin_urgency_lifecycle" model="ir.ui.view">
