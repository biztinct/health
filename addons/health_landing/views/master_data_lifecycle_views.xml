    </record>
    <record id="view_admin_contact_reason_lifecycle" model="ir.ui.view">
        <field name="name">admin.contact.reason.lifecycle</field><field name="model">health.contact.reason</field>
        <field name="inherit_id" ref="view_admin_contact_reason_list"/>
