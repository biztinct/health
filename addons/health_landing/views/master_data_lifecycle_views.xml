    <record id="action_admin_lookup_values" model="ir.actions.act_window"><field name="context">{'deleted_test': False, 'search_default_group_category': 1}</field></record>
    <record id="action_admin_lookup_categories" model="ir.actions.act_window"><field name="context">{'deleted_test': False}</field></record>
</odoo>
