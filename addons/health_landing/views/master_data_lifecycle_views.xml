<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The shared lifecycle controller needs `deleted` in the list payload to
        decide between Delete and Restore for the current selection.  These
        fields stay invisible; the visible buttons are injected globally by
        health_base's lifecycle policy.
    -->
    <record id="view_admin_catchment_lifecycle" model="ir.ui.view">
        <field name="name">admin.catchment.lifecycle</field>
        <field name="model">health.catchment.province</field>
        <field name="inherit_id" ref="view_admin_catchment_list"/>
        <field name="arch" type="xml"><xpath expr="//list" position="inside"><field name="deleted" column_invisible="1"/></xpath></field>
    </record>
    <record id="view_admin_province_lifecycle" model="ir.ui.view">
        <field name="name">admin.province.lifecycle</field><field name="model">health.province</field>
        <field name="inherit_id" ref="view_admin_province_list"/>
        <field name="arch" type="xml"><xpath expr="//list" position="inside"><field name="deleted" column_invisible="1"/></xpath></field>
    </record>
    <record id="view_admin_district_lifecycle" model="ir.ui.view">
        <field name="name">admin.district.lifecycle</field><field name="model">health.vietnamese.district</field>
        <field name="inherit_id" ref="view_admin_district_list"/>
        <field name="arch" type="xml"><xpath expr="//list" position="inside"><field name="deleted" column_invisible="1"/></xpath></field>
    </record>
    <record id="view_admin_category_lifecycle" model="ir.ui.view">
        <field name="name">admin.patient.category.lifecycle</field><field name="model">health.patient.category</field>
        <field name="inherit_id" ref="view_admin_category_list"/>
