        <field name="arch" type="xml"><xpath expr="//list" position="inside"><field name="deleted" column_invisible="1"/></xpath></field>
    </record>
    <record id="view_admin_lost_reason_lifecycle" model="ir.ui.view">
        <field name="name">admin.lost.reason.lifecycle</field><field name="model">crm.lost.reason</field>
        <field name="inherit_id" ref="view_admin_lost_reason_list"/>
        <field name="arch" type="xml"><xpath expr="//list" position="inside"><field name="deleted" column_invisible="1"/></xpath></field>
