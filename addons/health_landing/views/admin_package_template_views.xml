<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Master Data › Care & Services › Package Templates.
         A prepaid package is always sold from a template (product.template,
         type healthcare_package): the template carries the visit count, price,
         service type, location and validity, and many clients buy packages from
         the same one. Until now templates could only be made through the
         generic product form, which the CMS never shows (UAT CT-06, 2026-11-04).
         This form shows only what a package template needs. -->
    <record id="view_admin_package_template_list" model="ir.ui.view">
        <field name="name">admin.package.template.list</field>
        <field name="model">product.template</field>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Package Templates" js_class="admin_model_navigator_view">
                <field name="name" string="Package"/>
                <field name="healthcare_package_type_id" string="Service Type"/>
                <field name="healthcare_service_count" string="Visits"/>
                <field name="list_price" string="Package Price" widget="monetary"/>
                <field name="healthcare_price_per_visit" string="Price per Visit" widget="monetary"/>
                <field name="healthcare_service_location_id" string="Location" optional="show"/>
                <field name="healthcare_package_duration" string="Valid (weeks)" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_admin_package_template_form" model="ir.ui.view">
        <field name="name">admin.package.template.form</field>
        <field name="model">product.template</field>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Package Template">
                <sheet>
                    <field name="type" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Package"/>
                        <h1><field name="name" placeholder="e.g. Three clinic visits"/></h1>
                    </div>
                    <group>
                        <group string="What is included">
                            <field name="healthcare_package_type_id" string="Service Type" required="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="healthcare_service_count" string="Visits" required="1"/>
                            <field name="healthcare_service_location_id" string="Location"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="healthcare_package_duration" string="Valid for (weeks)"/>
                        </group>
                        <group string="Price">
                            <field name="list_price" string="Package Price" widget="monetary" required="1"/>
                            <field name="healthcare_price_per_visit" string="Price per Visit" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Terms">
                        <field name="healthcare_terms" nolabel="1" colspan="2"
                               placeholder="What the client receives, cancellation and refund terms..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_admin_package_templates" model="ir.actions.act_window">
        <field name="name">Package Templates</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type', '=', 'healthcare_package')]</field>
        <field name="context">{'default_type': 'healthcare_package', 'default_sale_ok': True, 'default_purchase_ok': False, 'default_list_price': 0}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_admin_package_template_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_admin_package_template_form')})]"/>
    </record>
</odoo>
