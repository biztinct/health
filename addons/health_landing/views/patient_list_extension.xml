<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit health_base patient kanban and add Dashboard button -->
    <record id="view_health_patient_kanban_hub_spoke" model="ir.ui.view">
        <field name="name">res.partner.patient.kanban.hub.spoke</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="health_base.view_health_patient_kanban"/>
        <field name="arch" type="xml">
            <!-- Replace Schedule button with Dashboard button -->
            <xpath expr="//button[@name='action_create_appointment']" position="replace">
                <button name="action_open_hub_spoke"
                        type="object"
                        class="btn btn-primary btn-sm">
                    <i class="fa fa-tachometer"/> Dashboard
                </button>
            </xpath>
        </field>
    </record>

    <!-- Action to open patient kanban with hub-spoke button -->
    <record id="action_patient_hub_spoke_list" model="ir.actions.act_window">
        <field name="name">Select Patient</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="health_base.view_health_patient_kanban"/>
        <field name="search_view_id" ref="health_base.view_health_patient_search"/>
        <field name="domain">[('is_patient', '=', True)]</field>
        <field name="context">{
            'search_default_active_patients': 1,
            'default_is_patient': True,
            'default_customer_rank': 1,
            'default_patient_status': 'new',
        }</field>
    </record>

</odoo>
