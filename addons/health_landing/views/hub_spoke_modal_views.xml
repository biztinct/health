    <!-- Lead Source Modal View -->
    <record id="view_lead_source_modal" model="ir.ui.view">
        <field name="name">crm.lead.source.modal</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <form string="Lead Source">
                <sheet>
                    <h1>
