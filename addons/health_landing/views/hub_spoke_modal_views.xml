    <!-- Lead Internal Notes Modal View -->
    <record id="view_lead_internal_notes_modal" model="ir.ui.view">
        <field name="name">crm.lead.internal.notes.modal</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <form string="Internal Notes">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/> - Internal Notes
                    </h1>

                    <group>
                        <field name="description" placeholder="Notes"/>
                        <field name="service_requirements"/>
                        <field name="follow_up_notes"/>
