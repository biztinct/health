<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FSO Calendar View for Patient Bookings -->
    <record id="view_fso_bookings_calendar" model="ir.ui.view">
        <field name="name">fso.bookings.calendar</field>
        <field name="model">health.fieldservice.order</field>
        <field name="arch" type="xml">
            <calendar string="Bookings Calendar"
                      date_start="scheduled_datetime"
                      date_stop="estimated_end_datetime"
                      color="lead_staff_id"
                      mode="month"
                      scales="month"
                      quick_create="0"
                      event_open_popup="1"
                      hide_time="true">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="lead_staff_id"
                       filters="1"
                       avatar_field="image_128"/>
                <field name="service_type"/>
                <field name="state"
                       filters="1"/>
            </calendar>
        </field>
    </record>

    <!-- FSO Calendar Search View with Lead Staff Filter -->
    <record id="view_fso_bookings_calendar_search" model="ir.ui.view">
        <field name="name">fso.bookings.calendar.search</field>
        <field name="model">health.fieldservice.order</field>
        <field name="arch" type="xml">
            <search string="Search Bookings">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="lead_staff_id"/>
                <field name="service_type"/>
                <field name="state"/>
                <filter string="Lead Staff" name="group_lead_staff" context="{'group_by': 'lead_staff_id'}"/>
                <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- Client Info Modal View - Summary of patient details -->
    <record id="view_patient_client_info_modal" model="ir.ui.view">
        <field name="name">res.partner.client.info.modal</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Client Information">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/> - Client Info
                    </h1>
                    <h3>
                        <field name="patient_code_display"/>
                    </h3>

                    <group>
                        <group string="Personal Details">
                            <field name="title"/>
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="middle_name"/>
                            <field name="vietnamese_name"/>
                            <field name="birth_date"/>
                            <field name="age_display"/>
                            <field name="deceased"/>
                            <field name="gender_id"/>
                        </group>

                        <group string="Other Information">
                            <field name="mobile" widget="phone"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="patient_status"/>
                            <field name="patient_category_id"/>
                            <field name="catchment_province_id"/>
                            <field name="primary_facility_id" domain="[('catchment_province_id', '=', catchment_province_id)]"/>
                            <field name="state_id" string="Province"/>
                            <field name="national_id"/>
                            <field name="profession" string="Occupation"/>
                            <field name="ethnicity"/>
                        </group>
                    </group>

                    <group>
                        <group string="Emergency Contact">
                            <field name="emergency_contact_name"/>
                            <field name="emergency_contact_phone" widget="phone"/>
                            <field name="emergency_contact_relation"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" special="save"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Relations Modal View - Hierarchy widget -->
    <record id="view_patient_relations_modal" model="ir.ui.view">
        <field name="name">res.partner.relations.modal</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string='Client Relationships'>
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/> - Relationships
                    </h1>

                    <!-- Relationship Hierarchy Widget -->
                    <widget name="relationship_hierarchy"/>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" special="save"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Map Modal View - Address with map widget -->
    <record id="view_patient_map_modal" model="ir.ui.view">
        <field name="name">res.partner.map.modal</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string='Client Location'>
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/> - Location
                    </h1>

                    <group>
                        <group string="Home Address">
                            <label for="vietnamese_address"/>
                            <div class="o_row align-items-start">
                                <field name="vietnamese_address" nolabel="1" readonly="1" widget="text" class="flex-grow-1"/>
                                <button name="action_edit_vietnamese_address"
                                        type="object"
                                        class="btn btn-link p-0 fa fa-pencil text-muted"
                                        title="Edit address"/>
                            </div>
                        </group>
                    </group>

                    <!-- Hidden fields needed by address_map widget for route calculation -->
                    <field name="primary_facility_id" invisible="1"/>
                    <field name="partner_latitude" invisible="1"/>
                    <field name="partner_longitude" invisible="1"/>
                    <field name="date_localization" invisible="1"/>

                    <group colspan="2" col="1">
                        <!-- Interactive OpenStreetMap Display -->
                        <field name="geo_coordinates_display" widget="address_map" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" special="save"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Packages Modal View - Service packages with gauge widgets -->
    <record id="view_patient_packages_modal" model="ir.ui.view">
        <field name="name">res.partner.packages.modal</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Service Packages">
                <header>
                    <button name="action_create_prepaid_package"
                            type="object"
                            string="Select Package"
                            class="btn-primary"
                            context="{'return_to_packages_modal': True}"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/> - Service Packages
                    </h1>

                    <!-- Active Service Packages with Gauge Widgets -->
                    <div invisible="not is_patient or active_packages_count == 0">
                        <separator string="ACTIVE SERVICE PACKAGES"/>
                        <field name="active_service_packages" nolabel="1">
                            <kanban create="false" edit="false" delete="false" class="o_kanban_mobile">
                                <field name="name"/>
                                <field name="service_type"/>
                                <field name="total_services"/>
                                <field name="consumed_services"/>
                                <field name="remaining_services"/>

                                <templates>
                                    <t t-name="card" class="text-center">
                                        <field class="fw-bold fs-4 text-primary" name="name" />
                                        <div class="mt-2">
                                            <span class="badge badge-info">
                                                <field name="service_type"/>
                                            </span>
                                        </div>
                                        <div class="pt-3 fs-1 fw-bolder">
                                            <field name="consumed_services"
                                                   widget="gauge"
                                                   options="{'max_field': 'total_services', 'style': 'width:160px; height: 120px;'}" />
                                        </div>
                                        <p class="mt-2">
                                            <small class="text-muted">
                                                <field name="consumed_services"/> / <field name="total_services"/> services used
                                                <br/>
                                                <field name="remaining_services"/> remaining
                                            </small>
                                        </p>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </div>

                    <!-- Show message when no packages -->
                    <group invisible="active_packages_count &gt; 0">
                        <div class="alert alert-info">
                            <p>No active service packages for this patient.</p>
                        </div>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" special="save"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Bookings Modal View - FSO Bookings with timeline -->
    <record id="view_patient_bookings_modal" model="ir.ui.view">
        <field name="name">res.partner.bookings.modal</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string='Client Bookings'>
                <header>
                    <button name="action_create_fso_modal" type="object" string="Create Booking" class="btn-primary"/>
                    <button name="action_view_bookings_calendar" type="object" string="Calendar View" class="btn-primary"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/> - Bookings
                    </h1>

                    <!-- Upcoming Bookings -->
                    <group string="Upcoming Bookings">
                        <field name="fso_upcoming_ids" nolabel="1">
                            <kanban create="false" edit="false" delete="false" default_group_by="scheduled_month" group_create="false">
                                <field name="name"/>
                                <field name="scheduled_datetime"/>
                                <field name="scheduled_month"/>
                                <field name="lead_staff_id"/>
                                <field name="state"/>

                                <progressbar field="state" colors='{"draft": "secondary", "scheduled": "info", "assigned": "warning", "confirmed": "success", "done": "success", "cancelled": "danger"}'/>

                                <templates>
                                    <t t-name="card">
                                        <div class="d-flex flex-column position-relative" style="background: white;">
                                            <!-- Status Badge - Top Right (No Background) -->
                                            <div class="position-absolute top-0 end-0">
                                                <span t-if="record.state.raw_value == 'draft'" class="badge text-bg-secondary">Draft</span>
                                                <span t-elif="record.state.raw_value == 'scheduled'" class="badge text-bg-info">Scheduled</span>
                                                <span t-elif="record.state.raw_value == 'assigned'" class="badge text-bg-warning">Assigned</span>
                                                <span t-elif="record.state.raw_value == 'confirmed'" class="badge text-bg-success">Confirmed</span>
                                                <span t-elif="record.state.raw_value == 'done' or record.state.raw_value == 'completed'" class="badge text-bg-success">Completed</span>
                                                <span t-elif="record.state.raw_value == 'cancelled'" class="badge text-bg-danger">Cancelled</span>
                                                <span t-else="" class="badge text-bg-secondary"><field name="state"/></span>
                                            </div>

                                            <!-- Booking Reference (Top Left, No Icon) -->
                                            <div class="fw-bold text-primary mb-2">
                                                <field name="name"/>
                                            </div>

                                            <!-- Scheduled Date/Time (dd-mmm-yy hh:mm format) -->
                                            <div class="mb-2">
                                                <i class="fa fa-clock-o me-1 text-muted"/>
                                                <strong>Scheduled:</strong>
                                                <t t-esc="luxon.DateTime.fromISO(record.scheduled_datetime.raw_value).toFormat('dd-MMM-yy HH:mm')"/>
                                            </div>

                                            <!-- Lead Staff -->
                                            <div class="mb-1">
                                                <i class="fa fa-user-md me-1 text-muted"/>
                                                <strong>Nurse:</strong>
                                                <field name="lead_staff_id"/>
                                            </div>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </group>

                    <!-- Past Bookings -->
                    <group string="Past Bookings">
                        <field name="fso_past_ids" nolabel="1">
                            <list create="false" delete="false">
                                <field name="scheduled_datetime"/>
                                <field name="primary_nurse_id"/>
                                <field name="name"/>
                                <field name="service_type"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'done' or state == 'completed'"
                                       decoration-danger="state == 'cancelled'"
                                       decoration-warning="state == 'draft'"
                                       decoration-info="state == 'confirmed'"/>
                                <field name="actual_duration" string="Duration (hrs)"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" special="save"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Financials Modal View - Invoices with line items -->
    <record id="view_patient_financials_modal" model="ir.ui.view">
        <field name="name">res.partner.financials.modal</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string='Client Financials'>
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/> - Financials
                    </h1>

                    <group>
                        <group string="Financial Summary">
                            <field name="total_invoiced" widget="monetary"/>
                            <field name="total_paid" widget="monetary"/>
                            <field name="total_due" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <!-- All Invoices List -->
                    <group string="Invoices">
                        <field name="customer_invoice_ids" nolabel="1">
                            <list create="false" delete="false" decoration-success="state == 'posted' and payment_state == 'paid'" decoration-warning="state == 'draft'" decoration-info="state == 'posted' and payment_state == 'partial'" decoration-danger="state == 'posted' and payment_state == 'not_paid'">
                                <field name="name"/>
                                <field name="invoice_date"/>
                                <field name="invoice_date_due"/>
                                <field name="amount_total" widget="monetary"/>
                                <field name="amount_residual" widget="monetary"/>
                                <field name="payment_state" widget="badge" decoration-success="payment_state == 'paid'" decoration-info="payment_state == 'partial'" decoration-danger="payment_state == 'not_paid'"/>
                                <field name="state" invisible="1"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" special="save"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Lead Client Info Modal View -->
    <record id="view_lead_client_info_modal" model="ir.ui.view">
        <field name="name">crm.lead.client.info.modal</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <form string="Lead Information">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/> - Lead Info
                    </h1>

                    <group>
                        <group string="Lead Details">
                            <field name="phone"/>
                            <field name="email_from"/>
                            <field name="gender_id"/>
                            <field name="birth_date"/>
                            <field name="national_id" string="National ID (CCCD/CMND)"/>
                            <field name="stage_id"/>
                            <field name="user_id"/>
                            <field name="team_id"/>
                        </group>

                        <group string="Status &amp; Follow-up">
                            <field name="contact_outcome"/>
                            <field name="health_contact_outcome" invisible="1"/>
                            <field name="service_interest_id"/>
                            <field name="lead_followup_required"/>
                            <field name="next_follow_up_date"/>
                            <field name="partner_id" invisible="1"/>
                        </group>
                    </group>

                    <!-- Action Buttons Row - Modern styled side by side -->
                    <div style="display: flex; justify-content: center; gap: 12px; margin: 16px 0; padding: 0 8px;">
                        <button name="action_open_client_dashboard" type="object"
                                class="oe_link"
                                title="Open Client Dashboard"
                                invisible="not partner_id"
                                style="display: flex; align-items: center; gap: 8px; padding: 10px 18px; background: linear-gradient(135deg, #E4F4FD, #d4e8fa); border: 1px solid #b3cef5; border-radius: 10px; color: #0D356B; font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.2s ease;">
                            <span class="fa fa-user-md" style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; background: #1565C0; color: white; border-radius: 8px; font-size: 16px;"/>
                            <span>View Client Dashboard</span>
                        </button>
                        <button name="action_view_lead_activities" type="object"
                                class="oe_link"
                                title="View scheduled activities for this lead"
                                style="display: flex; align-items: center; gap: 8px; padding: 10px 18px; background: linear-gradient(135deg, #E4F4FD, #d4e8fa); border: 1px solid #b3cef5; border-radius: 10px; color: #0D356B; font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.2s ease;">
                            <span class="fa fa-calendar-check-o" style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; background: #1565C0; color: white; border-radius: 8px; font-size: 16px;"/>
                            <span>View Activities</span>
                        </button>
                        <button name="action_schedule_new_activity" type="object"
                                class="oe_link"
                                title="Schedule a new activity for this lead"
                                style="display: flex; align-items: center; gap: 8px; padding: 10px 18px; background: linear-gradient(135deg, #E4F4FD, #d4e8fa); border: 1px solid #b3cef5; border-radius: 10px; color: #0D356B; font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.2s ease;">
                            <span class="fa fa-plus-circle" style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; background: #1565C0; color: white; border-radius: 8px; font-size: 16px;"/>
                            <span>Schedule Activity</span>
                        </button>
                    </div>

                    <group>
                        <group string="Contact Status">
                            <field name="contact_status" readonly="1" force_save="1"/>
                            <field name="booking_lost_reason" invisible="contact_outcome != 'booking_lost'"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" special="save"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Lead Relations Modal View -->
    <record id="view_lead_relations_modal" model="ir.ui.view">
        <field name="name">crm.lead.relations.modal</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <form string="Lead Relationships">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/> - Relationships
                    </h1>

                    <group>
                        <group string="Catchment &amp; Reason">
                            <field name="catchment_province_id" string="Catchment Province" options="{'no_create': True}"/>
                            <field name="contact_reason_id" string="Contact Reason" options="{'no_create': True}"/>
                            <field name="lead_reason_id" string="Lead Reason" options="{'no_create': True}"/>
                        </group>
                        <group string="Relationship Context">
                            <field name="contact_relationship_type" string="I am the:" widget="radio"
                                   options="{'horizontal': true}"/>
                            <label for="client_name" string="Client Name" invisible="contact_relationship_type == 'client'"/>
                            <div class="o_row" invisible="contact_relationship_type == 'client'">
                                <field name="client_name" nolabel="1" placeholder="Enter client name..."
                                       required="contact_relationship_type != 'client'"/>
                                <button name="action_search_client_by_name" type="object" 
                                        class="btn btn-outline-primary btn-sm"
                                        string="🔍 Search" 
                                        title="Search for existing clients"/>
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" special="save"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Lead Map Modal View -->
    <record id="view_lead_map_modal" model="ir.ui.view">
        <field name="name">crm.lead.map.modal</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <form string="Lead Location">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/> - Location
                    </h1>

                    <group>
                        <group string="Home Address">
                            <field name="province_code"/>
                            <field name="house_number"/>
                            <field name="sub_alley_number"/>
                            <field name="alley_number"/>
                            <field name="ward_commune"/>
                            <field name="named_area"/>
                            <field name="apartment_number"/>
                            <field name="building_name"/>
                            <field name="full_vietnamese_address"/>
                        </group>
                        <group string="Standard Address">
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="zip"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" special="save"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Lead Source Modal View -->
    <record id="view_lead_source_modal" model="ir.ui.view">
        <field name="name">crm.lead.source.modal</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <form string="Lead Source">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/> - Source
                    </h1>

                    <group>
                        <group string="Marketing Source">
                            <field name="source_id"/>
                            <field name="medium_id"/>
                            <field name="campaign_id"/>
                        </group>
                        <group string="Health Source">
                            <field name="contact_source"/>
                            <field name="healthcare_lead_source"/>
                            <field name="vietnamese_channel"/>
                            <field name="contact_reason_id"/>
                            <field name="lead_reason_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" special="save"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Lead Internal Notes Modal View -->
    <record id="view_lead_internal_notes_modal" model="ir.ui.view">
        <field name="name">crm.lead.internal.notes.modal</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <form string="Internal Notes">
                <sheet>
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/> - Internal Notes
                    </h1>

                    <group>
                        <field name="description" placeholder="Notes"/>
                        <field name="service_requirements"/>
                        <field name="follow_up_notes"/>
                        <field name="reason_if_rejected"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" special="save"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
