    <!-- Service Categories — the product.category taxonomy the price-list
         import builds (Service Type → Service Category). -->
    <!-- Authored rather than inherited: core's category list shows
         `display_name` (the full "Parent / Child" path), which is computed and
         so cannot be edited or translated in place. This one shows `name`, the
         field that actually carries the en_US/vi_VN pair. -->
    <record id="view_admin_service_category_list" model="ir.ui.view">
        <field name="name">admin.service.category.list</field>
        <field name="model">product.category</field>
        <!-- Explicit reset: this record shipped once as an inherited view, and
             simply dropping <inherit_id> from the XML leaves the old parent on
             the existing row — the upgrade then fails with "cannot be located
             in parent view" because a standalone <list> is not a valid patch. -->
        <field name="inherit_id" eval="False"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list string="Service Categories" js_class="admin_model_navigator_view"
                  editable="bottom">
                <field name="name" string="Category"/>
                <field name="parent_id" string="Parent"/>
                <field name="complete_name" string="Full Path" readonly="1" optional="show"/>
                <field name="product_count" string="Services" readonly="1" optional="show"/>
            </list>
        </field>
    </record>

