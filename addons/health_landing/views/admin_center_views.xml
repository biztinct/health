<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =============================================== -->
    <!--  ADMIN CENTER — People (Users, Roles, Role Mgmt)-->
    <!-- =============================================== -->

    <record id="view_admin_users_list" model="ir.ui.view">
        <field name="name">admin.users.list</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="health_user_admin.view_health_users_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">admin_model_navigator_view</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_admin_users" model="ir.actions.act_window">
        <field name="name">Users</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('share', '=', False)]</field>
        <field name="context">{'active_test': False, 'open_create_wizard': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_admin_users_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('health_user_admin.view_health_users_form')})]"/>
        <field name="search_view_id" ref="health_user_admin.view_health_users_search"/>
    </record>

    <record id="action_admin_roles" model="ir.actions.act_window">
        <field name="name">Access Roles</field>
        <field name="res_model">access.role</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_admin_role_mgmt" model="ir.actions.act_window">
        <field name="name">Role Management</field>
        <field name="res_model">role.management</field>
        <field name="view_mode">list,form</field>
    </record>

