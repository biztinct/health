    <!-- Services — the product list the "Import Price List" wizard populates
         (product.template, type='service'). This is the first Pricing tab;
         the pricing ENGINE list is deliberately not a tab any more — there is
         a single engine and it is not something the client maintains. The
         action below is kept so the legacy Odoo menu entry still resolves. -->
    <record id="view_admin_service_list" model="ir.ui.view">
        <field name="name">admin.service.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Services" js_class="admin_model_navigator_view" multi_edit="1">
                <field name="currency_id" column_invisible="True"/>
                <field name="default_code" string="Item Code"/>
                <field name="name" string="Service"/>
                <field name="categ_id" string="Category"/>
                <field name="list_price" string="Base Fee" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="uom_id" string="Unit" optional="show" groups="uom.group_uom"/>
                <field name="rounding_rule" optional="show"/>
                <field name="sale_ok" string="Can be Sold" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

