<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- FSO Flowchart Dashboard Template - Excalidraw Layout -->
    <t t-name="health_landing.FSOHubSpokeTemplate">
        <div class="fso_spoke_container">

            <!-- Compact Header with FSO ID and Status Bar -->
            <div class="fso_spoke_header">
                <button class="health_landing_back_btn" t-on-click="props.onBack">
                    <i class="fa fa-arrow-left"/> Back
                </button>

                <!-- FSO ID and Status Bar on Same Line -->
                <div class="fso_header_main" t-if="!state.loading &amp;&amp; state.fsoData">
                    <h1 class="fso_spoke_title">
                        <i class="fa fa-stethoscope"/> <t t-esc="props.fsoName"/>
                    </h1>

                    <!-- Compact Status Bar -->
                    <div class="fso_status_stages_compact">
                        <div t-att-class="'fso_status_stage ' + (state.fsoData.show_draft_indicator ? 'active' : 'inactive')">
                            <div class="fso_status_icon">
                                <i class="fa fa-file-o"/>
                            </div>
                            <span class="fso_status_label">DRAFT</span>
                        </div>
                        <i class="fa fa-angle-right fso_status_arrow"/>
                        <div t-att-class="'fso_status_stage ' + (state.fsoData.show_booked_indicator ? 'active' : 'inactive')">
                            <div class="fso_status_icon">
                                <i class="fa fa-calendar-check-o"/>
                            </div>
                            <span class="fso_status_label">BOOKED</span>
                        </div>
                        <i class="fa fa-angle-right fso_status_arrow"/>
                        <div t-att-class="'fso_status_stage ' + (state.fsoData.show_assigned_indicator ? 'active' : 'inactive')">
                            <div class="fso_status_icon">
                                <i class="fa fa-user-check"/>
                            </div>
                            <span class="fso_status_label">ASSIGNED</span>
                        </div>
                        <i class="fa fa-angle-right fso_status_arrow"/>
                        <div t-att-class="'fso_status_stage ' + (state.fsoData.show_in_progress_indicator ? 'active' : 'inactive')">
                            <div class="fso_status_icon">
                                <i class="fa fa-refresh fa-spin" t-if="state.fsoData.show_in_progress_indicator"/>
                                <i class="fa fa-refresh" t-else=""/>
                            </div>
                            <span class="fso_status_label">IN PROGRESS</span>
                        </div>
                        <i class="fa fa-angle-right fso_status_arrow"/>
                        <div t-att-class="'fso_status_stage ' + (state.fsoData.show_completed_indicator ? 'active completed' : 'inactive')">
                            <div class="fso_status_icon">
                                <i class="fa fa-check-circle"/>
                            </div>
                            <span class="fso_status_label">COMPLETED</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Loading State -->
            <div class="health_landing_loading" t-if="state.loading">
                <i class="fa fa-spinner health_landing_loading_spinner"/>
                <p>Loading workflow data...</p>
            </div>

            <!-- SVG Flowchart Layout -->
            <div class="fso_spoke_svg_container" t-if="!state.loading">
                <svg
                    t-ref="hubSpokeSvg"
                    class="fso_spoke_svg"
                    t-att-width="svgWidth"
                    t-att-height="svgHeight"
                    t-att-viewBox="`0 0 ${svgWidth} ${svgHeight}`"
                    preserveAspectRatio="xMidYMid meet"
                >
                    <defs>
                        <!-- Glow filter for active nodes and arrows -->
                        <filter id="glowFilter" x="-50%" y="-50%" width="200%" height="200%">
                            <feGaussianBlur stdDeviation="8" result="coloredBlur"/>
                            <feMerge>
                                <feMergeNode in="coloredBlur"/>
                                <feMergeNode in="coloredBlur"/>
                                <feMergeNode in="SourceGraphic"/>
                            </feMerge>
                        </filter>

                        <!-- Small Consistent Arrow markers -->
                        <marker id="arrowhead" markerWidth="8" markerHeight="8" refX="7" refY="2.5" orient="auto">
                            <polygon points="0 0, 8 2.5, 0 5" fill="#64748b"/>
                        </marker>
                        <marker id="arrowheadActive" markerWidth="8" markerHeight="8" refX="7" refY="2.5" orient="auto">
                            <polygon points="0 0, 8 2.5, 0 5" fill="#0284c7"/>
                        </marker>
                    </defs>

                    <!-- Connection Lines with smooth curves (rendered first, behind nodes) -->
                    <g class="connection_lines">
                        <t t-foreach="connections" t-as="connection" t-key="connection.from + '_' + connection.to">
                            <path
                                t-att-d="getLinePath(connection)"
                                t-att-class="getConnectionClasses(connection)"
                                t-att-stroke="isConnectionActive(connection) ? '#0284c7' : '#64748b'"
                                stroke-width="2"
                                fill="none"
                                t-att-marker-end="isConnectionActive(connection) ? 'url(#arrowheadActive)' : 'url(#arrowhead)'"
                            />
                        </t>
                    </g>

                    <!-- All Nodes (rendered on top of connections) -->
                    <g class="flowchart_nodes">
                        <t t-foreach="allNodes" t-as="node" t-key="node.id">
                            <g
                                t-att-class="getNodeClasses(node)"
                                t-on-click="() => this.onNodeClick(node)"
                                t-on-mouseenter="() => this.onNodeMouseEnter(node)"
                                t-on-mouseleave="() => this.onNodeMouseLeave()"
                            >
                                <!-- Render Rectangle -->
                                <t t-if="node.shape === 'rect'">
                                    <rect
                                        t-att-x="node.x"
                                        t-att-y="node.y"
                                        t-att-width="node.width"
                                        t-att-height="node.height"
                                        t-att-fill="node.lightColor"
                                        t-att-stroke="node.color"
                                        stroke-width="3"
                                        rx="8"
                                        class="fso_node_shape"
                                    />
                                    <!-- Icon for rectangle -->
                                    <foreignObject
                                        t-att-x="node.x + (node.width / 2) - 18"
                                        t-att-y="node.y + (node.height / 2) - 26"
                                        width="36"
                                        height="36"
                                    >
                                        <div xmlns="http://www.w3.org/1999/xhtml" class="fso_node_icon">
                                            <i t-att-class="`fa ${node.icon}`" t-att-style="`color: ${node.color}; font-size: 24px;`"/>
                                        </div>
                                    </foreignObject>
                                    <!-- Label for rectangle -->
                                    <text
                                        t-att-x="node.x + (node.width / 2)"
                                        t-att-y="node.y + (node.height / 2) + 20"
                                        class="fso_node_label"
                                        text-anchor="middle"
                                        t-att-fill="node.color"
                                        font-size="13"
                                        font-weight="700"
                                        t-esc="node.label"
                                    />
                                </t>

                                <!-- Render Oval/Ellipse with width/height -->
                                <t t-if="node.shape === 'oval'">
                                    <ellipse
                                        t-att-cx="node.x + (node.width / 2)"
                                        t-att-cy="node.y + (node.height / 2)"
                                        t-att-rx="node.width / 2"
                                        t-att-ry="node.height / 2"
                                        t-att-fill="node.lightColor"
                                        t-att-stroke="node.color"
                                        stroke-width="3"
                                        class="fso_node_shape"
                                    />
                                    <!-- Icon for oval -->
                                    <foreignObject
                                        t-att-x="node.x + (node.width / 2) - 18"
                                        t-att-y="node.y + (node.height / 2) - 28"
                                        width="36"
                                        height="36"
                                    >
                                        <div xmlns="http://www.w3.org/1999/xhtml" class="fso_node_icon">
                                            <i t-att-class="`fa ${node.icon}`" t-att-style="`color: ${node.color}; font-size: 24px;`"/>
                                        </div>
                                    </foreignObject>
                                    <!-- Label for oval -->
                                    <text
                                        t-att-x="node.x + (node.width / 2)"
                                        t-att-y="node.y + (node.height / 2) + 20"
                                        class="fso_node_label"
                                        text-anchor="middle"
                                        t-att-fill="node.color"
                                        font-size="13"
                                        font-weight="700"
                                        t-esc="node.label"
                                    />
                                </t>
                            </g>
                        </t>
                    </g>

                </svg>

                <!-- Legend -->
                <div class="fso_spoke_legend">
                    <p>
                        <i class="fa fa-lightbulb-o"/> <strong>Tip:</strong> Active arrows and nodes glow to guide you through the workflow
                    </p>
                </div>
            </div>
        </div>
    </t>

</templates>
