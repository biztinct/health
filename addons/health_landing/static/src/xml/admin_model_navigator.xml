<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="health_landing.AdminModelNavigatorView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='props.Renderer']" position="before">
            <div t-if="hasNavigationTabs" t-attf-class="admin-nav-tabs #{isSectioned ? 'o_sectioned' : ''}">
                <t t-foreach="navigationSections" t-as="section" t-key="section.id">
                    <div class="admin-nav-section">
                        <span t-if="section.label" class="admin-nav-section-label" t-esc="section.label"/>
                        <div class="admin-nav-section-tabs">
                            <t t-foreach="section.tabs" t-as="tab" t-key="tab.id">
                                <button t-attf-class="admin-nav-tab #{activeTabId === tab.id ? 'active' : ''}"
                                        t-on-click="() => this.switchTab(tab.id)">
                                    <i t-attf-class="fa #{tab.icon}"/>
                                    <t t-esc="tab.label"/>
                                </button>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </xpath>
    </t>

</templates>
