<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Patient Spoke Modal Template -->
    <t t-name="health_landing.PatientSpokeModalTemplate">
        <div class="health_landing_modal_backdrop" t-on-click="props.onClose">
            <div class="health_landing_modal" t-att-class="'module-' + props.spoke.id" t-on-click.stop="">

                <!-- Modal Header -->
                <div class="health_landing_modal_header">
                    <button class="health_landing_modal_close" t-on-click="props.onClose">
                        <i class="fa fa-times"/>
                    </button>
                    <div class="health_landing_modal_icon" t-att-style="`color: ${props.spoke.color}`">
                        <i t-att-class="'fa ' + props.spoke.icon"/>
                    </div>
                    <h2 class="health_landing_modal_title" t-esc="props.spoke.label"/>
                    <p class="health_landing_modal_subtitle" t-esc="props.spoke.description"/>
                </div>

                <!-- Loading State -->
                <div class="health_landing_modal_body" t-if="state.loading">
                    <div class="text-center py-5">
                        <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                        <p class="mt-3">Đang tải dữ liệu...</p>
                    </div>
                </div>

                <!-- Error State -->
                <div class="health_landing_modal_body" t-if="state.error">
                    <div class="alert alert-danger">
                        <i class="fa fa-exclamation-triangle"/> Lỗi: <t t-esc="state.error"/>
                    </div>
                </div>

                <!-- Client Info Content -->
                <t t-if="!state.loading and !state.error and props.spoke.id === 'client_info'">
                    <div class="health_landing_modal_body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small">Mã bệnh nhân</label>
                                <div class="fw-bold" t-esc="state.data.patient_code"/>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small">Tuổi / Giới tính</label>
                                <div class="fw-bold"><t t-esc="state.data.age"/> years / <t t-esc="state.data.gender"/></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small">Điện thoại</label>
                                <div class="fw-bold" t-esc="state.data.phone or state.data.mobile or 'N/A'"/>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="text-muted small">Email</label>
                                <div class="fw-bold" t-esc="state.data.email or 'N/A'"/>
                            </div>
                            <div class="col-12 mb-3">
                                <label class="text-muted small">Địa chỉ</label>
                                <div class="fw-bold">
                                    <t t-esc="state.data.street"/><t t-if="state.data.street2">, <t t-esc="state.data.street2"/></t><br/>
                                    <t t-esc="state.data.city"/>, <t t-esc="state.data.state_id ? state.data.state_id[1] : ''"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- Relations Content -->
                <t t-if="!state.loading and !state.error and props.spoke.id === 'relations'">
                    <div class="health_landing_modal_body">
                        <div class="mb-4" t-if="state.data.caregivers.length > 0">
                            <h6 class="text-danger"><i class="fa fa-users"/> Người chăm sóc (<t t-esc="state.data.caregivers.length"/>)</h6>
                            <t t-foreach="state.data.caregivers.slice(0, 3)" t-as="rel" t-key="rel.id">
                                <div class="d-flex align-items-center mb-2 p-2 bg-light rounded">
                                    <i class="fa fa-user-circle fa-2x text-danger me-3"/>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold" t-esc="rel.representative_id[1]"/>
                                        <small class="text-muted" t-esc="rel.relationship_type"/>
                                        <t t-if="rel.is_primary">
                                            <span class="badge bg-danger ms-2">PRIMARY</span>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <div class="mb-4" t-if="state.data.payers.length > 0">
                            <h6 class="text-warning"><i class="fa fa-money"/> Người thanh toán (<t t-esc="state.data.payers.length"/>)</h6>
                            <t t-foreach="state.data.payers.slice(0, 3)" t-as="rel" t-key="rel.id">
                                <div class="d-flex align-items-center mb-2 p-2 bg-light rounded">
                                    <i class="fa fa-user-circle fa-2x text-warning me-3"/>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold" t-esc="rel.representative_id[1]"/>
                                        <small class="text-muted" t-esc="rel.relationship_type"/>
                                        <t t-if="rel.is_primary">
                                            <span class="badge bg-warning ms-2">PRIMARY</span>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <div class="mb-4" t-if="state.data.emergency.length > 0">
                            <h6 class="text-primary"><i class="fa fa-phone"/> Liên hệ khẩn cấp (<t t-esc="state.data.emergency.length"/>)</h6>
                            <t t-foreach="state.data.emergency.slice(0, 3)" t-as="rel" t-key="rel.id">
                                <div class="d-flex align-items-center mb-2 p-2 bg-light rounded">
                                    <i class="fa fa-user-circle fa-2x text-primary me-3"/>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold" t-esc="rel.representative_id[1]"/>
                                        <small class="text-muted" t-esc="rel.phone"/>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <p t-if="state.data.total === 0" class="text-center text-muted py-4">
                            Không tìm thấy mối quan hệ nào
                        </p>
                    </div>
                </t>

                <!-- Map Content -->
                <t t-if="!state.loading and !state.error and props.spoke.id === 'map'">
                    <div class="health_landing_modal_body">
                        <div class="mb-3">
                            <h6><i class="fa fa-map-marker"/> Địa chỉ</h6>
                            <p class="mb-2">
                                <t t-esc="state.data.street"/><t t-if="state.data.street2">, <t t-esc="state.data.street2"/></t><br/>
                                <t t-esc="state.data.city"/>, <t t-esc="state.data.state_id ? state.data.state_id[1] : ''"/> <t t-esc="state.data.zip"/>
                            </p>
                        </div>
                        <div t-if="state.data.partner_latitude and state.data.partner_longitude">
                            <h6><i class="fa fa-location-arrow"/> Tọa độ GPS</h6>
                            <p class="text-muted">
                                <t t-esc="state.data.partner_latitude"/>, <t t-esc="state.data.partner_longitude"/>
                            </p>
                        </div>
                    </div>
                </t>

                <!-- Packages Content -->
                <t t-if="!state.loading and !state.error and props.spoke.id === 'packages'">
                    <div class="health_landing_modal_body">
                        <t t-if="state.data.packages.length > 0">
                            <t t-foreach="state.data.packages" t-as="pkg" t-key="pkg.id">
                                <div class="mb-3 p-3 bg-light rounded">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="mb-0" t-esc="pkg.package_product_id[1]"/>
                                        <span t-att-class="'badge ' + getStatusBadge(pkg.state)" t-esc="pkg.state"/>
                                    </div>
                                    <div class="row small text-muted">
                                        <div class="col-6">
                                            <i class="fa fa-calendar"/> Hết hạn: <t t-esc="formatDate(pkg.expiry_date)"/>
                                        </div>
                                        <div class="col-6">
                                            <i class="fa fa-check-circle"/> Các buổi: <t t-esc="pkg.remaining_sessions"/> / <t t-esc="pkg.total_sessions"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </t>
                        <p t-else="" class="text-center text-muted py-4">
                            Không có gói dịch vụ nào đang hoạt động
                        </p>
                    </div>
                </t>

                <!-- Bookings Content -->
                <t t-if="!state.loading and !state.error and props.spoke.id === 'bookings'">
                    <div class="health_landing_modal_body">
                        <div class="mb-4" t-if="state.data.upcoming.length > 0">
                            <h6 class="text-success"><i class="fa fa-calendar-plus-o"/> Lịch hẹn sắp tới</h6>
                            <t t-foreach="state.data.upcoming" t-as="booking" t-key="booking.id">
                                <div class="mb-2 p-3 bg-light rounded cursor-pointer" t-on-click="() => this.onItemClick(booking, 'booking')">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="fw-bold" t-esc="booking.service_type_id[1]"/>
                                            <small class="text-muted">
                                                <i class="fa fa-clock-o"/> <t t-esc="formatDate(booking.scheduled_date)"/>
                                            </small>
                                        </div>
                                        <span t-att-class="'badge ' + getStatusBadge(booking.state)" t-esc="booking.state"/>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <div class="mb-4" t-if="state.data.recent.length > 0">
                            <h6 class="text-secondary"><i class="fa fa-history"/> Các lịch hẹn gần đây (Trong 7 ngày qua)</h6>
                            <t t-foreach="state.data.recent" t-as="booking" t-key="booking.id">
                                <div class="mb-2 p-3 bg-light rounded cursor-pointer" t-on-click="() => this.onItemClick(booking, 'booking')">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="fw-bold" t-esc="booking.service_type_id[1]"/>
                                            <small class="text-muted">
                                                <i class="fa fa-clock-o"/> <t t-esc="formatDate(booking.scheduled_date)"/>
                                            </small>
                                        </div>
                                        <span t-att-class="'badge ' + getStatusBadge(booking.state)" t-esc="booking.state"/>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <p t-if="state.data.upcoming.length === 0 and state.data.recent.length === 0" class="text-center text-muted py-4">
                            Không tìm thấy lịch hẹn
                        </p>
                    </div>
                </t>

                <!-- Financials Content -->
                <t t-if="!state.loading and !state.error and props.spoke.id === 'financials'">
                    <div class="health_landing_modal_body">
                        <div class="row mb-4">
                            <div class="col-6">
                                <div class="p-3 bg-warning bg-opacity-10 rounded text-center">
                                    <div class="h4 mb-0 text-warning" t-esc="formatCurrency(state.data.total_pending)"/>
                                    <small class="text-muted">Tổng số tiền đang chờ xử lý</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-danger bg-opacity-10 rounded text-center">
                                    <div class="h4 mb-0 text-danger" t-esc="state.data.overdue_count"/>
                                    <small class="text-muted">Số hóa đơn quá hạn</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4" t-if="state.data.pending_invoices.length > 0">
                            <h6><i class="fa fa-file-text-o"/> Các hóa đơn đang chờ xử lý</h6>
                            <t t-foreach="state.data.pending_invoices.slice(0, 5)" t-as="inv" t-key="inv.id">
                                <div class="mb-2 p-3 bg-light rounded">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="fw-bold" t-esc="inv.name"/>
                                            <small class="text-muted">
                                                Đến hạn: <t t-esc="formatDate(inv.invoice_date_due)"/>
                                            </small>
                                        </div>
                                        <div class="text-end">
                                            <div class="fw-bold text-warning" t-esc="formatCurrency(inv.amount_residual)"/>
                                            <span t-att-class="'badge ' + (inv.payment_state === 'partial' ? 'badge-warning' : 'badge-danger')" t-esc="inv.payment_state"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <div t-if="state.data.last_payment" class="alert alert-success">
                            <i class="fa fa-check-circle"/> Lần thanh toán cuối: <t t-esc="formatCurrency(state.data.last_payment.amount)"/>
                            on <t t-esc="formatDate(state.data.last_payment.date)"/>
                        </div>

                        <p t-if="state.data.pending_invoices.length === 0 and !state.data.last_payment" class="text-center text-muted py-4">
                            Chưa có dữ liệu tài chính nào
                        </p>
                    </div>
                </t>

                <!-- Modal Footer -->
                <div class="health_landing_modal_footer" t-if="!state.loading and !state.error">
                    <button class="health_landing_modal_btn health_landing_modal_btn_secondary" t-on-click="props.onClose">
                        Đóng
                    </button>
                    <button class="health_landing_modal_btn health_landing_modal_btn_primary" t-on-click="onEditClick">
                        <i class="fa fa-edit"/> Chỉnh sửa toàn bộ chi tiết
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
