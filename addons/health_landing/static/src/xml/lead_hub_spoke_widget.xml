<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="health_landing.LeadHubSpokeTemplate">
        <div class="hub_spoke_container hub_spoke_container_lead">
            <div class="hub_spoke_header">
                <button class="health_landing_back_btn" t-on-click="props.onBack">
                    <i class="fa fa-arrow-left"/> Back
                </button>

                <div class="health_landing_breadcrumb">
                    <a href="#" class="health_landing_breadcrumb_item" t-on-click="onHomeClick">
                        <i class="fa fa-home"/> Home
                    </a>
                    <span class="health_landing_breadcrumb_separator">/</span>
                    <a href="#" class="health_landing_breadcrumb_item" t-on-click="onContactsClick">Contacts</a>
                    <span class="health_landing_breadcrumb_separator">/</span>
                    <span class="health_landing_breadcrumb_item" t-esc="getLeadName()"/>
                </div>

                <h1 class="hub_spoke_title" style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px;">
                    <span><i class="fa fa-user-circle"/> <t t-esc="getLeadName()"/></span>
                    <!-- Spam Caller Warning Badge -->
                    <t t-if="isSpamCaller()">
                        <span class="badge rounded-pill" 
                              style="background-color: #dc3545; color: white; font-size: 13px; padding: 5px 14px; font-weight: 600; animation: pulse 1.5s infinite;">
                            ⚠️ Spam Caller
                        </span>
                    </t>
                    <!-- Contact Outcome Badge -->
                    <t t-if="getContactOutcome()">
                        <span class="badge rounded-pill" 
                              t-att-style="getOutcomeBadgeStyle() + ' font-size: 13px; padding: 5px 14px; font-weight: 600;'">
                            <i class="fa fa-tag" style="margin-right: 4px;"/> <t t-esc="getContactOutcome()"/>
                        </span>
                    </t>
                    <!-- Follow-up Required Badge -->
                    <t t-if="needsFollowup()">
                        <span class="badge rounded-pill" 
                              style="background-color: #e83e8c; color: white; font-size: 13px; padding: 5px 14px; font-weight: 600;">
                            <i class="fa fa-flag" style="margin-right: 4px;"/> Follow-up Required
                        </span>
                    </t>
                    <!-- Next Follow-up Date Badge -->
                    <t t-if="hasNextFollowup()">
                        <span class="badge rounded-pill" 
                              style="background-color: #6610f2; color: white; font-size: 13px; padding: 5px 14px; font-weight: 600;">
                            <i class="fa fa-calendar" style="margin-right: 4px;"/> <t t-esc="getNextFollowupDate()"/>
                        </span>
                    </t>
                </h1>
                <div class="hub_spoke_action_buttons">
                    <button type="button" class="hub_spoke_btn hub_spoke_btn--spam" t-on-click="onMarkSpamClick" title="Mark as Spam">
                        <i class="fa fa-ban"/> Mark Spam
                    </button>
                    <button type="button" class="hub_spoke_btn hub_spoke_btn--booking" t-on-click="onBookingClick" title="Create booking">
                        <i class="fa fa-calendar-plus-o"/> Booking
                    </button>
                    <button type="button" class="hub_spoke_btn hub_spoke_btn--consultation" t-on-click="onConsultationClick" title="Transfer for consultation">
                        <i class="fa fa-comments"/> Consultation
                    </button>
                    <button type="button" class="hub_spoke_btn hub_spoke_btn--escalate" t-on-click="onEscalateClick" title="Escalate contact">
                        <i class="fa fa-level-up"/> Escalate
                    </button>
                    <button type="button" class="hub_spoke_btn hub_spoke_btn--message" t-on-click="onSendMessageClick" title="Send message">
                        <i class="fa fa-envelope"/> Send Message
                    </button>
                    <button type="button" class="hub_spoke_btn hub_spoke_btn--activity" t-on-click="onLogActivityClick" title="Schedule activity">
                        <i class="fa fa-clock-o"/> Log Activity
                    </button>
                    <button type="button" class="hub_spoke_btn hub_spoke_btn--note" t-on-click="onLogNoteClick" title="Add internal note">
                        <i class="fa fa-sticky-note"/> Log Note
                    </button>
                </div>
            </div>

            <div class="health_landing_loading" t-if="state.loading">
                <i class="fa fa-spinner health_landing_loading_spinner"/>
                <p>Loading lead data...</p>
            </div>

            <div class="hub_spoke_svg_container" t-if="!state.loading">
                <svg
                    t-ref="hubSpokeSvg"
                    class="hub_spoke_svg"
                    t-att-width="svgWidth"
                    t-att-height="svgHeight"
                    viewBox="0 0 800 600"
                    preserveAspectRatio="xMidYMid meet"
                >
                    <defs>
                        <filter id="glow">
                            <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
                            <feMerge>
                                <feMergeNode in="coloredBlur"/>
                                <feMergeNode in="SourceGraphic"/>
                            </feMerge>
                        </filter>

                        <linearGradient t-foreach="spokes" t-as="spoke" t-key="spoke.id"
                                        t-attf-id="gradient_lead_{{spoke.id}}"
                                        x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" t-att-stop-color="spoke.color" stop-opacity="0.3"/>
                            <stop offset="100%" t-att-stop-color="spoke.color" stop-opacity="1"/>
                        </linearGradient>
                    </defs>

                    <g class="hub_spoke_lines">
                        <t t-foreach="spokes" t-as="spoke" t-key="spoke.id + '_line'">
                            <path
                                t-att-class="getLineClasses(spoke)"
                                t-att-d="getSpokePath(spoke.angle)"
                                t-att-stroke="spoke.color"
                                stroke-width="3"
                                stroke-dasharray="5,5"
                                fill="none"
                            />
                        </t>
                    </g>

                    <g class="hub_spoke_center" t-on-click="onHubClick">
                        <circle
                            t-att-cx="centerX"
                            t-att-cy="centerY"
                            t-att-r="hubRadius"
                            class="hub_spoke_center_circle"
                            fill="#E3F2FD"
                            stroke="#1565C0"
                            stroke-width="4"
                        />

                        <foreignObject
                            t-att-x="centerX - 30"
                            t-att-y="centerY - 40"
                            width="60"
                            height="60"
                        >
                            <div xmlns="http://www.w3.org/1999/xhtml" class="hub_spoke_center_icon">
                                <i class="fa fa-user-circle"/>
                            </div>
                        </foreignObject>

                        <text
                            t-att-x="centerX"
                            t-att-y="centerY + 30"
                            class="hub_spoke_center_text"
                            text-anchor="middle"
                            fill="#1565C0"
                            font-size="16"
                            font-weight="700"
                        >
                            <t t-esc="getLeadName()"/>
                        </text>
                    </g>

                    <g class="hub_spoke_nodes">
                        <t t-foreach="spokes" t-as="spoke" t-key="spoke.id + '_node'">
                            <g
                                t-att-class="getSpokeClasses(spoke)"
                                t-att-transform="`translate(${getSpokePosition(spoke.angle).x}, ${getSpokePosition(spoke.angle).y})`"
                                t-on-mouseenter="() => this.onSpokeMouseEnter(spoke)"
                                t-on-mouseleave="() => this.onSpokeMouseLeave()"
                                t-on-click="() => this.onSpokeClick(spoke)"
                            >
                                <circle
                                    r="60"
                                    t-att-fill="spoke.lightColor"
                                    t-att-stroke="spoke.color"
                                    stroke-width="4"
                                    class="hub_spoke_node_circle"
                                />

                                <foreignObject x="-25" y="-30" width="50" height="50">
                                    <div xmlns="http://www.w3.org/1999/xhtml" class="hub_spoke_node_icon">
                                        <i t-att-class="`fa ${spoke.icon}`" t-att-style="`color: ${spoke.color};`"/>
                                    </div>
                                </foreignObject>

                                <text
                                    x="0"
                                    y="28"
                                    class="hub_spoke_node_label"
                                    text-anchor="middle"
                                    t-att-fill="spoke.color"
                                    font-size="14"
                                    font-weight="600"
                                >
                                    <t t-esc="spoke.label"/>
                                </text>
                            </g>
                        </t>
                    </g>
                </svg>

                <div class="hub_spoke_legend">
                    <p>
                        <i class="fa fa-hand-pointer-o"/> Click on any section to view details
                    </p>
                </div>
            </div>
        </div>
    </t>

</templates>
