<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Serial gold refresh queue: drains due bi.refresh.job rows one at a time -->
        <record id="cron_bi_gold_refresh" model="ir.cron">
            <field name="name">BI: refresh gold datasets</field>
            <field name="model_id" ref="model_bi_refresh_job"/>
            <field name="state">code</field>
            <field name="code">model._process_refresh_queue()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Scheduled dashboard email snapshots -->
        <record id="cron_bi_snapshot" model="ir.cron">
            <field name="name">BI: email dashboard snapshots</field>
            <field name="model_id" ref="model_bi_dashboard"/>
            <field name="state">code</field>
            <field name="code">model._process_snapshot_queue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Query cache vacuum: drop expired entries, trim oversized cache -->
        <record id="cron_bi_cache_vacuum" model="ir.cron">
            <field name="name">BI: vacuum query cache</field>
            <field name="model_id" ref="model_bi_query_cache"/>
            <field name="state">code</field>
            <field name="code">model._vacuum()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
