<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= Workspace ================= -->
    <record id="view_bi_workspace_list" model="ir.ui.view">
        <field name="name">bi.workspace.list</field>
        <field name="model">bi.workspace</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="owner_id"/>
                <field name="dataset_count"/>
                <field name="dashboard_count"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="view_bi_workspace_form" model="ir.ui.view">
        <field name="name">bi.workspace.form</field>
        <field name="model">bi.workspace</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="owner_id"/>
                            <field name="is_default"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="member_ids" widget="many2many_tags"/>
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="company_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What lives in this workspace?"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= Source ================= -->
    <record id="view_bi_source_list" model="ir.ui.view">
        <field name="name">bi.source.list</field>
        <field name="model">bi.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field name="model_name"/>
                <field name="view_name"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'ready'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="view_bi_source_form" model="ir.ui.view">
        <field name="name">bi.source.form</field>
        <field name="model">bi.source</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="model_id"
                                   invisible="type != 'odoo_model'"
                                   required="type == 'odoo_model'"/>
                            <field name="view_name"
                                   invisible="type != 'sql_view'"
                                   required="type == 'sql_view'"/>
                            <field name="connector_type"
                                   invisible="type != 'external'"/>
                        </group>
                        <group>
                            <field name="last_sync"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================= Dataset ================= -->
    <record id="view_bi_dataset_list" model="ir.ui.view">
        <field name="name">bi.dataset.list</field>
        <field name="model">bi.dataset</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="workspace_id"/>
                <field name="storage_mode"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"/>
                <field name="is_certified"/>
                <field name="chart_count"/>
            </list>
        </field>
    </record>

    <record id="view_bi_dataset_form" model="ir.ui.view">
        <field name="name">bi.dataset.form</field>
        <field name="model">bi.dataset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" type="object"
                            string="Publish" class="btn-primary"
                            invisible="state == 'published'"/>
                    <button name="action_publish" type="object"
                            string="Re-publish"
                            invisible="state != 'published'"/>
                    <button name="action_unpublish" type="object"
                            string="Unpublish"
                            invisible="state != 'published'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Dataset name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="workspace_id"/>
                            <field name="storage_mode"/>
                            <field name="grain"/>
                            <field name="is_certified"/>
                        </group>
                        <group>
                            <field name="company_field_id"
                                   domain="[('dataset_id', '=', id)]"/>
                            <field name="refresh_job_id"/>
                            <field name="freshness_at"/>
                            <field name="has_fanout"/>
                        </group>
                    </group>
                    <field name="description"
                           placeholder="Business description (shown to users and to the AI)"/>
                    <notebook>
                        <page string="Nodes">
                            <field name="node_ids">
                                <list editable="bottom">
                                    <field name="source_id"/>
                                    <field name="is_root"/>
                                    <field name="alias"/>
                                    <button name="action_scan_fields"
                                            type="object" string="Scan Fields"
                                            icon="fa-refresh"/>
                                </list>
                            </field>
                        </page>
                        <page string="Relationships">
                            <field name="relationship_ids">
                                <list editable="bottom">
                                    <field name="parent_node_id"
                                           domain="[('dataset_id', '=', parent.id)]"/>
                                    <field name="parent_field"/>
                                    <field name="child_node_id"
                                           domain="[('dataset_id', '=', parent.id)]"/>
                                    <field name="child_field"/>
                                    <field name="join_type"/>
                                    <field name="cardinality"/>
                                    <field name="origin"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fields">
                            <field name="field_ids">
                                <list editable="bottom" limit="200">
                                    <field name="node_id" column_invisible="1"/>
                                    <field name="technical_name" readonly="origin == 'stored'"/>
                                    <field name="name"/>
                                    <field name="role"/>
                                    <field name="data_type"/>
                                    <field name="default_agg"/>
                                    <field name="folder"/>
                                    <field name="visibility"/>
                                    <field name="is_filterable"/>
                                    <field name="origin"/>
                                    <field name="expression"
                                           readonly="origin != 'calculated'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= Refresh jobs ================= -->
    <record id="view_bi_refresh_job_list" model="ir.ui.view">
        <field name="name">bi.refresh.job.list</field>
        <field name="model">bi.refresh.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="dataset_id"/>
                <field name="interval_minutes"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'running'"/>
                <field name="last_refresh"/>
                <field name="last_duration_ms"/>
                <field name="matview_size"/>
                <field name="next_run"/>
                <button name="action_refresh_now" type="object"
                        string="Refresh Now" icon="fa-refresh"/>
            </list>
        </field>
    </record>

    <!-- ================= Access rules ================= -->
    <record id="view_bi_access_rule_list" model="ir.ui.view">
        <field name="name">bi.access.rule.list</field>
        <field name="model">bi.access.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="dataset_id"/>
                <field name="rule_type"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_bi_access_rule_form" model="ir.ui.view">
        <field name="name">bi.access.rule.form</field>
        <field name="model">bi.access.rule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_preview" type="object"
                            string="Preview Predicate"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="dataset_id"/>
                            <field name="rule_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="user_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group invisible="rule_type != 'row'">
                        <field name="domain_json" widget="json"/>
                    </group>
                    <group invisible="rule_type != 'column'">
                        <field name="field_ids" widget="many2many_tags"
                               domain="[('dataset_id', '=', dataset_id)]"/>
                        <field name="mask_mode"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================= Glossary ================= -->
    <record id="view_bi_glossary_list" model="ir.ui.view">
        <field name="name">bi.glossary.term.list</field>
        <field name="model">bi.glossary.term</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="definition"/>
                <field name="formula_note"/>
                <field name="owner_id"/>
            </list>
        </field>
    </record>

    <!-- ================= AI Provider ================= -->
    <record id="view_bi_ai_provider_list" model="ir.ui.view">
        <field name="name">bi.ai.provider.list</field>
        <field name="model">bi.ai.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="provider"/>
                <field name="model_name"/>
                <field name="has_api_key"/>
                <field name="is_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_bi_ai_provider_form" model="ir.ui.view">
        <field name="name">bi.ai.provider.form</field>
        <field name="model">bi.ai.provider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="provider"/>
                            <field name="endpoint"/>
                            <field name="model_name"/>
                        </group>
                        <group>
                            <field name="api_key_input" password="True"/>
                            <field name="has_api_key"/>
                            <field name="is_default"/>
                            <field name="active"/>
                            <field name="max_tokens"/>
                            <field name="temperature"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================= Audit log ================= -->
    <record id="view_bi_audit_log_list" model="ir.ui.view">
        <field name="name">bi.audit.log.list</field>
        <field name="model">bi.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="created_at"/>
                <field name="user_id"/>
                <field name="event"/>
                <field name="dataset_id"/>
                <field name="res_model"/>
            </list>
        </field>
    </record>

    <!-- ================= Dataset wizard ================= -->
    <record id="view_bi_dataset_wizard_form" model="ir.ui.view">
        <field name="name">bi.dataset.wizard.form</field>
        <field name="model">bi.dataset.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="workspace_id"/>
                    <field name="model_id"/>
                    <field name="auto_join_lookups"/>
                </group>
                <footer>
                    <button name="action_create" type="object"
                            string="Create Dataset" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ================= CSV import wizard ================= -->
    <record id="view_bi_csv_import_wizard_form" model="ir.ui.view">
        <field name="name">bi.csv.import.wizard.form</field>
        <field name="model">bi.csv.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="has_header"/>
                    <field name="date_format_hint"/>
                    <field name="existing_source_id"/>
                    <field name="create_dataset"
                           invisible="existing_source_id"/>
                    <field name="workspace_id"
                           invisible="not create_dataset or existing_source_id"/>
                </group>
                <footer>
                    <button name="action_import" type="object"
                            string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ================= Window actions ================= -->
    <record id="action_bi_workspace" model="ir.actions.act_window">
        <field name="name">Workspaces</field>
        <field name="res_model">bi.workspace</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bi_source" model="ir.actions.act_window">
        <field name="name">Data Sources</field>
        <field name="res_model">bi.source</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bi_dataset" model="ir.actions.act_window">
        <field name="name">Datasets</field>
        <field name="res_model">bi.dataset</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bi_dataset_wizard" model="ir.actions.act_window">
        <field name="name">New Dataset</field>
        <field name="res_model">bi.dataset.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_bi_csv_import" model="ir.actions.act_window">
        <field name="name">Import CSV / Excel</field>
        <field name="res_model">bi.csv.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_bi_refresh_job" model="ir.actions.act_window">
        <field name="name">Refresh Jobs</field>
        <field name="res_model">bi.refresh.job</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_bi_access_rule" model="ir.actions.act_window">
        <field name="name">Access Rules</field>
        <field name="res_model">bi.access.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bi_glossary" model="ir.actions.act_window">
        <field name="name">Business Glossary</field>
        <field name="res_model">bi.glossary.term</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_bi_ai_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">bi.ai.provider</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bi_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">bi.audit.log</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
