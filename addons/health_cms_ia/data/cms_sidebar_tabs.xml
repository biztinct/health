<?xml version="1.0" encoding="utf-8"?>
<!--
    THE NEW TABS — the headings the consolidation groups existing screens under.

    Each one is a tab in the shell M1 drew: it has NO screen of its own, so it
    opens the first screen inside it (ledger §5.225), and the screens inside it
    are the segments. The hook (`hooks.py`) moves the existing rows under them,
    writes the actions they answer for, and switches off any that ends up with
    nothing inside it on a database where a module is missing.

    noupdate="1" ON PURPOSE. Once a heading exists it belongs to the clinic:
    somebody may rename it or reorder it from the Menu screen, and an upgrade
    must not undo that. The same rule is why the hook writes the rows it moves
    rather than a data file (ledger §5.116).

    NO GATE IS WRITTEN HERE. A heading with no roles of its own and no screen
    of its own is opened by whoever opens something inside it
    (`health_access` `_compute_effective_biz_role_ids`), which is the only way
    one heading can hold screens for different people without widening any of
    them. `parent_id` is written explicitly False (ledger §5.69b).
-->
<odoo noupdate="1">

    <!-- ============================== CRM ============================== -->
    <record id="parent_crm_channels" model="cms.sidebar.item">
        <field name="name">Channels</field>
        <field name="section_id" ref="health_cms_sidebar.section_crm"/>
        <field name="parent_id" eval="False"/>
        <field name="sequence">30</field>
        <field name="icon">fa fa-comments-o</field>
    </record>
