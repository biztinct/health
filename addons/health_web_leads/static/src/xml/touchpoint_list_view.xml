<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- Structure and class names are copied verbatim from
     health_fieldservice/static/src/xml/ops_client_list_view.xml so the chip bar
     is pixel-identical to Clients/Contacts and this module ships NO new CSS. -->
<t t-name="health_web_leads.TouchpointListView" t-inherit="web.ListView"
   t-inherit-mode="primary">
    <xpath expr="//t[@t-component='props.Renderer']" position="before">
        <div class="ops-cl-tabs">
            <t t-foreach="tabs" t-as="tab" t-key="tab.id">
                <button t-attf-class="ops-cl-tab #{tabState.activeTab === tab.id ? 'active' : ''}"
                        t-on-click="() => this.setTab(tab.id)">
                    <i t-attf-class="fa #{tab.icon}"/>
                    <t t-esc="tab.label"/>
                </button>
            </t>
        </div>
        <!-- Occurred-at date filter -->
        <div class="ops-cl-date-filters">
            <span class="ops-cl-date-lbl">Occurred</span>
            <t t-foreach="dateTabs" t-as="dt" t-key="dt.id">
                <button t-attf-class="ops-cl-date-btn #{tabState.dateFilter === dt.id ? 'active' : ''}"
                        t-on-click="() => this.setDateFilter(dt.id)">
                    <t t-esc="dt.label"/>
                </button>
            </t>
            <button t-attf-class="ops-cl-date-btn #{tabState.dateFilter === 'custom' ? 'active' : ''}"
                    t-on-click="() => this.setDateFilter('custom')">Custom</button>
            <t t-if="tabState.dateFilter === 'custom'">
                <input type="date" class="ops-cl-date-input"
                       t-att-value="tabState.customFrom"
                       t-on-change="(ev) => this.onCustomDate('from', ev)"
                       title="From"/>
                <span class="ops-cl-date-dash">–</span>
                <input type="date" class="ops-cl-date-input"
                       t-att-value="tabState.customTo"
                       t-on-change="(ev) => this.onCustomDate('to', ev)"
                       title="To"/>
            </t>
        </div>
    </xpath>
</t>

</templates>
