<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Catchment scoping for the Web Touchpoints / Campaign Review leaf.

        The Owner twin below is mandatory, not decorative: Odoo ORs the group
        rules matching ANY group the user is in, and membership of a group with
        no rule grants no exemption. group_healthcare_owner implies admin
        implies manager (health_security.xml:79-98), and manager is inside the
        scoped list — so without the twin an owner is pinned to one area by
        their own inherited groups.
    -->

    <record id="lead_touchpoint_catchment_rule" model="ir.rule">
        <field name="name">Lead Touchpoints: staff see their own catchment</field>
        <field name="model_id" ref="model_health_lead_touchpoint"/>
        <field name="domain_force">['&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False)]</field>
        <field name="groups" eval="[
            (4, ref('health_base.group_healthcare_sales')), 
            (4, ref('health_base.group_healthcare_operations_manager')), 
            (4, ref('health_base.group_healthcare_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="lead_touchpoint_catchment_rule_owner" model="ir.rule">
        <field name="name">Lead Touchpoints: Owner sees all catchments</field>
        <field name="model_id" ref="model_health_lead_touchpoint"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('health_base.group_healthcare_owner'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!--
        GA1 — company scoping for the touchpoint.

        A GLOBAL rule (no `groups`), deliberately: Odoo ORs the group rules
        above, so a company clause written as a group rule would be widened
        away by the Owner twin. A global rule ANDs with every group rule
        instead, which is exactly the semantics wanted — an owner sees every
        CATCHMENT, still only inside the companies they are allowed into.

        The `company_id = False` branch keeps any legacy row whose anchor
        never carried a company visible rather than vanishing it. The column
        is a stored compute over the lead / conversation, so it is never a
        value a user typed.
    -->
    <record id="lead_touchpoint_company_rule" model="ir.rule">
        <field name="name">Lead Touchpoints: own companies</field>
        <field name="model_id" ref="model_health_lead_touchpoint"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
