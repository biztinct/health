<?xml version="1.0" encoding="utf-8"?>
<!-- Ledger §5.69: a backend `menuitem` is NOT a reachable surface for the
     users who live in the /bizapp CMS shell — a real login lands there,
     /odoo redirects back into it, and the app switcher lists only the
     shell's own apps. The `Sales & CRM › Configuration › Web Touchpoints`
     menu this module also ships is correct and group-gated, and for the
     CMS persona it does not exist. The sidebar seed is what makes the
     touchpoint list part of "done".

     Two traps from that same ledger entry, both avoided here:
       (a) seeded as a SIBLING leaf, never as a child of "Contacts" —
           `cms_sidebar.js:124` turns any item WITH children into a
           non-navigating expandable group, which would break the parent;
       (b) no `parent_id` written at all (an omitted field is not an unset
           field on a data update, so there is nothing to unset later).

     NO noupdate: the item stays updatable on upgrade. Ungated (no
     `role_ids`) like the sibling Contacts / Care Command items — the
     `health.lead.touchpoint` ACLs are what actually govern the rows. -->
<odoo>

    <record id="item_web_touchpoints" model="cms.sidebar.item">
        <field name="name">Web Touchpoints</field>
        <field name="section_id" ref="health_cms_sidebar.section_crm"/>
        <field name="sequence">21</field>
        <field name="icon">fa fa-crosshairs</field>
        <field name="action_xmlid">health_web_leads.action_health_lead_touchpoint</field>
        <!-- Campaign Review was retired by the 19.0.1.2.0 menu consolidation —
             it was this same model with a different domain, and is now the
             "Unmatched Campaigns" chip on this list. Its action must stay in
             the shell allowlist or that screen opens outside the CMS chrome.

             Declared HERE, in the owning module's own seed, rather than
             appended by health_cms_coverage's hook: this file is noupdate="0",
             so every upgrade of health_web_leads rewrites this record and would
             silently wipe an externally-appended value. (Measured — that is
             exactly what happened on the first UAT run.) -->
        <field name="match_action_xmlids">health_web_leads.action_health_lead_touchpoint,health_web_leads.action_campaign_review</field>
        <field name="match_models">health.lead.touchpoint</field>
    </record>

    <!-- W2.5. `fa fa-plug` is already the Channel Center's icon, so this one
         takes `fa fa-globe`. Same two §5.69 traps avoided as above: a leaf
         SIBLING, and no `parent_id` field at all. Ungated — the
         `web.leads.connector` ACLs are what govern who sees rows.

         SECTION: ADMIN, not CRM. The 19.0.1.2.0 menu consolidation moved the
         configuration tables out of the daily-work sections; this is a
         singleton config record ("Website connector"), not something anyone
         opens during a shift.

         Declared HERE rather than relocated by health_cms_coverage's hook
         because this file is noupdate="0": every upgrade of health_web_leads
         rewrites this record and would drag it back into CRM. (Measured — that
         is exactly what happened on the UAT run.)

         Moving it also resolves the sequence-13 collision it had with
         health_care_command_channels' "Unrouted Contacts", where ordering fell
         through to `id`. -->
    <record id="item_web_leads_connector" model="cms.sidebar.item">
        <field name="name">Website Connector</field>
        <field name="section_id" ref="health_cms_sidebar.section_admin"/>
        <field name="sequence">112</field>
        <field name="icon">fa fa-globe</field>
        <field name="action_xmlid">health_web_leads.action_web_leads_connector</field>
        <field name="match_action_xmlids">health_web_leads.action_web_leads_connector</field>
        <field name="match_models">web.leads.connector</field>
    </record>

    <!-- W3. Sequences VERIFIED against the live table before choosing
         (handover fact #9): section_crm holds 10 Dashboard, 11 Care Command,
         12 Channel Center, 13 Website Connector, 20 Contacts, 21 Web
         Touchpoints, 50 Activities — so 22 and 23 are free and put the two
         new surfaces next to the touchpoint list they read from. Same two
         §5.69 traps avoided: leaf SIBLINGS, and no `parent_id` field at
         all. Ungated — the underlying ACLs govern the rows.

         A THIRD trap, found by reading `cms_sidebar.js:50-100` rather than
         copying the neighbours: `_buildMatchIndex` stores `match_models` in
         a LAST-WINS map keyed by model name, and `_resolveActiveItem` falls
         back to it whenever the current action has no xml_id. Neither new
         leaf therefore declares `match_models` — `crm.lead` already belongs
         to Contacts (seq 20) and `health.lead.touchpoint` to Web
         Touchpoints (21), and a higher sequence would silently STEAL their
         highlight on every action opened without an xml_id. The action
         xml-ids below are the exact index and are checked first. -->
    <!-- RETIRED by the 19.0.1.2.0 menu consolidation. This was the same
         health.lead.touchpoint model as Web Touchpoints (seq 21) with only a
         different domain, so it is now the "Unmatched Campaigns" chip on that
         list (static/src/js/touchpoint_list_view.js) — one screen instead of
         two menu items for the same records.

         Kept as a row with active="False" rather than deleted: the action and
         the backend menuitem still exist, so deep links keep resolving, and
         the retirement is one field away from being undone.

         `active` is declared HERE rather than written by
         health_cms_coverage's hook because this file is noupdate="0" — an
         upgrade of this module rewrites the record and would resurrect the
         leaf. (Guarded by test_05b_hook_never_writes_an_updatable_record.) -->
    <record id="item_campaign_review" model="cms.sidebar.item">
        <field name="name">Campaign Review</field>
        <field name="active" eval="False"/>
        <field name="section_id" ref="health_cms_sidebar.section_crm"/>
        <field name="sequence">22</field>
        <field name="icon">fa fa-bullhorn</field>
        <field name="action_xmlid">health_web_leads.action_campaign_review</field>
        <field name="match_action_xmlids">health_web_leads.action_campaign_review</field>
    </record>

    <record id="item_lead_analysis" model="cms.sidebar.item">
        <field name="name">Lead Analysis</field>
        <field name="section_id" ref="health_cms_sidebar.section_crm"/>
        <field name="sequence">23</field>
        <field name="icon">fa fa-bar-chart</field>
        <field name="action_xmlid">health_web_leads.action_web_leads_funnel</field>
        <field name="match_action_xmlids">health_web_leads.action_web_leads_funnel</field>
    </record>

</odoo>
