msgstr "%s đã xoá người nhận cảnh báo giao dữ liệu — cảnh báo sẽ chuyển về cho quản trị viên cổng API."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
msgid "Credentials issued by %(user)s: service account %(login)s, OAuth client %(client)s. The secret was shown once and is not stored anywhere."
msgstr "%(user)s đã cấp thông tin xác thực: tài khoản dịch vụ %(login)s, ứng dụng OAuth %(client)s. Mã bí mật chỉ hiển thị một lần và không được lưu ở bất kỳ đâu."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
