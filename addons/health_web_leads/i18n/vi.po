msgstr "Kết nối website: luồng xử lý đạt"

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
msgid "There is nothing to disconnect yet — no credentials have been issued."
msgstr "Chưa có gì để ngắt kết nối — chưa cấp thông tin xác thực nào."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
msgid "Website disconnected by %(user)s: OAuth client %(client)s is archived, so its tokens no longer authenticate. The record is kept for the audit trail."
msgstr "%(user)s đã ngắt kết nối website: ứng dụng OAuth %(client)s đã được lưu trữ nên các token của nó không còn xác thực được. Bản ghi vẫn được giữ để phục vụ nhật ký kiểm toán."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
msgid "Website disconnected"
msgstr "Đã ngắt kết nối website"

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
msgid "The WordPress relay can no longer submit leads. Reconnect restores the client — rotate the secret afterwards."
msgstr "Bộ chuyển tiếp WordPress không thể gửi lead nữa. Kết nối lại sẽ khôi phục ứng dụng OAuth — sau đó hãy đổi mã bí mật."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
msgid "There are no credentials to reconnect — use Get credentials instead."
msgstr "Không có thông tin xác thực nào để kết nối lại — hãy dùng Lấy thông tin xác thực."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
msgid "Website reconnected by %(user)s. Rotate the secret unless the website still holds the previous one."
msgstr "%(user)s đã kết nối lại website. Hãy đổi mã bí mật, trừ khi website vẫn đang giữ mã cũ."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
msgid "Website reconnected"
msgstr "Đã kết nối lại website"

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
msgid "Rotate the secret unless the website still holds the previous one."
msgstr "Hãy đổi mã bí mật, trừ khi website vẫn đang giữ mã cũ."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
msgid "Only a system administrator, a CRM manager or a user administrator may operate the website connector."
msgstr "Chỉ quản trị viên hệ thống, quản lý CRM hoặc quản trị viên người dùng mới được vận hành phần kết nối website."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
msgid "The %s is not valid JSON. Expected an object such as {\"15838\": \"HN\", \"15670\": \"HCM\"}."
msgstr "%s không phải JSON hợp lệ. Cần một đối tượng dạng {\"15838\": \"HN\", \"15670\": \"HCM\"}."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
msgid "The %s must be a JSON object, not a list or a plain value."
msgstr "%s phải là một đối tượng JSON, không phải danh sách hay giá trị đơn."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
msgid "The %s has an entry with an empty key."
msgstr "%s có một mục với khoá rỗng."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
msgid "The %(label)s entry \"%(key)s\" maps to \"%(value)s\", which is not a city. Use \"HN\" for Hà Nội or \"HCM\" for Hồ Chí Minh."
msgstr "Mục \"%(key)s\" trong %(label)s trỏ tới \"%(value)s\", đây không phải một thành phố. Hãy dùng \"HN\" cho Hà Nội hoặc \"HCM\" cho Hồ Chí Minh."
