<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_google_ads_account_select_form" model="ir.ui.view">
        <field name="name">google.ads.account.select.form</field>
        <field name="model">google.ads.account.select</field>
        <field name="arch" type="xml">
            <form string="Choose the advertising account">
                <field name="account_id" invisible="1"/>
                <div class="text-muted">
                    <p>Google's permission covers your whole Google Ads access.
                       This system only reads account names, campaigns, spend,
                       clicks and conversions. It never changes anything in
                       Google Ads.</p>
                </div>
                <field name="line_ids" nolabel="1">
                    <list string="Advertising accounts" editable="bottom"
                          create="false" delete="false">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="name" readonly="1"/>
                        <field name="customer_id" readonly="1"/>
                        <field name="login_customer_id" readonly="1"
                               optional="show"/>
                        <field name="currency" readonly="1"/>
                        <field name="time_zone" readonly="1" optional="hide"/>
                        <field name="status" readonly="1"
                               decoration-muted="status != 'ENABLED'"/>
                        <field name="test_account" readonly="1"
                               optional="hide"/>
                        <field name="is_manager" readonly="1"
                               optional="hide"/>
                    </list>
                </field>
                <div class="text-muted" invisible="line_ids">
                    <p>No advertising account is visible to the Google account
                       you signed in with. Sign in with the account that
                       manages the ads, or ask the ads manager to grant
                       access.</p>
                </div>
                <footer>
                    <button string="Use this one" name="action_use"
                            type="object" class="btn-primary"/>
                    <button string="Refresh list" name="action_refresh"
                            type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
