<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Company scoping for the advertising account and its campaign mappings.

        GLOBAL rules (no `groups`), deliberately: Odoo ORs the group rules a
        user matches, so a company clause written as a group rule would be
        widened away the moment a user is also in a group carrying a
        sees-everything rule. A global rule ANDs with every group rule
        instead, which is exactly the semantics wanted — company ownership is
        not a privilege anybody outranks.
    -->

    <record id="google_ads_account_company_rule" model="ir.rule">
        <field name="name">Google Ads accounts: own companies</field>
        <field name="model_id" ref="model_google_ads_account"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="google_ads_campaign_company_rule" model="ir.rule">
        <field name="name">Google Ads campaigns: own companies</field>
        <field name="model_id" ref="model_google_ads_campaign"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- GA3. The daily cache, the report view and the honesty log all carry
         `company_id`, and all three get the same GLOBAL company clause for the
         same reason: money figures must never cross a clinic boundary, and a
         company clause written as a group rule would be OR-ed away by any
         sees-everything group rule a user also matches. -->

    <record id="google_ads_campaign_day_company_rule" model="ir.rule">
        <field name="name">Google Ads daily figures: own companies</field>
        <field name="model_id" ref="model_google_ads_campaign_day"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="google_ads_sync_run_company_rule" model="ir.rule">
        <field name="name">Google Ads sync history: own companies</field>
        <field name="model_id" ref="model_google_ads_sync_run"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="google_ads_campaign_stat_company_rule" model="ir.rule">
        <field name="name">Google Ads report: own companies</field>
        <field name="model_id" ref="model_google_ads_campaign_stat"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
