msgstr "Kiểm tra luồng website THẤT BẠI cho %(user)s: %(reason)s"

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid "Google Ads: website test failed"
msgstr "Google Ads: kiểm tra website thất bại"

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
