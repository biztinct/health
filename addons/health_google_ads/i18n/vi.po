# ------------------------------------------------------- validation + gates
#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid "%(label)s must be exactly ten digits, with no hyphens or spaces."
msgstr "%(label)s phải gồm đúng mười chữ số, không có dấu gạch ngang hay khoảng trắng."

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid ""
"The website connector \"%(connector)s\" belongs to %(their)s, but this "
"advertising account belongs to %(ours)s."
msgstr "Kết nối website \"%(connector)s\" thuộc về %(their)s, nhưng tài khoản quảng cáo này thuộc về %(ours)s."

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid ""
"Customer ID %(customer)s is already used by \"%(name)s\" (%(company)s). One "
"Google Ads customer belongs to one company — open that account instead of "
"creating a second one."
msgstr "Mã khách hàng %(customer)s đã được \"%(name)s\" (%(company)s) sử dụng. Một khách hàng Google Ads chỉ thuộc về một công ty — hãy mở tài khoản đó thay vì tạo tài khoản thứ hai."

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid ""
"There is already a Google Ads account without a customer ID for this company "
"(\"%s\"). Give that one its customer ID instead of creating a second draft."
msgstr "Đã có một tài khoản Google Ads chưa nhập mã khách hàng cho công ty này (\"%s\"). Hãy nhập mã khách hàng cho tài khoản đó thay vì tạo bản nháp thứ hai."

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid ""
"Only a system administrator, a CRM manager, a clinic administrator or an "
"owner may set up Google Ads."
msgstr "Chỉ quản trị viên hệ thống, quản lý CRM, quản trị viên phòng khám hoặc chủ sở hữu mới được thiết lập Google Ads."

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_campaign.py:0
msgid ""
"Only a system administrator, a CRM manager, a clinic administrator or an "
"owner may set up Google Ads campaigns."
msgstr "Chỉ quản trị viên hệ thống, quản lý CRM, quản trị viên phòng khám hoặc chủ sở hữu mới được thiết lập chiến dịch Google Ads."

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid ""
"Only a platform administrator can change whether Google lead forms are "
"available, and only against a written policy finding."
msgstr "Chỉ quản trị viên nền tảng mới được thay đổi trạng thái khả dụng của biểu mẫu Google, và chỉ khi có kết luận chính sách bằng văn bản."

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid ""
"A Google Ads account is kept for its history. Archive it instead — only a "
"system administrator can delete one."
msgstr "Tài khoản Google Ads được giữ lại để lưu lịch sử. Hãy lưu trữ tài khoản — chỉ quản trị viên hệ thống mới được xóa."

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_campaign.py:0
msgid "A Google campaign ID is digits only, with no spaces — \"%s\" is not one."
msgstr "Mã chiến dịch Google chỉ gồm chữ số, không có khoảng trắng — \"%s\" không hợp lệ."

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/lead_touchpoint.py:0
msgid ""
"This touch belongs to %(ours)s, but the Google Ads account \"%(account)s\" "
"belongs to %(theirs)s."
msgstr "Lượt tiếp cận này thuộc %(ours)s, nhưng tài khoản Google Ads \"%(account)s\" thuộc %(theirs)s."

# ------------------------------------------------------------ website test
#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid ""
"Link the website connector first — there is nothing to test the enquiry "
"against until this account knows which website its enquiries arrive from."
msgstr "Hãy liên kết kết nối website trước — chưa có gì để kiểm tra cho tới khi tài khoản này biết các yêu cầu đến từ website nào."

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid "No website connector is linked yet."
msgstr "Chưa liên kết kết nối website nào."

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid ""
"This checks this system only. A full round trip from the website becomes "
"available once the website connection piece is installed; until then, the "
"proof that Google's own values reach us is a real enquiry."
msgstr "Phần này chỉ kiểm tra hệ thống. Việc kiểm tra trọn vòng từ website sẽ khả dụng khi phần kết nối website được cài đặt; trước đó, bằng chứng rằng dữ liệu của Google đến được với chúng ta là một yêu cầu thật."

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid "FAILED: %s"
msgstr "THẤT BẠI: %s"

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid "the test produced nothing to inspect"
msgstr "lần kiểm tra không tạo ra dữ liệu nào để xem xét"

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
