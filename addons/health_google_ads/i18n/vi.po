#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid "Google Ads: website pipeline OK"
msgstr "Google Ads: luồng website hoạt động tốt"

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid "matched to this account"
msgstr "đã khớp với tài khoản này"

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid "not matched to any account"
msgstr "không khớp với tài khoản nào"

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid "matched, but the enquiry contradicts itself"
msgstr "đã khớp, nhưng yêu cầu này tự mâu thuẫn"

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid "not matched"
msgstr "chưa khớp"

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid ""
"Pipeline OK — a Google ad click on form %(form)s would be recorded as a "
"Google Ads enquiry, %(match)s. Nothing was saved."
msgstr "Luồng hoạt động tốt — một lượt nhấp quảng cáo Google trên biểu mẫu %(form)s sẽ được ghi nhận là yêu cầu từ Google Ads, %(match)s. Không có dữ liệu nào được lưu."

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid "Campaign ID carried through exactly: %s"
msgstr "Mã chiến dịch được giữ nguyên chính xác: %s"

#. module: health_google_ads
#. odoo-python
#: code:addons/health_google_ads/models/google_ads_account.py:0
msgid ""
"The synthetic enquiry resolved to \"%s\" rather than a new enquiry — an open "
"enquiry already matches the test phone number. The pipeline itself worked."
msgstr "Yêu cầu mô phỏng được xử lý thành \"%s\" thay vì một yêu cầu mới — đã có một yêu cầu đang mở trùng số điện thoại kiểm tra. Bản thân luồng xử lý vẫn hoạt động."

