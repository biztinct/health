<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kanban View -->
    <record id="view_shift_template_kanban" model="ir.ui.view">
        <field name="name">hr.shift.template.kanban</field>
        <field name="model">hr.shift.template</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <field name="name"/>
                <field name="code"/>
                <field name="shift_type"/>
                <field name="start_hour"/>
                <field name="end_hour"/>
                <field name="duration"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-start">
                            <div class="flex-grow-1">
                                <strong><field name="name"/></strong>
                                <div class="text-muted small">
                                    <field name="code"/>
                                </div>
                            </div>
                            <widget name="web_ribbon" title="Night"
                                    invisible="shift_type != 'night'"
                                    bg_color="text-bg-dark"/>
                        </div>
                        <div class="mt-2">
                            <span class="badge text-bg-primary">
                                <i class="fa fa-clock-o"/> <field name="duration"/> hrs
                            </span>
                            <span class="badge text-bg-secondary ms-1">
                                <field name="shift_type"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_shift_template_form" model="ir.ui.view">
        <field name="name">hr.shift.template.form</field>
        <field name="model">hr.shift.template</field>
        <field name="arch" type="xml">
            <form string="Shift Template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Morning Shift"/></h1>
                    </div>
                    <group>
                        <group string="Shift Details">
                            <field name="code"/>
                            <field name="shift_type"/>
                            <field name="is_overnight"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group string="Timing">
                            <field name="start_hour" widget="float_time"/>
                            <field name="end_hour" widget="float_time"/>
                            <field name="break_duration" widget="float_time"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="resource_calendar_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Additional notes about this shift..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_shift_template_list" model="ir.ui.view">
        <field name="name">hr.shift.template.list</field>
        <field name="model">hr.shift.template</field>
        <field name="arch" type="xml">
            <list string="Shift Templates" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="shift_type"/>
                <field name="start_hour" widget="float_time"/>
                <field name="end_hour" widget="float_time"/>
                <field name="break_duration" widget="float_time"/>
                <field name="duration" widget="float_time"/>
                <field name="is_overnight"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_shift_template" model="ir.actions.act_window">
        <field name="name">Shift Templates</field>
        <field name="res_model">hr.shift.template</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
