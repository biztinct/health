              name="My Shifts"
              parent="menu_shift_management"
              action="action_my_shifts"
              sequence="2"/>

    <menuitem id="menu_shift_templates"
              name="Shift Templates"
              parent="menu_shift_management"
              action="action_shift_template"
              sequence="10"
              groups="hr_attendance.group_hr_attendance_manager"/>

    <!-- Overtime -->
    <menuitem id="menu_overtime"
              name="Overtime"
              parent="menu_workforce_root"
              sequence="20"/>

    <menuitem id="menu_overtime_requests"
              name="Overtime Requests"
              parent="menu_overtime"
              action="action_overtime_request"
              sequence="1"/>

    <menuitem id="menu_overtime_to_approve"
