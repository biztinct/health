    <menuitem id="menu_workforce_config"
              name="Configuration"
              parent="menu_workforce_root"
              sequence="90"
              groups="hr_attendance.group_hr_attendance_manager"/>

    <menuitem id="menu_overtime_config"
              name="Overtime Rules"
              parent="menu_workforce_config"
              action="action_overtime_config"
              sequence="1"/>

    <menuitem id="menu_shift_templates_config"
              name="Shift Templates"
              parent="menu_workforce_config"
              action="action_shift_template"
              sequence="2"/>

