<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Workforce Management Menu Structure -->
    <menuitem id="menu_workforce_root"
              name="Workforce"
              web_icon="pb_hr_workforce,static/description/icon.png"
              groups="hr_attendance.group_hr_attendance_officer"
              sequence="245"/>

    <!-- Dashboard -->
    <menuitem id="menu_workforce_dashboard"
              name="Dashboard"
              parent="menu_workforce_root"
              action="action_workforce_dashboard_server"
              sequence="1"/>

    <!-- Live Attendance -->
    <menuitem id="menu_attendance_live"
              name="Live Attendance"
              parent="menu_workforce_root"
              action="action_attendance_live"
              sequence="5"/>

    <!-- Timecards -->
    <menuitem id="menu_attendance_timecard"
              name="Timecards"
              parent="menu_workforce_root"
              action="action_attendance_timecard"
              sequence="6"/>

    <!-- Payroll Report -->
    <menuitem id="menu_payroll_report"
