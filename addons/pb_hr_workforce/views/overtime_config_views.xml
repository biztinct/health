<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Overtime Config List View — Enhanced with day/time columns -->
    <record id="view_overtime_config_list" model="ir.ui.view">
        <field name="name">hr.overtime.config.list</field>
        <field name="model">hr.overtime.config</field>
        <field name="arch" type="xml">
            <list string="Overtime Rules"
                  decoration-info="overtime_type == 'night'"
                  decoration-danger="overtime_type == 'holiday'"
                  decoration-warning="overtime_type == 'weekend'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="country_id"/>
                <field name="overtime_type"/>
                <field name="rate_multiplier"/>
                <field name="rate_display" string="Rate"/>
                <field name="applicable_days_display" string="Applies On"/>
                <field name="time_display" string="Time Window"/>
                <field name="threshold_hours" string="OT After (hrs)"/>
                <field name="max_hours_per_day"/>
                <field name="max_hours_per_month"/>
                <field name="requires_approval"/>
            </list>
        </field>
    </record>

    <!-- Overtime Config Form View — Deputy-style with day/time applicability -->
    <record id="view_overtime_config_form" model="ir.ui.view">
        <field name="name">hr.overtime.config.form</field>
        <field name="model">hr.overtime.config</field>
        <field name="arch" type="xml">
            <form string="Overtime Rule">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Vietnam — Weekday OT"/></h1>
                    </div>

                    <group>
                        <group string="Classification">
                            <field name="country_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="overtime_type"/>
                            <field name="requires_approval"/>
                        </group>
                        <group string="Rates &amp; Limits">
                            <field name="rate_multiplier"/>
                            <field name="rate_display" string="Effective Rate"/>
                            <field name="threshold_hours" string="OT Begins After (hrs)"
                                   help="Regular work hours per day. Overtime kicks in after this threshold."/>
                            <field name="max_hours_per_day"/>
                            <field name="max_hours_per_month"/>
                        </group>
                    </group>

                    <separator string="When Does This Rule Apply?"/>
                    <group>
                        <group string="Applicable Days of the Week">
                            <div class="d-flex gap-4 flex-wrap">
                                <field name="apply_monday"/>
                                <field name="apply_tuesday"/>
                                <field name="apply_wednesday"/>
                                <field name="apply_thursday"/>
                                <field name="apply_friday"/>
                                <field name="apply_saturday"/>
                                <field name="apply_sunday"/>
                            </div>
                            <field name="applicable_days_display" string="Summary" readonly="1"/>
                        </group>
                        <group string="Time Window">
                            <field name="time_from" widget="float_time" string="From"/>
                            <field name="time_to" widget="float_time" string="To"/>
                            <field name="time_display" string="Summary" readonly="1"/>
                        </group>
                    </group>

                    <separator string="How The System Classifies Attendance"/>
                    <div class="alert alert-info" role="alert">
                        <strong>🔍 Classification Logic:</strong>
                        The Timecard system automatically classifies each attendance record
                        into regular or overtime hours using this rule's configuration:
                        <ul class="mt-2 mb-0">
                            <li><b>Weekday OT:</b> Hours worked beyond the <b>threshold</b> on applicable weekdays become overtime.</li>
                            <li><b>Weekend OT:</b> ALL hours on Saturday/Sunday are overtime at this rate.</li>
                            <li><b>Holiday OT:</b> ALL hours on public holidays are overtime at this rate.</li>
                            <li><b>Night Premium:</b> Hours falling within the <b>time window</b> (e.g. 10 PM – 6 AM) earn the night premium.</li>
                            <li><b>Extended OT:</b> When OT hours exceed the <b>max OT hours/day</b>, the remaining hours escalate to this rule.</li>
                        </ul>
                    </div>

                    <field name="note" placeholder="Legal reference (e.g. Vietnam Labor Code Art. 98)..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_overtime_config" model="ir.actions.act_window">
        <field name="name">Overtime Rules</field>
        <field name="res_model">hr.overtime.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
