<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Overtime Request List View -->
    <record id="view_overtime_request_list" model="ir.ui.view">
        <field name="name">hr.overtime.request.list</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch" type="xml">
            <list string="Overtime Requests" default_order="date desc"
                  decoration-danger="state == 'refused'"
                  decoration-success="state == 'approved'"
                  decoration-warning="state == 'submitted'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date"/>
                <field name="overtime_type"/>
                <field name="planned_hours"/>
                <field name="approved_hours"/>
                <field name="rate_display" string="Rate"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'refused'"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'submitted'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Overtime Request Form View -->
    <record id="view_overtime_request_form" model="ir.ui.view">
        <field name="name">hr.overtime.request.form</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch" type="xml">
            <form string="Overtime Request">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-success" invisible="state != 'submitted'"
                            groups="hr_attendance.group_hr_attendance_manager"/>
                    <button name="action_refuse" string="Refuse" type="object"
                            class="btn-danger" invisible="state != 'submitted'"
                            groups="hr_attendance.group_hr_attendance_manager"/>
                    <button name="action_reset_draft" string="Reset" type="object"
                            class="btn-secondary"
                            invisible="state not in ('submitted', 'refused')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Refused"
                            bg_color="text-bg-danger"
                            invisible="state != 'refused'"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Request Details">
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="manager_id"/>
                            <field name="date"/>
                        </group>
                        <group string="Overtime Details">
                            <field name="overtime_type"/>
                            <field name="planned_hours"/>
                            <field name="approved_hours"
                                   invisible="state not in ('approved',)"/>
                            <field name="overtime_config_id"/>
                            <field name="rate_display" string="Rate Multiplier"/>
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Overtime Request Search View -->
    <record id="view_overtime_request_search" model="ir.ui.view">
        <field name="name">hr.overtime.request.search</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch" type="xml">
            <search string="Overtime Requests">
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter name="filter_my" string="My Requests"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="filter_to_approve" string="To Approve"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="filter_this_month" string="This Month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <group name="group_by">
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_type" string="OT Type"
                            context="{'group_by': 'overtime_type'}"/>
                    <filter name="group_month" string="Month"
                            context="{'group_by': 'date:month'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Overtime Request Pivot View -->
    <record id="view_overtime_request_pivot" model="ir.ui.view">
        <field name="name">hr.overtime.request.pivot</field>
        <field name="model">hr.overtime.request</field>
        <field name="arch" type="xml">
            <pivot string="Overtime Analysis">
                <field name="employee_id" type="row"/>
                <field name="overtime_type" type="col"/>
                <field name="approved_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_overtime_request" model="ir.actions.act_window">
        <field name="name">Overtime Requests</field>
        <field name="res_model">hr.overtime.request</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="view_overtime_request_search"/>

    </record>

    <record id="action_overtime_to_approve" model="ir.actions.act_window">
        <field name="name">OT To Approve</field>
        <field name="res_model">hr.overtime.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_overtime_request_search"/>
        <field name="domain">[('state', '=', 'submitted')]</field>
    </record>

    <record id="action_my_overtime" model="ir.actions.act_window">
        <field name="name">My Overtime</field>
        <field name="res_model">hr.overtime.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
    </record>

</odoo>
