<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Workforce Dashboard Form View -->
    <record id="view_workforce_dashboard_form" model="ir.ui.view">
        <field name="name">hr.workforce.dashboard.form</field>
        <field name="model">hr.workforce.dashboard</field>
        <field name="arch" type="xml">
            <form string="Workforce Dashboard" create="false"
                  class="workforce-dashboard">
                <sheet>
                    <!-- Hidden data fields for JS charts -->
                    <field name="chart_data" invisible="1"/>
                    <field name="display_name_computed" invisible="1"/>

                    <!-- Dashboard Header -->
                    <div class="wf-dash-header">
                        <div class="wf-dash-title">
                            <h1><i class="fa fa-tachometer"/> Workforce Dashboard</h1>
                        </div>
                        <div class="wf-dash-filters">
                            <group>
                                <field name="department_id" placeholder="All Departments"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                        </div>
                    </div>

                    <!-- KPI Cards Row -->
                    <div class="wf-kpi-row">
                        <div class="wf-kpi-card wf-kpi-present">
                            <div class="wf-kpi-icon"><i class="fa fa-users"/></div>
                            <div class="wf-kpi-body">
                                <div class="wf-kpi-value"><field name="present_today" nolabel="1"/></div>
                                <div class="wf-kpi-label">Present Today</div>
                                <div class="wf-kpi-sub">
                                    <field name="absent_today" nolabel="1"/> absent ·
                                    <field name="presence_rate" nolabel="1" widget="percentage"/> rate
                                </div>
                            </div>
                        </div>
                        <div class="wf-kpi-card wf-kpi-hours">
                            <div class="wf-kpi-icon"><i class="fa fa-clock-o"/></div>
                            <div class="wf-kpi-body">
                                <div class="wf-kpi-value"><field name="avg_hours_week" nolabel="1" digits="[3,1]"/></div>
                                <div class="wf-kpi-label">Avg Hours / Employee This Week</div>
                            </div>
                        </div>
                        <div class="wf-kpi-card wf-kpi-overtime">
                            <div class="wf-kpi-icon"><i class="fa fa-hourglass-half"/></div>
                            <div class="wf-kpi-body">
                                <div class="wf-kpi-value"><field name="ot_hours_month" nolabel="1" digits="[5,1]"/></div>
                                <div class="wf-kpi-label">OT Hours This Period</div>
                                <div class="wf-kpi-sub">
                                    <field name="pending_ot_requests" nolabel="1"/> pending approvals
                                </div>
                            </div>
                        </div>
                        <div class="wf-kpi-card wf-kpi-leaves">
                            <div class="wf-kpi-icon"><i class="fa fa-plane"/></div>
                            <div class="wf-kpi-body">
                                <div class="wf-kpi-value"><field name="pending_leaves" nolabel="1"/></div>
                                <div class="wf-kpi-label">Pending Leave Requests</div>
                                <div class="wf-kpi-sub">
                                    <field name="shift_compliance_rate" nolabel="1" widget="percentage"/> shift compliance
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Charts Section -->
                    <div class="wf-charts-row">
                        <div class="wf-chart-card">
                            <div class="wf-chart-title"><i class="fa fa-bar-chart"/> Attendance by Day</div>
                            <div class="wf-chart-wrapper">
                                <canvas id="wfChartAttendance"></canvas>
                            </div>
                        </div>
                        <div class="wf-chart-card">
                            <div class="wf-chart-title"><i class="fa fa-line-chart"/> Hours Trend (Last 8 Weeks)</div>
                            <div class="wf-chart-wrapper">
                                <canvas id="wfChartHoursTrend"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="wf-charts-row">
                        <div class="wf-chart-card">
                            <div class="wf-chart-title"><i class="fa fa-building"/> OT by Department</div>
                            <div class="wf-chart-wrapper">
                                <canvas id="wfChartOTDept"></canvas>
                            </div>
                        </div>
                        <div class="wf-chart-card">
                            <div class="wf-chart-title"><i class="fa fa-pie-chart"/> Leave Distribution</div>
                            <div class="wf-chart-wrapper">
                                <canvas id="wfChartLeaves"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="wf-quick-actions">
                        <h3><i class="fa fa-bolt"/> Quick Actions</h3>
                        <div class="wf-action-buttons">
                            <a type="action" name="%(pb_hr_workforce.action_shift_planning_no_filter)d"
                               class="btn btn-outline-primary">
                                <i class="fa fa-calendar"/> View Roster
                            </a>
                            <a type="action" name="%(pb_hr_workforce.action_overtime_to_approve)d"
                               class="btn btn-outline-warning">
                                <i class="fa fa-hourglass"/> Approve Overtime
                            </a>
                            <a type="action" name="%(hr_holidays.hr_leave_action_action_approve_department)d"
                               class="btn btn-outline-success">
                                <i class="fa fa-plane"/> Approve Leaves
                            </a>
                            <a type="action" name="%(hr_attendance.hr_attendance_action)d"
                               class="btn btn-outline-info">
                                <i class="fa fa-clock-o"/> All Attendance
                            </a>
                        </div>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Server action to open dashboard (creates transient record with proper name) -->
    <record id="action_workforce_dashboard_server" model="ir.actions.server">
        <field name="name">Workforce Dashboard</field>
        <field name="model_id" ref="model_hr_workforce_dashboard"/>
        <field name="state">code</field>
        <field name="code">
record = env['hr.workforce.dashboard'].create({})
action = {
    'type': 'ir.actions.act_window',
    'name': 'Workforce Dashboard',
    'res_model': 'hr.workforce.dashboard',
    'res_id': record.id,
    'view_mode': 'form',
    'target': 'current',
    'flags': {'mode': 'edit'},
}
        </field>
    </record>

    <!-- Fallback window action (form view directly) -->
    <record id="action_workforce_dashboard" model="ir.actions.act_window">
        <field name="name">Workforce Dashboard</field>
        <field name="res_model">hr.workforce.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
