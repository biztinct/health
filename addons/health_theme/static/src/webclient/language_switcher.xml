<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- The whole control is behind `hasChoice`: on a database with one
         language installed this renders nothing rather than a dropdown whose
         only entry is the language you are already in. -->
    <t t-name="health_theme.LanguageSwitcher">
        <div t-if="hasChoice" class="vu-language-switcher">
            <Dropdown position="'bottom-end'" disabled="state.switching">
                <button
                    class="vu-language-switcher__toggle"
                    type="button"
                    t-att-title="currentLabel"
                    t-att-aria-label="toggleAriaLabel"
                    t-att-disabled="state.switching"
                >
                    <i class="fa fa-globe" aria-hidden="true"/>
                    <span class="vu-language-switcher__code" t-esc="currentShortCode"/>
                    <i class="fa fa-angle-down vu-language-switcher__chevron" aria-hidden="true"/>
                </button>
                <t t-set-slot="content">
                    <div class="vu-language-switcher__heading">Language</div>
                    <DropdownItem
                        t-foreach="state.languages"
                        t-as="language"
                        t-key="language.code"
                        class="{ 'vu-language-switcher__item--current': language.code === currentCode }"
                        attrs="{
                            'aria-current': language.code === currentCode ? 'true' : undefined,
                            'data-language-code': language.code,
                        }"
                        onSelected="() => this.selectLanguage(language.code)"
                    >
                        <span class="vu-language-switcher__name" t-esc="language.name"/>
                        <span class="vu-language-switcher__meta">
                            <i t-if="language.code === currentCode"
                               class="fa fa-check"
                               aria-label="Current language"/>
                        </span>
                    </DropdownItem>
                </t>
            </Dropdown>
        </div>
    </t>

</templates>
