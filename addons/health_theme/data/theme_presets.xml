<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Theme presets — deliberately NOT noupdate: shipped presets are product
         data and improve with upgrades. Admin-created themes live on vu.theme
         and are never touched by module updates. -->

    <record id="preset_vietuc" model="vu.theme.preset">
        <field name="sequence">1</field>
        <field name="key">vietuc</field>
        <field name="name">Việt Úc (Default)</field>
        <field name="description">Official brand — Deep Blue, healthcare state colors, compact 13px.</field>
        <field name="token_values" eval="{}"/>
        <field name="preview_colors" eval="['#1565C0', '#42A5F5', '#FAFAFA', '#176B47', '#946200']"/>
    </record>

    <record id="preset_minimal_white" model="vu.theme.preset">
        <field name="sequence">2</field>
        <field name="key">minimal_white</field>
        <field name="name">Minimal White</field>
        <field name="description">Near-monochrome, hairline borders, zero shadows.</field>
        <field name="token_values" eval="{
            'vu-brand-primary': '#18181B',
            'vu-brand-primary-dark': '#000000',
            'vu-brand-secondary': '#52525B',
