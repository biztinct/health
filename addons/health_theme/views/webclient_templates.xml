<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Set browser theme color to healthcare teal -->
    <template id="webclient_bootstrap" inherit_id="web.webclient_bootstrap">
        <xpath expr="//meta[@name='theme-color']" position="replace">
            <meta name="theme-color" content="#0F6D66"/>
        </xpath>
    </template>

    <!-- Rename login field label/placeholder from Email to User ID -->
    <template id="login_userid_label" inherit_id="auth_signup.login">
        <xpath expr="//label[@for='login']" position="replace">
            <label for="login" class="form-label">User ID</label>
        </xpath>
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="placeholder">User ID</attribute>
        </xpath>
    </template>

</odoo>
