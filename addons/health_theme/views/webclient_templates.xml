                            <circle cx="234.7" cy="-70" r="9.2"/>
                        </g>
                    </svg>
                    <!-- The status line is picked from session_info's user_context.lang,
                         NOT translated through the view's arch_db: the render env's
                         lang comes from request.session.context, which lags one
                         request behind a language switch (the reload right after
                         the EN/VI globe would show the old language), while
                         session_info reads the user's lang fresh. A t-out
                         expression is not a translatable term, so no .po entry. -->
                    <t t-set="cjx_lang" t-value="((session_info or {}).get('user_context') or {}).get('lang') or ''"/>
                    <div class="cjx-status" t-out="'Đang mở ngày làm việc của bạn' if cjx_lang.startswith('vi') else 'Opening your day'"/>
                </div>
            </div>
            <script type="text/javascript">
                (function () {
                    var s = document.getElementById('cjx-splash');
                    if (!s) { return; }
                    s.dataset.t0 = String(performance.now());
                    try {
                        if (sessionStorage.getItem('cjx_splash_seen')) { s.classList.add('is-still'); }
                    } catch (e) { /* storage blocked: play every time */ }
                })();
            </script>
        </xpath>
        <!-- Theme Engine: published token overrides. Anchored after the last
             asset call inside the head_web block, so the :root overrides load
             AFTER the compiled bundles and win the cascade. If the route
             fails, compiled Việt Úc defaults apply — tint-only, never breaking. -->
        <xpath expr="//t[@t-call='web.conditional_assets_tests']" position="after">
            <link rel="stylesheet" type="text/css" href="/vu_theme/tokens.css"/>
        </xpath>
    </template>

    <!-- Rename login field label/placeholder from Email to User ID -->
    <template id="login_userid_label" inherit_id="auth_signup.login">
        <xpath expr="//label[@for='login']" position="replace">
            <label for="login" class="form-label">User ID</label>
        </xpath>
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="placeholder">User ID</attribute>
        </xpath>
    </template>

</odoo>
