<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Browser tab icon + iOS home-screen icon: the Carejiox "Care Pulse" mark
         on every page that goes through web.layout (web client and login).
         `x_icon` still wins when a caller sets one (website favicon, scoped apps). -->
    <template id="layout_favicon" inherit_id="web.layout" priority="90">
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link type="image/png" rel="icon" sizes="64x64" t-att-href="x_icon or '/health_theme/static/src/img/carejiox-favicon.png'"/>
            <link rel="apple-touch-icon" sizes="180x180" href="/health_theme/static/src/img/carejiox-touch-180.png"/>
        </xpath>
    </template>

    <!-- Set browser theme color to brand Deep Blue (matches navbar) -->
    <template id="webclient_bootstrap" inherit_id="web.webclient_bootstrap">
        <xpath expr="//meta[@name='theme-color']" position="replace">
            <meta name="theme-color" content="#1565C0"/>
        </xpath>
        <!-- the stock iOS icon goes; layout_favicon above already supplies ours -->
        <xpath expr="//link[@rel='apple-touch-icon']" position="replace"/>
        <!-- FIRST-OPEN SPLASH (the "First open" moment of the Carejiox loading
             language). Rendered straight into the body with its own inline CSS
             so the mark is drawing itself while the web client mounts and the
             first screen loads; the choreography is: C draws (0–.65s), pulse traces (.42–.92s), dot
             pops (.85–1.3s), wordmark wipes in (1–1.7s), status line (1.5s),
             then the dot beats until static/src/js/cjx_splash.js fades it out
             once the first screen is up. Repeat loads in the same tab get the
             finished logo with no draw (.is-still, set by the inline script
             below before first paint). Dark theme follows Odoo's color_scheme. -->
        <xpath expr="//t[@t-call='web.layout']" position="inside">
            <div id="cjx-splash" t-att-class="'cjx-splash' + (color_scheme == 'dark' and ' is-dark' or '')" aria-hidden="true">
                <style>
#cjx-splash{position:fixed;inset:0;z-index:20000;display:grid;place-items:center;background:#FFFFFF;color:#0F1E45;transition:opacity .5s cubic-bezier(.4,0,.2,1),transform .5s cubic-bezier(.4,0,.2,1)}
#cjx-splash.is-dark{background:#0B1220;color:#E8EEF8}
#cjx-splash.is-out{opacity:0;transform:scale(.985);pointer-events:none}
#cjx-splash .cjx-in{display:grid;justify-items:center;gap:22px;transform:translateY(-4vh)}
#cjx-splash .cjx-mark{width:96px;height:96px;overflow:visible}
#cjx-splash .cjx-ring,#cjx-splash .cjx-pulse{fill:none;stroke:#1565C0;stroke-linecap:round;stroke-linejoin:round}
#cjx-splash.is-dark .cjx-ring,#cjx-splash.is-dark .cjx-pulse{stroke:#42A5F5}
#cjx-splash .cjx-ring{stroke-width:10;stroke-dasharray:170;stroke-dashoffset:170;animation:cjx-draw .65s cubic-bezier(.4,0,.2,1) forwards}
#cjx-splash .cjx-pulse{stroke-width:7;stroke-dasharray:92;stroke-dashoffset:92;animation:cjx-draw .5s .42s cubic-bezier(.4,0,.2,1) forwards}
#cjx-splash .cjx-sweep{fill:none;stroke:#42A5F5;stroke-width:7;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:14 90;stroke-dashoffset:104;opacity:0;animation:cjx-sweep 1.1s 1.5s linear infinite}
#cjx-splash.is-dark .cjx-sweep{stroke:#83C5FA}
#cjx-splash .cjx-dot{fill:#FB8C00;transform-box:fill-box;transform-origin:center;transform:scale(0);animation:cjx-pop .45s .85s cubic-bezier(.34,1.56,.64,1) forwards,cjx-beat 1.1s 1.5s ease-in-out infinite}
#cjx-splash .cjx-word{height:30px;width:auto;overflow:visible;opacity:0;transform:translateY(6px);animation:cjx-rise .4s 1s cubic-bezier(.2,.8,.2,1) forwards}
#cjx-splash .cjx-word path{fill:currentColor}
#cjx-splash .cjx-word circle{fill:#FB8C00}
#cjx-splash.is-dark .cjx-dot,#cjx-splash.is-dark .cjx-word circle{fill:#FCB24D}
#cjx-splash .cjx-word rect{width:0;animation:cjx-wipe .7s 1s cubic-bezier(.2,.8,.2,1) forwards}
#cjx-splash .cjx-status{font:500 13px/1.4 'Segoe UI',system-ui,-apple-system,Arial,sans-serif;letter-spacing:.02em;color:#5B6B8A;opacity:0;min-height:1.4em;animation:cjx-fade .4s 1.5s forwards}
#cjx-splash.is-dark .cjx-status{color:#93A3BF}
@keyframes cjx-draw{to{stroke-dashoffset:0}}
@keyframes cjx-pop{to{transform:scale(1)}}
@keyframes cjx-beat{0%,100%{transform:scale(1)}30%{transform:scale(1.32)}55%{transform:scale(.96)}}
@keyframes cjx-sweep{0%{opacity:0;stroke-dashoffset:104}15%{opacity:.9}85%{opacity:.9}100%{opacity:0;stroke-dashoffset:0}}
@keyframes cjx-rise{to{opacity:1;transform:none}}
@keyframes cjx-wipe{to{width:402px}}
@keyframes cjx-fade{to{opacity:1}}
#cjx-splash.is-still .cjx-ring,#cjx-splash.is-still .cjx-pulse{animation:none;stroke-dashoffset:0}
#cjx-splash.is-still .cjx-dot{animation:none;transform:scale(1)}
#cjx-splash.is-still .cjx-sweep{animation:none;opacity:0}
#cjx-splash.is-still .cjx-word{animation:none;opacity:1;transform:none}
#cjx-splash.is-still .cjx-word rect{animation:none;width:402px}
#cjx-splash.is-still .cjx-status{animation:none;opacity:1}
@media (prefers-reduced-motion:reduce){
#cjx-splash .cjx-ring,#cjx-splash .cjx-pulse{animation:none;stroke-dashoffset:0}
#cjx-splash .cjx-dot{animation:none;transform:scale(1)}
#cjx-splash .cjx-sweep{animation:none;opacity:0}
#cjx-splash .cjx-word{animation:none;opacity:1;transform:none}
#cjx-splash .cjx-word rect{animation:none;width:402px}
#cjx-splash .cjx-status{animation:none;opacity:1}
}
                </style>
                <div class="cjx-in">
                    <svg class="cjx-mark" viewBox="0 0 100 100" role="img" aria-label="Carejiox">
                        <path class="cjx-ring" d="M76.05 28.14A34 34 0 1 0 76.05 71.86"/>
                        <path class="cjx-pulse" d="M28 50H40L46 37L54 63L60 50H80"/>
                        <path class="cjx-sweep" d="M28 50H40L46 37L54 63L60 50H80"/>
                        <circle class="cjx-dot" cx="89" cy="50" r="6.5"/>
                    </svg>
                    <svg class="cjx-word" viewBox="0 -82 402 106" role="img" aria-label="carejiox">
                        <defs><clipPath id="cjx-wclip"><rect x="0" y="-82" width="402" height="106"/></clipPath></defs>
