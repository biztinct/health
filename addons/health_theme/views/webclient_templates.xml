<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Set browser theme color to brand Deep Blue (matches navbar) -->
    <template id="webclient_bootstrap" inherit_id="web.webclient_bootstrap">
        <xpath expr="//meta[@name='theme-color']" position="replace">
            <meta name="theme-color" content="#1565C0"/>
        </xpath>
        <!-- Theme Engine: published token overrides. Anchored after the last
             asset call inside the head_web block, so the :root overrides load
             AFTER the compiled bundles and win the cascade. If the route
             fails, compiled Việt Úc defaults apply — tint-only, never breaking. -->
        <xpath expr="//t[@t-call='web.conditional_assets_tests']" position="after">
            <link rel="stylesheet" type="text/css" href="/vu_theme/tokens.css"/>
        </xpath>
    </template>

    <!-- Rename login field label/placeholder from Email to User ID -->
    <template id="login_userid_label" inherit_id="auth_signup.login">
        <xpath expr="//label[@for='login']" position="replace">
            <label for="login" class="form-label">User ID</label>
        </xpath>
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="placeholder">User ID</attribute>
        </xpath>
    </template>

</odoo>
