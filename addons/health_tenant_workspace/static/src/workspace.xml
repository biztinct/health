<templates xml:space="preserve">
<t t-name="health_tenant_workspace.Workspace">
 <main class="htw">
  <header class="htw-head"><div><p class="htw-eyebrow">Settings</p><h1 t-esc="title"/><p t-if="mode === 'company'">The details people see on your documents and company profile.</p><p t-if="mode === 'setup'">Set up your clinic at your own pace. Your progress is saved.</p><p t-if="mode === 'history'">One timeline, with the access rules of each original record.</p></div><button class="btn btn-outline-primary" t-on-click="load" t-att-disabled="state.busy">Refresh</button></header>
  <div t-if="state.error" class="alert alert-danger" role="alert" t-esc="state.error"/>
  <div t-if="state.busy" role="status">Working…</div>
  <t t-if="state.setup">
   <nav class="htw-steps" aria-label="Setup steps"><button t-foreach="steps" t-as="s" t-key="s" t-att-class="state.setup.step === s ? 'active' : ''" t-on-click="()=>this.step(s)" t-att-disabled="state.busy"><span t-esc="s_index + 1"/><t t-esc="stepLabels[s]"/></button></nav>
   <div t-if="state.setup.completed" class="alert alert-success">Setup completed. You can return here whenever your clinic changes.</div>
  </t>
  <div t-if="state.profile and (!state.setup or state.setup.step === 'company')" class="htw-grid">
   <section class="htw-card"><h2>Company details</h2><div class="htw-fields"><label t-foreach="fieldKeys" t-as="key" t-key="key"><span t-esc="labels[key]"/><input class="form-control" t-model="state.profile.company[key]" t-att-type="key === 'email' ? 'email' : 'text'"/></label><label>Country<select class="form-select" t-model="state.profile.country_id"><option value="">Choose a country</option><option t-foreach="state.profile.countries" t-as="c" t-key="c.id" t-att-value="c.id" t-esc="c.name"/></select></label><label>Company logo<input type="file" accept="image/png,image/jpeg,image/webp" t-on-change="upload"/></label></div><p class="text-muted">Currency and platform settings are managed by the platform administrator.</p><button class="btn btn-primary" t-on-click="saveCompany" t-att-disabled="state.busy">Save company details</button></section>
   <aside class="htw-card htw-preview"><p class="htw-eyebrow">Document preview</p><img t-att-src="state.profile.logo" alt="Company logo"/><h2 t-esc="state.profile.company.name"/><p><t t-esc="state.profile.company.street"/><br/><t t-esc="state.profile.company.city"/></p><p t-esc="state.profile.company.phone"/><p t-esc="state.profile.company.email"/><p><span>Tax number: </span><t t-esc="state.profile.company.vat"/></p><hr/><p>This is a preview of your company details. Each document keeps its own layout.</p><p><span>Application name: </span><strong t-esc="state.profile.brand.name"/></p><p><span>Currency: </span><t t-esc="state.profile.currency"/></p></aside>
  </div>
  <section t-if="state.setup" class="htw-card">
   <h2 t-esc="stepLabels[state.setup.step]"/><p t-esc="stepHelp[state.setup.step]"/><div class="htw-check" t-foreach="visibleChecks" t-as="c" t-key="c.key"><div><strong t-esc="c.label"/><small t-if="c.optional">Optional</small></div><span t-att-class="c.ready ? 'text-success' : 'text-muted'" t-esc="readyLabel(c.ready)"/><button class="btn btn-outline-primary" t-if="c.action or c.key === 'company'" t-on-click="()=>this.openCheck(c)">Open</button><span t-else="">Ask your administrator to enable this screen.</span></div><label class="htw-notes">Setup notes<textarea class="form-control" t-model="state.setup.notes" rows="3"/></label><div class="htw-buttons"><button class="btn btn-outline-primary" t-on-click="()=>this.step(state.setup.step)" t-att-disabled="state.busy">Save progress</button><button t-if="setupIndex > 0" class="btn btn-outline-primary" t-on-click="()=>this.step(steps[setupIndex-1])" t-att-disabled="state.busy">Previous step</button><button t-if="setupIndex &lt; 5" class="btn btn-primary" t-on-click="()=>this.step(steps[setupIndex+1])" t-att-disabled="state.busy">Next step</button><button t-if="setupIndex === 5" class="btn btn-primary" t-on-click="()=>this.step('review', true)" t-att-disabled="state.busy">Finish setup</button></div>
  </section>
  <t t-if="mode === 'history'"><form class="htw-filters" t-on-submit.prevent="search"><input class="form-control" placeholder="Search summaries" t-model="state.query"/><select class="form-select" t-model="state.source"><option value="all">All sources</option><option value="workspace">Company and setup</option><option value="clinical">Record changes</option><option value="access">Access and roles</option><option value="support">Support sessions</option><option value="api">API activity</option><option value="channels">Connections</option></select><button class="btn btn-primary" t-att-disabled="state.busy">Search</button></form>
   <section t-if="state.history" class="htw-card"><div class="htw-sources"><span t-foreach="state.history.sources" t-as="s" t-key="s.source"><strong t-esc="sourceLabels[s.source] || s.source"/>: <t t-esc="s.status"/></span></div><p t-if="!state.history.rows.length">No matching activity is visible with your access.</p><article class="htw-event" t-foreach="state.history.rows" t-as="r" t-key="r.key"><time t-esc="r.date"/><span class="badge text-bg-light" t-esc="sourceLabels[r.source] || r.source"/><strong t-esc="r.title"/><span t-esc="r.actor"/><details t-if="r.detail"><summary>What changed</summary><div t-foreach="historyChanges(r.detail)" t-as="change" t-key="change.key" class="my-2"><strong t-esc="change.label"/><div><t t-if="change.before"><span t-esc="change.before"/> → </t><span t-esc="change.after"/></div></div></details></article><p class="text-muted">Times are shown in UTC. Detailed clinical content and request payloads are not included.</p><div class="htw-buttons"><button class="btn btn-outline-primary" t-on-click="()=>this.page(-50)" t-att-disabled="!state.offset or state.busy">Previous</button><button class="btn btn-outline-primary" t-on-click="()=>this.page(50)" t-att-disabled="!state.history.more or state.busy">Next</button></div></section>
  </t>
 </main>
</t>
</templates>
