<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="health_invoicing.FinanceSidebar">
    <aside class="ops-global-sidebar fin-sidebar">
        <div class="ops-sidebar-logo" t-on-click="navigateHome" style="cursor:pointer">
            <div class="ops-logo-icon fin-logo-icon"><i class="fa fa-university"/></div>
            <div>
                <div class="ops-logo-text">VIET UC</div>
                <div class="ops-logo-sub">Finance Center</div>
            </div>
        </div>
        <nav class="ops-sidebar-nav">
            <div class="ops-nav-section-label">Main</div>
            <a t-attf-class="ops-nav-item #{isActive('dashboard') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('dashboard')"><i class="fa fa-th-large"/> Dashboard</a>
            <a t-attf-class="ops-nav-item #{isActive('invoices') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('invoices')"><i class="fa fa-file-text-o"/> Invoices</a>
            <a t-attf-class="ops-nav-item #{isActive('packages') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('packages')"><i class="fa fa-cube"/> Service Packages</a>

            <div class="ops-nav-section-label">AR &amp; Payments</div>
            <a t-attf-class="ops-nav-item #{isActive('ar_dashboard') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('ar_dashboard')"><i class="fa fa-bar-chart"/> AR Dashboard</a>
            <a t-attf-class="ops-nav-item #{isActive('ar_management') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('ar_management')"><i class="fa fa-credit-card"/> AR Management</a>
            <a t-attf-class="ops-nav-item #{isActive('payments') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('payments')"><i class="fa fa-money"/> Payments</a>
            <a t-attf-class="ops-nav-item #{isActive('overdue') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('overdue')"><i class="fa fa-exclamation-circle"/> Overdue Clients</a>

            <div class="ops-nav-section-label">Reports</div>
            <a t-attf-class="ops-nav-item #{isActive('vat_log') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('vat_log')"><i class="fa fa-book"/> VAT Log</a>
            <a t-attf-class="ops-nav-item #{isActive('ar_transactions') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('ar_transactions')"><i class="fa fa-exchange"/> AR Transactions</a>

            <div class="ops-nav-section-label">System</div>
            <a t-attf-class="ops-nav-item #{isActive('settings') ? 'active' : ''}"
               t-on-click="() => this.navigateTo('settings')"><i class="fa fa-cog"/> Settings</a>
            <a class="ops-nav-item" t-on-click="navigateHome"><i class="fa fa-arrow-left"/> Back to Odoo</a>
        </nav>
        <div class="ops-sidebar-user">
            <div class="ops-user-avatar" t-esc="currentUserInitials"/>
            <div class="ops-user-info">
                <div class="ops-user-name" t-esc="currentUserName"/>
                <div class="ops-user-role">Finance</div>
            </div>
        </div>
    </aside>
</t>

</templates>
