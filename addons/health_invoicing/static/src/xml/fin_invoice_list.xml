<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="health_invoicing.FinInvoiceListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='props.Renderer']" position="before">
            <!-- Status filter tabs -->
            <div class="fin-cl-tabs">
                <t t-foreach="statusTabs" t-as="tab" t-key="tab.id">
                    <button t-attf-class="fin-cl-tab #{tabState.activeTab === tab.id ? 'active' : ''}"
                            t-on-click="() => this.setTab(tab.id)">
                        <i t-attf-class="fa #{tab.icon}"/>
                        <t t-esc="tab.label"/>
                    </button>
                </t>
                <div class="fin-cl-tabs-spacer"/>
                <button class="fin-cl-pay-bulk-btn" t-if="selectedCount &gt; 0"
                        t-on-click="onBulkReceivePayment">
                    <i class="fa fa-money"/> Receive Payment (<t t-esc="selectedCount"/>)
                </button>
                <button class="fin-cl-new-btn" t-on-click="openNewInvoice">
                    <i class="fa fa-plus"/> New Invoice
                </button>
            </div>
            <!-- Date quick-filter pills -->
            <div class="fin-cl-date-filters">
                <t t-foreach="dateTabs" t-as="dt" t-key="dt.id">
                    <button t-attf-class="fin-cl-date-btn #{tabState.dateFilter === dt.id ? 'active' : ''}"
                            t-on-click="() => this.setDateFilter(dt.id)">
                        <t t-esc="dt.label"/>
                    </button>
                </t>
                <button t-attf-class="fin-cl-date-btn #{tabState.dateFilter === 'custom' ? 'active' : ''}"
                        t-on-click="() => this.setDateFilter('custom')">Custom</button>
                <t t-if="tabState.dateFilter === 'custom'">
                    <input type="date" class="fin-cl-date-input" t-att-value="tabState.customFrom"
                           t-on-change="(ev) => this.onCustomDate('from', ev)" title="From"/>
                    <span class="fin-cl-date-dash">–</span>
                    <input type="date" class="fin-cl-date-input" t-att-value="tabState.customTo"
                           t-on-change="(ev) => this.onCustomDate('to', ev)" title="To"/>
                </t>
            </div>
        </xpath>
    </t>

    <!-- Outstanding Invoices list: bulk "Receive Payment" button only. -->
    <t t-name="health_invoicing.ClientPayListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='props.Renderer']" position="before">
            <div class="fin-cl-tabs" t-if="selectedCount &gt; 0">
                <div class="fin-cl-tabs-spacer"/>
                <button class="fin-cl-pay-bulk-btn" t-on-click="onBulkReceivePayment">
                    <i class="fa fa-money"/> Receive Payment (<t t-esc="selectedCount"/>)
                </button>
            </div>
        </xpath>
    </t>

</templates>
