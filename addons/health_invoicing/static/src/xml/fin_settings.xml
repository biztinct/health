<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="health_invoicing.FinSettings">
    <div class="fin-dashboard">
        <div class="fin-main-content">
            <header class="fin-top-header">
                <div class="fin-header-left">
                    <h1 class="fin-page-title">Finance Settings</h1>
                    <span class="fin-page-subtitle">Configuration &amp; system settings</span>
                </div>
            </header>

            <div class="fin-settings-grid">
                <div class="fin-settings-tile" t-on-click="openPackageProducts">
                    <div class="fin-settings-icon"><i class="fa fa-cube"/></div>
                    <div class="fin-settings-label">Package Products</div>
                    <div class="fin-settings-desc">Healthcare package product templates</div>
                </div>

                <div class="fin-settings-tile" t-on-click="openTaxConfig">
                    <div class="fin-settings-icon"><i class="fa fa-percent"/></div>
                    <div class="fin-settings-label">Tax Configuration</div>
                    <div class="fin-settings-desc">Vietnamese tax settings</div>
                </div>

                <div class="fin-settings-tile" t-on-click="openInvoicingSettings">
                    <div class="fin-settings-icon"><i class="fa fa-wrench"/></div>
                    <div class="fin-settings-label">Invoicing Settings</div>
                    <div class="fin-settings-desc">General invoicing configuration</div>
                </div>

                <div class="fin-settings-tile" t-on-click="openPaymentMethods">
                    <div class="fin-settings-icon"><i class="fa fa-credit-card"/></div>
                    <div class="fin-settings-label">Payment Methods</div>
                    <div class="fin-settings-desc">Payment method configuration</div>
                </div>

                <div class="fin-settings-tile" t-on-click="openChartOfAccounts">
                    <div class="fin-settings-icon"><i class="fa fa-sitemap"/></div>
                    <div class="fin-settings-label">Chart of Accounts</div>
                    <div class="fin-settings-desc">Account configuration</div>
                </div>
            </div>
        </div>
    </div>
</t>

</templates>
