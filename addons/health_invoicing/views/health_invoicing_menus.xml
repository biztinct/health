<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Main Healthcare Invoicing Menu -->
    <menuitem 
        id="menu_health_invoicing_root" 
        name="Healthcare Invoicing"
        groups="base.group_user"
        web_icon="health_invoicing,static/description/icon.png"
        sequence="135"/>

    <!-- Service Billing Menu -->
    <menuitem 
        id="menu_health_service_billing"
        name="Service Billing"
        parent="menu_health_invoicing_root"
        sequence="10"/>

    <menuitem 
        id="menu_health_service_billing_all"
        name="All Service Billing"
        parent="menu_health_service_billing"
        action="action_health_service_billing"
        sequence="10"/>

    <!-- Payment Workflow Menu -->
    <menuitem 
        id="menu_health_payment_workflow"
        name="Payment Workflow"
        parent="menu_health_invoicing_root"
        sequence="20"/>

    <menuitem 
        id="menu_health_payment_workflow_wizard"
        name="Process Payments"
        parent="menu_health_payment_workflow"
        action="action_health_payment_workflow_wizard"
        sequence="10"/>

    <!-- Actions for Service Billing -->
    <record id="action_health_service_billing" model="ir.actions.act_window">
        <field name="name">Healthcare Service Billing</field>
        <field name="res_model">health.service.billing</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create healthcare service billing records
            </p>
            <p>
                Track billing for healthcare services including home visits, clinic visits, and other medical services.
                Manage insurance claims and generate invoices automatically.
            </p>
        </field>
    </record>

    <!-- Actions for Payment Workflow -->
    <record id="action_health_payment_workflow_wizard" model="ir.actions.act_window">
        <field name="name">Healthcare Payment Workflow</field>
        <field name="res_model">health.payment.workflow.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Process healthcare service payments
            </p>
            <p>
                Process payments for completed healthcare services using Pay Now or Pay Later workflows.
                Automatically submit invoices to Vietnamese Tax Authorities.
            </p>
        </field>
    </record>

</odoo>