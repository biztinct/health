<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Actions must be defined before menus that reference them -->
    
    <!-- Actions for Service Billing -->
    <record id="action_health_service_billing" model="ir.actions.act_window">
        <field name="name">Healthcare Service Billing</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('healthcare_service_type', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create healthcare service invoices
            </p>
            <p>
                Track billing for healthcare services including home visits, clinic visits, and other medical services.
                Manage insurance claims and generate invoices automatically with Vietnamese tax compliance.
            </p>
        </field>
    </record>

    <!-- Actions for Payment Workflow -->
    <record id="action_health_payment_workflow_wizard" model="ir.actions.act_window">
        <field name="name">Healthcare Payment Workflow</field>
        <field name="res_model">health.payment.workflow.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Process healthcare service payments
            </p>
            <p>
                Process payments for completed healthcare services using Pay Now or Pay Later workflows.
                Automatically submit invoices to Vietnamese Tax Authorities.
            </p>
        </field>
    </record>

    <!-- Menu Items (defined after actions) -->
    
    <!-- Main Healthcare Invoicing Menu -->
    <menuitem 
        id="menu_health_invoicing_root" 
        name="Healthcare Invoicing"
        groups="base.group_user"
        web_icon="health_invoicing,static/description/icon.png"
        sequence="135"/>

    <!-- Service Billing Menu -->
    <menuitem 
        id="menu_health_service_billing"
        name="Service Billing"
        parent="menu_health_invoicing_root"
        sequence="10"/>

    <menuitem 
        id="menu_health_service_billing_all"
        name="All Service Billing"
        parent="menu_health_service_billing"
        action="action_health_service_billing"
        sequence="10"/>

    <!-- Product Configuration Menu -->
    <menuitem 
        id="menu_health_product_configuration"
        name="Product Configuration"
        parent="menu_health_invoicing_root"
        sequence="15"/>

    <menuitem 
        id="menu_health_package_products"
        name="Package Products"
        parent="menu_health_product_configuration"
        action="action_healthcare_package_products"
        sequence="10"/>

    <menuitem 
        id="menu_all_healthcare_products"
        name="All Healthcare Products"
        parent="menu_health_product_configuration"
        action="action_all_healthcare_products"
        sequence="20"/>

    <!-- Prepaid Services Menu -->
    <menuitem 
        id="menu_health_prepaid_services"
        name="Prepaid Services"
        parent="menu_health_invoicing_root"
        sequence="20"/>

    <menuitem 
        id="menu_health_service_packages"
        name="Patient Packages"
        parent="menu_health_prepaid_services"
        action="action_health_service_package"
        sequence="10"/>

    <menuitem 
        id="menu_health_prepaid_consumptions"
        name="Service Consumptions"
        parent="menu_health_prepaid_services"
        action="action_health_prepaid_service"
        sequence="20"/>

    <!-- Accounts Receivable Management Menu -->
    <menuitem 
        id="menu_health_accounts_receivable"
        name="Accounts Receivable"
        parent="menu_health_invoicing_root"
        sequence="30"/>

    <menuitem 
        id="menu_health_ar_dashboard"
        name="AR Dashboard"
        parent="menu_health_accounts_receivable"
        action="action_healthcare_ar_dashboard"
        sequence="10"/>

    <menuitem 
        id="menu_health_overdue_patients"
        name="Overdue Patients"
        parent="menu_health_accounts_receivable"
        action="action_healthcare_overdue_patients"
        sequence="20"/>

    <menuitem 
        id="menu_health_cash_collections"
        name="Cash Collections"
        parent="menu_health_accounts_receivable"
        action="action_healthcare_cash_management"
        sequence="30"/>


    <!-- Payment Management Menu -->
    <menuitem 
        id="menu_health_payment_management"
        name="Payment Management"
        parent="menu_health_invoicing_root"
        sequence="35"/>

    <menuitem 
        id="menu_health_payment_transactions"
        name="Payment Transactions"
        parent="menu_health_payment_management"
        action="action_health_payment_transaction"
        sequence="10"/>

    <!-- Payment Workflow Menu -->
    <menuitem 
        id="menu_health_payment_workflow"
        name="Payment Workflow"
        parent="menu_health_invoicing_root"
        sequence="40"/>

    <menuitem 
        id="menu_health_payment_workflow_wizard"
        name="Process Payments"
        parent="menu_health_payment_workflow"
        action="action_health_payment_workflow_wizard"
        sequence="10"/>

    <!-- Reports Menu -->
    <menuitem 
        id="menu_health_invoicing_reports"
        name="Reports"
        parent="menu_health_invoicing_root"
        sequence="50"/>

</odoo>