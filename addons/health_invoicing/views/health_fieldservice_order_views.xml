<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FSO Form - Enhanced Payment Integration -->
    <record id="view_health_fieldservice_order_form_invoicing" model="ir.ui.view">
        <field name="name">FSO Enhanced Payment Integration</field>
        <field name="model">health.fieldservice.order</field>
        <field name="inherit_id" ref="health_fieldservice.view_health_fieldservice_order_form"/>
        <field name="arch" type="xml">
            
            <!-- Smart buttons removed — actions moved to right panel -->
            
            <!-- Enhanced Header Actions -->
            <xpath expr="//header" position="inside">
                
                <!-- Primary Nurse Workflow Button -->
                <button type="object" name="action_complete_service_with_payment"
                        string="Complete Service and Collect Payment"
                        class="btn-success" icon="fa-money"
                        invisible="state != 'in_progress' or is_invoiced"
                        groups="health_invoicing.group_health_invoicing_user"
                        help="Complete service and launch payment collection workflow"/>

                <!-- Service Package moved to action panel -->

                <!-- Ensure sale_order_id field is loaded for modifier evaluation -->
                <field name="sale_order_id" invisible="1"/>
                <field name="is_invoice_paid" invisible="1"/>
                
                <!-- Pay Quote Button - Prepay service before completion -->
                <button type="object" name="action_prepay_quote"
                        string="Pay Quote" class="btn-info" icon="fa-credit-card"
                        invisible="state in ('draft', 'completed', 'completed_pending_invoice', 'cancelled', 'closed') or not sale_order_id or is_invoice_paid"
                        help="Pay for the quoted services in advance"/>
                        
                <!-- Alternative Manual Invoice Creation removed - use main Create Invoice button instead -->
                        
            </xpath>
            
            <!-- Add Service Package Selection (Always Visible for Easy Package Booking) -->
            <xpath expr="//group[1]" position="after">
                <group string="Service Packages" name="package_selection"
                       invisible="not package_ids"
                       groups="health_invoicing.group_health_invoicing_user">
                    <group>
                        <field name="package_ids"
                               widget="many2many_tags"
                               readonly="1"
                               nolabel="0"
                               string="Assigned Packages"
                               help="Assigned via the Service Package button"/>
                        <field name="package_consumption_quantity" 
                               invisible="1"
                               help="Number of services to consume from each package"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="is_package_service" readonly="1" invisible="1"/>
                        <field name="package_service_value" readonly="1" widget="monetary"
                               invisible="1"/>
                    </group>
                </group>

                
                <!-- Package Status Alert -->
                <div class="alert alert-info" role="alert" 
                     invisible="not package_ids">
                    <strong><i class="fa fa-cube"/> Packages Selected:</strong> 
                    <field name="package_ids" widget="many2many_tags" readonly="1" nolabel="1"/> - 
                    1 service will be consumed from each package.
                </div>
            </xpath>
            
            <!-- Move payment fields into the Quote and Invoice Status card -->
            <xpath expr="//field[@name='invoice_state']" position="after">
                <field name="is_invoiced" readonly="1"
                       groups="health_invoicing.group_health_invoicing_user"/>
                <field name="total_paid_amount" readonly="1"
                       invisible="not is_invoiced"
                       groups="health_invoicing.group_health_invoicing_user"/>
                <field name="outstanding_amount" readonly="1" 
                       invisible="outstanding_amount == 0 or not is_invoiced"
                       groups="health_invoicing.group_health_invoicing_user"/>
                <field name="payment_transaction_count" readonly="1" 
                       invisible="payment_transaction_count == 0"
                       groups="health_invoicing.group_health_invoicing_user"/>
                <field name="insurance_claim_id"
                       options="{'no_create': False}"
                       placeholder="Link to insurance claim invoice (if any)"
                       groups="health_invoicing.group_insurance_claims"/>
            </xpath>
            
            <!-- Add Payment Tracking Tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Payments and Transactions" name="payment_tracking"
                      invisible="payment_transaction_count == 0"
                      groups="health_invoicing.group_health_invoicing_user">
                    
                    <group string="Payment Transactions">
                        <field name="payment_transaction_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="transaction_date"/>
                                <field name="display_name"/>
                                <field name="amount" widget="monetary"/>
                                <field name="payment_method"/>
                                <field name="transaction_type"/>
                                <field name="status" widget="badge" 
                                       decoration-success="status == 'reconciled'"
                                       decoration-warning="status in ('pending_delivery', 'collected')"
                                       decoration-danger="status == 'failed'"/>
                                <field name="collected_by_id"/>
                            </list>
                        </field>
                    </group>
                    
                    <group string="Package Service Details" 
                           invisible="not is_package_service"
                           groups="health_invoicing.group_health_invoicing_user">
                        <p><strong>Package Service Integration:</strong></p>
                        <p>Packages: <field name="package_ids" widget="many2many_tags" readonly="1" nolabel="1"/></p>
                        <!-- Hidden: Services Consumed and Service Value not needed in UI -->
                        <p invisible="1">Services Consumed Per Package: <field name="package_consumption_quantity" readonly="1" nolabel="1"/></p>
                        <p invisible="1">Total Service Value: <field name="package_service_value" readonly="1" nolabel="1" widget="monetary"/></p>
                        
                        <!-- Legacy Prepaid Consumptions (hidden - deprecated) -->
                        <separator string="Legacy Consumption Records (Deprecated)" invisible="1"/>
                        <field name="prepaid_consumption_ids" nolabel="1" readonly="1" invisible="1">
                            <list>
                                <field name="service_date"/>
                                <field name="package_id"/>
                                <field name="quantity_consumed"/>
                                <field name="total_value" widget="monetary"/>
                                <field name="status"/>
                            </list>
                        </field>
                    </group>
                    
                </page>
            </xpath>
            
        </field>
    </record>

    <!-- Add Select Prepaid Package to booking form action panel -->
    <record id="view_fso_form_package_action" model="ir.ui.view">
        <field name="name">FSO Package Action Panel Button</field>
        <field name="model">health.fieldservice.order</field>
        <field name="inherit_id" ref="health_fieldservice.view_health_fieldservice_order_form"/>
        <field name="arch" type="xml">

            <!-- DRAFT without Quote/Package: also hide when package_ids present -->
            <xpath expr="//div[@name='draft_create_quote_card']" position="attributes">
                <attribute name="invisible">state != 'draft' or sale_order_id or package_ids</attribute>
            </xpath>

            <!-- Add Prepaid Package button next to Create Quote in primary card -->
            <xpath expr="//div[@name='draft_create_quote_card']//button[@name='action_create_and_open_quote']" position="after">
                <button name="action_open_service_package_wizard" type="object"
                        class="vu-action-btn vu-action-btn--secondary"
                        groups="health_invoicing.group_health_invoicing_user">
                    <i class="fa fa-cube"/> Prepaid Package
                </button>
            </xpath>

            <!-- DRAFT with Quote/Package: also show when package_ids present -->
            <xpath expr="//div[@name='draft_confirm_client_card']" position="attributes">
                <attribute name="invisible">state != 'draft' or (not sale_order_id and not package_ids)</attribute>
            </xpath>

            <!-- Update subtitle to reflect package option -->
            <xpath expr="//div[@name='draft_confirm_client_card']//div[contains(@class,'vu-action-card__subtitle')]" position="replace">
                <div class="vu-action-card__subtitle">
                    Quote or package assigned. Contact the client to confirm this booking, then click Confirm.
                </div>
            </xpath>

            <!-- Add Create Quote button in confirm card (when only package, no quote yet) -->
            <xpath expr="//div[@name='draft_confirm_client_card']//button[@name='action_confirm_booking']" position="before">
                <button name="action_create_and_open_quote" type="object"
                        class="vu-action-btn vu-action-btn--secondary"
                        invisible="sale_order_id"
                        groups="health_base.group_healthcare_operations_manager">
                    <i class="fa fa-file-text-o"/> Create Quote
                </button>
            </xpath>

            <xpath expr="//button[@name='action_view_quote']" position="after">
                <button type="object" name="action_open_service_package_wizard"
                        class="vu-action-item"
                        invisible="state in ('completed', 'completed_pending_invoice', 'cancelled', 'closed')"
                        groups="health_invoicing.group_health_invoicing_user">
                    <i class="fa fa-cube"/> Select Prepaid Package
                </button>
            </xpath>
            <xpath expr="//button[@name='action_view_all_invoices']" position="after">
                <button type="object" name="action_view_payment_transactions"
                        class="vu-action-item"
                        invisible="payment_transaction_count == 0"
                        groups="health_invoicing.group_health_invoicing_user">
                    <i class="fa fa-credit-card"/> View Payments
                </button>
            </xpath>
        </field>
    </record>

</odoo>
