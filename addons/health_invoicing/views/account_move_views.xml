<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_payment_date_translation" model="ir.ui.view">
        <field name="name">account.move.form.payment.date.translation</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="partner_time_to_pay.view_move_form"/>
        <field name="arch" type="xml">
            <field name="full_reconcile_payment_date" position="attributes">
                <attribute name="string">Payment Date</attribute>
            </field>
        </field>
    </record>

    <!-- Healthcare Invoice Form View Extension -->
    <record id="view_healthcare_invoice_form" model="ir.ui.view">
        <field name="name">account.move.form.healthcare</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add Process Payment button after existing buttons in header -->
            <header position="inside">
                <button name="action_process_payment" 
                        type="object" 
                        string="Process Payment" icon="fa-credit-card"
                        class="btn-success"
                        invisible="1"
                        help="Process payment for this invoice"/>
            </header>
            
            <!-- Healthcare-specific fields temporarily commented out -->
            <!-- <xpath expr="//field[@name='partner_id']" position="after">
                <field name="patient_id" invisible="not patient_id"/>
                <field name="fieldservice_order_id" invisible="not fieldservice_order_id"/>
                <field name="appointment_id" invisible="not appointment_id"/>
                <field name="healthcare_service_type" invisible="not healthcare_service_type"/>
            </xpath> -->
            
            <!-- Add Tax Authority Status in a separate group -->
            <notebook position="inside">
                <page string="Tax Authority &amp; Compliance" name="tax_compliance"
                      invisible="move_type not in ['out_invoice', 'out_refund'] or not red_invoice_enabled">

                    <!-- Hidden field for Red Invoice toggle visibility -->
                    <field name="red_invoice_enabled" invisible="1"/>

                    <!-- Discount Warning Banner -->
                    <field name="has_discounts" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not has_discounts">
                        <strong><i class="fa fa-exclamation-triangle"/> Discounts Applied:</strong> This invoice has discounts totaling
                        <field name="total_discount_amount" widget="monetary" readonly="1"/>
                        <br/>All discounted line items must have a reason in the "Discount Reason" field.
                    </div>

                    <group>
                        <group string="Vietnamese Tax Authority">
                            <field name="tax_authority_submission_status" widget="badge"/>
                            <field name="tax_submission_date" readonly="1"/>
                            <field name="tax_submission_reference" readonly="1"/>
                            <field name="tax_submission_error" readonly="1" invisible="not tax_submission_error"/>
                        </group>

                        <group string="MISA Integration">
                            <field name="misa_sync_status" widget="badge"/>
                            <field name="misa_invoice_id" readonly="1"/>
                            <field name="misa_sync_date" readonly="1"/>
                            <field name="misa_sync_error" readonly="1" invisible="not misa_sync_error"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Invoice Line - Add Discount Reason Field -->
    <record id="view_move_line_form_discount_reason" model="ir.ui.view">
        <field name="name">account.move.line.form.discount.reason</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <!-- Add discount_reason field after name in the form -->
            <field name="name" position="after">
                <field name="discount_reason"
                       placeholder="Required when discount is applied"
                       invisible="discount == 0"/>
            </field>
        </field>
    </record>

    <!-- Invoice Line Tree - Add Discount Reason Column (for invoice line editing) -->
    <record id="view_move_line_tree_discount_reason" model="ir.ui.view">
        <field name="name">account.move.line.tree.discount.reason</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <!-- Add discount_reason after name column -->
            <field name="name" position="after">
                <field name="discount_reason"
                       optional="show"
                       placeholder="Required when discount > 0"/>
            </field>
        </field>
    </record>

    <!-- Invoice Form - Add Discount Reason to Inline Invoice Lines -->
    <record id="view_move_form_discount_reason_inline" model="ir.ui.view">
        <field name="name">account.move.form.discount.reason.inline</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add discount_reason field after discount in invoice_line_ids tree -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='discount']" position="after">
                <field name="discount_reason"
                       optional="show"
                       placeholder="Required when discount > 0"
                       width="150px"/>
            </xpath>
        </field>
    </record>

</odoo>
