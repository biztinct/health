<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Healthcare AR Dashboard - Patient Due List -->
    <record id="view_healthcare_ar_payments_tree" model="ir.ui.view">
        <field name="name">Healthcare Payments Due List</field>
        <field name="model">account.move.line</field>
        <field name="priority">15</field>
        <field name="arch" type="xml">
            <list decoration-success="full_reconcile_id!=False"
                  decoration-muted="reconciled!=False and full_reconcile_id==False"
                  decoration-warning="parent_state!='posted'"
                  decoration-danger="reconciled==False and date_maturity&lt;current_date and parent_state=='posted'"
                  decoration-info="move_id.healthcare_service_type!=False"
                  create="false" delete="false" default_order="date_maturity">
                  
                <!-- Healthcare-specific columns first -->
                <field name="partner_id" string="Client" readonly="1"/>
                <field name="move_id" string="Invoice" readonly="1"/>
                <field name="invoice_date" readonly="1"/>
                <field name="date_maturity" string="Due Date"/>
                <field name="amount_residual" sum="Total Outstanding" string="Outstanding Amount"/>
                
                <!-- Service information -->
                <field name="invoice_origin" readonly="1" string="Service Origin"/>
                <field name="payment_term_id" readonly="1" string="Payment Terms"/>
                
                <!-- Financial details -->
                <field name="debit" readonly="1" sum="Total Debit" optional="hide"/>
                <field name="credit" readonly="1" sum="Total Credit" optional="hide"/>
                <field name="balance" readonly="1" sum="Total Balance" optional="show"/>
                
                <!-- Status fields -->
                <field name="reconciled" readonly="1" string="Paid" widget="boolean"/>
                <field name="full_reconcile_id" readonly="1" optional="hide"/>
                
                <!-- Hidden fields for functionality -->
                <field name="company_currency_id" invisible="1" readonly="1"/>
                <field name="parent_state" invisible="1"/>
                <field name="account_id" invisible="1"/>
                
            </list>
        </field>
    </record>

    <!-- Ensure Client column label renders correctly in AR list -->
    <record id="view_healthcare_ar_payments_tree_client_label" model="ir.ui.view">
        <field name="name">Healthcare AR Payments Client Label</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="view_healthcare_ar_payments_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">Client</attribute>
            </xpath>
        </field>
    </record>

    <!-- Healthcare AR Search View -->
    <record id="view_healthcare_ar_payments_filter" model="ir.ui.view">
        <field name="name">Healthcare Payments Due Search</field>
        <field name="model">account.move.line</field>
        <field name="priority">15</field>
        <field name="arch" type="xml">
            <search string="Search Healthcare Payments">
                <field name="partner_id"/>
            </search>
        </field>
    </record>

    <!-- Healthcare AR Pivot View -->
    <record id="view_healthcare_ar_payments_pivot" model="ir.ui.view">
        <field name="name">Healthcare AR Analysis</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <pivot string="Healthcare Accounts Receivable Analysis">
                <field name="partner_id" type="row"/>
                <field name="date_maturity" type="col" interval="month"/>
                <field name="amount_residual" type="measure"/>
                <field name="balance" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Healthcare AR Graph View -->
    <record id="view_healthcare_ar_payments_graph" model="ir.ui.view">
        <field name="name">Healthcare AR Trends</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <graph string="Healthcare Accounts Receivable Trends" type="line">
                <field name="date_maturity" type="row" interval="month"/>
                <field name="amount_residual" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Healthcare AR Dashboard Action -->
    <record id="action_healthcare_ar_dashboard" model="ir.actions.act_window">
        <field name="name">Healthcare AR Dashboard</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{
            'search_default_outstanding_only': 1,
            'search_default_group_by_patient': 1
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_healthcare_ar_payments_tree')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_healthcare_ar_payments_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_healthcare_ar_payments_graph')})]"/>
        <field name="search_view_id" ref="view_healthcare_ar_payments_filter"/>
        <field name="domain">[
            ('account_id.reconcile', '=', True),
            ('balance', '!=', 0),
            ('account_id.account_type', '=', 'asset_receivable')
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No outstanding patient payments found!
            </p>
            <p>
                This dashboard shows all outstanding payments from patients.
                Use filters to find overdue payments, high-value receivables, or analyze payment patterns.
            </p>
        </field>
    </record>

    <!-- Cash Management Dashboard -->
    <record id="action_healthcare_cash_management" model="ir.actions.act_window">
        <field name="name">Cash Management - Nurse Collections</field>
        <field name="res_model">health.payment.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_method', '=', 'cash')]</field>
        <field name="context">{'search_default_cash_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No cash collections found!
            </p>
            <p>
                This dashboard tracks cash payments collected by nurses that need
                to be delivered to the Operations Manager.
            </p>
        </field>
    </record>

    <!-- Overdue Patients Action -->
    <record id="action_healthcare_overdue_patients" model="ir.actions.act_window">
        <field name="name">Overdue Client Payments</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'search_default_overdue_patients': 1,
            'search_default_group_by_patient': 1
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_healthcare_ar_payments_tree')})]"/>
        <field name="search_view_id" ref="view_healthcare_ar_payments_filter"/>
        <field name="domain">[
            ('account_id.reconcile', '=', True),
            ('balance', '!=', 0),
            ('account_id.account_type', '=', 'asset_receivable'),
            ('date_maturity', '&lt;', context_today()),
            ('reconciled', '=', False)
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No overdue payments! 🎉
            </p>
            <p>
                This view shows patients with overdue payments that require follow-up.
                Use the contact information to reach out to patients for payment collection.
            </p>
        </field>
    </record>

    <!-- Healthcare Invoices List View with Red Invoice State -->
    <record id="view_healthcare_invoices_list" model="ir.ui.view">
        <field name="name">Healthcare Invoices List</field>
        <field name="model">account.move</field>
        <field name="priority">15</field>
        <field name="arch" type="xml">
            <list string="Healthcare Invoices"
                  decoration-success="state=='posted' and payment_state=='paid'"
                  decoration-warning="state=='draft'"
                  decoration-info="state=='posted' and payment_state in ('partial', 'not_paid')"
                  decoration-danger="state=='cancel'"
                  create="false" delete="false">

                <!-- Key invoice information -->
                <field name="name" string="Invoice Number" readonly="1"/>
                <field name="partner_id" string="Client" readonly="1"/>
                <field name="invoice_date" readonly="1"/>
                <field name="invoice_date_due" widget="remaining_days" optional="show" invisible="payment_state in ('paid', 'in_payment')"/>
                <field name="amount_total" readonly="1" sum="Total Amount"/>
                <field name="amount_residual" readonly="1" sum="Amount Due" string="Amount Due"/>

                <!-- Payment state -->
                <field name="payment_state" readonly="1" widget="badge"
                       decoration-success="payment_state=='paid'"
                       decoration-warning="payment_state in ('partial', 'in_payment')"
                       decoration-danger="payment_state=='not_paid'"/>

                <!-- Optional fields -->
                <field name="invoice_origin" readonly="1" optional="show" string="Source Document"/>
                <field name="healthcare_service_type" readonly="1" optional="hide" string="Service Type"/>

                <!-- Hidden fields for functionality -->
                <field name="state" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="move_type" column_invisible="1"/>

            </list>
        </field>
    </record>

    <!-- Healthcare Invoices Search View -->
    <record id="view_healthcare_invoices_filter" model="ir.ui.view">
        <field name="name">Healthcare Invoices Search</field>
        <field name="model">account.move</field>
        <field name="priority">15</field>
        <field name="arch" type="xml">
            <search string="Search Healthcare Invoices">
                <field name="partner_id"/>
            </search>
        </field>
    </record>

    <!-- Healthcare Invoices Dashboard Action -->
    <record id="action_healthcare_invoices" model="ir.actions.act_window">
        <field name="name">Healthcare Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'default_move_type': 'out_invoice',
            'search_default_posted_invoices': 1
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_healthcare_invoices_list')})]"/>
        <field name="search_view_id" ref="view_healthcare_invoices_filter"/>
        <field name="domain">[
            ('move_type', '=', 'out_invoice')
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No healthcare invoices found!
            </p>
            <p>
                This view shows all healthcare invoices with their payment and submission status.
                Use filters to find invoices by payment state, invoice state, or client.
            </p>
        </field>
    </record>

</odoo>
