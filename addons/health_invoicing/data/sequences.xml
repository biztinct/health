<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Service Package Sequence -->
    <record id="seq_health_service_package" model="ir.sequence">
        <field name="name">Health Service Package</field>
        <field name="code">health.service.package</field>
        <field name="prefix">PKG</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Payment Transaction Sequence -->
    <record id="seq_health_payment_transaction" model="ir.sequence">
        <field name="name">Health Payment Transaction</field>
        <field name="code">health.payment.transaction</field>
        <field name="prefix">PAY</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Prepaid Service Consumption Sequence -->
    <record id="seq_health_prepaid_service" model="ir.sequence">
        <field name="name">Health Prepaid Service</field>
        <field name="code">health.prepaid.service</field>
        <field name="prefix">CONS</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- OM Receipt Sequence -->
    <record id="seq_health_om_receipt" model="ir.sequence">
        <field name="name">OM Cash Receipt</field>
        <field name="code">health.om.receipt</field>
        <field name="prefix">OM-REC-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>