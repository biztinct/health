<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        The six official facilities, using the legacy facility codes verbatim
        (01_01_00 … 02_01_02) so migrated bookings keep the branch they were
        delivered from. Existing databases are brought in line by
        migration.lookup.seeder.seed_facilities(), which also re-points any
        reference sitting on an older generic city facility.
    -->

    <record id="facility_hn_pk_pkgdvu" model="health.facility">
        <field name="name">HN_PK_PKGDVU</field>
        <field name="code">01_01_00</field>
        <field name="facility_type">main_clinic</field>
        <field name="facility_status">operational</field>
        <field name="street">-</field>
        <field name="city">Hà Nội</field>
        <field name="catchment_province_id" ref="catchment_province_hanoi"/>
    </record>

    <record id="facility_hn_ns_minh_khai" model="health.facility">
        <field name="name">HN_NS_Minh_Khai</field>
        <field name="code">01_01_01</field>
        <field name="facility_type">branch_clinic</field>
        <field name="facility_status">operational</field>
        <field name="street">-</field>
        <field name="city">Hà Nội</field>
        <field name="catchment_province_id" ref="catchment_province_hanoi"/>
    </record>

