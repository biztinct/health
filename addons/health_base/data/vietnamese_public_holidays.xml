<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
    Vietnamese Public Holidays 2025

    This file defines standard Vietnamese public holidays with pricing multipliers
    for the healthcare pricing engine.

    Multipliers:
    - TET (Lunar New Year): 3.0x (highest demand, triple pricing)
    - National Holidays: 2.0x (double pricing)
    - Regional/Observances: 1.0x (standard pricing)
    -->

    <!-- TET Nguyen Dan 2025 (Lunar New Year) -->
    <record id="holiday_tet_2025" model="resource.calendar.leaves">
        <field name="name">TET Nguyen Dan 2025</field>
        <field name="date_from">2025-01-28 00:00:00</field>
        <field name="date_to">2025-02-03 23:59:59</field>
        <field name="holiday_type_id" model="health.lookup.value" search="[('category_code', '=', 'holiday_type'), ('code', '=', 'tet')]"/>
        <field name="price_multiplier">3.0</field>
        <field name="is_pricing_holiday" eval="True"/>
        <field name="resource_id" eval="False"/>
        <field name="calendar_id" eval="False"/>
    </record>

    <!-- Hung Kings' Commemoration Day (10th day of 3rd lunar month) -->
    <record id="holiday_hung_kings_2025" model="resource.calendar.leaves">
