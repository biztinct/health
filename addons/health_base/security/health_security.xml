<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Healthcare Security Groups -->
    
    <!-- Healthcare module category -->
    <record id="module_category_healthcare" model="ir.module.category">
        <field name="name">Healthcare</field>
        <field name="description">Healthcare Management System</field>
        <field name="sequence">15</field>
    </record>

    <!-- Healthcare privilege for Access Rights tab -->
    <record id="res_groups_privilege_healthcare" model="res.groups.privilege">
        <field name="name">Healthcare</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="module_category_healthcare"/>
    </record>
    
    <!-- Base Healthcare Group -->
    <record id="group_healthcare_base" model="res.groups">
        <field name="name">Healthcare: Base Access</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Basic healthcare access - can view own data</field>
    </record>
    
    <!-- Healthcare Staff Groups -->
    <record id="group_healthcare_receptionist" model="res.groups">
        <field name="name">Healthcare: Receptionist</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_base'))]"/>
        <field name="comment">Receptionist - patient intake, appointment scheduling</field>
    </record>
    
    <record id="group_healthcare_nurse" model="res.groups">
        <field name="name">Healthcare: Nurse</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_base'))]"/>
        <field name="comment">Nurse - patient care, basic clinical notes</field>
    </record>
    
    <record id="group_healthcare_head_nurse" model="res.groups">
        <field name="name">Healthcare: Head Nurse</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_nurse'))]"/>
        <field name="comment">Head Nurse - nurse supervision, advanced clinical access</field>
    </record>
    
    <record id="group_healthcare_doctor" model="res.groups">
        <field name="name">Healthcare: Doctor</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_base'))]"/>
        <field name="comment">Doctor - full clinical access, prescriptions, diagnoses</field>
    </record>
    
    <!-- Administrative Groups -->
    <record id="group_healthcare_sales" model="res.groups">
        <field name="name">Healthcare: Sales</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_base'))]"/>
        <field name="comment">Sales - lead management, initial patient contact</field>
    </record>
    
    <record id="group_healthcare_operations_manager" model="res.groups">
        <field name="name">Healthcare: Operations Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_sales'))]"/>
        <field name="comment">Operations Manager - scheduling oversight, staff coordination</field>
    </record>
    
    <record id="group_healthcare_finance" model="res.groups">
        <field name="name">Healthcare: Finance</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_base'))]"/>
        <field name="comment">Finance - billing, invoicing, financial reports</field>
    </record>
    
    <!-- Management Groups -->
    <record id="group_healthcare_manager" model="res.groups">
        <field name="name">Healthcare: Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_operations_manager')), (4, ref('group_healthcare_head_nurse')), (4, ref('group_healthcare_finance'))]"/>
        <field name="comment">Manager - facility management, full operational access</field>
    </record>
    
    <record id="group_healthcare_admin" model="res.groups">
        <field name="name">Healthcare: Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_manager'))]"/>
        <field name="comment">Administrator - system configuration, user management</field>
    </record>
    
    <!-- Record Custodian: the data-governance duty group. Archive is a
         custodian function (delete is a user function) — the archive wizard
         and the restore action are gated on this group. Deliberately NOT
         implied by admin/manager: tenant admins assign the duty explicitly
         (the Healthcare privilege is tenant-admin-assignable, see
         the tenant-admin privilege allow-list). -->
    <record id="group_healthcare_custodian" model="res.groups">
        <field name="name">Healthcare: Record Custodian</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_base'))]"/>
        <field name="comment">Record Custodian - archives records, restores deletions, oversees the data lifecycle</field>
    </record>

    <record id="group_healthcare_owner" model="res.groups">
        <field name="name">Healthcare: Owner</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_admin')), (4, ref('group_healthcare_custodian'))]"/>
        <field name="comment">Owner - full healthcare access, business oversight</field>
    </record>
    
    <!-- Patient Portal Group -->
    <record id="group_healthcare_patient" model="res.groups">
        <field name="name">Healthcare: Patient Portal</field>
        <field name="privilege_id" ref="res_groups_privilege_healthcare"/>
        <field name="comment">Patient Portal - view own records, book appointments</field>
    </record>

    <!-- CRITICAL: Users must be able to read their own partner record for login -->
    <record id="rule_user_own_partner" model="ir.rule">
        <field name="name">User: Own Partner Record</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        CRITICAL: core mail reads base.partner_root.email_normalized WITHOUT
        sudo in two places — _message_get_default_recipients (composer and mail
        templates) and _message_get_suggested_recipients_batch, which EVERY
        chatter render drives. An internal user who cannot read that one
        partner therefore gets an AccessError dialog instead of a chatter, and
        the ops/CRM personas cannot: they hold neither the healthcare-staff
        rule (342) nor any rule whose domain matches the root partner.

        The `groups` field below is NON-NEGOTIABLE. ir.rule._compute_global
        makes a rule GLOBAL iff `groups` is empty, and global rules are AND-ed
        into every partner query for every user — omitting it would collapse
        res.partner to a single record system-wide. With `groups` set, group
        rules OR together and the widening is exactly {base.partner_root}.
        Read-only on purpose: _get_rules filters on perm_<mode>, so this rule
        can never grant write on the root partner.

        The id is baked at XML load because the ir.rule eval context is only
        {user, company_ids, company_id} — `ref()` is not available at rule
        evaluation time, and a hard-coded 2 is database-specific.
        (SH-1 §6; precedent: the rule that keeps the platform administrator off the
        clinic's people list, now health_access/security/health_access_security.xml.)
    -->
    <record id="rule_internal_read_root_partner" model="ir.rule">
        <field name="name">Internal users: read the root (OdooBot) partner</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force"
               eval="'[(\'id\', \'=\', ' + str(ref('base.partner_root')) + ')]'"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- System administrators have unrestricted access -->
    <record id="rule_system_admin_all_partners" model="ir.rule">
        <field name="name">System Admin: All Partners</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <!-- Healthcare staff can access patients and business partners -->
    <record id="rule_healthcare_staff_partners" model="ir.rule">
        <field name="name">Healthcare Staff: Patient and Business Partners</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[
            '|', '|', '|',
            ('id', '=', user.partner_id.id),
            ('is_patient', '=', False),
            '&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False),
            '&amp;', ('primary_facility_id.catchment_province_id', '=', user.catchment_province_id.id), ('primary_facility_id.catchment_province_id', '!=', False)
        ]</field>
        <field name="groups" eval="[(4, ref('group_healthcare_nurse')), (4, ref('group_healthcare_doctor')), (4, ref('group_healthcare_receptionist')), (4, ref('group_healthcare_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_healthcare_owner_all_partners" model="ir.rule">
        <field name="name">Healthcare Owner: All Partners</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_healthcare_owner'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    
    <!-- Patients can only see their own records -->
    <record id="rule_patient_own_records" model="ir.rule">
        <field name="name">Patient Portal: Own Records Only</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_healthcare_patient'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <!-- Facility access rules -->
    <record id="rule_staff_assigned_facilities" model="ir.rule">
        <field name="name">Staff: Assigned Facilities</field>
        <field name="model_id" ref="model_health_facility"/>
        <field name="domain_force">[
            '&amp;',
            '&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False),
            '|', ('facility_manager_id', '=', user.id), ('head_nurse_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('group_healthcare_nurse')), (4, ref('group_healthcare_head_nurse'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <!-- Managers can access all facilities -->
    <record id="rule_manager_all_facilities" model="ir.rule">
        <field name="name">Manager: Own Catchment Facilities</field>
        <field name="model_id" ref="model_health_facility"/>
        <field name="domain_force">['&amp;', ('catchment_province_id', '=', user.catchment_province_id.id), ('catchment_province_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_healthcare_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_owner_all_facilities" model="ir.rule">
        <field name="name">Owner: All Facilities</field>
        <field name="model_id" ref="model_health_facility"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_healthcare_owner'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    
    <!-- Partner category for healthcare classification.

         These carried `parent_id ref="base.res_partner_category_0"`, which is
         defined ONLY in base/data/res_partner_demo.xml — DEMO data. Referencing
         it from a `data` file made health_base uninstallable on any database
         created without demo data, i.e. on a production install:
             ParseError: while parsing health_base/security/health_security.xml:212
         Found by the GC-3 CI gate, which installs demo-less on purpose; vietuat
         never showed it because that database was created WITH demo data.

         Dropping the field rather than repointing it is deliberate: Odoo writes
         only the fields a record declares, so an upgrade leaves the existing
         parent_id untouched on databases that already have one (verified on
         vietuat: categories 81/82/83 still parented to 1 after the upgrade),
         while a fresh install simply creates them unparented. -->
    <record id="patient_category" model="res.partner.category">
        <field name="name">Healthcare Patient</field>
        <field name="color">4</field>
    </record>
    
    <record id="staff_category" model="res.partner.category">
        <field name="name">Healthcare Staff</field>
        <field name="color">2</field>
    </record>
    
    <record id="facility_category" model="res.partner.category">
        <field name="name">Healthcare Facility</field>
        <field name="color">6</field>
    </record>
    
    <!-- Data privacy and HIPAA compliance settings -->
    <record id="healthcare_data_retention_policy" model="ir.config_parameter">
        <field name="key">healthcare.data_retention_years</field>
        <field name="value">7</field>
    </record>
    
    <record id="healthcare_audit_logging" model="ir.config_parameter">
        <field name="key">healthcare.audit_logging_enabled</field>
        <field name="value">True</field>
    </record>
    
    <record id="healthcare_encryption_required" model="ir.config_parameter">
        <field name="key">healthcare.encryption_required</field>
        <field name="value">True</field>
    </record>
    
    <!-- Vietnamese compliance settings -->
    <record id="vietnam_moh_integration" model="ir.config_parameter">
        <field name="key">vietnam.moh_integration_enabled</field>
        <field name="value">True</field>
    </record>
    
    <record id="vietnam_tax_authority_integration" model="ir.config_parameter">
        <field name="key">vietnam.tax_authority_integration_enabled</field>
        <field name="value">True</field>
    </record>
    
</odoo>
