<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Healthcare Security Groups -->
    
    <!-- Healthcare module category -->
    <record id="module_category_healthcare" model="ir.module.category">
        <field name="name">Healthcare</field>
        <field name="description">Healthcare Management System</field>
        <field name="sequence">15</field>
    </record>
    
    <!-- Base Healthcare Group -->
    <record id="group_healthcare_base" model="res.groups">
        <field name="name">Healthcare: Base Access</field>
        <field name="category_id" ref="module_category_healthcare"/>
        <field name="comment">Basic healthcare access - can view own data</field>
    </record>
    
    <!-- Healthcare Staff Groups -->
    <record id="group_healthcare_receptionist" model="res.groups">
        <field name="name">Healthcare: Receptionist</field>
        <field name="category_id" ref="module_category_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_base'))]"/>
        <field name="comment">Receptionist - patient intake, appointment scheduling</field>
    </record>
    
    <record id="group_healthcare_nurse" model="res.groups">
        <field name="name">Healthcare: Nurse</field>
        <field name="category_id" ref="module_category_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_base'))]"/>
        <field name="comment">Nurse - patient care, basic clinical notes</field>
    </record>
    
    <record id="group_healthcare_head_nurse" model="res.groups">
        <field name="name">Healthcare: Head Nurse</field>
        <field name="category_id" ref="module_category_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_nurse'))]"/>
        <field name="comment">Head Nurse - nurse supervision, advanced clinical access</field>
    </record>
    
    <record id="group_healthcare_doctor" model="res.groups">
        <field name="name">Healthcare: Doctor</field>
        <field name="category_id" ref="module_category_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_base'))]"/>
        <field name="comment">Doctor - full clinical access, prescriptions, diagnoses</field>
    </record>
    
    <!-- Administrative Groups -->
    <record id="group_healthcare_sales" model="res.groups">
        <field name="name">Healthcare: Sales</field>
        <field name="category_id" ref="module_category_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_base'))]"/>
        <field name="comment">Sales - lead management, initial patient contact</field>
    </record>
    
    <record id="group_healthcare_operations_manager" model="res.groups">
        <field name="name">Healthcare: Operations Manager</field>
        <field name="category_id" ref="module_category_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_sales'))]"/>
        <field name="comment">Operations Manager - scheduling oversight, staff coordination</field>
    </record>
    
    <record id="group_healthcare_finance" model="res.groups">
        <field name="name">Healthcare: Finance</field>
        <field name="category_id" ref="module_category_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_base'))]"/>
        <field name="comment">Finance - billing, invoicing, financial reports</field>
    </record>
    
    <!-- Management Groups -->
    <record id="group_healthcare_manager" model="res.groups">
        <field name="name">Healthcare: Manager</field>
        <field name="category_id" ref="module_category_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_operations_manager')), (4, ref('group_healthcare_head_nurse')), (4, ref('group_healthcare_finance'))]"/>
        <field name="comment">Manager - facility management, full operational access</field>
    </record>
    
    <record id="group_healthcare_admin" model="res.groups">
        <field name="name">Healthcare: Administrator</field>
        <field name="category_id" ref="module_category_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_manager'))]"/>
        <field name="comment">Administrator - system configuration, user management</field>
    </record>
    
    <record id="group_healthcare_owner" model="res.groups">
        <field name="name">Healthcare: Owner</field>
        <field name="category_id" ref="module_category_healthcare"/>
        <field name="implied_ids" eval="[(4, ref('group_healthcare_admin'))]"/>
        <field name="comment">Owner - full system access, business oversight</field>
    </record>
    
    <!-- Patient Portal Group -->
    <record id="group_healthcare_patient" model="res.groups">
        <field name="name">Healthcare: Patient Portal</field>
        <field name="category_id" ref="module_category_healthcare"/>
        <field name="comment">Patient Portal - view own records, book appointments</field>
    </record>
    
    <!-- Record Rules for Patient Data Security -->
    
    <!-- Patients can only see their own records -->
    <record id="rule_patient_own_records" model="ir.rule">
        <field name="name">Patient: Own Records Only</field>
        <field name="model_id" ref="model_health_patient"/>
        <field name="domain_force">[('partner_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_healthcare_patient'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <!-- Healthcare staff can see all patients -->
    <record id="rule_staff_all_patients" model="ir.rule">
        <field name="name">Healthcare Staff: All Patients</field>
        <field name="model_id" ref="model_health_patient"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_healthcare_nurse')), (4, ref('group_healthcare_doctor')), (4, ref('group_healthcare_receptionist'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <!-- Only managers and admins can delete patients -->
    <record id="rule_manager_delete_patients" model="ir.rule">
        <field name="name">Manager: Delete Patients</field>
        <field name="model_id" ref="model_health_patient"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_healthcare_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    
    <!-- Facility access rules -->
    <record id="rule_staff_assigned_facilities" model="ir.rule">
        <field name="name">Staff: Assigned Facilities</field>
        <field name="model_id" ref="model_health_facility"/>
        <field name="domain_force">['|', ('facility_manager_id', '=', user.id), ('head_nurse_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_healthcare_nurse')), (4, ref('group_healthcare_head_nurse'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <!-- Managers can access all facilities -->
    <record id="rule_manager_all_facilities" model="ir.rule">
        <field name="name">Manager: All Facilities</field>
        <field name="model_id" ref="model_health_facility"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_healthcare_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    
    <!-- Partner category for healthcare classification -->
    <record id="patient_category" model="res.partner.category">
        <field name="name">Healthcare Patient</field>
        <field name="color">4</field>
        <field name="parent_id" ref="base.res_partner_category_0"/>
    </record>
    
    <record id="staff_category" model="res.partner.category">
        <field name="name">Healthcare Staff</field>
        <field name="color">2</field>
        <field name="parent_id" ref="base.res_partner_category_0"/>
    </record>
    
    <record id="facility_category" model="res.partner.category">
        <field name="name">Healthcare Facility</field>
        <field name="color">6</field>
        <field name="parent_id" ref="base.res_partner_category_0"/>
    </record>
    
    
    <!-- Data privacy and HIPAA compliance settings -->
    <record id="healthcare_data_retention_policy" model="ir.config_parameter">
        <field name="key">healthcare.data_retention_years</field>
        <field name="value">7</field>
    </record>
    
    <record id="healthcare_audit_logging" model="ir.config_parameter">
        <field name="key">healthcare.audit_logging_enabled</field>
        <field name="value">True</field>
    </record>
    
    <record id="healthcare_encryption_required" model="ir.config_parameter">
        <field name="key">healthcare.encryption_required</field>
        <field name="value">True</field>
    </record>
    
    <!-- Vietnamese compliance settings -->
    <record id="vietnam_moh_integration" model="ir.config_parameter">
        <field name="key">vietnam.moh_integration_enabled</field>
        <field name="value">True</field>
    </record>
    
    <record id="vietnam_tax_authority_integration" model="ir.config_parameter">
        <field name="key">vietnam.tax_authority_integration_enabled</field>
        <field name="value">True</field>
    </record>
</odoo>