<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_health_lookup_import_wizard_form" model="ir.ui.view">
        <field name="name">health.lookup.import.wizard.form</field>
        <field name="model">health.lookup.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Dropdown Values">
                <div invisible="state == 'done'">
                    <h3>One workbook, one sheet per dropdown</h3>
                    <p class="text-muted">
                        Start with <b>Download Template</b>: it produces a
                        spreadsheet with one sheet per vocabulary, already filled
                        with the current values. Edit it and upload it back here.
                        The sheet <i>name</i> tells us which dropdown a row belongs
                        to, so there is no category column to fill in, and rows are
                        matched on <code>code</code> — so re-uploading the same file
                        updates the values instead of duplicating them.
                    </p>
                    <p class="text-muted">
                        To load just one dropdown instead, go to
                        <b>Value Categories</b>, open it, and use
                        <b>Manage Values</b> — that screen already knows its
                        category, so a plain
                        <code>code / name / name_vi</code> sheet is enough.
                    </p>
                    <group>
                        <field name="file" filename="filename" string="Spreadsheet (.xlsx)"/>
                        <field name="filename" invisible="1"/>
                        <field name="state" invisible="1"/>
                    </group>
                </div>
                <div invisible="state != 'done'">
                    <h3>Import finished</h3>
                    <field name="log" widget="text" readonly="1" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_download_template" type="object"
                            string="Download Template" class="btn-secondary"
                            invisible="state == 'done'"/>
                    <button name="action_import" type="object"
                            string="Import" class="btn-primary"
                            invisible="state == 'done' or not file"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_health_lookup_import_wizard" model="ir.actions.act_window">
        <field name="name">Import / Template</field>
        <field name="res_model">health.lookup.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Reachable from the values screen itself, which is where someone
         standing in front of a list of vocabularies would look for it. -->
    <record id="view_health_lookup_value_list_import_button" model="ir.ui.view">
        <field name="name">health.lookup.value.list.import.button</field>
        <field name="model">health.lookup.value</field>
        <field name="inherit_id" ref="health_base.view_health_lookup_value_list"/>
        <field name="arch" type="xml">
            <!-- Must land BEFORE the first field: Odoo expects <header> as the
                 opening child of <list>, and position="inside" appends. -->
            <xpath expr="//list/field[1]" position="before">
                <header>
                    <button name="%(action_health_lookup_import_wizard)d"
                            type="action" string="Import / Template"
                            class="btn-secondary"/>
                </header>
            </xpath>
        </field>
    </record>

</odoo>
