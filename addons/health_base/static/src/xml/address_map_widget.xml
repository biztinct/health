<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="health_base.AddressMapWidget">
        <div class="o_address_map_widget" style="height: 100%; width: 100%;">
            <!-- Map Container -->
            <div t-ref="mapContainer"
                 class="o_map_container"
                 style="height: 400px; width: 100%; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            </div>

            <!-- Coordinates and Route Info Display Below Map -->
            <div t-if="props.record.data.partner_latitude and props.record.data.partner_longitude"
                 class="o_map_info mt-2 p-3"
                 style="background: #f8f9fa; border-radius: 6px; font-size: 12px; color: #666;">

                <!-- GPS Coordinates Row -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <i class="fa fa-map-marker text-danger me-1"/>
                        <strong>Patient GPS:</strong>
                        <span class="ms-1">
                            <t t-esc="props.record.data.partner_latitude.toFixed(6)"/>,
                            <t t-esc="props.record.data.partner_longitude.toFixed(6)"/>
                        </span>
                    </div>
                    <div t-if="props.record.data.date_localization" class="text-muted">
                        <i class="fa fa-calendar me-1"/>
                        <t t-esc="props.record.data.date_localization"/>
                    </div>
                </div>

                <!-- Driving Route Info Row -->
                <div t-if="state.facilityName || state.routeError"
                     class="pt-2"
                     style="border-top: 1px solid #dee2e6;">

                    <!-- Loading State -->
                    <div t-if="state.isLoadingRoute" class="text-center py-2">
                        <i class="fa fa-spinner fa-spin me-1"/>
                        Calculating driving route...
                    </div>

                    <!-- Route Error -->
                    <div t-elif="state.routeError" class="text-warning">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        <t t-esc="state.routeError"/>
                        <span t-if="state.routeError === 'Facility has no coordinates'" class="ms-2">
                            (Please geocode the facility first)
                        </span>
                    </div>

                    <!-- Route Info -->
                    <div t-elif="state.drivingDistance" class="d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fa fa-building text-success me-1"/>
                            <strong>Route to <t t-esc="state.facilityName"/>:</strong>
                        </div>
                        <div class="text-end">
                            <span class="me-3">
                                <i class="fa fa-car text-primary me-1"/>
                                <strong><t t-esc="state.drivingDistance"/> km</strong>
                            </span>
                            <span t-if="state.drivingDuration">
                                <i class="fa fa-clock-o text-secondary me-1"/>
                                <t t-esc="state.drivingDuration"/>
                            </span>
                        </div>
                    </div>

                    <!-- Facility Coords -->
                    <div t-if="state.facilityLat and state.facilityLon" class="text-muted mt-1" style="font-size: 11px;">
                        <i class="fa fa-hospital-o text-success me-1"/>
                        Facility GPS: <t t-esc="state.facilityLat.toFixed(6)"/>, <t t-esc="state.facilityLon.toFixed(6)"/>
                    </div>
                </div>

                <!-- Legend -->
                <div class="d-flex justify-content-between align-items-center mt-2 pt-2" style="border-top: 1px solid #dee2e6;">
                    <div style="font-size: 11px;">
                        <span class="me-3">
                            <span style="display: inline-block; width: 12px; height: 12px; background: #E53935; border-radius: 50%; border: 2px solid white; box-shadow: 0 1px 2px rgba(0,0,0,0.2);"></span>
                            <span class="ms-1">Patient</span>
                        </span>
                        <span>
                            <span style="display: inline-block; width: 12px; height: 12px; background: #0F6D66; border-radius: 50%; border: 2px solid white; box-shadow: 0 1px 2px rgba(0,0,0,0.2);"></span>
                            <span class="ms-1">Facility</span>
                        </span>
                    </div>
                    <small class="text-muted">
                        <i t-att-class="state.mapProvider === 'google' ? 'fa fa-google' : 'fa fa-globe'" class="me-1"/>
                        <t t-if="state.mapProvider === 'google'">Google Maps</t>
                        <t t-else="">OpenStreetMap</t>
                    </small>
                </div>
            </div>

            <!-- No Coordinates Message -->
            <div t-if="!props.record.data.partner_latitude or !props.record.data.partner_longitude"
                 class="o_map_no_coords text-center text-muted p-4"
                 style="height: 400px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #f8f9fa; border-radius: 8px;">
                <i class="fa fa-map-marker mb-3" style="font-size: 48px; color: #0F6D66; opacity: 0.5;"/>
                <p style="margin: 0; font-size: 14px;">
                    Click "Geocode Address" to set patient location<br/>
                    <small>Map with driving route will display when coordinates are available</small>
                </p>
            </div>
        </div>
    </t>

</templates>
