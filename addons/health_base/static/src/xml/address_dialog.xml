<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="health_base.AddressDialog">
    <Dialog title="dialogTitle" size="'md'">
        <div class="o_address_dialog">
            <div class="row g-2">
                <div class="col-6"><label class="o_form_label">House No.</label>
                    <input class="form-control" t-model="state.house_number"/></div>
                <div class="col-6"><label class="o_form_label">Street</label>
                    <input class="form-control" t-model="state.street"/></div>
                <div class="col-6"><label class="o_form_label">Alley (Ngõ)</label>
                    <input class="form-control" t-model="state.alley_number"/></div>
                <div class="col-6"><label class="o_form_label">Sub-alley (Ngách)</label>
                    <input class="form-control" t-model="state.sub_alley_number"/></div>
                <div class="col-6"><label class="o_form_label">Ward / Commune</label>
                    <input class="form-control" t-model="state.ward_commune"/></div>
                <div class="col-6"><label class="o_form_label">Named Area</label>
                    <input class="form-control" t-model="state.named_area"/></div>
                <div class="col-6"><label class="o_form_label">Building</label>
                    <input class="form-control" t-model="state.building_name"/></div>
                <div class="col-6"><label class="o_form_label">Apartment</label>
                    <input class="form-control" t-model="state.apartment_number"/></div>
                <div class="col-6"><label class="o_form_label">City</label>
                    <select class="form-select" t-on-change="onCityChange">
                        <option value="">-</option>
                        <t t-foreach="provinces" t-as="p" t-key="p.id">
                            <option t-att-value="p.id"
                                    t-att-selected="p.id === state.catchment_province_id"
                                    t-esc="p.name"/>
                        </t>
                    </select></div>
                <div class="col-6"><label class="o_form_label">District</label>
                    <select class="form-select" t-on-change="onDistrictChange"
                            t-att-disabled="!state.catchment_province_id">
                        <option value="">-</option>
                        <t t-foreach="districtOptions" t-as="d" t-key="d.id">
                            <option t-att-value="d.id"
                                    t-att-selected="d.id === state.district_id"
                                    t-esc="d.name"/>
                        </t>
                    </select></div>
                <div class="col-6"><label class="o_form_label">Postal Code</label>
                    <input class="form-control" t-model="state.zip"/></div>
            </div>
            <div class="o_address_preview mt-3" t-if="preview">
                <i class="fa fa-map-marker me-2"/><span t-esc="preview"/>
            </div>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-primary" t-on-click="save">Save Address</button>
            <button class="btn btn-secondary" t-on-click="() => props.close()">Cancel</button>
        </t>
    </Dialog>
</t>

</templates>
