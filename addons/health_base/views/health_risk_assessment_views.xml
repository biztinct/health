<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Fall Risk Assessment Form View -->
    <record id="view_health_fall_risk_form" model="ir.ui.view">
        <field name="name">health.fall.risk.form</field>
        <field name="model">health.fall.risk</field>
        <field name="arch" type="xml">
            <form string="Fall Risk Assessment" class="o_form_record_class">
                <header>
                    <field name="risk_level" widget="badge" decoration-success="risk_level == 'low'" 
                           decoration-warning="risk_level == 'medium'" decoration-danger="risk_level == 'high'"/>
                </header>
                <sheet string="Assessment">
                    <div class="oe_button_box" name="button_box" groups="base.group_user">
                        <button name="generate_intervention_plan" type="object" 
                                string="Generate Plan" class="oe_stat_button" icon="fa-clipboard"/>
                    </div>
                    <group>
                        <group string="Patient Information">
                            <field name="patient_id"/>
                            <field name="assessment_date"/>
                            <field name="assessed_by"/>
                        </group>
                        <group string="Risk Score">
                            <field name="morse_score" readonly="1"/>
                            <field name="risk_level" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Morse Fall Scale" name="morse_scale">
                            <group>
                                <group string="Assessment Components">
                                    <field name="history_of_falling"/>
                                    <field name="secondary_diagnosis"/>
                                    <field name="ambulatory_aid"/>
                                    <field name="iv_therapy"/>
                                    <field name="gait_transfer"/>
                                    <field name="mental_status"/>
                                </group>
                            </group>
                        </page>
                        <page string="Environmental Assessment" name="environmental">
                            <field name="environmental_hazards" placeholder="Home environment assessment..."/>
                            <field name="vietnamese_environmental_hazards" placeholder="Vietnamese environmental assessment..."/>
                        </page>
                        <page string="Intervention Plan" name="intervention">
                            <field name="intervention_plan" placeholder="Personalized fall prevention plan..."/>
                            <field name="vietnamese_intervention_plan" placeholder="Vietnamese intervention plan..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- Fall Risk Assessment List View -->
    <record id="view_health_fall_risk_list" model="ir.ui.view">
        <field name="name">health.fall.risk.list</field>
        <field name="model">health.fall.risk</field>
        <field name="arch" type="xml">
            <list string="Fall Risk Assessments">
                <field name="patient_id"/>
                <field name="assessment_date"/>
                <field name="morse_score"/>
                <field name="risk_level" widget="badge" decoration-success="risk_level == 'low'" 
                       decoration-warning="risk_level == 'medium'" decoration-danger="risk_level == 'high'"/>
                <field name="assessed_by"/>
            </list>
        </field>
    </record>

    <!-- Fall Risk Assessment Search View -->
    <record id="view_health_fall_risk_search" model="ir.ui.view">
        <field name="name">health.fall.risk.search</field>
        <field name="model">health.fall.risk</field>
        <field name="arch" type="xml">
            <search string="Search Fall Risk Assessments">
                <field name="patient_id"/>
                <field name="assessed_by"/>
                <filter string="High Risk" name="high_risk" domain="[('risk_level', '=', 'high')]"/>
                <filter string="Medium Risk" name="medium_risk" domain="[('risk_level', '=', 'medium')]"/>
                <filter string="Low Risk" name="low_risk" domain="[('risk_level', '=', 'low')]"/>
                <filter string="Today" name="today" domain="[('assessment_date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group expand="0" string="Group By">
                    <filter string="Risk Level" name="group_risk" context="{'group_by': 'risk_level'}"/>
                    <filter string="Patient" name="group_patient" context="{'group_by': 'patient_id'}"/>
                    <filter string="Assessment Date" name="group_date" context="{'group_by': 'assessment_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Fall Risk Assessment Action -->
    <record id="action_health_fall_risk" model="ir.actions.act_window">
        <field name="name">Fall Risk Assessments</field>
        <field name="res_model">health.fall.risk</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first fall risk assessment!
            </p>
            <p>
                Assess patient fall risk using the Morse Fall Scale and generate personalized prevention plans.
            </p>
        </field>
    </record>

    <!-- Readmission Risk Assessment Form View -->
    <record id="view_health_readmission_risk_form" model="ir.ui.view">
        <field name="name">health.readmission.risk.form</field>
        <field name="model">health.readmission.risk</field>
        <field name="arch" type="xml">
            <form string="Readmission Risk Assessment" class="o_form_record_class">
                <header>
                    <field name="risk_level" widget="badge" decoration-success="risk_level == 'low'" 
                           decoration-warning="risk_level == 'medium'" decoration-danger="risk_level == 'high'"/>
                </header>
                <sheet string="Assessment">
                    <div class="oe_button_box" name="button_box" groups="base.group_user">
                        <button name="generate_interventions" type="object" 
                                string="Generate Interventions" class="oe_stat_button" icon="fa-clipboard"/>
                    </div>
                    <group>
                        <group string="Patient Information">
                            <field name="patient_id"/>
                            <field name="assessment_date"/>
                            <field name="age" readonly="1"/>
                            <field name="gender" readonly="1"/>
                        </group>
                        <group string="Risk Score">
                            <field name="risk_score" readonly="1"/>
                            <field name="risk_level" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Medical History" name="medical">
                            <group>
                                <group string="Medical Factors">
                                    <field name="chronic_conditions"/>
                                    <field name="prior_admissions"/>
                                    <field name="emergency_visits"/>
                                </group>
                                <group string="Functional Status">
                                    <field name="adl_score"/>
                                    <field name="mobility_issues"/>
                                    <field name="cognitive_impairment"/>
                                </group>
                            </group>
                        </page>
                        <page string="Social Factors" name="social">
                            <group>
                                <group string="Living Situation">
                                    <field name="lives_alone"/>
                                    <field name="has_caregiver"/>
                                </group>
                                <group string="Access Issues">
                                    <field name="transportation_issues"/>
                                    <field name="financial_constraints"/>
                                </group>
                            </group>
                        </page>
                        <page string="Medication Factors" name="medication">
                            <group>
                                <field name="medication_count"/>
                                <field name="medication_compliance"/>
                            </group>
                        </page>
                        <page string="Recommended Interventions" name="interventions">
                            <field name="recommended_interventions" placeholder="Recommended interventions..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- Readmission Risk Assessment List View -->
    <record id="view_health_readmission_risk_list" model="ir.ui.view">
        <field name="name">health.readmission.risk.list</field>
        <field name="model">health.readmission.risk</field>
        <field name="arch" type="xml">
            <list string="Readmission Risk Assessments">
                <field name="patient_id"/>
                <field name="assessment_date"/>
                <field name="risk_score"/>
                <field name="risk_level" widget="badge" decoration-success="risk_level == 'low'" 
                       decoration-warning="risk_level == 'medium'" decoration-danger="risk_level == 'high'"/>
                <field name="chronic_conditions"/>
                <field name="prior_admissions"/>
            </list>
        </field>
    </record>

    <!-- Readmission Risk Assessment Action -->
    <record id="action_health_readmission_risk" model="ir.actions.act_window">
        <field name="name">Readmission Risk Assessments</field>
        <field name="res_model">health.readmission.risk</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first readmission risk assessment!
            </p>
            <p>
                Assess patient readmission risk and generate personalized intervention plans.
            </p>
        </field>
    </record>

</odoo>
