<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Facility Tree View -->
    <record id="view_health_facility_list" model="ir.ui.view">
        <field name="name">health.facility.list</field>
        <field name="model">health.facility</field>
        <field name="arch" type="xml">
            <list string="Healthcare Facilities" decoration-warning="facility_status=='maintenance'" decoration-danger="facility_status in ['closed_temporary', 'closed_permanent']">
                <field name="name"/>
                <field name="code"/>
                <field name="catchment_province_id"/>
                <field name="facility_type"/>
                <field name="city"/>
                <field name="state_id"/>
                <field name="facility_status"/>
                <field name="max_daily_patients"/>
                <field name="total_beds"/>
                <field name="available_beds"/>
                <field name="covers_home_visits" widget="boolean_toggle"/>
                <field name="home_visit_radius_km"/>
                <field name="facility_manager_id"/>
                <field name="patient_count"/>
                <button name="action_view_patients" type="object" icon="fa-users" title="View Patients" class="health-btn health-btn-sm"/>
                <button name="action_view_appointments" type="object" icon="fa-calendar" title="View Appointments" class="health-btn health-btn-outline health-btn-sm"/>
                <button name="action_check_license_expiry" type="object" icon="fa-certificate" title="Check License" class="health-btn health-btn-sm"/>
            </list>
        </field>
    </record>

    <!-- Facility Form View -->
    <record id="view_health_facility_form" model="ir.ui.view">
        <field name="name">health.facility.form</field>
        <field name="model">health.facility</field>
        <field name="arch" type="xml">
            <form string="Healthcare Facility">
                <header>
                    <field name="facility_status" widget="statusbar" statusbar_visible="planning,construction,operational,maintenance"/>
                    <button name="action_geocode_address" string="Geocode Address" type="object" class="health-btn health-btn-secondary" icon="fa-map-marker"/>
                    <button name="action_check_license_expiry" string="Check License" type="object" class="health-btn health-btn-primary"/>
                    <button name="action_view_patients" string="View Clients" type="object" class="health-btn health-btn-outline"/>
                    <button name="action_view_appointments" string="View Appointments" type="object" class="health-btn health-btn-outline"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_patients" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="patient_count" string='Clients' widget="statinfo"/>
                        </button>
                        <button name="action_view_appointments" type="object" class="oe_stat_button" icon="fa-calendar">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_beds"/>/<field name="available_beds"/>
                                </span>
                                <span class="o_stat_text">Beds</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="health-card-header">
                        <div class="oe_title">
                            <h1 class="health-title">
                                <field name="name" placeholder="Facility name..."/>
                            </h1>
                            <div class="health-subtitle">
                                <field name="code" placeholder="Facility code..."/>
                                <span class="health-badge health-badge-info ml-2">
                                    <field name="facility_type"/>
                                </span>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Basic Information" name="basic_info">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="building"/>
                                    <div>
                                        <span>Facility Identity</span>
                                        <small class="text-muted d-block">Contact, leadership and address details</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="building"/>
                                            <span>Facility Details</span>
                                        </div>
                                        <group col="2">
                                            <field name="facility_type"/>
                                            <field name="catchment_province_id" options="{'no_create': True}"/>
                                            <field name="phone" widget="phone"/>
                                            <field name="email" widget="email"/>
                                            <field name="website" widget="url"/>
                                            <field name="timezone"/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="users-group"/>
                                            <span>Leadership</span>
                                        </div>
                                        <group col="2">
                                            <field name="facility_manager_id"/>
                                            <field name="head_nurse_id"/>
                                            <field name="total_staff_count"/>
                                            <field name="active"/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="map-pin"/>
                                            <span>Location</span>
                                        </div>
                                        <group col="2">
                                            <field name="street"/>
                                            <field name="street2"/>
                                            <field name="city"/>
                                            <field name="state_id"/>
                                            <field name="zip"/>
                                            <field name="country_id"/>
                                            <field name="latitude"/>
                                            <field name="longitude"/>
                                        </group>
                                    </div>
                                </div>

                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="timeline"/>
                                        <span>Operating Hours</span>
                                    </div>
                                    <group>
                                        <field name="operating_hours"/>
                                    </group>
                                </div>
                            </div>
                        </page>

                        <page string="Services &amp; Capabilities" name="services">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="stethoscope"/>
                                    <div>
                                        <span>Services &amp; Capacity</span>
                                        <small class="text-muted d-block">Operational capacity and available care</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="activity"/>
                                            <span>Capacity</span>
                                        </div>
                                        <group col="2">
                                            <field name="max_daily_patients"/>
                                            <field name="total_beds"/>
                                            <field name="available_beds" readonly="1"/>
                                            <field name="consultation_rooms"/>
                                            <field name="parking_spaces"/>
                                            <field name="wheelchair_accessible" widget="boolean_toggle"/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="heart-pulse"/>
                                            <span>Capabilities</span>
                                        </div>
                                        <group col="2">
                                            <field name="has_emergency_services" widget="boolean_toggle"/>
                                            <field name="has_laboratory" widget="boolean_toggle"/>
                                            <field name="has_imaging" widget="boolean_toggle"/>
                                            <field name="has_pharmacy" widget="boolean_toggle"/>
                                        </group>
                                    </div>
                                </div>

                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="tag"/>
                                            <span>Services Offered</span>
                                        </div>
                                        <group>
                                            <field name="services_offered" widget="many2many_tags"/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="file-text"/>
                                            <span>Medical Specialties</span>
                                        </div>
                                        <group>
                                            <field name="specialties" widget="many2many_tags"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <page string="Home Visit Coverage" name="home_visits">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="map-pin"/>
                                    <div>
                                        <span>Home Visit Coverage</span>
                                        <small class="text-muted d-block">Radius, pricing and supported districts</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="map-pin"/>
                                            <span>Settings</span>
                                        </div>
                                        <group col="2">
                                            <field name="covers_home_visits" widget="boolean_toggle"/>
                                            <field name="home_visit_radius_km" invisible="not covers_home_visits"/>
                                            <field name="base_home_visit_fee" widget="monetary" invisible="not covers_home_visits"/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="map-pin"/>
                                            <span>Coverage Areas</span>
                                        </div>
                                        <group>
                                            <field name="home_visit_districts" widget="many2many_tags" invisible="not covers_home_visits"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <page string="Financial &amp; Insurance" name="financial">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="credit-card"/>
                                    <div>
                                        <span>Financial Controls</span>
                                        <small class="text-muted d-block">Currencies, revenue and insurance partners</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="credit-card"/>
                                            <span>Financial Settings</span>
                                        </div>
                                        <group col="2">
                                            <field name="default_currency_id"/>
                                            <field name="accepts_insurance" widget="boolean_toggle"/>
                                            <field name="monthly_revenue" widget="monetary" readonly="1"/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="shield-check"/>
                                            <span>Accepted Insurance Providers</span>
                                        </div>
                                        <group>
                                            <field name="accepted_insurance_providers" widget="many2many_tags" invisible="not accepts_insurance"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <page string="Licensing &amp; Compliance" name="compliance">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="shield-check"/>
                                    <div>
                                        <span>Licensing &amp; Compliance</span>
                                        <small class="text-muted d-block">Regulatory identifiers and inspection cadence</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="id-card"/>
                                            <span>Licensing</span>
                                        </div>
                                        <group col="2">
                                            <field name="business_license_number"/>
                                            <field name="health_license_number"/>
                                            <field name="license_expiry_date"/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="timeline"/>
                                            <span>Inspections</span>
                                        </div>
                                        <group col="2">
                                            <field name="last_inspection_date"/>
                                            <field name="next_inspection_date"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Facility Kanban View -->
    <record id="view_health_facility_kanban" model="ir.ui.view">
        <field name="name">health.facility.kanban</field>
        <field name="model">health.facility</field>
        <field name="arch" type="xml">
            <kanban default_group_by="facility_type">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="facility_type"/>
                <field name="facility_status"/>
                <field name="city"/>
                <field name="state_id"/>
                <field name="max_daily_patients"/>
                <field name="total_beds"/>
                <field name="available_beds"/>
                <field name="covers_home_visits"/>
                <field name="home_visit_radius_km"/>
                <field name="patient_count"/>
                <field name="monthly_revenue"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="health-card health-facility-card">
                            <div class="health-card-header">
                                <div class="health-status-indicator" t-att-class="record.facility_status.raw_value"/>
                                <strong class="health-card-title">
                                    <field name="name"/>
                                </strong>
                                <div class="dropdown">
                                    <a class="dropdown-toggle o_dropdown_kanban" data-toggle="dropdown" href="#" role="button" aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a t-if="widget.editable" type="edit" class="dropdown-item">Edit</a>
                                        <a t-if="widget.deletable" type="delete" class="dropdown-item">Delete</a>
                                        <a name="action_view_patients" type="object" class="dropdown-item">View Patients</a>
                                        <a name="action_view_appointments" type="object" class="dropdown-item">View Appointments</a>
                                        <a name="action_check_license_expiry" type="object" class="dropdown-item">Check License</a>
                                    </div>
                                </div>
                            </div>
                            <div class="health-card-body">
                                <div class="row">
                                    <div class="col-6">
                                        <small class="health-text-xs">Facility Code</small><br/>
                                        <span class="health-badge health-badge-neutral">
                                            <field name="code"/>
                                        </span>
                                    </div>
                                    <div class="col-6">
                                        <small class="health-text-xs">Type</small><br/>
                                        <field name="facility_type"/>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <small class="health-text-xs">Location</small><br/>
                                        <field name="city"/>, <field name="state_id"/>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-6">
                                        <small class="health-text-xs">Capacity</small><br/>
                                        <field name="max_daily_patients"/> patients/day
                                    </div>
                                    <div class="col-6">
                                        <small class="health-text-xs">Beds</small><br/>
                                        <field name="available_beds"/>/<field name="total_beds"/> available
                                    </div>
                                </div>
                                <div class="row mt-2" t-if="record.covers_home_visits.raw_value">
                                    <div class="col-12">
                                        <small class="health-text-xs">Home Visits</small><br/>
                                        <span class="health-badge health-badge-success">
                                            <field name="home_visit_radius_km"/> km radius
                                        </span>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-6">
                                        <small class="health-text-xs">Patients</small><br/>
                                        <field name="patient_count"/>
                                    </div>
                                    <div class="col-6">
                                        <small class="health-text-xs">Monthly Revenue</small><br/>
                                        <field name="monthly_revenue" widget="monetary"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <!-- OWL kanban compatibility -->
                    <t t-name="card">
                        <t t-call="kanban-box"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Facility Search View -->
    <record id="view_health_facility_search" model="ir.ui.view">
        <field name="name">health.facility.search</field>
        <field name="model">health.facility</field>
        <field name="arch" type="xml">
            <search string="Healthcare Facilities">
                <field name="name"/>
                <field name="catchment_province_id"/>
                <separator string="Catchment Area"/>
                <filter name="operational" string="Operational" domain="[('facility_status', '=', 'operational')]"/>
                <filter name="group_by_catchment_province" string="Catchment Area"
                        context="{'group_by': 'catchment_province_id'}"/>
            </search>
        </field>
    </record>

    <!-- Facility Action -->
    <record id="action_health_facility" model="ir.actions.act_window">
        <field name="name">Healthcare Facilities</field>
        <field name="res_model">health.facility</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_health_facility_kanban"/>
        <field name="search_view_id" ref="view_health_facility_search"/>
        <field name="context">{
            'search_default_operational': 1
        }</field>
        <field name="help" type="html">
            <div class="health-empty-state">
                <img src="/health_base/static/src/img/facility-icon.png" alt="No facilities" class="health-empty-icon"/>
                <h3 class="health-title">No healthcare facilities found</h3>
                <p class="health-text-sm">Create your first healthcare facility to start managing locations and services.</p>
                <a type="action" class="health-btn health-btn-primary">Create Facility</a>
            </div>
        </field>
    </record>
</odoo>
