<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =============================================================== -->
    <!--  Dropdown values — the client-maintained vocabularies behind     -->
    <!--  the converted Selection fields.                                 -->
    <!-- =============================================================== -->

    <record id="view_health_lookup_value_list" model="ir.ui.view">
        <field name="name">health.lookup.value.list</field>
        <field name="model">health.lookup.value</field>
        <field name="arch" type="xml">
            <!-- Inline-editable so the EN/VI globe sits on the row: every
                 required field is present, so "New" saves without a form. -->
            <list string="Dropdown Values" editable="bottom"
                  default_order="category_id, sequence, name">
                <field name="sequence" widget="handle"/>
                <!-- Read-only, never hidden. A value's vocabulary is
                     structural — moving a row between categories silently
                     breaks every record pointing at it — but the column stays
                     visible so a new line always shows which vocabulary it is
                     landing in, whether that comes from the group it was added
                     under or from default_category_id on the drill-down. -->
                <field name="category_id" readonly="1"
                       options="{'no_create': True, 'no_quick_create': True}"/>
                <field name="code"/>
                <field name="name"/>
                <field name="name_vi" string="Vietnamese Name" optional="show"/>
                <field name="description" optional="hide"/>
                <field name="usage_count" string="In Use" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="category_code" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_health_lookup_value_form" model="ir.ui.view">
        <field name="name">health.lookup.value.form</field>
        <field name="model">health.lookup.value</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="category_id"
                                   options="{'no_create': True, 'no_quick_create': True}"/>
                            <field name="name"/>
                            <field name="name_vi"/>
                        </group>
                        <group>
                            <!-- Read-only once saved: the code is what a
                                 re-import matches on. -->
                            <field name="code" readonly="id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="usage_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <div class="text-muted" invisible="not usage_count">
                        This value is in use, so it cannot be deleted. Untick
                        <b>Active</b> to stop offering it on new records — the
                        records already using it keep their history.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_health_lookup_value_search" model="ir.ui.view">
        <field name="name">health.lookup.value.search</field>
        <field name="model">health.lookup.value</field>
        <field name="arch" type="xml">
            <search string="Dropdown Values">
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <separator/>
                <filter string="Unused" name="unused" domain="[('usage_count', '=', 0)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Category" name="group_category"
                        context="{'group_by': 'category_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_health_lookup_value" model="ir.actions.act_window">
        <field name="name">Dropdown Values</field>
        <field name="res_model">health.lookup.value</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False, 'search_default_group_category': 1}</field>
        <field name="search_view_id" ref="view_health_lookup_value_search"/>
    </record>

    <!-- =============================================================== -->
    <!--  Vocabularies. Read-mostly: a category exists because a field    -->
    <!--  points at it, so the client manages VALUES, not categories.     -->
    <!-- =============================================================== -->

    <record id="view_health_lookup_category_list" model="ir.ui.view">
        <field name="name">health.lookup.category.list</field>
        <field name="model">health.lookup.category</field>
        <field name="arch" type="xml">
            <list string="Value Categories" create="false">
                <field name="name"/>
                <field name="code"/>
                <field name="used_by" string="Used On"/>
                <field name="value_count" string="Values"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
                <button name="action_open_values" type="object" icon="fa-list-ul"
                        string="Manage values" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_health_lookup_category_form" model="ir.ui.view">
        <field name="name">health.lookup.category.form</field>
        <field name="model">health.lookup.category</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_values" type="object" string="Manage Values"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code" readonly="1"/>
                        </group>
                        <group>
                            <field name="used_by"/>
                            <field name="value_count"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Use <b>Manage Values</b> to add, reorder or translate the
                        options offered by this dropdown. That screen already knows
                        the category, so an imported spreadsheet needs only
                        <code>code</code>, <code>name</code> and
                        <code>name_vi</code> columns.
                    </div>
                    <notebook>
                        <page string="Values">
                            <field name="value_ids" context="{'default_category_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="name_vi"/>
                                    <field name="usage_count" string="In Use"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_health_lookup_category" model="ir.actions.act_window">
        <field name="name">Value Categories</field>
        <field name="res_model">health.lookup.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
