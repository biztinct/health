<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================================
         VAFHS Patient Management Views - State-of-the-Art Healthcare Interface
         ========================================================================= -->

    <!-- Enhanced Patient Form View - Proper Odoo 19 Layout -->
    <record id="view_health_patient_form" model="ir.ui.view">
        <field name="name">res.partner.patient.form</field>
        <field name="model">res.partner</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <form string="Client Record" class="o_form_patient_record">
                <header>
                    <field name="patient_status" widget="statusbar" statusbar_visible="new,active,inactive"/>
                    <button name="action_activate_patient" string="Activate" type="object" class="oe_highlight"
                            invisible="patient_status == 'active'"/>
                </header>

                <sheet string="Client">
                    <div class="oe_button_box" name="button_box" groups="base.group_user">
                        <button name="action_view_appointments" type="object" class="oe_stat_button" icon="fa-calendar-check-o"
                                invisible="not is_patient">
                            <field name="visit_count" string="Bookings" widget="statinfo"/>
                        </button>

                        <!-- REPRESENTATIVE SIDE: My Patients -->
                        <button name="action_view_my_patients_as_caregiver" type="object" class="oe_stat_button" icon="fa-user-md"
                                invisible="not is_caregiver or caregiver_patient_count == 0">
                            <field name="caregiver_patient_count" string="Clients I Care For" widget="statinfo"/>
                        </button>
                        <button name="action_view_my_patients_as_payer" type="object" class="oe_stat_button" icon="fa-credit-card"
                                invisible="not is_payer or payer_patient_count == 0">
                            <field name="payer_patient_count" string="Clients I Pay For" widget="statinfo"/>
                        </button>
                        <button name="action_view_my_patients_as_referrer" type="object" class="oe_stat_button" icon="fa-share-square-o"
                                invisible="not is_referrer or referrer_patient_count == 0">
                            <field name="referrer_patient_count" string="Clients I Referred" widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1 class="d-flex align-items-center gap-3">
                            <field name="name" placeholder="Client Full Name" required="1" class="o_text_overflow flex-grow-1"/>
                            <div class="patient-badges">
                                <span class="badge patient-badge">
                                    <field name="patient_code_display" nolabel="1"/>
                                </span>
                                <span class="badge patient-badge badge-age">
                                    <field name="age_display" nolabel="1"/>
                                </span>
                                <span class="badge patient-badge badge-deceased text-danger" invisible="not deceased">
                                    <i class="fa fa-user-times" title="Deceased"/>
                                </span>
                            </div>
                        </h1>
                    </div>

                    <!-- Alert Messages -->
                    <div class="alert alert-danger" role="alert" invisible="not allergies">
                        <strong><i class="fa fa-exclamation-triangle"/> ALLERGIES:</strong>
                        <field name="allergies" readonly="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="patient_status != 'new'">
                        <strong><i class="fa fa-info-circle"/> NEW CLIENT:</strong>
                        Please complete all required information and verify insurance details.
                    </div>

                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="id-card"/>
                            <div>
                                <span>Profile Overview</span>
                                <small class="text-muted d-block">Identity, contact and onboarding source</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="id-card"/>
                                    <span>Personal Information</span>
                                </div>
                                <group col="2">
                                    <field name="title"/>
                                    <field name="first_name"/>
                                    <field name="last_name"/>
                                    <field name="middle_name"/>
                                    <field name="vietnamese_name" placeholder="Tên tiếng Việt"/>
                                    <field name="birth_date"/>
                                    <field name="deceased"/>
                                    <field name="gender"/>
                                </group>
                            </div>

                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="users-group"/>
                                    <span>Other Information</span>
                                </div>
                                <group col="2">
                                    <field name="phone" widget="phone" required="1"/>
                                    <field name="mobile" widget="phone" invisible="1"/>
                                    <field name="email" widget="email"/>
                                    <field name="patient_category_id"/>
                                    <field name="primary_facility_id" required="1"/>
                                    <field name="source_type"/>
                                    <field name="national_id"/>
                                    <field name="profession" string="Occupation"/>
                                    <field name="ethnicity"/>
                                </group>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <!-- Address Information Page -->
                        <page string="Address Information" name="address_info">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="map-pin"/>
                                    <div>
                                        <span>Address Information</span>
                                        <small class="text-muted d-block">Full Vietnamese address plus geo location</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="file-text"/>
                                            <span>Address Details</span>
                                        </div>
                                        <group col="2">
                                            <label for="vietnamese_address" string="Full Vietnamese Address"/>
                                            <div class="o_row align-items-start">
                                                <field name="vietnamese_address" nolabel="1" readonly="1" widget="text" class="flex-grow-1"/>
                                                <button name="action_edit_vietnamese_address"
                                                        type="object"
                                                        class="btn btn-link p-0 fa fa-pencil text-muted"
                                                        title="Edit address"/>
                                            </div>

                                            <!-- Hidden fields for geocoding -->
                                            <field name="address_search" invisible="1"/>
                                            <field name="partner_latitude" invisible="1"/>
                                            <field name="partner_longitude" invisible="1"/>
                                            <field name="date_localization" invisible="1"/>
                                        </group>
                                        <div class="mt-2">
                                            <button name="action_geocode_address_photon"
                                                    type="object"
                                                    class="btn btn-secondary btn-sm"
                                                    icon="fa-map-marker"
                                                    string="Geocode Address"/>
                                        </div>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="map-pin"/>
                                            <span>Map Location</span>
                                        </div>
                                        <field name="geo_coordinates_display" widget="address_map" nolabel="1"/>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <!-- Intake Notes -->
                        <page string="Intake Notes" name="intake_notes">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="clipboard-list"/>
                                    <div>
                                        <span>Intake Notes</span>
                                        <small class="text-muted d-block">Assessment snapshots and initial planning</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="file-text"/>
                                            <span>Assessment Information</span>
                                        </div>
                                        <group col="1">
                                            <field name="intake_diagnosis" placeholder="Medical diagnosis and assessment findings" nolabel="1"/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="heart-pulse"/>
                                            <span>Care Planning</span>
                                        </div>
                                        <group col="2">
                                            <field name="intake_referring_doctor_id" placeholder="Select referring doctor or contact" options="{'no_create': True}"/>
                                            <field name="intake_goal_of_care" placeholder="Primary goal or objective of care"/>
                                            <field name="intake_required_equipment" placeholder="Equipment or supplies required for care"/>
                                        </group>
                                    </div>
                                </div>
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="file-text"/>
                                        <span>Additional Notes</span>
                                    </div>
                                    <group>
                                    <field name="intake_notes" placeholder="Additional intake assessment notes and observations" nolabel="1"/>
                                    </group>
                                </div>
                            </div>
                        </page>

                        <!-- Insurance &amp; Billing -->
                        <page string="Insurance &amp; Billing" name="insurance_billing">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="credit-card"/>
                                    <div>
                                        <span>Insurance &amp; Billing</span>
                                        <small class="text-muted d-block">Coverage, payment preferences and reminders</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="shield-check"/>
                                            <span>Insurance Details</span>
                                        </div>
                                        <group col="2">
                                            <field name="insurance_provider"/>
                                            <field name="insurance_number"/>
                                            <field name="insurance_expiry"/>
                                        </group>
                                        <div class="alert alert-warning" invisible="not insurance_expiry or insurance_expiry &gt; context_today()" role="alert">
                                            <i class="fa fa-exclamation-triangle"/> Insurance has expired - please update
                                        </div>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="credit-card"/>
                                            <span>Payment Preferences</span>
                                        </div>
                                        <group col="1">
                                            <field name="payment_method" required="1"/>
                                        </group>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <!-- Service History -->
                        <page string="Service History" name="service_history">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="history"/>
                                    <div>
                                        <span>Service History</span>
                                        <small class="text-muted d-block">Field service visits and care interactions</small>
                                    </div>
                                </div>
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="history"/>
                                        <span>History Timeline</span>
                                    </div>
                                    <p>
                                        Service history entries will be displayed here once the <strong>health_fieldservice</strong> module injects the timeline widget.
                                    </p>
                                </div>
                            </div>
                        </page>

                        <!-- Active Service Packages -->
                        <page string="Active Packages" name="active_packages">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="package"/>
                                    <div>
                                        <span>Active Packages</span>
                                        <small class="text-muted d-block">Bundles and prepaid services currently assigned</small>
                                    </div>
                                </div>
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="package"/>
                                        <span>Package Summary</span>
                                    </div>
                                    <p>
                                        Package information will be injected by the <strong>health_invoicing</strong> module.
                                    </p>
                                </div>
                            </div>
                        </page>

                        <!-- Healthcare Relationships -->
                        <page string="Healthcare Relationships" name="healthcare_relationships">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="users-group"/>
                                    <div>
                                        <span>Healthcare Relationships</span>
                                        <small class="text-muted d-block">Visual hierarchy of clients and stakeholders</small>
                                    </div>
                                </div>
                                <div class="alert alert-info" role="alert">
                                    Relationship map widget is not available in this Odoo version.
                                </div>
                            </div>
                        </page>

                        <!-- Patient Journey &amp; Analytics -->
                        <page string="Client Journey" name="patient_journey">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="timeline"/>
                                    <div>
                                        <span>Client Journey</span>
                                        <small class="text-muted d-block">Registration milestones and visit cadence</small>
                                    </div>
                                </div>
                                <div class="vu-section-grid">
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="file-text"/>
                                            <span>Registration Details</span>
                                        </div>
                                        <group col="2">
                                            <field name="source_details" placeholder="Specific source details"/>
                                            <field name="referral_source" invisible="source_type != 'referral'"/>
                                            <field name="registration_date" readonly="1"/>
                                        </group>
                                    </div>
                                    <div class="vu-card">
                                        <div class="vu-card__title">
                                            <span class="vu-section__icon" data-icon="timeline"/>
                                            <span>Visit Tracking</span>
                                        </div>
                                        <group col="2">
                                            <field name="last_visit_date" readonly="1"/>
                                            <field name="next_visit_date"/>
                                            <field name="visit_count" readonly="1"/>
                                        </group>
                                    </div>
                                </div>
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="timeline"/>
                                        <span>Client Timeline</span>
                                    </div>
                                    <div class="alert alert-info">
                                        <i class="fa fa-timeline"/> Client timeline with appointments, treatments, and key events will be displayed here.
                                    </div>
                                </div>
                            </div>
                        </page>

                        <!-- Clinical Notes &amp; Communications -->
                        <page string="Clinical Notes" name="clinical_notes">
                            <div class="vu-section">
                                <div class="vu-section__title">
                                    <span class="vu-section__icon" data-icon="file-text"/>
                                    <div>
                                        <span>Clinical Notes &amp; Communications</span>
                                        <small class="text-muted d-block">Care coordination and documentation coming soon</small>
                                    </div>
                                </div>
                                <div class="vu-card">
                                    <div class="vu-card__title">
                                        <span class="vu-section__icon" data-icon="file-text"/>
                                        <span>Clinical Documentation</span>
                                    </div>
                                    <div class="alert alert-secondary">
                                        <i class="fa fa-stethoscope"/> Clinical documentation system integration coming soon.
                                    </div>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>

                <!-- Proper Odoo 19 Chatter Implementation -->
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- Modern Patient List View -->
    <record id="view_health_patient_tree" model="ir.ui.view">
        <field name="name">res.partner.patient.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Client Registry" decoration-warning="patient_status=='new'"
                  decoration-danger="patient_status=='deceased'" decoration-muted="patient_status=='inactive'"
                  decoration-success="patient_category_id and 'VIP' in patient_category_id.name"
                  create="true" edit="true" delete="true" sample="1">

                <field name="patient_code"/>
                <field name="name"/>
                <field name="age_display"/>
                <field name="gender"/>
                <field name="phone" widget="phone"/>
                <field name="patient_category_id"/>
                <field name="patient_status"/>
                <field name="source_type"/>
                <field name="last_visit_date"/>
                <field name="next_visit_date"/>
                <field name="visit_count"/>

                <!-- Quick Actions -->
                <button name="action_create_appointment" type="object" icon="fa-calendar-plus-o"
                        title="Schedule New Appointment"/>
                <button name="action_view_appointments" type="object" icon="fa-calendar"
                        title="View Appointment History"/>
            </list>
        </field>
    </record>

    <!-- Professional Patient Kanban View for patient-->
    <record id="view_health_patient_kanban" model="ir.ui.view">
        <field name="name">res.partner.patient.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban default_group_by="patient_category_id" class="o_patient_kanban" create="true" quick_create="false" sample="1"
                    group_create="false" group_edit="false" group_delete="false">
                <field name="id"/>
                <field name="name"/>
                <field name="patient_code"/>
                <field name="age_display"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="patient_status"/>
                <field name="patient_category_id"/>
                <field name="last_visit_date"/>
                <field name="next_visit_date"/>
                <field name="source_type"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="o_patient_card">
                            <div class="o_patient_card_header">
                                <div class="o_patient_identity">
                                    <div class="o_patient_avatar">
                                        <i class="fa fa-user"/>
                                    </div>
                                    <div class="o_patient_identity_text">
                                        <strong><field name="name"/></strong>
                                    </div>
                                </div>
                                <span class="badge badge-pill" t-att-class="record.patient_status.raw_value === 'new' ? 'badge-warning' : (record.patient_status.raw_value === 'active' ? 'badge-success' : 'badge-secondary')">
                                    <field name="patient_status"/>
                                </span>
                            </div>

                                <div class="o_patient_card_info">
                                    <div class="o_patient_code"><i class="fa fa-id-card-o"/> <field name="patient_code"/></div>
                                    <div><i class="fa fa-venus-mars"/> <field name="age_display"/> • <field name="gender"/></div>
                                    <div><i class="fa fa-phone"/> <field name="phone"/></div>
                                </div>

                            <div class="o_patient_card_footer">
                                <button name="action_create_appointment" type="object" class="btn btn-primary btn-sm">
                                    <i class="fa fa-calendar-plus-o"/> Schedule
                                </button>
                                <button name="action_view_appointments" type="object" class="btn btn-outline-secondary btn-sm">
                                    <i class="fa fa-history"/> History
                                </button>
                            </div>
                        </div>
                    </t>

                    <!-- Kanban Empty State Template -->
                    <t t-name="kanban-menu">
                        <a role="menuitem" type="object" name="action_create_patient" class="dropdown-item">New Client</a>
                    </t>

                    <!-- OWL kanban compatibility -->
                    <t t-name="card">
                        <t t-call="kanban-box"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Enhanced Patient Search View -->
    <record id="view_health_patient_search" model="ir.ui.view">
        <field name="name">res.partner.patient.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Client Search">
                <field name="name" string="Client Name"/>
                <field name="patient_code" string="Client ID"/>
                <field name="phone" string="Phone"/>
                <field name="national_id" string="National ID"/>
                <field name="email"/>
                <field name="state_id" string="Province"/>

                <separator/>

                <!-- Status Filters -->
                <filter name="active_patients" string="Active" domain="[('patient_status', '=', 'active')]"/>
                <filter name="new_patients" string="New" domain="[('patient_status', '=', 'new')]"/>
                <filter name="inactive_patients" string="Inactive" domain="[('patient_status', '=', 'inactive')]"/>

                <separator/>

                <!-- Category Filters -->
                <filter name="vip_patients" string="VIP" domain="[('patient_category_id.name', 'ilike', 'VIP')]"/>
                <filter name="emergency_patients" string="Emergency" domain="[('patient_category_id.name', 'ilike', 'Emergency')]"/>

                <separator/>

                <!-- Visit Filters -->
                <filter name="upcoming_visits" string="Upcoming Visits"
                        domain="[('next_visit_date', '&gt;=', context_today())]"/>
                <filter name="recent_visits" string="Recent Visits"
                        domain="[('last_visit_date', '&gt;=', context_today())]"/>
            </search>
        </field>
    </record>

    <!-- Main Patient Action -->
    <record id="action_health_patient" model="ir.actions.act_window">
        <field name="name">Client Registry</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_health_patient_search"/>
        <field name="domain">[('is_patient', '=', True)]</field>
        <field name="context">{
            'search_default_active_patients': 1,
            'default_is_patient': True,
            'default_customer_rank': 1,
            'default_country_id': 241,
            'default_patient_status': 'new',
            'create': True,
            'edit': True,
            'delete': True
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Welcome to VAFHS Client Management!
            </p>
            <p>
                Create your first client record to begin managing healthcare services.<br/>
                Click the <strong>New</strong> button above to register your first client.
            </p>
            <p>
                The system tracks client demographics, medical history, appointments, and billing.
            </p>
        </field>
    </record>

    <!-- Patient Action View References - Ensure our custom views are used -->
    <record id="action_health_patient_view_tree" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_health_patient_tree"/>
        <field name="act_window_id" ref="action_health_patient"/>
    </record>

    <record id="action_health_patient_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_health_patient_kanban"/>
        <field name="act_window_id" ref="action_health_patient"/>
    </record>

    <record id="action_health_patient_view_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_health_patient_form"/>
        <field name="act_window_id" ref="action_health_patient"/>
    </record>

    <record id="view_health_patient_address_form" model="ir.ui.view">
        <field name="name">res.partner.address.modal</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Edit Address">
                <sheet>
                    <group col="2">
                        <field name="province_code"/>
                        <field name="house_number"/>
                        <field name="sub_alley_number"/>
                        <field name="alley_number"/>
                        <field name="ward_commune"/>
                        <field name="named_area"/>
                        <field name="apartment_number"/>
                        <field name="building_name"/>
                        <field name="zip" string="Postal Code"/>
                        <field name="street" placeholder="Street name / Main road"/>
                        <field name="city" placeholder="District / City" required="1"/>
                        <field name="state_id" string="Province" placeholder="Select province" options="{'no_create': True}" required="1"/>
                        <field name="country_id" string="Country" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" class="btn-primary" special="save"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Patient Category Management -->
    <record id="view_health_patient_category_tree" model="ir.ui.view">
        <field name="name">health.patient.category.list</field>
        <field name="model">health.patient.category</field>
        <field name="arch" type="xml">
            <list string="Client Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="price_multiplier"/>
                <field name="color" widget="color"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_health_patient_category_form" model="ir.ui.view">
        <field name="name">health.patient.category.form</field>
        <field name="model">health.patient.category</field>
        <field name="arch" type="xml">
            <form string="Client Category">
                <sheet>
                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="tag"/>
                            <div>
