<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Public Holiday List View -->
    <record id="view_healthcare_public_holiday_list" model="ir.ui.view">
        <field name="name">healthcare.public.holiday.list</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="arch" type="xml">
            <list string="Public Holidays"
                  decoration-warning="holiday_type_code == 'tet'"
                  decoration-info="holiday_type_code == 'national'"
                  decoration-muted="not is_pricing_holiday">
                <field name="holiday_type_code" column_invisible="True" invisible="1"/>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="holiday_type_id"/>
                <field name="price_multiplier" string="Price × "/>
                <field name="province_id"/>
                <field name="is_pricing_holiday" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Public Holiday Form View -->
    <record id="view_healthcare_public_holiday_form" model="ir.ui.view">
        <field name="name">healthcare.public.holiday.form</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="arch" type="xml">
            <form string="Public Holiday">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Holiday Name (e.g., TET Nguyen Dan 2025)"/>
                        </h1>
                    </div>

                    <div class="vu-section">
                        <div class="vu-section__title">
                            <span class="vu-section__icon" data-icon="calendar"/>
                            <div>
                                <span>Holiday Configuration</span>
                                <small class="text-muted d-block">Dates, multiplier and scope</small>
                            </div>
                        </div>
                        <div class="vu-section-grid">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="calendar"/>
                                    <span>Holiday Dates</span>
                                </div>
                                <group col="2">
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="resource_id" invisible="1"/>
                                    <field name="calendar_id" invisible="1"/>
                                </group>
                            </div>
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="credit-card"/>
                                    <span>Pricing Configuration</span>
                                </div>
                                <group col="2">
                                    <field name="holiday_type_id"/>
                                    <field name="price_multiplier" widget="monetary"/>
                                    <field name="is_pricing_holiday"/>
                                    <field name="province_id" placeholder="Leave blank for national holidays"/>
                                </group>
                            </div>
                        </div>

                        <div class="vu-card">
                            <div class="vu-card__title">
                                <span class="vu-section__icon" data-icon="users-group"/>
                                <span>Scope</span>
                            </div>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </div>
                    </div>

                    <notebook>
                        <page string="Pricing Examples" name="pricing_examples">
                            <div class="vu-card">
                                <div class="vu-card__title">
                                    <span class="vu-section__icon" data-icon="credit-card"/>
                                    <span>Pricing Examples</span>
                                </div>
                                <group>
                                    <field name="price_multiplier" invisible="1"/>
                                    <div class="alert alert-info" role="alert">
                                        <h4>Pricing Examples for <field name="name" readonly="1" nolabel="1"/> (<field name="price_multiplier" readonly="1" nolabel="1"/>x multiplier):</h4>
                                        <ul>
                                            <li>Base Price: 100,000 VND → Holiday Price: <strong><field name="price_multiplier" readonly="1" nolabel="1"/> × 100,000 = <field name="price_multiplier" readonly="1" widget="float" nolabel="1"/> VND</strong></li>
                                            <li>Home Visit: 500,000 VND → Holiday Price: <strong>1,500,000 VND</strong> (if multiplier = 3.0)</li>
                                            <li>Consultation: 200,000 VND → Holiday Price: <strong>600,000 VND</strong> (if multiplier = 3.0)</li>
                                        </ul>
                                    </div>
                                </group>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Public Holiday Search View -->
    <record id="view_healthcare_public_holiday_search" model="ir.ui.view">
        <field name="name">healthcare.public.holiday.search</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="arch" type="xml">
            <search string="Public Holidays">
                <field name="name"/>
                <field name="holiday_type_id"/>
                <field name="province_id"/>
            </search>
        </field>
    </record>

    <!-- Window Action for Public Holidays -->
    <record id="action_healthcare_public_holidays" model="ir.actions.act_window">
        <field name="name">Public Holidays</field>
        <field name="res_model">resource.calendar.leaves</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('resource_id', '=', False), ('calendar_id', '=', False)]</field>
        <field name="context">{'default_resource_id': False, 'default_calendar_id': False, 'default_is_pricing_holiday': True, 'search_default_pricing_holidays': 1, 'search_default_upcoming': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
                                      (0, 0, {'view_mode': 'list', 'view_id': ref('view_healthcare_public_holiday_list')}),
                                      (0, 0, {'view_mode': 'form', 'view_id': ref('view_healthcare_public_holiday_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No public holidays defined yet!
            </p>
            <p>
                Create public holidays with pricing multipliers for TET, National holidays, etc.
            </p>
        </field>
    </record>

</odoo>
