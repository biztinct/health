<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend User Form to add Healthcare Fields -->
    <record id="view_users_form_healthcare" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.healthcare</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- Add facility_id after the title section -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <group string="Healthcare Settings">
                        <field name="is_healthcare_staff"/>
                        <field name="healthcare_role" invisible="not is_healthcare_staff"/>
                        <field name="facility_id" options="{'no_create': True}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
