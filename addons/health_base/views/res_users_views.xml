<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend User Form to add Healthcare Fields -->
    <record id="view_users_form_healthcare" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.healthcare</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- Add catchment_province_id after the title section -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <!-- The job and the two qualifiers that depend on it are added
                     here by `health_access` (view inherit). They name fields
                     that module puts on `res.users`, and a view in THIS module
                     naming them would refuse to load on a database that does
                     not have it — this module is the root of the tree. -->
                <group name="healthcare_settings_wrap">
                    <group string="Healthcare Settings" name="healthcare_settings">
                        <field name="is_healthcare_staff"/>
                        <field name="catchment_province_id" options="{'no_create': True}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
