<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Audit Log List View -->
    <record id="view_health_audit_log_list" model="ir.ui.view">
        <field name="name">health.audit.log.view.list</field>
        <field name="model">health.audit.log.view</field>
        <field name="arch" type="xml">
            <list string="Audit Log" 
                  create="false" edit="false" delete="false"
                  default_order="date desc"
                  decoration-success="new_value in ['Completed', 'Confirmed', 'Won', 'Assigned', 'Done']"
                  decoration-danger="new_value in ['Cancelled', 'Lost', 'Rejected', 'Expired']">
                
                <field name="date" string="When" widget="datetime"/>
                <field name="user_id" string="Changed By" widget="many2one_avatar_user"/>
                <field name="model_name" string="Module"/>
                <field name="record_name" string="Record"/>
                <field name="field_name" string="Field Changed"/>
                <field name="old_value" string="From" optional="show"/>
                <field name="new_value" string="To"/>
                
            </list>
        </field>
    </record>

    <!-- Audit Log Search View - Simplified -->
    <record id="view_health_audit_log_search" model="ir.ui.view">
        <field name="name">health.audit.log.view.search</field>
        <field name="model">health.audit.log.view</field>
        <field name="arch" type="xml">
            <search string="Search Audit Log">
                <field name="model_name"/>
                <field name="record_name"/>
                <field name="field_name"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_health_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">health.audit.log.view</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_health_audit_log_list"/>
        <field name="search_view_id" ref="view_health_audit_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No changes recorded yet
            </p>
        </field>
    </record>

</odoo>
