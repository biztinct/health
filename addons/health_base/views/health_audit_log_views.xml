<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Audit Log List View -->
    <record id="view_health_audit_log_list" model="ir.ui.view">
        <field name="name">health.audit.log.view.list</field>
        <field name="model">health.audit.log.view</field>
        <field name="arch" type="xml">
            <list string="Audit Log"
                  create="false" edit="false" delete="false"
                  decoration-primary="model in ['advanced.pricing.engine', 'advanced.pricing.rule', 'product.pricelist']"
                  decoration-info="model == 'res.partner'"
                  decoration-warning="model == 'account.move'"
                  decoration-success="model == 'health.fieldservice.order'">
                <field name="model" column_invisible="1"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="record_name"/>
                <field name="field_name"/>
                <field name="old_value"/>
                <field name="new_value"/>
            </list>
        </field>
    </record>

    <!-- Audit Log Search/Filter View -->
    <record id="view_health_audit_log_search" model="ir.ui.view">
        <field name="name">health.audit.log.view.search</field>
        <field name="model">health.audit.log.view</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="record_name"/>
                <field name="field_name"/>
                <field name="date"/>

                <separator/>
                <!-- Date filters -->
                <filter name="filter_today" string="Today"
                        domain="[('date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                 ('date', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter name="filter_last_7_days" string="Last 7 Days"
                        domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="filter_last_30_days" string="Last 30 Days"
                        domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="filter_this_month" string="This Month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01 00:00:00'))]"/>
                <filter name="filter_last_month" string="Last Month"
                        domain="[('date', '&gt;=', (context_today().replace(day=1) - datetime.timedelta(days=1)).strftime('%Y-%m-01 00:00:00')),
                                 ('date', '&lt;', context_today().strftime('%Y-%m-01 00:00:00'))]"/>

                <separator/>
                <!-- Quick filters by model type -->
                <filter name="pricing_changes" string="Pricing Changes"
                        domain="[('model', 'in', ['advanced.pricing.engine', 'advanced.pricing.rule', 'product.pricelist'])]"/>
                <filter name="invoice_changes" string="Invoice Changes"
                        domain="[('model', '=', 'account.move')]"/>
                <filter name="patient_changes" string='Client Data Changes'
                        domain="[('model', '=', 'res.partner')]"/>
                <filter name="fso_changes" string="Service Order Changes"
                        domain="[('model', '=', 'health.fieldservice.order')]"/>
                <filter name="holiday_changes" string="Holiday Changes"
                        domain="[('model', '=', 'resource.calendar.leaves')]"/>

                <separator/>
                <!-- Group by options -->
                <group expand="0" string="Group By">
                    <filter name="group_model" string="Model" context="{'group_by': 'model_name'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_field" string="Field" context="{'group_by': 'field_name'}"/>
                    <separator/>
                    <filter name="group_date_day" string="Date (Day)" context="{'group_by': 'date:day'}"/>
                    <filter name="group_date_week" string="Date (Week)" context="{'group_by': 'date:week'}"/>
                    <filter name="group_date_month" string="Date (Month)" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_health_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">health.audit.log.view</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_health_audit_log_list"/>
        <field name="context">{
            'search_default_group_model': 1,
            'search_default_group_user': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No audit logs found
            </p>
            <p>
                The audit log tracks all changes to critical healthcare data including pricing rules,
                patient records, invoices, and service orders.
            </p>
        </field>
    </record>

    <!-- Audit Log menu moved to top-level in health_menus.xml -->

</odoo>
