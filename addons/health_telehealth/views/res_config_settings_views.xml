<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_telehealth" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.telehealth</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="health_base.res_config_settings_view_form_health"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='health_base']" position="inside">
                <block title="Telehealth (Video Visits)" name="health_telehealth_settings">
                    <setting id="th_enabled_setting" string="Enable telehealth sessions"
                             help="When on, confirming an online (telemedicine) booking creates a video session and sends the join link (the send still rides the messaging enabled/dry-run switches).">
                        <field name="th_enabled"/>
                    </setting>
                    <setting id="th_video_base_setting" string="Video base URL"
                             help="Room URL = this base + a unique room slug. Default meet.jit.si. Self-host Jitsi with signed JWT room tokens as the v2 upgrade path.">
                        <field name="th_video_base_url"/>
                    </setting>
                    <setting id="th_template_setting" string="Telehealth join ZNS template"
                             help="Zalo ZNS template ID for the join link. Rides the messaging enabled/dry-run switches. Empty = ZNS step skipped (session still created).">
                        <field name="th_zns_template_join"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
