<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Standalone, self-contained mobile waiting-room pages (no website/
         backend assets). Flat mono colors, no gradients, inlined currentColor
         SVG icons, no emoji. vi-first with an en gloss. Renders on a phone.
         Cloned from health_family_link/views/family_templates.xml. -->
    <template id="tele_styles" name="Telehealth Styles">
        <style>
            * { box-sizing: border-box; }
            body { margin: 0; font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
                   background: #f4f5f7; color: #1f2733; -webkit-text-size-adjust: 100%; }
            .tl-wrap { max-width: 480px; margin: 0 auto; padding: 24px 18px 48px; }
            .tl-card { background: #ffffff; border: 1px solid #e3e6ea; border-radius: 14px;
                       padding: 22px 20px; }
            .tl-brand { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; color: #0b6b5a; }
            .tl-brand svg { width: 26px; height: 26px; }
            .tl-brand span { font-weight: 700; font-size: 17px; letter-spacing: .2px; }
            .tl-h1 { font-size: 20px; font-weight: 700; margin: 6px 0 4px; }
            .tl-sub { color: #5b6572; font-size: 14px; margin: 0 0 18px; line-height: 1.5; }
            .tl-row { display: flex; align-items: center; gap: 12px; padding: 12px 0;
                      border-top: 1px solid #eef0f2; font-size: 16px; }
            .tl-row:first-of-type { border-top: none; }
            .tl-row svg { width: 20px; height: 20px; flex: 0 0 auto; color: #0b6b5a; }
            .tl-row .tl-label { display: block; font-size: 12px; font-weight: 500; color: #8a94a1; }
            .tl-row .tl-val { font-weight: 600; }
            .tl-status { display: inline-block; padding: 5px 12px; border-radius: 999px;
                         font-size: 13px; font-weight: 700; margin-bottom: 14px; }
            .tl-status.pending { background: #e6f4f1; color: #0b6b5a; }
            .tl-status.open { background: #eaf1fb; color: #1b4f9c; }
            .tl-status.closed { background: #eef0f2; color: #5b6572; }
            .tl-join { display: flex; align-items: center; justify-content: center; gap: 10px;
                       width: 100%; margin: 18px 0 8px; padding: 18px 20px; border: none;
                       border-radius: 12px; background: #1565c0; color: #ffffff;
                       font-size: 18px; font-weight: 700; text-decoration: none; }
            .tl-join svg { width: 24px; height: 24px; }
            .tl-note { font-size: 13px; color: #8a94a1; margin-top: 16px; text-align: center; }
        </style>
    </template>

    <!-- Shared brand header -->
    <template id="tele_brand" name="Telehealth Brand">
        <div class="tl-brand">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21s-7-4.35-9.5-8.5A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6.5C19 16.65 12 21 12 21z"/>
            </svg>
            <span>Viet Uc Health</span>
        </div>
    </template>

    <!-- Neutral page: invalid / expired / cancelled -->
    <template id="tele_neutral" name="Telehealth Unavailable">
        <t t-name="health_telehealth.tele_neutral">
            <html lang="vi">
                <head>
                    <meta charset="utf-8"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1"/>
                    <title>Khám trực tuyến</title>
                    <t t-call="health_telehealth.tele_styles"/>
                </head>
                <body>
                    <div class="tl-wrap">
                        <div class="tl-card">
                            <t t-call="health_telehealth.tele_brand"/>
                            <div class="tl-h1">Không có thông tin để hiển thị</div>
                            <p class="tl-sub">Liên kết này không còn hiệu lực hoặc chưa có thông tin.
                               Vui lòng liên hệ với chúng tôi nếu cần hỗ trợ.
                               <br/>(This link is no longer available. Please contact us if you need help.)</p>
                            <p class="tl-note">Viet Uc Health</p>
                        </div>
                    </div>
                </body>
            </html>
        </t>
    </template>

    <!-- Live page: pending / open / closed -->
    <template id="tele_page" name="Telehealth Waiting Room">
        <t t-name="health_telehealth.tele_page">
            <html lang="vi">
                <head>
                    <meta charset="utf-8"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1"/>
                    <title>Khám trực tuyến</title>
                    <!-- Pending auto-flips to the Join state when the doctor starts;
                         open re-checks so a completed visit stops offering the room. -->
                    <t t-if="mode == 'pending' or mode == 'open'">
                        <meta http-equiv="refresh" content="60"/>
                    </t>
                    <t t-call="health_telehealth.tele_styles"/>
                </head>
                <body>
                    <div class="tl-wrap">
                        <div class="tl-card">
                            <t t-call="health_telehealth.tele_brand"/>

                            <!-- Pending: date + time window, no room URL -->
                            <t t-if="mode == 'pending'">
                                <span class="tl-status pending">Sắp diễn ra (Upcoming)</span>
                                <div class="tl-h1">Khám trực tuyến cho <t t-esc="patient_name"/></div>
                                <p class="tl-sub">Video sẽ mở khi bác sĩ bắt đầu.
                                   (The video opens when the doctor starts.)</p>
                                <div class="tl-row" t-if="visit_date">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="4" width="18" height="18" rx="2"/>
                                        <path d="M16 2v4M8 2v4M3 10h18"/>
                                    </svg>
                                    <span><span class="tl-label">Ngày (Date)</span>
                                          <span class="tl-val"><t t-esc="visit_date"/></span></span>
                                </div>
                                <div class="tl-row" t-if="time_window">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
                                    </svg>
                                    <span><span class="tl-label">Khung giờ (Time)</span>
                                          <span class="tl-val"><t t-esc="time_window"/></span></span>
                                </div>
                                <div class="tl-row" t-if="staff_name">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                    <span><span class="tl-label">Bác sĩ (Doctor)</span>
                                          <span class="tl-val"><t t-esc="staff_name"/></span></span>
                                </div>
                                <p class="tl-note" t-if="facility_phone">
                                    Cần hỗ trợ? Gọi <t t-esc="facility_phone"/>.
                                    (Need help? Call <t t-esc="facility_phone"/>.)</p>
                            </t>

                            <!-- Open: the Join button — the ONLY state with the room URL -->
                            <t t-if="mode == 'open'">
                                <span class="tl-status open">Đang diễn ra (Live)</span>
                                <div class="tl-h1">Buổi khám đã bắt đầu</div>
                                <p class="tl-sub">Nhấn để vào phòng khám trực tuyến.
                                   (Tap to join the video visit.)</p>
                                <a class="tl-join" t-att-href="room_url" target="_blank" rel="noopener">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M23 7l-7 5 7 5V7z"/>
                                        <rect x="1" y="5" width="15" height="14" rx="2"/>
                                    </svg>
                                    <span>Vào phòng khám (Join)</span>
                                </a>
                                <p class="tl-note" t-if="facility_phone">
                                    Gặp sự cố? Gọi <t t-esc="facility_phone"/>.
                                    (Having trouble? Call <t t-esc="facility_phone"/>.)</p>
                            </t>

                            <!-- Closed: thank-you, no summary, no room URL -->
                            <t t-if="mode == 'closed'">
                                <span class="tl-status closed">Đã kết thúc (Ended)</span>
                                <div class="tl-h1">Buổi khám đã kết thúc</div>
                                <p class="tl-sub">Cảm ơn bạn đã sử dụng dịch vụ khám trực tuyến.
                                   (Thank you — your video visit has ended.)</p>
                                <p class="tl-note" t-if="facility_phone">
                                    Cần hỗ trợ thêm? Gọi <t t-esc="facility_phone"/>.
                                    (Need anything else? Call <t t-esc="facility_phone"/>.)</p>
                            </t>

                            <p class="tl-note">Viet Uc Health</p>
                        </div>
                    </div>
                </body>
            </html>
        </t>
    </template>

</odoo>
