<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Transcription sweep — every 30 minutes (same-day cadence, §2.4).
             Inert without a configured STT endpoint. -->
        <record id="cron_scribe_transcribe" model="ir.cron">
            <field name="name">Scribe: transcribe pending recordings</field>
            <field name="model_id" ref="model_health_scribe_job"/>
            <field name="state">code</field>
            <field name="code">model.cron_scribe_transcribe()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
