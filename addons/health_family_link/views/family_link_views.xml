<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_family_link_list" model="ir.ui.view">
        <field name="name">health.family.link.list</field>
        <field name="model">health.family.link</field>
        <field name="arch" type="xml">
            <list string="Family Visit Links" create="false">
                <field name="create_date"/>
                <field name="fso_id"/>
                <field name="partner_id"/>
                <field name="relation_id" optional="hide"/>
                <field name="state"/>
                <field name="expires_at"/>
                <field name="visit_link_message_id" optional="hide"/>
                <field name="snapshot_message_id" optional="hide"/>
                <field name="catchment_province_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_family_link_form" model="ir.ui.view">
        <field name="name">health.family.link.form</field>
        <field name="model">health.family.link</field>
        <field name="arch" type="xml">
            <form string="Family Visit Link" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="fso_id"/>
                            <field name="partner_id"/>
                            <field name="relation_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="expires_at"/>
                            <field name="visit_link_message_id"/>
                            <field name="snapshot_message_id"/>
                            <field name="catchment_province_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_family_link_search" model="ir.ui.view">
        <field name="name">health.family.link.search</field>
        <field name="model">health.family.link</field>
        <field name="arch" type="xml">
            <search string="Search Family Links">
                <field name="fso_id"/>
                <field name="partner_id"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="revoked" string="Revoked" domain="[('state', '=', 'revoked')]"/>
                <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_by_catchment" string="Catchment Area"
                        context="{'group_by': 'catchment_province_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_family_link" model="ir.actions.act_window">
        <field name="name">Family Visit Links</field>
        <field name="res_model">health.family.link</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_family_link_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No family visit links yet.
            </p>
            <p>
                Links are created automatically when a booking is confirmed for a
                client whose relation is opted in to visit updates.
            </p>
        </field>
    </record>

    <menuitem id="menu_family_link"
              name="Family Visit Links"
              parent="health_base.menu_healthcare_root"
              action="action_family_link"
              groups="health_base.group_healthcare_head_nurse,health_base.group_healthcare_operations_manager,health_base.group_healthcare_manager,health_base.group_healthcare_admin,health_base.group_healthcare_owner"
              sequence="30"/>

</odoo>
