<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">

    <!-- Control C5 (register item G4) — weekly conformance self-check.
         Deliberately a SEPARATE file from data/fhir_data.xml: that file is a
         noupdate="1" configuration seed whose values are owned by the
         deployment (health_fhir_core.consent_enforced was flipped in the
         database by GC-2), and re-writing it is how a seed cutover gets
         silently reverted. -->
    <record id="ir_cron_fhir_conformance_weekly" model="ir.cron"
            forcecreate="True">
        <field name="name">FHIR: weekly conformance check</field>
        <field name="model_id" ref="model_fhir_conformance"/>
        <field name="state">code</field>
        <field name="code">model.run_weekly_check()</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <!-- Sunday-night-ish: far from the deploy window, so a failure is
             read as drift rather than as a release still settling. -->
        <field name="nextcall"
               eval="(DateTime.now() + timedelta(days=7)).strftime('%Y-%m-%d 03:00:00')"/>
    </record>

</data></odoo>
