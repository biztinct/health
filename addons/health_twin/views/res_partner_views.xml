<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Health client form: "Trends" tab hosting the ECharts vitals/NEWS2
         trend charts (twin-phase2). The widget reads its data under the
         calling user's env (record-rule gated). -->
    <record id="view_health_patient_form_twin_trends" model="ir.ui.view">
        <field name="name">res.partner.health.patient.form.twin.trends</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="health_base.view_health_patient_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Trends" name="twin_trends"
                      groups="health_base.group_healthcare_nurse">
                    <widget name="twin_trend_charts"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
