<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- =====================================================================
         Table A of docs/strategy/cms-sidebar-menu-coverage.html, restricted to
         the four business sections: CRM, OPERATIONS MANAGER, CLINICAL, FINANCE.
         ADMIN, the proposed ANALYTICS section, the optional configuration
         screens and the already-reachable duplicates are NOT touched, and no
         existing sidebar item or backend menuitem is modified or removed.

         Conventions, each cloned from the siblings in
         health_cms_sidebar/data/ and health_cms_clinical/data/:
           * ROOT leaves only — no parent_id. An item with children turns into a
             non-navigating expander and would break the parent (§5.69a).
           * match_action_xmlids only, NEVER match_models: the model index is
             last-wins and a satellite leaf would hijack an existing leaf's
             highlight (§5.94). This is a deliberate divergence from
             health_cms_clinical, which predates that finding.
           * no role_ids, like the siblings — the action/model ACL is the real
             gate, and drawing a leaf a user cannot open is better than hiding
             a feature from everyone.
           * `icon` is rendered as <i t-att-class="item.icon"/>, so it must be a
             font-awesome class here; the repo's hf-wt-ico SVG masks have no
             render path in this template.
           * sequences continue after the highest existing one in each section,
             so nothing reorders.
         ===================================================================== -->

    <!-- =================================================================
         CRM  (existing sequences 10-50 → new 60+)
         ================================================================= -->

    <record id="item_crm_channels_setup" model="cms.sidebar.item">
        <field name="name">Channels (setup)</field>
