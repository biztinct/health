<odoo>
    <record id="fsm_order_timeline_view" model="ir.ui.view">
        <field name="name">fsm.order.timeline</field>
        <field name="model">fsm.order</field>
        <field name="type">timeline</field>
        <field name="arch" type="xml">
<!--            <timeline
                date_start="scheduled_date_start"
                date_stop="scheduled_date_end"
                string="Orders"
                default_group_by="person_id"
                event_open_popup="true"
                colors="#ffffff:stage_name=='New';"
            >
            </timeline>
-->

<timeline date_start="scheduled_date_start" date_stop="scheduled_date_end" string="Orders" default_group_by="person_id" event_open_popup="true" colors="#A3C1DA:stage_name=='New'; #B2E0B2:stage_name=='Confirmed'; #F6EBA8:stage_name=='Requested'; #F4C2C2:stage_name=='Assigned'; #E6C9E4:stage_name=='Scheduled'; #FFDAB9:stage_name=='En Route'; #B2E3D8:stage_name=='Started'; #B7CFB7:stage_name=='Completed'; #FFB8B1:stage_name=='Cancelled';">
    <field name="personpartner_id"/>
    <field name="location_name"/>       
    <field name="street"/>
    <field name="city"/>
    <field name="phone"/>
    <field name="person_id"/>
    <field name="scheduled_duration"/>
    <field name="location_id"/>        
    <field name="category_ids"/>
    <field name="scheduled_date_start"/>
    <field name="scheduled_date_end"/>

    <templates>
        <t t-name="timeline-item">
            <div class="o_project_timeline_item oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban" style="display: flex; align-items: flex-start; justify-content: space-between;"> 
                <div> 
                    <t t-if="record.personpartner_id">
                        <img t-attf-src="/web/image/res.partner/#{record.personpartner_id}/image_128" t-att-alt="record.person_id.name" t-att-title="record.person_id.name" width="60" height="60" class="mr8"/>
                    </t>
                    <span>
                        <strong><t t-esc="record.location_name"/></strong>
                        <small name="scheduled_duration" class="text-info ml4" t-if="record.scheduled_duration">
                            <t t-out="formatters.get('float_time')(record.scheduled_duration)"/>
                        </small>
                        <t t-if="record.stage_name == 'New'">
                            <i class="fa fa-hourglass-start fa-2x" aria-hidden="true" style="color: #2A4D69;"/>
                        </t>
                        <t t-if="record.stage_name == 'Confirmed'">
                            <i class="fa fa-thumbs-up fa-2x" aria-hidden="true" style="color: #3B8A3A;"/>
                        </t>
                        <t t-if="record.stage_name == 'Requested'">
                            <i class="fa fa-clock-o fa-2x" aria-hidden="true" style="color: #BDAA00;"/>
                        </t>
                        <t t-if="record.stage_name == 'Assigned'">
                            <i class="fa fa-map-marker fa-2x" aria-hidden="true" style="color: #A03A3A;"/>
                        </t>
                        <t t-if="record.stage_name == 'Scheduled'">
                            <i class="fa fa-calendar-check-o fa-2x" aria-hidden="true" style="color: #5B3F8D;"/>
                        </t>
                        <t t-if="record.stage_name == 'En Route'">
                            <i class="fa fa-motorcycle fa-2x" aria-hidden="true" style="color: #C76A3C;"/>
                        </t>
                        <t t-if="record.stage_name == 'Started'">
                            <i class="fa fa-handshake-o fa-2x" aria-hidden="true" style="color: #2B7A7A;"/>
                        </t>
                        <t t-if="record.stage_name == 'Completed'">
                            <i class="fa fa-child fa-2x" aria-hidden="true" style="color: black;"/>
                        </t>
                        <t t-if="record.stage_name == 'Cancelled'">
                            <i class="fa fa-flag-checkered fa-2x" aria-hidden="true" style="color: black;"/>
                        </t>
                    </span>
                    <div style="text-align: left; color: #6c757d;">  
                        <div>
                            <i class="fa fa-map-marker" style="font-weight: bold; color: #444;"/> 
                            <span><t t-esc="record.street"/></span>
                        </div>
                        <div>
                            <i class="fa fa-building" style="font-weight: bold; color: #444;"/> 
                            <span><t t-esc="record.city"/></span>
                        </div>
                        <div t-if="record.phone"> 
                            <i class="fa fa-phone" style="font-weight: bold; color: #444;"/> 
                            <span><t t-esc="record.phone"/></span>
                        </div>

                    </div>
                </div>

                <div style="display: flex; align-items: center;"> 
                </div>
            </div>
        </t>
    </templates>


            
            </timeline>



        </field>
    </record>
    <record id="fieldservice.action_fsm_dash_order" model="ir.actions.act_window">
        <field name="view_mode">kanban,tree,form,calendar,timeline</field>
    </record>
    <record id="fieldservice.action_fsm_operation_order" model="ir.actions.act_window">
        <field name="view_mode">tree,form,calendar,timeline</field>
    </record>
</odoo>
