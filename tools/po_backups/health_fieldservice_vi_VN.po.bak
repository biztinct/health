msgstr "<strong>MINISTRY OF Y tế COMPLIANCE REPORT</strong>"

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.view_health_booking_cancel_wizard_form
msgid ""
"<strong>Note:</strong> Cancellation details are mandatory and will be logged"
" for record-keeping purposes."
msgstr "<strong>Ghi chú:</strong> Hủylation Chi tiết are mandatory và will be logged cho bản ghi-keeping purposes."

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.view_healthcare_quote_form_custom
msgid ""
"<strong>Nurse Access:</strong> You can only edit quantities and discounts in"
" this quote."
msgstr "<strong>Y tá Truy cập:</strong> You can only Chỉnh sửa quantities và dissố lượngs trong này quote."

#. module: health_fieldservice
#: model_terms:ir.actions.act_window,help:health_fieldservice.action_assignment_web_timeline_view
