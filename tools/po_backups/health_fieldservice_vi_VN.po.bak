#. module: health_fieldservice
#. odoo-python
#: code:addons/health_fieldservice/models/health_staff_assignment.py:0
msgid ""
"\n"
"\n"
"Click on a staff member below to assign them to this appointment."
msgstr "\n\nNhấn trên a nhân viên member bên dưới Đến phân công them Đến này Cuộc hẹn."

#. module: health_fieldservice
#: model:ir.actions.report,print_report_name:health_fieldservice.action_report_moh_multi
msgid ""
"'MOH_Compliance_Report_%s' % "
"(datetime.datetime.now().strftime('%Y%m%d_%H%M%S'))"
msgstr "'MOH_Tuân thủ_Báo cáo_%s' % (ngàygiờ.ngàygiờ.bây giờ().strfgiờ('%Y%m%d_%H%M%S'))"

#. module: health_fieldservice
#: model:ir.actions.report,print_report_name:health_fieldservice.action_report_moh_single
msgid "'MOH_Report_%s' % (object.name)"
msgstr "'MOH_Báo cáo_%s' % (object.tên)"

