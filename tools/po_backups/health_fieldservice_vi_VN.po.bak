#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.view_healthcare_quote_form_custom
msgid ""
"<strong>Invoice Creation Mode:</strong> Review and modify the quote items "
"below, then click \"Create Invoice\" to generate the final invoice."
msgstr "<strong>Hóa đơn Creation Mode:</strong> Đánh giá và modify the quote items bên dưới, then nhấn \"Tạo mới Hóa đơn\" Đến geneđánh giá the final Hóa đơn."

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.report_moh_document
#: model_terms:ir.ui.view,arch_db:health_fieldservice.report_moh_document_multi
