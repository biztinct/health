msgstr "<strong>Bệnh nhân Thông tin / Thông tin bệnh nhân</strong>"

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.report_moh_document
msgid "<strong>Patient Signature / Chữ ký bệnh nhân</strong>"
msgstr "<strong>Bệnh nhân Chữ ký / Chữ ký bệnh nhân</strong>"

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.view_health_fieldservice_order_form
msgid ""
"<strong>Quote/Invoice:</strong> Required - Please create a quote with "
"service items"
msgstr "<strong>Quote/Hóa đơn:</strong> Bắt buộc - Vui lòng Tạo mới a quote với dịch vụ items"

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.report_moh_document_multi
msgid "<strong>Report Date / Ngày báo cáo:</strong>"
msgstr "<strong>Báo cáo Ngày / Ngày báo cáo:</strong>"

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.report_moh_document
msgid "<strong>Service Date / Ngày dịch vụ:</strong>"
msgstr "<strong>Dịch vụ Ngày / Ngày dịch vụ:</strong>"

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.report_moh_document
msgid "<strong>Service Type / Loại dịch vụ:</strong>"
msgstr "<strong>Dịch vụ Loại / Loại dịch vụ:</strong>"

#. module: health_fieldservice
#: model_terms:ir.actions.act_window,help:health_fieldservice.action_health_staff_availability
msgid ""
"<strong>Tip:</strong> Use the calendar view to quickly visualize staff availability \n"
"                across different time periods."
msgstr "<strong>Tip:</strong> Use the Lịch Xem Đến quickly visualize nhân viên availability \n                ngang qua different Giờ kỳs."

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.view_health_booking_cancel_wizard_form
msgid ""
"<strong>Warning:</strong> This booking has an associated invoice. The draft "
"invoice will be cancelled automatically."
msgstr "<strong>Cảnh báo:</strong> Này đặt lịch has an liên kết Hóa đơn. The Nháp Hóa đơn will be Đã hủy automatically."

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.view_health_fieldservice_order_form
msgid ""
"<strong>ℹ️ Part-Time Staff Workflow:</strong> This service was completed by "
"part-time/casual staff who do not have invoice creation permissions. "
"Operations team has been notified to create the invoice."
msgstr "<strong>ℹ️ Part-Giờ Nhân viên Workflow:</strong> Này dịch vụ was đã hoàn thành bởi part-Giờ/casual nhân viên ai do not have Hóa đơn creation quyềns. Vận hành đội has been notified Đến Tạo mới the Hóa đơn."

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.view_health_fieldservice_order_form
msgid ""
"<strong>⏳ Awaiting Invoice:</strong>\n"
"                            Service completed by part-time staff. Operations team needs to create the invoice."
msgstr "<strong>⏳ Ađang chờ Hóa đơn:</strong>\n                            Dịch vụ đã hoàn thành bởi part-Giờ nhân viên. Vận hành đội nhu cầus Đến Tạo mới the Hóa đơn."

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.view_health_fieldservice_order_form
msgid ""
"<strong>⚠️ Required:</strong> Clinical notes must be submitted before "
"completing the service."
msgstr "<strong>⚠️ Bắt buộc:</strong> Lâm sàng Ghi chú must be submitted trước completing the dịch vụ."

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.view_health_fieldservice_order_form
msgid ""
"<strong>✓ Clinical Notes Submitted:</strong> Clinical documentation is "
"complete."
msgstr "<strong>✓ Lâm sàng Ghi chú Submitted:</strong> Lâm sàng tài liệu là Hoàn thành."

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.view_health_fieldservice_order_form
msgid ""
"<strong>📋 Quote Required:</strong> \n"
"                            This booking needs a healthcare quote before it can be confirmed."
msgstr "<strong>📋 Quote Bắt buộc:</strong> \n                            Này đặt lịch nhu cầus a Y tế quote trước it can be Đã xác nhận."

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.view_health_fieldservice_order_form
msgid "<strong>📋 Service Completion Requirements:</strong>"
msgstr "<strong>📋 Dịch vụ Completion Yêu cầus:</strong>"

#. module: health_fieldservice
#: model_terms:ir.ui.view,arch_db:health_fieldservice.view_health_fieldservice_order_form
msgid ""
"<strong>📝 Quote Created:</strong>\n"
"                            Healthcare quote exists but needs items added before confirmation."
msgstr "<strong>📝 Quote Đã tạo:</strong>\n                            Y tế quote exists but nhu cầus items đã thêm trước xác nhậnation."

