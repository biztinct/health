#!/usr/bin/python3
"""Root-only atomic domain map updates. Arguments are never shell code."""
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

if os.geteuid() != 0:
    sys.exit('Run through the platform domain scripts.')
if len(sys.argv) not in (3,4):sys.exit('Expected set HOST DATABASE or remove HOST')
action,host=sys.argv[1:3]
if not re.fullmatch(r'(?=.{1,253}$)[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+',host):sys.exit('Invalid hostname')
slug=sys.argv[3] if len(sys.argv)==4 else None
if action not in ('set','remove'):sys.exit('Invalid operation')
if action=='set':
    if not slug or not re.fullmatch(r'[a-z][a-z0-9]*(?:-[a-z0-9]+)*',slug) or len(slug)>63 or slug.endswith('-staging'):sys.exit('Invalid tenant')
    proc=subprocess.run(['sudo','-u','postgres','psql','-d','carejiox','-Atc',"SELECT count(*) FROM biz_tenant WHERE slug='%s' AND state='live'" % slug],capture_output=True,text=True,check=True)
    if proc.stdout.strip() != '1':sys.exit('Only a live registered customer may receive a domain')
path=Path('/etc/carejiox-domains.json')
with open('/run/lock/carejiox-domains.lock','w') as lock:
    fcntl.flock(lock,fcntl.LOCK_EX)
    data=json.loads(path.read_text()) if path.exists() else {}
    if action=='set':
        if host in data and data[host]!=slug:sys.exit('Hostname already belongs to another customer')
        data[host]=slug
    else:
        if slug and host in data and data[host] != slug:
            sys.exit('Hostname belongs to another customer')
        data.pop(host,None)
    fd,tmp=tempfile.mkstemp(prefix='.carejiox-domains-',dir='/etc')
    try:
        with os.fdopen(fd,'w') as target:
            json.dump(data,target,sort_keys=True);target.flush();os.fsync(target.fileno())
        os.chmod(tmp,0o644);os.replace(tmp,path)
    finally:
        if os.path.exists(tmp):os.unlink(tmp)
