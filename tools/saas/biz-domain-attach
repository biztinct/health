#!/bin/bash
# Exact host routing is provided by the server-wide biz_domain_router module.
set -euo pipefail
. "${BIZ_LIB:-/usr/local/bin}/biz-common.sh"
biz_load_conf
HOSTNAME_ARG="${1:-}"; SLUG_ARG="${2:-}"
biz_valid_hostname "$HOSTNAME_ARG" || biz_die 'invalid hostname' 2
biz_valid_slug "$SLUG_ARG" || biz_die 'invalid tenant' 2
[[ "$SLUG_ARG" != *-staging ]] || biz_die 'practice copies cannot receive domains' 2
[[ "$HOSTNAME_ARG" != "$APEX_DOMAIN" && "$HOSTNAME_ARG" != "www.$APEX_DOMAIN" && "$HOSTNAME_ARG" != "$SLUG_ARG.$APEX_DOMAIN" ]] || biz_die 'reserved platform address' 2
if [[ "${3:-}" == '--check-only' ]]; then echo 'OK (check-only)'; exit 0; fi
[[ "$CUSTOM_DOMAIN_PINNING" == 1 ]] || biz_die 'Enable the verified domain router first' 3
# Do not overwrite an existing tenant subdomain or another managed block.
CERT_NAME="${BLOCK_PREFIX}${HOSTNAME_ARG}"
CONF="/etc/nginx/sites-available/${CERT_NAME}.conf"
LINK="/etc/nginx/sites-enabled/${CERT_NAME}.conf"
if [[ -e "$CONF" ]]; then
    # A retry after the HTTP request timed out must recover the completed work.
    if grep -Fxq "# Managed custom domain ${HOSTNAME_ARG} -> ${SLUG_ARG}" "$CONF" && grep -Eq '^[[:space:]]*listen 443 ssl;' "$CONF" && [[ -s "/etc/letsencrypt/live/${CERT_NAME}/fullchain.pem" ]]; then
        /usr/local/bin/biz-domain-map set "$HOSTNAME_ARG" "$SLUG_ARG"
        nginx -t
        systemctl reload nginx
        echo "OK ${HOSTNAME_ARG} -> ${SLUG_ARG} (already active)"
        exit 0
    fi
    biz_die 'This address is already configured; remove it before attaching again' 2
fi
/usr/local/bin/biz-domain-map set "$HOSTNAME_ARG" "$SLUG_ARG"
rollback() {
    rm -f "$LINK" "$CONF"
    /usr/local/bin/biz-domain-map remove "$HOSTNAME_ARG"
    nginx -t && systemctl reload nginx
}
trap rollback ERR
cat > "$CONF" <<EOF
# Managed custom domain ${HOSTNAME_ARG} -> ${SLUG_ARG}
server {
    listen 80;
    server_name ${HOSTNAME_ARG};
    client_max_body_size 128M;
    proxy_read_timeout 720s;
    proxy_set_header Host \$host;
    proxy_set_header X-Forwarded-Host \$host;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_set_header X-Real-IP \$remote_addr;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location ^~ /web/database/ { return 404; }
    location /websocket {
        proxy_pass http://127.0.0.1:8072;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-Host \$host;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
    }
    location / { proxy_pass http://127.0.0.1:8069; proxy_redirect off; }
}
EOF
ln -s "$CONF" "$LINK"
nginx -t
systemctl reload nginx
# Certbot's nginx installer can prefer an existing wildcard TLS block over
# this exact HTTP host. Obtain only; write our own exact TLS block so unrelated
# domains and their certificates never change.
mkdir -p /var/lib/letsencrypt/.well-known/acme-challenge
certbot certonly --webroot -w /var/lib/letsencrypt --non-interactive --agree-tos --register-unsafely-without-email --cert-name "$CERT_NAME" -d "$HOSTNAME_ARG" --deploy-hook 'systemctl reload nginx'
sed -i "s|listen 80;|listen 443 ssl;\\n    ssl_certificate /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;\\n    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;\\n    include /etc/letsencrypt/options-ssl-nginx.conf;|" "$CONF"
cat >> "$CONF" <<EOF
server {
    listen 80;
    server_name ${HOSTNAME_ARG};
    location ^~ /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 301 https://\$host\$request_uri; }
}
EOF
nginx -t
systemctl reload nginx
trap - ERR
echo "OK ${HOSTNAME_ARG} -> ${SLUG_ARG}"
