  "anchorLint": {
    "why": "The binding rule of DESIGN_SPEC §4. Content points at controls by name; a renamed screen must break the build, not the lesson.",
    "contentFiles": [
      "data.js"
    ],
    "templateFiles": [
      "app.js",
      "practice-data.js"
    ],
    "note": "In production, contentFiles become the learn-content records and templateFiles become the OWL templates."
  },
  "tokenLint": {
    "why": "Tenant overrides fill NAMED SLOTS in content. A typo renders `{{roleDutyDoctor}}` to a learner instead of the clinic's own escalation title — and unlike a broken anchor, nothing crashes, so it ships.",
    "contentFiles": [
      "data.js"
    ],
    "declaredIn": "practice-data.js"
  }
