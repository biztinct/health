#. module: health_messaging
#: model:mail.template,body_html:health_messaging.mail_template_booking_confirmation
msgid ""
"<div style=\"font-family:Arial,sans-serif;color:#1e293b;\">\n"
"                <p>Kính gửi {{ object.patient_id.name or '' }},</p>\n"
"                <p>Lịch hẹn của quý khách đã được xác nhận:</p>\n"
"                <ul>\n"
"                    <li><strong>Ngày:</strong> {{ format_datetime(object.scheduled_datetime, tz=object.booking_timezone, dt_format='dd/MM/yyyy') if object.scheduled_datetime else '' }}</li>\n"
"                    <li><strong>Giờ:</strong> {{ format_datetime(object.scheduled_datetime, tz=object.booking_timezone, dt_format='HH:mm') if object.scheduled_datetime else '' }}</li>\n"
"                    <li><strong>Cơ sở:</strong> {{ object.facility_id.name or '' }}</li>\n"
"                </ul>\n"
"                <hr/>\n"
"                <p>Dear {{ object.patient_id.name or '' }}, your visit is confirmed for\n"
"                    {{ format_datetime(object.scheduled_datetime, tz=object.booking_timezone, dt_format='dd/MM/yyyy') if object.scheduled_datetime else '' }}\n"
"                    at {{ format_datetime(object.scheduled_datetime, tz=object.booking_timezone, dt_format='HH:mm') if object.scheduled_datetime else '' }}\n"
"                    ({{ object.facility_id.name or '' }}).</p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: health_messaging
#: model:mail.template,body_html:health_messaging.mail_template_cancellation_notice
msgid ""
"<div style=\"font-family:Arial,sans-serif;color:#1e293b;\">\n"
"                <p>Kính gửi {{ object.patient_id.name or '' }},</p>\n"
"                <p>Lịch hẹn ngày\n"
"                    <strong>{{ format_datetime(object.scheduled_datetime, tz=object.booking_timezone, dt_format='dd/MM/yyyy') if object.scheduled_datetime else '' }}</strong>\n"
"                    lúc <strong>{{ format_datetime(object.scheduled_datetime, tz=object.booking_timezone, dt_format='HH:mm') if object.scheduled_datetime else '' }}</strong>\n"
"                    ({{ object.facility_id.name or '' }}) đã được huỷ. Vui lòng liên hệ để đặt lại.</p>\n"
"                <hr/>\n"
"                <p>Dear {{ object.patient_id.name or '' }}, your visit on\n"
"                    {{ format_datetime(object.scheduled_datetime, tz=object.booking_timezone, dt_format='dd/MM/yyyy') if object.scheduled_datetime else '' }}\n"
"                    ({{ object.facility_id.name or '' }}) has been cancelled. Please contact us to rebook.</p>\n"
"            </div>\n"
"        "
msgstr ""

