#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
msgid ""
"Website disconnected by %(user)s: OAuth client %(client)s is archived, so "
"its tokens no longer authenticate. The record is kept for the audit trail."
msgstr ""
"%(user)s đã ngắt kết nối website: ứng dụng OAuth %(client)s đã được lưu trữ "
"nên các token của nó không còn xác thực được. Bản ghi vẫn được giữ để phục "
"vụ nhật ký kiểm toán."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/crm_lead.py:0
msgid ""
"Website marketing consent checkbox (text version %(version)s), submission %"
"(submission)s, submitted %(when)s UTC."
msgstr ""
"Ô đồng ý tiếp thị trên website (phiên bản văn bản %(version)s), lượt gửi %"
"(submission)s, gửi lúc %(when)s UTC."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/crm_lead.py:0
msgid "Website marketing consent materialised as %(ref)s for %(client)s."
msgstr ""
"Đồng ý tiếp thị từ website đã được ghi nhận thành %(ref)s cho %(client)s."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/crm_lead.py:0
msgid ""
"Website marketing consent was NOT materialised: %(client)s already holds an "
"active marketing consent (%(ref)s), which an automated claim must never "
"supersede."
msgstr ""
"KHÔNG tạo bản ghi đồng ý tiếp thị từ website: %(client)s đã có một đồng ý "
"tiếp thị đang hiệu lực (%(ref)s), và một khai báo tự động không bao giờ được "
"thay thế bản ghi đó."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/crm_lead.py:0
msgid ""
"Website marketing consent was NOT materialised: the contact details on this "
"lead do not match the client %(client)s, so the person who ticked the box is "
"not the person the consent would cover. Capture consent from the client "
"directly if it is needed."
msgstr ""
"KHÔNG tạo bản ghi đồng ý tiếp thị từ website: thông tin liên hệ trên khách "
"tiềm năng này không khớp với khách hàng %(client)s, nên người tích vào ô "
"đồng ý không phải người mà sự đồng ý áp dụng. Hãy thu thập đồng ý trực tiếp "
"từ khách hàng nếu cần."

#. module: health_web_leads
#. odoo-python
#: code:addons/health_web_leads/models/web_leads_connector.py:0
