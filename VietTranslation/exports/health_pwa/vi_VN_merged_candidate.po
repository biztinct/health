#~ msgid ""
#~ "// Health PWA Service Worker v1.0.95\n"
#~ "// IMPORTANT: Increment version number when deploying updates!\n"
#~ "\n"
#~ "const CACHE_VERSION = '1.0.95';\n"
#~ "const CACHE_NAME = `health-pwa-v${CACHE_VERSION}`;\n"
#~ "const OFFLINE_URL = '/health_pwa/offline';\n"
#~ "const API_CACHE_NAME = `health-pwa-api-v${CACHE_VERSION}`;\n"
#~ "\n"
#~ "// Listen for SKIP_WAITING message to activate new service worker "
#~ "immediately\n"
#~ "self.addEventListener('message', (event) =&gt; {\n"
#~ "    if (event.data &amp;&amp; event.data.type === 'SKIP_WAITING') {\n"
#~ "        self.skipWaiting();\n"
#~ "    }\n"
#~ "});\n"
#~ "\n"
#~ "// Files to cache for offline functionality\n"
#~ "const STATIC_CACHE_URLS = [\n"
#~ "    '/health_pwa',\n"
#~ "    '/health_pwa/offline',\n"
#~ "    `/health_pwa/static/src/css/app.css?v=${CACHE_VERSION}`,\n"
#~ "    `/health_pwa/static/src/css/mobile.css?v=${CACHE_VERSION}`,\n"
#~ "    `/health_pwa/static/src/js/utils/pwa-utils.js?v=${CACHE_VERSION}`,\n"
#~ "    `/health_pwa/static/src/js/app.js?v=${CACHE_VERSION}`,\n"
#~ "    `/health_pwa/static/src/js/router.js?v=${CACHE_VERSION}`,\n"
#~ "    '/health_pwa/static/icons/icon-192.png',\n"
#~ "    // Note: External CDN URLs removed from pre-cache - they fail with "
#~ "CORS errors\n"
#~ "    // and cause the entire SW installation to fail, preventing cache "
#~ "updates.\n"
#~ "    // These are loaded directly via &lt;script&gt; tags and cached by "
#~ "the browser normally.\n"
#~ "];\n"
#~ "\n"
#~ "// API endpoints to cache\n"
#~ "const API_CACHE_PATTERNS = [\n"
#~ "    /^\\/health_pwa\\/api\\/patients/,\n"
#~ "    /^\\/health_pwa\\/api\\/fso/,\n"
#~ "    /^\\/health_pwa\\/api\\/teams/,\n"
#~ "    /^\\/health_pwa\\/api\\/user/,\n"
#~ "];\n"
#~ "\n"
#~ "// Install event - cache static files\n"
#~ "self.addEventListener('install', event =&gt; {\n"
#~ "    console.log('Service Worker installing...');\n"
#~ "    event.waitUntil(\n"
#~ "        caches.open(CACHE_NAME)\n"
#~ "            .then(cache =&gt; {\n"
#~ "                console.log('Caching static files');\n"
#~ "                return cache.addAll(STATIC_CACHE_URLS);\n"
#~ "            })\n"
#~ "            .then(() =&gt; {\n"
#~ "                console.log('Service Worker installed successfully');\n"
#~ "                return self.skipWaiting();\n"
#~ "            })\n"
#~ "            .catch(error =&gt; {\n"
#~ "                console.error('Service Worker installation failed:', "
#~ "error);\n"
#~ "            })\n"
#~ "    );\n"
#~ "});\n"
#~ "\n"
#~ "// Activate event - clean up old caches\n"
#~ "self.addEventListener('activate', event =&gt; {\n"
#~ "    console.log('Service Worker activating...');\n"
#~ "    event.waitUntil(\n"
#~ "        caches.keys().then(cacheNames =&gt; {\n"
#~ "            return Promise.all(\n"
#~ "                cacheNames.map(cacheName =&gt; {\n"
#~ "                    if (cacheName !== CACHE_NAME &amp;&amp; cacheName !== "
#~ "API_CACHE_NAME) {\n"
#~ "                        console.log('Deleting old cache:', cacheName);\n"
#~ "                        return caches.delete(cacheName);\n"
#~ "                    }\n"
#~ "                })\n"
#~ "            );\n"
#~ "        }).then(() =&gt; {\n"
#~ "            console.log('Service Worker activated');\n"
#~ "            return self.clients.claim();\n"
#~ "        })\n"
#~ "    );\n"
#~ "});\n"
#~ "\n"
#~ "// Fetch event - handle network requests with caching strategy\n"
#~ "self.addEventListener('fetch', event =&gt; {\n"
#~ "    const request = event.request;\n"
#~ "    const url = new URL(request.url);\n"
#~ "    \n"
#~ "    // Skip non-GET requests and chrome-extension requests\n"
