"        const cache = await caches.open(API_CACHE_NAME);\n"
"        const cachedResponse = await cache.match(request);\n"
"        \n"
"        if (cachedResponse) {\n"
"            // Add offline indicator header\n"
"            const response = cachedResponse.clone();\n"
"            response.headers.set('X-Served-By', 'ServiceWorker-Cache');\n"
"            return response;\n"
"        }\n"
"        \n"
"        // Return offline response for API requests\n"
"        return new Response(JSON.stringify({\n"
"            success: false,\n"
"            error: 'Network unavailable and no cached data',\n"
"            offline: true,\n"
"            timestamp: new Date().toISOString()\n"
"        }), {\n"
"            status: 503,\n"
"            headers: { 'Content-Type': 'application/json' }\n"
"        });\n"
"    }\n"
"}\n"
"\n"
"// Handle static requests with Cache First strategy\n"
"async function handleStaticRequest(request) {\n"
"    const cache = await caches.open(CACHE_NAME);\n"
"    const cachedResponse = await cache.match(request);\n"
"    \n"
"    if (cachedResponse) {\n"
"        return cachedResponse;\n"
"    }\n"
"    \n"
"    try {\n"
"        const response = await fetch(request);\n"
"        if (response.ok) {\n"
"            cache.put(request, response.clone());\n"
"        }\n"
"        return response;\n"
"    } catch (error) {\n"
"        console.log('Static request failed:', request.url);\n"
"        \n"
"        // Return offline page for navigation requests\n"
"        if (request.mode === 'navigate') {\n"
"            const offlineResponse = await cache.match(OFFLINE_URL);\n"
"            return offlineResponse || new Response('Offline', { status: "
"503 });\n"
"        }\n"
"        \n"
"        // Return minimal response for other requests\n"
"        return new Response('Offline', { status: 503 });\n"
"    }\n"
"}\n"
"\n"
"// Background sync for offline actions\n"
"self.addEventListener('sync', event =&gt; {\n"
"    console.log('Background sync triggered:', event.tag);\n"
"    \n"
"    if (event.tag === 'health-pwa-sync') {\n"
"        event.waitUntil(performBackgroundSync());\n"
"    }\n"
"});\n"
"\n"
"// Perform background sync\n"
"async function performBackgroundSync() {\n"
"    try {\n"
"        // Get pending sync data from IndexedDB (handled by PouchDB)\n"
"        console.log('Performing background sync...');\n"
"        \n"
"        // Send message to active clients to trigger sync\n"
"        const clients = await self.clients.matchAll();\n"
"        clients.forEach(client =&gt; {\n"
"            client.postMessage({\n"
"                type: 'BACKGROUND_SYNC',\n"
"                timestamp: new Date().toISOString()\n"
"            });\n"
"        });\n"
"        \n"
"    } catch (error) {\n"
"        console.error('Background sync failed:', error);\n"
"    }\n"
"}\n"
"\n"
"// Push notification handler\n"
"self.addEventListener('push', event =&gt; {\n"
"    console.log('[SW] Push notification received');\n"
"    \n"
"    let notifData = {\n"
"        title: 'Viet Uc',\n"
"        body: 'New notification',\n"
"        icon: '/health_pwa/static/icons/icon-192.png',\n"
"        badge: '/health_pwa/static/icons/icon-96.png',\n"
"        tag: 'health-pwa-notification',\n"
"        data: {},\n"
"    };\n"
"\n"
"    if (event.data) {\n"
"        try {\n"
"            const payload = event.data.json();\n"
"            notifData.title = payload.title || notifData.title;\n"
"            notifData.body = payload.body || notifData.body;\n"
"            notifData.icon = payload.icon || notifData.icon;\n"
"            notifData.badge = payload.badge || notifData.badge;\n"
"            notifData.tag = payload.tag || notifData.tag;\n"
"            notifData.data = payload.data || {};\n"
"        } catch (e) {\n"
"            notifData.body = event.data.text();\n"
"        }\n"
"    }\n"
"\n"
"    // Build notification actions based on type\n"
"    let actions = [\n"
"        { action: 'open', title: 'Mở / Open' },\n"
"        { action: 'close', title: 'Đóng / Close' }\n"
"    ];\n"
"\n"
"    // Assignment notifications get Accept/Decline buttons\n"
"    if (notifData.data &amp;&amp; notifData.data.type === 'assignment' "
"&amp;&amp; notifData.data.assignment_id) {\n"
"        actions = [\n"
"            { action: 'accept', title: '✅ Accept' },\n"
"            { action: 'decline', title: '❌ Decline' },\n"
"        ];\n"
"    }\n"
"\n"
"    const options = {\n"
"        body: notifData.body,\n"
"        icon: notifData.icon,\n"
"        badge: notifData.badge,\n"
"        vibrate: [200, 100, 200],\n"
"        tag: notifData.tag,\n"
"        data: notifData.data,\n"
"        actions: actions,\n"
"        requireInteraction: true,\n"
"    };\n"
"\n"
"    event.waitUntil(\n"
"        self.registration.showNotification(notifData.title, options).then(() "
"=&gt; {\n"
"            // Notify all open clients to refresh notification count\n"
"            return self.clients.matchAll({ type: 'window' }).then(clientList "
"=&gt; {\n"
"                clientList.forEach(client =&gt; {\n"
"                    client.postMessage({ type: 'PUSH_RECEIVED' });\n"
"                });\n"
"            });\n"
"        })\n"
"    );\n"
"});\n"
"\n"
"// Notification click handler\n"
"self.addEventListener('notificationclick', event =&gt; {\n"
"    console.log('[SW] Notification clicked:', event.action);\n"
"    event.notification.close();\n"
"    \n"
"    if (event.action === 'close') return;\n"
"\n"
"    const notifData = event.notification.data || {};\n"
"    const assignmentId = notifData.assignment_id;\n"
"\n"
"    // Handle Accept/Decline actions for assignments\n"
"    if (assignmentId &amp;&amp; (event.action === 'accept' || event.action "
"=== 'decline')) {\n"
"        event.waitUntil(\n"
"            fetch(`/health_pwa/api/assignments/${assignmentId}/respond`, {\n"
"                method: 'POST',\n"
"                headers: { 'Content-Type': 'application/json' },\n"
"                body: JSON.stringify({ action: event.action }),\n"
"            }).then(resp =&gt; resp.json()).then(data =&gt; {\n"
"                console.log('[SW] Assignment response:', data);\n"
"                // Notify clients to refresh\n"
"                return self.clients.matchAll({ type: "
"'window' }).then(clientList =&gt; {\n"
"                    clientList.forEach(client =&gt; {\n"
"                        client.postMessage({ type: 'PUSH_RECEIVED' });\n"
"                    });\n"
"                    // If no open clients, show a confirmation notification\n"
"                    if (clientList.length === 0) {\n"
"                        const msg = event.action === 'accept'\n"
"                            ? '✅ Assignment confirmed'\n"
"                            : '❌ Assignment declined';\n"
"                        return self.registration.showNotification('Viet Uc', "
"{\n"
"                            body: msg,\n"
"                            icon: '/health_pwa/static/icons/icon-192.png',\n"
"                            tag: 'assignment-response',\n"
"                        });\n"
"                    }\n"
"                });\n"
"            }).catch(err =&gt; {\n"
"                console.error('[SW] Failed to respond to assignment:', "
"err);\n"
"                return self.registration.showNotification('Viet Uc', {\n"
"                    body: '⚠️ Error responding to assignment. Please open the "
"app.',\n"
"                    icon: '/health_pwa/static/icons/icon-192.png',\n"
"                    tag: 'assignment-response-error',\n"
"                });\n"
"            })\n"
"        );\n"
"        return;\n"
"    }\n"
"\n"
"    // Default: open the app (with notifications panel if assignment)\n"
"    const urlToOpen = (notifData &amp;&amp; notifData.type === "
"'assignment')\n"
"        ? '/health_pwa#/today?showNotifications=1'\n"
"        : (notifData &amp;&amp; notifData.url)\n"
"            ? notifData.url\n"
"            : '/health_pwa';\n"
"\n"
"    event.waitUntil(\n"
"        clients.matchAll({ type: 'window', includeUncontrolled: "
"true }).then(clientList =&gt; {\n"
"            // Try to focus existing window\n"
"            for (const client of clientList) {\n"
"                if (client.url.includes('/health_pwa') &amp;&amp; 'focus' in "
"client) {\n"
"                    client.navigate(urlToOpen);\n"
"                    return client.focus();\n"
"                }\n"
"            }\n"
"            // Open new window if no existing window\n"
"            if (clients.openWindow) {\n"
"                return clients.openWindow(urlToOpen);\n"
"            }\n"
"        })\n"
"    );\n"
"});\n"
"\n"
"console.log('Health PWA Service Worker loaded successfully');"

