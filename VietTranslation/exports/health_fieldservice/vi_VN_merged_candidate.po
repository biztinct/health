#. module: health_fieldservice
#: model:mail.template,body_html:health_fieldservice.email_template_assignment_confirmed
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 "
"auto;\">\n"
"                <div style=\"background: linear-gradient(135deg, #2563eb, "
"#059669); color: white; padding: 30px; text-align: center;\">\n"
"                    <h1 style=\"margin: 0; font-size: 28px;\">Assignment "
