#. module: health_fieldservice
#: model:mail.template,body_html:health_fieldservice.email_template_status_update
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 "
"auto;\">\n"
"                <div style=\"background: #2563eb; color: white; padding: "
"20px; text-align: center;\">\n"
"                    <h1 style=\"margin: 0;\">Service Booking Status Update</"
"h1>\n"
"                </div>\n"
"                \n"
"                <div style=\"padding: 30px;\">\n"
"                    <h2>Hello {{ object.patient_id.name }},</h2>\n"
"                    \n"
"                    <p style=\"font-size: 16px; line-height: 1.6;\">\n"
"                        Your service booking status has been updated to: "
"<strong>{{ object.state.title() }}</strong>\n"
"                    </p>\n"
"                    \n"
