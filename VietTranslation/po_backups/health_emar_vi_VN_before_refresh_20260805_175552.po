#. module: health_emar
#: code:addons/health_emar/models/health_medication_order.py:0
msgid "Only draft orders can be activated."
msgstr "Chỉ y lệnh nháp mới có thể kích hoạt."

#. module: health_emar
#: code:addons/health_emar/models/health_medication_order.py:0
msgid "PRN orders require a PRN reason."
msgstr "Y lệnh PRN cần có lý do PRN."

#. module: health_emar
#: code:addons/health_emar/models/health_medication_order.py:0
msgid "End date must be on/after start date."
msgstr "Ngày kết thúc phải bằng/sau ngày bắt đầu."

#. module: health_emar
#: code:addons/health_emar/models/health_medication_order.py:0
msgid "Dose must be positive."
msgstr "Liều lượng phải là số dương."

#. module: health_emar
#: code:addons/health_emar/models/health_medication_order.py:0
msgid "Interaction check unavailable"
msgstr "Không kiểm tra được tương tác thuốc"

#. module: health_emar
#: code:addons/health_emar/models/health_medication_administration.py:0
msgid ""
"A reason is required when recording a dose as not given or refused "
"(audit requirement)."
msgstr ""
"Cần có lý do khi ghi nhận liều thuốc không dùng hoặc bị từ chối "
"(yêu cầu kiểm toán)."

#. module: health_emar
#: code:addons/health_emar/models/health_medication_administration.py:0
msgid ""
"Recorded administrations are append-only: only the notes may be edited. "
"Ask a head nurse to amend the record (correction is logged, never silent)."
msgstr ""
"Phiếu thực hiện thuốc đã ghi nhận chỉ được bổ sung: chỉ ghi chú có thể "
"chỉnh sửa. Cần điều dưỡng trưởng để hiệu chỉnh (mọi hiệu chỉnh đều được "
"ghi log)."

#. module: health_emar
#: code:addons/health_emar/models/health_medication_administration.py:0
msgid "Recorded administrations cannot be deleted (clinical record integrity)."
msgstr "Không thể xóa phiếu thực hiện thuốc đã ghi nhận (toàn vẹn hồ sơ lâm sàng)."

